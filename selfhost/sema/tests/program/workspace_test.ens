import Path from @std.fs;
import @std.testing;
import program.workspace;
import Workspace from program.workspace;
import WorkspaceLoader from program.workspace;
import PackageMatch from program.workspace;
import FakeFileLoader from sema_support;
import sema_support;

test "workspace root discovery finds the nearest marked ancestor" {
    let loader = new FakeFileLoader();
    loader.add("/proj/ens.package", "package demo.app \{ ens \"0.1\"; \}");
    try testing.assertEqual(discovered(loader, "/proj"), "/proj");
    try testing.assertEqual(discovered(loader, "/proj/src/nested"), "/proj");
    try testing.assertEqual(discovered(loader, "/elsewhere/src"), "none");
}

test "sources without a workspace root stand alone" {
    let loader = new FakeFileLoader();
    let loading = new WorkspaceLoader(loader);
    let alone = loading.loadRoot(Path("/alone/src"), Path(""));
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    try testing.assertEqual(alone.sourceRoot().toString(), "/alone/src");
    try testing.assertFalse(alone.hasTestsRoot(), "a standalone workspace has no tests root");
    try testing.assertEqual(alone.packagePrefix(), "");
    try testing.assertFalse(alone.hasPackageManifest(), "no manifest governs standalone sources");
    try testing.assertTrue(alone.matchPackage(["acme"]) == null,
        "a standalone workspace has no packages");
    try testing.assertEqual(alone.missingPackageMessage("acme.widgets"),
        "External package 'acme.widgets' is not available; these sources have no ens.package "
            + "manifest (only '@std' is built in).");
}

test "a root package resolves dependencies against its enclosing workspace by name" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"vendor/acme\";\n"
        + "    member \"vendor/widgets\";\n"
        + "\}\n");
    loader.add("/ws/proj/ens.package", "package demo.app \{\n"
        + "    version \"1.3.0\";\n"
        + "    ens \"1.2\";\n"
        + "    dependency acme;\n"
        + "    dependency acme.widgets;\n"
        + "\}\n");
    loader.add("/ws/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/ws/vendor/widgets/ens.package", "package acme.widgets \{ ens \"0.1\"; \}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/ws/proj/src"), Path(""));
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    try testing.assertEqual(root.root().toString(), "/ws/proj");
    try testing.assertTrue(root.hasPackageManifest(), "the root declares a package");
    try testing.assertEqual(root.packageName(), "demo.app");

    let widgets = root.matchPackage(["acme", "widgets", "gadget"]);
    if (widgets != null) {
        try testing.assertEqual(widgets.segmentCount(), 2L);
        try testing.assertEqual(widgets.folder().toString(), "/ws/vendor/widgets");
    } else {
        try testing.fail("expected 'acme.widgets' to match by its longest prefix");
    }

    let acme = root.matchPackage(["acme", "other"]);
    if (acme != null) {
        try testing.assertEqual(acme.segmentCount(), 1L);
        try testing.assertEqual(acme.folder().toString(), "/ws/vendor/acme");
    } else {
        try testing.fail("expected 'acme' to match");
    }

    try testing.assertTrue(root.matchPackage(["missing", "thing"]) == null,
        "an undeclared package must not match");
    try testing.assertEqual(root.missingPackageMessage("missing.thing"),
        "Package 'missing.thing' is not declared as a dependency in /ws/proj/ens.package.");
}

test "a workspace-form root declares members without exposing them" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"frontend\";\n"
        + "    member \"sema\";\n"
        + "\}\n");
    loader.add("/ws/frontend/ens.package", "package ens.frontend \{ ens \"0.1\"; \}\n");
    loader.add("/ws/sema/ens.package", "package ens.sema \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency ens.frontend;\n"
        + "\}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/ws"), Path(""));
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    try testing.assertTrue(root.isWorkspaceRoot(), "the root manifest is the workspace form");
    try testing.assertTrue(root.matchPackage(["ens", "frontend", "lexer"]) == null,
        "a workspace root is not a package and resolves nothing");
    try testing.assertEqual(root.missingPackageMessage("ens.frontend"),
        "Package 'ens.frontend' is not available here: these sources sit under the workspace "
            + "at /ws/ens.package but not inside a member package, so only '@std' is "
            + "importable.");

    let member = loading.loadPackage(Path("/ws/sema"), "ens.sema");
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    try testing.assertEqual(member.sourceRoot().toString(), "/ws/sema/src");
    try testing.assertFalse(member.hasTestsRoot(), "a package never exposes a tests root");
    try testing.assertEqual(member.packagePrefix(), "ens.sema");
    let sibling = member.matchPackage(["ens", "frontend", "lexer"]);
    if (sibling != null) {
        try testing.assertEqual(sibling.folder().toString(), "/ws/frontend");
    } else {
        try testing.fail("expected the member's dependency to resolve to its sibling");
    }
}

test "dependency resolution failures are reported on the manifest" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"lib\";\n"
        + "\}\n");
    loader.add("/ws/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.lib \"2.0\";\n"
        + "    dependency ghost.lib;\n"
        + "\}\n");
    loader.add("/ws/lib/ens.package", "package acme.lib \{ ens \"0.1\"; \}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/ws/proj/src"), Path(""));
    let diagnostics = loading.diagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/ws/proj/ens.package",
        "Dependency 'acme.lib' resolves to the workspace member at /ws/lib; a member is used "
            + "as-is, so remove the version '2.0'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/ws/proj/ens.package",
        "No source for package 'ghost.lib': it is not a workspace member, no override redirects "
        + "it, and it names no git source. Add a from clause with its git URL, for example "
        + "'dependency ghost.lib \"1.0\" from \"https://github.com/owner/repo.git\";', or point "
        + "an override at a local folder.");
    let lib = root.matchPackage(["acme", "lib", "core"]);
    if (lib == null) {
        try testing.fail("the versioned member dependency still resolves after the error");
    }
}

test "git sources validate against members and are left to the driver" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"lib\";\n"
        + "\}\n");
    loader.add("/ws/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.lib \"1.0\" from \"https://example.com/lib.git\";\n"
        + "    dependency acme.json from \"https://example.com/json.git\";\n"
        + "    dependency beta.tools \"2.0\" from \"https://example.com/tools.git\";\n"
        + "\}\n");
    loader.add("/ws/lib/ens.package", "package acme.lib \{ ens \"0.1\"; \}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/ws/proj/src"), Path(""));
    let diagnostics = loading.diagnostics();
    try testing.assertEqual(diagnostics.length, 5L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/ws/proj/ens.package",
        "Dependency 'acme.json' declares a git source but no version; a git source fetches a "
            + "tagged version, for example 'dependency acme.json \"1.0\" from "
            + "\"https://example.com/json.git\";'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/ws/proj/ens.package",
        "Dependency 'acme.lib' resolves to the workspace member at /ws/lib; a member is used "
            + "as-is, so remove the version '1.0'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/ws/proj/ens.package",
        "Dependency 'acme.lib' resolves to the workspace member at /ws/lib; a member is used "
            + "as-is, so remove the from clause.");
    try sema_support.assertDiagnostic(diagnostics, 3, "/ws/proj/ens.package",
        "Dependency 'acme.json' names a git source, which only a build fetches. To check these "
        + "sources against a local copy, point an override at a checkout with 'ens override add "
        + "acme.json <folder>'.");
    try sema_support.assertDiagnostic(diagnostics, 4, "/ws/proj/ens.package",
        "Dependency 'beta.tools' names a git source, which only a build fetches. To check these "
        + "sources against a local copy, point an override at a checkout with 'ens override add "
        + "beta.tools <folder>'.");
    let lib = root.matchPackage(["acme", "lib"]);
    if (lib == null) {
        try testing.fail("the member dependency still resolves after the from-clause error");
    }
}

test "a package that is not a member gets no member index" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"lib\";\n"
        + "\}\n");
    loader.add("/ws/lib/ens.package", "package acme.lib \{ ens \"0.1\"; \}\n");
    loader.add("/ws/stray/ens.package", "package demo.stray \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.lib;\n"
        + "\}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/ws/stray/src"), Path(""));
    let diagnostics = loading.diagnostics();
    try testing.assertEqual(diagnostics.length, 1L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/ws/stray/ens.package",
        "No source for package 'acme.lib': it is not a workspace member, no override redirects it, "
        + "and it names no git source. Add a from clause with its git URL, for example "
        + "'dependency acme.lib \"1.0\" from \"https://github.com/owner/repo.git\";', or point "
        + "an override at a local folder.");
    try testing.assertTrue(root.matchPackage(["acme", "lib"]) == null,
        "a non-member package resolves nothing through the workspace");
}

test "only the root's overrides apply and their targets must match by name" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"lib\";\n"
        + "\}\n");
    loader.add("/ws/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.lib;\n"
        + "    dependency acme.gone \"1.0\";\n"
        + "    dependency other.lib;\n"
        + "\}\n");
    loader.add("/ws/proj/ens.overrides", "overrides \{\n"
        + "    override acme.lib \"../../local/lib\";\n"
        + "    override acme.gone \"../../local/gone\";\n"
        + "    override other.lib \"../../local/misnamed\";\n"
        + "\}\n");
    loader.add("/ws/lib/ens.package", "package acme.lib \{ ens \"0.1\"; \}\n");
    loader.add("/ws/lib/ens.overrides", "overrides \{\n"
        + "    override acme.lib \"../../local/ignored\";\n"
        + "\}\n");
    loader.add("/local/lib/ens.package", "package acme.lib \{ ens \"0.1\"; \}\n");
    loader.add("/local/gone/ens.package", "package acme.gone \{ ens \"0.1\"; \}\n");
    loader.add("/local/misnamed/ens.package", "package something.unrelated \{ ens \"0.1\"; \}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/ws/proj/src"), Path(""));
    let diagnostics = loading.diagnostics();
    try testing.assertEqual(diagnostics.length, 3L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/ws/proj/ens.overrides",
        "The override for package 'other.lib' points at /local/misnamed, which declares "
            + "package 'something.unrelated' instead; the names must match exactly.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/ws/proj/ens.package",
        "Dependency 'acme.lib' declares no version, and only a dependency that resolves to a "
        + "workspace member may leave it out. Add the version this package requires, for example "
        + "'dependency acme.lib \"1.0\";'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/ws/proj/ens.package",
        "No source for package 'other.lib': it is not a workspace member, no override redirects "
        + "it, and it names no git source. Add a from clause with its git URL, for example "
        + "'dependency other.lib \"1.0\" from \"https://github.com/owner/repo.git\";', or point "
        + "an override at a local folder.");

    let overridden = root.matchPackage(["acme", "lib"]);
    if (overridden != null) {
        try testing.assertEqual(overridden.folder().toString(), "/local/lib");
    } else {
        try testing.fail("the override must win over the workspace member");
    }

    let member = loading.loadPackage(Path("/ws/lib"), "acme.lib");
    let after = loading.diagnostics();
    try testing.assertEqual(after.length, 3L);
    try testing.assertEqual(member.packageName(), "acme.lib");
}

test "a workspace-form root's overrides apply to its member packages" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"lib\";\n"
        + "\}\n");
    loader.add("/ws/ens.overrides", "overrides \{\n"
        + "    override acme.dep \"../local/dep\";\n"
        + "\}\n");
    loader.add("/ws/lib/ens.package", "package acme.lib \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.dep \"1.0\";\n"
        + "\}\n");
    loader.add("/local/dep/ens.package", "package acme.dep \{ ens \"0.1\"; \}\n");
    let loading = new WorkspaceLoader(loader);
    loading.loadRoot(Path("/ws"), Path(""));
    let member = loading.loadPackage(Path("/ws/lib"), "acme.lib");
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    let overridden = member.matchPackage(["acme", "dep", "core"]);
    if (overridden != null) {
        try testing.assertEqual(overridden.folder().toString(), "/local/dep");
    } else {
        try testing.fail("the root's override must reach the member's dependency");
    }
}

// A workspace builds each member from the member's own folder, so the manifest discovered above the
// sources is the member's rather than the workspace's. The build names the folder its overrides came
// from, because they apply to every package of the build and not just to the one beside them.
test "a build reports which folder's overrides govern it" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n    member \"lib\";\n\}\n");
    loader.add("/ws/ens.overrides", "overrides \{\n"
        + "    override acme.dep \"../local/dep\";\n"
        + "\}\n");
    loader.add("/ws/lib/ens.package", "package acme.lib \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.dep \"1.0\";\n"
        + "\}\n");
    loader.add("/local/dep/ens.package", "package acme.dep \{ ens \"0.1\"; \}\n");

    let governed = new WorkspaceLoader(loader);
    let member = governed.loadRoot(Path("/ws/lib/src"), Path(""), Path("/ws"));
    try sema_support.assertNoDiagnostics(governed.diagnostics());
    let overridden = member.matchPackage(["acme", "dep", "core"]);
    if (overridden != null) {
        try testing.assertEqual(overridden.folder().toString(), "/local/dep");
    } else {
        try testing.fail("the build root's override must reach the member's dependency");
    }

    // Naming no folder leaves the overrides to the manifest above the sources, which the member's
    // own folder has and which declares none.
    let alone = new WorkspaceLoader(loader);
    let unaided = alone.loadRoot(Path("/ws/lib/src"), Path(""));
    try testing.assertEqual(alone.diagnostics().length, 1L);
    try sema_support.assertDiagnostic(alone.diagnostics(), 0, "/ws/lib/ens.package",
        "No source for package 'acme.dep': it is not a workspace member, no override redirects it, "
        + "and it names no git source. Add a from clause with its git URL, for example "
        + "'dependency acme.dep \"1.0\" from \"https://github.com/owner/repo.git\";', or point "
        + "an override at a local folder.");
    try testing.assertTrue(unaided.matchPackage(["acme", "dep"]) == null,
        "nothing redirects the dependency when no folder carries the overrides");
}

test "manifest form problems are reported against the file" {
    let loader = new FakeFileLoader();
    loader.add("/one/ens.package", "package demo.a \{ ens \"0.1\"; \}\nworkspace \{ \}\n");
    let first = new WorkspaceLoader(loader);
    first.loadRoot(Path("/one/src"), Path(""));
    try sema_support.assertDiagnostic(first.diagnostics(), 0, "/one/ens.package",
        "A manifest file holds exactly one declaration; remove the extra declarations.");

    loader.add("/two/ens.package", "overrides \{ \}\n");
    let second = new WorkspaceLoader(loader);
    second.loadRoot(Path("/two/src"), Path(""));
    try sema_support.assertDiagnostic(second.diagnostics(), 0, "/two/ens.package",
        "An ens.package file holds a package or workspace declaration; overrides live in the "
            + "ens.overrides file next to it.");

    loader.add("/three/ens.package", "package demo.c \{ ens \"0.1\"; \}\n");
    loader.add("/three/ens.overrides", "package demo.d \{ ens \"0.1\"; \}\n");
    let third = new WorkspaceLoader(loader);
    third.loadRoot(Path("/three/src"), Path(""));
    try sema_support.assertDiagnostic(third.diagnostics(), 0, "/three/ens.overrides",
        "An ens.overrides file holds a single overrides declaration; packages and workspaces "
            + "are declared in ens.package.");

    loader.add("/four/ens.package", "workspace \{\n"
        + "    member \"ghost\";\n"
        + "    member \"twin_a\";\n"
        + "    member \"twin_b\";\n"
        + "\}\n");
    loader.add("/four/twin_a/ens.package", "package acme.twin \{ ens \"0.1\"; \}\n");
    loader.add("/four/twin_b/ens.package", "package acme.twin \{ ens \"0.1\"; \}\n");
    let fourth = new WorkspaceLoader(loader);
    fourth.loadRoot(Path("/four"), Path(""));
    let diagnostics = fourth.diagnostics();
    try testing.assertEqual(diagnostics.length, 2L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/four/ens.package",
        "Workspace member 'ghost' has no ens.package manifest; every member folder declares "
            + "a package.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/four/ens.package",
        "Members '/four/twin_a' and '/four/twin_b' both declare package 'acme.twin'; "
            + "package names must be unique within a workspace.");

    loader.add("/five/ens.package", "package demo.e \{ \}\n");
    let fifth = new WorkspaceLoader(loader);
    fifth.loadRoot(Path("/five/src"), Path(""));
    try sema_support.assertDiagnostic(fifth.diagnostics(), 0, "/five/ens.package",
        "Package 'demo.e' does not declare the language version it is written for; add "
            + "'ens \"0.1\";' to the package declaration.");
}

test "version, native, and artifact declarations validate their shapes" {
    let loader = new FakeFileLoader();
    loader.add("/proj/ens.package", "package demo.app \{\n"
        + "    version \"one\";\n"
        + "    ens \"1.2.3\";\n"
        + "    native libc system \{\n"
        + "        windows \"c\";\n"
        + "    \}\n"
        + "    native llvm \{\n"
        + "        windows \"LLVM-C\";\n"
        + "        windows \"LLVM-C2\";\n"
        + "        beos \"LLVM\";\n"
        + "        macos artifact \"https://example.com/llvm.tar\" hash \"sha256:short\";\n"
        + "    \}\n"
        + "\}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/proj/src"), Path(""));
    let diagnostics = loading.diagnostics();
    try testing.assertEqual(diagnostics.length, 6L);
    try sema_support.assertDiagnostic(diagnostics, 0, "/proj/ens.package",
        "The version 'one' is not a valid version; use dotted numerals, for example "
            + "'version \"1.3.0\";'.");
    try sema_support.assertDiagnostic(diagnostics, 1, "/proj/ens.package",
        "The language version '1.2.3' is not valid; use major.minor, for example "
            + "'ens \"1.2\";'.");
    try sema_support.assertDiagnostic(diagnostics, 2, "/proj/ens.package",
        "Native library 'libc' is marked 'system', so it is linked by platform defaults and "
            + "cannot carry a binding block.");
    try sema_support.assertDiagnostic(diagnostics, 3, "/proj/ens.package",
        "Platform 'windows' is bound twice for native library 'llvm'; remove the duplicate.");
    try sema_support.assertDiagnostic(diagnostics, 4, "/proj/ens.package",
        "Unknown platform 'beos' in native library 'llvm'; bindings use 'windows', 'linux', "
            + "or 'macos'.");
    try sema_support.assertDiagnostic(diagnostics, 5, "/proj/ens.package",
        "The artifact checksum for native library 'llvm' must look like 'sha256:' followed "
            + "by 64 hex digits.");
    try testing.assertEqual(root.natives().length, 2L);
    try testing.assertTrue(root.natives()[0].isSystem(), "libc keeps its system flag");
    try testing.assertEqual(root.nativeNames()[1], "llvm");
}

test "the standard library loads as an ordinary package" {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/ens.package", "package std \{\n"
        + "    ens \"0.1\";\n"
        + "    native libc system;\n"
        + "\}\n");
    let loading = new WorkspaceLoader(loader);
    let stdlib = loading.loadPackage(Path("/stdlib/std"), "std");
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    try testing.assertEqual(stdlib.sourceRoot().toString(), "/stdlib/std/src");
    try testing.assertEqual(stdlib.packagePrefix(), "std");
    try testing.assertTrue(stdlib.hasPackageManifest(), "the std manifest is read");
    try testing.assertEqual(stdlib.natives().length, 1L);
    try testing.assertEqual(stdlib.natives()[0].name(), "libc");
}

test "a build that takes a package from an override reports it, once per package" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"first\";\n"
        + "    member \"second\";\n"
        + "\}\n");
    loader.add("/ws/ens.overrides", "overrides \{\n"
        + "    override acme.lib \"../local/lib\";\n"
        + "    override acme.spare \"../local/spare\";\n"
        + "\}\n");
    loader.add("/ws/first/ens.package", "package demo.first \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.lib \"1.0\";\n"
        + "\}\n");
    loader.add("/ws/second/ens.package", "package demo.second \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme.lib \"1.0\";\n"
        + "\}\n");
    loader.add("/local/lib/ens.package", "package acme.lib \{ ens \"0.1\"; \}\n");
    loader.add("/local/spare/ens.package", "package acme.spare \{ ens \"0.1\"; \}\n");

    let loading = new WorkspaceLoader(loader);
    let first = loading.loadRoot(Path("/ws/first/src"), Path(""), Path("/ws"));
    let second = loading.loadPackage(Path("/ws/second"), "demo.second");
    try sema_support.assertNoDiagnostics(loading.diagnostics());

    // One line for the package both members take from the override, and nothing at all for the
    // override nobody depends on.
    string[] said = loading.notices();
    try testing.assertEqual(said.length, 1L);
    try testing.assertEqual(said[0], "Using the override for package 'acme.lib': '/local/lib'");
}

test "a build that takes nothing from an override reports nothing" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "package demo.app \{ ens \"0.1\"; \}\n");
    loader.add("/ws/ens.overrides", "overrides \{\n"
        + "    override acme.lib \"../local/lib\";\n"
        + "\}\n");
    loader.add("/local/lib/ens.package", "package acme.lib \{ ens \"0.1\"; \}\n");
    let loading = new WorkspaceLoader(loader);
    let root = loading.loadRoot(Path("/ws/src"), Path(""));
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    try testing.assertEqual(loading.notices().length, 0L);
}

// Where the root discovery landed, as text, so an assertion reads the path it expects and "none"
// where no ancestor is marked.
discovered(FakeFileLoader loader, string startFolder) -> string {
    Path? root = workspace.discoverRoot(loader, Path(startFolder));
    if (root == null) {
        return "none";
    }
    return root.toString();
}

test "a native declaration is spelled on one line the way a manifest writes it" {
    let loader = new FakeFileLoader();
    string digest = "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    loader.add("/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    native zlib;\n"
        + "    native libc system;\n"
        + "    native llvm \{\n"
        + "        windows \"LLVM-C\" \"LTO\";\n"
        + "        linux \"LLVM-18\";\n"
        + "        macos artifact \"https://example.com/llvm.a\" hash \"" + digest + "\";\n"
        + "    \}\n"
        + "    native blank \{\n"
        + "    \}\n"
        + "\}\n");
    let loading = new WorkspaceLoader(loader);
    let natives = loading.loadRoot(Path("/proj/src"), Path("")).natives();
    try sema_support.assertNoDiagnostics(loading.diagnostics());
    try testing.assertEqual(natives.length, 4L);
    try testing.assertEqual(workspace.nativeDeclarationText(natives[0]), "native zlib;");
    try testing.assertEqual(workspace.nativeDeclarationText(natives[1]), "native libc system;");
    try testing.assertEqual(workspace.nativeDeclarationText(natives[2]),
        "native llvm \{ windows \"LLVM-C\" \"LTO\"; linux \"LLVM-18\"; macos artifact "
            + "\"https://example.com/llvm.a\" hash \"" + digest + "\"; \}");
    try testing.assertEqual(workspace.nativeDeclarationText(natives[3]), "native blank \{ \}");
}

test "a native declaration is refused when its manifest reports a problem inside it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    native good \{ windows \"good\"; \}\n"
        + "    native twice \{ windows \"a\"; windows \"a\"; \}\n"
        + "    native odd \{ windoze \"a\"; \}\n"
        + "    native blank \{ windows \"\"; \}\n"
        + "    native plain;\n"
        + "\}\n");
    let loading = new WorkspaceLoader(loader);
    let natives = loading.loadRoot(Path("/proj/src"), Path("")).natives();
    try testing.assertEqual(loading.diagnostics().length, 3L);
    try testing.assertEqual(natives.length, 5L);
    try testing.assertTrue(!natives[0].isRefused(), "'good' is accepted");
    try testing.assertTrue(natives[1].isRefused(), "'twice' binds a platform twice");
    try testing.assertTrue(natives[2].isRefused(), "'odd' names an unknown platform");
    try testing.assertTrue(natives[3].isRefused(), "'blank' has an empty base name");
    try testing.assertTrue(!natives[4].isRefused(), "'plain' is accepted");
}
