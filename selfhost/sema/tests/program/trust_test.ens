// What sema will answer for after the parser had to guess. Every case here is the same question from
// a different side: is a semantic diagnostic about the author's program, or about the parser's answer
// to a syntax error?
import @std.testing;
import program.graph;
import program.trust;
import FakeFileLoader from sema_support;
import sema_support;
import pipeline;

assessed(FakeFileLoader loader) -> graph.GraphResult {
    return graph.buildGraph(loader, "/proj/src", "", "/stdlib", ["main.ens"]);
}

test "a program that parsed soundly is analyzed whole" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "main() \{\n    let value = 1;\n\}\n");
    let result = trust.assess(assessed(loader));
    try testing.assertTrue(result.analyzable(), "nothing was guessed at");
}

test "a guess inside a body silences that function and nothing else" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "broken() \{\n"
        + "    let value = 1 +\n"
        + "\}\n"
        + "main() \{\n"
        + "    let found = nowhere();\n"
        + "\}\n");
    let graphResult = assessed(loader);
    let result = trust.assess(graphResult);
    try testing.assertTrue(result.analyzable(), "the file still declares what the author wrote");

    let analysis = pipeline.analyzeRecovered(graphResult);
    if (analysis == null) {
        try testing.fail("a body-confined guess leaves the program analyzable");
        return;
    }
    try sema_support.assertMentions(analysis.bodyDiagnostics(), "Undefined function 'nowhere'");
    for (let diagnostic in analysis.bodyDiagnostics()) {
        try testing.assertTrue(diagnostic.message().indexOf("value") < 0,
            "nothing is reported about the guessed body: " + diagnostic.message());
    }
}

test "a guess about what a file declares silences every semantic diagnostic" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Box \{\n"
        + "    long;\n"
        + "\}\n"
        + "main() \{\n"
        + "    let found = nowhere();\n"
        + "\}\n");
    let graphResult = assessed(loader);
    try testing.assertTrue(!trust.assess(graphResult).analyzable(),
        "a field with no name leaves every reference to it a guess");
    try testing.assertTrue(pipeline.analyzeRecovered(graphResult) == null,
        "the syntax error stands on its own");
}

test "an unclosed brace silences every semantic diagnostic" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "main() \{\n    let found = nowhere();\n");
    try testing.assertTrue(!trust.assess(assessed(loader)).analyzable(),
        "what followed the unclosed brace belongs to whatever the parser guessed");
}

test "an absent terminator silences nothing" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "class Pair \{\n"
        + "    long left\n"
        + "    long right;\n"
        + "\}\n"
        + "main() \{\n"
        + "    let found = nowhere();\n"
        + "\}\n");
    let graphResult = assessed(loader);
    try testing.assertTrue(trust.assess(graphResult).analyzable(),
        "a missing ';' consumes nothing and changes no meaning");
    let analysis = pipeline.analyzeRecovered(graphResult);
    if (analysis == null) {
        try testing.fail("a missing ';' leaves the program analyzable");
        return;
    }
    try sema_support.assertMentions(analysis.bodyDiagnostics(), "Undefined function 'nowhere'");
}

test "a graph the compiler could not finish reading silences every semantic diagnostic" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import lib.gone;\n"
        + "main() \{\n"
        + "    let found = nowhere();\n"
        + "\}\n");
    let graphResult = assessed(loader);
    try testing.assertTrue(graphResult.diagnostics().length > 0, "the import resolves to nothing");
    try testing.assertTrue(!trust.assess(graphResult).analyzable(),
        "names from a module that never loaded are undefined everywhere");
}

test "a damaged enum is left alone rather than walked" {
    // The typed accessors of a list the parser could not fill are not total, so reaching sema at all
    // would be a panic rather than a diagnostic.
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "enum Color \{\n    Red,\n    ,\n    Blue,\n\}\n");
    try testing.assertTrue(pipeline.analyzeRecovered(assessed(loader)) == null,
        "an enum whose members the parser could not read is not analyzed");
}
