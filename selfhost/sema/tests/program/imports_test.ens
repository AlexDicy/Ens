import @std.testing;
import ImportSite from program.imports;
import ProgramImports from program.imports;
import List from @std.collections.list;
import Set from @std.collections.set;

// A program 'main' and 'helper' the user edits, over a fetched 'acme.parts' that 'acme.relay'
// imports, with 'acme.relay' and 'acme.other' importing each other.
programImports(ImportSite[] written) -> ProgramImports {
    let sites = new List<ImportSite>();
    for (let site in written) {
        sites.push(site);
    }
    sites.push(new ImportSite("acme.relay", "acme", "acme.parts", "import parts;"));
    sites.push(new ImportSite("acme.relay", "acme", "acme.other", "import other;"));
    sites.push(new ImportSite("acme.other", "acme", "acme.relay", "import relay;"));
    return new ProgramImports(sites, Set<string>.of(["main", "helper"]));
}

editableSite(string importer, string target) -> ImportSite {
    return new ImportSite(importer, "", target, "import @{target};");
}

loadingTargets(ProgramImports imports, string modulePath) -> string {
    let found = new List<string>();
    for (let site in imports.loading(modulePath)) {
        found.push("{site.importerPath}->{site.targetPath}");
    }
    return string.joined(found.toArray(), ", ");
}

test "a module is loaded by the editable imports of it and of the fetched modules that load it" {
    let imports = programImports([editableSite("main", "acme.parts"),
        editableSite("main", "acme.relay"), editableSite("helper", "acme.parts")]);
    try testing.assertEqual(loadingTargets(imports, "acme.parts"),
        "main->acme.parts, main->acme.relay, helper->acme.parts");
    try testing.assertEqual(loadingTargets(imports, "acme.other"), "main->acme.relay");
}

test "an import between editable modules does not load a module those modules import" {
    let imports = programImports([editableSite("main", "helper"),
        editableSite("helper", "acme.parts")]);
    try testing.assertEqual(loadingTargets(imports, "acme.parts"), "helper->acme.parts");
    try testing.assertEqual(loadingTargets(imports, "helper"), "main->helper");
}

test "the imports a fetched module writes are never offered for removal" {
    let imports = programImports([editableSite("main", "acme.relay")]);
    try testing.assertEqual(loadingTargets(imports, "acme.relay"), "main->acme.relay");
    try testing.assertEqual(loadingTargets(imports, "acme.parts"), "main->acme.relay");
    try testing.assertEqual(loadingTargets(imports, "unknown"), "");
}
