// A file that calls 'frozen()' loads the module declaring 'FrozenList' with no import written, since
// the call may be on an array, and a file that calls no 'frozen()' does not.
import Path from @std.fs;
import @std.testing;
import program.graph;
import GraphResult from program.graph;
import FakeFileLoader from sema_support;
import sema_support;

built(string main) -> GraphResult {
    let loader = new FakeFileLoader();
    loader.add("/stdlib/std/src/collections/frozen.ens", "export final class FrozenList<T> \{\n"
        + "    public constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", main);
    return graph.buildGraph(loader, Path("/proj/src"), Path(""), Path("/stdlib"), ["main.ens"]);
}

test "a call of 'frozen()' loads the module declaring 'FrozenList'" {
    let result = built("main() -> int \{\n"
        + "    int[] values = [1];\n"
        + "    let frozen = values.frozen();\n"
        + "    return 0;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(result.diagnostics());
    let frozenModule = try sema_support.moduleWithPath(result, "std.collections.frozen");
}

test "a file that calls no 'frozen()' does not load it, even when it names the word" {
    let result = built("frozen() -> int \{\n"
        + "    return 0;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int frozen = frozen();\n"
        + "    return frozen;\n"
        + "\}\n");
    try sema_support.assertNoDiagnostics(result.diagnostics());
    try testing.assertTrue(result.moduleWithPath("std.collections.frozen") == null,
        "only a member call of 'frozen()' loads the module");
}
