import @std.testing;
import program.graph;
import Module from program.graph;
import GraphResult from program.graph;
import FakeFileLoader from sema_support;
import sema_support;

test "bare sibling imports load once each and record their edges" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import helper;\nimport util;\n");
    loader.add("/proj/src/helper.ens", "import main;\n");
    loader.add("/proj/src/util.ens", "");
    let result = graph.buildGraph(loader, "/proj/src", "", "/stdlib", ["main.ens"]);

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try sema_support.assertModulePaths(result, ["main", "helper", "util"]);
    let mainModule = try sema_support.moduleWithPath(result, "main");
    try sema_support.assertImports(mainModule, ["helper", "util"]);
    try testing.assertEqual(mainModule.filePath(), "/proj/src/main.ens");
    try testing.assertEqual(mainModule.packagePrefix(), "");
    try testing.assertEqual(mainModule.source().text(), "import helper;\nimport util;\n");
    try testing.assertEqual(mainModule.parseResult().diagnostics().length, 0L);

    let helper = try sema_support.moduleWithPath(result, "helper");
    try sema_support.assertImports(helper, ["main"]);
}

test "package imports converge with the package's own bare imports" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"vendor/acme\";\n"
        + "    member \"vendor/widgets\";\n"
        + "\}\n");
    loader.add("/ws/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency acme;\n"
        + "    dependency acme.widgets;\n"
        + "\}\n");
    loader.add("/ws/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/ws/vendor/widgets/ens.package", "package acme.widgets \{ ens \"0.1\"; \}\n");
    loader.add("/ws/proj/src/main.ens", "import Gadget from @acme.widgets.gadget;\n"
        + "import @acme.tool;\n"
        + "import @acme.widgets.parts.bolt;\n");
    loader.add("/ws/vendor/widgets/src/gadget.ens", "import parts.bolt;\n");
    loader.add("/ws/vendor/widgets/src/parts/bolt.ens", "import gadget;\n");
    loader.add("/ws/vendor/acme/src/tool.ens", "");
    let result = graph.buildGraph(loader, "/ws/proj/src", "", "/stdlib", ["main.ens"]);

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try sema_support.assertModulePaths(result,
        ["main", "acme.widgets.gadget", "acme.tool", "acme.widgets.parts.bolt"]);

    let gadget = try sema_support.moduleWithPath(result, "acme.widgets.gadget");
    try testing.assertEqual(gadget.filePath(), "/ws/vendor/widgets/src/gadget.ens");
    try testing.assertEqual(gadget.packagePrefix(), "acme.widgets");
    try sema_support.assertImports(gadget, ["acme.widgets.parts.bolt"]);

    let bolt = try sema_support.moduleWithPath(result, "acme.widgets.parts.bolt");
    try sema_support.assertImports(bolt, ["acme.widgets.gadget"]);

    let tool = try sema_support.moduleWithPath(result, "acme.tool");
    try testing.assertEqual(tool.filePath(), "/ws/vendor/acme/src/tool.ens");
    try testing.assertEqual(tool.packagePrefix(), "acme");
}

test "a package resolves through its own dependencies, loaded when first reached" {
    let loader = new FakeFileLoader();
    loader.add("/ws/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"vendor/widgets\";\n"
        + "    member \"vendor/base\";\n"
        + "\}\n");
    loader.add("/ws/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency widgets;\n"
        + "\}\n");
    loader.add("/ws/vendor/widgets/ens.package", "package widgets \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency base;\n"
        + "\}\n");
    loader.add("/ws/vendor/base/ens.package", "package base \{ ens \"0.1\"; \}\n");
    loader.add("/ws/proj/src/main.ens", "import @widgets.gadget;\n");
    loader.add("/ws/vendor/widgets/src/gadget.ens", "import @base.core;\n");
    loader.add("/ws/vendor/base/src/core.ens", "");
    let result = graph.buildGraph(loader, "/ws/proj/src", "", "/stdlib", ["main.ens"]);

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try sema_support.assertModulePaths(result, ["main", "widgets.gadget", "base.core"]);
    let core = try sema_support.moduleWithPath(result, "base.core");
    try testing.assertEqual(core.filePath(), "/ws/vendor/base/src/core.ens");
    try testing.assertEqual(core.packagePrefix(), "base");
}

test "the implicitly imported modules load ahead of the program's own seeds" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "");
    let result = graph.buildGraph(loader, "/proj/src", "", "/stdlib", ["main.ens"]);

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try testing.assertEqual(result.modules()[0].canonicalPath(), "std.core");
    let core = try sema_support.moduleWithPath(result, "std.core");
    try testing.assertEqual(core.filePath(), "/stdlib/std/src/core.ens");
    try testing.assertEqual(core.packagePrefix(), "std");
}

test "std imports resolve against the stdlib root and keep their full paths" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import @std.testing;\n");
    loader.add("/stdlib/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    loader.add("/stdlib/std/src/testing.ens", "import @std.collections.list;\n");
    loader.add("/stdlib/std/src/collections/list.ens", "");
    let result = graph.buildGraph(loader, "/proj/src", "", "/stdlib", ["main.ens"]);

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try sema_support.assertModulePaths(result, ["main", "std.testing", "std.collections.list"]);
    let testingModule = try sema_support.moduleWithPath(result, "std.testing");
    try testing.assertEqual(testingModule.filePath(), "/stdlib/std/src/testing.ens");
    try testing.assertEqual(testingModule.packagePrefix(), "std");
    try sema_support.assertImports(testingModule, ["std.collections.list"]);
}

test "repeated seeds and repeated imports load a module once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens", "import Helper from helper;\nimport helper;\n");
    loader.add("/proj/src/helper.ens", "");
    loader.add("/proj/src/extra.ens", "import helper;\n");
    let result = graph.buildGraph(loader, "/proj/src", "", "/stdlib",
        ["main.ens", "main.ens", "extra.ens"]);

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try sema_support.assertModulePaths(result, ["main", "extra", "helper"]);
    let mainModule = try sema_support.moduleWithPath(result, "main");
    try sema_support.assertImports(mainModule, ["helper"]);
}

test "root bare imports fall back from the source root to the tests root" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/logic.ens", "");
    loader.add("/proj/tests/support.ens", "import logic;\n");
    loader.add("/proj/tests/logic_test.ens", "import support;\nimport logic;\n");
    let result = graph.buildGraph(loader, "/proj/src", "/proj/tests", "/stdlib",
        ["logic_test.ens"]);

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try sema_support.assertModulePaths(result, ["logic_test", "support", "logic"]);
    let support = try sema_support.moduleWithPath(result, "support");
    try testing.assertEqual(support.filePath(), "/proj/tests/support.ens");
    let logic = try sema_support.moduleWithPath(result, "logic");
    try testing.assertEqual(logic.filePath(), "/proj/src/logic.ens");
}

test "a single-file program roots its entry file as the main module" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/tool.ens", "import helper;\n");
    loader.add("/proj/src/helper.ens", "import tool;\n");
    let result = graph.buildFileProgram(loader, "/proj/src", "", "/stdlib", "tool.ens");

    try sema_support.assertNoDiagnostics(result.diagnostics());
    try sema_support.assertModulePaths(result, ["main", "helper"]);
    let entry = try sema_support.moduleWithPath(result, "main");
    try testing.assertEqual(entry.filePath(), "/proj/src/tool.ens");
    try sema_support.assertImports(entry, ["helper"]);

    let helper = try sema_support.moduleWithPath(result, "helper");
    try sema_support.assertImports(helper, ["main"]);
}
