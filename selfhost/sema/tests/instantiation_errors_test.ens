import @std.testing;
import FakeFileLoader from sema_support;
import sema_support;

test "type arguments must satisfy class and interface bounds at every reference site" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Shape \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Holder<T: Shape> \{\n"
        + "    T? item;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Chorus<T: Speaker> \{\n"
        + "    T? lead;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Wrong \{\n"
        + "    Holder<int>? numbers;\n"
        + "    Chorus<Shape>? silent;\n"
        + "    Holder<Circle>? fine;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertMentions(found,
        "Type argument 'int' for type parameter 'T' must be 'Shape' or a subclass of it");
    try sema_support.assertMentions(found,
        "Type argument 'Shape' for type parameter 'T' must implement interface 'Speaker'");
    try testing.assertEqual(found.length, 2L);
}

test "a type-parameter argument without a strong enough bound is rejected" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Chorus<T: Speaker> \{\n"
        + "    T? lead;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Free<U> \{\n"
        + "    Chorus<U>? chorus;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Type argument 'U' for type parameter 'T' must implement interface 'Speaker'");
}

test "a struct cycle through a generic instantiation is diagnosed" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Wrap<T> \{\n"
        + "    T item;\n"
        + "\}\n"
        + "struct Loop \{\n"
        + "    Wrap<Loop> inner;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.checkDiagnostics();
    try sema_support.assertMentions(found, "Struct 'Loop' contains itself by value");
    try sema_support.assertMentions(found, "field 'inner' of 'Loop' has type 'Wrap<Loop>'");
    try sema_support.assertMentions(found, "field 'item' of 'Wrap<Loop>' has type 'Loop'");
}

test "a non-defaultable field inside a filled instantiation needs initialization" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Pair<A, B> \{\n"
        + "    A first;\n"
        + "    B second;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    Pair<string, int> at;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Field 'at' of struct 'Corner' has non-nullable type 'Pair<string, int>'");
}

test "override and interface checks stay active across filled generic bases" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Source<T> \{\n"
        + "    get() -> T;\n"
        + "\}\n"
        + "class Box<T> \{\n"
        + "    constructor();\n"
        + "    final peek() -> T? \{ return null; \}\n"
        + "    tag() -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "class Hider extends Box<int> \{\n"
        + "    constructor();\n"
        + "    tag() -> string \{ return \"hidden\"; \}\n"
        + "\}\n"
        + "class Sealed extends Box<int> \{\n"
        + "    constructor();\n"
        + "    override peek() -> int? \{ return null; \}\n"
        + "\}\n"
        + "class Empty implements Source<int> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertMentions(found,
        "Method 'tag' hides a method inherited from 'Box<int>'");
    try sema_support.assertMentions(found,
        "Cannot override 'peek' because it is declared 'final' in 'Box<int>'");
    try sema_support.assertMentions(found,
        "Class 'Empty' implements 'Source<int>' but does not provide 'get() -> int'");
}

test "a concrete class must satisfy abstract methods inherited through a generic base" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "abstract class Producer<T> \{\n"
        + "    constructor();\n"
        + "    abstract produce() -> T;\n"
        + "\}\n"
        + "class Lazy extends Producer<int> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Class 'Lazy' must override abstract method 'produce', or be declared 'abstract'");
}
