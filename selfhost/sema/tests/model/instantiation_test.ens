        + "    B second;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    Pair<int, bool> at;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a bound may name a generic template declared later in the module" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Small \{\n"
        + "    tiny() -> bool;\n"
        + "\}\n"
        + "class Leaf implements Small \{\n"
        + "    constructor();\n"
        + "    override tiny() -> bool \{ return true; \}\n"
        + "\}\n"
        + "class Holder<T: Container<Leaf>> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "interface Container<U: Small> \{\n"
        + "    get() -> U;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "type arguments see implemented interfaces and type-parameter bounds" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Rock implements Speaker \{\n"
        + "    constructor();\n"
        + "    override speak() -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "class Chorus<T: Speaker> \{\n"
        + "    T? lead;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Wrap \{\n"
        + "    Chorus<Rock>? chorus;\n"
        + "\}\n"
        + "struct Free<U: Speaker> \{\n"
        + "    Chorus<U>? chorus;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}
