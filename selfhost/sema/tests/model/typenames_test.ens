// How a type is spelled where no file names it.
import @std.testing;
import model.typenames;
import QuotedCode from model.typenames;
import TypeStore from model.types;
import Visibility from model.types;
import Type from model.types;
import sema_support;
import FakeFileLoader from sema_support;
import Pipeline from sema_support;
import Stage from sema_support;
import PrimitiveKind from model.types;

test "a generic template displays at its own type parameters" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let box = store.addClass("Box", "lib", "", "/proj/src/lib.ens", node, Visibility.Public,
        ["T"], false, false, false);
    let pair = store.addStruct("Pair", "lib", "", "/proj/src/lib.ens", node, Visibility.Public,
        ["A", "B"]);
    let plain = store.addClass("Plain", "lib", "", "/proj/src/lib.ens", node, Visibility.Public,
        [], false, false, false);
    try testing.assertEqual(typenames.display(box), "Box<T>");
    try testing.assertEqual(typenames.display(pair), "Pair<A, B>");
    try testing.assertEqual(typenames.display(store.optionalOf(box)), "Box<T>?");
    try testing.assertEqual(typenames.display(plain), "Plain");
}

test "a type no file names reads by its own declared name" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let alphaKind = store.addEnum("Kind", "alpha.kinds", "", "/proj/src/alpha/kinds.ens", node,
        Visibility.Public);
    let box = store.addClass("Box", "lib", "", "/proj/src/lib.ens", node, Visibility.Public,
        ["T"], false, true, false);
    Type alphaArgument = alphaKind;

    // What an EIR dump and an 'Internal:' message read; a diagnostic spells a type through the
    // names of the file it is reported in, which phases/link_test.ens covers.
    try testing.assertEqual(typenames.display(alphaKind), "Kind");
    try testing.assertEqual(typenames.display(store.instantiationOf(box, [alphaArgument])),
        "Box<Kind>");
    try testing.assertEqual(typenames.display(store.optionalOf(store.arrayOf(alphaKind))), "Kind[]?");
}

test "two types spelled alike are distinguished by the names their file bound" {
    let loader = new FakeFileLoader();
    sema_support.aliasingLibrary(loader);
    loader.add("/proj/src/main.ens",
        "import Kind as SizeKind from lib.sizes;\n"
        + "import Kind as ColorKind from lib.colors;\n"
        + "import Box from lib.sizes;\n"
        + "import lib.colors as coloring;\n"
        + "main() -> int \{\n"
        + "    SizeKind size = coloring.pick();\n"
        + "    Box<SizeKind> boxed = new Box<ColorKind>();\n"
        + "    SizeKind[] sizes = [ColorKind.Red];\n"
        + "    int number = size;\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let reported = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Variable 'size' has type 'SizeKind', but its value has type 'ColorKind'. Declare 'size' as a "
        + "'ColorKind' instead.");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Variable 'boxed' has type 'Box<SizeKind>', but its value has type 'Box<ColorKind>'. Declare "
        + "'boxed' as a 'Box<ColorKind>' instead.");
    try sema_support.assertDiagnostic(reported, 2, "/proj/src/main.ens",
        "Element 1 has type 'ColorKind', but the elements of this array have type 'SizeKind'.");
    try sema_support.assertDiagnostic(reported, 3, "/proj/src/main.ens",
        "Variable 'number' has type 'int', but its value has type 'SizeKind'. Declare 'number' as a "
        + "'SizeKind' instead.");
    try testing.assertEqual(reported.length, 4L);
}

// An import of the type's own name would collide with what this file declares, so the fix binds
// the import to the module's name in front of the type's.
test "a module-qualified type name whose bare name is taken is fixed with an alias" {
    let loader = new FakeFileLoader();
    sema_support.partsLibrary(loader);
    loader.add("/proj/src/main.ens",
        "import lib.parts as parts;\n"
        + "public class Widget \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "keeps(parts.Widget held) \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let reported = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "'parts.Widget' writes a type after a module name, and only a function can be written "
        + "after a module name. Write 'import Widget as PartsWidget from lib.parts;' and then "
        + "write 'PartsWidget'.");
    try testing.assertEqual(reported.length, 1L);
}

test "a function type displays the way the language writes it" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let boolType = store.primitive(PrimitiveKind.Bool);
    let voidType = store.primitive(PrimitiveKind.Void);
    let compare = store.functionOf([intType, intType], intType, []);
    try testing.assertEqual(typenames.display(compare), "(int, int) -> int");
    try testing.assertEqual(typenames.display(store.functionOf([], store.stringType(), [])),
        "() -> string");
    let test = store.functionOf([intType], boolType, []);
    try testing.assertEqual(typenames.display(store.optionalOf(test)), "((int) -> bool)?");
    try testing.assertEqual(typenames.display(store.arrayOf(test)), "((int) -> bool)[]");
    try testing.assertEqual(typenames.display(store.functionOf([intType], test, [])),
        "(int) -> (int) -> bool");
    try testing.assertEqual(typenames.display(store.functionOf([test, intType], voidType, [])),
        "((int) -> bool, int) -> void");
}

// A program whose main file imports one 'Kind', 'Box' and 'Pair' and declares a 'Mode', so the
// other types of those names read with their modules after the quote.
quotingPipeline() -> Pipeline throws {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/alpha/kinds.ens", "public enum Kind \{ One \}\n");
    loader.add("/proj/src/beta/kinds.ens", "public enum Kind \{ Two \}\n");
    loader.add("/proj/src/gamma/kinds.ens", "public enum Kind \{ Three \}\n");
    loader.add("/proj/src/delta/modes.ens", "public enum Mode \{ Fast \}\n");
    loader.add("/proj/src/beta/boxes.ens",
        "public class Box<T> \{\n    public constructor() \{ \}\n\}\n"
        + "public class Pair<A, B> \{\n    public constructor() \{ \}\n\}\n");
    loader.add("/proj/src/gamma/boxes.ens", "public class Box<T> \{\n    public constructor() \{ \}\n\}\n");
    loader.add("/proj/src/main.ens",
        "import Kind from alpha.kinds;\n"
        + "import Box from beta.boxes;\n"
        + "import Pair from beta.boxes;\n"
        + "public enum Mode \{ Slow \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src",
        ["main.ens", "beta/kinds.ens", "gamma/kinds.ens", "delta/modes.ens", "gamma/boxes.ens"]);
    try sema_support.assertClean(pipeline);
    return pipeline;
}

test "a quoted type is followed by the module of each type the file has no clear name for" {
    let pipeline = try quotingPipeline();
    let store = pipeline.store();
    let names = try sema_support.namesOf(pipeline, "main");
    Type clear = try sema_support.declaredType(pipeline, "alpha.kinds", "Kind");
    Type later = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    Type mode = try sema_support.declaredType(pipeline, "delta.modes", "Mode");
    let box = try sema_support.declaredType(pipeline, "beta.boxes", "Box");
    let pair = try sema_support.declaredType(pipeline, "beta.boxes", "Pair");
    let other = try sema_support.declaredType(pipeline, "gamma.boxes", "Box");
    Type number = store.primitive(PrimitiveKind.Int);

    try sema_support.assertReads(names.quoted(clear), "'Kind'");
    try sema_support.assertReads(names.quoted(number), "'int'");
    try sema_support.assertReads(names.quoted(later), "'Kind' (from beta.kinds)");
    try sema_support.assertReads(names.quoted(store.arrayOf(later)), "'Kind[]' (from beta.kinds)");
    try sema_support.assertReads(names.quoted(store.optionalOf(later)), "'Kind?' (from beta.kinds)");
    try sema_support.assertReads(names.quoted(store.instantiationOf(box, [later])),
        "'Box<Kind>' (Kind from beta.kinds)");
    try sema_support.assertReads(names.quoted(store.instantiationOf(pair, [later, mode])),
        "'Pair<Kind, Mode>' (Kind from beta.kinds, Mode from delta.modes)");
    try sema_support.assertReads(names.quoted(other), "'Box<T>' (from gamma.boxes)");
    try sema_support.assertReads(names.quoted(store.instantiationOf(other, [number])),
        "'Box<int>' (from gamma.boxes)");
    try sema_support.assertReads(names.quoted(store.arrayOf(store.instantiationOf(other, [number]))),
        "'Box<int>[]' (from gamma.boxes)");
    try sema_support.assertReads(names.quoted(store.instantiationOf(other, [clear])),
        "'Box<Kind>' (Box from gamma.boxes)");
    try sema_support.assertReads(names.quoted(store.instantiationOf(other, [later])),
        "'Box<Kind>' (Box from gamma.boxes, Kind from beta.kinds)");
    Type predicate = store.functionOf([later], store.primitive(PrimitiveKind.Bool), []);
    try sema_support.assertReads(names.quoted(predicate), "'(Kind) -> bool' (Kind from beta.kinds)");
    try sema_support.assertReads(names.quotedNullable(predicate),
        "'((Kind) -> bool)?' (Kind from beta.kinds)");
    try sema_support.assertReads(names.quotedNullable(later), "'Kind?' (from beta.kinds)");
    try sema_support.assertReads(names.quotedName(other), "'Box' (from gamma.boxes)");
    try sema_support.assertReads(names.quotedName(box), "'Box'");
}

// Each meaning of a name written twice is told apart by where it stands among the names written
// alike; a name written twice for one type needs no position.
test "one name written for two types in a quote says which one by position" {
    let pipeline = try quotingPipeline();
    let store = pipeline.store();
    let names = try sema_support.namesOf(pipeline, "main");
    Type clear = try sema_support.declaredType(pipeline, "alpha.kinds", "Kind");
    Type later = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    Type third = try sema_support.declaredType(pipeline, "gamma.kinds", "Kind");
    let pair = try sema_support.declaredType(pipeline, "beta.boxes", "Pair");

    try sema_support.assertReads(names.quoted(store.instantiationOf(pair, [clear, later])),
        "'Pair<Kind, Kind>' (the second Kind from beta.kinds)");
    try sema_support.assertReads(names.quoted(store.instantiationOf(pair, [later, third])),
        "'Pair<Kind, Kind>' (the first Kind from beta.kinds, the second Kind from gamma.kinds)");
    try sema_support.assertReads(names.quoted(store.instantiationOf(pair, [later, later])),
        "'Pair<Kind, Kind>' (Kind from beta.kinds)");
    try sema_support.assertReads(names.quoted(store.functionOf([later, clear], later, [])),
        "'(Kind, Kind) -> Kind' (the first and third Kind from beta.kinds)");
}

// The code spells each type it writes itself, so every type written is one the note can name.
test "quoted code is followed by the module of each type it writes, by name" {
    let pipeline = try quotingPipeline();
    let store = pipeline.store();
    let names = try sema_support.namesOf(pipeline, "main");
    Type clear = try sema_support.declaredType(pipeline, "alpha.kinds", "Kind");
    Type later = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    let other = try sema_support.declaredType(pipeline, "gamma.boxes", "Box");
    Type boxed = store.instantiationOf(other, [store.primitive(PrimitiveKind.Int)]);

    try sema_support.assertReads(names.quotedCode(["new ", "()"], [boxed]),
        "'new Box<int>()' (Box from gamma.boxes)");
    try sema_support.assertReads(names.quotedCode(["", " k"], [later]), "'Kind k' (Kind from beta.kinds)");
    try sema_support.assertReads(names.quotedCode(["", ".One"], [clear]), "'Kind.One'");
    try sema_support.assertReads(names.quotedCode(["", ".Two == ", ".One"], [later, clear]),
        "'Kind.Two == Kind.One' (the first Kind from beta.kinds)");
    try sema_support.assertReads(names.quotedCode(["", ".Two != ", ".One && k == ", ".Two"],
        [later, clear, later]),
        "'Kind.Two != Kind.One && k == Kind.Two' (the first and third Kind from beta.kinds)");
    Type[] none = [];
    try sema_support.assertReads(names.quotedCode(["return 0;"], none), "'return 0;'");
}

// A name written alone is the declared type's name without its type parameters, which the note
// names the same way.
test "quoted code that writes a declared type by its name alone is followed by its module" {
    let pipeline = try quotingPipeline();
    let names = try sema_support.namesOf(pipeline, "main");
    let clear = try sema_support.declaredType(pipeline, "alpha.kinds", "Kind");
    let later = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    let box = try sema_support.declaredType(pipeline, "beta.boxes", "Box");
    let other = try sema_support.declaredType(pipeline, "gamma.boxes", "Box");

    try sema_support.assertReads(names.quotedNamedCode(["", ".make()"], [other]),
        "'Box.make()' (Box from gamma.boxes)");
    try sema_support.assertReads(names.quotedNamedCode(["", ".make()"], [box]), "'Box.make()'");
    try sema_support.assertReads(names.quotedNamedCode(["", ".Two == ", ".One"], [later, clear]),
        "'Kind.Two == Kind.One' (the first Kind from beta.kinds)");
    try sema_support.assertReads(names.quotedNamedCode(["", ".One and ", ".Two"], [later, later]),
        "'Kind.One and Kind.Two' (Kind from beta.kinds)");
}

// Code written a piece at a time reads the same as quotedCode given those pieces.
test "quoted code written a piece at a time is followed by the module of each type it writes" {
    let pipeline = try quotingPipeline();
    let store = pipeline.store();
    let names = try sema_support.namesOf(pipeline, "main");
    Type later = try sema_support.declaredType(pipeline, "beta.kinds", "Kind");
    let other = try sema_support.declaredType(pipeline, "gamma.boxes", "Box");

    let created = new QuotedCode();
    created.write("new ");
    created.writeType(store.instantiationOf(other, [store.primitive(PrimitiveKind.Int)]));
    created.write("[size]");
    try sema_support.assertReads(created.quotedFor(names), "'new Box<int>[size]' (Box from gamma.boxes)");
    let overload = new QuotedCode();
    overload.write("make(");
    overload.writeType(later);
    overload.write(", ");
    overload.writeType(store.primitive(PrimitiveKind.Int));
    overload.write(")");
    try sema_support.assertReads(overload.quotedFor(names), "'make(Kind, int)' (Kind from beta.kinds)");
    let plain = new QuotedCode();
    plain.write("return 0;");
    try sema_support.assertReads(plain.quotedFor(names), "'return 0;'");
}

// The module reads as an import of it is written in this file: with the '@' of another package,
// and without the package's own name inside it.
test "a module note spells the module the way this file imports it" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/tools\";\n"
        + "\}\n");
    loader.add("/proj/ens.package",
        "package demo.app \{\n    ens \"0.1\";\n    dependency acme.tools;\n\}\n");
    loader.add("/proj/vendor/tools/ens.package", "package acme.tools \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/tools/src/hammer.ens", "export class Hammer \{ \}\n");
    loader.add("/proj/src/sizes/parts.ens", "public enum Kind \{ Two \}\n");
    loader.add("/proj/src/main.ens",
        "import @acme.tools.hammer;\n"
        + "import sizes.parts;\n"
        + "public class Hammer \{ \}\n"
        + "public class Error \{\n    public constructor() \{ \}\n\}\n"
        + "public enum Kind \{ One \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertClean(pipeline);
    let names = try sema_support.namesOf(pipeline, "main");

    try sema_support.assertReads(names.quoted(try sema_support.declaredType(pipeline, "acme.tools.hammer",
        "Hammer")), "'Hammer' (from @acme.tools.hammer)");
    try sema_support.assertReads(names.quoted(try sema_support.declaredType(pipeline, "std.core", "Error")),
        "'Error' (from @std.core)");
    try sema_support.assertReads(names.quoted(try sema_support.declaredType(pipeline, "sizes.parts", "Kind")),
        "'Kind' (from sizes.parts)");
}

// The types an import of a name could bind in a file are those of other modules the file may name,
// another package's where they are exported, in the order of the paths their imports spell.
test "the types a file could import under a name are listed by import path" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/tools\";\n"
        + "\}\n");
    loader.add("/proj/ens.package",
        "package demo.app \{\n    ens \"0.1\";\n    dependency acme.tools;\n\}\n");
    loader.add("/proj/vendor/tools/ens.package", "package acme.tools \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/tools/src/hammer.ens",
        "export class Hammer \{ \}\npublic class Kind \{ \}\n");
    loader.add("/proj/vendor/tools/src/sizes.ens", "export enum Kind \{ Two \}\n");
    loader.add("/proj/src/sizes/parts.ens", "public enum Kind \{ Two \}\n");
    loader.add("/proj/src/colors.ens", "public enum Kind \{ Red \}\n");
    loader.add("/proj/src/hidden.ens", "enum Kind \{ Hidden \}\n");
    loader.add("/proj/src/main.ens",
        "import @acme.tools.hammer;\n"
        + "import @acme.tools.sizes;\n"
        + "import sizes.parts;\n"
        + "import colors;\n"
        + "import hidden;\n"
        + "public enum Kind \{ One \}\n");
    let pipeline = sema_support.analyze(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertClean(pipeline);
    let names = try sema_support.namesOf(pipeline, "main");

    let kinds = names.importableTypesNamed("Kind");
    try testing.assertEqual(kinds.length, 3L);
    try testing.assertTrue(kinds[0] == try sema_support.declaredType(pipeline, "acme.tools.sizes", "Kind"),
        "the package's exported type should come first, under its '@' path");
    try testing.assertTrue(kinds[1] == try sema_support.declaredType(pipeline, "colors", "Kind"),
        "the program's own modules should follow in path order");
    try testing.assertTrue(kinds[2] == try sema_support.declaredType(pipeline, "sizes.parts", "Kind"),
        "a nested module's path should sort after a top-level one");
    try testing.assertEqual(names.importableTypesNamed("Hammer").length, 1L);
    try testing.assertEqual(names.importableTypesNamed("Missing").length, 0L);

    let unreachable = names.unreachableTypesNamed("Kind");
    try testing.assertEqual(unreachable.length, 2L);
    try testing.assertTrue(unreachable[0] == try sema_support.declaredType(pipeline, "acme.tools.hammer", "Kind"),
        "another package's public type is out of reach, listed under its '@' path first");
    try testing.assertTrue(unreachable[1] == try sema_support.declaredType(pipeline, "hidden", "Kind"),
        "a private type of the program's own module is out of reach");
    try testing.assertEqual(names.unreachableTypesNamed("Hammer").length, 0L);
    try testing.assertEqual(names.unreachableTypesNamed("Missing").length, 0L);
}

// Inside a generic declaration a type parameter hides a type of the file under the same name, so a
// message about that type names its module, as it does for any name the file means otherwise.
test "a type a type parameter in scope hides is named with its module" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "public enum Kind \{\n"
        + "    Small,\n"
        + "\}\n"
        + "public kind() -> Kind \{\n"
        + "    return Kind.Small;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Kind from parts;\n"
        + "import parts;\n"
        + "class Holder<Kind> \{\n"
        + "    protected constructor();\n"
        + "\n"
        + "    use() -> int \{\n"
        + "        int inside = parts.kind();\n"
        + "        return inside;\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    int outside = parts.kind();\n"
        + "    return outside;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 2L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens",
        "Variable 'inside' has type 'int', but its value has type 'Kind' (from parts).");
    try sema_support.assertDiagnostic(reported, 1, "/proj/src/main.ens",
        "Variable 'outside' has type 'int', but its value has type 'Kind'. Declare 'outside' as a "
        + "'Kind' instead.");
}

// The phases before the bodies name a hidden type the same way inside a generic declaration, with
// its module at the first mention only: the layout of a class, the conformance check of a struct,
// and the throws validation of a method and of a lambda inside one. A lambda's fix writes its
// function type with the names of the place that type is written.
test "a type a type parameter hides is named with its module in every phase" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "public enum Kind \{\n"
        + "    Small,\n"
        + "\}\n"
        + "public class Failure extends Error \{\n"
        + "    public constructor() \{\n"
        + "        super(\"failure\");\n"
        + "    \}\n"
        + "\}\n"
        + "public fail() throws Failure \{\n"
        + "    throw new Failure();\n"
        + "\}\n"
        + "public failing() -> int throws Failure \{\n"
        + "    throw new Failure();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Kind from parts;\n"
        + "import Failure from parts;\n"
        + "import parts;\n"
        + "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected value() -> Kind \{\n"
        + "        return Kind.Small;\n"
        + "    \}\n"
        + "\}\n"
        + "class Holder<Kind> extends Base \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "    override value() -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "interface Shower \{\n"
        + "    show() -> Kind;\n"
        + "\}\n"
        + "struct Shown<Kind> implements Shower \{\n"
        + "    int count;\n"
        + "    override show() -> int \{\n"
        + "        return 0;\n"
        + "    \}\n"
        + "\}\n"
        + "compute(() -> int f) -> int \{\n"
        + "    return f();\n"
        + "\}\n"
        + "class Thrower<Failure> \{\n"
        + "    protected constructor();\n"
        + "    run() \{\n"
        + "        parts.fail();\n"
        + "    \}\n"
        + "    use() -> int \{\n"
        + "        return compute(() -> try parts.failing());\n"
        + "    \}\n"
        + "\}\n"
        + "class Hider<Failure> \{\n"
        + "    protected constructor();\n"
        + "    compute(() -> int f) -> int \{\n"
        + "        return f();\n"
        + "    \}\n"
        + "    use() -> int \{\n"
        + "        return this.compute(() -> try parts.failing());\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    string file = "/proj/src/main.ens";
    let laidOut = analysis.layoutDiagnostics();
    try testing.assertEqual(laidOut.length, 1L);
    try sema_support.assertDiagnostic(laidOut, 0, file, "Override of 'value' is 'value() -> int', but the "
        + "'value' declared in 'Base' is 'value() -> Kind' (Kind from parts). Change this 'value' to "
        + "match it.");
    let checked = analysis.checkDiagnostics();
    try testing.assertEqual(checked.length, 1L);
    try sema_support.assertDiagnostic(checked, 0, file, "Method 'show' of struct 'Shown' returns 'int', "
        + "but interface 'Shower' requires 'Kind' (from parts). Write 'import Kind as PartsKind from "
        + "parts;' and change the return type of 'show' to 'PartsKind'.");
    let thrown = analysis.exceptionDiagnostics();
    try testing.assertEqual(thrown.length, 3L);
    try sema_support.assertDiagnostic(thrown, 0, file, "Call to 'fail' can throw 'Failure' (from parts). "
        + "Prefix it with 'try', and either catch it with a 'catch' clause or mark this function "
        + "'throws'.");
    try sema_support.assertDiagnostic(thrown, 1, file, "This lambda can throw 'Failure' (from parts), but "
        + "the function type it is given to has no 'throws' list. Add 'throws Failure' after that "
        + "function type's return type, as in '(() -> int throws Failure)', or move the throwing code "
        + "into a named function that catches 'Failure' with a 'catch' clause.");
    try sema_support.assertDiagnostic(thrown, 2, file, "This lambda can throw 'Failure' (from parts), but "
        + "the function type it is given to has no 'throws' list. Write 'import Failure as PartsFailure "
        + "from parts;' and add 'throws PartsFailure' to that function type, as in '(() -> int throws "
        + "PartsFailure)'. Or move the throwing code into a named function that catches 'Failure' with "
        + "a 'catch' clause.");
}

// A lambda passed to a function of another module gets a fix spelled with the names of the file
// that declares the function's parameter type, which can call the same type something else or need
// an import for it, and the refusal names that parameter and points at it.
test "a lambda passed to another module's function is fixed with that module's names" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "public class Failure extends Error \{\n"
        + "    public constructor() \{\n"
        + "        super(\"failure\");\n"
        + "    \}\n"
        + "\}\n"
        + "public failing() -> int throws Failure \{\n"
        + "    throw new Failure();\n"
        + "\}\n");
    loader.add("/proj/src/runner.ens", "import Failure as Problem from parts;\n"
        + "public run(() -> int f) -> int \{\n"
        + "    return f();\n"
        + "\}\n");
    loader.add("/proj/src/plain.ens", "public run(() -> int f) -> int \{\n"
        + "    return f();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import Failure from parts;\n"
        + "import parts;\n"
        + "import runner;\n"
        + "import plain;\n"
        + "main() -> int \{\n"
        + "    return runner.run(() -> try parts.failing()) + plain.run(() -> try parts.failing());\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    let thrown = analysis.exceptionDiagnostics();
    try testing.assertEqual(thrown.length, 2L);
    try sema_support.assertDiagnostic(thrown, 0, "/proj/src/main.ens", "This lambda can throw 'Failure', "
        + "but the type of parameter 'f' of 'run' has no 'throws' list. Add 'throws Problem' there, as in "
        + "'(() -> int throws Problem)', or move the throwing code into a named function that catches "
        + "'Failure' with a 'catch' clause.");
    let declared = try sema_support.relatedOf(thrown[0]);
    try testing.assertEqual(declared.file(), "/proj/src/runner.ens");
    try testing.assertEqual(declared.note(), "parameter 'f' of 'run' is declared here");
    try sema_support.assertDiagnostic(thrown, 1, "/proj/src/main.ens", "This lambda can throw 'Failure', "
        + "but the type of parameter 'f' of 'run' has no 'throws' list. Write 'import Failure from "
        + "parts;' and add 'throws Failure' to it, as in '(() -> int throws Failure)'. Or move the "
        + "throwing code into a named function that catches 'Failure' with a 'catch' clause.");
    let unimported = try sema_support.relatedOf(thrown[1]);
    try testing.assertEqual(unimported.file(), "/proj/src/plain.ens");
    try testing.assertEqual(unimported.note(), "parameter 'f' of 'run' is declared here");
}

// One message writes the module of a type the first time it names the type and not again.
test "a message notes the module of a type only at its first mention" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens", "public class Holder \{\n"
        + "    int secret;\n"
        + "    public constructor() \{\n"
        + "        this.secret = 0;\n"
        + "    \}\n"
        + "\}\n"
        + "public holder() -> Holder \{\n"
        + "    return new Holder();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens", "import parts;\n"
        + "class Holder \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return parts.holder().secret;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    let reported = analysis.bodyDiagnostics();
    try testing.assertEqual(reported.length, 1L);
    try sema_support.assertDiagnostic(reported, 0, "/proj/src/main.ens", "'secret' is private to class "
        + "'Holder' (from parts), so only code inside 'Holder' can use it. Mark it 'public' to use it "
        + "here.");
}
