// Which field a name finds on a hand-built class or struct layout.
import @std.testing;
import model.typemembers;
import Field from model.typemembers;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import Visibility from model.types;
import Type from model.types;
import Span from @ens.frontend.support.source;
import sema_support;

// One instance field for a layout built by hand, at the empty span a declaration would carry.
layoutField(string name, Type type, Visibility visibility, Type owner) -> Field {
    Span nameSpan = {start: 0, length: 0};
    return new Field(name, type, visibility, false, false, false, false, false, nameSpan, owner);
}

test "the field a name reaches on a type leaves out a private base field" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let plain = store.addClass("Plain", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let reuses = store.addClass("Reuses", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    plain.setBase(base);
    reuses.setBase(base);
    Type intType = store.primitive(PrimitiveKind.Int);
    let hidden = layoutField("ticks", intType, Visibility.Private, base);
    let shared = layoutField("shared", intType, Visibility.Protected, base);
    let total = layoutField("total", intType, Visibility.Public, base);
    base.fields().push(hidden);
    base.fields().push(shared);
    base.fields().push(total);
    // Each subclass carries the flattened layout the layout phase builds: the base's three
    // fields at the slots they hold in the base, then its own.
    for (let inherited in base.fields()) {
        plain.fields().push(inherited);
        reuses.fields().push(inherited);
    }
    let own = layoutField("ticks", intType, Visibility.Private, reuses);
    reuses.fields().push(own);

    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(base, "ticks"), 0L);
    try testing.assertTrue(typemembers.inheritedOrOwnField(base, "ticks") == hidden,
        "the class that declares a private field reaches it");

    // 'Plain' holds 'ticks' in its layout at slot 0 and still reaches no field under that name,
    // which is what leaves the name free for a member of its own.
    try testing.assertTrue(plain.fields().get(0) == hidden,
        "the flattened layout carries the private base field");
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(plain, "ticks"), -1L);
    try testing.assertTrue(typemembers.inheritedOrOwnField(plain, "ticks") == null,
        "a subclass does not inherit a private base field");
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(plain, "shared"), 1L);
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(plain, "total"), 2L);
    try testing.assertTrue(typemembers.inheritedOrOwnField(plain, "shared") == shared,
        "a protected base field is inherited");
    try testing.assertTrue(typemembers.inheritedOrOwnField(plain, "total") == total,
        "a public base field is inherited");
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(plain, "absent"), -1L);
    try testing.assertTrue(typemembers.inheritedOrOwnField(plain, "absent") == null,
        "a name no field of the type declares reaches none");

    // The subclass's own field holds a slot of its own, and that slot is the one the name
    // reaches on it, so a write through a 'Reuses' reference never lands in the base's.
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(reuses, "ticks"), 3L);
    try testing.assertTrue(typemembers.inheritedOrOwnField(reuses, "ticks") == own,
        "a subclass field takes the name ahead of the private base field it reuses");

    // A class further down the chain inherits no more than the subclass above it. 'ticks' is
    // private to the base of its base, while the protected and public fields are inherited.
    let leaf = store.addClass("Leaf", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    leaf.setBase(plain);
    for (let inherited in plain.fields()) {
        leaf.fields().push(inherited);
    }
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(leaf, "ticks"), -1L);
    try testing.assertTrue(typemembers.inheritedOrOwnField(leaf, "ticks") == null,
        "a private field of the base's base is not inherited either");
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(leaf, "shared"), 1L);
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(leaf, "total"), 2L);

    let pixel = store.addStruct("Pixel", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, []);
    let corner = layoutField("x", intType, Visibility.Private, pixel);
    pixel.fields().push(corner);
    try testing.assertEqual(typemembers.inheritedOrOwnFieldIndex(pixel, "x"), 0L);
    try testing.assertTrue(typemembers.inheritedOrOwnField(pixel, "x") == corner,
        "a struct declares every field it has, so its own private field reaches");
}
