// The readers both checking and code generation take a literal token's value from.
import @std.testing;
import model.literalvalues;

test "an integer token is read in the base its prefix names, separators and suffix ignored" {
    try testing.assertEqual(literalvalues.integerMagnitude("1_000") ?? 0, 1000);
    try testing.assertEqual(literalvalues.integerMagnitude("0x1F") ?? 0, 31);
    try testing.assertEqual(literalvalues.integerMagnitude("0o755") ?? 0, 493);
    try testing.assertEqual(literalvalues.integerMagnitude("0b1010") ?? 0, 10);
    try testing.assertEqual(literalvalues.integerMagnitude("42L") ?? 0, 42);
    try testing.assertTrue(literalvalues.integerMagnitude("0o78") == null, "8 is no octal digit");
    try testing.assertTrue(literalvalues.integerMagnitude("18446744073709551616") == null,
        "a value past the largest 'ulong' does not parse");
}

test "a character token is read as the code point it names, escapes decoded" {
    try testing.assertEqual(literalvalues.charCodepoint("'a'"), 97);
    try testing.assertEqual(literalvalues.charCodepoint("'\\n'"), 10);
    try testing.assertEqual(literalvalues.charCodepoint("'\\u00e9'"), 233);
    try testing.assertEqual(literalvalues.charCodepoint("'€'"), 8364);
}

test "a string token is read as its UTF-8 bytes, one delimiter dropped from each end" {
    try testing.assertTrue(literalvalues.decodeStringBytes("\"a\\tb\"") == "a\tb".toBytes(),
        "a plain literal drops its quotes and decodes its escapes");
    try testing.assertTrue(literalvalues.decodeStringBytes("\"\\u00e9\"") == "é".toBytes(),
        "a '\\u' escape becomes the character's UTF-8 bytes");
    try testing.assertTrue(literalvalues.decodeStringBytes("\"open \{") == "open ".toBytes(),
        "an interpolation piece drops its quote and the brace after it");
}
