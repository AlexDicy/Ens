import @std.testing;
import model.convert;
import model.types;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import Visibility from model.types;
import Type from model.types;
import sema_support;

test "assignability allows identity, widening, subclasses, and one optional wrap" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    derived.setBase(base);
    Type intType = store.primitive(PrimitiveKind.Int);
    Type longType = store.primitive(PrimitiveKind.Long);
    try testing.assertTrue(convert.isAssignableStrict(intType, intType),
        "the same type is assignable");
    try testing.assertTrue(convert.isAssignableStrict(longType, intType),
        "an int reaches a long by widening");
    try testing.assertFalse(convert.isAssignableStrict(intType, longType),
        "a long does not reach an int");
    try testing.assertTrue(convert.isAssignableStrict(base, derived),
        "a subclass reaches its base");
    try testing.assertFalse(convert.isAssignableStrict(derived, base),
        "a base does not reach its subclass");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(base), derived),
        "a bare value reaches the nullable form of its type");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(base), store.nullType()),
        "null reaches any nullable type");
}

test "assignability wraps once per optional level and never unwraps" {
    let store = new TypeStore();
    Type stringType = store.stringType();
    let once = store.optionalOf(stringType);
    let twice = store.optionalOf(once);
    try testing.assertTrue(convert.isAssignableStrict(twice, stringType),
        "a bare string reaches string?? by wrapping twice");
    try testing.assertTrue(convert.isAssignableStrict(twice, once),
        "a string? reaches string?? by wrapping once");
    try testing.assertTrue(convert.isAssignableStrict(twice, store.nullType()),
        "null fills the outer level of string??");
    try testing.assertFalse(convert.isAssignableStrict(once, twice),
        "a string?? does not reach string?, which would drop a level");
    try testing.assertFalse(convert.isAssignableStrict(stringType, twice),
        "a string?? does not reach a plain string");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(twice), once),
        "a string? reaches string??? by wrapping twice");
}

test "a nullable class payload still accepts a derived value at every level" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    derived.setBase(base);
    let baseTwice = store.optionalOf(store.optionalOf(base));
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(base),
        store.optionalOf(derived)), "Derived? reaches Base?");
    try testing.assertTrue(convert.isAssignableStrict(baseTwice, store.optionalOf(derived)),
        "Derived? reaches Base?? by wrapping once");
    try testing.assertTrue(convert.isAssignableStrict(baseTwice, derived),
        "Derived reaches Base?? by wrapping twice");
}

test "coreOf strips every optional level and bareOf strips one" {
    let store = new TypeStore();
    Type stringType = store.stringType();
    let once = store.optionalOf(stringType);
    let twice = store.optionalOf(once);
    try testing.assertTrue(convert.coreOf(twice) == stringType,
        "string?? has string under every level");
    try testing.assertTrue(convert.coreOf(once) == stringType,
        "string? has string under its level");
    try testing.assertTrue(convert.coreOf(stringType) == stringType,
        "a plain type is its own core");
    try testing.assertTrue(convert.bareOf(twice) == once, "one level off string?? is string?");
    try testing.assertTrue(convert.bareOf(once) == stringType,
        "one level off string? is string");
}

test "unification keeps the deeper optional and refuses nested siblings" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    let other = store.addClass("Other", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    derived.setBase(base);
    other.setBase(base);
    Type stringType = store.stringType();
    let once = store.optionalOf(stringType);
    let twice = store.optionalOf(once);
    try testing.assertTrue(convert.unifyValueTypes(twice, once, store) == twice,
        "string?? and string? meet at string??");
    try testing.assertTrue(convert.unifyValueTypes(twice, store.nullType(), store) == twice,
        "string?? and null meet at string??");
    try testing.assertTrue(convert.unifyValueTypes(store.optionalOf(derived),
        store.optionalOf(other), store) == store.optionalOf(base),
        "two nullable siblings meet at their nullable base");
    try testing.assertTrue(convert.unifyValueTypes(store.optionalOf(store.optionalOf(derived)),
        store.optionalOf(other), store) == null,
        "a doubly-nullable sibling has no common type with a once-nullable one");
}
