import @std.testing;
import model.convert;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import Visibility from model.types;
import Type from model.types;
import sema_support;

test "assignability allows identity, widening, subclasses, and one optional wrap" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    derived.setBase(base);
    Type intType = store.primitive(PrimitiveKind.Int);
    Type longType = store.primitive(PrimitiveKind.Long);
    try testing.assertTrue(convert.isAssignableStrict(intType, intType),
        "the same type is assignable");
    try testing.assertTrue(convert.isAssignableStrict(longType, intType),
        "an int reaches a long by widening");
    try testing.assertFalse(convert.isAssignableStrict(intType, longType),
        "a long does not reach an int");
    try testing.assertTrue(convert.isAssignableStrict(base, derived),
        "a subclass reaches its base");
    try testing.assertFalse(convert.isAssignableStrict(derived, base),
        "a base does not reach its subclass");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(base), derived),
        "a bare value reaches the nullable form of its type");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(base), store.nullType()),
        "null reaches any nullable type");
}

// Every code point fits an 'int' and a 'uint', which are no wider than a 'char', and the wider
// integer types; 'byte', 'short', 'ushort' and the floating-point types do not take one.
test "a char widens to the integer types that have room for every code point" {
    let store = new TypeStore();
    Type charType = store.primitive(PrimitiveKind.Char);
    Type intType = store.primitive(PrimitiveKind.Int);
    for (let kind in [PrimitiveKind.Int, PrimitiveKind.UInt, PrimitiveKind.Long, PrimitiveKind.ULong]) {
        try testing.assertTrue(convert.isAssignableStrict(store.primitive(kind), charType),
            "a char converts to {kind}");
    }
    for (let kind in [PrimitiveKind.Byte, PrimitiveKind.Short, PrimitiveKind.UShort, PrimitiveKind.Float,
            PrimitiveKind.Double]) {
        try testing.assertFalse(convert.isAssignableStrict(store.primitive(kind), charType),
            "a char does not convert to {kind}");
    }
    try testing.assertFalse(convert.isAssignableStrict(charType, intType),
        "an int does not convert to a char");
    try testing.assertTrue(convert.numericCommonType(charType, intType, store) == intType,
        "a char beside an int meets it at 'int'");
}

test "assignability wraps once per optional level and never unwraps" {
    let store = new TypeStore();
    Type stringType = store.stringType();
    let once = store.optionalOf(stringType);
    let twice = store.optionalOf(once);
    try testing.assertTrue(convert.isAssignableStrict(twice, stringType),
        "a bare string reaches string?? by wrapping twice");
    try testing.assertTrue(convert.isAssignableStrict(twice, once),
        "a string? reaches string?? by wrapping once");
    try testing.assertTrue(convert.isAssignableStrict(twice, store.nullType()),
        "null fills the outer level of string??");
    try testing.assertFalse(convert.isAssignableStrict(once, twice),
        "a string?? does not reach string?, which would drop a level");
    try testing.assertFalse(convert.isAssignableStrict(stringType, twice),
        "a string?? does not reach a plain string");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(twice), once),
        "a string? reaches string??? by wrapping twice");
}

test "a nullable number widens under each level of null as its plain type does" {
    let store = new TypeStore();
    Type intType = store.primitive(PrimitiveKind.Int);
    Type longType = store.primitive(PrimitiveKind.Long);
    Type uintType = store.primitive(PrimitiveKind.UInt);
    let intOnce = store.optionalOf(intType);
    let intTwice = store.optionalOf(intOnce);
    let longOnce = store.optionalOf(longType);
    let longTwice = store.optionalOf(longOnce);
    try testing.assertTrue(convert.isAssignableStrict(longOnce, intOnce), "an int? reaches long?");
    try testing.assertTrue(convert.isAssignableStrict(longTwice, intTwice),
        "an int?? reaches long??");
    try testing.assertTrue(convert.isAssignableStrict(longTwice, intOnce),
        "an int? reaches long?? by widening and wrapping once");
    let doubleOnce = store.optionalOf(store.primitive(PrimitiveKind.Double));
    try testing.assertTrue(convert.isAssignableStrict(doubleOnce, intOnce), "an int? reaches double?");
    try testing.assertFalse(convert.isAssignableStrict(intOnce, longOnce),
        "a long? does not reach int?, which would narrow");
    try testing.assertFalse(convert.isAssignableStrict(longOnce, intTwice),
        "an int?? does not reach long?, which would drop a level");
    try testing.assertFalse(convert.isAssignableStrict(store.optionalOf(uintType), intOnce),
        "an int? does not reach uint?, as an int does not reach a uint");
}

test "numbers meet at their common number under the most levels of null either has" {
    let store = new TypeStore();
    Type intType = store.primitive(PrimitiveKind.Int);
    Type longType = store.primitive(PrimitiveKind.Long);
    Type uintType = store.primitive(PrimitiveKind.UInt);
    let intOnce = store.optionalOf(intType);
    let longOnce = store.optionalOf(longType);
    let longTwice = store.optionalOf(longOnce);
    try testing.assertTrue(convert.numericCommonType(intOnce, longType, store) == longOnce,
        "int? and long meet at long?");
    try testing.assertTrue(convert.numericCommonType(longType, intOnce, store) == longOnce,
        "the order of the sides does not change where they meet");
    try testing.assertTrue(convert.numericCommonType(store.optionalOf(intOnce), longOnce, store)
        == longTwice, "int?? and long? meet at long??");
    try testing.assertTrue(convert.numericCommonType(intOnce, intType, store) == intOnce,
        "int? and int meet at int?");
    try testing.assertTrue(convert.numericCommonType(intOnce, uintType, store) == null,
        "int? and uint do not meet, as int and uint do not");
    try testing.assertTrue(convert.numericCommonType(store.optionalOf(store.stringType()),
        store.stringType(), store) == null, "a string is no number");
    try testing.assertTrue(convert.unifyValueTypes(intOnce, longType, store) == longOnce,
        "the values of a '?:' meet at the common number");
}

test "a nullable class payload still accepts a derived value at every level" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    derived.setBase(base);
    let baseTwice = store.optionalOf(store.optionalOf(base));
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(base),
        store.optionalOf(derived)), "Derived? reaches Base?");
    try testing.assertTrue(convert.isAssignableStrict(baseTwice, store.optionalOf(derived)),
        "Derived? reaches Base?? by wrapping once");
    try testing.assertTrue(convert.isAssignableStrict(baseTwice, derived),
        "Derived reaches Base?? by wrapping twice");
}

test "coreOf strips every optional level and bareOf strips one" {
    let store = new TypeStore();
    Type stringType = store.stringType();
    let once = store.optionalOf(stringType);
    let twice = store.optionalOf(once);
    try testing.assertTrue(convert.coreOf(twice) == stringType,
        "string?? has string under every level");
    try testing.assertTrue(convert.coreOf(once) == stringType,
        "string? has string under its level");
    try testing.assertTrue(convert.coreOf(stringType) == stringType,
        "a plain type is its own core");
    try testing.assertTrue(convert.bareOf(twice) == once, "one level off string?? is string?");
    try testing.assertTrue(convert.bareOf(once) == stringType,
        "one level off string? is string");
}

test "unification keeps the deeper optional and refuses nested siblings" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    let other = store.addClass("Other", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    derived.setBase(base);
    other.setBase(base);
    Type stringType = store.stringType();
    let once = store.optionalOf(stringType);
    let twice = store.optionalOf(once);
    try testing.assertTrue(convert.unifyValueTypes(twice, once, store) == twice,
        "string?? and string? meet at string??");
    try testing.assertTrue(convert.unifyValueTypes(twice, store.nullType(), store) == twice,
        "string?? and null meet at string??");
    try testing.assertTrue(convert.unifyValueTypes(store.optionalOf(derived),
        store.optionalOf(other), store) == store.optionalOf(base),
        "two nullable siblings meet at their nullable base");
    try testing.assertTrue(convert.unifyValueTypes(store.optionalOf(store.optionalOf(derived)),
        store.optionalOf(other), store) == null,
        "a doubly-nullable sibling has no common type with a once-nullable one");
}

test "a generic type reaches itself written at its own type parameters" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let box = store.addClass("Box", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        ["T"], false, false, false);
    let parameter = store.typeParameter(node, 0, "T");
    box.setTypeParameterTypes([parameter]);
    Type atOwnParameter = store.instantiationOf(box, [parameter]);
    Type atInt = store.instantiationOf(box, [store.primitive(PrimitiveKind.Int)]);
    try testing.assertTrue(convert.isAssignableStrict(atOwnParameter, box),
        "the bare type 'this' has inside Box<T> reaches Box<T>");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(atOwnParameter), box),
        "and reaches Box<T>? by wrapping once");
    try testing.assertFalse(convert.isAssignableStrict(atInt, box),
        "the bare type does not reach Box<int>, whose argument is not the parameter");
    try testing.assertFalse(convert.isAssignableStrict(atOwnParameter, atInt),
        "Box<int> does not reach Box<T>");
}

test "assignability between function types is invariant" {
    try sema_support.assertOnlyProblem("take((long, long) -> long order) \{ \}\n"
        + "main() -> int \{\n"
        + "    (int, int) -> int order = (a, b) -> a - b;\n"
        + "    take(order);\n"
        + "    return 0;\n"
        + "\}\n",
        "Argument 1 of 'take' has type '(int, int) -> int', but parameter 'order' has type '(long, long) "
            + "-> long'.");
}

// A type parameter with a class bound converts as that class does, since every type argument is that
// class or a subclass of it, at every optional level. One with only an interface bound converts to no
// interface, since a struct or a primitive may satisfy that bound and none of them converts to one. Values
// of such parameters, and of their bounds' subclasses, meet at the nearest class they share.
test "a type parameter with a class bound converts as its bound does" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let named = store.addInterface("Named", "app", "", "/proj/src/app.ens", node, Visibility.Public, []);
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    base.setInterfaces([named]);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    derived.setBase(base);
    let bounded = store.typeParameter(node, 0, "T");
    bounded.setBounds([base]);
    let onlyNamed = store.typeParameter(node, 1, "U");
    onlyNamed.setBounds([named]);
    let alsoBounded = store.typeParameter(node, 2, "V");
    alsoBounded.setBounds([base]);
    try testing.assertTrue(convert.isAssignableStrict(base, bounded), "a 'T: Base' reaches 'Base'");
    try testing.assertTrue(convert.isAssignableStrict(named, bounded),
        "a 'T: Base' reaches an interface 'Base' implements");
    try testing.assertTrue(convert.isAssignableStrict(store.optionalOf(base), store.optionalOf(bounded)),
        "a 'T?' reaches 'Base?'");
    try testing.assertFalse(convert.isAssignableStrict(derived, bounded),
        "a 'T: Base' does not reach a subclass of 'Base'");
    try testing.assertFalse(convert.isAssignableStrict(bounded, base), "a 'Base' does not reach 'T'");
    try testing.assertFalse(convert.isAssignableStrict(named, onlyNamed),
        "a 'U: Named' does not reach 'Named'");
    try testing.assertTrue(convert.unifyValueTypes(bounded, base, store) == base,
        "a 'T: Base' and a 'Base' meet at 'Base'");
    try testing.assertTrue(convert.unifyValueTypes(bounded, alsoBounded, store) == base,
        "a 'T: Base' and a 'V: Base' meet at 'Base'");
    try testing.assertTrue(convert.unifyValueTypes(derived, bounded, store) == base,
        "a 'Derived' and a 'T: Base' meet at 'Base'");
    try testing.assertTrue(
        convert.unifyValueTypes(store.optionalOf(bounded), derived, store) == store.optionalOf(base),
        "a 'T?' and a 'Derived' meet at 'Base?'");
    try testing.assertTrue(convert.unifyValueTypes(onlyNamed, base, store) == null,
        "a 'U: Named' and a 'Base' do not meet");
}
