import @std.testing;
import @ens.frontend.support.source;
import LocalBinding from model.scopes;
import BindingKind from model.scopes;
import model.narrow;
import NarrowingPath from model.narrow;
import NarrowingState from model.narrow;
import NarrowingEnd from model.narrow;
import NarrowingEndKind from model.narrow;
import PathSegment from model.narrow;
import Field from model.typemembers;
import Type from model.types;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import Visibility from model.types;
import List from @std.collections.list;
import Map from @std.collections.map;

binding(string name, Type type) -> LocalBinding {
    return new LocalBinding(name, type, BindingKind.Variable, false, source.makeSpan(0, 0));
}

pathOf(LocalBinding root, List<PathSegment> segments) -> NarrowingPath {
    return new NarrowingPath(root, segments);
}

fieldPath(LocalBinding root, string field) -> NarrowingPath {
    let segments = new List<PathSegment>();
    segments.push(narrow.fieldSegment(field));
    return new NarrowingPath(root, segments);
}

// An assignment written at offset 'at'.
write(long at) -> NarrowingEnd {
    return new NarrowingEnd(NarrowingEndKind.Assigned, source.makeSpan(at, 1), null, "", "value", null);
}

test "paths compare and hash by content" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("root", intType);
    let other = binding("other", intType);

    try testing.assertTrue(narrow.bindingPath(root) == narrow.bindingPath(root),
        "two spellings of the same root should be equal");
    try testing.assertTrue(narrow.bindingPath(root).hash() == narrow.bindingPath(root).hash(),
        "equal paths should hash equally");
    try testing.assertTrue(narrow.bindingPath(root) != narrow.bindingPath(other),
        "distinct roots should differ");

    try testing.assertTrue(fieldPath(root, "door") == fieldPath(root, "door"),
        "field segments should compare by name");
    try testing.assertTrue(fieldPath(root, "door").hash() == fieldPath(root, "door").hash(),
        "equal field paths should hash equally");
    try testing.assertTrue(fieldPath(root, "door") != fieldPath(root, "window"),
        "different field names should differ");
    try testing.assertTrue(fieldPath(root, "door") != narrow.bindingPath(root),
        "a longer path should differ from its root");
}

// Each pass over a loop declares the locals inside it again, so what a pass learns about such a local
// is found on the next pass by where the local is declared.
test "paths of bindings declared at the same place match by declaration but not by identity" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let first = new LocalBinding("inner", intType, BindingKind.Variable, false, source.makeSpan(40, 5));
    let again = new LocalBinding("inner", intType, BindingKind.Variable, false, source.makeSpan(40, 5));
    let elsewhere = new LocalBinding("inner", intType, BindingKind.Variable, false, source.makeSpan(90, 5));

    try testing.assertTrue(narrow.bindingPath(first) != narrow.bindingPath(again),
        "bindings declared again should stay distinct roots");
    try testing.assertTrue(narrow.bindingPath(first).sameDeclaration(narrow.bindingPath(again)),
        "bindings declared at the same place should match by declaration");
    try testing.assertTrue(fieldPath(first, "door").sameDeclaration(fieldPath(again, "door")),
        "the same fields after bindings declared at the same place should match");
    try testing.assertFalse(fieldPath(first, "door").sameDeclaration(fieldPath(again, "window")),
        "different fields should not match");
    try testing.assertFalse(narrow.bindingPath(first).sameDeclaration(narrow.bindingPath(elsewhere)),
        "bindings declared at different places should not match");
}

test "state layers narrow, look up innermost-first, and pop cleanly" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let longType = store.primitive(PrimitiveKind.Long);
    let root = binding("value", optionalInt);
    let state = new NarrowingState();

    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "an unproven path reads as null");
    state.narrow(narrow.bindingPath(root), intType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "a narrowed path reads its proven type");

    state.push();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "an inner layer sees the outer proof");
    state.narrow(narrow.bindingPath(root), longType);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == longType,
        "the innermost proof wins");
    state.pop();
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "popping a layer restores the outer proof");
}

test "invalidation erases across every layer" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("room", intType);
    let unrelated = binding("other", intType);
    let state = new NarrowingState();

    state.narrow(fieldPath(root, "door"), intType);
    state.push();
    state.narrow(narrow.bindingPath(root), intType);
    state.narrow(fieldPath(unrelated, "door"), intType);

    state.clearForRoot(root, write(0));
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == null,
        "a root clear drops the binding's own narrowing");
    try testing.assertTrue(state.provenType(fieldPath(root, "door")) == null,
        "a root clear drops a member path, even in an outer layer");
    try testing.assertTrue(state.provenType(fieldPath(unrelated, "door")) == intType,
        "paths under other roots are untouched");
}

test "a deeper write drops the paths it prefixes and nothing shorter" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let house = binding("house", intType);
    let state = new NarrowingState();

    let roomDoor = new List<PathSegment>();
    roomDoor.push(narrow.fieldSegment("room"));
    roomDoor.push(narrow.fieldSegment("door"));
    state.narrow(fieldPath(house, "room"), intType);
    state.narrow(pathOf(house, roomDoor), intType);

    let written = new List<PathSegment>();
    written.push(narrow.fieldSegment("room"));
    written.push(narrow.fieldSegment("door"));
    state.clearPrefixedBy(pathOf(house, written), write(0));
    try testing.assertTrue(state.provenType(fieldPath(house, "room")) == intType,
        "writing house.room.door keeps the shorter house.room narrowing");
    let reread = new List<PathSegment>();
    reread.push(narrow.fieldSegment("room"));
    reread.push(narrow.fieldSegment("door"));
    try testing.assertTrue(state.provenType(pathOf(house, reread)) == null,
        "writing house.room.door drops house.room.door itself");

    state.narrow(pathOf(house, roomDoor), intType);
    state.clearPrefixedBy(fieldPath(house, "room"), write(0));
    try testing.assertTrue(state.provenType(pathOf(house, roomDoor)) == null,
        "writing house.room drops the deeper house.room.door narrowing");

    let other = binding("other", intType);
    state.narrow(fieldPath(house, "room"), intType);
    state.clearPrefixedBy(fieldPath(other, "room"), write(0));
    try testing.assertTrue(state.provenType(fieldPath(house, "room")) == intType,
        "a write under another root keeps the path");
}

typeLevelField(string name, Type type) -> Field {
    return new Field(name, type, Visibility.Public, false, true, false, true, source.makeSpan(0, 0),
        source.makeSpan(0, 0), type);
}

test "a type-level root compares by field identity and clears only its own paths" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let label = typeLevelField("label", optionalInt);
    let other = typeLevelField("label", optionalInt);
    let local = binding("label", optionalInt);

    try testing.assertTrue(narrow.typeLevelPath(label) == narrow.typeLevelPath(label),
        "two reads of one field should be one path");
    try testing.assertTrue(narrow.typeLevelPath(label).hash() == narrow.typeLevelPath(label).hash(),
        "equal type-level paths should hash equally");
    try testing.assertTrue(narrow.typeLevelPath(label) != narrow.typeLevelPath(other),
        "two fields of one name should be two paths");
    try testing.assertTrue(narrow.typeLevelPath(label) != narrow.bindingPath(local),
        "a field root should differ from a binding of the same name");

    let name = narrow.fieldSegment("name");
    try testing.assertTrue(narrow.typeLevelPath(label).extended(name)
        == narrow.typeLevelPath(label).extended(narrow.fieldSegment("name")),
        "an extended path should compare by its segments");
    try testing.assertTrue(narrow.typeLevelPath(label).extended(name) != narrow.typeLevelPath(label),
        "an extended path should differ from its root");

    let state = new NarrowingState();
    state.narrow(narrow.typeLevelPath(label).extended(name), intType);
    state.narrow(narrow.typeLevelPath(other).extended(name), intType);
    state.clearPrefixedBy(narrow.typeLevelPath(other), write(0));
    state.clearForRoot(local, write(0));
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(label).extended(name)) == intType,
        "clearing another field or a binding should keep this field's path");
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(other).extended(name)) == null,
        "clearing a field should drop the paths it prefixes");
}

test "a type-level path and a binding path never prefix each other" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let intType = store.primitive(PrimitiveKind.Int);
    let label = typeLevelField("label", optionalInt);
    let local = binding("label", optionalInt);
    let name = narrow.fieldSegment("name");
    let state = new NarrowingState();

    state.narrow(narrow.typeLevelPath(label).extended(name), intType);
    state.narrow(narrow.bindingPath(local).extended(name), intType);
    state.clearPrefixedBy(narrow.bindingPath(local), write(0));
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(label).extended(name)) == intType,
        "a write to a binding should keep a type-level path under a field of the same name");
    try testing.assertTrue(state.provenType(narrow.bindingPath(local).extended(name)) == null,
        "a write to a binding should drop the paths it prefixes");

    state.narrow(narrow.bindingPath(local).extended(name), intType);
    state.clearPrefixedBy(narrow.typeLevelPath(label), write(0));
    try testing.assertTrue(state.provenType(narrow.bindingPath(local).extended(name)) == intType,
        "clearing a type-level path should keep a binding path of the same name");
    try testing.assertTrue(state.provenType(narrow.typeLevelPath(label).extended(name)) == null,
        "clearing a type-level path should drop the paths it prefixes");
}

test "two sets of proofs are the same when they prove the same type for the same paths" {
    let store = new TypeStore();
    Type intType = store.primitive(PrimitiveKind.Int);
    Type longType = store.primitive(PrimitiveKind.Long);
    let value = binding("value", store.optionalOf(intType));
    let count = binding("count", store.optionalOf(longType));
    let left = new Map<NarrowingPath, Type>();
    left.set(narrow.bindingPath(value), intType);
    let right = new Map<NarrowingPath, Type>();
    right.set(narrow.bindingPath(value), intType);
    try testing.assertTrue(narrow.sameProofs(left, right));
    right.set(narrow.bindingPath(count), longType);
    try testing.assertFalse(narrow.sameProofs(left, right));
    left.set(narrow.bindingPath(count), intType);
    try testing.assertFalse(narrow.sameProofs(left, right));
}

test "a path names the type of its root and the fields after it" {
    let store = new TypeStore();
    let optionalInt = store.optionalOf(store.primitive(PrimitiveKind.Int));
    let local = binding("room", optionalInt);
    let label = typeLevelField("label", optionalInt);
    let path = fieldPath(local, "door").extended(narrow.fieldSegment("code"));
    try testing.assertTrue(path.rootType() == optionalInt, "a binding path reads its binding's type");
    try testing.assertTrue(narrow.typeLevelPath(label).rootType() == optionalInt,
        "a type-level path reads its field's type");
    try testing.assertEqual(string.joined(path.fieldNames(), "."), "door.code");
    try testing.assertEqual(narrow.bindingPath(local).fieldNames().length, 0L);
}

test "a state starts from given proofs, and a copy keeps its own layers" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let optionalInt = store.optionalOf(intType);
    let root = binding("value", optionalInt);
    let other = binding("other", optionalInt);
    let proven = new Map<NarrowingPath, Type>();
    proven.set(narrow.bindingPath(root), intType);
    let state = new NarrowingState(proven);
    try testing.assertTrue(state.provenType(narrow.bindingPath(root)) == intType,
        "a state holds the proofs it starts from");

    state.push();
    state.narrow(narrow.bindingPath(other), intType);
    let copied = state.copy();
    copied.pop();
    try testing.assertTrue(copied.provenType(narrow.bindingPath(other)) == null,
        "a copy pops its own layers");
    try testing.assertTrue(state.provenType(narrow.bindingPath(other)) == intType,
        "popping a copy leaves the original's layers");
    try testing.assertTrue(copied.provenType(narrow.bindingPath(root)) == intType,
        "a copy keeps the outer proofs");
}

test "a write that drops a proof is recorded until a proof of the path holds again" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("value", store.optionalOf(intType));
    let untouched = binding("other", store.optionalOf(intType));
    let path = narrow.bindingPath(root);
    let state = new NarrowingState();

    state.clearForRoot(untouched, write(3));
    try testing.assertTrue(state.endOf(narrow.bindingPath(untouched)) == null,
        "a write that drops no proof is not recorded");

    state.narrow(path, intType);
    state.push();
    state.clearForRoot(root, write(5));
    let ended = state.endOf(path);
    try testing.assertTrue(ended != null, "the write that dropped the proof is recorded");
    if (ended != null) {
        try testing.assertEqual(ended.at().start, 5L);
        try testing.assertTrue(ended.kind() == NarrowingEndKind.Assigned, "the write is an assignment");
    }
    let snapshot = state.snapshotLayers();
    state.push();
    state.narrow(path, intType);
    try testing.assertTrue(state.endOf(path) == null, "a proof made after the write hides it");
    state.pop();
    try testing.assertTrue(state.endOf(path) != null, "popping that proof shows the write again");
    state.restoreLayers(snapshot);
    try testing.assertTrue(state.endOf(path) != null, "a snapshot keeps the write");
    state.pop();
    try testing.assertTrue(state.endOf(path) != null,
        "a write in a branch that drops a proof made outside it is recorded outside it too");

    let inner = narrow.bindingPath(untouched);
    state.push();
    state.narrow(inner, intType);
    state.clearForRoot(untouched, write(7));
    try testing.assertTrue(state.endOf(inner) != null, "the write that dropped the inner proof is recorded");
    state.pop();
    try testing.assertTrue(state.endOf(inner) == null,
        "a write that drops a proof made in a branch ends with the branch");
}

// A later write to a path whose proof an earlier write ended is what a read after it is told about,
// in the layer that records the earlier write, so it outlasts the branch it is in. A path that holds a
// proof again keeps the write that ended its proof before.
test "a later write is recorded as what ended a path no proof holds for" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let root = binding("value", store.optionalOf(intType));
    let path = narrow.bindingPath(root);
    let state = new NarrowingState();

    state.renewForRoot(root, write(2));
    try testing.assertTrue(state.endOf(path) == null,
        "a write records nothing where no write ended a proof");
    state.narrow(path, intType);
    state.clearForRoot(root, write(4));
    state.push();
    state.renewForRoot(root, write(6));
    state.pop();
    let renewed = state.endOf(path);
    try testing.assertTrue(renewed != null, "the later write is recorded");
    if (renewed != null) {
        try testing.assertEqual(renewed.at().start, 6L);
    }
    state.push();
    state.narrow(path, intType);
    state.renewForRoot(root, write(8));
    state.pop();
    let kept = state.endOf(path);
    if (kept != null) {
        try testing.assertEqual(kept.at().start, 6L);
    }
    try testing.assertTrue(kept != null, "a write where a proof holds leaves the earlier one recorded");
}

// Ending a proof records the write in the layer that held the proof, and where no layer holds a proof of
// the path or records a write that ended one, in the top layer, which takes it along when it is popped.
test "ending a proof records the write where the proof was, or else in the top layer" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let path = narrow.bindingPath(binding("value", store.optionalOf(intType)));
    let unproven = narrow.bindingPath(binding("other", store.optionalOf(intType)));
    let state = new NarrowingState();

    state.narrow(path, intType);
    state.push();
    state.endProof(path, write(3));
    state.pop();
    let ended = state.endOf(path);
    try testing.assertTrue(state.provenType(path) == null && ended != null,
        "the write is recorded in the layer that held the proof");
    if (ended != null) {
        try testing.assertEqual(ended.at().start, 3L);
    }

    state.push();
    state.endProof(unproven, write(5));
    let recorded = state.endOf(unproven);
    try testing.assertTrue(recorded != null, "with no proof held, the write is recorded in the top layer");
    if (recorded != null) {
        try testing.assertEqual(recorded.at().start, 5L);
    }
    state.pop();
    try testing.assertTrue(state.endOf(unproven) == null, "popping the top layer takes the write along");
}

// A state reads only the layers that have held something, so a proof is found past any number of empty
// layers, a popped layer takes its proofs along, and a copy or a restored snapshot reads the same layers.
test "a state finds proofs past empty layers and after a pop, a copy or a restore" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let optionalInt = store.optionalOf(intType);
    let outerRoot = binding("outer", optionalInt);
    let outer = narrow.bindingPath(outerRoot);
    let inner = narrow.bindingPath(binding("inner", optionalInt));
    let state = new NarrowingState();
    state.narrow(outer, intType);
    for (long i = 0; i < 20; i++) {
        state.push();
    }
    let snapshot = state.snapshotLayers();
    state.narrow(inner, intType);
    let copied = state.copy();
    try testing.assertTrue(state.provenType(outer) == intType, "a proof is found past empty layers");
    state.clearForRoot(outerRoot, write(3));
    try testing.assertTrue(state.endOf(outer) != null, "a write past empty layers is recorded");
    state.pop();
    try testing.assertTrue(state.provenType(inner) == null, "a popped layer takes its proofs along");
    state.push();
    state.narrow(inner, intType);
    try testing.assertTrue(state.provenType(inner) == intType, "a layer pushed again holds a new proof");
    try testing.assertTrue(copied.provenType(outer) == intType && copied.provenType(inner) == intType,
        "a copy reads the layers the original held");
    state.restoreLayers(snapshot);
    try testing.assertTrue(state.provenType(outer) == intType && state.provenType(inner) == null,
        "a restored snapshot reads the layers it held");
}

// The branches of a statement each start from what holds where the branches start: what a branch changes
// in the layers that hold there is put back after it, and the places it changed are those changes and
// what the layers it pushed hold. A statement inside a branch puts back its own changes.
test "branches put back what they change where they start, and name the places they change" {
    let store = new TypeStore();
    let intType = store.primitive(PrimitiveKind.Int);
    let optionalInt = store.optionalOf(intType);
    let kept = narrow.bindingPath(binding("kept", optionalInt));
    let written = binding("written", optionalInt);
    let tested = narrow.bindingPath(binding("tested", optionalInt));
    let state = new NarrowingState();
    state.narrow(kept, intType);
    state.narrow(narrow.bindingPath(written), intType);

    state.startBranches();
    state.push();
    state.clearForRoot(written, write(4));
    state.narrow(tested, intType);
    let changed = state.changedPlaces();
    try testing.assertTrue(changed.contains(narrow.bindingPath(written)) && changed.contains(tested),
        "a branch changes what it writes and what it proves");
    try testing.assertEqual(changed.length(), 2L);
    state.restartBranches();
    try testing.assertTrue(state.provenType(narrow.bindingPath(written)) == intType,
        "the next branch starts with the proof the write dropped");
    try testing.assertTrue(state.endOf(narrow.bindingPath(written)) == null,
        "the next branch starts with no write recorded as what ended it");
    try testing.assertTrue(state.provenType(tested) == null,
        "the next branch starts without the layer pushed");

    state.push();
    state.startBranches();
    state.clearPath(kept);
    state.endBranches();
    try testing.assertTrue(state.provenType(kept) == intType, "a statement inside puts back its own changes");
    try testing.assertTrue(state.changedPlaces().isEmpty(), "what a statement inside puts back is no change");
    state.clearPath(kept);
    try testing.assertTrue(state.changedPlaces().contains(kept), "a change after it is one");
    state.endBranches();
    try testing.assertTrue(state.provenType(kept) == intType, "ending the branches puts back their changes");

    state.startBranches();
    state.endProof(tested, write(9));
    try testing.assertTrue(state.endOf(tested) != null && state.changedPlaces().contains(tested),
        "a write recorded where no proof was is a change");
    state.endBranches();
    try testing.assertTrue(state.endOf(tested) == null, "ending the branches puts back that write too");
}
