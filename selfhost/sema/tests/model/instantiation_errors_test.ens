import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "type arguments must satisfy class and interface bounds at every reference site" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Circle extends Shape \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Holder<T: Shape> \{\n"
        + "    T? item;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Chorus<T: Speaker> \{\n"
        + "    T? lead;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Wrong \{\n"
        + "    Holder<int>? numbers;\n"
        + "    Chorus<Shape>? silent;\n"
        + "    Holder<Circle>? fine;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type argument 'int' for type parameter 'T' must be 'Shape' or a subclass of it.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Type argument 'Shape' for type parameter 'T' must implement interface 'Speaker'.");
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
}

test "a type-parameter argument without a strong enough bound is rejected" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Chorus<T: Speaker> \{\n"
        + "    T? lead;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Free<U> \{\n"
        + "    Chorus<U>? chorus;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type argument 'U' for type parameter 'T' must implement interface 'Speaker'.");
    try testing.assertEqual(found.length, 1L);
}

test "a bound naming a generic template declared later in the module is checked" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Small \{\n"
        + "    tiny() -> bool;\n"
        + "\}\n"
        + "class Grow \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Holder<T: Container<Grow>> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "interface Container<U: Small> \{\n"
        + "    get() -> U;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type argument 'Grow' for type parameter 'U' must implement interface 'Small'.");
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
}

test "the same bound violation is diagnosed when the template comes first" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Small \{\n"
        + "    tiny() -> bool;\n"
        + "\}\n"
        + "class Grow \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "interface Container<U: Small> \{\n"
        + "    get() -> U;\n"
        + "\}\n"
        + "class Holder<T: Container<Grow>> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type argument 'Grow' for type parameter 'U' must implement interface 'Small'.");
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
}

test "a struct cycle through a generic instantiation is diagnosed" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Wrap<T> \{\n"
        + "    T item;\n"
        + "\}\n"
        + "struct Loop \{\n"
        + "    Wrap<Loop> inner;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Struct 'Loop' contains itself by value: field 'inner' of 'Loop' has type 'Wrap<Loop>', "
        + "and field 'item' of 'Wrap<Loop>' has type 'Loop'. A struct's fields are stored inline, "
        + "so this one would have no end. Break the cycle, for example by making 'Wrap' a class "
        + "('class Wrap \{ ... \}') so the field holds a reference.");
    try testing.assertEqual(found.length, 1L);
}

test "a non-defaultable field inside a filled instantiation is accepted" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Pair<A, B> \{\n"
        + "    A first;\n"
        + "    B second;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    Pair<string, int> at;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "override and interface checks stay active across filled generic bases" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Source<T> \{\n"
        + "    get() -> T;\n"
        + "\}\n"
        + "class Box<T> \{\n"
        + "    protected constructor();\n"
        + "    protected final peek() -> T? \{ return null; \}\n"
        + "    protected tag() -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "class Hider extends Box<int> \{\n"
        + "    constructor();\n"
        + "    tag() -> string \{ return \"hidden\"; \}\n"
        + "\}\n"
        + "class Sealed extends Box<int> \{\n"
        + "    constructor();\n"
        + "    protected override peek() -> int? \{ return null; \}\n"
        + "\}\n"
        + "class Empty implements Source<int> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'tag' hides a method inherited from 'Box<int>'; mark it 'override' to replace "
        + "it, or rename it.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Cannot override 'peek' because it is declared 'final' in 'Box<int>'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Class 'Empty' implements 'Source<int>' but does not provide 'get() -> int'. Declare the "
        + "method, or inherit it from a base class.");
    try testing.assertEqual(found.length, 3L);
}

test "a polymorphically recursive template is reported instead of expanding forever" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Node<T> \{\n"
        + "    Node<Node<T>>? child;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Use \{\n"
        + "    Node<int>? head;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'Node<int>' never finishes being built: it needs 'Node<Node<int>>', which needs "
        + "'Node<Node<Node<int>>>', and so on without end. Remove the type argument that refers "
        + "back to 'Node<int>'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'Node<Node<T>>' never finishes being built: it needs 'Node<Node<Node<T>>>', which needs "
        + "'Node<Node<Node<Node<T>>>>', and so on without end. Remove the type argument that "
        + "refers back to 'Node<Node<T>>'.");
    try testing.assertEqual(found.length, 2L);
}

test "a concrete class must satisfy abstract methods inherited through a generic base" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "abstract class Producer<T> \{\n"
        + "    protected constructor();\n"
        + "    protected abstract produce() -> T;\n"
        + "\}\n"
        + "class Lazy extends Producer<int> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Class 'Lazy' must override abstract method 'produce', or be declared 'abstract'.");
    try testing.assertEqual(found.length, 1L);
}
