// The subclass, interface and conformance walks over hand-built types.
import @std.testing;
import model.hierarchy;
import TypeStore from model.types;
import Visibility from model.types;
import Type from model.types;
import sema_support;

test "subclass and conformance walks follow bases and implemented interfaces" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let speaker = store.addInterface("Speaker", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, []);
    let base = store.addClass("Base", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        [], false, false, false);
    let derived = store.addClass("Derived", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    derived.setBase(base);
    base.setInterfaces([speaker]);
    try testing.assertTrue(hierarchy.isSubclassOf(derived, base), "derived reaches its base");
    try testing.assertTrue(hierarchy.isSubclassOf(derived, derived), "a class is its own subclass");
    try testing.assertFalse(hierarchy.isSubclassOf(base, derived), "a base is not its subclass");
    try testing.assertTrue(hierarchy.conformsTo(derived, speaker),
        "conformance passes through the base chain");
    try testing.assertTrue(hierarchy.isSubclassOrConforms(derived, speaker),
        "the combined test picks conformance for an interface");
}

test "interface extension chains walk through baseOf, the ladder, and conformance" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let named = store.addInterface("Named", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, []);
    let labeled = store.addInterface("Labeled", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, []);
    let tagged = store.addInterface("Tagged", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, []);
    labeled.setBase(named);
    tagged.setBase(labeled);
    let crate = store.addClass("Crate", "app", "", "/proj/src/app.ens", node,
        Visibility.Public, [], false, false, false);
    crate.setInterfaces([tagged]);
    try testing.assertTrue(hierarchy.baseOf(tagged) == labeled,
        "an interface's base is the interface it extends");
    Type[] ladder = hierarchy.interfaceLadderOf(tagged);
    try testing.assertEqual(ladder.length, 3L);
    try testing.assertTrue(ladder[0] == tagged, "the ladder starts at the interface itself");
    try testing.assertTrue(ladder[1] == labeled, "the ladder continues to the extended one");
    try testing.assertTrue(ladder[2] == named, "the ladder reaches the deepest ancestor");
    try testing.assertTrue(hierarchy.conformsTo(tagged, named),
        "a sub-interface conforms to its ancestor");
    try testing.assertFalse(hierarchy.conformsTo(named, tagged),
        "an ancestor does not conform to a sub-interface");
    try testing.assertTrue(hierarchy.conformsTo(crate, tagged),
        "a class conforms to the interface it implements");
    try testing.assertTrue(hierarchy.conformsTo(crate, labeled),
        "a class conforms through one extension link");
    try testing.assertTrue(hierarchy.conformsTo(crate, named),
        "a class conforms through the whole ladder");
    try testing.assertTrue(hierarchy.isSubclassOrConforms(crate, named),
        "the combined test walks the ladder for an interface target");
}
