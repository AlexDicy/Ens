// Which types another task may be given, and the reason given for each one it may not.
import @std.testing;
import sema_support;
import model.sharing;
import model.convert;
import UnshareableKind from model.sharing;
import TypeStore from model.types;
import PrimitiveKind from model.types;
import Visibility from model.types;
import Type from model.types;

assertKind(Type type, UnshareableKind expected) throws {
    let reason = sharing.whyUnshareable(type);
    if (reason == null) {
        try testing.fail("the type should not be shareable");
        return;
    }
    try testing.assertTrue(reason.kind() == expected, "the reason should be the expected kind");
}

test "values nothing can change are shareable, and an array or a function value is not" {
    let store = new TypeStore();
    try testing.assertTrue(sharing.isShareable(store.primitive(PrimitiveKind.Int)), "an 'int'");
    try testing.assertTrue(sharing.isShareable(store.primitive(PrimitiveKind.Void)), "a 'void'");
    try testing.assertTrue(sharing.isShareable(store.stringType()), "a 'string'");
    try testing.assertTrue(sharing.isShareable(store.optionalOf(store.stringType())), "a 'string?'");
    try assertKind(store.arrayOf(store.primitive(PrimitiveKind.Int)), UnshareableKind.Changeable);
    try assertKind(store.optionalOf(store.arrayOf(store.stringType())), UnshareableKind.Changeable);
    try assertKind(store.functionOf([], store.primitive(PrimitiveKind.Int), []),
        UnshareableKind.FunctionValue);
    try testing.assertTrue(sharing.isShareable(store.functionOf([], store.stringType(), [], true)),
        "a 'shared () -> string'");
}

test "a shared function value widens to the same function type without 'shared', and not back" {
    let store = new TypeStore();
    let integer = store.primitive(PrimitiveKind.Int);
    let shared = store.functionOf([integer], integer, [], true);
    let plain = store.functionOf([integer], integer, []);
    let other = store.functionOf([integer], store.stringType(), []);
    try testing.assertTrue(shared != plain, "the two should be distinct types");
    try testing.assertTrue(convert.isAssignableStrict(plain, shared), "shared to plain");
    try testing.assertTrue(!convert.isAssignableStrict(shared, plain), "plain to shared");
    try testing.assertTrue(!convert.isAssignableStrict(other, shared), "a different signature");
}

test "a class or an interface is shareable once marked, and a type parameter once declared so" {
    let store = new TypeStore();
    let node = sema_support.anyGreenNode();
    let plain = store.addClass("Plain", "app", "", "/proj/src/app.ens", node, Visibility.Public, [],
        false, true, false);
    try assertKind(plain, UnshareableKind.Unmarked);
    plain.markShared();
    try testing.assertTrue(sharing.isShareable(plain), "a marked class");
    let named = store.addInterface("Named", "app", "", "/proj/src/app.ens", node, Visibility.Public,
        []);
    try assertKind(named, UnshareableKind.Unmarked);
    let parameter = store.typeParameter(node, 0, "T");
    try assertKind(parameter, UnshareableKind.OpenParameter);
    parameter.markShared();
    try testing.assertTrue(sharing.isShareable(parameter), "a '<shared T>' parameter");
}

test "a struct is shareable when every field is, and the reason names the field at fault" {
    let analysis = try sema_support.analyzeOne("struct Inner \{\n"
        + "    int[] codes;\n"
        + "\}\n"
        + "struct Outer \{\n"
        + "    int plain;\n"
        + "    Inner inner;\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "    string label;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let point = try sema_support.structNamed(analysis, "main", "Point");
    try testing.assertTrue(sharing.isShareable(point), "a struct of shareable fields");
    let outer = try sema_support.structNamed(analysis, "main", "Outer");
    let reason = sharing.whyUnshareable(outer);
    if (reason == null) {
        try testing.fail("'Outer' should not be shareable");
        return;
    }
    try testing.assertTrue(reason.kind() == UnshareableKind.StructField, "a struct field reason");
    try testing.assertEqual(reason.field(), "inner");
    try testing.assertTrue(reason.innermost().kind() == UnshareableKind.Changeable,
        "the innermost reason should be the array");
}
