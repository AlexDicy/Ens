// Tests for the path helpers.
import @std.testing;
import support.paths;

test "the base name of a path is what follows its last separator" {
    try testing.assertEqual(paths.baseName("src/util.ens"), "util.ens");
    try testing.assertEqual(paths.baseName("C:\\work\\src\\main.ens"), "main.ens");
    try testing.assertEqual(paths.baseName("/a\\b/c.ens"), "c.ens");
    try testing.assertEqual(paths.baseName("alone.ens"), "alone.ens");
    try testing.assertEqual(paths.baseName("folder/"), "");
}
