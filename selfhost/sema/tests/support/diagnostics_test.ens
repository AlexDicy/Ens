// Tests for the shared wording helpers.
import @std.testing;
import @ens.frontend.support.source;
import support.diagnostics;
import FileDiagnostic from support.diagnostics;
import MentionMarker from support.diagnostics;
import RelatedLocation from support.diagnostics;

test "a list joins its last item with 'and' or 'or' and no comma before it" {
    try testing.assertEqual(diagnostics.andJoined(["'a'"]), "'a'");
    try testing.assertEqual(diagnostics.andJoined(["'a'", "'b'"]), "'a' and 'b'");
    try testing.assertEqual(diagnostics.andJoined(["'a'", "'b'", "'c'"]), "'a', 'b' and 'c'");
    try testing.assertEqual(diagnostics.andJoined(["'a'", "'b'", "'c'"], "or"),
        "'a', 'b' or 'c'");
    string[] none = [];
    try testing.assertEqual(diagnostics.andJoined(none), "");
}

test "an ordinal word names a position counted from one" {
    try testing.assertEqual(diagnostics.ordinalWord(1), "first");
    try testing.assertEqual(diagnostics.ordinalWord(2), "second");
    try testing.assertEqual(diagnostics.ordinalWord(3), "third");
    try testing.assertEqual(diagnostics.ordinalWord(10), "tenth");
    try testing.assertEqual(diagnostics.ordinalWord(11), "11th");
    try testing.assertEqual(diagnostics.ordinalWord(12), "12th");
    try testing.assertEqual(diagnostics.ordinalWord(13), "13th");
    try testing.assertEqual(diagnostics.ordinalWord(21), "21st");
    try testing.assertEqual(diagnostics.ordinalWord(22), "22nd");
    try testing.assertEqual(diagnostics.ordinalWord(23), "23rd");
    try testing.assertEqual(diagnostics.ordinalWord(111), "111th");
}

// The marker after a quote of the type 'name' declared in 'modulePath', with its module noted
// when 'needsNote'.
markerFor(string name, string modulePath, bool needsNote) -> string {
    let marker = new MentionMarker();
    marker.writeDeclared(name, "{modulePath}.{name}", needsNote, modulePath);
    return marker.marker("{modulePath}.{name}", false);
}

test "a message writes the module of a type after its first quote only" {
    string parts = markerFor("Kind", "parts", true);
    try testing.assertEqual(diagnostics.render("'Kind'{parts} is not 'int'. Write a 'Kind'{parts}."),
        "'Kind' (from parts) is not 'int'. Write a 'Kind'.");
    string local = markerFor("Kind", "main", false);
    try testing.assertEqual(diagnostics.render("'int' is not 'Kind'{local}."), "'int' is not 'Kind'.");
    try testing.assertEqual(diagnostics.render("No type is quoted."), "No type is quoted.");
}

test "a later quote keeps its module note when the message writes the name for another type" {
    string parts = markerFor("Kind", "parts", true);
    string local = markerFor("Kind", "main", false);
    try testing.assertEqual(diagnostics.render("'Kind'{parts} is not 'Kind'{local}. Use 'Kind'{parts}."),
        "'Kind' (from parts) is not 'Kind'. Use 'Kind' (from parts).");
    try testing.assertEqual(diagnostics.render("'Kind'{local} is not 'Kind'{parts}. Use 'Kind'{parts}."),
        "'Kind' is not 'Kind' (from parts). Use 'Kind' (from parts).");
}

test "a quote of several types notes each by name, and by position where it writes one name twice" {
    let pair = new MentionMarker();
    pair.writeDeclared("Pair", "main.Pair", false, "main");
    pair.writeDeclared("Kind", "main.Kind", false, "main");
    pair.writeDeclared("Kind", "parts.Kind", true, "parts");
    try testing.assertEqual(diagnostics.render("'Pair<Kind, Kind>'{pair.marker("", false)}"),
        "'Pair<Kind, Kind>' (the second Kind from parts)");
    let generic = new MentionMarker();
    generic.writeDeclared("Box", "parts.Box", true, "parts");
    generic.writeTypeParameter("T");
    try testing.assertEqual(diagnostics.render("'Box<T>'{generic.marker("parts.Box", false)}"),
        "'Box<T>' (from parts)");
    try testing.assertEqual(diagnostics.render("'Box.make()'{generic.marker("", true)}"),
        "'Box.make()' (Box from parts)");
}

test "a quote of code to write keeps its module note after an earlier quote of the type" {
    string parts = markerFor("Kind", "parts", true);
    let code = new MentionMarker();
    code.writeDeclared("Kind", "parts.Kind", true, "parts");
    string text = "'Kind'{parts} is not 'int'. Write 'Kind k'{code.marker("", true)}.";
    try testing.assertEqual(diagnostics.render(text),
        "'Kind' (from parts) is not 'int'. Write 'Kind k' (Kind from parts).");
}

test "text taken from the source writes the characters of a marker as escapes" {
    string parts = markerFor("Kind", "parts", true);
    string forged = diagnostics.sourceText("'x'" + parts);
    try testing.assertEqual(diagnostics.render(forged), diagnostics.sourceText("'x'" + parts));
    try testing.assertEqual(diagnostics.sourceText("a\uFDD0b"), "a\\uFDD0b");
    try testing.assertEqual(diagnostics.sourceText("plain"), "plain");
}

test "text that only resembles a marker is left as it is written" {
    string parts = markerFor("Kind", "parts", true);
    try testing.assertEqual(diagnostics.render("'\uFDD0' and 'Kind'{parts}"),
        "'\uFDD0' and 'Kind' (from parts)");
    try testing.assertEqual(diagnostics.render("'\uFDD0x\uFDD1' and 'Kind'{parts}"),
        "'\uFDD0x\uFDD1' and 'Kind' (from parts)");
}

test "a reported problem and the note beside it carry their text with every marker replaced" {
    string parts = markerFor("Kind", "parts", true);
    let note = new RelatedLocation("/proj/src/parts.ens", source.makeSpan(0, 1),
        "'Kind'{parts} is declared here");
    let reported = new FileDiagnostic("/proj/src/main.ens", "'int' is not 'Kind'{parts}.",
        source.makeSpan(2, 3), note);
    try testing.assertEqual(reported.message(), "'int' is not 'Kind' (from parts).");
    try testing.assertEqual(reported.related()[0].note(), "'Kind' (from parts) is declared here");
}
