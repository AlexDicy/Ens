// Tests for the syntax-tree helpers.
import @std.testing;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import CallExpressionNode from @ens.frontend.syntax.generated.nodes;
import SuperExpressionNode from @ens.frontend.syntax.generated.nodes;
import SyntaxNode from @ens.frontend.syntax.node;
import List from @std.collections.list;
import support.syntax;
import sema_support;

test "a constructor body builds its base where it writes a 'super(...)' outside its lambdas" {
    let declarations = constructorsOf("class Leaf extends Base \{\n"
        + "    constructor() \{ super(1); \}\n"
        + "    constructor(int a) \{ (super(a)); \}\n"
        + "    constructor(long a) \{ print(\"first\"); super(a); \}\n"
        + "    constructor(bool b) \{ if (b) \{ super(1); \} \}\n"
        + "    constructor(string s) \{ this.label = s; \}\n"
        + "    constructor(this.label);\n"
        + "\}\n");
    bool[] writes = [true, true, true, true, false, false];
    try testing.assertEqual(declarations.length(), writes.length);
    for (long i = 0; i < writes.length; i++) {
        let declaration = declarations.get(i);
        try testing.assertEqual(syntax.writesSuperCall(declaration), writes[i]);
        try testing.assertEqual(syntax.callsSuper(declaration.body()), writes[i]);
    }
}

test "a 'super(...)' inside a lambda is written by the constructor but builds no base" {
    let declarations = constructorsOf("class Leaf extends Base \{\n"
        + "    constructor() \{ () -> void later = () -> \{ super(1); \}; \}\n"
        + "    constructor(int a) \{ super.describe(); \}\n"
        + "\}\n");
    try testing.assertEqual(declarations.length(), 2L);
    try testing.assertTrue(syntax.writesSuperCall(declarations.get(0)));
    try testing.assertFalse(syntax.callsSuper(declarations.get(0).body()));
    try testing.assertFalse(syntax.writesSuperCall(declarations.get(1)));
}

test "a 'super(...)' is placed by the statement, the loop and the call around it" {
    let declarations = constructorsOf("class Leaf extends Base \{\n"
        + "    constructor() \{ super(1); \}\n"
        + "    constructor(int a) \{ print(super(a)); \}\n"
        + "    constructor(long a) \{ while (true) \{ super(make(a)); \} \}\n"
        + "\}\n");
    bool[] statements = [true, false, true];
    bool[] looped = [false, false, true];
    try testing.assertEqual(declarations.length(), statements.length);
    for (long i = 0; i < statements.length; i++) {
        let superCall = superCallIn(declarations.get(i));
        try testing.assertEqual(syntax.isStatementCall(superCall), statements[i]);
        try testing.assertEqual(syntax.insideLoop(superCall), looped[i]);
        try testing.assertFalse(syntax.insideSuperArguments(superCall));
    }
    let made = callsIn(declarations.get(2)).get(1);
    try testing.assertFalse(made.callee() is SuperExpressionNode);
    try testing.assertTrue(syntax.insideSuperArguments(made));
}

test "a 'super(...)' is found as the body of a switch arm and as the initializer of a 'for' loop" {
    let declarations = constructorsOf("class Leaf extends Base \{\n"
        + "    constructor(int a) \{ switch (a) \{ 1 -> super(a), default -> \{ super(0); \} \} \}\n"
        + "    constructor(long a) \{ for (super(a); false;) \{ \} \}\n"
        + "    constructor() \{ super(1); \}\n"
        + "\}\n");
    bool[] armed = [true, false, false];
    bool[] initializing = [false, true, false];
    try testing.assertEqual(declarations.length(), armed.length);
    for (long i = 0; i < armed.length; i++) {
        let superCall = superCallIn(declarations.get(i));
        try testing.assertEqual(syntax.armHolding(superCall) != null, armed[i]);
        try testing.assertEqual(syntax.inLoopInitializer(superCall), initializing[i]);
    }
}

constructorsOf(string text) -> List<FunctionDeclarationNode> {
    let declarations = new List<FunctionDeclarationNode>();
    collectFunctions(sema_support.parseSource("main.ens", text), declarations);
    return declarations;
}

// The first 'super(...)' call in 'node'.
superCallIn(SyntaxNode node) -> CallExpressionNode {
    for (let call in callsIn(node)) {
        if (call.callee() is SuperExpressionNode) {
            return call;
        }
    }
    panic("no 'super(...)' call in the declaration");
}

// The calls in 'node', outermost first.
callsIn(SyntaxNode node) -> List<CallExpressionNode> {
    let found = new List<CallExpressionNode>();
    collectCalls(node, found);
    return found;
}

collectCalls(SyntaxNode node, List<CallExpressionNode> found) {
    if (node is CallExpressionNode) {
        found.push(node);
    }
    for (let child in node.childNodes()) {
        collectCalls(child, found);
    }
}

collectFunctions(SyntaxNode node, List<FunctionDeclarationNode> found) {
    if (node is FunctionDeclarationNode) {
        found.push(node);
    }
    let children = node.childNodes();
    for (long i = 0; i < children.length(); i++) {
        collectFunctions(children.get(i), found);
    }
}
