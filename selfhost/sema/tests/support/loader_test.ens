// Tests for what the file loader reports when a file cannot be read.
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import @std.testing;
import SystemFileLoader from support.loader;
import FileError from support.loader;

// Whether a second spelling reaches the folder is the file system's answer, so the test asks it and
// holds the key to that answer: the same key exactly when the second spelling finds the folder.
test "two spellings of one folder share a key, as the file system tells folders apart" {
    let scratch = try TemporaryDirectory.create("ens-sema-folder-key");
    Path folder = scratch.path().join("Probe");
    try folder.createDirectories();
    Path respelled = scratch.path().join("PROBE");
    let loader = new SystemFileLoader();
    try testing.assertEqual(loader.folderKey(scratch.path().join("Probe/../Probe/.")),
        loader.folderKey(folder));
    if (respelled.isDirectory()) {
        try testing.assertEqual(loader.folderKey(respelled), loader.folderKey(folder));
    } else {
        try testing.assertNotEqual(loader.folderKey(respelled), loader.folderKey(folder));
    }
}

test "a folder that is not there is keyed by its normalized text" {
    let loader = new SystemFileLoader();
    let scratch = try TemporaryDirectory.create("ens-sema-folder-key-missing");
    Path missing = scratch.path().join("gone/./deeper/..");
    try testing.assertEqual(loader.folderKey(missing), scratch.path().join("gone").normalize()
        .toString());
}

test "the files under a folder are every file at any depth, and a missing folder throws" {
    let scratch = try TemporaryDirectory.create("ens-sema-files-under");
    Path root = scratch.path().join("src");
    try root.join("nested").createDirectories();
    try root.join("main.ens").writeText("");
    try root.join("nested/helper.ens").writeText("");
    try root.join("notes.txt").writeText("");
    let loader = new SystemFileLoader();
    Path[] under = try loader.filesUnder(root);
    try testing.assertEqual(under.length, 3L);
    try testing.assertEqual(under[0], root.join("main.ens"));
    try testing.assertEqual(under[1], root.join("nested/helper.ens"));
    try testing.assertEqual(under[2], root.join("notes.txt"));
    let refused = try testing.assertThrows<FileError>(() -> {
        Path[] none = try loader.filesUnder(scratch.path().join("gone"));
    });
    try testing.assertEqual(refused.message, "This folder could not be read: nothing is there.");
}

test "the loader names why a file could not be read, without its path" {
    let scratch = try TemporaryDirectory.create("ens-sema-loader");
    Path missing = scratch.path().join("gone.ens");
    let loader = new SystemFileLoader();
    let refused = try testing.assertThrows<FileError>(() -> {
        string text = try loader.readText(missing);
    });
    try testing.assertEqual(refused.message, "This file could not be read: nothing is there.");
    try testing.assertEqual(refused.reason, "nothing is there");

    Path broken = scratch.path().join("broken.ens");
    try broken.writeBytes([0x61 as byte, 0xC3 as byte, 0x28 as byte]);
    let undecoded = try testing.assertThrows<FileError>(() -> {
        string text = try loader.readText(broken);
    });
    try testing.assertEqual(undecoded.message, "This file is not valid UTF-8, the way Ens stores "
        + "text as bytes: the byte at offset 1 does not start a character. Save the file as UTF-8 "
        + "in your editor.");
    try testing.assertEqual(undecoded.reason, "it is not valid UTF-8, the way Ens stores text as "
        + "bytes: the byte at offset 1 does not start a character");
}
