        + "    protected override toString() -> string \{ return \"p\"; \}\n"
        + "\}\n"
        + "public class Key \{\n"
        + "    int id;\n"
        + "    public constructor(this.id);\n"
        + "    protected override hash() -> long \{ return this.id; \}\n"
        + "    protected override equals(Key other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "class Quiet \{\n"
        + "    int id;\n"
        + "    protected constructor(this.id);\n"
        + "    override hash() -> long \{ return this.id; \}\n"
        + "    override equals(Quiet other) -> bool \{ return true; \}\n"
        + "\}\n");
