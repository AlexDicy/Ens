    try sema_support.assertMentions(layout,
        "Method 'hash' replaces the built-in identity hash of class 'Key', so it must be as "
            + "visible as 'Key' itself; mark it 'public'.");
    try sema_support.assertMentions(layout,
        "Method 'equals' replaces the built-in identity equality of class 'Key', so it must be "
            + "as visible as 'Key' itself; mark it 'public'.");
}

test "a field refuses every modifier but visibility, 'weak', 'const', and 'static'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box \{\n"
        + "    abstract int first = 0;\n"
        + "    override int second = 0;\n"
        + "    final int third = 0;\n"
        + "    noreturn int fifth = 0;\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    sealed int fourth = 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Field 'first' cannot be 'abstract'; 'abstract' is for a method with no body, which each "
            + "subclass then writes for itself. Remove 'abstract'.");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Field 'second' cannot be 'override'");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Field 'third' cannot be 'final'");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Field 'fourth' cannot be 'sealed'");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Field 'fifth' cannot be 'noreturn'");
}

test "no callable carries 'weak', 'sealed', or 'const', wherever it is declared" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    weak speak() -> string;\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "    sealed describe() -> int \{ return this.x; \}\n"
        + "\}\n"
        + "class Box \{\n"
        + "    const constructor();\n"
        + "    weak destructor() \{ \}\n"
        + "    sealed poke() -> int \{ return 1; \}\n"
        + "\}\n"
        + "const helper() -> int \{ return 2; \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Method 'speak' cannot be 'weak'; 'weak' goes on a class field that refers to an object "
            + "without keeping it alive, as in 'weak Parent? parent'. Remove 'weak'.");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Method 'describe' cannot be 'sealed'");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Function 'helper' cannot be 'const'");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "A constructor cannot be 'const'; 'const' goes on a field or a variable inside a "
            + "function, as in 'const string name;' or 'const limit = 10'. Remove 'const'.");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "A destructor cannot be 'weak'");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Method 'poke' cannot be 'sealed'");
}

test "a top-level function refuses the dispatch markers nothing could inherit" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "override first() -> int \{ return 1; \}\n"
        + "final second() -> int \{ return 2; \}\n"
        + "abstract third() -> int \{ return 3; \}\n"
        + "static fourth() -> int \{ return 4; \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Function 'first' cannot be 'override'; 'override' is for a method that replaces one the "
            + "type inherits. Remove 'override'.");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Function 'second' cannot be 'final'");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Function 'third' cannot be 'abstract'");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Function 'fourth' cannot be 'static'; 'static' goes on a method or a 'const' field of "
            + "a class or a struct, where it makes the member belong to the type itself; a "
            + "top-level function already belongs to no instance. Remove 'static'.");
}

test "a callable keeps the markers its own shape governs" {
