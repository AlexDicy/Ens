test "a field cannot be both 'weak' and 'const'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Tangle \{\n"
        + "    weak const Tangle? neighbor;\n"
        + "    constructor(this.neighbor);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'neighbor' cannot be both 'weak' and 'const': a 'const' field keeps one value for "
        + "the object's whole life, while a 'weak' field becomes null when the object it refers to "
        + "is destroyed. Remove one of the two.");
}

test "a class with a non-defaulted 'const' field needs a constructor to assign it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Silent \{\n"
        + "    const int value;\n"
        + "\}\n"
        + "class Covered \{\n"
        + "    const int value = 1;\n"
        + "\}\n");
