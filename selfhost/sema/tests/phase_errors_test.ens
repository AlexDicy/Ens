        + "\}\n"
        + "class Watcher \{\n"
        + "    weak Watcher direct;\n"
        + "    weak Speaker? seen;\n"
        + "    constructor(this.direct);\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    weak int x;\n"
        + "\}\n");
