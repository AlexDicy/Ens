    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'value' of class 'Silent' is 'const' with no default value, and 'Silent' has no "
        + "constructor to assign it. Add one, for example 'constructor(this.value);', or give the "
        + "field a default value.");
}

test "weak fields must be nullable classes and never be declared on structs" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    weak Watcher direct;\n"
        + "    weak Speaker? seen;\n"
        + "    constructor(this.direct);\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    weak int x;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 2L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'direct' of class 'Watcher' is 'weak', so its type must be nullable. A weak field "
        + "becomes 'null' when its object is destroyed. Write 'weak Watcher? direct'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Field 'seen' of class 'Watcher' is 'weak', so its type must be a class. 'Speaker' is an "
        + "interface. Replace 'Speaker' with a class that implements 'Speaker'.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 1L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Field 'x' of struct 'Value' cannot be 'weak'. A weak field becomes 'null' when its object "
        + "is destroyed. A struct is copied wherever it goes, so its copies could not all be set "
        + "to 'null'. Remove 'weak'.");
}

test "field defaults may only reference earlier fields" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "helperValue() -> int \{ return 3; \}\n"
        + "struct Bad \{\n"
        + "    int area = width * height;\n"
        + "    int width = 4;\n"
        + "    int height = helperValue();\n"
        + "    int self = self;\n"
        + "    int fine = width;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "The default value of field 'area' references 'width', which is declared later. Move "
        + "'width' above 'area', or drop the reference.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The default value of field 'area' references 'height', which is declared later. Move "
        + "'height' above 'area', or drop the reference.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "The default value of field 'self' uses 'self' itself. 'self' has no value until this "
        + "default is computed. Drop the reference, or use a field declared above 'self'.");
}

// The refusal text for a write to the field named 'assigned', inside the default of the field
// named 'defaulted'.
siblingWriteRefusal(string assigned, string defaulted) -> string {
    return "Field '{assigned}' cannot be assigned inside the default of '{defaulted}'. A "
        + "default gives its own field a value and reads earlier ones, so give '{assigned}' its "
        + "value in its own default, or assign both fields in a constructor.";
}

// A field takes its value from its own default or from a constructor, so a default that writes a
// sibling is refused, whether it writes with '=', with a compound operator, with a '++' or with
// a '--', and on a struct as on a class. A struct field lives in the value that holds it, so a
// chain of them is a write to the sibling at its root and names that field, however many fields
// the chain steps through. A default that names its own field is refused for the reference
// alone, by the rule the checks phase owns.
test "a field default cannot assign a sibling field" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Holder \{\n"
        + "    int a = 1;\n"
        + "    int b = (a = 5);\n"
        + "    int c = (a += 2);\n"
        + "    int d = (a++);\n"
        + "    int e = (--a);\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    int first = 1;\n"
        + "    int second = (first = 3);\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    protected Inner inner = \{\};\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "class Chained \{\n"
        + "    Corner corner = \{\};\n"
        + "    int written = (corner.x = 7);\n"
        + "    int deep = (corner.inner.x = 8);\n"
        + "    int stepped = (corner.x++);\n"
        + "    int compounded = (corner.x += 2);\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        siblingWriteRefusal("a", "b"));
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        siblingWriteRefusal("a", "c"));
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        siblingWriteRefusal("a", "d"));
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        siblingWriteRefusal("a", "e"));
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        siblingWriteRefusal("first", "second"));
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "written"));
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "deep"));
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "stepped"));
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        siblingWriteRefusal("corner", "compounded"));
    try testing.assertEqual(found.length, 9L);
}

// An element of the array a sibling refers to, and a field of the object one refers to, are
// storage of their own, so writing them is not writing the sibling. A default may also read an
// earlier sibling, call a module function, and hold a lambda that reads a sibling.
test "a field default may write through a sibling and read one" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "baseValue() -> int \{\n"
        + "    return 4;\n"
        + "\}\n"
        + "struct Corner \{\n"
        + "    protected int x = 1;\n"
        + "\}\n"
        + "class Box \{\n"
        + "    protected int value = 0;\n"
        + "    protected Corner corner = \{\};\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder \{\n"
        + "    int[] slots = new int[2];\n"
        + "    int written = (slots[0] = 5);\n"
        + "    Box box = new Box();\n"
        + "    int inner = (box.value = 6);\n"
        + "    int throughClass = (box.corner.x = 7);\n"
        + "    Corner[] corners = new Corner[2];\n"
        + "    int throughElement = (corners[0].x = 8);\n"
        + "    int fromFunction = baseValue();\n"
        + "    int doubled = fromFunction * 2;\n"
        + "    () -> int reader = () -> doubled + 1;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "class fields must be initialized while struct fields may be non-defaultable" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Value \{\n"
        + "    string label;\n"
        + "\}\n"
        + "class Half \{\n"
        + "    string first;\n"
        + "    string second;\n"
        + "    constructor(this.first) \{\n"
        + "    \}\n"
        + "\}\n"
        + "class Assigned \{\n"
        + "    string first;\n"
        + "    constructor() \{\n"
        + "        this.first = \"ok\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    // A class that declares a constructor is checked by the definite-assignment pass over each
    // constructor body, so the unassigned field surfaces among the body diagnostics.
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'second' of class 'Half' cannot hold null and is not assigned on every path through "
        + "this constructor. Assign it on every path, for example 'this.second = ...;'.");
}

test "a 'const' field takes exactly one write on every constructor path" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Twice \{\n"
        + "    const int value;\n"
        + "    constructor() \{\n"
        + "        this.value = 1;\n"
        + "        this.value = 2;\n"
        + "    \}\n"
        + "\}\n"
        + "class MaybeTwice \{\n"
        + "    const int maybe;\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.maybe = 1;\n"
        + "        \}\n"
        + "        this.maybe = 2;\n"
        + "    \}\n"
        + "\}\n"
        + "class Looped \{\n"
        + "    const int looped;\n"
        + "    constructor() \{\n"
        + "        for (int i = 0; i < 3; i++) \{\n"
        + "            this.looped = i;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "class Sometimes \{\n"
        + "    const int sometimes;\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.sometimes = 1;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "class Balanced \{\n"
        + "    const int chosen;\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.chosen = 1;\n"
        + "        \} else \{\n"
        + "            this.chosen = 2;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'value' is 'const' and may already be assigned when this line runs. Remove one of "
        + "the assignments.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'maybe' is 'const' and may already be assigned when this line runs. Remove one of "
        + "the assignments.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Field 'looped' of class 'Looped' is 'const' with no default value and is not assigned on "
        + "every path through this constructor. Assign it on every path, for example 'this.looped = ...;'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Field 'looped' is 'const' and cannot be assigned inside a loop, which can run more than "
        + "once. Assign it once, outside the loop.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'sometimes' of class 'Sometimes' is 'const' with no default value and is not "
        + "assigned on every path through this constructor. Assign it on every path, for example "
        + "'this.sometimes = ...;'.");
}

test "a 'const' field is writable only by its own type's constructors, through 'this'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box \{\n"
        + "    const int value;\n"
        + "    const int counter = 0;\n"
        + "    constructor(this.value);\n"
        + "    constructor(Box other) \{\n"
        + "        this.value = 1;\n"
        + "        other.value = 2;\n"
        + "    \}\n"
        + "    poke() \{\n"
        + "        this.value = 9;\n"
        + "        this.counter++;\n"
        + "        this.counter += 4;\n"
        + "    \}\n"
        + "\}\n"
        // 'Root.seed' is protected, so 'Stem' inherits it and the refusal is about 'const'
        // alone. A private base field is not inherited, which 'Hidden' and 'Shoot' cover.
        + "class Root \{\n"
        + "    protected const int seed;\n"
        + "    protected constructor(this.seed);\n"
        + "\}\n"
        + "class Stem extends Root \{\n"
        + "    constructor() \{\n"
        + "        super(1);\n"
        + "        this.seed = 2;\n"
        + "    \}\n"
        + "    constructor(this.seed, bool ignored) \{\n"
        + "        super(3);\n"
        + "    \}\n"
        + "\}\n"
        + "public class Hidden \{\n"
        + "    const int seed;\n"
        + "    protected constructor(this.seed);\n"
        + "\}\n"
        + "class Shoot extends Hidden \{\n"
        + "    protected constructor() \{\n"
        + "        super(1);\n"
        + "        this.seed = 2;\n"
        + "    \}\n"
        + "\}\n"
        + "public struct Pair \{\n"
        + "    const int first;\n"
        + "\}\n"
        + "rewrite(Pair pair) \{\n"
        + "    pair.first = 5;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 9L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Cannot assign a new value to field 'value': it is 'const', so it is assigned exactly "
        + "once, inside a constructor of 'Box' as 'this.value = ...'. Remove 'const' from the "
        + "field if it needs to change.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Cannot assign a new value to field 'value': it is 'const', so it is assigned exactly "
        + "once, inside a constructor of 'Box' as 'this.value = ...'. Remove 'const' from the "
        + "field if it needs to change.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "The '++' operator cannot change field 'counter': a 'const' field is assigned once "
        + "when the object is constructed and never again. Remove 'const' from the field if it "
        + "needs to change.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Cannot use '+=' on field 'counter': a 'const' field is assigned once when the object "
        + "is constructed and never again. Remove 'const' from the field if it needs to change.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Field 'seed' is 'const' and declared in base class 'Root', so only a constructor of "
        + "'Root' can assign it. Pass the value to 'super(...)' instead.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "Parameter 'this.seed' assigns field 'seed', which is 'const' and declared in base class "
        + "'Root', so only a constructor of 'Root' can assign it. Take an ordinary parameter and "
        + "pass it to 'super(...)' instead.");
    // 'Shoot' writing 'Hidden.seed' is refused for the visibility alone, because a private base
    // field is not inherited.
    try sema_support.assertDiagnostic(found, 6, "/proj/src/app.ens",
        "'seed' is private to class 'Hidden', so only code inside 'Hidden' can use it. Mark it "
        + "'public' to use it here.");
    try sema_support.assertDiagnostic(found, 7, "/proj/src/app.ens",
        "Cannot assign a new value to field 'first': it is 'const', so it is assigned exactly "
        + "once, inside a constructor of 'Pair' as 'this.first = ...' or by a struct literal "
        + "like '\{first: ...\}'. Remove 'const' from the field if it needs to change.");
    try sema_support.assertDiagnostic(found, 8, "/proj/src/app.ens",
        "'first' is private to struct 'Pair', so only code inside 'Pair' can use it. Mark it "
        + "'public' to use it here.");
}

test "a catch clause assigns a 'const' field only when the body could not have" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "shaky() -> int throws \{\n"
        + "    throw new Failure(\"boom\");\n"
        + "\}\n"
        + "boom() throws \{\n"
        + "    throw new Failure(\"boom\");\n"
        + "\}\n"
        + "class Fallback \{\n"
        + "    const int parsed;\n"
        + "    constructor() \{\n"
        + "        this.parsed = try shaky();\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        this.parsed = -1;\n"
        + "    \}\n"
        + "\}\n"
        + "class TooLate \{\n"
        + "    const int early;\n"
        + "    constructor() \{\n"
        + "        this.early = 1;\n"
        + "        try boom();\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        this.early = -1;\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    // The single diagnostic is what accepts 'Fallback.parsed', whose body could not have assigned
    // it before throwing.
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'early' is 'const' and may already be assigned when this line runs. Remove one of "
        + "the assignments.");
    // The note lands on the body's assignment, which is what the exception path carried in.
    let earlier = try sema_support.relatedOf(found[0]);
    try testing.assertEqual(earlier.note(), "'early' is assigned here");
    try testing.assertTrue(earlier.span().start < found[0].span().start,
        "the note points at the assignment the body ran first");
}

test "struct value cycles are reported with their path" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Outer \{\n"
        + "    Inner nested;\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    Outer? back;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Struct 'Outer' contains itself by value: field 'nested' of 'Outer' has type 'Inner', and "
        + "field 'back' of 'Inner' has type 'Outer?'. A struct's fields are stored inline, so this "
        + "one would have no end. Break the cycle, for example by making 'Inner' a class "
        + "('class Inner \{ ... \}') so the field holds a reference.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Struct 'Inner' contains itself by value: field 'back' of 'Inner' has type 'Outer?', and "
        + "field 'nested' of 'Outer' has type 'Inner'. A struct's fields are stored inline, so "
        + "this one would have no end. Break the cycle, for example by making 'Outer' a class "
        + "('class Outer \{ ... \}') so the field holds a reference.");
}

test "declared throws types must be distinct exception classes" {
    let loader = new FakeFileLoader();
    string source = "class MyError extends Error \{\n"
        + "    constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Runner \{\n"
        + "    constructor();\n"
        + "    bad() throws Speaker \{ \}\n"
        + "    overlapping() throws MyError, Error \{ \}\n"
        + "\}\n"
        + "loose() throws MyError \{ \}\n"
        + "abstract class Vague \{\n"
        + "    abstract go() throws;\n"
        + "\}\n";
    loader.add("/proj/src/app.ens", source);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 2L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "A declared throws type must be 'Error' or a subclass of it, and 'Speaker' is neither. "
        + "Remove 'Speaker' from the 'throws' list, or replace it with a class that extends "
        + "'Error'.");
    try sema_support.assertDiagnostic(checks, 1, "/proj/src/app.ens",
        "The 'throws' list names both 'Error' and 'MyError'. 'MyError' is a subclass of 'Error', "
        + "so 'Error' alone covers both. Remove 'MyError'.");
    try testing.assertEqual(checks[1].span().start, source.indexOf("MyError, Error"));
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Abstract method 'go' of 'Vague' is marked 'throws' but lists no exception types. Without "
        + "a body, the types it throws must be written out. List them after 'throws', as in "
        + "'throws Error', or remove 'throws'.");
    // A list on the free function 'loose' is accepted: it bounds the body, not only overrides.
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout, Stage.Checks]);
}

test "test declarations are validated in place" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "test \"misplaced\" \{ \}\n");
    loader.add("/proj/src/checks_test.ens",
        "import app;\n"
        + "test \"\" \{ \}\n"
        + "test \"line\\nbreak\" \{ \}\n"
        + "test \"value \{1\} here\" \{ \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["checks_test.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Test declarations are only allowed in files ending '_test.ens'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/checks_test.ens",
        "A test description cannot be empty.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/checks_test.ens",
        "A test description cannot contain a line break.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/checks_test.ens",
        "A test description must be a plain string without interpolation.");
}

test "type parameter bounds reject duplicates, two classes, and non-class bounds" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Animal \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Robot \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Chorus<T: Speaker + Speaker> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Pen<T: Animal + Robot> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Sized<T: int> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type parameter 'T' already has the bound 'Speaker'. Remove this second 'Speaker'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Type parameter 'T' already has the class bound 'Animal'; at most one bound can be a "
        + "class. Keep one class bound and make the rest interfaces.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "A type-parameter bound must be a class that is not generic, or an interface, and 'int' is "
        + "neither. Name a class or an interface, or remove the bound.");
}

test "enums and struct clauses are validated" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "enum Color \{ Red, Red \}\n"
        + "enum Hollow \{ \}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "struct Point extends Speaker \{\n"
        + "    int x;\n"
        + "\}\n"
        + "struct Dot implements Speaker \{\n"
        + "    int x;\n"
        + "\}\n"
        + "class Twice \{\n"
        + "    int a;\n"
        + "    int a;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout, Stage.Checks]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 3L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Enum 'Color' already has a member named 'Red'. Remove this second 'Red', or rename it.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Enum 'Hollow' must have at least one member.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "Struct 'Point' cannot use 'extends'. Only a class can have a base class. Remove the "
        + "'extends ...' clause, or make 'Point' a class.");
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 1L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Struct 'Dot' implements 'Speaker' but does not provide 'speak() -> string'. Declare the "
        + "method here, or stop implementing 'Speaker'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'a' is already declared in 'Twice'.");
}

test "interface extension rejects bad targets, cycles, redeclarations, and leaks" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "interface Marker extends Widget \{\n"
        + "\}\n"
        + "interface Loop extends Loop \{\n"
        + "\}\n"
        + "interface Alpha extends Beta \{\n"
        + "\}\n"
        + "interface Beta extends Alpha \{\n"
        + "\}\n"
        + "interface Source \{\n"
        + "    get() -> int;\n"
        + "\}\n"
        + "interface Buffered extends Source \{\n"
        + "    get() -> int;\n"
        + "\}\n"
        + "interface Hidden \{\n"
        + "\}\n"
        + "public interface Wide extends Hidden \{\n"
        + "\}\n"
        + "class Busted implements Buffered \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout, Stage.Checks]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 3L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Interface 'Marker' cannot extend class 'Widget'; an interface extends an interface. Write "
        + "'class Widget implements Marker' instead.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Interface 'Loop' cannot extend itself.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "Interface 'Alpha' extends itself through the interfaces it extends. An interface cannot "
        + "extend itself, directly or indirectly.");
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 2L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Interface 'Buffered' already requires 'get() -> int' through 'Source', the interface it "
        + "extends. Remove this redeclaration.");
    try sema_support.assertDiagnostic(checks, 1, "/proj/src/app.ens",
        "Interface 'Wide' is 'public' but the interface it extends, 'Hidden', is private to module "
        + "'app'. Mark 'Hidden' 'public', or lower the declaration.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 2L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Class 'Busted' implements 'Buffered' but does not provide 'get() -> int'. Declare the "
        + "method, or inherit it from a base class.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Class 'Busted' implements 'Buffered' but does not provide 'get() -> int', required by "
        + "'Source', which 'Buffered' extends. Declare the method, or inherit it from a base class.");
}

test "keyed containers refuse changeable and hashless keys where they are written" {
    let loader = new FakeFileLoader();
    loader.addCollections();
    loader.add("/proj/src/main.ens",
        "import List from @std.collections.list;\n"
        + "import Map from @std.collections.map;\n"
        + "import Set from @std.collections.set;\n"
        + "external type Handle;\n"
        + "struct Tagged \{\n"
        + "    int id;\n"
        + "    string[] labels;\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    Map<string, int> counts;\n"
        + "\}\n"
        + "struct Outer \{\n"
        + "    Inner inner;\n"
        + "\}\n"
        + "struct Handled \{\n"
        + "    Handle handle;\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let byArray = new Map<int[], string>();\n"
        + "    let lists = new Set<List<int>>();\n"
        + "    let byTagged = new Map<Tagged, int>();\n"
        + "    let byOuter = new Map<Outer, int>();\n"
        + "    let byHandle = new Map<Handle, int>();\n"
        + "    let byHandled = new Map<Handled, int>();\n"
        + "    let steps = new Set<(int) -> int>();\n"
        + "    let byName = new Map<string, int>();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 7L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Cannot use 'int[]' as a Map key: an array's contents, and so its hash, can change while "
        + "it sits in the table. Key by a value whose contents cannot change, such as a string or "
        + "an integer.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Cannot use 'List<int>' as a Set element: a collection's contents, and so its hash, can "
        + "change while it sits in the set. Key by a value whose contents cannot change, such as a "
        + "string or an integer.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Cannot use 'Tagged' as a Map key: its field 'labels' has type 'string[]', whose contents "
        + "can change while the key sits in the table. Key by the fields whose contents cannot "
        + "change, give 'Tagged' its own 'equals' and 'hash' that leave 'labels' out, or key by a "
        + "value you keep beside the key.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "Cannot use 'Outer' as a Map key: its field 'inner.counts' has type 'Map<string, int>', "
        + "whose contents can change while the key sits in the table. Key by the fields whose "
        + "contents cannot change, give 'Outer' its own 'equals' and 'hash' that leave "
        + "'inner.counts' out, or key by a value you keep beside the key.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "Cannot use 'Handle' as a Map key: an external type is an address with no value to hash. "
        + "Wrap the handle in a class, which hashes by identity, or key by a value you keep beside it.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/main.ens",
        "Cannot use 'Handled' as a Map key: its field 'handle' has type 'Handle', which has no "
        + "hash; an external type is an address with no value to hash. Give 'Handled' its own "
        + "'equals' and 'hash', or key by the fields that have one.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/main.ens",
        "Cannot use '(int) -> int' as a Set element: a function value has no identity, so it has "
        + "no hash. Keep a name or tag beside each function and key by that instead.");
}

test "an unmarked member of a file-private class or struct reaches its whole file" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app_test.ens",
        "class Helper \{\n"
        + "    int value;\n"
        + "    static const int LIMIT = 10;\n"
        + "    protected int spare = 0;\n"
        + "    constructor(this.value);\n"
        + "    doubled() -> int \{ return this.value * 2; \}\n"
        + "    static make(int value) -> Helper \{ return new Helper(value); \}\n"
        + "\}\n"
        + "struct Spot \{\n"
        + "    int x;\n"
        + "    constructor(this.x);\n"
        + "    shifted(int by) -> int \{ return this.x + by; \}\n"
        + "    static origin() -> Spot \{ return \{x: 0\}; \}\n"
        + "\}\n"
        + "class Reader \{\n"
        + "    constructor();\n"
        + "    read(Helper helper) -> int \{ return helper.value + helper.spare + Helper.LIMIT; \}\n"
        + "\}\n"
        + "struct Probe \{\n"
        + "    int depth = 0;\n"
        + "    probe(Spot spot) -> int \{ return spot.x + Spot(1).shifted(this.depth); \}\n"
        + "\}\n"
        + "measure() -> int \{\n"
        + "    let helper = Helper.make(4);\n"
        + "    () -> int reach = () -> helper.doubled() + new Helper(1).value;\n"
        + "    Spot spot = \{x: 3\};\n"
        + "    Probe probe = \{\};\n"
        + "    return reach() + new Reader().read(helper) + Spot.origin().x + probe.probe(spot);\n"
        + "\}\n"
        + "test \"reads a member\" \{\n"
        + "    let helper = new Helper(2);\n"
        + "    let total = helper.value + helper.doubled();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app_test.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "a class with no constructor of its own is built wherever the class is visible" {
