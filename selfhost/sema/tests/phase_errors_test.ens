        "Field 'value' of class 'Silent' is 'const' with no default value, and 'Silent' has no "
        + "constructor to assign it. Add one, for example 'constructor(this.value);', or give the "
        + "field a default value.");
}

test "weak fields must be nullable classes and never be declared on structs" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
