import @std.testing;
import FakeFileLoader from sema_support;
import Stage from sema_support;
import sema_support;

test "an external block may only name a native library its manifest declares" {
    let loader = new FakeFileLoader();
    loader.add("/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    native libc system;\n"
        + "\}\n");
    loader.add("/proj/src/app.ens",
        "external from libc \{\n"
        + "    abs(int value) -> int;\n"
        + "\}\n"
        + "external from zlib \{\n"
        + "    compressBound(ulong sourceLength) -> ulong;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "External library 'zlib' is not declared in /proj/ens.package. Add 'native zlib;' (or a "
        + "'system' or per-platform form) to the package manifest.");
}

test "type references diagnose unknown names, bare generics, arity, and non-generics" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box<T> \{\n"
        + "    T? value;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Bad \{\n"
        + "    Nope a;\n"
        + "    Box b;\n"
        + "    Box<int, int> c;\n"
        + "    int<int> d;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Unknown type 'Nope'. Check the spelling, or import the module that declares it.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Generic type 'Box' requires type arguments (for example 'Box<int>').");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Generic type 'Box' expects 1 type argument, but 2 were given.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Type 'int' is not generic and takes no type arguments.");
}

test "the reserved word 'decimal' is refused wherever a type is named" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box<T> \{\n"
        + "    T? value;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Money \{\n"
        + "    decimal amount;\n"
        + "    decimal? pending;\n"
        + "    decimal[]? history;\n"
        + "    Box<decimal>? boxed;\n"
        + "\}\n"
        + "rate(decimal factor) -> decimal \{\n"
        + "    return factor;\n"
        + "\}\n"
        + "use() \{\n"
        + "    decimal here = 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Bodies]);
    string message = "'decimal' is a reserved word and not a usable type yet. Use 'double' for "
    + "fractional values, or an integer scaled by hand (a 'long' count of cents, say) where the "
    + "value has to be exact.";
    let declared = analysis.signatureDiagnostics();
    try testing.assertEqual(declared.length, 6L);
    for (let diagnostic in declared) {
        try testing.assertEqual(diagnostic.message(), message);
    }
    let inBody = analysis.bodyDiagnostics();
    try testing.assertEqual(inBody.length, 1L);
    try testing.assertEqual(inBody[0].message(), message);
}

// What a module-qualified type name reads before the rule that refuses the spelling gets to it:
// a type this file cannot reach, a name the module does not declare, and a head that is no
// imported module at all.
test "qualified references diagnose visibility, missing types, and unknown aliases" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import lib.shapes;\n"
        + "struct Holder \{\n"
        + "    shapes.Hidden h;\n"
        + "    shapes.Missing m;\n"
        + "    foo.Thing t;\n"
        + "\}\n");
    loader.add("/proj/src/lib/shapes.ens",
        "class Hidden \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Type 'Hidden' is private to module 'lib.shapes', so only that file can use it. Mark it "
        + "'public' to use it from other modules in the package.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Module 'lib.shapes' has no type 'Missing'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "'foo' is not an imported module, so 'foo.Thing' names no type. Import 'Thing' from the "
        + "module that declares it, then write 'Thing'.");
    try testing.assertEqual(found.length, 3L);
}

test "function collection rejects duplicate, generic, main, and external overloads" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "add(int a) -> int \{ return a; \}\n"
        + "add(int b) -> int \{ return b; \}\n"
        + "main() \{ \}\n"
        + "main(int x) \{ \}\n"
        + "pick<T>(T value) \{ \}\n"
        + "pick(int value) \{ \}\n"
        + "dup(long y) -> long \{ return y; \}\n"
        + "external from m \{\n"
        + "    dup(int x) -> int;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 6L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Function 'add' is already declared with the same parameter types; overloads must differ "
        + "in parameter count or types.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Function 'main' is the program entry point, so only the main module (src/main.ens) can "
        + "define it, not 'app'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Function 'main' is the program entry point, so only the main module (src/main.ens) can "
        + "define it, not 'app'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Function 'main' cannot be overloaded; it is the program entry point.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Function 'pick' cannot be overloaded, because one of its declarations is generic and a "
        + "generic function takes no overloads.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "External function 'dup' cannot share its name with another function; C symbols cannot be "
        + "overloaded.");
}

test "main may only be defined in the main module" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import app;\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    loader.add("/proj/src/app.ens",
        "main() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Function 'main' is the program entry point, so only the main module (src/main.ens) can "
        + "define it, not 'app'.");
}

test "the entry point rejects a wrong return type, parameters, and type parameters" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/tool.ens",
        "main<T>(int limit) -> long \{\n"
        + "    return 0L;\n"
        + "\}\n");
    let analysis = sema_support.analyzeFileProgram(loader, "/proj/src", "tool.ens");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/tool.ens",
        "Function 'main' is the program entry point, so nothing calls it with type arguments and "
        + "it cannot declare the type parameter 'T'. Write 'main() -> int' (or 'main()') and put "
        + "the generic work in a function 'main' calls.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/tool.ens",
        "Function 'main' is the program entry point and takes no parameters, so it cannot declare "
        + "'limit'. Write 'main() -> int' (or 'main()') and read the command line with "
        + "'environment.arguments()' after 'import @std.environment;'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/tool.ens",
        "Function 'main' returns 'long', and the program entry point returns 'int' or nothing, "
        + "because what it returns becomes the exit code. Write 'main() -> int' to choose the "
        + "exit code, or 'main()' to leave it 0.");
}

test "the entry point accepts no return type, 'int', 'throws', and 'noreturn'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/plain.ens", "main() \{ \}\n");
    loader.add("/proj/src/coded.ens", "main() -> int \{\n    return 0;\n\}\n");
    loader.add("/proj/src/failing.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "main() -> int throws \{\n    throw new Failure(\"stop\");\n\}\n");
    loader.add("/proj/src/looping.ens", "noreturn main() \{\n    while (true) \{ \}\n\}\n");
    for (let entry in ["plain.ens", "coded.ens", "failing.ens", "looping.ens"]) {
        let analysis = sema_support.analyzeFileProgram(loader, "/proj/src", entry);
        try sema_support.assertProgramClean(analysis);
    }
}

test "the override matrix rejects hiding, final, missing bases, and mismatches" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Base \{\n"
        + "    protected constructor();\n"
        + "    protected greet() -> int \{ return 1; \}\n"
        + "    protected final locked() -> int \{ return 2; \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    greet() -> int \{ return 3; \}\n"
        + "    protected override locked() -> int \{ return 4; \}\n"
        + "    override missing() -> int \{ return 5; \}\n"
        + "    override greet(int x) -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'greet' hides a method inherited from 'Base', so a call through 'Base' and one "
        + "through 'Derived' would run different code. Mark it 'override' to replace it, or give "
        + "it another name.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Cannot override 'locked' because it is declared 'final' in 'Base'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Method 'missing' is marked 'override' but no base class or implemented interface declares it.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Override of 'greet' does not match the 'greet' declared in 'Base', which is 'greet() -> int'.");
}

test "a private base field is not inherited, so a subclass field, method or static reuses its name" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Base \{\n"
        + "    int secret;\n"
        + "    protected int shared;\n"
        + "    protected constructor() \{ this.secret = 1; this.shared = 2; \}\n"
        + "    protected baseSecret() -> int \{ return this.secret; \}\n"
        + "\}\n"
        + "class Reuses extends Base \{\n"
        + "    protected string secret;\n"
        + "    protected constructor() \{ super(); this.secret = \"own\"; \}\n"
        + "    protected ownSecret() -> string \{ return this.secret; \}\n"
        + "\}\n"
        + "class Reports extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected secret() -> int \{ return 3; \}\n"
        + "\}\n"
        + "class Tallies extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected static secret() -> int \{ return 4; \}\n"
        + "\}\n"
        + "class Collides extends Base \{\n"
        + "    protected int shared;\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Field 'shared' is already declared in base class 'Base' and inherited by 'Collides'. Remove "
        + "this declaration and use the inherited field, or give this one another name.");
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
}

test "a 'this.field' parameter refuses a private base field however deep the chain" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Base \{\n"
        + "    int secret = 1;\n"
        + "    protected int shared = 2;\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Binds extends Base \{\n"
        + "    protected constructor(this.secret);\n"
        + "\}\n"
        + "class Middle extends Base \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Deeper extends Middle \{\n"
        + "    protected constructor(this.secret);\n"
        + "\}\n"
        + "class Absent extends Base \{\n"
        + "    protected constructor(this.missing);\n"
        + "\}\n"
        // Both of these bind a field their own class has, so both are accepted: 'Reuses'
        // declares 'secret' itself, and 'Shares' inherits 'shared'.
        + "class Reuses extends Base \{\n"
        + "    protected int secret = 3;\n"
        + "    protected constructor(this.secret);\n"
        + "\}\n"
        + "class Shares extends Base \{\n"
        + "    protected constructor(this.shared);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'secret' is private to 'Base', so 'Binds' has no field by that name. Declare one in "
        + "'Binds', or mark 'secret' 'protected' in 'Base'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "'secret' is private to 'Base', so 'Deeper' has no field by that name. Declare one in "
        + "'Deeper', or mark 'secret' 'protected' in 'Base'.");
    // A name no field of the chain declares is reported as the absent field it is.
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "No field 'missing' on type 'Absent'. Drop 'this.' and give the parameter a type, as in "
        + "'int missing'.");
}

test "a base field a subclass inherits keeps its name from the subclass's own members" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Base \{\n"
        + "    protected int shared;\n"
        + "    protected constructor() \{ this.shared = 1; \}\n"
        + "\}\n"
        + "class Reports extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected shared() -> int \{ return 2; \}\n"
        + "\}\n"
        + "class Tallies extends Base \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "    protected static shared() -> int \{ return 3; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    // Both messages name 'Base', the class that declares the field, rather than the subclass
    // the refused member is written in.
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'shared' is already declared as a field of 'Base'; a field and a method cannot share a name.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Static member 'shared' has the same name as a field of 'Base'; a static and an instance "
        + "member cannot share a name. Rename one of the two.");
}

test "a class override carries the overridden method's visibility, capped at its own class" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "export class Wide \{\n"
        + "    export constructor();\n"
        + "    export greet() -> int \{ return 1; \}\n"
        + "    public wave() -> int \{ return 2; \}\n"
        + "\}\n"
        + "public class Animal \{\n"
        + "    protected constructor();\n"
        + "    protected sound() -> int \{ return 1; \}\n"
        + "\}\n"
        + "public class Unmarked extends Animal \{\n"
        + "    protected constructor();\n"
        + "    override sound() -> int \{ return 2; \}\n"
        + "\}\n"
        + "public class Wider extends Animal \{\n"
        + "    protected constructor();\n"
        + "    public override sound() -> int \{ return 3; \}\n"
        + "\}\n"
        + "public class Loud \{\n"
        + "    public constructor();\n"
        + "    public sound() -> int \{ return 1; \}\n"
        + "\}\n"
        + "public class Narrower extends Loud \{\n"
        + "    public constructor();\n"
        + "    protected override sound() -> int \{ return 4; \}\n"
        + "\}\n"
        + "class Capped extends Wide \{\n"
        + "    protected constructor();\n"
        + "    export override greet() -> int \{ return 5; \}\n"
        + "\}\n"
        + "class Fine extends Wide \{\n"
        + "    protected constructor();\n"
        + "    protected override greet() -> int \{ return 6; \}\n"
        + "    protected override wave() -> int \{ return 7; \}\n"
        + "\}\n"
        + "public class AlsoFine extends Wide \{\n"
        + "    public constructor();\n"
        + "    public override greet() -> int \{ return 8; \}\n"
        + "    public override wave() -> int \{ return 9; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Override 'sound' must be 'protected', the visibility of the 'sound' it overrides in "
        + "'Animal'. Mark it 'protected'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Override 'sound' must be 'protected', the visibility of the 'sound' it overrides in "
        + "'Animal'. Replace 'public' with 'protected'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Override 'sound' must be 'public', the visibility of the 'sound' it overrides in 'Loud'. "
        + "Replace 'protected' with 'public'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Override 'greet' cannot be 'export' while 'Capped' is private to its file, because a "
        + "member is never more visible than the type that holds it. Remove 'export'. An unmarked "
        + "member of 'Capped' already reaches its whole file.");
}

test "abstract methods need abstract classes and concrete subclasses must implement them" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Solid \{\n"
        + "    constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "abstract class Shape \{\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Flat extends Shape \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Class 'Solid' must override abstract method 'area', or be declared 'abstract'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Abstract method 'area' requires class 'Solid' to be declared 'abstract'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Class 'Flat' must override abstract method 'area', or be declared 'abstract'.");
}

test "interfaces reject fields, bodies, modifiers, and typeless throws" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    int volume;\n"
        + "    speak() -> string \{ return \"\"; \}\n"
        + "    public quiet();\n"
        + "    loud() throws;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "An interface cannot declare fields; its body lists only method signatures.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Interface method 'speak' cannot have a body; end the signature with ';'. Implementing "
        + "classes provide the body.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "A member of an interface always has the interface's own visibility. Remove the modifier "
        + "from 'quiet'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "An interface method marked 'throws' must list its exception types, for example 'throws IOError'.");
}

test "a member cannot be more visible than the type that contains it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Hidden \{\n"
        + "    export int wide;\n"
        + "    public constructor();\n"
        + "    export speak() -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "public struct Pt \{\n"
        + "    export int x;\n"
        + "    export scaled() -> int \{ return this.x; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 3L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'wide' cannot be 'export' while 'Hidden' is private to its file, because a member "
        + "is never more visible than the type that holds it. Remove 'export'. An unmarked member "
        + "of 'Hidden' already reaches its whole file.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "The constructor of 'Hidden' cannot be 'public' while 'Hidden' is private to its file, "
        + "because a member is never more visible than the type that holds it. Remove 'public'. "
        + "An unmarked member of 'Hidden' already reaches its whole file.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "Method 'speak' cannot be 'export' while 'Hidden' is private to its file, because a member "
        + "is never more visible than the type that holds it. Remove 'export'. An unmarked member "
        + "of 'Hidden' already reaches its whole file.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 2L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Field 'x' cannot be 'export' while 'Pt' is only 'public', because a member is never more "
        + "visible than the type that holds it. Replace 'export' with 'public', or mark 'Pt' 'export' too.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Method 'scaled' cannot be 'export' while 'Pt' is only 'public', because a member is never "
        + "more visible than the type that holds it. Replace 'export' with 'public', or mark 'Pt' "
        + "'export' too.");
}

test "'final' means nothing on a private method, while a declared throws list still bounds it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public constructor();\n"
        + "    final frozen() -> int \{ return 1; \}\n"
        + "    read() -> int throws Failure \{ return 2; \}\n"
        + "    protected final locked() -> int \{ return 3; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'frozen' cannot be 'final': it is private to 'Base', so no subclass can override "
        + "it anyway. Remove 'final'.");
}

test "a struct's members are private unless marked, exactly as a class's are" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "public struct Point \{\n"
        + "    public int x;\n"
        + "    int secret = 0;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Point from lib;\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1\};\n"
        + "    return p.x + p.secret;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'secret' is private to struct 'Point', so only code inside 'Point' can use it. Mark it "
        + "'public' to use it here.");
}

test "a visible declaration may not mention a less visible type" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Secret \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "public expose(Secret s) \{ \}\n"
        + "public fetch() -> Secret \{ return new Secret(); \}\n"
        + "public class Child extends Secret \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Function 'expose' is 'public' but its parameter type mentions 'Secret', which is private "
        + "to module 'app'. Mark 'Secret' 'public', or lower the declaration.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Function 'fetch' is 'public' but its return type mentions 'Secret', which is private to "
        + "module 'app'. Mark 'Secret' 'public', or lower the declaration.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Class 'Child' is 'public' but its base class 'Secret' is private to module 'app'. Mark "
        + "'Secret' 'public', or lower the declaration.");
}

test "a protected member leaks only as far as its class can be subclassed" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Secret \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "export class Channel \{\n"
        + "    export constructor();\n"
        + "    protected open(Secret secret) \{ \}\n"
        + "\}\n"
        + "public class Registry \{\n"
        + "    protected Secret entry;\n"
        + "    protected constructor(this.entry);\n"
        + "\}\n"
        + "export final class Wrapper \{\n"
        + "    protected Secret inner;\n"
        + "    protected constructor(this.inner);\n"
        + "\}\n"
        + "class Open \{\n"
        + "    protected Secret held;\n"
        + "    protected constructor(this.held);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'open' of class 'Channel' is protected, and 'Channel' is 'export', so a subclass "
        + "in another package can reach it, but its parameter type mentions 'Secret', which is "
        + "private to module 'app'. Mark 'Secret' 'export', lower 'Channel', or mark 'Channel' 'final'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Field 'entry' of class 'Registry' is protected, and 'Registry' is 'public', so a subclass "
        + "anywhere in the package can reach it, but its type mentions 'Secret', which is private "
        + "to module 'app'. Mark 'Secret' 'public', lower 'Registry', or mark 'Registry' 'final'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Constructor of class 'Registry' is protected, and 'Registry' is 'public', so a subclass "
        + "anywhere in the package can reach it, but its parameter type mentions 'Secret', which "
        + "is private to module 'app'. Mark 'Secret' 'public', lower 'Registry', or mark "
        + "'Registry' 'final'.");
}

test "interface satisfaction requires every method and the override marker" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak(int volume) -> string;\n"
        + "\}\n"
        + "class Silent implements Speaker \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Wrong implements Speaker \{\n"
        + "    constructor();\n"
        + "    speak(int volume) -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Class 'Silent' implements 'Speaker' but does not provide 'speak(int) -> string'. Declare "
        + "the method, or inherit it from a base class.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'speak' of 'Wrong' implements a method declared in interface 'Speaker'; mark it 'override'.");
}

test "inheritance rejects cycles once, wrong bases, and cross-module sealing" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import Sealed from lib;\n"
        + "class A extends B \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class B extends A \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    int x;\n"
        + "\}\n"
        + "class OnValue extends Value \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "final class Locked \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class OnLocked extends Locked \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class OnSealed extends Sealed \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "sealed final class Both \{\n"
        + "    constructor();\n"
        + "\}\n");
    loader.add("/proj/src/lib.ens",
        "public sealed class Sealed \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "public class SameModule extends Sealed \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 1L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Class 'A' extends itself through its base classes. A class cannot inherit from itself, "
        + "directly or indirectly.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 4L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "'Value' is not a class; only classes can be extended.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Cannot extend 'Locked' because it is declared 'final'.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "Cannot extend 'Sealed' because it is declared 'sealed'; only the module that declares "
        + "'Sealed' can extend it.");
    try sema_support.assertDiagnostic(signatures, 3, "/proj/src/app.ens",
        "Class 'Both' cannot be both 'sealed' and 'final'; 'final' already forbids every subclass. "
        + "Remove one of the two.");
}

test "constructor and destructor rules hold" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    int id = 0;\n"
        + "    constructor() throws \{ \}\n"
        + "    Widget(int x) \{ \}\n"
        + "    destructor(int extra) -> int \{ return 1; \}\n"
        + "    destructor() \{ \}\n"
        + "    poke();\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    int x;\n"
        + "    destructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 6L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "A constructor cannot be marked 'throws'. Handle the exceptions with a 'catch' clause "
        + "after the constructor body.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "To declare a constructor, use the 'constructor' keyword. A method cannot be named after "
        + "its class 'Widget'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "A destructor cannot declare parameters.");
    try sema_support.assertDiagnostic(layout, 3, "/proj/src/app.ens",
        "A destructor cannot declare a return type.");
    try sema_support.assertDiagnostic(layout, 4, "/proj/src/app.ens",
        "A class can declare at most one destructor.");
    try sema_support.assertDiagnostic(layout, 5, "/proj/src/app.ens",
        "Shorthand declaration ';' is only allowed on a constructor.");
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 1L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "A struct cannot declare a destructor; destructors are only allowed on classes.");
}

test "hash and equals are validated as a pair with exact signatures" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class OnlyHash \{\n"
        + "    constructor();\n"
        + "    override hash() -> long \{ return 1; \}\n"
        + "\}\n"
        + "class OnlyEquals \{\n"
        + "    constructor();\n"
        + "    override equals(OnlyEquals other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "class BadHash \{\n"
        + "    constructor();\n"
        + "    override hash() -> int \{ return 1; \}\n"
        + "\}\n"
        + "class Unmarked \{\n"
        + "    constructor();\n"
        + "    hash() -> long \{ return 1; \}\n"
        + "    override equals(Unmarked other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Class 'OnlyHash' defines 'hash' but not 'equals', and equal values have to hash equally. "
        + "Add an 'equals(OnlyHash other) -> bool' method.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Class 'OnlyEquals' defines 'equals' but not 'hash', and equal values have to hash "
        + "equally. Add a 'hash() -> long' method.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "A method named 'hash' must have the signature 'hash() -> long'.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Method 'hash' overrides the built-in identity hash; mark it 'override'.");
}

test "a class's marked toString is held to the text form it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Throwing \{\n"
        + "    public constructor();\n"
        + "    public override toString() -> string throws Error \{ return \"t\"; \}\n"
        + "\}\n"
        + "public class Shaped \{\n"
        + "    public constructor();\n"
        + "    public override toString(int width) -> string \{ return \"w\"; \}\n"
        + "\}\n"
        + "abstract class Ghost \{\n"
        + "    abstract override toString() -> string;\n"
        + "\}\n"
        + "public class Quiet \{\n"
        + "    public constructor();\n"
        + "    protected override toString() -> string \{ return \"q\"; \}\n"
        + "\}\n"
        + "public class Legacy \{\n"
        + "    public constructor();\n"
        + "    public toString() -> string \{ return \"l\"; \}\n"
        + "\}\n"
        + "public class Sized \{\n"
        + "    public constructor();\n"
        + "    public toString(int scale) -> string \{ return \"s\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A method named 'toString' cannot be marked 'throws': a text form is taken where no 'try' "
        + "can be written, such as inside a '\{...\}' in a string. Remove 'throws', or rename the method.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'toString' of 'Shaped' is marked 'override' but takes parameters, which makes it "
        + "an ordinary method rather than the text form every class has. Remove 'override'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Method 'toString' of 'Ghost' cannot be 'abstract': every class already has a text form, "
        + "so an override of it needs a body. Write the body, or remove the method.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "Method 'toString' replaces the built-in text form of class 'Quiet', so it must be as "
        + "visible as 'Quiet' itself; mark it 'public'.");
    // 'Legacy' has the text form's shape and writes no marker. 'Sized' takes an argument, so it
    // is an ordinary method that nothing in the language calls, and writing no marker is right.
    // 'Shaped' takes one too, which is why its marker has nothing to implement.
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "Method 'toString' of 'Legacy' replaces the text form every class already has; mark it 'override'.");
}

test "a struct's toString is held to the text form it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct Shaped \{\n"
        + "    int x;\n"
        + "    public override toString(int width) -> string \{ return \"w\"; \}\n"
        + "\}\n"
        + "public struct Throwing \{\n"
        + "    int x;\n"
        + "    public override toString() -> string throws Error \{ return \"t\"; \}\n"
        + "\}\n"
        + "public struct Unmarked \{\n"
        + "    int x;\n"
        + "    public toString() -> string \{ return \"u\"; \}\n"
        + "\}\n"
        + "struct Following \{\n"
        + "    int x;\n"
        + "    override toString() -> string \{ return \"f\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Checks]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A method named 'toString' cannot be marked 'throws': a text form is taken where no 'try' "
        + "can be written, such as inside a '\{...\}' in a string. Remove 'throws', or rename the method.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "Method 'toString' overrides the built-in text form of struct 'Unmarked'; mark it 'override'.");
    // 'Shaped' takes an argument, so it is an ordinary method, and a struct has no ordinary
    // method to override. The refusal says which of the two reasons its marker failed on.
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 1L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Method 'toString' of 'Shaped' is marked 'override', and a struct inherits nothing to "
        + "override; a 'toString' that takes parameters is an ordinary method rather than the "
        + "struct's text form. Remove 'override'.");
}

test "a struct member overrides only what the language gives a struct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Counter \{\n"
        + "    int value;\n"
        + "    override constructor(this.value);\n"
        + "    override doubled() -> int \{ return this.value * 2; \}\n"
        + "    override hash() -> long \{ return this.value; \}\n"
        + "    override equals(Counter other) -> bool \{ return true; \}\n"
        + "    override toString() -> string \{ return \"c\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Checks]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "A constructor cannot be 'override' or 'abstract'.");
    // The marker rule is whole-program, because an interface the struct implements may be
    // declared in another module.
    let checks = analysis.checkDiagnostics();
    try testing.assertEqual(checks.length, 1L);
    try sema_support.assertDiagnostic(checks, 0, "/proj/src/app.ens",
        "Method 'doubled' of 'Counter' is marked 'override', and a struct inherits nothing to "
        + "override; only 'toString', 'hash', and 'equals' replace a built-in behavior of a "
        + "struct. Remove 'override'.");
}

test "a struct's hash is held to the content hash it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
