        "'toString' takes the visibility of 'Seal', so 'private' is never written. Remove it from "
        + "'toString'.");
}

// A class that declares no constructor runs its base class's zero-argument constructor. The
// refusal is reported once, at the class. Building the class with 'new' or calling 'super()' on it
// reports nothing further. Each fix is written with the base's own parameters.
test "a class with no constructor needs a zero-argument base constructor it can reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Hidden \{\n"
        + "    constructor(int count) \{ \}\n"
        + "\}\n"
        + "class OverHidden extends Hidden \{\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor(int width, string label = \"wide\") \{ \}\n"
        + "\}\n"
        + "class OverSized extends Sized \{\n"
        + "\}\n"
        + "public class Guarded \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class OverGuarded extends Guarded \{\n"
        + "\}\n"
        + "public class Mixed \{\n"
        + "    constructor() \{ \}\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class OverMixed extends Mixed \{\n"
        + "\}\n"
        + "class Holder<T> \{\n"
        + "    protected constructor(T value) \{ \}\n"
        + "\}\n"
        + "class IntHolder extends Holder<int> \{\n"
        + "\}\n"
        + "class Wrapped<T> extends Holder<T> \{\n"
        + "\}\n"
        + "class Failure extends Error \{\n"
        + "\}\n"
        + "class Further extends OverSized \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let sized = new OverSized();\n"
        + "    let further = new Further();\n"
        + "    let wrapped = new Wrapped<string>();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 7L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Class 'OverHidden' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Hidden', which declares none. Mark 'constructor(int)' in 'Hidden' as "
        + "'protected' so a subclass can call it, then declare a constructor that calls "
        + "'super(...)', as in 'constructor(int count) \{ super(count); \}'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Class 'OverSized' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Sized', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(int width) \{ super(width); \}'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Class 'OverGuarded' declares no constructor, so it would run the zero-argument "
        + "constructor of its base class 'Guarded', which is private to 'Guarded'. Mark "
        + "'constructor()' in 'Guarded' as 'protected' so a subclass can call it.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "Class 'OverMixed' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Mixed', which is private to 'Mixed'. Declare a constructor that "
        + "calls 'super(...)', as in 'constructor(int width) \{ super(width); \}'.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "Class 'IntHolder' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Holder<int>', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(int value) \{ super(value); \}'.");
    try sema_support.assertDiagnostic(found, 5, "/proj/src/main.ens",
        "Class 'Wrapped' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Holder<T>', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(T value) \{ super(value); \}'.");
    try sema_support.assertDiagnostic(found, 6, "/proj/src/main.ens",
        "Class 'Failure' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Error', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(string message) \{ super(message); \}'.");
}

// The fixes the refusals above suggest compile in the file they were read in, and each fixed
// class can still be built there.
test "the fixes a class with no constructor is offered compile and construct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Hidden \{\n"
        + "    protected constructor(int count) \{ \}\n"
        + "\}\n"
        + "class OverHidden extends Hidden \{\n"
        + "    constructor(int count) \{ super(count); \}\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor(int width, string label = \"wide\") \{ \}\n"
        + "\}\n"
        + "class OverSized extends Sized \{\n"
        + "    constructor(int width) \{ super(width); \}\n"
        + "\}\n"
        + "public class Guarded \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class OverGuarded extends Guarded \{\n"
        + "\}\n"
        + "public class Mixed \{\n"
        + "    constructor() \{ \}\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class OverMixed extends Mixed \{\n"
        + "    constructor(int width) \{ super(width); \}\n"
        + "\}\n"
        + "class Holder<T> \{\n"
        + "    protected constructor(T value) \{ \}\n"
        + "\}\n"
        + "class IntHolder extends Holder<int> \{\n"
        + "    constructor(int value) \{ super(value); \}\n"
        + "\}\n"
        + "class Wrapped<T> extends Holder<T> \{\n"
        + "    constructor(T value) \{ super(value); \}\n"
        + "\}\n"
        + "class Failure extends Error \{\n"
        + "    constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let hidden = new OverHidden(1);\n"
        + "    let sized = new OverSized(2);\n"
        + "    let guarded = new OverGuarded();\n"
        + "    let mixed = new OverMixed(3);\n"
        + "    let held = new IntHolder(4);\n"
        + "    let wrapped = new Wrapped<string>(\"five\");\n"
        + "    let failure = new Failure(\"six\");\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// A declared constructor that leaves out 'super(...)' is held to the rule a class with no
// constructor is, with the same variants of the refusal. A 'super(...)' call to a private base
// constructor is fixed by 'protected', which is what a subclass needs.
test "a declared constructor without 'super(...)' needs a zero-argument base constructor it can reach" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class Unchained extends Sized \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Matching extends Sized \{\n"
        + "    protected constructor(int width) \{ \}\n"
        + "\}\n"
        + "class Chained extends Sized \{\n"
        + "    protected constructor() \{ super(4); \}\n"
        + "\}\n"
        + "public class Guarded \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class OverGuarded extends Guarded \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public class Hidden \{\n"
        + "    constructor(int count) \{ \}\n"
        + "\}\n"
        + "class OverHidden extends Hidden \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class CallsHidden extends Hidden \{\n"
        + "    protected constructor() \{ super(1); \}\n"
        + "\}\n"
        + "class Grand \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Middle extends Grand \{\n"
        + "\}\n"
        + "class Leaf extends Middle \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 5L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Constructor of 'Unchained' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width);' and add 'int width' to its parameters.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Constructor of 'Matching' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width);'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Constructor of 'OverGuarded' does not call 'super(...)', so it would run the "
        + "zero-argument constructor of its base class 'Guarded', which is private to 'Guarded'. "
        + "Mark 'constructor()' in 'Guarded' as 'protected' so a subclass can call it.");
    try sema_support.assertDiagnostic(found, 3, "/proj/src/main.ens",
        "Constructor of 'OverHidden' does not call 'super(...)', so it would run the "
        + "zero-argument constructor of its base class 'Hidden', which declares none. Mark "
        + "'constructor(int)' in 'Hidden' as 'protected' so a subclass can call it, then start "
        + "this constructor's body with 'super(count);' and add 'int count' to its parameters.");
    try sema_support.assertDiagnostic(found, 4, "/proj/src/main.ens",
        "The constructor of 'Hidden' is private, so only code inside 'Hidden' can call it. Mark it "
        + "'protected' to call it from a subclass.");
}

// A public constructor is out of reach of a subclass in another package. An exported one is within reach.
test "a class with no constructor cannot run a base constructor its package does not export" {
    let loader = new FakeFileLoader();
    loader.add("/ens.package", "workspace \{\n"
        + "    member \"proj\";\n"
        + "    member \"proj/vendor/acme\";\n"
        + "\}\n");
    loader.add("/proj/ens.package", "package demo.app \{\n    ens \"0.1\";\n    dependency acme;\n\}\n");
    loader.add("/proj/vendor/acme/ens.package", "package acme \{ ens \"0.1\"; \}\n");
    loader.add("/proj/vendor/acme/src/parts.ens",
        "export class Latched \{\n"
        + "    public constructor();\n"
        + "\}\n"
        + "export class Gear \{\n"
        + "    export constructor();\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Latched from @acme.parts;\n"
        + "import Gear from @acme.parts;\n"
        + "class Bolt extends Latched \{\n"
        + "\}\n"
        + "class Cog extends Gear \{\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Class 'Bolt' declares no constructor, so it would run the zero-argument constructor of "
        + "its base class 'Latched', which is public inside package 'acme' but not exported. Mark "
        + "'constructor()' in 'Latched' as 'export' so a subclass in another package can call it.");
}

// The implicit chain picks a zero-argument constructor the class can reach, so a private one gives
// way to a reachable one whose parameters all take defaults.
test "an unreachable zero-argument base constructor gives way to a reachable one" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "public class Base \{\n"
        + "    constructor() \{ \}\n"
        + "    protected constructor(int count = 4) \{ \}\n"
        + "\}\n"
        + "class Plain extends Base \{\n"
        + "\}\n"
        + "class Declared extends Base \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Leaf extends Plain \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let plain = new Plain();\n"
        + "    let declared = new Declared();\n"
        + "    let leaf = new Leaf();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// The implicit chain stops at the nearest base class that declares constructors. A class below
// it with no constructor of its own is refused there, and the classes further down report
// nothing more. A constructor further down that reaches an excluded conditional constructor
// through such a class is refused where it is declared, with or without 'super()'.
test "the implicit chain walks through a class with no constructor to the base that declares them" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Mute \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class Top<T> \{\n"
        + "    protected constructor<T: Speaker>() \{ \}\n"
        + "    protected constructor(int size) \{ \}\n"
        + "\}\n"
        + "class Middle<T> extends Top<T> \{\n"
        + "\}\n"
        + "class Bottom extends Middle<Mute> \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "class SuperBottom extends Middle<Mute> \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "class Sized \{\n"
        + "    protected constructor(int size) \{ \}\n"
        + "\}\n"
        + "class OverSized extends Sized \{\n"
        + "\}\n"
        + "class Lower extends OverSized \{\n"
        + "\}\n"
        + "class Lowest extends OverSized \{\n"
        + "    protected constructor() \{ super(); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let lower = new Lower();\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let checked = analysis.checkDiagnostics();
    try testing.assertEqual(checked.length, 1L);
    try sema_support.assertDiagnostic(checked, 0, "/proj/src/main.ens",
        "Class 'OverSized' declares no constructor, so it would run the zero-argument constructor "
        + "of its base class 'Sized', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'constructor(int size) \{ super(size); \}'.");
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Constructor of 'Bottom' cannot initialize base class 'Middle<Mute>', which declares no "
        + "constructor and so runs the zero-argument constructor of 'Top<Mute>': the zero-argument "
        + "constructor of 'Top<T>' exists only when 'T' satisfies 'Speaker', and in 'Top<Mute>', 'T' "
        + "is 'Mute', which does not implement 'Speaker'. Give 'Top' a zero-argument constructor "
        + "that exists for every type argument, or use a type argument that satisfies the bound.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Constructor of 'SuperBottom' cannot initialize base class 'Middle<Mute>', which declares no "
        + "constructor and so runs the zero-argument constructor of 'Top<Mute>': the zero-argument "
        + "constructor of 'Top<T>' exists only when 'T' satisfies 'Speaker', and in 'Top<Mute>', 'T' "
        + "is 'Mute', which does not implement 'Speaker'. Give 'Top' a zero-argument constructor "
        + "that exists for every type argument, or use a type argument that satisfies the bound.");
}

// The constructor a fix declares carries the marker that keeps the class as constructible as the
// constructor it replaces. A type the file has no name for comes with the import that binds one,
// under a name of its own where the file already uses the type's name.
test "a fix for a missing base constructor call keeps the class's reach and imports what it names" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens",
        "public class Widget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Gadget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public constructor(Widget widget, Gadget[] gadgets) \{ \}\n"
        + "\}\n"
        + "export class Plain \{\n"
        + "    export constructor(int count) \{ \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Base from parts;\n"
        + "import Plain from parts;\n"
        + "class Widget \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public class Child extends Base \{\n"
        + "\}\n"
        + "export class Shared extends Plain \{\n"
        + "\}\n"
        + "class Declared extends Base \{\n"
        + "    protected constructor(int size) \{ \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks, Stage.Bodies]);
    let checked = analysis.checkDiagnostics();
    try testing.assertEqual(checked.length, 2L);
    try sema_support.assertDiagnostic(checked, 0, "/proj/src/main.ens",
        "Class 'Child' declares no constructor, so it would run the zero-argument constructor of "
        + "its base class 'Base', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'public constructor(PartsWidget widget, Gadget[] gadgets) \{ "
        + "super(widget, gadgets); \}', with 'import Widget as PartsWidget from parts;' and 'import "
        + "Gadget from parts;' at the top of the file.");
    try sema_support.assertDiagnostic(checked, 1, "/proj/src/main.ens",
        "Class 'Shared' declares no constructor, so it would run the zero-argument constructor of "
        + "its base class 'Plain', which declares none. Declare a constructor that calls "
        + "'super(...)', as in 'export constructor(int count) \{ super(count); \}'.");
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Constructor of 'Declared' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Base', which declares none. Start this constructor's "
        + "body with 'super(widget, gadgets);' and add 'PartsWidget widget, Gadget[] gadgets' to "
        + "its parameters, with 'import Widget as PartsWidget from parts;' and 'import Gadget from "
        + "parts;' at the top of the file.");
}

// The fixes the refusals above suggest compile in the file they were read in, and each fixed
// class can still be built there.
test "the fixes that import what they name compile and construct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/parts.ens",
        "public class Widget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Gadget \{\n"
        + "    public constructor() \{ \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public constructor(Widget widget, Gadget[] gadgets) \{ \}\n"
        + "\}\n"
        + "export class Plain \{\n"
        + "    export constructor(int count) \{ \}\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Base from parts;\n"
        + "import Plain from parts;\n"
        + "import Widget as PartsWidget from parts;\n"
        + "import Gadget from parts;\n"
        + "class Widget \{\n"
        + "    protected constructor() \{ \}\n"
        + "\}\n"
        + "public class Child extends Base \{\n"
        + "    public constructor(PartsWidget widget, Gadget[] gadgets) \{ super(widget, gadgets); \}\n"
        + "\}\n"
        + "export class Shared extends Plain \{\n"
        + "    export constructor(int count) \{ super(count); \}\n"
        + "\}\n"
        + "class Declared extends Base \{\n"
        + "    protected constructor(int size, PartsWidget widget, Gadget[] gadgets) \{\n"
        + "        super(widget, gadgets);\n"
        + "    \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let child = new Child(new PartsWidget(), [new Gadget()]);\n"
        + "    let shared = new Shared(1);\n"
        + "    let declared = new Declared(2, new PartsWidget(), []);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

// A 'super()' written in a method is refused for that alone, even over a chain whose zero-argument
// constructor the type arguments exclude.
test "a 'super()' in a method reports only that it belongs in a constructor" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Mute \{\n"
        + "    constructor() \{ \}\n"
        + "\}\n"
        + "class Top<T> \{\n"
        + "    constructor<T: Speaker>() \{ \}\n"
        + "\}\n"
        + "class Middle<T> extends Top<T> \{\n"
        + "\}\n"
        + "class Bottom extends Middle<Mute> \{\n"
        + "    run() \{ super(); \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'super(...)' can only be called from a constructor.");
}

// A parameter the fix adds takes a number after its name when the constructor already uses the
// name for something else. A constructor with no body is told to gain one.
test "a declared constructor's fix keeps its own parameter names and its bodiless form" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    constructor(int width, int height) \{ \}\n"
        + "\}\n"
        + "class Clash extends Sized \{\n"
        + "    constructor(string width) \{ \}\n"
        + "\}\n"
        + "class Crowded extends Sized \{\n"
        + "    constructor(string width, bool width2) \{ \}\n"
        + "\}\n"
        + "class Shorthand extends Sized \{\n"
        + "    int depth;\n"
        + "    constructor(this.depth);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Bodies]);
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "Constructor of 'Clash' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width2, height);' and add 'int width2, int height' to its parameters.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/main.ens",
        "Constructor of 'Crowded' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Start this constructor's "
        + "body with 'super(width3, height);' and add 'int width3, int height' to its parameters.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/main.ens",
        "Constructor of 'Shorthand' does not call 'super(...)', so it would run the zero-argument "
        + "constructor of its base class 'Sized', which declares none. Give this constructor a body "
        + "that starts with 'super(width, height);' and add 'int width, int height' to its "
        + "parameters.");
}

// The fixes the refusals above suggest compile in the file they were read in, and each fixed
// class can still be built there.
test "the fixes that rename or give a body compile and construct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "class Sized \{\n"
        + "    constructor(int width, int height) \{ \}\n"
        + "\}\n"
        + "class Clash extends Sized \{\n"
        + "    constructor(string width, int width2, int height) \{ super(width2, height); \}\n"
        + "\}\n"
        + "class Crowded extends Sized \{\n"
        + "    constructor(string width, bool width2, int width3, int height) \{\n"
        + "        super(width3, height);\n"
        + "    \}\n"
        + "\}\n"
        + "class Shorthand extends Sized \{\n"
        + "    int depth;\n"
        + "    constructor(this.depth, int width, int height) \{ super(width, height); \}\n"
        + "\}\n"
        + "main() -> int \{\n"
        + "    let clash = new Clash(\"wide\", 1, 2);\n"
        + "    let crowded = new Crowded(\"wide\", true, 3, 4);\n"
        + "    let shorthand = new Shorthand(5, 6, 7);\n"
        + "    return 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertProgramClean(analysis);
}

test "interfaces, weak fields, destructors and hash name what to change" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "    constructor();\n"
        + "    destructor();\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    weak int count;\n"
        + "    weak Watcher?? twice;\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Handle \{\n"
        + "    constructor();\n"
        + "    public destructor() \{ \}\n"
        + "\}\n"
        + "class Other \{\n"
        + "    constructor();\n"
        + "    override destructor() throws \{ \}\n"
        + "\}\n"
        + "class Keyed \{\n"
        + "    constructor();\n"
        + "    override hash(int seed) -> long \{ return 1; \}\n"
        + "    override equals(Keyed other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "class Keyless \{\n"
        + "    constructor();\n"
        + "    override hash() \{ \}\n"
        + "    override equals(Keyless other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 2L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Interface 'Speaker' cannot declare a constructor. An interface has no objects of its own "
        + "to build. Remove the constructor.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "Interface 'Speaker' cannot declare a destructor. An interface has no objects of its own "
        + "to destroy. Remove the destructor.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 7L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "Field 'count' of class 'Watcher' is 'weak', so its type must be a class. 'int' is not a "
        + "class. Remove 'weak'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "Field 'twice' of class 'Watcher' is 'weak', so its type needs exactly one '?'. "
        + "'Watcher??' has two. Write 'weak Watcher? twice'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "The destructor of 'Handle' cannot be 'public'. No code calls a destructor; it runs when "
        + "the object is destroyed. Remove 'public'.");
    try sema_support.assertDiagnostic(layout, 3, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be 'override'. No destructor replaces another: when an "
        + "object is destroyed, its own class's destructor and every base class's destructor run. "
        + "Remove 'override'.");
    try sema_support.assertDiagnostic(layout, 4, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be marked 'throws'. It runs when the object is "
        + "destroyed, where no code can catch an exception. Remove 'throws', and catch the "
        + "exceptions with 'catch' clauses after the destructor body.");
    try sema_support.assertDiagnostic(layout, 5, "/proj/src/app.ens",
        "Method 'hash' of 'Keyed' takes parameters. A Map or Set calls 'hash()' to find a key. "
        + "Every class inherits 'hash() -> long'. Write 'override hash() -> long', or rename the "
        + "method.");
    try sema_support.assertDiagnostic(layout, 6, "/proj/src/app.ens",
        "Method 'hash' of 'Keyless' returns nothing. A Map or Set calls 'hash()' to find a key. "
        + "Every class inherits 'hash() -> long'. Write 'override hash() -> long', or rename the "
        + "method.");
}

test "a repeated visibility mark names the first, and a private abstract method is reported once" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Visible \{\n"
        + "    public protected greet() \{ \}\n"
        + "    public public constructor() \{ \}\n"
        + "\}\n"
        + "public abstract class Shape \{\n"
        + "    protected constructor();\n"
        + "    abstract go();\n"
        + "\}\n"
        + "public class Square extends Shape \{\n"
        + "    public constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "    override go() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "'greet' is already marked 'public'. A declaration takes one visibility modifier. Remove "
        + "'protected'.");
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The constructor of 'Visible' is already marked 'public'. A declaration takes one "
        + "visibility modifier. Remove this second 'public'.");
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "Abstract method 'go' is private to 'Shape', so no subclass can implement it. Mark it 'protected'.");
}

test "a throws list naming a type parameter beside its bound names both" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Boom extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "class Thrower<T: Boom> \{\n"
        + "    constructor();\n"
        + "    run() throws T, Boom \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Checks]);
    let found = analysis.checkDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "The 'throws' list names both 'Boom' and 'T'. 'T' can only be 'Boom' or a subclass of it, "
        + "so 'Boom' alone covers both. Remove 'T'.");
}

test "a missing body, a second class bound, and a destructor's markers name what applies there" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Shape \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Rock \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "class Holder<T: Shape> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Free<W: Rock> \{\n"
        + "    Holder<W>? held;\n"
        + "\}\n"
        + "class Other \{\n"
        + "    constructor();\n"
        + "    public override destructor() \{ \}\n"
        + "\}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    weak Speaker plainSeen;\n"
        + "    constructor(this.plainSeen);\n"
        + "\}\n"
        + "struct Point \{\n"
        + "    int x;\n"
        + "    poke();\n"
        + "    static make() -> Point;\n"
        + "\}\n"
        + "loose() -> int;\n"
        + "go() throws;\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures, Stage.Layout]);
    let signatures = analysis.signatureDiagnostics();
    try testing.assertEqual(signatures.length, 5L);
    try sema_support.assertDiagnostic(signatures, 0, "/proj/src/app.ens",
        "Type argument 'W' for type parameter 'T' of 'Holder' must be 'Shape' or a subclass of it. "
        + "'W' already has the class bound 'Rock', and a type parameter takes one class bound. "
        + "Replace 'Rock' with 'Shape' or a class that extends 'Shape'.");
    try sema_support.assertDiagnostic(signatures, 1, "/proj/src/app.ens",
        "'poke' has no body; it ends in ';'. Only a constructor can leave out its body. Replace the "
        + "';' with a body between '\{' and '\}'.");
    try sema_support.assertDiagnostic(signatures, 2, "/proj/src/app.ens",
        "'make' has no body; it ends in ';'. A static method always needs a body. Replace the ';' "
        + "with a body between '\{' and '\}'.");
    try sema_support.assertDiagnostic(signatures, 3, "/proj/src/app.ens",
        "'loose' has no body; it ends in ';'. A function outside a class or a struct always needs a "
        + "body. Replace the ';' with a body between '\{' and '\}'.");
    try sema_support.assertDiagnostic(signatures, 4, "/proj/src/app.ens",
        "'go' has no body; it ends in ';'. A function outside a class or a struct always needs a "
        + "body. Replace the ';' with a body between '\{' and '\}'.");
    let layout = analysis.layoutDiagnostics();
    try testing.assertEqual(layout.length, 3L);
    try sema_support.assertDiagnostic(layout, 0, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be 'public'. No code calls a destructor; it runs when the "
        + "object is destroyed. Remove 'public'.");
    try sema_support.assertDiagnostic(layout, 1, "/proj/src/app.ens",
        "The destructor of 'Other' cannot be 'override'. No destructor replaces another: when an "
        + "object is destroyed, its own class's destructor and every base class's destructor run. "
        + "Remove 'override'.");
    try sema_support.assertDiagnostic(layout, 2, "/proj/src/app.ens",
        "Field 'plainSeen' of class 'Watcher' is 'weak', so its type must be a class. 'Speaker' is "
        + "an interface. Replace 'Speaker' with a class that implements 'Speaker', and add '?' "
        + "after it.");
}

test "a constructor or destructor marker is refused at the marker word" {
    let loader = new FakeFileLoader();
    string source = "class Seventh \{\n"
        + "    final constructor();\n"
        + "\}\n"
        + "class Eighth \{\n"
        + "    constructor();\n"
        + "    final destructor() \{ \}\n"
        + "\}\n"
        + "class Ninth \{\n"
        + "    override constructor();\n"
        + "\}\n"
        + "class Tenth \{\n"
        + "    constructor();\n"
        + "    override destructor() \{ \}\n"
        + "\}\n"
        + "class Eleventh \{\n"
        + "    constructor();\n"
        + "    abstract destructor() \{ \}\n"
        + "\}\n"
        + "class Twelfth \{\n"
        + "    abstract constructor();\n"
        + "\}\n";
    loader.add("/proj/src/app.ens", source);
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Layout]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 6L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "The constructor of 'Seventh' cannot be 'final'. 'final' stops a subclass from replacing a "
        + "method, and no subclass replaces a constructor. Remove 'final'.");
    try testing.assertEqual(found[0].span().start, source.indexOf("final constructor"));
    try sema_support.assertDiagnostic(found, 1, "/proj/src/app.ens",
        "The destructor of 'Eighth' cannot be 'final'. No destructor replaces another: when an object "
        + "is destroyed, its own class's destructor and every base class's destructor run. Remove "
        + "'final'.");
    try testing.assertEqual(found[1].span().start, source.indexOf("final destructor"));
    try sema_support.assertDiagnostic(found, 2, "/proj/src/app.ens",
        "The constructor of 'Ninth' cannot be 'override'. A constructor never replaces the "
        + "constructor of a base class. Remove 'override'.");
    try testing.assertEqual(found[2].span().start, source.indexOf("override constructor"));
    try sema_support.assertDiagnostic(found, 3, "/proj/src/app.ens",
        "The destructor of 'Tenth' cannot be 'override'. No destructor replaces another: when an "
        + "object is destroyed, its own class's destructor and every base class's destructor run. "
        + "Remove 'override'.");
    try testing.assertEqual(found[3].span().start, source.indexOf("override destructor"));
    try sema_support.assertDiagnostic(found, 4, "/proj/src/app.ens",
        "The destructor of 'Eleventh' cannot be 'abstract'. No destructor replaces another: when "
        + "an object is destroyed, its own class's destructor and every base class's destructor "
        + "run. Remove 'abstract'.");
    try testing.assertEqual(found[4].span().start, source.indexOf("abstract destructor"));
    try sema_support.assertDiagnostic(found, 5, "/proj/src/app.ens",
        "The constructor of 'Twelfth' cannot be 'abstract'. 'abstract' marks a method each "
        + "subclass writes for itself, and a subclass never writes its base class's constructor. "
        + "Remove 'abstract'.");
    try testing.assertEqual(found[5].span().start, source.indexOf("abstract constructor"));
}

// A program 'demo.<name>' in a workspace beside the dependency 'acme.entry', whose main module
// declares 'main', and 'acme.mid', which imports it.
entryWorkspace(string name, string mainSource) -> FakeFileLoader {
    let loader = new FakeFileLoader();
    loader.add("/ew/ens.package", "workspace \{\n"
        + "    member \"dep\";\n"
        + "    member \"mid\";\n"
        + "    member \"{name}\";\n"
        + "\}\n");
    loader.add("/ew/dep/ens.package", "package acme.entry \{ ens \"0.1\"; \}\n");
    loader.add("/ew/dep/src/main.ens", "main() -> int \{\n    return 0;\n\}\n");
    loader.add("/ew/mid/ens.package",
        "package acme.mid \{\n    ens \"0.1\";\n    dependency acme.entry;\n\}\n");
    loader.add("/ew/mid/src/relay.ens", "import @acme.entry.main;\n"
        + "start() -> int \{\n    return 0;\n\}\n");
    loader.add("/ew/{name}/ens.package", "package demo.{name} \{\n    ens \"0.1\";\n"
        + "    dependency acme.entry;\n    dependency acme.mid;\n\}\n");
    loader.add("/ew/{name}/src/main.ens", mainSource);
    return loader;
}

// The one signature refusal reported in the dependency's main module.
entryRefusal(FakeFileLoader loader, string name) -> string throws {
    let analysis = sema_support.analyzeAll(loader, "/ew/{name}/src", ["main.ens"]);
    let found = new List<FileDiagnostic>();
    for (let diagnostic in analysis.signatureDiagnostics()) {
        if (diagnostic.file() == "/ew/dep/src/main.ens") {
            found.push(diagnostic);
        }
    }
    try testing.assertEqual(found.length(), 1L);
    return found.get(0).message();
}

test "a dependency's main offers removing an import only when the program writes it on one line" {
    string rule = "Function 'main' starts the program, so only the program's main module, "
        + "'main.ens', can declare it. This file is the main module of package 'acme.entry', a "
        + "dependency of this program. ";
    string body = "\nmain() -> int \{\n    return 0;\n\}\n";
    try testing.assertEqual(try entryRefusal(entryWorkspace("app",
        "import @acme.entry.main as entry;\n" + body), "app"),
        rule + "Rename this function, or remove 'import @acme.entry.main as entry;' from module "
        + "'main'.");
    try testing.assertEqual(try entryRefusal(entryWorkspace("split",
        "import @acme.entry\n    .main as entry;\n" + body), "split"), rule + "Rename this function.");
    try testing.assertEqual(try entryRefusal(entryWorkspace("noted",
        "import @acme.entry.main /* the entry */ as entry;\n" + body), "noted"),
        rule + "Rename this function.");
    try testing.assertEqual(try entryRefusal(entryWorkspace("relayed",
        "import @acme.mid.relay;\n" + body), "relayed"), rule + "Rename this function.");
}

test "a 'src/main.ens' in a folder with no manifest is told how to become the main module" {
    let loader = new FakeFileLoader();
    loader.add("/prog/src/main.ens", "main() -> int \{\n    return 0;\n\}\n");
    let analysis = sema_support.analyzeAll(loader, "/prog", ["src/main.ens"]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/prog/src/main.ens",
        "Function 'main' starts the program, so only the program's main module, 'main.ens', can "
        + "declare it. The program folder has no 'ens.package' file, so 'src/main.ens' is module "
        + "'src.main' and not the main module. Move this file to 'main.ens' at the root of the "
        + "program folder, or add an 'ens.package' file so that 'src/main.ens' becomes the main "
        + "module.");
}

test "an interface method named 'hash' is held to the one shape a Map or Set calls" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens", "interface Keyed \{\n"
        + "    hash() -> int;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertProgramCleanExcept(analysis, [Stage.Signatures]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Method 'hash' of interface 'Keyed' returns 'int'. A Map or Set calls 'hash()' to find a "
        + "key. An interface method named 'hash' must be 'hash() -> long'. Write 'hash() -> long', "
        + "or rename the method.");
}

test "a 'src/main.ens' beside the program's own 'main.ens' keeps the general text" {
    let loader = new FakeFileLoader();
    loader.add("/prog/main.ens", "import src.main as other;\n"
        + "main() -> int \{\n    return 0;\n\}\n");
    loader.add("/prog/src/main.ens", "public main() -> int \{\n    return 1;\n\}\n");
    let analysis = sema_support.analyzeAll(loader, "/prog", ["main.ens"]);
    let found = new List<FileDiagnostic>();
    for (let diagnostic in analysis.signatureDiagnostics()) {
        if (diagnostic.file() == "/prog/src/main.ens") {
            found.push(diagnostic);
        }
    }
    try testing.assertEqual(found.length(), 1L);
    try testing.assertEqual(found.get(0).message(), "Function 'main' starts the program, so only "
        + "the program's main module, 'main.ens', can declare it. This file is module 'src.main'. "
        + "Rename this function, or move it into 'main.ens'.");
}
