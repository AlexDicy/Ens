import @std.testing;
import FakeFileLoader from sema_support;
import sema_support;

test "an external block may only name a native library its manifest declares" {
    let loader = new FakeFileLoader();
    loader.add("/proj/ens.package", "package demo.app \{\n"
        + "    ens \"0.1\";\n"
        + "    native libc system;\n"
        + "\}\n");
    loader.add("/proj/src/app.ens",
        "external from libc \{\n"
        + "    abs(int value) -> int;\n"
        + "\}\n"
        + "external from zlib \{\n"
        + "    compressBound(ulong sourceLength) -> ulong;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertMentions(found, "External library 'zlib' is not declared in "
        + "/proj/ens.package. Add 'native zlib;' (or a 'system' or per-platform form) to the "
        + "package manifest.");
}

test "type references diagnose unknown names, bare generics, arity, and non-generics" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box<T> \{\n"
        + "    T? value;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Bad \{\n"
        + "    Nope a;\n"
        + "    Box b;\n"
        + "    Box<int, int> c;\n"
        + "    int<int> d;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found, "Unknown type 'Nope'");
    try sema_support.assertMentions(found, "Generic type 'Box' requires type arguments");
    try sema_support.assertMentions(found, "expects 1 type argument, but 2 were given");
    try sema_support.assertMentions(found, "'int' is not generic and takes no type arguments");
}

test "the reserved word 'decimal' is refused wherever a type is named" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box<T> \{\n"
        + "    T? value;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Money \{\n"
        + "    decimal amount;\n"
        + "    decimal? pending;\n"
        + "    decimal[]? history;\n"
        + "    Box<decimal>? boxed;\n"
        + "\}\n"
        + "rate(decimal factor) -> decimal \{\n"
        + "    return factor;\n"
        + "\}\n"
        + "use() \{\n"
        + "    decimal here = 0;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    string message = "'decimal' is a reserved word and not a usable type yet. Use 'double' for "
        + "fractional values, or hold the value in an integer scaled by hand (for example a "
        + "'long' count of cents) when it has to be exact.";
    let declared = analysis.signatureDiagnostics();
    try testing.assertEqual(declared.length, 6L);
    for (let diagnostic in declared) {
        try testing.assertEqual(diagnostic.message(), message);
    }
    let inBody = analysis.bodyDiagnostics();
    try testing.assertEqual(inBody.length, 1L);
    try testing.assertEqual(inBody[0].message(), message);
}

test "qualified references diagnose visibility, missing types, and unknown aliases" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import lib.shapes;\n"
        + "struct Holder \{\n"
        + "    shapes.Hidden h;\n"
        + "    shapes.Missing m;\n"
        + "    foo.Thing t;\n"
        + "\}\n");
    loader.add("/proj/src/lib/shapes.ens",
        "class Hidden \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found,
        "Type 'Hidden' is private to module 'lib.shapes'");
    try sema_support.assertMentions(found, "Module 'lib.shapes' has no type 'Missing'");
    try sema_support.assertMentions(found, "'foo' is not an imported module");
}

test "function collection rejects duplicate, generic, main, and external overloads" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "add(int a) -> int \{ return a; \}\n"
        + "add(int b) -> int \{ return b; \}\n"
        + "main() \{ \}\n"
        + "main(int x) \{ \}\n"
        + "pick<T>(T value) \{ \}\n"
        + "pick(int value) \{ \}\n"
        + "dup(long y) -> long \{ return y; \}\n"
        + "external from m \{\n"
        + "    dup(int x) -> int;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found,
        "Function 'add' is already declared with the same parameter types");
    try sema_support.assertMentions(found, "Function 'main' cannot be overloaded");
    try sema_support.assertMentions(found, "'pick' cannot be overloaded because one of its "
        + "declarations is generic");
    try sema_support.assertMentions(found, "External function 'dup' cannot share its name");
}

test "main may only be defined in the main module" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/main.ens",
        "import app;\n"
        + "main() -> int \{\n"
        + "    return 0;\n"
        + "\}\n");
    loader.add("/proj/src/app.ens",
        "main() -> int \{\n"
        + "    return 1;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/app.ens",
        "Function 'main' is the program entry point and may only be defined in the main "
        + "module (src/main.ens); module 'app' cannot define it.");
}

test "the entry point rejects a wrong return type, parameters, and type parameters" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/tool.ens",
        "main<T>(int limit) -> long \{\n"
        + "    return 0L;\n"
        + "\}\n");
    let analysis = sema_support.analyzeFileProgram(loader, "/proj/src", "tool.ens");
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertMentions(found,
        "Function 'main' is the program entry point and cannot be generic, so it cannot declare "
        + "the type parameter 'T'; nothing calls it with type arguments. Declare it as "
        + "'main() -> int' (or 'main()') and put the generic work in a function that "
        + "'main' calls.");
    try sema_support.assertMentions(found,
        "Function 'main' is the program entry point and takes no parameters, so it cannot "
        + "declare 'limit'. Declare it as 'main() -> int' (or 'main()') and read the command "
        + "line with 'system.arguments()' after 'import @std.system;'.");
    try sema_support.assertMentions(found,
        "Function 'main' is the program entry point and must return 'int' or nothing, not "
        + "'long'; the value it returns becomes the process exit code. Write 'main() -> int' "
        + "to choose the exit code, or 'main()' to leave it 0.");
}

test "the entry point accepts no return type, 'int', 'throws', and 'noreturn'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/plain.ens", "main() \{ \}\n");
    loader.add("/proj/src/coded.ens", "main() -> int \{\n    return 0;\n\}\n");
    loader.add("/proj/src/failing.ens",
        "main() -> int throws \{\n    throw new Error(\"stop\");\n\}\n");
    loader.add("/proj/src/looping.ens", "noreturn main() \{\n    while (true) \{ \}\n\}\n");
    for (let entry in ["plain.ens", "coded.ens", "failing.ens", "looping.ens"]) {
        let analysis = sema_support.analyzeFileProgram(loader, "/proj/src", entry);
        try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    }
}

test "the override matrix rejects hiding, final, missing bases, and mismatches" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Base \{\n"
        + "    constructor();\n"
        + "    protected greet() -> int \{ return 1; \}\n"
        + "    protected final locked() -> int \{ return 2; \}\n"
        + "\}\n"
        + "class Derived extends Base \{\n"
        + "    constructor();\n"
        + "    greet() -> int \{ return 3; \}\n"
        + "    override locked() -> int \{ return 4; \}\n"
        + "    override missing() -> int \{ return 5; \}\n"
        + "    override greet(int x) -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertMentions(found, "hides a method inherited from 'Base'");
    try sema_support.assertMentions(found, "declared 'final' in 'Base'");
    try sema_support.assertMentions(found,
        "marked 'override' but no base class or implemented interface declares it");
    try sema_support.assertMentions(found,
        "Override of 'greet' does not match the signature declared in 'Base'");
}

test "abstract methods need abstract classes and concrete subclasses must implement them" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Solid \{\n"
        + "    constructor();\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "abstract class Shape \{\n"
        + "    protected abstract area() -> int;\n"
        + "\}\n"
        + "class Flat extends Shape \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertMentions(found,
        "Abstract method 'area' requires class 'Solid' to be declared 'abstract'");
    try sema_support.assertMentions(found,
        "Class 'Flat' must override abstract method 'area'");
}

test "interfaces reject fields, bodies, modifiers, and typeless throws" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    int volume;\n"
        + "    speak() -> string \{ return \"\"; \}\n"
        + "    public quiet();\n"
        + "    loud() throws;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found, "An interface cannot declare fields");
    try sema_support.assertMentions(found, "Interface method 'speak' cannot have a body");
    try sema_support.assertMentions(found,
        "The members of an interface always share the interface's visibility");
    try sema_support.assertMentions(found,
        "An interface method marked 'throws' must list its exception types");
}

test "a member cannot be more visible than the type that contains it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Hidden \{\n"
        + "    export int wide;\n"
        + "    public constructor();\n"
        + "    export speak() -> string \{ return \"\"; \}\n"
        + "\}\n"
        + "public struct Pt \{\n"
        + "    export int x;\n"
        + "    export scaled() -> int \{ return this.x; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Field 'wide' is marked 'export' but 'Hidden' is private to its file; a member "
        + "cannot be more visible than the type that contains it. Raise 'Hidden' to "
        + "'export', or lower 'wide'.");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Constructor 'constructor' is marked 'public' but 'Hidden' is private to its file");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Method 'speak' is marked 'export' but 'Hidden' is private to its file");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Field 'x' is marked 'export' but 'Pt' is only 'public'");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "Method 'scaled' is marked 'export' but 'Pt' is only 'public'");
}

test "'final' says nothing on a private method, while a declared throws list still bounds it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Failure extends Error \{\n"
        + "    protected constructor(string message) \{ super(message); \}\n"
        + "\}\n"
        + "public class Base \{\n"
        + "    public constructor();\n"
        + "    final frozen() -> int \{ return 1; \}\n"
        + "    read() -> int throws Failure \{ return 2; \}\n"
        + "    protected final locked() -> int \{ return 3; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertMentions(found,
        "Method 'frozen' cannot be 'final': it is private to 'Base', so it is not inherited");
    try testing.assertEqual(found.length, 1L);
}

test "a struct's members are private unless marked, exactly as a class's are" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/lib.ens",
        "public struct Point \{\n"
        + "    public int x;\n"
        + "    int secret = 0;\n"
        + "\}\n");
    loader.add("/proj/src/main.ens",
        "import Point from lib;\n"
        + "main() -> int \{\n"
        + "    Point p = \{x: 1\};\n"
        + "    return p.x + p.secret;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["main.ens"]);
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
    let found = analysis.bodyDiagnostics();
    try testing.assertEqual(found.length, 1L);
    try sema_support.assertDiagnostic(found, 0, "/proj/src/main.ens",
        "'secret' is private to struct 'Point' and can only be accessed from inside 'Point'");
}

test "a visible declaration may not mention a less visible type" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Secret \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "public expose(Secret s) \{ \}\n"
        + "public fetch() -> Secret \{ return new Secret(); \}\n"
        + "public class Child extends Secret \{\n"
        + "    protected constructor() \{\n"
        + "        super();\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.checkDiagnostics();
    try sema_support.assertMentions(found, "Function 'expose' is visible as 'public' but its "
        + "parameter type mentions 'Secret', which is private to module 'app'. Mark 'Secret' "
        + "as 'public', or lower the declaration.");
    try sema_support.assertMentions(found, "Function 'fetch' is visible as 'public' but its "
        + "return type mentions 'Secret', which is private to module 'app'. Mark 'Secret' as "
        + "'public', or lower the declaration.");
    try sema_support.assertMentions(found, "Class 'Child' is visible as 'public' but its "
        + "base class 'Secret' is private to module 'app'. Mark 'Secret' as 'public', or "
        + "lower the declaration.");
}

test "a protected member leaks only as far as its class can be subclassed" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Secret \{\n"
        + "    protected constructor();\n"
        + "\}\n"
        + "export class Channel \{\n"
        + "    export constructor();\n"
        + "    protected open(Secret secret) \{ \}\n"
        + "\}\n"
        + "public class Registry \{\n"
        + "    protected Secret entry;\n"
        + "    protected constructor(this.entry);\n"
        + "\}\n"
        + "export final class Wrapper \{\n"
        + "    protected Secret inner;\n"
        + "    protected constructor(this.inner);\n"
        + "\}\n"
        + "class Open \{\n"
        + "    protected Secret held;\n"
        + "    protected constructor(this.held);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.checkDiagnostics();
    try sema_support.assertMentions(found, "Method 'open' of class 'Channel' is protected, "
        + "and 'Channel' is an open export class whose subclasses in other packages can "
        + "reach it, but its parameter type mentions 'Secret', which is private to module "
        + "'app'. Mark 'Secret' as 'export', lower 'Channel', or mark 'Channel' 'final'.");
    try sema_support.assertMentions(found, "Field 'entry' of class 'Registry' is protected, "
        + "and 'Registry' is an open public class whose subclasses anywhere in the package "
        + "can reach it, but its type mentions 'Secret', which is private to module 'app'. "
        + "Mark 'Secret' as 'public', lower 'Registry', or mark 'Registry' 'final'.");
    try sema_support.assertMentions(found, "Constructor of class 'Registry' is protected");
    for (let diagnostic in found) {
        if (diagnostic.message().indexOf("'Wrapper'") >= 0
                || diagnostic.message().indexOf("'Open'") >= 0) {
            try testing.fail("a final or file-private class keeps the file floor for its "
                + "protected members: " + diagnostic.message());
        }
    }
}

test "interface satisfaction requires every method and the override marker" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak(int volume) -> string;\n"
        + "\}\n"
        + "class Silent implements Speaker \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Wrong implements Speaker \{\n"
        + "    constructor();\n"
        + "    speak(int volume) -> string \{ return \"\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertMentions(found, "Class 'Silent' implements 'Speaker' but does not "
        + "provide 'speak(int) -> string'");
    try sema_support.assertMentions(found,
        "implements a method declared in interface 'Speaker'; mark it 'override'");
}

test "inheritance rejects cycles once, wrong bases, and cross-module sealing" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "import Sealed from lib;\n"
        + "class A extends B \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class B extends A \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    int x;\n"
        + "\}\n"
        + "class OnValue extends Value \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "final class Locked \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class OnLocked extends Locked \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class OnSealed extends Sealed \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "sealed final class Both \{\n"
        + "    constructor();\n"
        + "\}\n");
    loader.add("/proj/src/lib.ens",
        "public sealed class Sealed \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "public class SameModule extends Sealed \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "eventually extends itself through its base classes");
    long cycles = 0;
    for (let diagnostic in analysis.layoutDiagnostics()) {
        if (diagnostic.message().indexOf("eventually extends itself") >= 0) {
            cycles++;
        }
    }
    try testing.assertEqual(cycles, 1L);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found, "'Value' is not a class; only classes can be "
        + "extended");
    try sema_support.assertMentions(found, "Cannot extend 'Locked' because it is declared "
        + "'final'");
    try sema_support.assertMentions(found, "Cannot extend 'Sealed' because it is declared "
        + "'sealed'");
    try sema_support.assertMentions(found, "cannot be both 'sealed' and 'final'");
}

test "constructor and destructor rules hold" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    int id = 0;\n"
        + "    constructor() throws \{ \}\n"
        + "    Widget(int x) \{ \}\n"
        + "    destructor(int extra) -> int \{ \}\n"
        + "    destructor() \{ \}\n"
        + "    poke();\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    int x;\n"
        + "    destructor() \{ \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let layout = analysis.layoutDiagnostics();
    try sema_support.assertMentions(layout, "A constructor cannot be marked 'throws'");
    try sema_support.assertMentions(layout,
        "A method cannot be named after its class 'Widget'");
    try sema_support.assertMentions(layout, "A destructor cannot declare parameters");
    try sema_support.assertMentions(layout, "A destructor cannot declare a return type");
    try sema_support.assertMentions(layout, "A class can declare at most one destructor");
    try sema_support.assertMentions(layout,
        "Shorthand declaration ';' is only allowed on a constructor");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "A struct cannot declare a destructor");
}

test "hash and equals are validated as a pair with exact signatures" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class OnlyHash \{\n"
        + "    constructor();\n"
        + "    override hash() -> long \{ return 1; \}\n"
        + "\}\n"
        + "class OnlyEquals \{\n"
        + "    constructor();\n"
        + "    override equals(OnlyEquals other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "class BadHash \{\n"
        + "    constructor();\n"
        + "    override hash() -> int \{ return 1; \}\n"
        + "\}\n"
        + "class Unmarked \{\n"
        + "    constructor();\n"
        + "    hash() -> long \{ return 1; \}\n"
        + "    override equals(Unmarked other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try sema_support.assertMentions(found, "Class 'OnlyHash' defines 'hash' but not 'equals'");
    try sema_support.assertMentions(found,
        "Class 'OnlyEquals' defines 'equals' but not 'hash'");
    try sema_support.assertMentions(found,
        "A method named 'hash' must have the signature 'hash() -> long'");
    try sema_support.assertMentions(found, "overrides the built-in identity hash");
}

test "a class's marked toString is held to the text form it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public class Throwing \{\n"
        + "    public constructor();\n"
        + "    public override toString() -> string throws \{ return \"t\"; \}\n"
        + "\}\n"
        + "public class Shaped \{\n"
        + "    public constructor();\n"
        + "    public override toString(int width) -> string \{ return \"w\"; \}\n"
        + "\}\n"
        + "abstract class Ghost \{\n"
        + "    abstract override toString() -> string;\n"
        + "\}\n"
        + "public class Quiet \{\n"
        + "    public constructor();\n"
        + "    protected override toString() -> string \{ return \"q\"; \}\n"
        + "\}\n"
        + "public class Legacy \{\n"
        + "    public constructor();\n"
        + "    public toString() -> string \{ return \"l\"; \}\n"
        + "\}\n"
        + "public class Sized \{\n"
        + "    public constructor();\n"
        + "    public toString(int scale) -> string \{ return \"s\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.layoutDiagnostics();
    try testing.assertEqual(found.length, 4L);
    try sema_support.assertMentions(found,
        "A method named 'toString' cannot be marked 'throws'; a value's text form is used where "
            + "there is no room for a 'try', such as an interpolation hole. Remove 'throws', or "
            + "rename the method.");
    try sema_support.assertMentions(found,
        "A method named 'toString' must have the signature 'toString() -> string'; it defines "
            + "how values of this type render as text (for example in an interpolation hole).");
    try sema_support.assertMentions(found,
        "Method 'toString' of 'Ghost' cannot be 'abstract': every class already answers with "
            + "its type name, so a 'toString' override needs a body that replaces that default. "
            + "Write the body, or remove the method.");
    try sema_support.assertMentions(found,
        "Method 'toString' replaces the built-in text form of class 'Quiet', so it must be as "
            + "visible as 'Quiet' itself; mark it 'public'.");
}

test "a struct's toString is held to the text form it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct Shaped \{\n"
        + "    int x;\n"
        + "    public override toString(int width) -> string \{ return \"w\"; \}\n"
        + "\}\n"
        + "public struct Throwing \{\n"
        + "    int x;\n"
        + "    public override toString() -> string throws \{ return \"t\"; \}\n"
        + "\}\n"
        + "public struct Unmarked \{\n"
        + "    int x;\n"
        + "    public toString() -> string \{ return \"u\"; \}\n"
        + "\}\n"
        + "struct Following \{\n"
        + "    int x;\n"
        + "    override toString() -> string \{ return \"f\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertMentions(found,
        "A method named 'toString' must have the signature 'toString() -> string'; it defines "
            + "how values of this type render as text (for example in an interpolation hole).");
    try sema_support.assertMentions(found,
        "A method named 'toString' cannot be marked 'throws'; a value's text form is used where "
            + "there is no room for a 'try', such as an interpolation hole. Remove 'throws', or "
            + "rename the method.");
    try sema_support.assertMentions(found,
        "Method 'toString' overrides the built-in text form of struct 'Unmarked'; mark it "
            + "'override'.");
}

test "a struct member overrides only what the language gives a struct" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Counter \{\n"
        + "    int value;\n"
        + "    override constructor(this.value);\n"
        + "    override doubled() -> int \{ return this.value * 2; \}\n"
        + "    override hash() -> long \{ return this.value; \}\n"
        + "    override equals(Counter other) -> bool \{ return true; \}\n"
        + "    override toString() -> string \{ return \"c\"; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 2L);
    try sema_support.assertMentions(found, "A constructor cannot be 'override' or 'abstract'.");
    try sema_support.assertMentions(found,
        "Method 'doubled' of 'Counter' is marked 'override' but structs do not inherit, so there "
            + "is nothing to override; only 'toString', 'hash', and 'equals' replace a built-in "
            + "behavior of a struct. Remove 'override'.");
}

test "a struct's hash is held to the content hash it replaces" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct Unmarked \{\n"
        + "    int id;\n"
        + "    public hash() -> long \{ return this.id; \}\n"
        + "    public override equals(Unmarked other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "public struct Shaped \{\n"
        + "    int id;\n"
        + "    public hash() -> int \{ return 1; \}\n"
        + "\}\n"
        + "public struct Throwing \{\n"
        + "    int id;\n"
        + "    public override hash() -> long throws \{ return this.id; \}\n"
        + "\}\n"
        + "public struct Marked \{\n"
        + "    int id;\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "    public override equals(Marked other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertMentions(found,
        "Method 'hash' overrides the built-in content hash of struct 'Unmarked'; mark it "
            + "'override'.");
    try sema_support.assertMentions(found,
        "A method named 'hash' must have the signature 'hash() -> long'");
    try sema_support.assertMentions(found,
        "A method named 'hash' cannot be marked 'throws'; a value's hash is taken where there "
            + "is no room for a 'try', such as when it is used as a Map or Set key. Remove "
            + "'throws', or rename the method.");
}

test "a struct's hash and equals are a matched pair, each written override" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "public struct HashOnly \{\n"
        + "    int id;\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "\}\n"
        + "public struct EqualsOnly \{\n"
        + "    int id;\n"
        + "    public override equals(EqualsOnly other) -> bool \{ return true; \}\n"
        + "\}\n"
        + "public struct Ordinary \{\n"
        + "    int id;\n"
        + "    public equals(Ordinary other) -> bool \{ return true; \}\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "\}\n"
        + "public struct Paired \{\n"
        + "    int id;\n"
        + "    public override hash() -> long \{ return this.id; \}\n"
        + "    public override equals(Paired other) -> bool \{ return true; \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try testing.assertEqual(found.length, 3L);
    try sema_support.assertMentions(found,
        "Struct 'HashOnly' defines 'hash' but not 'equals'. A struct that customizes one must "
            + "customize both, so equal values hash equally. Add an 'equals(HashOnly other) -> "
            + "bool' method.");
    try sema_support.assertMentions(found,
        "Struct 'EqualsOnly' defines 'equals' but not 'hash'. A struct that customizes one must "
            + "customize both, so equal values hash equally. Add a 'hash() -> long' method.");
    try sema_support.assertMentions(found,
        "Method 'equals' overrides the built-in memberwise equality of struct 'Ordinary'; mark "
            + "it 'override'.");
}

test "a struct member cannot be abstract" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Box \{\n"
