test "a field cannot be both 'weak' and 'const'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Tangle \{\n"
        + "    weak const Tangle? neighbor;\n"
        + "    constructor(this.neighbor);\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Field 'neighbor' cannot be both 'weak' and 'const': a 'const' field keeps one value "
            + "for the object's whole life, while a 'weak' field becomes null when the object "
            + "it refers to is destroyed. Remove one of the two.");
}

test "a class with a non-defaulted 'const' field needs a constructor to assign it" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Silent \{\n"
        + "    const int value;\n"
        + "\}\n"
        + "class Covered \{\n"
        + "    const int value = 1;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.checkDiagnostics();
    try sema_support.assertMentions(found,
        "Field 'value' of class 'Silent' is 'const' but 'Silent' has no constructor to assign "
            + "it. A 'const' field without a default value is assigned exactly once, in a "
            + "constructor; add one (e.g. 'constructor(this.value);'), or give the field a "
            + "default value.");
    for (let diagnostic in found) {
        if (diagnostic.message().indexOf("'Covered'") >= 0) {
            try testing.fail("a defaulted const field needs no constructor: "
                + diagnostic.message());
        }
    }
}

test "weak fields must be nullable classes and never sit on structs" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Watcher \{\n"
        + "    weak Watcher direct;\n"
        + "    weak Speaker? seen;\n"
        + "    constructor();\n"
        + "\}\n"
        + "struct Value \{\n"
        + "    weak int x;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "'weak' fields must be nullable class types");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "interface-typed weak fields are not supported");
    try sema_support.assertMentions(analysis.signatureDiagnostics(),
        "'weak' fields are not allowed on structs");
}

test "field defaults may only reference earlier fields" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "helperValue() -> int \{ return 3; \}\n"
        + "struct Bad \{\n"
        + "    int area = width * height;\n"
        + "    int width = 4;\n"
        + "    int height = helperValue();\n"
        + "    int self = self;\n"
        + "    int fine = width;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.checkDiagnostics();
    try sema_support.assertMentions(found, "references 'width', which is declared later");
    try sema_support.assertMentions(found, "references 'height', which is declared later");
    try sema_support.assertMentions(found, "cannot reference the field itself");
    long defaultComplaints = 0;
    for (let diagnostic in found) {
        if (diagnostic.message().indexOf("default value of field") >= 0) {
            defaultComplaints++;
        }
    }
    try testing.assertEqual(defaultComplaints, 3L);
}

test "class fields must be initialized while struct fields may be non-defaultable" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Value \{\n"
        + "    string label;\n"
        + "\}\n"
        + "class Half \{\n"
        + "    string first;\n"
        + "    string second;\n"
        + "    constructor(this.first) \{\n"
        + "    \}\n"
        + "\}\n"
        + "class Assigned \{\n"
        + "    string first;\n"
        + "    constructor() \{\n"
        + "        this.first = \"ok\";\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    // A class that declares a constructor is checked by the definite-assignment pass over each
    // constructor body, so the unassigned field surfaces among the body diagnostics.
    try sema_support.assertMentions(analysis.bodyDiagnostics(),
        "Field 'second' of class 'Half' is not assigned on every path through this constructor");
    for (let diagnostic in analysis.checkDiagnostics()) {
        if (diagnostic.message().indexOf("struct 'Value'") >= 0) {
            try testing.fail("a struct's non-defaultable field must not be reported: "
                + diagnostic.message());
        }
    }
    for (let diagnostic in analysis.bodyDiagnostics()) {
        if (diagnostic.message().indexOf("'first'") >= 0) {
            try testing.fail("initialized fields should not be reported: "
                + diagnostic.message());
        }
    }
}

test "a 'const' field takes exactly one write on every constructor path" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Twice \{\n"
        + "    const int value;\n"
        + "    constructor() \{\n"
        + "        this.value = 1;\n"
        + "        this.value = 2;\n"
        + "    \}\n"
        + "\}\n"
        + "class MaybeTwice \{\n"
        + "    const int maybe;\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.maybe = 1;\n"
        + "        \}\n"
        + "        this.maybe = 2;\n"
        + "    \}\n"
        + "\}\n"
        + "class Looped \{\n"
        + "    const int looped;\n"
        + "    constructor() \{\n"
        + "        for (int i = 0; i < 3; i++) \{\n"
        + "            this.looped = i;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "class Sometimes \{\n"
        + "    const int sometimes;\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.sometimes = 1;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n"
        + "class Balanced \{\n"
        + "    const int chosen;\n"
        + "    constructor(bool flag) \{\n"
        + "        if (flag) \{\n"
        + "            this.chosen = 1;\n"
        + "        \} else \{\n"
        + "            this.chosen = 2;\n"
        + "        \}\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertMentions(found,
        "Field 'value' is 'const' and may already be assigned when this line runs; a 'const' "
            + "field is assigned exactly once. Remove one of the assignments.");
    try sema_support.assertMentions(found,
        "Field 'maybe' is 'const' and may already be assigned when this line runs");
    try sema_support.assertMentions(found,
        "Field 'looped' is 'const', so it cannot be assigned inside a loop: the loop can "
            + "run more than once, but a 'const' field is assigned exactly once. Assign it "
            + "once, outside the loop.");
    try sema_support.assertMentions(found,
        "Field 'sometimes' of class 'Sometimes' is not assigned on every path through this "
            + "constructor. A 'const' field without a default value must be assigned exactly "
            + "once before the constructor returns; assign it on every path, for example "
            + "'this.sometimes = ...;'.");
    for (let diagnostic in found) {
        if (diagnostic.message().indexOf("'chosen'") >= 0) {
            try testing.fail("assigning a const field once per branch is legal: "
                + diagnostic.message());
        }
    }
}

test "a 'const' field is writable only by its own type's constructors, through 'this'" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Box \{\n"
        + "    const int value;\n"
        + "    const int counter = 0;\n"
        + "    constructor(this.value);\n"
        + "    constructor(Box other) \{\n"
        + "        this.value = 1;\n"
        + "        other.value = 2;\n"
        + "    \}\n"
        + "    poke() \{\n"
        + "        this.value = 9;\n"
        + "        this.counter++;\n"
        + "        this.counter += 4;\n"
        + "    \}\n"
        + "\}\n"
        + "class Root \{\n"
        + "    const int seed;\n"
        + "    constructor(this.seed);\n"
        + "\}\n"
        + "class Stem extends Root \{\n"
        + "    constructor() \{\n"
        + "        super(1);\n"
        + "        this.seed = 2;\n"
        + "    \}\n"
        + "    constructor(this.seed, bool ignored) \{\n"
        + "        super(3);\n"
        + "    \}\n"
        + "\}\n"
        + "struct Pair \{\n"
        + "    const int first;\n"
        + "\}\n"
        + "rewrite(Pair pair) \{\n"
        + "    pair.first = 5;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertMentions(found,
        "Cannot assign a new value to field 'value' because it is declared 'const'; a 'const' "
            + "field is assigned exactly once, inside a constructor of 'Box' as "
            + "'this.value = ...', and never changes afterwards. Remove 'const' from the field "
            + "if it needs to change.");
    try sema_support.assertMentions(found,
        "The '++' operator cannot change field 'counter' because it is declared 'const'");
    try sema_support.assertMentions(found,
        "Cannot use '+=' on field 'counter' because 'counter' is declared 'const'");
    try sema_support.assertMentions(found,
        "Field 'seed' is 'const' and declared in base class 'Root', so only a constructor of "
            + "'Root' can assign it; a subclass constructor cannot. Pass the value along in the "
            + "'super(...)' call instead.");
    try sema_support.assertMentions(found,
        "Parameter 'this.seed' assigns field 'seed', but 'seed' is 'const' and declared in "
            + "base class 'Root', so only a constructor of 'Root' can assign it. Take an "
            + "ordinary parameter and pass it along in the 'super(...)' call instead.");
    try sema_support.assertMentions(found,
        "Cannot assign a new value to field 'first' because it is declared 'const'; a 'const' "
            + "field is assigned exactly once, inside a constructor of 'Pair' as "
            + "'this.first = ...' or by a struct literal like '\{first: ...\}', and never "
            + "changes afterwards. Remove 'const' from the field if it needs to change.");
}

test "a catch clause assigns a 'const' field only when the body could not have" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "shaky() -> int throws \{\n"
        + "    throw new Error(\"boom\");\n"
        + "\}\n"
        + "boom() throws \{\n"
        + "    throw new Error(\"boom\");\n"
        + "\}\n"
        + "class Fallback \{\n"
        + "    const int parsed;\n"
        + "    constructor() \{\n"
        + "        this.parsed = try shaky();\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        this.parsed = -1;\n"
        + "    \}\n"
        + "\}\n"
        + "class TooLate \{\n"
        + "    const int early;\n"
        + "    constructor() \{\n"
        + "        this.early = 1;\n"
        + "        try boom();\n"
        + "    \}\n"
        + "    catch (Error e) \{\n"
        + "        this.early = -1;\n"
        + "    \}\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.bodyDiagnostics();
    try sema_support.assertMentions(found,
        "Field 'early' is 'const' and may already be assigned when this line runs");
    for (let diagnostic in found) {
        if (diagnostic.message().indexOf("'parsed'") >= 0) {
            try testing.fail("the body could not have assigned 'parsed' before throwing: "
                + diagnostic.message());
        }
    }
}

test "struct value cycles are reported with their path" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "struct Outer \{\n"
        + "    Inner nested;\n"
        + "\}\n"
        + "struct Inner \{\n"
        + "    Outer? back;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "Struct 'Outer' contains itself by value");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "field 'back' of 'Inner' has type 'Outer?'");
}

test "declared throws types must be distinct exception classes" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class MyError extends Error \{\n"
        + "    constructor(this.message);\n"
        + "\}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Runner \{\n"
        + "    constructor();\n"
        + "    bad() throws Speaker \{ \}\n"
        + "    overlapping() throws MyError, Error \{ \}\n"
        + "\}\n"
        + "loose() throws MyError \{ \}\n"
        + "abstract class Vague \{\n"
        + "    abstract go() throws;\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "must be 'Error' or a subclass; 'Speaker' is not");
    try sema_support.assertMentions(analysis.checkDiagnostics(),
        "overlaps with another type in the list");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "An abstract method marked 'throws' must list its exception types");
    // A list on the free function 'loose' is accepted: it bounds the body, not only overrides.
    try sema_support.assertNoDiagnostics(analysis.signatureDiagnostics());
}

test "test declarations are validated in place" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "test \"misplaced\" \{ \}\n");
    loader.add("/proj/src/checks_test.ens",
        "import app;\n"
        + "test \"\" \{ \}\n"
        + "test \"line\\nbreak\" \{ \}\n"
        + "test \"value \{1\} here\" \{ \}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["checks_test.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found,
        "Test declarations are only allowed in files ending '_test.ens'");
    try sema_support.assertMentions(found, "A test description cannot be empty");
    try sema_support.assertMentions(found, "A test description cannot contain a line break");
    try sema_support.assertMentions(found,
        "A test description must be a plain string without interpolation");
}

test "type parameter bounds reject duplicates, two classes, and non-class bounds" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "class Animal \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Robot \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Chorus<T: Speaker + Speaker> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Pen<T: Animal + Robot> \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "class Sized<T: int> \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found, "Duplicate bound 'Speaker' on type parameter 'T'");
    try sema_support.assertMentions(found,
        "Type parameter 'T' already has the class bound 'Animal'");
    try sema_support.assertMentions(found,
        "A type-parameter bound must be a non-generic class or an interface");
}

test "enums and struct clauses are validated" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "enum Color \{ Red, Red \}\n"
        + "enum Hollow \{ \}\n"
        + "interface Speaker \{\n"
        + "    speak() -> string;\n"
        + "\}\n"
        + "struct Point extends Speaker \{\n"
        + "    int x;\n"
        + "\}\n"
        + "struct Dot implements Speaker \{\n"
        + "    int x;\n"
        + "\}\n"
        + "class Twice \{\n"
        + "    int a;\n"
        + "    int a;\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let found = analysis.signatureDiagnostics();
    try sema_support.assertMentions(found, "already has a member named 'Red'");
    try sema_support.assertMentions(found, "Enum 'Hollow' must have at least one member");
    try sema_support.assertMentions(found, "structs do not support inheritance");
    try sema_support.assertMentions(found, "Structs cannot implement interfaces");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Field 'a' is already declared in 'Twice'");
}

test "interface extension rejects bad targets, cycles, redeclarations, and leaks" {
    let loader = new FakeFileLoader();
    loader.add("/proj/src/app.ens",
        "class Widget \{\n"
        + "    constructor();\n"
        + "\}\n"
        + "interface Marker extends Widget \{\n"
        + "\}\n"
        + "interface Loop extends Loop \{\n"
        + "\}\n"
        + "interface Alpha extends Beta \{\n"
        + "\}\n"
        + "interface Beta extends Alpha \{\n"
        + "\}\n"
        + "interface Source \{\n"
        + "    get() -> int;\n"
        + "\}\n"
        + "interface Buffered extends Source \{\n"
        + "    get() -> int;\n"
        + "\}\n"
        + "interface Hidden \{\n"
        + "\}\n"
        + "public interface Wide extends Hidden \{\n"
        + "\}\n"
        + "class Busted implements Buffered \{\n"
        + "    constructor();\n"
        + "\}\n");
    let analysis = sema_support.analyzeAll(loader, "/proj/src", ["app.ens"]);
    let signature = analysis.signatureDiagnostics();
    try sema_support.assertMentions(signature, "Interface 'Marker' cannot extend class "
        + "'Widget': interfaces extend interfaces, and classes implement them. Write "
        + "'class Widget implements Marker' to have 'Widget' implement it.");
    try sema_support.assertMentions(signature, "Interface 'Loop' cannot extend itself.");
    try sema_support.assertMentions(signature, "Interface 'Alpha' eventually extends itself "
        + "through the interfaces it extends. An interface cannot extend itself, directly or "
        + "indirectly.");
    let checks = analysis.checkDiagnostics();
    try sema_support.assertMentions(checks, "Interface 'Buffered' already requires "
        + "'get() -> int' through 'Source', which it extends; an extending interface inherits "
        + "every requirement. Remove the redeclaration.");
    try sema_support.assertMentions(checks, "Interface 'Wide' is visible as 'public' but the "
        + "interface it extends, 'Hidden', is private to module 'app'. Mark 'Hidden' as "
        + "'public', or lower the declaration.");
    try sema_support.assertMentions(analysis.layoutDiagnostics(),
        "Class 'Busted' implements 'Buffered' but does not provide 'get() -> int', required "
        + "by 'Source', which 'Buffered' extends. Declare the method, or inherit it from a "
        + "base class.");
}
