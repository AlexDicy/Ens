// One program in, one executable out: build the module graph, run the sema pipeline, emit one
// object per module through the self-hosted code generator, and link them into an executable. Any
// diagnostic stops the build before objects are written; problems go to standard error, one per
// line, in (file, offset) order.
import @std.system;
import @std.path;
import List from @std.collections.list;
import @ens.frontend.syntax.generated.factory;
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FileDiagnostic from @ens.sema.support.diagnostics;
import FileLoader from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import GraphResult from @ens.sema.program.graph;
import Module from @ens.sema.program.graph;
import @ens.sema.program.graph;
import ProgramAnalysis from @ens.sema.pipeline;
import @ens.sema.pipeline;
import @ens.codegen.driver;
import @ens.llvm.target;
import LinkRequest from @ens.link.request;
import @ens.link.linker;
import Options from arguments;
import arguments;
import SourceCatalog from reporting;
import reporting;
import natives;
import stdlib;

// Runs one build and returns the process exit code: 0 built, 1 the program or its build had
// errors, 2 the invocation itself was unusable.
public run(Options options) -> int {
    FileLoader loader = new SystemFileLoader();

    string sourceRoot;
    string entryFile;
    bool fileProgram = options.source.endsWith(".ens");
    if (fileProgram) {
        if (!loader.exists(options.source)) {
            system.writeError("ensc: error: {options.source} does not exist");
            return 2;
        }
        sourceRoot = path.parentFolder(options.source);
        entryFile = path.fileName(options.source);
    } else {
        string packaged = path.join(options.source, "src/main.ens");
        string plain = path.join(options.source, "main.ens");
        if (loader.exists(packaged)) {
            sourceRoot = path.join(options.source, "src");
        } else if (loader.exists(plain)) {
            sourceRoot = options.source;
        } else {
            system.writeError("ensc: error: {options.source} holds neither src/main.ens nor main.ens, so "
                + "there is no program to compile");
            return 2;
        }
        entryFile = "main.ens";
    }

    string stdlibRoot = options.stdlibRoot;
    if (stdlibRoot.length == 0) {
        stdlibRoot = stdlib.findStdlibRoot(loader,
            system.getEnvironmentVariable("ENS_STDLIB"), sourceRoot);
    }
    if (stdlibRoot.length == 0) {
        system.writeError("ensc: error: cannot find the standard library; set ENS_STDLIB to the folder "
            + "containing 'std/' (normally <repo>/libs) or pass --stdlib <folder>");
        return 2;
    }

    GraphResult graphResult;
    if (fileProgram) {
        graphResult = graph.buildFileProgram(loader, sourceRoot, "", stdlibRoot, entryFile);
    } else {
        graphResult = graph.buildGraph(loader, sourceRoot, "", stdlibRoot, [entryFile]);
    }

    let catalog = new SourceCatalog(loader);
    catalog.addGraph(graphResult);
    let upstream = upstreamDiagnostics(graphResult);
    if (upstream.length() > 0) {
        reportAll(upstream, catalog);
        return 1;
    }

    let analysis = pipeline.analyzeProgram(graphResult);
    let problems = analysisDiagnostics(analysis);
    if (problems.length() > 0) {
        reportAll(problems, catalog);
        return 1;
    }

    if (!definesMain(graphResult)) {
        system.writeError("ensc: error: {options.source} does not define main() in its main module");
        return 1;
    }

    string objectsFolder = options.objectsFolder;
    if (objectsFolder.length == 0) {
        objectsFolder = path.parentFolder(options.output);
    }
    if (objectsFolder.length == 0) {
        objectsFolder = ".";
    }
    if (!loader.exists(objectsFolder)) {
        system.writeError("ensc: error: the objects folder {objectsFolder} does not exist");
        return 2;
    }

    string prefix = arguments.outputStem(options.output) + ".";
    let emitted = driver.emitProgram(analysis, objectsFolder, prefix);
    if (!emitted.succeeded()) {
        let failures = new List<FileDiagnostic>();
        for (let diagnostic in emitted.diagnostics()) {
            failures.push(diagnostic);
        }
        reportAll(failures, catalog);
        return 1;
    }
    if (emitted.objects().length() == 0) {
        system.writeError("ensc: error: the program produced no object files");
        return 1;
    }

    string triple = target.hostTargetTriple();
    let plan = natives.librariesFor(graphResult.natives(), natives.platformOfTriple(triple));
    if (plan.problem.length > 0) {
        system.writeError("ensc: error: " + plan.problem);
        return 1;
    }

    string[] libraryFiles = [];
    let linked = linker.link(new LinkRequest(emitted.objects().toArray(), plan.libraries,
        libraryFiles, options.output, triple));
    if (!linked.linked()) {
        reportLinkFailure(options.output, linked.output());
        return 1;
    }
    if (linked.output().length > 0) {
        system.writeError(linked.output());
    }
    return 0;
}

// A failed link, in the linker's own words: they are the only description of what went wrong worth
// printing, and swallowing them would leave nothing to act on.
reportLinkFailure(string output, string reported) {
    if (reported.length == 0) {
        system.writeError("ensc: error: linking {output} failed and the linker reported no reason");
        return;
    }
    system.writeError("ensc: error: linking {output} failed; the linker reported:");
    system.writeError(reported);
}

reportAll(List<FileDiagnostic> diagnostics, SourceCatalog catalog) {
    for (let line in reporting.formatAll(diagnostics, catalog)) {
        system.writeError(line);
    }
}

// Graph and parse diagnostics together, since both mean the program never reached analysis.
upstreamDiagnostics(GraphResult graphResult) -> List<FileDiagnostic> {
    let collected = new List<FileDiagnostic>();
    for (let diagnostic in graphResult.diagnostics()) {
        collected.push(diagnostic);
    }
    for (let loaded in graphResult.modules()) {
        for (let diagnostic in loaded.parseResult().diagnostics()) {
            collected.push(new FileDiagnostic(loaded.filePath(), diagnostic.message(),
                diagnostic.span()));
        }
    }
    return collected;
}

// Every stage's diagnostics in stage order; formatAll orders the merged list by position.
analysisDiagnostics(ProgramAnalysis analysis) -> List<FileDiagnostic> {
    let collected = new List<FileDiagnostic>();
    appendAll(collected, analysis.declareDiagnostics());
    appendAll(collected, analysis.linkDiagnostics());
    appendAll(collected, analysis.signatureDiagnostics());
    appendAll(collected, analysis.layoutDiagnostics());
    appendAll(collected, analysis.checkDiagnostics());
    appendAll(collected, analysis.bodyDiagnostics());
    appendAll(collected, analysis.exceptionDiagnostics());
    return collected;
}

appendAll(List<FileDiagnostic> sink, FileDiagnostic[] diagnostics) {
    for (let diagnostic in diagnostics) {
        sink.push(diagnostic);
    }
}

// Whether the program's main module declares a function named 'main'; its shape is already
// sema's business by the time this is asked.
definesMain(GraphResult graphResult) -> bool {
    let entry = graphResult.moduleWithPath("main");
    if (entry == null) {
        return false;
    }
    let root = factory.createRoot(entry.parseResult().root());
    if (!(root is SourceFileNode)) {
        return false;
    }
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        if (item is FunctionDeclarationNode) {
            let name = item.name();
            if (name != null && name.text() == "main") {
                return true;
            }
        }
    }
    return false;
}
