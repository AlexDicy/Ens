// Standard library discovery, mirroring the reference driver: the ENS_STDLIB environment
// variable when it names an existing folder, else the nearest ancestor of the program's source
// folder holding libs/std/ens.package. The reference driver starts its walk at the working
// directory; this driver starts at the source folder, which is where a build's library lives.
import FileLoader from @ens.sema.support.loader;
import @std.path;

// The folder containing 'std/', or "" when discovery finds none.
public findStdlibRoot(FileLoader loader, string? environment, string startFolder) -> string {
    if (environment != null && environment.length > 0 && loader.exists(environment)) {
        return environment;
    }
    string folder = path.normalize(startFolder);
    while (folder.length > 0) {
        string libs = path.join(folder, "libs");
        if (loader.exists(path.join(libs, "std/ens.package"))) {
            return libs;
        }
        string parent = path.parentFolder(folder);
        if (parent.length == 0 || parent == folder) {
            return "";
        }
        folder = parent;
    }
    return "";
}
