// What every compiling command settles before it does any work: the invocation it runs on, what it
// was pointed at, and where the standard library is. The order matters and is the same for all of
// them, which is why it is written once.
//
// Whether this toolchain does the work at all is decided here too, before anything is looked for on
// this machine, because a toolchain that takes the work over brings its own standard library with it.
// A command that is already answered - by another toolchain, or by a mistake in what was written -
// carries the exit code to end with instead of the values to work from.
import @std.system;
import FileLoader from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import Invocation from @ens.cli.invocation;
import BuildOptions from @ens.build.options;
import BuildTarget from @ens.build.target;
import @ens.build.target;
import Environment from @ens.build.environment;
import Reporter from @ens.build.report;
import ToolchainRequest from @ens.build.toolchain;
import @ens.build.toolchain;
import @ens.build.stdlib;
import options;

// A compiling command ready to run, or the code it should end with.
export final class Prepared {
    FileLoader fileLoader;
    BuildOptions? settled;
    BuildTarget? pointedAt;
    Reporter? announcer;
    int code;

    protected constructor(this.fileLoader, this.settled, this.pointedAt, this.announcer, this.code);

    export loader() -> FileLoader {
        return this.fileLoader;
    }

    // The invocation to work from, or null when the command is already answered.
    export options() -> BuildOptions? {
        return this.settled;
    }

    export target() -> BuildTarget? {
        return this.pointedAt;
    }

    export reporter() -> Reporter? {
        return this.announcer;
    }

    // The code an already answered command ends with.
    export exitCode() -> int {
        return this.code;
    }
}

// Settles everything a compiling command needs. `forwarded` is the command line as it arrived, after
// this program's own name, which the toolchain a command is handed to reads unchanged.
export compiling(Invocation invocation, Environment environment, string[] forwarded) -> Prepared {
    FileLoader loader = new SystemFileLoader();
    string workingFolder = system.currentDirectory();

    // The options are settled before the target, so a command line nobody could act on is reported
    // as the usage problem it is rather than as a missing package.
    let settled = options.resolve(invocation, workingFolder);
    let given = settled.options();
    if (given == null) {
        return refused(loader, settled.failure());
    }
    let reporter = new Reporter(given);

    let resolution = target.resolve(loader, workingFolder, firstPositional(invocation));
    let resolved = resolution.target();
    if (resolved == null) {
        return refused(loader, resolution.failure());
    }

    let handed = toolchain.hand(environment, toolchainRequest(invocation, environment),
        resolved.governingVersion(), forwarded, reporter);
    if (handed.finished()) {
        return answered(loader, handed.exitCode());
    }

    string stdlibRoot = given.stdlibRoot();
    if (stdlibRoot.length == 0) {
        stdlibRoot = stdlib.findRoot(loader, environment.value("ENS_STDLIB"), resolved.root());
    }
    if (stdlibRoot.length == 0) {
        return refused(loader, stdlib.missingMessage());
    }
    return new Prepared(loader, given.withStdlibRoot(stdlibRoot), resolved, reporter, 0);
}

// The path the command line named, or empty text when it named none.
firstPositional(Invocation invocation) -> string {
    string[] positionals = invocation.positionals();
    if (positionals.length == 0) {
        return "";
    }
    return positionals[0];
}

// What the command line and the environment said about which toolchain does the work. The option
// wins over the variable, because it was written for this one run.
toolchainRequest(Invocation invocation, Environment environment) -> ToolchainRequest {
    return new ToolchainRequest(invocation.value("toolchain") ?? "",
        environment.value("ENS_TOOLCHAIN"));
}

refused(FileLoader loader, string problem) -> Prepared {
    system.writeError("ens: " + problem);
    return answered(loader, 2);
}

answered(FileLoader loader, int code) -> Prepared {
    return new Prepared(loader, null, null, null, code);
}
