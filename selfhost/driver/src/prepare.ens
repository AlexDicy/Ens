// What every compiling command settles before it does any work, in the one order they all share.
// Whether this toolchain does the work is settled here too, before anything is looked for on this
// machine, because a toolchain that takes the work over brings its own standard library with it.
import FileLoader from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import Invocation from @ens.cli.invocation;
import Environment from @std.environment;
import Path from @std.fs;
import BuildOptions from @ens.build.options;
import BuildTarget from @ens.build.target;
import @ens.build.target;
import Packaging from @ens.build.packaging;
import Reporter from @ens.build.report;
import Declaration from @ens.build.toolchain;
import ToolchainRequest from @ens.build.toolchain;
import @ens.build.toolchain;
import LibraryOrigin from @ens.build.stdlib;
import @ens.build.stdlib;
import ContentStore from @ens.packages.store;
import @ens.packages.store;
import @ens.bundled.library;
import ResolutionRequest from @ens.packages.resolution;
import @ens.packages.resolution;
import options;

// A compiling command ready to run, or the code it should end with.
export final class Prepared {
    FileLoader fileLoader;
    BuildOptions? settled;
    BuildTarget? pointedAt;
    Packaging? reached;
    Reporter? announcer;
    int code;

    protected constructor(this.fileLoader, this.settled, this.pointedAt, this.reached,
                this.announcer, this.code);

    export loader() -> FileLoader {
        return this.fileLoader;
    }

    // How the command reaches what it depends on, or null when the command is already complete.
    export packaging() -> Packaging? {
        return this.reached;
    }

    // The invocation to work from, or null when the command is already complete.
    export options() -> BuildOptions? {
        return this.settled;
    }

    export target() -> BuildTarget? {
        return this.pointedAt;
    }

    export reporter() -> Reporter? {
        return this.announcer;
    }

    // The code an already complete command ends with.
    export exitCode() -> int {
        return this.code;
    }
}

// Settles everything a compiling command needs. `forwarded` is the command line as it was given, after
// this program's own name, which the toolchain a command is handed to reads unchanged.
export compiling(Invocation invocation, Environment environment, Path workingFolder,
                 string[] forwarded) -> Prepared {
    FileLoader loader = new SystemFileLoader();

    // The options are settled before the target, so a command line nobody could act on is reported
    // as the usage problem it is rather than as a missing package.
    let settled = options.resolve(invocation, workingFolder);
    let given = settled.options();
    if (given == null) {
        return refused(loader, settled.failure());
    }
    let reporter = new Reporter(given.verbosity());

    let targeting = target.resolve(loader, workingFolder, firstPositional(invocation));
    let resolved = targeting.target();
    if (resolved == null) {
        if (targeting.diagnostics().length > 0) {
            reporter.diagnostics(targeting.diagnostics());
            reporter.problem(targeting.failure());
            return answered(loader, 1);
        }
        return refused(loader, targeting.failure());
    }

    let handed = toolchain.hand(environment, toolchainRequest(invocation, environment),
        new Declaration(resolved.governingVersion(), resolved.artifactRoot()), forwarded,
        given.offline(), reporter);
    if (handed.finished()) {
        return answered(loader, handed.exitCode());
    }

    // Every package the build depends on is settled before anything is read, because what a
    // git-sourced dependency resolves to decides which files the module graph even has. It happens
    // after the toolchain is settled, so a run another toolchain takes over fetches nothing here and
    // the toolchain that does the work is the one that resolves. The manifest is the one governing
    // the target, so a single file of a package reaches the package's dependencies.
    let packages = resolution.resolve(loader, environment,
        new ResolutionRequest(resolved.artifactRoot(), given.offline(), given.locked()), reporter);
    for (let note in packages.notes()) {
        reporter.note(note);
    }
    if (!packages.succeeded()) {
        reporter.sentences(packages.failures());
        return answered(loader, 1);
    }
    let reached = new Packaging(packages.sources(), store.locate(environment), given.offline(),
        reporter);

    Path? stdlibRoot = given.stdlibRoot();
    LibraryOrigin origin = LibraryOrigin.Option;
    let targeted = stdlib.libraryRootOf(loader, resolved);
    if (targeted != null) {
        if (stdlibRoot != null && !stdlibRoot.isEmpty()
                && loader.folderKey(stdlibRoot) != loader.folderKey(targeted)) {
            return refused(loader,
                stdlib.otherLibraryMessage(resolved.root(), stdlibRoot, targeted));
        }
        stdlibRoot = targeted;
        origin = LibraryOrigin.Target;
    }
    if (stdlibRoot == null || stdlibRoot.isEmpty()) {
        stdlibRoot = stdlib.variableRoot(environment.get("ENS_STDLIB"));
        origin = LibraryOrigin.Variable;
    }
    if (stdlibRoot == null || stdlibRoot.isEmpty()) {
        ContentStore? cache = store.locate(environment);
        if (cache == null) {
            return refused(loader, stdlib.noCacheMessage(environment));
        }
        let bundled = library.standardLibrary(cache);
        if (bundled.leftBehind().length > 0) {
            reporter.note(bundled.leftBehind());
        }
        if (bundled.failure().length > 0) {
            return refused(loader, stdlib.notWrittenMessage(bundled.failure()));
        }
        stdlibRoot = bundled.path();
        origin = LibraryOrigin.Bundled;
    }
    string unusable = stdlib.libraryProblem(loader, stdlibRoot, origin);
    if (unusable.length > 0) {
        return refused(loader, unusable);
    }
    return new Prepared(loader, given.withStdlibRoot(stdlibRoot)
        .withArtifactRoot(resolved.artifactRoot()), resolved, reached, reporter, 0);
}

// The path the command line named, or empty text when it named none.
firstPositional(Invocation invocation) -> string {
    string[] positionals = invocation.positionals();
    if (positionals.length == 0) {
        return "";
    }
    return positionals[0];
}

// What the command line and the environment named as the toolchain that does the work. The option
// wins over the variable, because it was written for this one run.
export toolchainRequest(Invocation invocation, Environment environment) -> ToolchainRequest {
    return new ToolchainRequest(invocation.value("toolchain") ?? "",
        environment.get("ENS_TOOLCHAIN") ?? "");
}

refused(FileLoader loader, string problem) -> Prepared {
    eprint("ens: " + problem);
    return answered(loader, 2);
}

answered(FileLoader loader, int code) -> Prepared {
    return new Prepared(loader, null, null, null, null, code);
}
