// From the graph's native declarations to the libraries one platform's link step passes on,
// the mapping the reference driver applies to a normal build: a system library is linked by
// platform defaults, a declaration without a binding block links under its own name, and a
// binding block contributes its base names for the platform being built.
import NativeInfo from @ens.sema.program.workspace;
import List from @std.collections.list;

// The libraries to link, or the problem that stopped the mapping.
public class LibraryPlan {
    public string[] libraries;
    public string problem;

    public constructor(this.libraries, this.problem);
}

// The platform of a target triple, worded the way manifest bindings name platforms.
public platformOfTriple(string triple) -> string {
    if (triple.contains("windows") || triple.contains("win32") || triple.contains("msvc")) {
        return "windows";
    }
    if (triple.contains("darwin") || triple.contains("apple")) {
        return "macos";
    }
    return "linux";
}

public librariesFor(NativeInfo[] natives, string platform) -> LibraryPlan {
    let libraries = new List<string>();
    for (let native in natives) {
        if (native.isSystem()) {
            continue;
        }
        if (!native.hasBindingBlock()) {
            append(libraries, native.name());
            continue;
        }
        for (let binding in native.bindings()) {
            if (binding.platform() != platform) {
                continue;
            }
            if (binding.isArtifact()) {
                return new LibraryPlan([], "native library '{native.name()}' binds a fetched "
                    + "artifact on {platform}; this driver does not fetch artifacts, so build "
                    + "with the reference driver");
            }
            for (let baseName in binding.baseNames()) {
                append(libraries, baseName);
            }
        }
    }
    return new LibraryPlan(libraries.toArray(), "");
}

append(List<string> libraries, string name) {
    for (long i = 0; i < libraries.length(); i++) {
        if (libraries.get(i) == name) {
            return;
        }
    }
    libraries.push(name);
}
