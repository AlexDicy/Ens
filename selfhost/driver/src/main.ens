// The `ens` command: read the command line, settle the invocation, and run the one thing it names.
// The working folder and the environment are read once here, and nothing changes either. Exit
// codes are 0 it worked, 1 the work failed, 2 the command line requested something it cannot have.
import Invocation from @ens.cli.invocation;
import @ens.cli.help;
import @ens.cli.parse;
import Environment from @std.environment;
import Path from @std.fs;
import @std.environment;
import SystemFileLoader from @ens.sema.support.loader;
import Reporter from @ens.build.report;
import Verbosity from @ens.build.options;
import @ens.build.build;
import @ens.build.check;
import @ens.build.overriding;
import @ens.build.run;
import @ens.build.test;
import Version from @ens.language.version;
import ToolchainRequest from @ens.build.toolchain;
import @ens.build.toolchain;
import @ens.build.toolchaincommands;
import @ens.build.platform;
import @ens.link.linker;
import commands;
import cst;
import options;
import prepare;

main() -> int {
    let application = commands.application();
    string[] forwarded = environment.arguments();
    let invocation = parse.commandLine(application, forwarded);
    let variables = Environment.current();

    // A newer toolchain may know a command or an option this one does not.
    let problem = invocation.problem();
    if (problem != null) {
        if (!toolchain.namesToolchain(forwarded)) {
            let variable = new ToolchainRequest("", variables.get("ENS_TOOLCHAIN") ?? "");
            let handed = toolchain.hand(variables, variable, null, forwarded, plainly());
            if (handed.finished()) {
                return handed.exitCode();
            }
        }
        eprint("ens: " + problem);
        return 2;
    }
    // A compiling command chooses its toolchain once it has read its build root. A removal always
    // stays with the toolchain that was started.
    if (!compiles(invocation) && invocation.command() != "toolchain remove") {
        let handed = toolchain.hand(variables, prepare.toolchainRequest(invocation, variables),
            null, forwarded, plainly());
        if (handed.finished()) {
            return handed.exitCode();
        }
    }
    if (invocation.helpRequested()) {
        print(help.text(application, invocation.helpTarget()));
        return 0;
    }
    if (invocation.versionRequested()) {
        print(versionLine());
        return 0;
    }
    Path workingFolder = environment.currentDirectory();
    return linker.afterLastLink(() -> dispatch(invocation, variables, workingFolder, forwarded),
        () -> {
            linker.stopLinkerThreads();
        });
}

// `forwarded` is the command line as it was given, after this program's own name, which a command
// delegating the work to another toolchain passes on unchanged.
dispatch(Invocation invocation, Environment environment, Path workingFolder,
         string[] forwarded) -> int {
    switch (invocation.command()) {
        "version" -> {
            print(versionLine());
            return 0;
        },
        "cst-dump" -> {
            return cst.dumpFile(invocation.positionals()[0]);
        },
        "cst-analyze" -> {
            return cst.analyzeFile(invocation.positionals()[0]);
        },
        "build" -> {
            return compile(invocation, environment, workingFolder, forwarded, true);
        },
        "check" -> {
            return compile(invocation, environment, workingFolder, forwarded, false);
        },
        "run" -> {
            return runProgram(invocation, environment, workingFolder, forwarded);
        },
        "test" -> {
            return runTests(invocation, environment, workingFolder, forwarded);
        },
        "override add" -> {
            string[] given = invocation.positionals();
            return overriding.add(new SystemFileLoader(), workingFolder, given[0], given[1],
                plainly());
        },
        "override remove" -> {
            return overriding.remove(new SystemFileLoader(), workingFolder,
                invocation.positionals()[0], plainly());
        },
        "override list" -> {
            return overriding.list(new SystemFileLoader(), workingFolder, plainly());
        },
        "toolchain list" -> {
            return toolchaincommands.list(environment, plainly());
        },
        "toolchain remove" -> {
            return toolchaincommands.remove(environment, invocation.positionals()[0], plainly());
        },
        default -> {
            eprint("Internal: the command '{invocation.command()}' is declared but "
                + "nothing runs it");
            return 2;
        },
    }
}

compile(Invocation invocation, Environment environment, Path workingFolder, string[] forwarded,
        bool emit) -> int {
    let ready = prepare.compiling(invocation, environment, workingFolder, forwarded);
    let given = ready.options();
    let resolved = ready.target();
    let packaging = ready.packaging();
    let reporter = ready.reporter();
    if (given == null || resolved == null || packaging == null || reporter == null) {
        return ready.exitCode();
    }
    if (emit) {
        return build.run(ready.loader(), given, packaging, resolved, reporter);
    }
    return check.run(ready.loader(), given, packaging, resolved, reporter);
}

runProgram(Invocation invocation, Environment environment, Path workingFolder,
         string[] forwarded) -> int {
    let ready = prepare.compiling(invocation, environment, workingFolder, forwarded);
    let given = ready.options();
    let resolved = ready.target();
    let packaging = ready.packaging();
    let reporter = ready.reporter();
    if (given == null || resolved == null || packaging == null || reporter == null) {
        return ready.exitCode();
    }
    return run.run(ready.loader(), given, packaging, environment, resolved, invocation.rest(),
        reporter);
}

runTests(Invocation invocation, Environment environment, Path workingFolder,
         string[] forwarded) -> int {
    let ready = prepare.compiling(invocation, environment, workingFolder, forwarded);
    let given = ready.options();
    let resolved = ready.target();
    let packaging = ready.packaging();
    let reporter = ready.reporter();
    if (given == null || resolved == null || packaging == null || reporter == null) {
        return ready.exitCode();
    }
    return test.run(ready.loader(), given, packaging, environment, resolved,
        options.absoluteOrEmpty(invocation.value("tests"), given.workingFolder()),
        invocation.value("filter") ?? "", reporter);
}

compiles(Invocation invocation) -> bool {
    if (invocation.helpRequested() || invocation.versionRequested()) {
        return false;
    }
    switch (invocation.command()) {
        "build", "check", "run", "test" -> {
            return true;
        },
        default -> {
            return false;
        },
    }
}

// A reporter for a command with no options for how much to report. It prints everything it has.
plainly() -> Reporter {
    return new Reporter(Verbosity.Normal);
}

// What 'ens version' prints: the release this is, and the system and processor it runs on.
versionLine() -> string {
    return "ens " + Version.release + " " + platform.hostName();
}
