// The `ens` command: read the command line, settle the invocation, and run the one thing it names.
//
// The working folder and the environment are read once, here, into the values every part of a build
// then reads from; nothing anywhere changes either of them. Exit codes are the same for every
// command: 0 it worked, 1 the work failed, 2 the command line asked for something it cannot have.
import @std.system;
import FileLoader from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import Invocation from @ens.cli.invocation;
import @ens.cli.help;
import @ens.cli.parse;
import @ens.build.build;
import @ens.build.check;
import @ens.build.stdlib;
import @ens.build.version;
import BuildTarget from @ens.build.target;
import @ens.build.target;
import Environment from @ens.build.environment;
import Reporter from @ens.build.report;
import ToolchainRequest from @ens.build.toolchain;
import @ens.build.toolchain;
import commands;
import cst;
import options;

main() -> int {
    let application = commands.application();
    string[] argv = system.arguments();
    string[] forwarded = argv.slice(1, argv.length);
    let invocation = parse.commandLine(application, forwarded);

    let problem = invocation.problem();
    if (problem != null) {
        system.writeError("ens: " + problem);
        return 2;
    }
    if (invocation.helpRequested()) {
        print(help.text(application, invocation.helpTarget()));
        return 0;
    }
    if (invocation.versionRequested()) {
        print(versionLine());
        return 0;
    }
    let environment = new Environment(system.environment(), system.platform());
    return dispatch(invocation, environment, forwarded);
}

// `forwarded` is the command line as it arrived, after this program's own name, which a command
// handing the work to another toolchain passes on unchanged.
dispatch(Invocation invocation, Environment environment, string[] forwarded) -> int {
    switch (invocation.command()) {
        "version" -> {
            print(versionLine());
            return 0;
        },
        "cst-dump" -> {
            return cst.dumpFile(invocation.positionals()[0]);
        },
        "cst-analyze" -> {
            return cst.analyzeFile(invocation.positionals()[0]);
        },
        "build" -> {
            return compile(invocation, environment, forwarded, true);
        },
        "check" -> {
            return compile(invocation, environment, forwarded, false);
        },
        default -> {
            system.writeError("Internal: the command '{invocation.command()}' is declared but "
                + "nothing runs it");
            return 2;
        },
    }
}

// Runs a build or a check: resolve what was named, settle the options, see whether another toolchain
// should be doing this at all, then hand the work to the build package.
compile(Invocation invocation, Environment environment, string[] forwarded, bool emit) -> int {
    FileLoader loader = new SystemFileLoader();
    string workingFolder = system.currentDirectory();
    string named = "";
    string[] positionals = invocation.positionals();
    if (positionals.length > 0) {
        named = positionals[0];
    }

    // The options are settled before the target, so a command line nobody could act on is reported
    // as the usage problem it is rather than as a missing package.
    let settled = options.resolve(invocation, workingFolder);
    let given = settled.options();
    if (given == null) {
        system.writeError("ens: " + settled.failure());
        return 2;
    }
    let reporter = new Reporter(given);

    let resolution = target.resolve(loader, workingFolder, named);
    let resolved = resolution.target();
    if (resolved == null) {
        system.writeError("ens: " + resolution.failure());
        return 2;
    }

    // Which toolchain does the work is settled before anything is looked for on this machine,
    // because a toolchain that takes the work over brings its own standard library with it.
    let handed = toolchain.hand(environment, toolchainRequest(invocation, environment),
        resolved.governingVersion(), forwarded, reporter);
    if (handed.finished()) {
        return handed.exitCode();
    }

    string stdlibRoot = given.stdlibRoot();
    if (stdlibRoot.length == 0) {
        stdlibRoot = stdlib.findRoot(loader, environment.value("ENS_STDLIB"), resolved.root());
    }
    if (stdlibRoot.length == 0) {
        system.writeError("ens: " + stdlib.missingMessage());
        return 2;
    }

    let built = given.withStdlibRoot(stdlibRoot);
    if (emit) {
        return build.run(loader, built, resolved, reporter);
    }
    return check.run(loader, built, resolved, reporter);
}

// What the command line and the environment said about which toolchain does the work. The option
// wins over the variable, because it was written for this one run.
toolchainRequest(Invocation invocation, Environment environment) -> ToolchainRequest {
    return new ToolchainRequest(invocation.value("toolchain") ?? "",
        environment.value("ENS_TOOLCHAIN"));
}

versionLine() -> string {
    return "ens " + version.toolchainVersion();
}
