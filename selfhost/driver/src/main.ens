// The self-hosted driver's entry point: parse the command line, then run the one build it
// names. The executable is called ensc to stand apart from the reference driver's ens.
import @std.system;
import arguments;
import compile;

main() -> int {
    let parsed = arguments.parse(system.arguments());
    let options = parsed.options;
    if (options == null) {
        print("ensc: error: " + parsed.problem);
        print(arguments.usage());
        return 2;
    }
    return compile.run(options);
}
