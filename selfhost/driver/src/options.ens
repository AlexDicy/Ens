// Turning one reading of the command line into the immutable invocation a build runs on. Every
// option is checked here, before any work starts, so a mistyped level or an unknown pass is
// reported as the usage problem it is rather than as a build failure.
import TargetTriple from @ens.target.triple;
import SystemSupport from @ens.target.triple;
import TripleReading from @ens.target.triple;
import @ens.target.triple;
import CodegenSettings from @ens.codegen.settings;
import OptimizationLevel from @ens.codegen.settings;
import @ens.codegen.settings;
import @ens.codegen.passes.optimize;
import @ens.host.paths;
import Path from @std.fs;
import BuildOptions from @ens.build.options;
import Verbosity from @ens.build.options;
import @ens.build.platform;
import Invocation from @ens.cli.invocation;
import List from @std.collections.list;
import Platform from @std.platform;

// The options a build will run on, or the usage problem that stopped them being made.
export final class OptionsResolution {
    BuildOptions? made;
    string problem;

    protected constructor(this.made, this.problem);

    export options() -> BuildOptions? {
        return this.made;
    }

    export failure() -> string {
        return this.problem;
    }
}

// Reads the options a compiling command accepts. Where the standard library is and where the
// build is rooted both depend on what is being built, so both are settled afterwards, through
// BuildOptions.withStdlibRoot and BuildOptions.withArtifactRoot.
export resolve(Invocation invocation, Path workingFolder) -> OptionsResolution {
    let level = levelOf(invocation);
    if (level == null) {
        string written = invocation.value("optimization-level") ?? "";
        return failed("'{written}' is not an optimization level. Write a level from 0 to 3, as "
            + "in '-O2' or '--optimization-level 2'");
    }
    string[] disabled = invocation.values("disable-pass");
    string unknownPass = firstUnknownPass(disabled);
    if (unknownPass.length > 0) {
        return failed("'--disable-pass' has no pass called '{unknownPass}'. The passes are "
            + quotedList(optimize.passNames()));
    }
    if (invocation.flag("quiet") && invocation.flag("verbose")) {
        return failed("'--quiet' and '--verbose' cannot be used together. Remove one of them");
    }
    TargetTriple? target = null;
    string? named = invocation.value("target");
    if (named != null) {
        target = TargetTriple.parse(named);
        if (target == null) {
            return failed(refusedTarget(named));
        }
    } else {
        target = platform.getHostTarget();
        if (target == null) {
            return failed(refusedHost(platform.hostTriple()));
        }
    }

    if (invocation.flag("no-link") && invocation.value("output") != null) {
        return failed("'--output' names the executable to write, and '--no-link' writes none. "
            + "Remove one of the two");
    }
    if (invocation.flag("no-link") && invocation.flag("strip")) {
        return failed("'--strip' leaves the symbol table out of the executable, and '--no-link' "
            + "writes none. Remove one of the two");
    }

    let settings = new CodegenSettings(level, target, disabled, false,
        invocation.flag("explain-arc"), invocation.flag("explain-reachability"));
    return new OptionsResolution(new BuildOptions(workingFolder, settings,
        absoluteOrEmpty(invocation.value("stdlib"), workingFolder),
        absoluteOrEmpty(invocation.value("output"), workingFolder),
        absoluteOrEmpty(invocation.value("objects"), workingFolder),
        invocation.flag("offline"), invocation.flag("locked"),
        verbosityOf(invocation), Path(""), !invocation.flag("no-link"),
        invocation.flag("strip")), "");
}

// The level the command line requested, the default when it requested none, or null when what it
// wrote is no level at all.
levelOf(Invocation invocation) -> OptimizationLevel? {
    let written = invocation.value("optimization-level");
    if (written == null) {
        return OptimizationLevel.Default;
    }
    return settings.levelFromText(written);
}

verbosityOf(Invocation invocation) -> Verbosity {
    if (invocation.flag("quiet")) {
        return Verbosity.Quiet;
    }
    if (invocation.flag("verbose")) {
        return Verbosity.Verbose;
    }
    return Verbosity.Normal;
}

firstUnknownPass(string[] named) -> string {
    for (let name in named) {
        bool known = false;
        for (let pass in optimize.passNames()) {
            if (pass == name) {
                known = true;
            }
        }
        if (!known) {
            return name;
        }
    }
    return "";
}

// Why '--target' cannot take `text`, which names a processor or a system this toolchain does not
// build for, or names none. Each part at fault is named, and the example is the triple as written
// with only those parts replaced.
refusedTarget(string text) -> string {
    let reading = triple.read(text);
    return "{problemsOf("'--target {text}'", reading)} {fixOf(reading)}, as in "
        + "'{exampleFor(reading)}'";
}

// Why a command that names no target cannot build for this machine, whose own target is `host`,
// which names a processor or a system this toolchain does not build for. The example is the host's
// triple with only the parts at fault replaced.
public refusedHost(string host) -> string {
    let reading = triple.read(host);
    return "{problemsOf("this machine's target, '{host}',", reading)} Build for another target "
        + "with '--target', as in '--target {exampleFor(reading)}'";
}

// What is wrong with the triple `reading` read, as sentences the first of which starts with
// `subject`.
problemsOf(string subject, TripleReading reading) -> string {
    if (reading.supportsProcessor()) {
        return "{subject} {systemReason(reading)}.";
    }
    string processor = reading.processor();
    string unsupported = "names the processor '{processor}', which this toolchain cannot build for";
    if (processor.isEmpty()) {
        unsupported = "names no processor";
    }
    switch (reading.systemSupport()) {
        SystemSupport.Supported -> {
            return "{subject} {unsupported}.";
        },
        SystemSupport.Missing -> {
            if (processor.isEmpty()) {
                return "{subject} names no processor and no system.";
            }
            return "{subject} {unsupported}, and names no system.";
        },
        SystemSupport.Unsupported -> {
            if (processor.isEmpty()) {
                return "{subject} names no processor, and {systemReason(reading)}.";
            }
            return "{subject} names the processor '{processor}' and the system "
                + "'{reading.system()}', and this toolchain builds for neither.";
        },
        SystemSupport.LinuxMusl, SystemSupport.LinuxGnuForm, SystemSupport.WindowsMinGW,
                SystemSupport.WindowsCygwin -> {
            return "{subject} {unsupported}. The triple also {systemReason(reading)}.";
        },
    }
}

// Why this toolchain cannot build for the system `reading` read, as what the triple does.
systemReason(TripleReading reading) -> string {
    string onlyWindows = "this toolchain builds Windows programs only against the Microsoft C "
        + "runtime";
    return switch (reading.systemSupport()) {
        SystemSupport.Missing -> "names no system",
        SystemSupport.LinuxMusl -> "builds against the C library 'musl', and this toolchain "
            + "builds Linux programs only against the GNU C library",
        SystemSupport.LinuxGnuForm -> "builds against the GNU C library in its "
            + "'{reading.linuxLibrary()}' form, and this toolchain builds Linux programs only "
            + "against its plain 'gnu' form",
        SystemSupport.WindowsMinGW -> "builds against the MinGW C runtime, and {onlyWindows}",
        SystemSupport.WindowsCygwin -> "builds against the Cygwin C library, and {onlyWindows}",
        SystemSupport.Unsupported, SystemSupport.Supported -> "names the system "
            + "'{reading.system()}', which this toolchain cannot build for",
    };
}

// What to write in place of each part of the triple `reading` read that is at fault.
fixOf(TripleReading reading) -> string {
    string processors = "'x86_64' for a 64-bit Intel or AMD processor, or 'aarch64' or 'arm64' for "
        + "a 64-bit ARM one";
    string systems = switch (reading.systemSupport()) {
        SystemSupport.LinuxMusl, SystemSupport.LinuxGnuForm -> "'linux-gnu'",
        SystemSupport.WindowsMinGW, SystemSupport.WindowsCygwin -> "'windows-msvc'",
        SystemSupport.Missing, SystemSupport.Unsupported, SystemSupport.Supported -> "'linux-gnu' "
            + "for Linux, 'windows-msvc' for Windows or 'macosx' for macOS",
    };
    if (reading.systemSupport() == SystemSupport.Supported) {
        return "Make the first part of the triple {processors}";
    }
    if (reading.supportsProcessor()) {
        return "Make the end of the triple {systems}";
    }
    return "Make the first part of the triple {processors}. Make the end {systems}";
}

// The triple as written with the processor and the system replaced where they are at fault.
exampleFor(TripleReading reading) -> string {
    string processor = reading.processor();
    if (!reading.supportsProcessor()) {
        processor = processorLike(processor);
    }
    string system = reading.system();
    if (reading.systemSupport() != SystemSupport.Supported) {
        system = systemFor(reading.nearestPlatform());
    }
    return reading.spelledWith(processor, system);
}

// The processor to offer instead of `written`: an ARM one in the spelling `written` starts with,
// and the 64-bit Intel one otherwise.
processorLike(string written) -> string {
    if (written.startsWith("aarch")) {
        return "aarch64";
    }
    if (written.startsWith("arm")) {
        return "arm64";
    }
    return "x86_64";
}

// The system to offer for a triple whose system is nearest to `platform`.
systemFor(Platform platform) -> string {
    return switch (platform) {
        Platform.Windows -> "windows-msvc",
        Platform.Linux -> "linux-gnu",
        Platform.MacOS -> "macosx",
    };
}

// A folder or file a command line named, as it reads from the folder the command ran in, or empty
// text when the command line named none.
export absoluteOrEmpty(string? given, Path workingFolder) -> Path {
    if (given == null) {
        return Path("");
    }
    return paths.resolved(given, workingFolder);
}

quotedList(string[] names) -> string {
    let quoted = new List<string>();
    for (let name in names) {
        quoted.push("'" + name + "'");
    }
    string[] parts = quoted.toArray();
    if (parts.length <= 1) {
        return string.joined(parts, "");
    }
    return string.joined(parts.slice(0, parts.length - 1), ", ") + " and "
        + parts[parts.length - 1];
}

failed(string problem) -> OptionsResolution {
    return new OptionsResolution(null, problem);
}
