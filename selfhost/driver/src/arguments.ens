// The driver's command line: one source (a single .ens file or a program folder), the output
// executable, and the settings the build needs. Parsing is pure text work over the argument
// array, so every rule here is unit-testable on its own.
import StringBuilder from @std.text.stringbuilder;

// One parsed invocation. Empty optional settings mean "not given"; their fallbacks (the
// environment, discovery from the source) are resolved by the compilation, not here.
public class Options {
    public string source;
    public string output;
    public string stdlibRoot;
    public string objectsFolder;

    public constructor() {
        this.source = "";
        this.output = "";
        this.stdlibRoot = "";
        this.objectsFolder = "";
    }
}

// What parsing produced: the options, or the problem that stopped it.
public class ParsedArguments {
    public Options? options;
    public string problem;

    public constructor(this.options, this.problem);
}

public usage() -> string {
    return "usage: ensc <source> --output <file> [--stdlib <folder>] [--objects <folder>]";
}

// Parses the full argument array as the process receives it, program name first. Every path
// value is normalized to forward slashes.
public parse(string[] argv) -> ParsedArguments {
    let options = new Options();
    long next = 1;
    while (next < argv.length) {
        string argument = argv[next];
        if (isValuedOption(argument)) {
            if (next + 1 >= argv.length || argv[next + 1].length == 0) {
                return failed("option '{argument}' needs a value");
            }
            setValue(options, argument, slashed(argv[next + 1]));
            next = next + 2;
            continue;
        }
        if (argument.startsWith("-")) {
            return failed("unknown option '{argument}'");
        }
        if (options.source.length > 0) {
            return failed("unexpected argument '{argument}'; one source is compiled "
                + "per invocation");
        }
        options.source = slashed(argument);
        next++;
    }
    if (options.source.length == 0) {
        return failed("no source to compile; name a .ens file or a program folder");
    }
    if (options.output.length == 0) {
        return failed("no output path; pass --output <file>");
    }
    return new ParsedArguments(options, "");
}

isValuedOption(string argument) -> bool {
    return argument == "--output" || argument == "--stdlib" || argument == "--objects";
}

setValue(Options options, string name, string value) {
    switch (name) {
        "--output" -> {
            options.output = value;
        },
        "--stdlib" -> {
            options.stdlibRoot = value;
        },
        "--objects" -> {
            options.objectsFolder = value;
        },
        default -> { },
    }
}

failed(string problem) -> ParsedArguments {
    return new ParsedArguments(null, problem);
}

// Path text with every backslash turned forward, so one separator convention holds everywhere
// downstream of the command line.
public slashed(string path) -> string {
    let out = new StringBuilder();
    byte[] raw = path.toBytes();
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] == '\\') {
            out.append("/");
        } else {
            out.appendByte(raw[i]);
        }
    }
    return out.toString();
}

// The output's file name without its extension, the stem every object file of the build starts
// with, so one folder can hold the objects of several programs apart.
public outputStem(string output) -> string {
    string name = fileNameOf(output);
    byte[] raw = name.toBytes();
    for (long i = raw.length - 1; i > 0; i--) {
        if (raw[i] == '.') {
            return name.substring(0, i);
        }
    }
    return name;
}

fileNameOf(string path) -> string {
    byte[] raw = path.toBytes();
    for (long i = raw.length - 1; i >= 0; i--) {
        if (raw[i] == '/') {
            return path.substring(i + 1, path.length);
        }
    }
    return path;
}
