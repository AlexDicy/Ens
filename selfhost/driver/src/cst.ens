// The two hidden syntax tools: printing a file's syntax tree, and reporting what the parser made of
// it. They work on one file at a time and read nothing else, which is what makes them useful when
// the front end itself is the thing under suspicion.
import @std.system;
import SystemError from @std.system;
import Source from @ens.frontend.support.source;
import LineIndex from @ens.frontend.support.source;
import @ens.frontend.parse.parser;
import @ens.frontend.syntax.generated.dump;
import @ens.frontend.syntax.generated.factory;

// Prints the file's syntax tree. Returns the exit code: 0 printed, 2 the file could not be read.
export dumpFile(string file) -> int {
    string text = try system.readAllText(file);
    let parsed = parser.parse(new Source(file, text));
    print(dump.dumpTree(factory.createRoot(parsed.root())));
    return 0;
} catch (SystemError error) {
    system.writeError("ens: could not read '{file}': {error.message}");
    return 2;
}

// Parses the file and reports every problem the parser found, saying nothing when it found none.
// Returns the exit code: 0 the file parsed cleanly, 1 it did not, 2 it could not be read.
export analyzeFile(string file) -> int {
    string text = try system.readAllText(file);
    let source = new Source(file, text);
    let parsed = parser.parse(source);
    let index = new LineIndex(source);
    long found = 0;
    for (let diagnostic in parsed.diagnostics()) {
        let position = index.positionAt(diagnostic.span().start);
        system.writeError("{file}:{position.line}:{position.column}: error: "
            + diagnostic.message());
        found++;
    }
    if (found == 0) {
        return 0;
    }
    return 1;
} catch (SystemError error) {
    system.writeError("ens: could not read '{file}': {error.message}");
    return 2;
}
