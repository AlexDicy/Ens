// What `ens` accepts. The whole command surface is declared here once, and both the parser and
// the help text are made out of these declarations, so they can never drift apart. '--help', '-h',
// '--version' and the 'help' command are handled by the library itself and are not declared.
import Application from @ens.cli.command;
import Command from @ens.cli.command;

// The options every compiling command shares, declared on each of them rather than on the
// application, so 'ens help build' lists them where a user looks for them.
declareBuildOptions(Command command) {
    command.option("target", "triple", "Build for another machine, such as 'x86_64-unknown-linux-gnu'");
    command.option("toolchain", "version", "The Ens version to build with, or 'local' for this one");
    command.option("optimization-level", 'O', "level",
        "How much to optimize, from 0 to 3, where 0 means not at all");
    command.option("stdlib", "folder", "The folder that contains the standard library's 'std/' folder");
    command.flag("explain-arc", "List the reference-count updates the optimizer removed");
    command.flag("explain-reachability", "List which functions the program uses and which are left out");
    command.option("disable-pass", "name",
        "Skip the named optimization pass, to find a pass that breaks the program", repeatable: true,
        hidden: true);
    command.flag("offline", "Download nothing, so a package not yet cached fails the build");
    command.flag("locked", "Fail instead of changing the versions ens.lock records");
    command.flag("quiet", 'q', "Report problems and nothing else");
    command.flag("verbose", 'v', "Report each step as it runs");
}

export application() -> Application {
    let ens = new Application("ens", "The Ens compiler and build tool.",
        "With no path, a command works on the nearest package in or above the folder it was run in.");
    ens.command(buildCommand());
    ens.command(runCommand());
    ens.command(checkCommand());
    ens.command(testCommand());
    ens.command(overrideCommand());
    ens.command(versionCommand());
    ens.command(dumpCommand());
    ens.command(analyzeCommand());
    return ens;
}

buildCommand() -> Command {
    let build = new Command("build", "Compile a program, a package, or a workspace's members",
        "The path is an '.ens' file, a folder of sources, a package folder, or a workspace root.\n"
        + "A program whose main module defines main() becomes an executable. One without main()\n"
        + "is a library: it is compiled the same way, and no executable is written. At a\n"
        + "workspace root every member is built, each one after the members it depends on.");
    build.argument("path", "what to build", required: false);
    build.option("output", 'o', "file", "Where to write the executable");
    declareBuildOptions(build);
    build.option("objects", "folder", "Where to leave the object files", repeatable: false,
        hidden: true);
    build.suggestForPassthrough("run");
    return build;
}

runCommand() -> Command {
    let run = new Command("run", "Build a program and run it",
        "The program is built in a folder of its own, and that folder is removed afterwards, so\n"
        + "nothing is left behind. Everything written after '--' is passed to the program exactly\n"
        + "as written, and 'ens run' exits with the program's exit code. At a workspace root, the\n"
        + "one member that is a program is the one that runs.");
    run.argument("path", "what to run", required: false);
    declareBuildOptions(run);
    run.passthrough();
    return run;
}

checkCommand() -> Command {
    let check = new Command("check", "Look for problems without building anything",
        "Reports every problem a build would report, without writing object files or an\n"
        + "executable. At a workspace root every member is checked, even after one of them has\n"
        + "problems.");
    check.argument("path", "what to check", required: false);
    declareBuildOptions(check);
    check.suggestForPassthrough("run");
    return check;
}

testCommand() -> Command {
    let test = new Command("test", "Run the tests of a package, a folder or a workspace",
        "Tests are in files whose names end in '_test.ens'. They are read from the target's\n"
        + "'tests' folder, or from the target itself when it has none. They are built with the\n"
        + "sources into one program, and each result is printed as its test finishes. At a\n"
        + "workspace root every member is tested with its own tests, even after one of them has\n"
        + "failures.");
    test.argument("path", "what to test", required: false);
    test.option("filter", "text", "Run only the tests whose description contains this text");
    test.option("tests", "folder", "The folder to read test files from, instead of 'tests'");
    declareBuildOptions(test);
    return test;
}

// The three forms are commands of their own rather than a word this one reads, so each carries its
// own help and its own arguments and a misspelled form gets the nearest one.
overrideCommand() -> Command {
    let redirect = new Command("override", "Take a package from a folder on this machine",
        "An override makes every dependency on one package, in every package of the build, use\n"
        + "a folder given here. Overrides are kept in an 'ens.overrides' file beside the\n"
        + "workspace's manifest, are not committed, and apply to every build there. Use one to\n"
        + "build against unreleased work on a dependency.");
    redirect.command(overrideAddCommand());
    redirect.command(overrideRemoveCommand());
    redirect.command(overrideListCommand());
    return redirect;
}

overrideAddCommand() -> Command {
    let add = new Command("add", "Take a package from a folder",
        "The folder is read relative to where the command runs, and is written down relative to\n"
        + "the workspace root. It must contain an ens.package that declares exactly the named\n"
        + "package: an override changes where a package comes from, never which package it is.\n"
        + "Adding an override for a package that already has one replaces it.");
    add.argument("package", "the overridden package");
    add.argument("folder", "the folder to take it from");
    return add;
}

overrideRemoveCommand() -> Command {
    let remove = new Command("remove", "Stop taking a package from a folder",
        "Every dependency on the package is taken again from the place its manifest names.");
    remove.argument("package", "the overridden package");
    return remove;
}

overrideListCommand() -> Command {
    return new Command("list", "List the overridden packages and whether each folder can be used");
}

versionCommand() -> Command {
    return new Command("version", "Print the toolchain version");
}

dumpCommand() -> Command {
    let dump = new Command("cst-dump", "Print a file's syntax tree",
        "Every element of the tree on its own line, with its kind, its byte range and its text.",
        hidden: true);
    dump.argument("file", "the file to read");
    return dump;
}

analyzeCommand() -> Command {
    let analyze = new Command("cst-analyze", "Parse a file and report what the parser found",
        "Nothing is printed for a file that parses cleanly.", hidden: true);
    analyze.argument("file", "the file to read");
    return analyze;
}
