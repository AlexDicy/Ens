// What `ens` answers to. The whole command surface is declared here once, and both the parser and
// the help text are made out of these declarations, so they can never drift apart. '--help', '-h',
// '--version' and the 'help' command are answered by the library itself and are not declared.
import Application from @ens.cli.command;
import Command from @ens.cli.command;

// The options every compiling command shares, declared on each of them rather than on the
// application, so 'ens help build' lists them where a user looks for them.
declareBuildOptions(Command command) {
    command.option("target", "triple", "Build for this triple, not this machine's own");
    command.option("toolchain", "version",
        "Which version of Ens does the work; 'local' is this one");
    command.option("optimization-level", 'O', "level",
        "How hard to optimize, 0 to 3; 0 turns the optimizer off");
    command.option("stdlib", "folder", "Where 'std/' lives, instead of looking for it");
    command.flag("explain-arc", "Say what the reference-counting optimizer elided");
    command.option("disable-pass", "name",
        "Leave one optimization pass out, to find which one miscompiles", repeatable: true,
        hidden: true);
    command.flag("offline", "Use no network; anything not already cached fails the build");
    command.flag("locked", "Fail rather than change ens.lock, which is what a CI build wants");
    command.flag("quiet", 'q', "Report problems and nothing else");
    command.flag("verbose", 'v', "Report each step as it runs");
}

export application() -> Application {
    let ens = new Application("ens", "The Ens compiler and build tool.",
        "With no path, a command works on the nearest package above the folder it was run in.");
    ens.command(buildCommand());
    ens.command(runCommand());
    ens.command(checkCommand());
    ens.command(testCommand());
    ens.command(overrideCommand());
    ens.command(versionCommand());
    ens.command(dumpCommand());
    ens.command(analyzeCommand());
    return ens;
}

buildCommand() -> Command {
    let build = new Command("build", "Compile a program, a package, or a workspace's members",
        "The path is an '.ens' file, a folder of sources, a package folder, or a workspace root.\n"
        + "A program whose main module defines main() becomes an executable; one without is a\n"
        + "library, compiled just as thoroughly with nothing kept. At a workspace root every\n"
        + "member is built, each one after the members it depends on.");
    build.argument("path", "what to build", required: false);
    build.option("output", 'o', "file", "Where to write the executable");
    declareBuildOptions(build);
    build.option("objects", "folder", "Where to leave the object files", repeatable: false,
        hidden: true);
    return build;
}

runCommand() -> Command {
    let run = new Command("run", "Build a program and run it",
        "The program is built in a folder of its own and that folder is removed afterwards, so\n"
        + "nothing is left behind. Everything written after '--' reaches the program exactly as\n"
        + "it was written, and the code the program ends with becomes this command's own. At a\n"
        + "workspace root the one member that is a program is the one that runs.");
    run.argument("path", "what to run", required: false);
    declareBuildOptions(run);
    run.passthrough();
    return run;
}

checkCommand() -> Command {
    let check = new Command("check", "Look for problems without building anything",
        "Everything a build does up to code generation, and nothing after it. At a workspace root\n"
        + "every member is checked, even after one of them reports problems.");
    check.argument("path", "what to check", required: false);
    declareBuildOptions(check);
    return check;
}

testCommand() -> Command {
    let test = new Command("test", "Run a target's tests",
        "Tests live in files whose names end '_test.ens'. Every one of them under the target's\n"
        + "'tests' folder, or under the target itself when it keeps no separate folder, is built\n"
        + "together with the sources into one program and run. Each result is reported as the\n"
        + "test it belongs to finishes. At a workspace root every member is tested against its\n"
        + "own tests, even after one of them reports failures.");
    test.argument("path", "what to test", required: false);
    test.option("filter", "text", "Run only the tests whose description contains this text");
    test.option("tests", "folder", "Where the test files live, instead of the target's own");
    declareBuildOptions(test);
    return test;
}

// The three forms are commands of their own rather than a word this one reads, so each carries its
// own help and its own arguments and a misspelled form is answered with the nearest one.
overrideCommand() -> Command {
    let redirect = new Command("override", "Take a package from a folder on this machine",
        "An override redirects every dependency on one package, in every package of the build,\n"
        + "to a folder given here. Overrides live in an 'ens.overrides' file beside the\n"
        + "workspace's manifest, are not committed, and apply to every build rooted there. They\n"
        + "are how work in progress on a dependency reaches a build without being released.");
    redirect.command(overrideAddCommand());
    redirect.command(overrideRemoveCommand());
    redirect.command(overrideListCommand());
    return redirect;
}

overrideAddCommand() -> Command {
    let add = new Command("add", "Redirect a package at a folder",
        "The folder is read from where the command was run and written down relative to the\n"
        + "workspace root. It must hold an ens.package declaring exactly the package being\n"
        + "redirected: an override says where a package comes from, never which package it is.\n"
        + "Redirecting a package that is already redirected replaces where it comes from.");
    add.argument("package", "the package to redirect");
    add.argument("folder", "the folder to take it from");
    return add;
}

overrideRemoveCommand() -> Command {
    let remove = new Command("remove", "Stop redirecting a package",
        "Every dependency on the package goes back to resolving the way it declares.");
    remove.argument("package", "the package to stop redirecting");
    return remove;
}

overrideListCommand() -> Command {
    return new Command("list", "Show which packages are redirected and whether their folders work");
}

versionCommand() -> Command {
    return new Command("version", "Print the toolchain version");
}

dumpCommand() -> Command {
    let dump = new Command("cst-dump", "Print a file's syntax tree",
        "Every element of the tree on its own line, with its kind, its span, and its text.",
        hidden: true);
    dump.argument("file", "the file to read");
    return dump;
}

analyzeCommand() -> Command {
    let analyze = new Command("cst-analyze", "Parse a file and report what the parser found",
        "Nothing is printed for a file that parses cleanly.", hidden: true);
    analyze.argument("file", "the file to read");
    return analyze;
}
