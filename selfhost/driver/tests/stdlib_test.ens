// Standard library discovery: the environment override when it points somewhere real, else the
// walk from the source folder up to the nearest ancestor holding libs/std/ens.package.
import @std.testing;
import MemoryFileLoader from support;
import stdlib;

withRepo() -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/repo/libs/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    return loader;
}

test "an existing ENS_STDLIB wins over discovery" {
    let loader = withRepo();
    loader.add("/elsewhere/libs", "");
    try testing.assertEqual(
        stdlib.findStdlibRoot(loader, "/elsewhere/libs", "/repo/tools/app/src"),
        "/elsewhere/libs");
}

test "a missing ENS_STDLIB falls back to the walk" {
    try testing.assertEqual(
        stdlib.findStdlibRoot(withRepo(), "/nowhere/libs", "/repo/tools/app/src"),
        "/repo/libs");
}

test "the walk finds the nearest ancestor with libs/std" {
    try testing.assertEqual(
        stdlib.findStdlibRoot(withRepo(), null, "/repo/tools/app/src"), "/repo/libs");
    try testing.assertEqual(stdlib.findStdlibRoot(withRepo(), null, "/repo"), "/repo/libs");
}

test "no marked ancestor means no root" {
    try testing.assertEqual(stdlib.findStdlibRoot(withRepo(), null, "/other/place"), "");
    try testing.assertEqual(stdlib.findStdlibRoot(new MemoryFileLoader(), "", "C:/repo/app"),
        "");
}
