// Turning a read command line into the invocation a build runs on: the level it optimizes at, the
// target it builds for, the passes it leaves out, how loud it is, and the paths it resolves.
import @std.testing;
import Path from @std.fs;
import TestFailure from @std.testing;
import BuildOptions from @ens.build.options;
import Verbosity from @ens.build.options;
import @ens.build.platform;
import OptimizationLevel from @ens.codegen.settings;
import @ens.cli.parse;
import commands;
import options;

test "a build with no options optimizes at level 2 for this machine" {
    let settled = try settle(["build", "hello.ens"]);
    try testing.assertTrue(settled.codegen().optimizationLevel() == OptimizationLevel.Default,
        "the default level is 2");
    try testing.assertTrue(settled.codegen().optimizesEir(), "the pipeline runs");
    try testing.assertEqual(settled.targetTriple(), platform.hostTriple());
    try testing.assertTrue(settled.verbosity() == Verbosity.Normal, "an ordinary run");
    try testing.assertFalse(settled.namesOutput(), "no output was named");
    try testing.assertTrue(settled.objects().isEmpty(), "no objects folder was named");
    try testing.assertFalse(settled.codegen().explainsArc(), "no arc account was asked for");
    try testing.assertFalse(settled.codegen().explainsReachability(),
        "no reachability account was asked for");
}

test "each explanation flag reaches the settings on its own" {
    let arc = try settle(["build", "--explain-arc"]);
    try testing.assertTrue(arc.codegen().explainsArc(), "'--explain-arc' asks for that account");
    try testing.assertFalse(arc.codegen().explainsReachability(),
        "'--explain-arc' asks for no other account");
    let reachability = try settle(["build", "--explain-reachability"]);
    try testing.assertTrue(reachability.codegen().explainsReachability(),
        "'--explain-reachability' asks for that account");
    try testing.assertFalse(reachability.codegen().explainsArc(),
        "'--explain-reachability' asks for no other account");
}

test "every spelling of a level reaches the level it names" {
    try testing.assertTrue(try levelOf(["build", "-O0"]) == OptimizationLevel.None, "-O0");
    try testing.assertTrue(try levelOf(["build", "-O1"]) == OptimizationLevel.Less, "-O1");
    try testing.assertTrue(try levelOf(["build", "-O", "2"]) == OptimizationLevel.Default, "-O 2");
    try testing.assertTrue(
        try levelOf(["build", "--optimization-level", "3"]) == OptimizationLevel.Aggressive,
        "--optimization-level 3");
    try testing.assertTrue(
        try levelOf(["build", "--optimization-level=0"]) == OptimizationLevel.None,
        "--optimization-level=0");
}

test "level 0 turns the pipeline off and every other level leaves it on" {
    let none = try settle(["build", "-O0"]);
    try testing.assertFalse(none.codegen().optimizesEir(), "level 0 optimizes nothing");
    try testing.assertEqual(none.codegen().llvmOptimizationLevel(), 0);
    let hardest = try settle(["build", "-O3"]);
    try testing.assertTrue(hardest.codegen().optimizesEir(), "level 3 optimizes");
    try testing.assertEqual(hardest.codegen().llvmOptimizationLevel(), 3);
}

test "a level outside 0 to 3 is refused, naming both spellings" {
    for (let written in ["4", "-1", "two", "10"]) {
        string problem = try problemOf(["build", "--optimization-level=" + written]);
        try testing.assertEqual(problem, "'{written}' is not an optimization level. Write a level "
            + "from 0 to 3, as in '-O2' or '--optimization-level 2'");
    }
}

test "a pass that does not exist is refused, with the passes there are" {
    string problem = try problemOf(["build", "--disable-pass", "nonsense"]);
    try testing.assertEqual(problem, "'--disable-pass' has no pass called 'nonsense'. The passes "
        + "are 'inlining', 'borrow-rewriting', 'hold-elision', 'by-address-parameters', "
        + "'stack-promotion', 'devirtualization' and 'cleanup-pruning'");
}

test "the passes a build leaves out are kept in the order they were written" {
    let settled = try settle(["build", "--disable-pass", "cleanup-pruning", "--disable-pass",
        "borrow-rewriting"]);
    string[] disabled = settled.codegen().disabledPasses();
    try testing.assertEqual(disabled.length, 2);
    try testing.assertEqual(disabled[0], "cleanup-pruning");
    try testing.assertEqual(disabled[1], "borrow-rewriting");
    try testing.assertFalse(settled.codegen().runsPass("cleanup-pruning"), "left out");
    try testing.assertTrue(settled.codegen().runsPass("devirtualization"), "still runs");
}

// A build that links nothing leaves its object files for a linker on another machine, so there is
// no executable for '--output' to name.
test "a build links unless told not to, and one that does not names no executable" {
    let linked = try settle(["build", "hello.ens"]);
    try testing.assertTrue(linked.linksProgram(), "a build links");
    let unlinked = try settle(["build", "hello.ens", "--no-link"]);
    try testing.assertFalse(unlinked.linksProgram(), "'--no-link' leaves the link out");
    let settledLater = unlinked.withObjectsFolder(Path("/objects")).withStdlibRoot(Path("/libs"))
        .withArtifactRoot(Path("/root"));
    try testing.assertFalse(settledLater.linksProgram(),
        "a build settled after its command line keeps leaving the link out");
    string problem = try problemOf(["build", "--no-link", "--output", "hello.exe"]);
    try testing.assertEqual(problem, "'--output' names the executable to write, and '--no-link' "
        + "writes none. Remove one of the two");
}

test "quiet and verbose are each honored, and requesting both is refused" {
    let quiet = try settle(["build", "-q"]);
    try testing.assertTrue(quiet.verbosity() == Verbosity.Quiet, "quiet");
    let verbose = try settle(["build", "-v"]);
    try testing.assertTrue(verbose.verbosity() == Verbosity.Verbose, "verbose");
    string problem = try problemOf(["build", "-q", "-v"]);
    try testing.assertEqual(problem,
        "'--quiet' and '--verbose' cannot be used together. Remove one of them");
}

test "a target triple this toolchain builds for is taken in each spelling of its parts" {
    for (let triple in ["x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu",
            "arm64-apple-macosx14.0", "amd64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
            "arm64-unknown-linux-gnu", "x86_64-pc-win32", "x86_64-pc-windows", "x86_64-linux-gnu",
            "x86_64-unknown-linux", "arm64-apple-macos14.0", "x86_64-apple-darwin23",
            "x86_64-pc-windows-msvc19.40.0"]) {
        let settled = try settle(["build", "--target", triple]);
        try testing.assertEqual(settled.targetTriple(), triple);
    }
}

test "a triple naming a processor this toolchain does not build for names that processor" {
    try expectRefusal("i686-pc-windows-msvc", "'--target i686-pc-windows-msvc' names the "
        + "processor 'i686', which this toolchain cannot build for. Make the first part of the "
        + "triple 'x86_64' for a 64-bit Intel or AMD processor, or 'aarch64' or 'arm64' for a "
        + "64-bit ARM one, as in 'x86_64-pc-windows-msvc'");
    try expectProcessorRefusal("x86_64h-apple-darwin23", "x86_64h", "x86_64-apple-darwin23");
    try expectProcessorRefusal("arm64e-apple-macosx14.0", "arm64e", "arm64-apple-macosx14.0");
    try expectProcessorRefusal("aarch64_be-unknown-linux-gnu", "aarch64_be",
        "aarch64-unknown-linux-gnu");
}

test "a triple with nothing before its first dash names no processor" {
    try expectRefusal("-unknown-linux-gnu", "'--target -unknown-linux-gnu' names no processor. "
        + "Make the first part of the triple 'x86_64' for a 64-bit Intel or AMD processor, or "
        + "'aarch64' or 'arm64' for a 64-bit ARM one, as in 'x86_64-unknown-linux-gnu'");
}

test "a triple naming a system this toolchain does not build for names that system" {
    try expectRefusal("x86_64-unknown-freebsd", "'--target x86_64-unknown-freebsd' names the "
        + "system 'freebsd', which this toolchain cannot build for. Make the end of the triple "
        + "'linux-gnu' for Linux, 'windows-msvc' for Windows or 'macosx' for macOS, as in "
        + "'x86_64-unknown-linux-gnu'");
    try expectSystemRefusal("aarch64-linux-android", "linux-android", "aarch64-linux-gnu");
    try expectSystemRefusal("arm64-apple-ios17.0", "ios17.0", "arm64-apple-macosx");
    try expectSystemRefusal("x86_64-pc-windows-itanium", "windows-itanium",
        "x86_64-pc-windows-msvc");
    try expectSystemRefusal("x86_64-pc-windows-msvcfoo", "windows-msvcfoo",
        "x86_64-pc-windows-msvc");
    try expectSystemRefusal("x86_64-unknown-none", "none", "x86_64-unknown-linux-gnu");
    try expectSystemRefusal("x86_64-uefi", "uefi", "x86_64-linux-gnu");
}

test "a triple of a processor alone names no system" {
    try expectRefusal("x86_64", "'--target x86_64' names no system. Make the end of the triple "
        + "'linux-gnu' for Linux, 'windows-msvc' for Windows or 'macosx' for macOS, as in "
        + "'x86_64-unknown-linux-gnu'");
}

test "a Linux triple of another C library names that library" {
    try expectRefusal("x86_64-unknown-linux-musl", "'--target x86_64-unknown-linux-musl' builds "
        + "against the C library 'musl', and this toolchain builds Linux programs only against "
        + "the GNU C library. Make the end of the triple 'linux-gnu', as in "
        + "'x86_64-unknown-linux-gnu'");
    try expectRefusal("aarch64-unknown-linux-gnueabihf", "'--target "
        + "aarch64-unknown-linux-gnueabihf' builds against the GNU C library in its 'gnueabihf' "
        + "form, and this toolchain builds Linux programs only against its plain 'gnu' form. "
        + "Make the end of the triple 'linux-gnu', as in 'aarch64-unknown-linux-gnu'");
    try expectRefusal("x86_64-linux-gnux32", "'--target x86_64-linux-gnux32' builds against the "
        + "GNU C library in its 'gnux32' form, and this toolchain builds Linux programs only "
        + "against its plain 'gnu' form. Make the end of the triple 'linux-gnu', as in "
        + "'x86_64-linux-gnu'");
}

test "a Windows triple of another C runtime names that runtime" {
    try expectRefusal("x86_64-pc-windows-gnu", "'--target x86_64-pc-windows-gnu' builds against "
        + "the MinGW C runtime, and this toolchain builds Windows programs only against the "
        + "Microsoft C runtime. Make the end of the triple 'windows-msvc', as in "
        + "'x86_64-pc-windows-msvc'");
    try expectRefusal("x86_64-w64-mingw32", "'--target x86_64-w64-mingw32' builds against the "
        + "MinGW C runtime, and this toolchain builds Windows programs only against the Microsoft "
        + "C runtime. Make the end of the triple 'windows-msvc', as in 'x86_64-w64-windows-msvc'");
    try expectRefusal("x86_64-pc-cygwin", "'--target x86_64-pc-cygwin' builds against the Cygwin "
        + "C library, and this toolchain builds Windows programs only against the Microsoft C "
        + "runtime. Make the end of the triple 'windows-msvc', as in 'x86_64-pc-windows-msvc'");
}

test "a triple naming both a processor and a system this toolchain does not build for names both" {
    try expectRefusal("pdp11-dec-unix", "'--target pdp11-dec-unix' names the processor 'pdp11' "
        + "and the system 'unix', and this toolchain builds for neither. Make the first part of "
        + "the triple 'x86_64' for a 64-bit Intel or AMD processor, or 'aarch64' or 'arm64' for a "
        + "64-bit ARM one. Make the end 'linux-gnu' for Linux, 'windows-msvc' for Windows or "
        + "'macosx' for macOS, as in 'x86_64-dec-linux-gnu'");
    try expectBothRefusal("arm64_32-apple-watchos", "names the processor 'arm64_32' and the "
        + "system 'watchos', and this toolchain builds for neither", "arm64-apple-macosx");
    try expectBothRefusal("pdp11", "names the processor 'pdp11', which this toolchain cannot "
        + "build for, and names no system", "x86_64-unknown-linux-gnu");
    try expectBothRefusal("-unknown-freebsd", "names no processor, and names the system "
        + "'freebsd', which this toolchain cannot build for", "x86_64-unknown-linux-gnu");
    try expectBothRefusal("-", "names no processor and no system", "x86_64-unknown-linux-gnu");
}

// A system with a reason of its own gives that reason in a sentence of its own after the
// processor's.
test "a triple of an unbuilt processor and another C library names both in their own words" {
    try expectRefusal("armv7-unknown-linux-gnueabihf", "'--target armv7-unknown-linux-gnueabihf' "
        + "names the processor 'armv7', which this toolchain cannot build for. The triple also builds "
        + "against the GNU C library in its 'gnueabihf' form, and this toolchain builds Linux "
        + "programs only against its plain 'gnu' form. Make the first part of the triple "
        + "'x86_64' for a 64-bit Intel or AMD processor, or 'aarch64' or 'arm64' for a 64-bit ARM "
        + "one. Make the end 'linux-gnu', as in 'arm64-unknown-linux-gnu'");
    try expectRefusal("i686-unknown-linux-musl", "'--target i686-unknown-linux-musl' names the "
        + "processor 'i686', which this toolchain cannot build for. The triple also builds against the C "
        + "library 'musl', and this toolchain builds Linux programs only against the GNU C "
        + "library. Make the first part of the triple 'x86_64' for a 64-bit Intel or AMD "
        + "processor, or 'aarch64' or 'arm64' for a 64-bit ARM one. Make the end 'linux-gnu', as "
        + "in 'x86_64-unknown-linux-gnu'");
    try expectRefusal("i686-w64-mingw32", "'--target i686-w64-mingw32' names the processor "
        + "'i686', which this toolchain cannot build for. The triple also builds against the MinGW C "
        + "runtime, and this toolchain builds Windows programs only against the Microsoft C "
        + "runtime. Make the first part of the triple 'x86_64' for a 64-bit Intel or AMD "
        + "processor, or 'aarch64' or 'arm64' for a 64-bit ARM one. Make the end 'windows-msvc', "
        + "as in 'x86_64-w64-windows-msvc'");
}

// A machine whose own target this toolchain cannot build for can still build for another one,
// and the text says why its own is refused the way '--target' would.
test "a machine this toolchain cannot build for is named with the target to build for instead" {
    try testing.assertEqual(options.refusedHost("x86_64-alpine-linux-musl"), "this machine's "
        + "target, 'x86_64-alpine-linux-musl', builds against the C library 'musl', and this "
        + "toolchain builds Linux programs only against the GNU C library. Build for another "
        + "target with '--target', as in '--target x86_64-alpine-linux-gnu'");
    try testing.assertEqual(options.refusedHost("riscv64-unknown-freebsd14.1"), "this machine's "
        + "target, 'riscv64-unknown-freebsd14.1', names the processor 'riscv64' and the system "
        + "'freebsd14.1', and this toolchain builds for neither. Build for another target with "
        + "'--target', as in '--target x86_64-unknown-linux-gnu'");
    try testing.assertEqual(options.refusedHost("riscv64-unknown-linux-gnu"), "this machine's "
        + "target, 'riscv64-unknown-linux-gnu', names the processor 'riscv64', which this "
        + "toolchain cannot build for. Build for another target with '--target', as in "
        + "'--target x86_64-unknown-linux-gnu'");
}

expectProcessorRefusal(string triple, string processor, string example) throws {
    try expectRefusal(triple, "'--target {triple}' names the processor '{processor}', which this "
        + "toolchain cannot build for. Make the first part of the triple 'x86_64' for a 64-bit "
        + "Intel or AMD processor, or 'aarch64' or 'arm64' for a 64-bit ARM one, as in "
        + "'{example}'");
}

expectSystemRefusal(string triple, string system, string example) throws {
    try expectRefusal(triple, "'--target {triple}' names the system '{system}', which this "
        + "toolchain cannot build for. Make the end of the triple 'linux-gnu' for Linux, "
        + "'windows-msvc' for Windows or 'macosx' for macOS, as in '{example}'");
}

expectBothRefusal(string triple, string problems, string example) throws {
    try expectRefusal(triple, "'--target {triple}' {problems}. Make the first part of the triple "
        + "'x86_64' for a 64-bit Intel or AMD processor, or 'aarch64' or 'arm64' for a 64-bit ARM "
        + "one. Make the end 'linux-gnu' for Linux, 'windows-msvc' for Windows or 'macosx' for "
        + "macOS, as in '{example}'");
}

// Checks that the triple is refused with `expected`. It is written attached to '--target', so one
// that starts with '-' is its value.
expectRefusal(string triple, string expected) throws {
    string problem = try problemOf(["build", "--target={triple}"]);
    try testing.assertEqual(problem, expected);
}

test "the paths a build was given read from the folder the command ran in" {
    let settled = try settle(["build", "hello.ens", "--output", "out/hello.exe", "--objects",
        "out/objects", "--stdlib", "vendor/libs"]);
    try testing.assertEqual(settled.output(), Path("/work/out/hello.exe"));
    try testing.assertEqual(settled.objects(), Path("/work/out/objects"));
    try testing.assertEqual(settled.stdlibRoot(), Path("/work/vendor/libs"));
    try testing.assertEqual(settled.workingFolder(), Path("/work"));
}

test "an absolute path a build was given is left where it points" {
    let settled = try settle(["build", "--output", "/elsewhere/hello.exe"]);
    try testing.assertEqual(settled.output(), Path("/elsewhere/hello.exe"));
}

test "discovery supplies the standard library when the command line does not" {
    let settled = try settle(["build", "hello.ens"]);
    try testing.assertEqual(settled.stdlibRoot(), Path("/discovered/libs"));
}

// The options a command line settles into, failing the test when it was refused.
settle(string[] argv) -> BuildOptions throws {
    let read = parse.commandLine(commands.application(), argv);
    let problem = read.problem();
    if (problem != null) {
        throw new TestFailure("the command line was refused before the options: {problem}");
    }
    let resolution = options.resolve(read, Path("/work"));
    let settled = resolution.options();
    if (settled == null) {
        throw new TestFailure("the options were refused: {resolution.failure()}");
    }
    return settled.withStdlibRoot(discoveredStdlib(settled));
}

// Why a command line was refused, failing the test when it was accepted.
problemOf(string[] argv) -> string throws {
    let read = parse.commandLine(commands.application(), argv);
    let readingProblem = read.problem();
    if (readingProblem != null) {
        return readingProblem;
    }
    let resolution = options.resolve(read, Path("/work"));
    if (resolution.options() != null) {
        throw new TestFailure("the command line was accepted but should have been refused");
    }
    return resolution.failure();
}

// What discovery would have found, standing in for the walk a real build makes.
discoveredStdlib(BuildOptions given) -> Path {
    if (!given.stdlibRoot().isEmpty()) {
        return given.stdlibRoot();
    }
    return Path("/discovered/libs");
}

levelOf(string[] argv) -> OptimizationLevel throws {
    let settled = try settle(argv);
    return settled.codegen().optimizationLevel();
}
