// The command surface `ens` declares: which commands exist, which of them are hidden, and what the
// generated help then says about them. Declaring the command tree is what makes it real, so a
// declaration the library refuses would fail here rather than in someone's terminal.
import @std.testing;
import Command from @ens.cli.command;
import @ens.cli.help;
import @ens.cli.parse;
import commands;

test "the commands of this milestone are declared, and no more" {
    let ens = commands.application();
    string[] expected = ["build", "check", "version", "cst-dump", "cst-analyze", "help"];
    Command[] declared = ens.commands();
    try testing.assertEqual(declared.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(declared[i].name(), expected[i]);
    }
}

test "the commands still to come are not declared yet" {
    let ens = commands.application();
    for (let name in ["run", "test", "override"]) {
        try testing.assertTrue(ens.commandNamed(name) == null,
            "'{name}' belongs to a later milestone but is already declared");
    }
}

test "the syntax tools are hidden and the commands a user runs are not" {
    let ens = commands.application();
    for (let name in ["cst-dump", "cst-analyze"]) {
        let hidden = ens.commandNamed(name);
        try testing.assertTrue(hidden != null, "'{name}' is declared");
        if (hidden != null) {
            try testing.assertTrue(hidden.hidden(), "'{name}' is hidden");
        }
    }
    for (let name in ["build", "check", "version"]) {
        let shown = ens.commandNamed(name);
        try testing.assertTrue(shown != null, "'{name}' is declared");
        if (shown != null) {
            try testing.assertFalse(shown.hidden(), "'{name}' is shown");
        }
    }
}

test "the overview lists the commands a user runs and hides the rest" {
    let ens = commands.application();
    string overview = help.text(ens, null);
    try testing.assertTrue(overview.contains("Usage: ens <command>"), "the usage line: {overview}");
    for (let shown in ["build", "check", "version", "help"]) {
        try testing.assertTrue(overview.contains(shown), "the overview lists '{shown}'");
    }
    for (let hidden in ["cst-dump", "cst-analyze", "--objects", "--disable-pass"]) {
        try testing.assertFalse(overview.contains(hidden),
            "the overview leaks '{hidden}':\n{overview}");
    }
}

test "the build page names every option a build takes" {
    string page = pageFor("build");
    for (let option in ["-o, --output <file>", "--target <triple>",
            "-O, --optimization-level <level>", "--explain-arc", "--stdlib <folder>",
            "-q, --quiet", "-v, --verbose"]) {
        try testing.assertTrue(page.contains(option), "the build page names '{option}':\n{page}");
    }
    try testing.assertFalse(page.contains("--objects"), "the hidden objects folder stays hidden");
    try testing.assertFalse(page.contains("--disable-pass"), "the hidden pass switch stays hidden");
}

test "the check page takes the build options a check can honor, and no output" {
    string page = pageFor("check");
    for (let option in ["--target <triple>", "-O, --optimization-level <level>",
            "--stdlib <folder>", "-q, --quiet"]) {
        try testing.assertTrue(page.contains(option), "the check page names '{option}':\n{page}");
    }
    try testing.assertFalse(page.contains("--output"),
        "a check writes nothing, so it takes no output");
}

test "both '-O2' and '--optimization-level 2' reach the same option" {
    let ens = commands.application();
    for (let written in [["build", "-O2"], ["build", "-O", "2"],
            ["build", "--optimization-level=2"], ["build", "--optimization-level", "2"]]) {
        let read = parse.commandLine(ens, written);
        string problem = read.problem() ?? "";
        try testing.assertEqual(problem, "");
        try testing.assertEqual(read.value("optimization-level") ?? "", "2");
    }
}

test "a bare '-O' is refused with both spellings named" {
    let read = parse.commandLine(commands.application(), ["build", "-O"]);
    string problem = read.problem() ?? "";
    try testing.assertTrue(problem.contains("-O<level>"), "the short spelling: {problem}");
    try testing.assertTrue(problem.contains("--optimization-level <level>"),
        "the long spelling: {problem}");
}

// The page 'ens help <command>' shows, reached the way the driver reaches it.
pageFor(string command) -> string {
    let ens = commands.application();
    let asked = parse.commandLine(ens, ["help", command]);
    return help.text(ens, asked.helpTarget());
}
