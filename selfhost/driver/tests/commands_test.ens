// The command surface `ens` declares: which commands exist, which of them are hidden, and what the
// generated help then says about them. Declaring the command tree is what makes it real, so a
// declaration the library refuses would fail here rather than in someone's terminal.
import @std.testing;
import Command from @ens.cli.command;
import @ens.cli.help;
import @ens.cli.parse;
import commands;

test "the commands of this milestone are declared, and no more" {
    let ens = commands.application();
    string[] expected = ["build", "run", "check", "test", "override", "version", "cst-dump",
        "cst-analyze", "help"];
    Command[] declared = ens.commands();
    try testing.assertEqual(declared.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(declared[i].name(), expected[i]);
    }
}

// 'override' answers to no path of its own: its three forms are commands under it, so the word after
// it is read against them and a misspelling is answered with the nearest one.
test "the forms of 'override' are commands under it" {
    let redirect = commands.application().commandNamed("override");
    try testing.assertTrue(redirect != null, "'override' is declared");
    if (redirect == null) {
        return;
    }
    string[] expected = ["add", "remove", "list"];
    Command[] forms = redirect.commands();
    try testing.assertEqual(forms.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(forms[i].name(), expected[i]);
        try testing.assertFalse(forms[i].hidden(), "'{expected[i]}' is a form a user runs");
    }
}

test "each form's help page says what it takes" {
    string page = pageFor("override");
    for (let form in ["add", "remove", "list"]) {
        try testing.assertTrue(page.contains(form), "the override page lists '{form}':\n{page}");
    }
    string added = nestedPageFor("override", "add");
    try testing.assertTrue(added.contains("Usage: ens override add <package> <folder>"),
        "the add page names both arguments:\n{added}");
    string listed = nestedPageFor("override", "list");
    try testing.assertTrue(listed.contains("Usage: ens override list"),
        "the list page takes nothing:\n{listed}");
}

test "an override form reads as the command it names, and a wrong word is answered" {
    let ens = commands.application();
    let added = parse.commandLine(ens, ["override", "add", "acme.json", "../json"]);
    try testing.assertEqual(added.problem() ?? "", "");
    try testing.assertEqual(added.command(), "override add");
    try testing.assertEqual(added.positionals().length, 2);
    try testing.assertEqual(added.positionals()[0], "acme.json");
    try testing.assertEqual(added.positionals()[1], "../json");

    try testing.assertEqual(parse.commandLine(ens, ["override", "list"]).command(),
        "override list");
    try testing.assertEqual(parse.commandLine(ens, ["override", "remove", "acme.json"]).command(),
        "override remove");

    string bare = parse.commandLine(ens, ["override"]).problem() ?? "";
    try testing.assertTrue(bare.length > 0, "'ens override' names no form, so it is refused");
    string wrong = parse.commandLine(ens, ["override", "lst"]).problem() ?? "";
    try testing.assertTrue(wrong.contains("did you mean 'list'?"), "the nearest form: {wrong}");
    string tooMany = parse.commandLine(ens, ["override", "remove", "a.b", "extra"]).problem() ?? "";
    try testing.assertTrue(tooMany.contains("extra"), "the extra argument: {tooMany}");
}

test "the syntax tools are hidden and the commands a user runs are not" {
    let ens = commands.application();
    for (let name in ["cst-dump", "cst-analyze"]) {
        let hidden = ens.commandNamed(name);
        try testing.assertTrue(hidden != null, "'{name}' is declared");
        if (hidden != null) {
            try testing.assertTrue(hidden.hidden(), "'{name}' is hidden");
        }
    }
    for (let name in ["build", "run", "check", "test", "override", "version"]) {
        let shown = ens.commandNamed(name);
        try testing.assertTrue(shown != null, "'{name}' is declared");
        if (shown != null) {
            try testing.assertFalse(shown.hidden(), "'{name}' is shown");
        }
    }
}

test "the overview lists the commands a user runs and hides the rest" {
    let ens = commands.application();
    string overview = help.text(ens, null);
    try testing.assertTrue(overview.contains("Usage: ens <command>"), "the usage line: {overview}");
    for (let shown in ["build", "run", "check", "test", "override", "version", "help"]) {
        try testing.assertTrue(overview.contains(shown), "the overview lists '{shown}'");
    }
    for (let hidden in ["cst-dump", "cst-analyze", "--objects", "--disable-pass"]) {
        try testing.assertFalse(overview.contains(hidden),
            "the overview leaks '{hidden}':\n{overview}");
    }
}

test "the build page names every option a build takes" {
    string page = pageFor("build");
    for (let option in ["-o, --output <file>", "--target <triple>", "--toolchain <version>",
            "-O, --optimization-level <level>", "--explain-arc", "--stdlib <folder>",
            "-q, --quiet", "-v, --verbose"]) {
        try testing.assertTrue(page.contains(option), "the build page names '{option}':\n{page}");
    }
    try testing.assertFalse(page.contains("--objects"), "the hidden objects folder stays hidden");
    try testing.assertFalse(page.contains("--disable-pass"), "the hidden pass switch stays hidden");
}

test "the check page takes the build options a check can honor, and no output" {
    string page = pageFor("check");
    for (let option in ["--target <triple>", "--toolchain <version>",
            "-O, --optimization-level <level>", "--stdlib <folder>", "-q, --quiet"]) {
        try testing.assertTrue(page.contains(option), "the check page names '{option}':\n{page}");
    }
    try testing.assertFalse(page.contains("--output"),
        "a check writes nothing, so it takes no output");
}

test "the run page shows the passthrough and takes no output" {
    string page = pageFor("run");
    try testing.assertTrue(page.contains("Usage: ens run [<path>] [options] [-- <arguments>]"),
        "the usage line names what follows '--':\n{page}");
    try testing.assertFalse(page.contains("--output"),
        "a run keeps no artifact, so it takes no output");
}

test "the test page names what narrows a run and where the tests are read from" {
    string page = pageFor("test");
    for (let option in ["--filter <text>", "--tests <folder>", "-O, --optimization-level <level>",
            "--toolchain <version>"]) {
        try testing.assertTrue(page.contains(option),
            "the test page names '{option}':\n{page}");
    }
    try testing.assertFalse(page.contains("[-- <arguments>]"),
        "a test run passes nothing on, so it declares no passthrough");
}

test "both '-O2' and '--optimization-level 2' reach the same option" {
    let ens = commands.application();
    for (let written in [["build", "-O2"], ["build", "-O", "2"],
            ["build", "--optimization-level=2"], ["build", "--optimization-level", "2"]]) {
        let read = parse.commandLine(ens, written);
        string problem = read.problem() ?? "";
        try testing.assertEqual(problem, "");
        try testing.assertEqual(read.value("optimization-level") ?? "", "2");
    }
}

test "a bare '-O' is refused with both spellings named" {
    let read = parse.commandLine(commands.application(), ["build", "-O"]);
    string problem = read.problem() ?? "";
    try testing.assertTrue(problem.contains("-O<level>"), "the short spelling: {problem}");
    try testing.assertTrue(problem.contains("--optimization-level <level>"),
        "the long spelling: {problem}");
}

// The page 'ens help <command>' shows, reached the way the driver reaches it.
pageFor(string command) -> string {
    let ens = commands.application();
    let asked = parse.commandLine(ens, ["help", command]);
    return help.text(ens, asked.helpTarget());
}

nestedPageFor(string command, string form) -> string {
    let ens = commands.application();
    let asked = parse.commandLine(ens, ["help", command, form]);
    return help.text(ens, asked.helpTarget());
}
