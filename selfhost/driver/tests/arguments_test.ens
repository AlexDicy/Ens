// The command line: what parses, what each problem says, and the path text helpers.
import @std.testing;
import Options from arguments;
import arguments;

test "a full invocation parses every setting" {
    let parsed = arguments.parse(["ensc", "app", "--output", "out/app.exe",
        "--stdlib", "repo/libs", "--objects", "out/objects"]);
    let options = parsed.options;
    if (options == null) {
        try testing.fail("expected options, got '{parsed.problem}'");
    }
    try testing.assertEqual(options.source, "app");
    try testing.assertEqual(options.output, "out/app.exe");
    try testing.assertEqual(options.stdlibRoot, "repo/libs");
    try testing.assertEqual(options.objectsFolder, "out/objects");
}

test "a minimal invocation leaves the optional settings empty" {
    let parsed = arguments.parse(["ensc", "src/main.ens", "--output", "main.exe"]);
    let options = parsed.options;
    if (options == null) {
        try testing.fail("expected options, got '{parsed.problem}'");
    }
    try testing.assertEqual(options.source, "src/main.ens");
    try testing.assertEqual(options.output, "main.exe");
    try testing.assertEqual(options.stdlibRoot, "");
    try testing.assertEqual(options.objectsFolder, "");
}

test "backslashed paths normalize to forward slashes" {
    let parsed = arguments.parse(["ensc", "C:\\repo\\app", "--output", "C:\\out\\app.exe"]);
    let options = parsed.options;
    if (options == null) {
        try testing.fail("expected options, got '{parsed.problem}'");
    }
    try testing.assertEqual(options.source, "C:/repo/app");
    try testing.assertEqual(options.output, "C:/out/app.exe");
}

test "the problems name what is missing or unknown" {
    try testing.assertEqual(arguments.parse(["ensc", "--output", "app.exe"]).problem,
        "no source to compile; name a .ens file or a program folder");
    try testing.assertEqual(arguments.parse(["ensc", "app"]).problem,
        "no output path; pass --output <file>");
    try testing.assertEqual(arguments.parse(["ensc", "app", "--output"]).problem,
        "option '--output' needs a value");
    try testing.assertEqual(arguments.parse(["ensc", "app", "--verbose"]).problem,
        "unknown option '--verbose'");
    try testing.assertEqual(
        arguments.parse(["ensc", "app", "other", "--output", "app.exe"]).problem,
        "unexpected argument 'other'; one source is compiled per invocation");
}

test "the output stem drops the folder and the extension" {
    try testing.assertEqual(arguments.outputStem("out/boot2.exe"), "boot2");
    try testing.assertEqual(arguments.outputStem("boot"), "boot");
    try testing.assertEqual(arguments.outputStem("a.b/boot"), "boot");
    try testing.assertEqual(arguments.outputStem(".hidden"), ".hidden");
}
