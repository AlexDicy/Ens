// The seam this package says its progress through. What matters is that a run may decide the lines
// are counted rather than printed, which is what makes the parts that relay another program's output
// testable at all.
import @std.testing;
import List from @std.collections.list;
import Progress from progress;

class Recorded implements Progress {
    protected List<string> lines;

    protected constructor() {
        this.lines = new List<string>();
    }

    protected override step(string line) {
        this.lines.push("step " + line);
    }

    protected override relayed(string line) {
        this.lines.push("relayed " + line);
    }
}

test "a run may take the lines as values instead of letting them reach a stream" {
    let recorded = new Recorded();
    Progress listening = recorded;
    listening.step("staging the fetch");
    listening.relayed("Cloning into 'json'...");
    try testing.assertEqual(recorded.lines.length(), 2);
    try testing.assertEqual(recorded.lines.get(0), "step staging the fetch");
    try testing.assertEqual(recorded.lines.get(1), "relayed Cloning into 'json'...");
}
