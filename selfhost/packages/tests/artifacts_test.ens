// What a download is asked for and what the file it brings back is called. Both are values, so the
// options that keep a stalled download from stopping a build forever are verified without one.
import @std.testing;
import artifacts;

test "a download fails rather than saving what a server said instead, and gives up in time" {
    try testing.assertEqual(string.joined(artifacts.curlArguments("https://host/z.lib",
        "/cache/staging/download-1/z.lib"), " "),
        "--fail --location --silent --show-error --connect-timeout 30 --max-time 600 "
        + "--output /cache/staging/download-1/z.lib --url https://host/z.lib");
}

test "the file keeps the name the URL's path gives it" {
    try testing.assertEqual(artifacts.fileNameOf("https://host/releases/1.0/extras.lib"),
        "extras.lib");
    try testing.assertEqual(artifacts.fileNameOf("file:///C:/files/libz.a"), "libz.a");
}

test "anything a server reads after the path is left out of the name" {
    try testing.assertEqual(artifacts.fileNameOf("https://host/z.lib?token=abc"), "z.lib");
    try testing.assertEqual(artifacts.fileNameOf("https://host/z.lib#sha"), "z.lib");
    try testing.assertEqual(artifacts.fileNameOf("https://host/z.lib?a=1#b"), "z.lib");
}

test "a URL ending in a slash names the last part before it" {
    try testing.assertEqual(artifacts.fileNameOf("https://host/path/"), "path");
    try testing.assertEqual(artifacts.fileNameOf("https://host/"), "host");
}

test "a URL with nothing to name a file by still names one" {
    try testing.assertEqual(artifacts.fileNameOf(""), "artifact");
    try testing.assertEqual(artifacts.fileNameOf("/"), "artifact");
}
