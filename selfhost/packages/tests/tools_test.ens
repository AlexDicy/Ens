// The rules a fetch runs another program under: how long it lets one go without a word, and what it
// says about one it stopped. Starting a program is what the fixtures under 'tests/' drive against a
// real operating system; what belongs here is the part that is a rule rather than an effect.
import @std.testing;
import tools;

test "a program is given far longer than its own limits before it is stopped" {
    long bound = tools.silenceLimitMilliseconds();
    // curl gives up on a whole download after ten minutes, so the backstop has to sit above that or
    // it would cut off downloads curl itself would have finished.
    try testing.assertTrue(bound > 600000,
        "the bound is {bound}ms, which is not above the ten minutes curl allows a download");
    try testing.assertTrue(bound <= 3600000,
        "the bound is {bound}ms, which is long enough that a wedged build looks like a hung one");
}

test "a program that was stopped is reported with its name and the bound it outstayed" {
    string said = tools.silenceProblem("git", 900000);
    try assertMentions(said, "'git'");
    try assertMentions(said, "900 seconds");
    try assertMentions(said, "was stopped");
}

assertMentions(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}
