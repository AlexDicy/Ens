// The rules a fetch runs another program under: how long it lets one run without output, and what it
// prints about one it stopped. Starting a program is what the fixtures under 'tests/' drive against a
// real operating system; what belongs here is the part that is a rule rather than an effect.
import @std.testing;
import Environment from @std.environment;
import ExitStatus from @std.process;
import SilenceLimit from tools;
import tools;

test "a program is given far longer than its own limits before it is stopped" {
    long bound = SilenceLimit.milliseconds;
    // curl stops a whole download after ten minutes, so the backstop has to be above that or
    // it would cut off downloads curl itself would have finished.
    try testing.assertTrue(bound > 600000,
        "the bound is {bound}ms, which is not above the ten minutes curl allows a download");
    try testing.assertTrue(bound <= 3600000,
        "the bound is {bound}ms, which is long enough that a wedged build looks like a hung one");
}

test "a program that was stopped is reported with its name and the bound it outstayed" {
    string said = tools.silenceProblem("git", 900000);
    try assertMentions(said, "'git'");
    try assertMentions(said, "900 seconds");
    try assertMentions(said, "was stopped");
}

// The overrides are laid over this process's own variables, so the program keeps the ones it is
// not given anew, and an override replaces the inherited value under its name.
test "overrides are laid over this process's own environment" {
    let inherited = Environment.current();
    string[] names = inherited.names();
    try testing.assertTrue(names.length > 0, "this process has no environment to lay over");
    try testing.assertFalse(inherited.contains("ENS_TOOLS_PROBE_ONE"), "the probe is set");
    try testing.assertFalse(inherited.contains("ENS_TOOLS_PROBE_TWO"), "the probe is set");
    string kept = names[0];
    Environment? given = tools.childEnvironment(["ENS_TOOLS_PROBE_ONE=one", kept + "=replaced",
        "ENS_TOOLS_PROBE_TWO="]);
    try testing.assertTrue(given != null, "overrides were given and no environment came back");
    if (given != null) {
        try testing.assertEqual<string?>(given.get("ENS_TOOLS_PROBE_ONE"), "one");
        try testing.assertEqual<string?>(given.get(kept), "replaced");
        try testing.assertEqual<string?>(given.get("ENS_TOOLS_PROBE_TWO"), "");
        try testing.assertEqual(given.length(), inherited.length() + 2);
    }
}

test "no overrides hands this process's own environment on unchanged" {
    try testing.assertTrue(tools.childEnvironment([]) == null, "an environment was built for "
        + "no overrides");
}

// A program this build stopped ends by signal 9 on every system, which reads as 137, the code a
// shell reports for it.
test "the reported code is the exit code, or 128 plus the signal" {
    ExitStatus exited = {code: 3, signal: 0};
    ExitStatus stopped = {code: 0, signal: 9};
    try testing.assertEqual(tools.reportedCode(exited), 3);
    try testing.assertEqual(tools.reportedCode(stopped), 137);
}

assertMentions(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}
