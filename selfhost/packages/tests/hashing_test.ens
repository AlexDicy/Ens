// What a tree's digest covers and what it leaves out. The digests are not written out here, since
// what matters is that the same contents give one answer and any difference gives another. That a
// digest is the right one is pinned against the published vectors in sha256_test.
import @std.testing;
import Path from @std.fs;
import hashing;
import sha256;
import support;

test "a file's digest is the digest of its bytes, written the way a manifest writes one" {
    Path root = try support.scratch("hash-file");
    try support.writeFile(root, "notes.txt", "abc");
    string digest = try hashing.ofFile(root.join("notes.txt"));
    try testing.assertEqual(digest,
        "sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    try testing.assertEqual(hashing.digits(digest),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    try testing.assertEqual(hashing.digits(hashing.digits(digest)), hashing.digits(digest));
    try support.removeTree(root);
}

test "a tree is walked in one settled order, deepest paths and all" {
    Path root = try support.scratch("hash-order");
    try support.writeFile(root, "zz.txt", "z");
    try support.writeFile(root, "a/b/deep.txt", "d");
    try support.writeFile(root, "a.txt", "a");
    string[] found = try hashing.filesUnder(root);
    try testing.assertEqual(string.joined(found, " "), "a.txt a/b/deep.txt zz.txt");
    try support.removeTree(root);
}

test "two trees holding the same files agree, and any difference does not" {
    Path first = try support.scratch("hash-same-one");
    Path second = try support.scratch("hash-same-two");
    for (let folder in [first, second]) {
        try support.writeFile(folder, "src/main.ens", "the main module\n");
        try support.writeFile(folder, "ens.package", "the manifest\n");
    }
    string agreed = try hashing.ofTree(first);
    try testing.assertEqual(try hashing.ofTree(second), agreed);

    try support.writeFile(second, "src/main.ens", "the main module, changed\n");
    string changed = try hashing.ofTree(second);
    try testing.assertTrue(changed != agreed, "a changed byte left the digest alone");

    Path renamed = try support.scratch("hash-same-three");
    try support.writeFile(renamed, "src/other.ens", "the main module\n");
    try support.writeFile(renamed, "ens.package", "the manifest\n");
    string moved = try hashing.ofTree(renamed);
    try testing.assertTrue(moved != agreed, "a renamed file left the digest alone");

    try support.removeTree(first);
    try support.removeTree(second);
    try support.removeTree(renamed);
}

// Feeding a path and then its contents without their lengths would let a file's name run into the
// next file's contents, so two trees that differ must still differ once the digest has read them.
test "where one file ends and the next begins is part of the digest" {
    Path apart = try support.scratch("hash-frame-one");
    try support.writeFile(apart, "a", "");
    try support.writeFile(apart, "b", "x");
    string separate = try hashing.ofTree(apart);

    Path together = try support.scratch("hash-frame-two");
    try support.writeFile(together, "a", "b x");
    string single = try hashing.ofTree(together);

    try testing.assertTrue(separate != single,
        "two different trees fed the digest the same bytes");
    try support.removeTree(apart);
    try support.removeTree(together);
}

test "a clone's own bookkeeping is left out of the digest" {
    Path root = try support.scratch("hash-git");
    try support.writeFile(root, "src/main.ens", "the main module\n");
    string bare = try hashing.ofTree(root);

    try support.writeFile(root, ".git/HEAD", "ref: refs/heads/main\n");
    try support.writeFile(root, ".git/objects/ab/cdef", "not really an object\n");
    try testing.assertEqual(try hashing.ofTree(root), bare);
    string[] found = try hashing.filesUnder(root);
    try testing.assertEqual(string.joined(found, " "), "src/main.ens");

    // Only a folder of that name is skipped; a file named '.git' is content like any other.
    try support.removeTree(root.join(".git"));
    try support.writeFile(root, ".git", "gitdir: elsewhere\n");
    string withFile = try hashing.ofTree(root);
    try testing.assertTrue(withFile != bare, "a '.git' file was skipped too");
    try support.removeTree(root);
}

test "an empty tree still has a digest, and it is the digest of nothing" {
    Path root = try support.scratch("hash-empty");
    try testing.assertEqual(try hashing.ofTree(root), "sha256:" + sha256.ofText(""));
    try support.removeTree(root);
}

test "a digest reads the same however a manifest spelled its hex digits" {
    string canonical = "sha256:0123456789abcdef" + "0123456789abcdef"
        + "0123456789abcdef" + "0123456789abcdef";
    try testing.assertEqual(hashing.canonical(canonical), canonical);
    try testing.assertEqual(hashing.canonical("sha256:0123456789ABCDEF" + "0123456789ABCDEF"
        + "0123456789ABCDEF" + "0123456789ABCDEF"), canonical);
    try testing.assertEqual(hashing.canonical("0123456789ABCDEF" + "0123456789abcdef"
        + "0123456789ABCDEF" + "0123456789abcdef"), canonical);
}

// A package's own files are its digest whichever way its tree reaches them, so a folder reached
// through a link contributes exactly as one reached directly. The link pointing back at the tree is
// there because a digest that walked it round again would never finish.
test "a folder reached through a link is part of the tree's digest" {
    Path direct = try support.scratch("hash-link-direct");
    try support.writeFile(direct, "src/main.ens", "the main module\n");
    try support.writeFile(direct, "shared/held.ens", "the shared module\n");
    string agreed = try hashing.ofTree(direct);

    Path linkedTree = try support.scratch("hash-link-through");
    try support.writeFile(linkedTree, "src/main.ens", "the main module\n");
    Path beside = try support.scratch("hash-link-beside");
    try support.writeFile(beside, "held.ens", "the shared module\n");
    try testing.assertTrue(try support.linked(beside, linkedTree.join("shared")),
        "this system would not make a link under '{linkedTree}' to test with");
    try testing.assertEqual(try hashing.ofTree(linkedTree), agreed);

    try testing.assertTrue(try support.linked(linkedTree, linkedTree.join("src/loop")),
        "this system would not make a second link to test with");
    string[] found = try hashing.filesUnder(linkedTree);
    try testing.assertTrue(found.length > 0, "the walk answered nothing at all");

    try support.removeTree(direct);
    try support.removeTree(linkedTree);
    try support.removeTree(beside);
}
