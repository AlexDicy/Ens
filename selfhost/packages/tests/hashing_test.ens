// What a tree's digest covers and what it leaves out. The digests themselves are not written out
// here: what matters is that the same contents give one answer and any difference gives another,
// which is what a cache and a lock file rely on. That the digest of a run of bytes is the right one
// is pinned against the published vectors in sha256_test.
import @std.testing;
import @std.path;
import @std.text.strings;
import hashing;
import sha256;
import support;

test "a file's digest is the digest of its bytes, written the way a manifest writes one" {
    string root = try support.scratch("hash-file");
    try support.writeFile(root, "notes.txt", "abc");
    string digest = try hashing.ofFile(path.join(root, "notes.txt"));
    try testing.assertEqual(digest,
        "sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    try testing.assertEqual(hashing.digits(digest),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    try testing.assertEqual(hashing.digits(hashing.digits(digest)), hashing.digits(digest));
    try support.removeTree(root);
}

test "a tree is walked in one settled order, deepest paths and all" {
    string root = try support.scratch("hash-order");
    try support.writeFile(root, "zz.txt", "z");
    try support.writeFile(root, "a/b/deep.txt", "d");
    try support.writeFile(root, "a.txt", "a");
    string[] found = try hashing.filesUnder(root);
    try testing.assertEqual(strings.joined(found, " "), "a.txt a/b/deep.txt zz.txt");
    try support.removeTree(root);
}

test "two trees holding the same files agree, and any difference does not" {
    string first = try support.scratch("hash-same-one");
    string second = try support.scratch("hash-same-two");
    for (let folder in [first, second]) {
        try support.writeFile(folder, "src/main.ens", "the main module\n");
        try support.writeFile(folder, "ens.package", "the manifest\n");
    }
    string agreed = try hashing.ofTree(first);
    try testing.assertEqual(try hashing.ofTree(second), agreed);

    try support.writeFile(second, "src/main.ens", "the main module, changed\n");
    string changed = try hashing.ofTree(second);
    try testing.assertTrue(changed != agreed, "a changed byte left the digest alone");

    string renamed = try support.scratch("hash-same-three");
    try support.writeFile(renamed, "src/other.ens", "the main module\n");
    try support.writeFile(renamed, "ens.package", "the manifest\n");
    string moved = try hashing.ofTree(renamed);
    try testing.assertTrue(moved != agreed, "a renamed file left the digest alone");

    try support.removeTree(first);
    try support.removeTree(second);
    try support.removeTree(renamed);
}

// Feeding a path and then its contents without their lengths would let a file's name run into the
// next file's contents, so two trees that differ must still differ once the digest has read them.
test "where one file ends and the next begins is part of the digest" {
    string apart = try support.scratch("hash-frame-one");
    try support.writeFile(apart, "a", "");
    try support.writeFile(apart, "b", "x");
    string separate = try hashing.ofTree(apart);

    string together = try support.scratch("hash-frame-two");
    try support.writeFile(together, "a", "b x");
    string single = try hashing.ofTree(together);

    try testing.assertTrue(separate != single,
        "two different trees fed the digest the same bytes");
    try support.removeTree(apart);
    try support.removeTree(together);
}

test "a clone's own bookkeeping is left out of the digest" {
    string root = try support.scratch("hash-git");
    try support.writeFile(root, "src/main.ens", "the main module\n");
    string bare = try hashing.ofTree(root);

    try support.writeFile(root, ".git/HEAD", "ref: refs/heads/main\n");
    try support.writeFile(root, ".git/objects/ab/cdef", "not really an object\n");
    try testing.assertEqual(try hashing.ofTree(root), bare);
    string[] found = try hashing.filesUnder(root);
    try testing.assertEqual(strings.joined(found, " "), "src/main.ens");

    // Only a folder of that name is skipped; a file named '.git' is content like any other.
    try support.removeTree(path.join(root, ".git"));
    try support.writeFile(root, ".git", "gitdir: elsewhere\n");
    string withFile = try hashing.ofTree(root);
    try testing.assertTrue(withFile != bare, "a '.git' file was skipped too");
    try support.removeTree(root);
}

test "an empty tree still has a digest, and it is the digest of nothing" {
    string root = try support.scratch("hash-empty");
    try testing.assertEqual(try hashing.ofTree(root), "sha256:" + sha256.ofText(""));
    try support.removeTree(root);
}
