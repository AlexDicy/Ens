// What a build says it changed about the lock, and how it decides that anything changed at all.
// Both are what '--locked' turns into an error, so both are pinned here without a build.
import @std.testing;
import List from @std.collections.list;
import Lockfile from lockfile;
import LockPackage from lockfile;
import LockRequirement from lockfile;
import LockArtifact from lockfile;
import LockMember from lockfile;
import lockfile;
import lockdiff;

digits(string mark) -> string {
    string filled = "";
    for (long i = 0; i < 64; i++) {
        filled = filled + mark;
    }
    return "sha256:" + filled;
}

recorded(string name, string version, string commit, string content,
         LockRequirement[] requires) -> LockPackage {
    LockArtifact[] noArtifacts = [];
    return new LockPackage(name, version, "https://host/" + name + ".git", commit, content,
        requires, noArtifacts);
}

lockOf(LockPackage[] packages) -> Lockfile {
    LockArtifact[] noArtifacts = [];
    return new Lockfile("demo.app", noArtifacts, noMembers(), packages);
}

noMembers() -> LockMember[] {
    LockMember[] none = [];
    return none;
}

noRequirements() -> LockRequirement[] {
    LockRequirement[] none = [];
    return none;
}

test "a lock records the same thing as itself" {
    let lock = lockOf([recorded("a.one", "1.0", "c1", digits("1"), noRequirements())]);
    try testing.assertTrue(lockdiff.same(lock, lock));
    try testing.assertTrue(!lockdiff.compare(lock, lock).any());
    try testing.assertEqual(lockdiff.compare(lock, lock).summary(), "");
}

test "the order packages were resolved in is not a difference" {
    let one = recorded("a.one", "1.0", "c1", digits("1"), noRequirements());
    let two = recorded("b.two", "2.0", "c2", digits("2"), noRequirements());
    try testing.assertTrue(lockdiff.same(lockOf([one, two]), lockOf([two, one])));
}

test "a package the lock did not record is locked, and the summary is in name order" {
    let before = lockOf([recorded("m.middle", "1.0", "c1", digits("1"), noRequirements())]);
    let after = lockOf([
        recorded("z.last", "3.0", "c3", digits("3"), noRequirements()),
        recorded("m.middle", "1.0", "c1", digits("1"), noRequirements()),
        recorded("a.first", "2.0", "c2", digits("2"), noRequirements()),
    ]);
    try testing.assertTrue(!lockdiff.same(before, after));
    try testing.assertEqual(lockdiff.compare(before, after).summary(),
        "locked a.first 2.0, locked z.last 3.0");
}

test "a raised version reads as what it was and what it is" {
    let before = lockOf([recorded("alex.json", "1.0", "c1", digits("1"), noRequirements())]);
    let after = lockOf([recorded("alex.json", "1.1", "c2", digits("2"), noRequirements())]);
    try testing.assertEqual(lockdiff.compare(before, after).summary(),
        "updated alex.json 1.0 -> 1.1");
}

test "a package no longer required is removed at the version it was locked at" {
    let before = lockOf([
        recorded("alex.json", "1.0", "c1", digits("1"), noRequirements()),
        recorded("beta.utils", "2.0", "c2", digits("2"), noRequirements()),
    ]);
    let after = lockOf([recorded("alex.json", "1.0", "c1", digits("1"), noRequirements())]);
    try testing.assertEqual(lockdiff.compare(before, after).summary(), "removed beta.utils 2.0");
}

test "the same version from somewhere else is a difference worth naming" {
    let before = lockOf([recorded("rt.pkg", "1.0", "c1", digits("1"), noRequirements())]);
    let after = lockOf([recorded("rt.pkg", "1.0", "c9", digits("9"), noRequirements())]);
    try testing.assertEqual(lockdiff.compare(before, after).summary(),
        "updated rt.pkg 1.0, which now comes from elsewhere");
}

test "what a locked package requires is part of what the lock records" {
    let before = lockOf([recorded("acme.tools", "1.0", "c1", digits("1"), noRequirements())]);
    let after = lockOf([recorded("acme.tools", "1.0", "c1", digits("1"),
        [new LockRequirement("beta.utils", "1.1")])]);
    try testing.assertTrue(!lockdiff.same(before, after));
    try testing.assertEqual(lockdiff.compare(before, after).summary(),
        "updated what acme.tools 1.0 requires");
}

test "the order requirements were recorded in is not a difference" {
    let first = lockOf([recorded("acme.tools", "1.0", "c1", digits("1"),
        [new LockRequirement("a.one", "1.0"), new LockRequirement("b.two", "2.0")])]);
    let second = lockOf([recorded("acme.tools", "1.0", "c1", digits("1"),
        [new LockRequirement("b.two", "2.0"), new LockRequirement("a.one", "1.0")])]);
    try testing.assertTrue(!lockdiff.compare(first, second).any());
}

test "the prebuilt libraries a locked package binds are part of what the lock records" {
    LockArtifact[] none = [];
    let before = new Lockfile("demo.app", none, noMembers(), [new LockPackage("acme.tools", "1.0",
        "https://host/t.git", "c1", digits("1"), noRequirements(), none)]);
    let after = new Lockfile("demo.app", none, noMembers(), [new LockPackage("acme.tools", "1.0",
        "https://host/t.git", "c1", digits("1"), noRequirements(),
        [new LockArtifact("fast", "windows", "https://host/f.lib", digits("f"))])]);
    try testing.assertEqual(lockdiff.compare(before, after).summary(),
        "updated the prebuilt libraries acme.tools 1.0 binds");
}

test "the prebuilt libraries a member of the build binds are part of what the lock records" {
    LockArtifact[] none = [];
    let entry = recorded("acme.tools", "1.0", "c1", digits("1"), noRequirements());
    let bound = new LockMember("demo.first",
        [new LockArtifact("fast", "windows", "https://host/f.lib", digits("f"))]);
    let rebound = new LockMember("demo.first",
        [new LockArtifact("fast", "windows", "https://host/other.lib", digits("f"))]);
    let without = new Lockfile("", none, noMembers(), [entry]);
    let with = new Lockfile("", none, [bound], [entry]);
    let changed = new Lockfile("", none, [rebound], [entry]);

    try testing.assertEqual(lockdiff.compare(without, with).summary(),
        "recorded the prebuilt libraries demo.first binds");
    try testing.assertEqual(lockdiff.compare(with, without).summary(),
        "dropped the prebuilt libraries demo.first bound");
    try testing.assertEqual(lockdiff.compare(with, changed).summary(),
        "updated the prebuilt libraries demo.first binds");
    try testing.assertTrue(!lockdiff.compare(with, with).any());
}

test "the prebuilt libraries the build itself binds are part of what the lock records" {
    LockArtifact[] none = [];
    let entry = recorded("acme.tools", "1.0", "c1", digits("1"), noRequirements());
    let before = new Lockfile("demo.app", none, noMembers(), [entry]);
    let after = new Lockfile("demo.app",
        [new LockArtifact("zlib", "linux", "https://host/z.a", digits("z"))], noMembers(),
        [entry]);
    try testing.assertEqual(lockdiff.compare(before, after).summary(),
        "recorded the prebuilt libraries this build itself binds");
    try testing.assertEqual(lockdiff.compare(after, before).summary(),
        "dropped the prebuilt libraries this build itself bound");
}

test "a lock that was not there before locks everything the build resolved" {
    let after = lockOf([
        recorded("alex.json", "1.0", "c1", digits("1"), noRequirements()),
        recorded("beta.utils", "1.1", "c2", digits("2"), noRequirements()),
    ]);
    try testing.assertEqual(lockdiff.compare(lockfile.empty(), after).summary(),
        "locked alex.json 1.0, locked beta.utils 1.1");
}

test "a difference the comparison cannot name is still reported as one" {
    LockArtifact[] none = [];
    let entry = recorded("acme.tools", "1.0", "c1", digits("1"), noRequirements());
    let before = new Lockfile("demo.app", none, noMembers(), [entry]);
    let after = new Lockfile("demo.renamed", none, noMembers(), [entry]);
    try testing.assertTrue(!lockdiff.same(before, after));
    try testing.assertEqual(lockdiff.compare(before, after).summary(),
        "updated what the lock records");
}
