// SHA-256 against the digests NIST publishes in FIPS 180-4. A hash checked only against itself
// agrees with itself however wrong it is, so every expected digest here is a published one. The
// messages also cover both padding cases, at 56 bytes and across two blocks.
import @std.testing;
import Sha256 from sha256;
import sha256;

test "the empty message" {
    try testing.assertEqual(sha256.ofText(""),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
}

test "FIPS 180-4 example: 'abc'" {
    try testing.assertEqual(sha256.ofText("abc"),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

test "FIPS 180-4 example: a 448-bit message, one padding block short" {
    try testing.assertEqual(
        sha256.ofText("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
}

test "FIPS 180-4 example: an 896-bit message, spanning two blocks" {
    try testing.assertEqual(
        sha256.ofText("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn"
            + "hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
        "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1");
}

test "FIPS 180-4 example: one million 'a'" {
    byte[] many = new byte[1000000];
    for (long i = 0; i < many.length; i++) {
        many[i] = 'a';
    }
    try testing.assertEqual(sha256.ofBytes(many),
        "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
}

test "a message fed in two pieces hashes the same as one fed whole" {
    let pieces = new Sha256();
    pieces.update("abcdbcdecdefdefgefghfghighijhijk");
    pieces.update("ijkljklmklmnlmnomnopnopq");
    try testing.assertEqual(pieces.hex(),
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");

    let byteAtATime = new Sha256();
    for (let value in "abc".toBytes()) {
        byte[] one = [value];
        byteAtATime.update(one);
    }
    try testing.assertEqual(byteAtATime.hex(),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

// Where the pieces fall must not matter, and a message long enough to hold several blocks is split
// at every offset in it, so every arrangement of a partly filled block against a whole one is fed.
test "no split of a message changes its digest" {
    byte[] message = new byte[200];
    for (long i = 0; i < message.length; i++) {
        message[i] = (i * 7 + 3) as byte;
    }
    string whole = sha256.ofBytes(message);
    for (long cut = 0; cut <= message.length; cut++) {
        let split = new Sha256();
        split.update(message.slice(0, cut));
        split.update(message.slice(cut, message.length));
        try testing.assertTrue(split.hex() == whole, "the message split at {cut} hashed apart");
    }
}

test "asking for the answer leaves the digest able to answer again" {
    let digest = new Sha256();
    digest.update("abc");
    try testing.assertEqual(digest.hex(),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    try testing.assertEqual(digest.hex(),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    digest.update("");
    try testing.assertEqual(digest.hex(),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

test "a digest is 32 bytes and its hex is those bytes in order" {
    let digest = new Sha256();
    byte[] answer = digest.digest();
    try testing.assertEqual(answer.length, 32);
    try testing.assertEqual(sha256.hexOf(answer),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    byte[] edges = [0x00, 0x0f, 0x10, 0xa5, 0xff];
    try testing.assertEqual(sha256.hexOf(edges), "000f10a5ff");
}
