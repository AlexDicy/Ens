// What a version is worth, and what is not a version at all. The comparisons pinned here are the
// ones a build's choice between two requirements turns on: a numeral against a numeral rather than a
// digit against a digit, and a component nobody wrote counting as zero.
import @std.testing;
import Version from versions;
import versions;

// Below zero, zero or above zero as one word, so a comparison reads as what it decided.
compared(string left, string right) -> string {
    let first = versions.parse(left);
    let second = versions.parse(right);
    if (first == null || second == null) {
        return "unparsed";
    }
    long order = versions.compare(first, second);
    if (order < 0) {
        return "below";
    }
    if (order > 0) {
        return "above";
    }
    return "same";
}

test "a version reads as its numerals" {
    let parsed = versions.parse("1.12.30");
    try testing.assertTrue(parsed != null);
    if (parsed != null) {
        try testing.assertEqual(parsed.components().length, 3);
        try testing.assertEqual(parsed.components()[0], 1);
        try testing.assertEqual(parsed.components()[1], 12);
        try testing.assertEqual(parsed.components()[2], 30);
        try testing.assertEqual(parsed.written(), "1.12.30");
        try testing.assertEqual(parsed.major(), 1);
    }
}

test "a single component is a version" {
    let parsed = versions.parse("7");
    try testing.assertTrue(parsed != null);
    if (parsed != null) {
        try testing.assertEqual(parsed.components().length, 1);
        try testing.assertEqual(parsed.major(), 7);
    }
}

test "components compare as numbers, not as digits" {
    try testing.assertEqual(compared("1.10", "1.9"), "above");
    try testing.assertEqual(compared("1.9", "1.10"), "below");
    try testing.assertEqual(compared("2.0", "10.0"), "below");
    try testing.assertEqual(compared("0.100", "0.99"), "above");
}

test "a component nobody wrote counts as zero" {
    try testing.assertEqual(compared("2.0", "2.0.0"), "same");
    try testing.assertEqual(compared("2", "2.0.0.0"), "same");
    try testing.assertEqual(compared("2.0.1", "2.0"), "above");
    try testing.assertEqual(compared("2.0", "2.0.1"), "below");
}

test "leading zeros do not change what a component is worth" {
    try testing.assertEqual(compared("1.007", "1.7"), "same");
    try testing.assertEqual(compared("01.0", "1"), "same");
}

test "the higher of two versions is kept, and a tie keeps the one already held" {
    let low = versions.parse("1.2");
    let high = versions.parse("1.10");
    let same = versions.parse("1.2.0");
    try testing.assertTrue(low != null && high != null && same != null);
    if (low != null && high != null && same != null) {
        try testing.assertEqual(versions.higher(low, high).written(), "1.10");
        try testing.assertEqual(versions.higher(high, low).written(), "1.10");
        try testing.assertEqual(versions.higher(low, same).written(), "1.2");
    }
}

test "only the leading component decides whether two versions agree" {
    let first = versions.parse("1.0");
    let second = versions.parse("1.99.99");
    let third = versions.parse("2.0");
    let zero = versions.parse("0.9");
    try testing.assertTrue(first != null && second != null && third != null && zero != null);
    if (first != null && second != null && third != null && zero != null) {
        try testing.assertTrue(versions.sameMajor(first, second));
        try testing.assertTrue(!versions.sameMajor(second, third));
        try testing.assertTrue(!versions.sameMajor(zero, first));
    }
}

test "anything that is not dotted numerals is no version" {
    try testing.assertTrue(versions.parse("") == null);
    try testing.assertTrue(versions.parse("1.") == null);
    try testing.assertTrue(versions.parse(".1") == null);
    try testing.assertTrue(versions.parse("1..2") == null);
    try testing.assertTrue(versions.parse("1.2.3-beta") == null);
    try testing.assertTrue(versions.parse("-1") == null);
    try testing.assertTrue(versions.parse("+1") == null);
    try testing.assertTrue(versions.parse(" 1.0") == null);
    try testing.assertTrue(versions.parse("1.0 ") == null);
    try testing.assertTrue(versions.parse("v1.0") == null);
    try testing.assertTrue(versions.parse("1,0") == null);
}
