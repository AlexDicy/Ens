// The lock file, whose one hard promise is that it reads back as what was written. Nothing else can
// be relied on if that does not hold: a build compares a lock against what it resolved, so a lock
// that came back different from how it went in would make every build rewrite it.
import @std.testing;
import TestFailure from @std.testing;
import @std.path;
import Lockfile from lockfile;
import LockPackage from lockfile;
import LockRequirement from lockfile;
import LockArtifact from lockfile;
import LockMember from lockfile;
import lockfile;
import support;

test "a lock recording nothing is still a lock, and reads back as one" {
    string text = lockfile.render(lockfile.empty());
    try testing.assertEqual(text, "lock 1\n");
    let reading = lockfile.parse("ens.lock", text);
    try testing.assertEqual(reading.failure(), "");
    try testing.assertTrue(reading.found(), "the text was there to read");
    try testing.assertEqual(reading.lock().packages().length, 0);
    try testing.assertEqual(reading.lock().rootName(), "");
    try testing.assertEqual(lockfile.render(reading.lock()), text);
}

test "everything a lock records survives being written and read back" {
    string written = lockfile.render(sample());
    try testing.assertEqual(written,
        "lock 1\n"
        + "root demo.app\n"
        + "artifact zlib windows https://example.com/z.lib sha256:" + digits("a") + "\n"
        + "package acme.json 1.4\n"
        + "source https://example.com/json.git 1111111111111111111111111111111111111111\n"
        + "content sha256:" + digits("b") + "\n"
        + "require acme.text 2.0\n"
        + "artifact fastpath linux https://example.com/fast.a sha256:" + digits("c") + "\n"
        + "artifact fastpath windows https://example.com/fast.lib sha256:" + digits("d") + "\n"
        + "package acme.text 2.1\n"
        + "source https://example.com/text.git 2222222222222222222222222222222222222222\n"
        + "content sha256:" + digits("e") + "\n");

    let reading = lockfile.parse("ens.lock", written);
    try testing.assertEqual(reading.failure(), "");
    try testing.assertEqual(lockfile.render(reading.lock()), written);

    let json = try recorded(reading.lock(), "acme.json");
    try testing.assertEqual(json.version(), "1.4");
    try testing.assertEqual(json.url(), "https://example.com/json.git");
    try testing.assertEqual(json.commit(), "1111111111111111111111111111111111111111");
    try testing.assertEqual(json.content(), "sha256:" + digits("b"));
    try testing.assertEqual(json.requirements().length, 1);
    try testing.assertEqual(json.requirements()[0].packageName(), "acme.text");
    try testing.assertEqual(json.requirements()[0].version(), "2.0");
    try testing.assertEqual(json.artifacts().length, 2);
    try testing.assertEqual(json.artifacts()[0].library(), "fastpath");
    try testing.assertEqual(json.artifacts()[0].platform(), "linux");
    try testing.assertEqual(reading.lock().rootArtifacts().length, 1);
    try testing.assertEqual(reading.lock().rootArtifacts()[0].url(),
        "https://example.com/z.lib");
    try testing.assertTrue(reading.lock().find("acme.none") == null,
        "the lock found a package it never recorded");
}

// A build resolves in whatever order it reached things; the file it writes must not show that, or a
// lock under version control would churn on every build.
test "the order a lock was built in does not reach the file" {
    LockRequirement[] none = [];
    LockArtifact[] noArtifacts = [];
    let text = new LockPackage("acme.text", "2.1", "https://example.com/text.git",
        "2222222222222222222222222222222222222222", "sha256:" + digits("e"), none, noArtifacts);
    let json = new LockPackage("acme.json", "1.4", "https://example.com/json.git",
        "1111111111111111111111111111111111111111", "sha256:" + digits("b"),
        [new LockRequirement("acme.text", "2.0"), new LockRequirement("acme.bits", "1.0")],
        noArtifacts);

    let first = new LockMember("demo.first",
        [new LockArtifact("fast", "windows", "https://example.com/f.lib", "sha256:" + digits("f"))]);
    let second = new LockMember("demo.second", noArtifacts);
    let oneWay = new Lockfile("demo.app", noArtifacts, [first, second], [json, text]);
    let another = new Lockfile("demo.app", noArtifacts, [second, first], [text, json]);
    try testing.assertEqual(lockfile.render(oneWay), lockfile.render(another));

    // Requirements settle too, whichever order the resolution reached them in.
    try assertMentions(lockfile.render(oneWay), "require acme.bits 1.0\nrequire acme.text 2.0\n");
}

test "a lock file that is not one is refused, saying what to do about it" {
    try assertRefused("", "records nothing at all");
    try assertRefused("\n\n", "records nothing at all");
    try assertRefused("lock 2\n", "its first line should be 'lock 1'");
    try assertRefused("package acme.json 1.0\n", "its first line should be 'lock 1'");
    try assertRefused("lock 1\nfrobnicate acme.json\n",
        "at line 2: 'frobnicate acme.json'");
    try assertRefused("lock 1\npackage acme.json\n", "at line 2: 'package acme.json'");
    try assertRefused("lock 1\ncontent sha256:abc\n", "at line 2: 'content sha256:abc'");
    try assertRefused("lock 1\nroot demo.app\nsource a b\n", "at line 3: 'source a b'");

    // Every one of them says the same thing about what a lock file is.
    let reading = lockfile.parse("/w/ens.lock", "lock 2\n");
    try assertMentions(reading.failure(), "'/w/ens.lock'");
    try assertMentions(reading.failure(), "never edited by hand");
    try assertMentions(reading.failure(), "delete it and build again");
    try testing.assertTrue(reading.found(), "a file that was there read as absent");
    try testing.assertEqual(reading.lock().packages().length, 0);
}

// The root's own artifacts belong to no fetched package, so they are recorded under the root and
// come back there.
test "an artifact before any package belongs to the root, and after one belongs to it" {
    let reading = lockfile.parse("ens.lock", "lock 1\n"
        + "root demo.app\n"
        + "artifact zlib windows https://example.com/z.lib sha256:" + digits("a") + "\n"
        + "package acme.json 1.4\n"
        + "source u c\n"
        + "content sha256:" + digits("b") + "\n"
        + "artifact fastpath linux https://example.com/fast.a sha256:" + digits("c") + "\n");
    try testing.assertEqual(reading.failure(), "");
    try testing.assertEqual(reading.lock().rootArtifacts().length, 1);
    try testing.assertEqual(reading.lock().rootArtifacts()[0].library(), "zlib");
    let json = try recorded(reading.lock(), "acme.json");
    try testing.assertEqual(json.artifacts().length, 1);
    try testing.assertEqual(json.artifacts()[0].library(), "fastpath");
}

// A workspace declares no package, so there is no root section for its members' bindings; each one
// is recorded under its own name instead.
test "a member's prebuilt libraries survive being written and read back" {
    LockRequirement[] none = [];
    LockArtifact[] noArtifacts = [];
    let dep = new LockPackage("art.dep", "1.0", "https://example.com/dep.git",
        "3333333333333333333333333333333333333333", "sha256:" + digits("f"), none, noArtifacts);
    let workspace = new Lockfile("", noArtifacts,
        [new LockMember("demo.second",
            [new LockArtifact("other", "linux", "https://example.com/o.a",
                "sha256:" + digits("2"))]),
         new LockMember("demo.first",
            [new LockArtifact("extras", "windows", "https://example.com/e.lib",
                 "sha256:" + digits("1")),
             new LockArtifact("extras", "linux", "https://example.com/e.a",
                 "sha256:" + digits("0"))])],
        [dep]);

    string written = lockfile.render(workspace);
    try testing.assertEqual(written,
        "lock 1\n"
        + "member demo.first\n"
        + "artifact extras linux https://example.com/e.a sha256:" + digits("0") + "\n"
        + "artifact extras windows https://example.com/e.lib sha256:" + digits("1") + "\n"
        + "member demo.second\n"
        + "artifact other linux https://example.com/o.a sha256:" + digits("2") + "\n"
        + "package art.dep 1.0\n"
        + "source https://example.com/dep.git "
        + "3333333333333333333333333333333333333333\n"
        + "content sha256:" + digits("f") + "\n");

    let reading = lockfile.parse("ens.lock", written);
    try testing.assertEqual(reading.failure(), "");
    try testing.assertEqual(lockfile.render(reading.lock()), written);
    try testing.assertEqual(reading.lock().members().length, 2);
    let recordedFirst = reading.lock().findMember("demo.first");
    try testing.assertTrue(recordedFirst != null, "the lock records no member 'demo.first'");
    if (recordedFirst != null) {
        try testing.assertEqual(recordedFirst.artifacts().length, 2);
        try testing.assertEqual(recordedFirst.artifacts()[0].platform(), "linux");
    }
    try testing.assertTrue(reading.lock().findMember("demo.absent") == null,
        "the lock found a member it never recorded");
    // A member holds no source, so nothing a package's block carries may attach to one.
    try assertRefused("lock 1\nmember demo.first\nsource u c\n", "at line 3: 'source u c'");
    try assertRefused("lock 1\nmember demo.first demo.second\n",
        "at line 2: 'member demo.first demo.second'");
}

// What a build has to keep a lock for: anything it brought in from outside the checkout. A prebuilt
// binary counts on its own, because reading the repository tells nobody what is inside it.
test "a lock records something as soon as a build fetches anything" {
    LockRequirement[] noRequirements = [];
    LockArtifact[] noArtifacts = [];
    LockMember[] noMembers = [];
    LockPackage[] noPackages = [];
    let bound = new LockArtifact("extras", "windows", "https://example.com/e.lib",
        "sha256:" + digits("1"));

    try testing.assertFalse(lockfile.empty().recordsAnything(),
        "an empty lock recorded something");
    try testing.assertFalse(new Lockfile("demo.app", noArtifacts, noMembers,
        noPackages).recordsAnything(), "a build that fetches nothing recorded something");
    try testing.assertTrue(new Lockfile("demo.app", [bound], noMembers,
        noPackages).recordsAnything(), "a prebuilt library the build binds recorded nothing");
    try testing.assertTrue(new Lockfile("", noArtifacts,
        [new LockMember("demo.first", [bound])], noPackages).recordsAnything(),
        "a prebuilt library a member binds recorded nothing");
    try testing.assertTrue(new Lockfile("", noArtifacts, noMembers,
        [new LockPackage("acme.json", "1.0", "u", "c", "sha256:" + digits("b"), noRequirements,
            noArtifacts)]).recordsAnything(), "a fetched package recorded nothing");
}

test "a tree with no lock file reads as an empty lock that was not there" {
    string root = try support.scratch("lock-absent");
    let reading = lockfile.read(root);
    try testing.assertFalse(reading.found(), "a lock file was found where none was written");
    try testing.assertEqual(reading.failure(), "");
    try testing.assertEqual(reading.lock().packages().length, 0);
    try support.removeTree(root);
}

test "a lock goes to the file beside the manifest and comes back the same" {
    string root = try support.scratch("lock-write");
    try testing.assertEqual(lockfile.filePath(root), path.join(root, "ens.lock"));
    try lockfile.write(root, sample());

    let reading = lockfile.read(root);
    try testing.assertTrue(reading.found(), "the lock file was not found");
    try testing.assertEqual(reading.failure(), "");
    try testing.assertEqual(lockfile.render(reading.lock()), lockfile.render(sample()));

    // Writing again over a lock that is already there leaves the same file.
    try lockfile.write(root, reading.lock());
    try testing.assertEqual(lockfile.render(lockfile.read(root).lock()),
        lockfile.render(sample()));
    try support.removeTree(root);
}

sample() -> Lockfile {
    LockRequirement[] none = [];
    LockArtifact[] noArtifacts = [];
    let json = new LockPackage("acme.json", "1.4", "https://example.com/json.git",
        "1111111111111111111111111111111111111111", "sha256:" + digits("b"),
        [new LockRequirement("acme.text", "2.0")],
        [new LockArtifact("fastpath", "windows", "https://example.com/fast.lib",
             "sha256:" + digits("d")),
         new LockArtifact("fastpath", "linux", "https://example.com/fast.a",
             "sha256:" + digits("c"))]);
    let text = new LockPackage("acme.text", "2.1", "https://example.com/text.git",
        "2222222222222222222222222222222222222222", "sha256:" + digits("e"), none, noArtifacts);
    LockMember[] noMembers = [];
    return new Lockfile("demo.app",
        [new LockArtifact("zlib", "windows", "https://example.com/z.lib",
            "sha256:" + digits("a"))],
        noMembers, [json, text]);
}

// A digest's 64 hex digits, all the same one, so a test reads as what it is checking rather than as
// a wall of hex.
digits(string digit) -> string {
    string text = "";
    for (long i = 0; i < 64; i++) {
        text = text + digit;
    }
    return text;
}

// The package the lock records under that name, failing the test when it records none.
recorded(Lockfile lock, string name) -> LockPackage throws {
    let locked = lock.find(name);
    if (locked == null) {
        throw new TestFailure("the lock records no package named '{name}'");
    }
    return locked;
}

assertRefused(string text, string fragment) throws {
    let reading = lockfile.parse("ens.lock", text);
    try testing.assertTrue(reading.failure().length > 0,
        "this was accepted as a lock file: '{text}'");
    try assertMentions(reading.failure(), fragment);
}

assertMentions(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}
