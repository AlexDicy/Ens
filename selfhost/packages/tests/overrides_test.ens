// Editing ens.overrides. Every test here checks the whole file it came out with, byte for byte,
// because the promise is not that the right declaration changed but that nothing else did: the
// comments, the blank lines, the order and the spacing a person put there all come back untouched.
import @std.testing;
import @std.path;
import @std.system;
import SystemFileLoader from @ens.sema.support.loader;
import OverrideEntry from @ens.sema.program.workspace;
import overrides;
import support;

test "an override goes into a file that has none, written the way a person would write it" {
    let absent = overrides.of("/w/ens.overrides", "");
    try testing.assertTrue(absent.saysNothing(), "an empty file says nothing");
    try testing.assertEqual(absent.withOverride("acme.json", "../json"),
        "overrides " + Brace.open + "\n    override acme.json \"../json\";\n" + Brace.close + "\n");

    let blank = overrides.of("/w/ens.overrides", "\n   \t\n");
    try testing.assertTrue(blank.saysNothing(), "a file of whitespace says nothing");
    try testing.assertEqual(blank.withOverride("acme.json", "../json"),
        "overrides " + Brace.open + "\n    override acme.json \"../json\";\n" + Brace.close + "\n");
}

test "an override added to a file joins the others and touches nothing else" {
    string before = "// where my checkouts are\noverrides " + Brace.open + "\n"
        + "    override beta.tools \"../tools\";   // still in progress\n"
        + "\n"
        + "    override gamma.text \"/opt/text\";\n"
        + Brace.close + "\n";
    string after = "// where my checkouts are\noverrides " + Brace.open + "\n"
        + "    override beta.tools \"../tools\";   // still in progress\n"
        + "\n"
        + "    override gamma.text \"/opt/text\";\n"
        + "    override acme.json \"../json\";\n"
        + Brace.close + "\n";
    try testing.assertEqual(overrides.of("/w/ens.overrides", before)
        .withOverride("acme.json", "../json"), after);
}

test "an override already there is replaced where it stands" {
    string before = "overrides " + Brace.open + "\n"
        + "    override acme.json \"../wrong\";  // was pointing at the old checkout\n"
        + "    override beta.tools \"../tools\";\n"
        + Brace.close + "\n";
    string after = "overrides " + Brace.open + "\n"
        + "    override acme.json \"../json\";  // was pointing at the old checkout\n"
        + "    override beta.tools \"../tools\";\n"
        + Brace.close + "\n";
    try testing.assertEqual(overrides.of("/w/ens.overrides", before)
        .withOverride("acme.json", "../json"), after);
}

// A block written on one line has no line of its own for a declaration to go on, so the line is
// broken in front of the brace rather than the declaration being crammed onto it.
test "a block written on one line gains a line for the declaration" {
    string before = "overrides " + Brace.open + " override beta.tools \"../tools\"; "
        + Brace.close + "\n";
    string after = "overrides " + Brace.open + " override beta.tools \"../tools\"; \n"
        + "    override acme.json \"../json\";\n" + Brace.close + "\n";
    try testing.assertEqual(overrides.of("/w/ens.overrides", before)
        .withOverride("acme.json", "../json"), after);

    let empty = overrides.of("/w/ens.overrides", "overrides " + Brace.open + Brace.close + "\n");
    try testing.assertEqual(empty.withOverride("acme.json", "../json"),
        "overrides " + Brace.open + "\n    override acme.json \"../json\";\n" + Brace.close + "\n");
}

test "removing an override takes its lines with it and leaves the rest alone" {
    string before = "// where my checkouts are\noverrides " + Brace.open + "\n"
        + "    override acme.json \"../json\";\n"
        + "\n"
        + "    override beta.tools \"../tools\";  // still in progress\n"
        + Brace.close + "\n";
    try testing.assertEqual(overrides.of("/w/ens.overrides", before)
        .withoutOverride("acme.json"),
        "// where my checkouts are\noverrides " + Brace.open + "\n"
        + "\n"
        + "    override beta.tools \"../tools\";  // still in progress\n"
        + Brace.close + "\n");

    // The last override leaves an empty block behind, not a file with a hole in it.
    try testing.assertEqual(overrides.of("/w/ens.overrides",
        "overrides " + Brace.open + "\n    override acme.json \"../json\";\n" + Brace.close + "\n")
        .withoutOverride("acme.json"), "overrides " + Brace.open + "\n" + Brace.close + "\n");
}

// A declaration sharing its line with something else cannot take the line, so only its own bytes go.
test "removing an override that shares its line takes only its own bytes" {
    string before = "overrides " + Brace.open + " override acme.json \"../json\"; "
        + "override beta.tools \"../tools\"; " + Brace.close + "\n";
    try testing.assertEqual(overrides.of("/w/ens.overrides", before)
        .withoutOverride("acme.json"),
        "overrides " + Brace.open + "  override beta.tools \"../tools\"; " + Brace.close + "\n");
}

test "a package that is not overridden leaves the file as it was" {
    string before = "overrides " + Brace.open + "\n    override acme.json \"../json\";\n"
        + Brace.close + "\n";
    let file = overrides.of("/w/ens.overrides", before);
    try testing.assertEqual(file.withoutOverride("nothing.here"), before);
    try testing.assertTrue(file.survey().find("nothing.here") == null,
        "the file declares a package it never mentions");
}

test "what the file declares comes back with where each declaration sits" {
    string text = "overrides " + Brace.open + "\n    override acme.json \"../json\";\n"
        + Brace.close + "\n";
    let file = overrides.of("/w/ens.overrides", text);
    try testing.assertEqual(file.path(), "/w/ens.overrides");
    try testing.assertEqual(file.text(), text);
    OverrideEntry[] declared = file.survey().overrides();
    try testing.assertEqual(declared.length, 1);
    try testing.assertEqual(declared[0].packageName(), "acme.json");
    try testing.assertEqual(declared[0].folder(), "../json");
    try testing.assertEqual(text.substring(declared[0].start(), declared[0].end()),
        "override acme.json \"../json\";");
}

test "a file that is not an overrides file is not edited" {
    let manifest = overrides.of("/w/ens.overrides", "package acme.json \{\n    ens \"0.1\";\n\}\n");
    try assertMentions(manifest.editingProblem(), "does not hold an overrides declaration");
    try assertMentions(manifest.editingProblem(), "declared in ens.package");

    let broken = overrides.of("/w/ens.overrides", "overrides " + Brace.open
        + "\n    override acme.json ../json;\n" + Brace.close + "\n");
    try assertMentions(broken.editingProblem(), "cannot be read");
    try assertMentions(broken.editingProblem(), "Fix the file by hand");

    let usable = overrides.of("/w/ens.overrides", "overrides " + Brace.open + Brace.close + "\n");
    try testing.assertEqual(usable.editingProblem(), "");
}

// The manifest grammar decides what a package name is, so this can never come to disagree with what
// a manifest would accept.
test "a package name is what a manifest would accept as one" {
    for (let name in ["acme.json", "acme", "a.b.c.d", "acme.json2"]) {
        try testing.assertTrue(overrides.isPackageName(name), "'{name}' is a package name");
    }
    for (let name in ["", "not/a/name!", "acme json", "acme.", ".acme", "acme..json", "\"x\"",
            "acme.json;", "2acme"]) {
        try testing.assertFalse(overrides.isPackageName(name), "'{name}' is not a package name");
    }
}

test "a folder is written down relative to the workspace it is overridden in" {
    try testing.assertEqual(overrides.relativeTo("/w/json", "/w/app"), "../json");
    try testing.assertEqual(overrides.relativeTo("/w/app/json", "/w/app"), "json");
    try testing.assertEqual(overrides.relativeTo("/w/app", "/w/app"), ".");
    try testing.assertEqual(overrides.relativeTo("/a/b/c/json", "/a/x/y"), "../../b/c/json");
    try testing.assertEqual(overrides.relativeTo("C:/w/json", "C:/w/app"), "../json");

    // Nothing in common means no relative path leads there, so the path stands as it is.
    try testing.assertEqual(overrides.relativeTo("D:/other", "C:/w/app"), "D:/other");
}

test "a folder in the file is read against the folder the file sits in" {
    try testing.assertEqual(overrides.resolved("/w", "../json"), "/json");
    try testing.assertEqual(overrides.resolved("/w", "sub/json"), "/w/sub/json");
    try testing.assertEqual(overrides.resolved("/w", "/opt/json"), "/opt/json");
}

test "a folder is usable only when its manifest declares exactly the overridden package" {
    string root = try support.scratch("override-target");
    let loader = new SystemFileLoader();
    try support.writeFile(root, "json/ens.package", "package acme.json \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "wrong/ens.package",
        "package acme.other \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "space/ens.package", "workspace \{\n    member \"json\";\n\}\n");
    try system.createDirectory(path.join(root, "nothing"));

    try testing.assertEqual(overrides.targetProblem(loader, root, "acme.json", "json"), "");
    try assertMentions(overrides.targetProblem(loader, root, "acme.json", "wrong"),
        "declares package 'acme.other' instead");
    try assertMentions(overrides.targetProblem(loader, root, "acme.json", "space"),
        "declares no package");
    try assertMentions(overrides.targetProblem(loader, root, "acme.json", "nothing"),
        "there is no ens.package manifest at");
    try assertMentions(overrides.targetProblem(loader, root, "acme.json", "gone"),
        "there is no ens.package manifest at");
    try support.removeTree(root);
}

test "the file lives beside the manifest, and one that is not there says nothing" {
    string root = try support.scratch("override-file");
    try testing.assertEqual(overrides.filePath(root), path.join(root, "ens.overrides"));

    let missing = try overrides.read(root);
    try testing.assertFalse(missing.found(), "a file was found where none was written");
    try testing.assertTrue(missing.saysNothing(), "a file that is not there says nothing");
    try testing.assertEqual(missing.editingProblem(), "");

    try overrides.write(missing.path(), missing.withOverride("acme.json", "../json"));
    let written = try overrides.read(root);
    try testing.assertTrue(written.found(), "the file was not written");
    try testing.assertEqual(written.text(),
        "overrides " + Brace.open + "\n    override acme.json \"../json\";\n" + Brace.close + "\n");
    try testing.assertEqual(written.survey().overrides().length, 1);
    try support.removeTree(root);
}

// A brace inside a string here would open an interpolation, so both are spelled out once.
final class Brace {
    protected static const string open = "\{";
    protected static const string close = "\}";
}

assertMentions(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}
