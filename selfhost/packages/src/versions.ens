// What a version is worth when two requirements on one package disagree. A version is dotted
// numerals and the numerals decide it, component by component: "1.10" is above "1.9", and a
// component nobody wrote counts as zero, so "2.0" and "2.0.0" are one version written two ways.
//
// This is resolution's rule, not the manifest grammar's, which is why it lives here. The grammar
// beside the manifest decides what a version may be spelled like; a build's choice between two
// spellings is only ever made while resolving what to fetch, and nothing else in the language reads
// a version's value at all.
import @std.text.strings;
import List from @std.collections.list;

export final class Version {
    long[] parts;
    string text;

    protected constructor(this.parts, this.text);

    // The numerals, in the order they were written.
    export components() -> long[] {
        return this.parts;
    }

    // The version as its manifest spelled it, which is what a message and a lock line both show.
    export written() -> string {
        return this.text;
    }

    // The leading component, which is the one that has to agree: a change to it says the package
    // is no longer used the same way.
    export major() -> long {
        if (this.parts.length == 0) {
            return 0;
        }
        return this.parts[0];
    }
}

// The version the text spells, or null when it spells anything else. A version is one or more
// components separated by '.', each one at least one digit and nothing but digits, so a sign, a
// letter, an empty component and surrounding space all read as no version at all.
export parse(string text) -> Version? {
    if (text.length == 0) {
        return null;
    }
    let parts = new List<long>();
    for (let component in strings.split(text, ".")) {
        if (!allDigits(component)) {
            return null;
        }
        long? value = strings.parseInteger(component);
        if (value == null) {
            return null;
        }
        parts.push(value);
    }
    return new Version(parts.toArray(), text);
}

// Below zero when the left version is the lower one, above zero when it is the higher one, and zero
// when the two are the same version. Components missing from either side count as zero, so a
// comparison never depends on how many of them were written.
export compare(Version left, Version right) -> long {
    long[] first = left.components();
    long[] second = right.components();
    long count = first.length;
    if (second.length > count) {
        count = second.length;
    }
    for (long i = 0; i < count; i++) {
        long a = componentAt(first, i);
        long b = componentAt(second, i);
        if (a != b) {
            if (a < b) {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

// Whether two versions of one package can stand for each other in a build.
export sameMajor(Version left, Version right) -> bool {
    return left.major() == right.major();
}

// The higher of the two, and the left one when they are the same version, so the version a build
// keeps is the one it already had.
export higher(Version left, Version right) -> Version {
    if (compare(right, left) > 0) {
        return right;
    }
    return left;
}

componentAt(long[] parts, long index) -> long {
    if (index < parts.length) {
        return parts[index];
    }
    return 0;
}

allDigits(string text) -> bool {
    byte[] bytes = text.toBytes();
    if (bytes.length == 0) {
        return false;
    }
    for (long i = 0; i < bytes.length; i++) {
        if (bytes[i] < '0' || bytes[i] > '9') {
            return false;
        }
    }
    return true;
}
