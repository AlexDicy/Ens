// The prebuilt native libraries a package binds instead of naming a library for the linker to find,
// one file per platform and downloaded once into the cache. The hash is checked before the file is
// kept rather than after, so a download that does not match never reaches the cache at all.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import ContentStore from store;
import Progress from progress;
import hashing;
import @ens.host.scratch;
import tools;

// One artifact the link needs: where its file is, or why there is none.
export final class FetchedArtifact {
    Path libraryFile;
    string problem;

    protected constructor(this.libraryFile, this.problem);

    export file() -> Path {
        return this.libraryFile;
    }

    export failure() -> string {
        return this.problem;
    }

    export succeeded() -> bool {
        return this.problem.length == 0;
    }
}

// The file the binding names, downloading it when the cache does not hold it yet. `library` is the
// native library the binding belongs to, which is what a reader of a problem recognizes.
export fetch(ContentStore store, string library, string url, string checksum, bool offline,
             Progress progress) -> FetchedArtifact {
    string digest = hashing.canonical(checksum);
    string name = fileNameOf(url);
    Path stored = store.artifactFile(digest, name);
    if (stored.isFile()) {
        return new FetchedArtifact(stored, "");
    }
    if (offline) {
        return refused("the prebuilt library for native '{library}' is not in the cache, and "
            + "'--offline' does not allow downloading it from '{url}'. Run the command once "
            + "without '--offline'");
    }

    let staging = store.stage("download");
    if (staging.failure().length > 0) {
        return refused("the prebuilt library for native '{library}' could not be downloaded: "
            + staging.failure());
    }
    let outcome = downloaded(store, staging.folder(), library, url, digest, name, progress);
    string leftBehind = scratch.discard(staging.folder());
    if (outcome.succeeded() || leftBehind.length == 0) {
        return outcome;
    }
    return refused(outcome.failure() + "\n" + leftBehind);
}

downloaded(ContentStore store, Path staging, string library, string url, string digest,
           string name, Progress progress) -> FetchedArtifact {
    Path target = staging.join(name);
    progress.step("Downloading the prebuilt '{library}' library from '{url}'");
    let download = tools.read("curl", curlArguments(url, target), noOverrides());
    if (!download.started()) {
        return refused("downloading the prebuilt library for native '{library}' needs 'curl', "
            + "which could not be started. Install curl and add its folder to 'PATH'");
    }
    if (!download.succeeded()) {
        string output = download.report();
        string report = "";
        if (output.length > 0) {
            report = ": " + output;
        }
        return refused("the prebuilt library for native '{library}' could not be downloaded from "
            + "'{url}'" + report);
    }

    string found = try hashing.ofFile(target);
    if (found != digest) {
        return refused("the file downloaded from '{url}' for native '{library}' has the hash "
            + "'{found}', but the manifest declares '{digest}', so it is not the file the "
            + "manifest names. If the library changed on purpose, write the new hash in the "
            + "manifest");
    }
    let published = try store.publishArtifact(target, digest, name);
    return new FetchedArtifact(published.path(), "");
} catch (FileSystemError stopped) {
    return refused("the prebuilt library for native '{library}' was downloaded but could not be "
        + "stored in the cache: " + stopped.message);
}

// How the download is requested: fail on an error status rather than saving the error page, follow
// where the server points, print nothing but what went wrong, and stop rather than wait forever.
export curlArguments(string url, Path target) -> string[] {
    return ["--fail", "--location", "--silent", "--show-error", "--connect-timeout", "30",
        "--max-time", "600", "--output", target.toString(), "--url", url];
}

// The name the artifact keeps in the cache: the last part of the URL's path, with anything a server
// reads after it left off, so a link line names the library it is rather than a digest.
export fileNameOf(string url) -> string {
    string trimmed = url;
    long marker = firstOf(trimmed, "?#");
    if (marker >= 0) {
        trimmed = trimmed.substring(0, marker);
    }
    while (trimmed.endsWith("/")) {
        trimmed = trimmed.substring(0, trimmed.length - 1);
    }
    string[] parts = trimmed.split("/");
    string name = parts[parts.length - 1];
    if (name.length == 0) {
        return "artifact";
    }
    return name;
}

// The index of the first of the given characters, or -1 when the text holds none of them.
firstOf(string text, string characters) -> long {
    long found = -1;
    for (let character in characters.chars()) {
        long at = text.indexOf(character.toString());
        if (at >= 0 && (found < 0 || at < found)) {
            found = at;
        }
    }
    return found;
}

noOverrides() -> string[] {
    string[] none = [];
    return none;
}

refused(string problem) -> FetchedArtifact {
    return new FetchedArtifact(Path(""), problem);
}
