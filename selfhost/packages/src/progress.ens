// Where this package prints its progress. A program it runs writes as it runs,
// and a line held back until that program finishes is no longer progress, so those lines go out
// through this and the package itself never writes anywhere.
export interface Progress {
    // A step this package took, which only a verbose run prints.
    step(string line);

    // A line another program wrote, passed on as it arrives.
    relayed(string line);
}
