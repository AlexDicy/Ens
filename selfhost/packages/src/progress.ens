// Where this package says what it is doing while it does it.
//
// Everything here that answers a question answers it with a value, so nothing needs a stream to
// report a result. What needs one is the part that has no result yet: a program this package runs
// writes as it goes, and a line held back until that program finishes is no longer progress. Those
// lines go out through this, so the package that owns the command's streams decides what reaches
// them and this one never writes anywhere itself.
//
// It is stated here rather than borrowed from the command layer because it is this package's need,
// and stating it means a run that wants the lines counted instead of printed just says so.
export interface Progress {
    // A step this package took, which only a run that asked to be told wants.
    step(string line);

    // A line another program wrote, passed on as it arrives.
    relayed(string line);
}
