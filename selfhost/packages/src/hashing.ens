// What a fetched thing's digest is, written everywhere as "sha256:" and 64 lowercase hex digits. A
// tree's digest covers every path under it and every byte of every file, each contributing its
// path, its length, then its bytes, with the length there so two trees cannot feed the same bytes.
import @std.system;
import @std.path;
import List from @std.collections.list;
import StringBuilder from @std.text.stringbuilder;
import Sha256 from sha256;

export ofFile(string file) -> string throws {
    let digest = new Sha256();
    digest.update(try system.readAllBytes(file));
    return written(digest);
}

// The digest of every file under the folder, read in one settled order so the answer does not depend
// on how a file system happens to enumerate a folder.
export ofTree(string folder) -> string throws {
    let digest = new Sha256();
    for (let relative in try filesUnder(folder)) {
        byte[] content = try system.readAllBytes(path.join(folder, relative));
        digest.update(relative);
        digest.update(separator());
        digest.update("{content.length}");
        digest.update(separator());
        digest.update(content);
    }
    return written(digest);
}

// Every file under the folder, as paths relative to it written with '/', in ascending order by their
// bytes. A '.git' folder is left out of the walk: it holds one clone's own bookkeeping, which two
// clones of the same commit do not agree on.
export filesUnder(string folder) -> string[] throws {
    let found = new List<string>();
    try gather(folder, "", found);
    found.sort((a, b) -> a.compareTo(b));
    return found.toArray();
}

// The 64 hex digits of a digest, written with or without its "sha256:" in front, which is the part a
// cache builds a folder name out of.
export digits(string digest) -> string {
    string marker = "sha256:";
    if (digest.startsWith(marker)) {
        return digest.substring(marker.length, digest.length);
    }
    return digest;
}

// A digest in the one form Ens writes one in, whichever case a manifest spelled its hex digits in:
// two digests that name the same bytes then read the same, in a cache's folder names, in a lock file,
// and in a message telling somebody the two do not match.
export canonical(string digest) -> string {
    let out = new StringBuilder();
    out.append("sha256:");
    for (let value in digits(digest).toBytes()) {
        if (value >= 'A' && value <= 'F') {
            out.appendByte((value + ('a' - 'A')) as byte);
        } else {
            out.appendByte(value);
        }
    }
    return out.toString();
}

gather(string folder, string prefix, List<string> found) throws {
    for (let entry in try system.listDirectory(folder)) {
        string child = path.join(folder, entry);
        string relative = entry;
        if (prefix.length > 0) {
            relative = prefix + "/" + entry;
        }
        if (system.isDirectory(child)) {
            if (entry == ".git") {
                continue;
            }
            try gather(child, relative, found);
            continue;
        }
        found.push(relative);
    }
}

written(Sha256 digest) -> string {
    return "sha256:" + digest.hex();
}

separator() -> byte[] {
    return [0];
}
