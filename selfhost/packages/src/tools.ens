// Running the programs a build needs in order to fetch what it depends on. Only two kinds of program
// are ever run this way, and the difference between them decides what happens to the output: a
// command asked a question is read, and a command that is doing something slow is passed on as it
// speaks, because a line held back until the command finishes is no longer an account of what it is
// doing.
//
// A run answers with a value and writes nowhere itself, so two of them could go on at once.
import @std.system;
import SystemError from @std.system;
import ChildProcess from @std.system;
import List from @std.collections.list;
import Progress from progress;

// What running one program came to.
export final class ToolRun {
    bool ran;
    int code;
    string[] outputLines;
    string problem;

    protected constructor(this.ran, this.code, this.outputLines, this.problem);

    // Whether the program ran at all. A program that could not be started said nothing, which is a
    // different thing from a program that ran and refused.
    export started() -> bool {
        return this.ran;
    }

    export exitCode() -> int {
        return this.code;
    }

    export succeeded() -> bool {
        return this.ran && this.code == 0;
    }

    // Everything the program wrote, in the order it wrote it, both streams together.
    export lines() -> string[] {
        return this.outputLines;
    }

    // Why the program could not be run, or "" when it ran.
    export failure() -> string {
        return this.problem;
    }

    // The last thing the program said, which is the part of its account worth repeating when a
    // command that failed has to be explained. Empty when it said nothing.
    export said() -> string {
        for (long i = this.outputLines.length - 1; i >= 0; i--) {
            string line = this.outputLines[i].trim();
            if (line.length > 0) {
                return line;
            }
        }
        return "";
    }
}

// Runs the program and keeps everything it wrote, showing none of it: this is for a command whose
// output is the answer to a question rather than an account of itself.
export read(string program, string[] arguments, string[] environmentOverrides) -> ToolRun {
    return ranWith(program, arguments, environmentOverrides, null);
}

// The same, with every line passed on the moment it arrives.
export relay(string program, string[] arguments, string[] environmentOverrides,
             Progress progress) -> ToolRun {
    return ranWith(program, arguments, environmentOverrides, progress);
}

ranWith(string program, string[] arguments, string[] environmentOverrides,
        Progress? progress) -> ToolRun {
    let running = try system.start(program, arguments, environmentOverrides);
    let collected = new List<string>();
    string? line = try running.readLine();
    while (line != null) {
        collected.push(line);
        if (progress != null) {
            progress.relayed(line);
        }
        line = try running.readLine();
    }
    return new ToolRun(true, try running.wait(), collected.toArray(), "");
} catch (SystemError error) {
    string[] nothing = [];
    return new ToolRun(false, 127, nothing, error.message);
}
