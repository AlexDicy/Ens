// Running the programs a build needs in order to fetch what it depends on. A command run for
// its output is read, and a command doing something slow is passed on as it prints, because a line
// held back until the command finishes is no longer an account of what it is doing.
import @std.system;
import SystemError from @std.system;
import ChildProcess from @std.system;
import List from @std.collections.list;
import Progress from progress;

// What running one program came to.
export final class ToolRun {
    bool ran;
    int code;
    string[] outputLines;
    string problem;
    string stopping;

    protected constructor(this.ran, this.code, this.outputLines, this.problem, this.stopping);

    // Whether the program ran at all. A program that could not be started printed nothing, which is a
    // different thing from a program that ran and refused.
    export started() -> bool {
        return this.ran;
    }

    export exitCode() -> int {
        return this.code;
    }

    export succeeded() -> bool {
        return this.ran && this.code == 0;
    }

    // Everything the program wrote, in the order it wrote it, both streams together.
    export lines() -> string[] {
        return this.outputLines;
    }

    // Why the program could not be run at all, or "" when it ran.
    export failure() -> string {
        return this.problem;
    }

    // Why this build stopped the program short, or "" when it ended on its own.
    export stoppedBecause() -> string {
        return this.stopping;
    }

    // The last line the program printed, which is the part of its account worth repeating when a
    // command that failed has to be explained. Empty when it printed nothing.
    export said() -> string {
        for (long i = this.outputLines.length - 1; i >= 0; i--) {
            string line = this.outputLines[i].trim();
            if (line.length > 0) {
                return line;
            }
        }
        return "";
    }

    // The report for a run that is no good: why it was stopped when this build stopped it, and
    // otherwise the last line it printed. Empty when there is nothing to add.
    export report() -> string {
        if (this.stopping.length > 0) {
            return this.stopping;
        }
        return this.said();
    }
}

export final class SilenceLimit {
    // How long a program may print nothing before a fetch stops it. The programs
    // are configured to stop on their own long before this, since git cuts a transfer that has
    // stalled after a minute of it and curl stops a whole download after ten. This is
    // well above both, so it catches a program wedged for a reason neither of them can detect, and a
    // build waiting forever on one of those looks exactly like a build that has stopped working.
    export static const long milliseconds = 900000;
}

// Why a program was stopped, named with the program and the bound it outstayed.
export silenceProblem(string program, long milliseconds) -> string {
    return "'{program}' wrote nothing for {milliseconds / 1000} seconds and was stopped; nothing "
        + "this build could see was happening";
}

// Runs the program and keeps everything it wrote, showing none of it: this is for a command whose
// output is a value the build reads rather than an account of itself.
export read(string program, string[] arguments, string[] environmentOverrides) -> ToolRun {
    return ranWith(program, arguments, environmentOverrides, null);
}

// Runs the program, keeps everything it wrote, and passes every line on to `progress` the moment it
// arrives: this is for a command whose own account of itself belongs in the build's output.
export relay(string program, string[] arguments, string[] environmentOverrides,
             Progress progress) -> ToolRun {
    return ranWith(program, arguments, environmentOverrides, progress);
}

// Every line the program writes, until it has printed everything or has printed nothing for so long
// that it is taken to be wedged. The wait is bounded because the programs' own limits cover a network
// that has stalled and a prompt nobody can complete, and neither of them covers a program stuck for a
// reason of its own: without a bound here, that is a build that never finishes.
ranWith(string program, string[] arguments, string[] environmentOverrides, Progress? progress) -> ToolRun {
    long bound = SilenceLimit.milliseconds;
    let running = try system.start(program, arguments, environmentOverrides);
    let collected = new List<string>();
    bool speaking = try running.waitForOutput(bound);
    while (speaking) {
        string? line = try running.readLine();
        if (line == null) {
            return new ToolRun(true, try running.wait(), collected.toArray(), "", "");
        }
        collected.push(line);
        if (progress != null) {
            progress.relayed(line);
        }
        speaking = try running.waitForOutput(bound);
    }
    try running.kill();
    int stopped = try running.wait();
    return new ToolRun(true, stopped, collected.toArray(), "",
        silenceProblem(program, bound));
} catch (SystemError error) {
    string[] nothing = [];
    return new ToolRun(false, 127, nothing, error.message, "");
}
