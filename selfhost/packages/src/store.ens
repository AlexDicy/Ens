// The cache every build on this machine shares. A folder is named after the digest of what is
// inside it, so two builds that fetched the same package agree on where it is. A fetch is assembled
// elsewhere and moved into place in one step, so no build ever reads a half-written package.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Environment from @std.environment;
import Platform from @std.environment;
import Scratch from @ens.host.scratch;
import @ens.host.scratch;
import @ens.host.home;
import hashing;

export final class ContentStore {
    Path rootFolder;

    export constructor(this.rootFolder);

    export root() -> Path {
        return this.rootFolder;
    }

    // Where a tree with this digest lives, whether or not it is there yet.
    export treeFolder(string digest) -> Path {
        return this.rootFolder.join("trees").join("sha256-" + hashing.digits(digest));
    }

    // Where an artifact with this digest lives. The file keeps its own name inside a folder named
    // after the digest, so what a link line names still reads as the library it is.
    export artifactFile(string digest, string fileName) -> Path {
        return this.rootFolder.join("artifacts").join(hashing.digits(digest)).join(fileName);
    }

    export hasTree(string digest) -> bool {
        return this.treeFolder(digest).isDirectory();
    }

    export hasArtifact(string digest, string fileName) -> bool {
        return this.artifactFile(digest, fileName).isFile();
    }

    // Somewhere under the store to assemble a fetch. It sits under the store's own root so that
    // publishing it is a move rather than a copy, which is what lets the store never hold a
    // half-written tree.
    export stage(string prefix) -> Scratch {
        return scratch.createUnder(this.rootFolder.join("staging"), prefix);
    }

    // Puts an assembled tree into the store under its digest. A tree another run published first is
    // the one that stays, and the assembled copy is dropped.
    export publishTree(Path staged, string digest) -> Published throws FileSystemError {
        Path destination = this.treeFolder(digest);
        let refused = claim(staged, destination);
        if (refused != null) {
            let dropped = scratch.discard(staged);
            throw notWritten(destination, refused);
        }
        return new Published(destination, scratch.discard(staged));
    }

    // Puts a single fetched file into the store under its digest, which is what a native artifact
    // is. A file another run published first is the one that stays.
    export publishArtifact(Path stagedFile, string digest,
                           string fileName) -> Published throws FileSystemError {
        Path destination = this.artifactFile(digest, fileName);
        let refused = claim(stagedFile, destination);
        if (refused != null) {
            throw notWritten(destination, refused);
        }
        return new Published(destination, discardFile(stagedFile));
    }
}

// Where something now is in the store, and anything the publishing left behind on the way. A
// leftover is reported without being allowed to decide the run's outcome: what was asked for is in
// the store either way, and a staging folder nothing removed is stepped over rather than read.
export final class Published {
    Path storedPath;
    string leftover;

    protected constructor(this.storedPath, this.leftover);

    export path() -> Path {
        return this.storedPath;
    }

    export leftBehind() -> string {
        return this.leftover;
    }
}

// Where the store lives: what ENS_CACHE says, else the 'cache' folder Ens keeps for this user, and
// null when nothing says where either of them is.
export rootFor(Environment environment) -> Path? {
    string? named = environment.get("ENS_CACHE");
    if (named != null && named.length > 0) {
        return Path.fromNative(named, environment.platform()).normalize();
    }
    return home.ensFolder(environment, "cache");
}

// The store for this run, or null when nothing says where it would live.
export locate(Environment environment) -> ContentStore? {
    Path? root = rootFor(environment);
    if (root == null) {
        return null;
    }
    return new ContentStore(root);
}

// What to tell a user whose run found nowhere to cache what it fetched.
export missingRootMessage(Environment environment) -> string {
    string variable = "HOME";
    if (environment.platform() == Platform.Windows) {
        variable = "USERPROFILE";
    }
    return "there is nowhere to keep what a build fetches: nothing in the environment says where "
        + "this user's own folder is. Set ENS_CACHE to a folder that can be written to, or set "
        + variable;
}

// Moves what was assembled into its place in the store, when nothing is there yet. Something already
// there was published by another run and stays as it is, since the digest named it and both hold the
// same bytes. Answers null when the store now holds it, or the refusal that stopped it.
claim(Path staged, Path destination) -> FileSystemError? {
    if (destination.exists()) {
        return null;
    }
    Path? parent = destination.parent();
    if (parent != null) {
        try parent.createDirectories();
    }
    let mine = try staged.moveTo(destination);
    return null;
} catch (FileSystemError refused) {
    return refused;
}

// The refusal as the store reports it, naming the place in the store the caller was publishing to
// and carrying the condition and the number the refusal itself came with.
notWritten(Path destination, FileSystemError refused) -> FileSystemError {
    return new FileSystemError("'{destination}' could not be written: {refused.message}",
        refused.kind, destination, refused.nativeError, refused);
}

// Removes a staged file the store did not take, doing nothing when the move already took it.
discardFile(Path file) -> string {
    if (!file.isFile()) {
        return "";
    }
    try file.removeFile();
    return "";
} catch (FileSystemError refused) {
    return "'{file}' could not be removed after it was cached: {refused.message}";
}
