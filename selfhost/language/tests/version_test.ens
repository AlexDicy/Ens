// The one version Ens has, and the language version a package's 'ens' declaration names, which is
// read out of it.
import @std.testing;
import Version from version;

test "the language version is the release's major.minor" {
    string language = Version.language();
    try testing.assertTrue(Version.release.startsWith(language + "."),
        "'{language}' begins '{Version.release}'");
    try testing.assertEqual(language.split(".").length, 2);
}
