// The release of Ens this executable is, which the release workflow writes before it builds. Its
// major.minor is the language version the compiler in this binary implements, which is what a
// package's 'ens' declaration names, and its patch counts the releases of that language version.

export final class Version {
    export static const string release = "0.13.0-beta";

    // The language version the compiler implements, as in '0.13': the release up to its patch.
    export static language() -> string {
        long minor = Version.release.indexOf(".") + 1;
        long patch = Version.release.indexOf(".", minor);
        if (minor == 0 || patch < 0) {
            return Version.release;
        }
        return Version.release.substring(0, patch);
    }
}
