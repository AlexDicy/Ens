// The semantic gate, run over every program unit the build system lists in a manifest. It gates in
// both directions: an accepted program must produce zero diagnostics, and a unit whose seed files
// carry an @expect-error directive must produce at least one.
import @std.system;
import SystemError from @std.system;
import List from @std.collections.list;
import Map from @std.collections.map;
import LineIndex from @ens.frontend.support.source;
import SystemFileLoader from @ens.sema.support.loader;
import FileDiagnostic from @ens.sema.support.diagnostics;
import @ens.sema.program.graph;
import GraphResult from @ens.sema.program.graph;
import @ens.sema.pipeline;
import @std.path;

// A seed file may add '// @expect-error-at <phase>' when its diagnostic belongs to a later phase
// sema structurally cannot see. Such a unit is exempt from the catch requirement but is always
// listed, and a tag sema outgrows fails the run, so the exemption list cannot rot.
// Exit codes: 0 the gate passed, 1 a unit answered wrongly or a phase tag is stale, 2 usage.
main() -> int {
    string[] arguments = system.arguments();
    if (arguments.length < 2) {
        print("semacheck: usage: semacheck <manifest-path>");
        return 2;
    }
    string manifestText = try system.readAllText(arguments[1]);
    let manifest = parseManifest(manifestText);
    if (manifest.problems.length() > 0) {
        for (long i = 0; i < manifest.problems.length(); i++) {
            print("semacheck: manifest: {manifest.problems.get(i)}");
        }
        return 2;
    }

    let loader = new SystemFileLoader();
    long acceptedCount = 0;
    long expectedCount = 0;
    long caughtCount = 0;
    long caughtAtParseOrGraph = 0;
    long caughtAtDeclareOrLink = 0;
    long caughtAtSignatures = 0;
    long caughtAtLayout = 0;
    long caughtAtChecks = 0;
    long caughtAtBodies = 0;
    long caughtAtExceptions = 0;
    let missed = new List<string>();
    let deferred = new List<string>();
    let staleTags = new List<string>();
    let falseRejects = new List<string>();
    let failureLines = new List<string>();

    for (long i = 0; i < manifest.units.length(); i++) {
        let unit = manifest.units.get(i);
        let report = checkUnit(loader, manifest.stdlibRoot, unit);
        if (isExpectedReject(unit)) {
            string phase = deferredPhase(unit);
            if (phase.length > 0) {
                if (report.total() > 0) {
                    staleTags.push("{unit.label} (tagged {phase})");
                } else {
                    deferred.push("{unit.label} -> {phase}");
                }
                continue;
            }
            expectedCount++;
            if (report.total() == 0) {
                missed.push(unit.label);
            } else {
                caughtCount++;
                if (report.parseLines.length() + report.graphLines.length() > 0) {
                    caughtAtParseOrGraph++;
                } else if (report.declareLines.length() + report.linkLines.length() > 0) {
                    caughtAtDeclareOrLink++;
                } else if (report.signatureLines.length() > 0) {
                    caughtAtSignatures++;
                } else if (report.layoutLines.length() > 0) {
                    caughtAtLayout++;
                } else if (report.checkLines.length() > 0) {
                    caughtAtChecks++;
                } else if (report.bodyLines.length() > 0) {
                    caughtAtBodies++;
                } else {
                    caughtAtExceptions++;
                }
            }
        } else {
            acceptedCount++;
            if (report.total() > 0) {
                falseRejects.push(unit.label);
                failureLines.push("semacheck: unit {unit.label} produced "
                    + "{report.total()} diagnostic(s):");
                report.appendTo(failureLines);
            }
        }
    }

    print("semacheck: checked {manifest.units.length()} unit(s): "
        + "{acceptedCount} accepted, {expectedCount} expected-reject enforced, "
        + "{deferred.length() + staleTags.length()} deferred to a later phase");
    print("semacheck: expected-reject caught {caughtCount} of {expectedCount} "
        + "(parse/graph {caughtAtParseOrGraph}, declare/link {caughtAtDeclareOrLink}, "
        + "signatures {caughtAtSignatures}, layout {caughtAtLayout}, "
        + "checks {caughtAtChecks}, bodies {caughtAtBodies}, "
        + "exceptions {caughtAtExceptions})");
    for (long i = 0; i < deferred.length(); i++) {
        print("semacheck: deferred: {deferred.get(i)}");
    }
    bool failed = false;
    if (missed.length() > 0) {
        failed = true;
        print("semacheck: gate FAILED: expected-reject not caught: " + describedList(missed));
    }
    if (staleTags.length() > 0) {
        failed = true;
        print("semacheck: gate FAILED: stale @expect-error-at tag, sema now catches: "
            + describedList(staleTags) + "; remove the directive");
    }
    if (falseRejects.length() > 0) {
        failed = true;
        print("semacheck: gate FAILED: {falseRejects.length()} accepted unit(s) "
            + "produced diagnostics");
        for (long i = 0; i < failureLines.length(); i++) {
            print(failureLines.get(i));
        }
    }
    if (failed) {
        return 1;
    }
    print("semacheck: gate passed: accepted units clean, all enforced rejects caught");
    return 0;
} catch (SystemError e) {
    print("semacheck: {e.message}");
    return 2;
}

class CheckUnit {
    protected string label;
    protected string sourceRoot;
    protected string entryFile;
    protected List<string> seeds;

    protected constructor(string label) {
        this.label = label;
        this.sourceRoot = "";
        this.entryFile = "";
        this.seeds = new List<string>();
    }
}

class Manifest {
    protected string stdlibRoot;
    protected List<CheckUnit> units;
    protected List<string> problems;

    protected constructor() {
        this.stdlibRoot = "";
        this.units = new List<CheckUnit>();
        this.problems = new List<string>();
    }
}

// One keyword per line, values separated by one space:
//   stdlib <folder containing std/>
//   unit <display label>          starts a unit
//   source <source root>          the unit's source folder
//   entry <relative path>         a single-file program: the file is the main module
//   seed <relative path>          one line per seed file, relative to the source root
// A unit's own files may carry '// @stdlib <folder>', relative to the unit's source root, naming a
// standard library that unit is checked against instead of the manifest's.
parseManifest(string text) -> Manifest {
    let manifest = new Manifest();
    CheckUnit? current = null;
    string[] lines = text.lines();
    for (long i = 0; i < lines.length; i++) {
        string line = lines[i].trim();
        if (line.length == 0) {
            continue;
        }
        long space = line.indexOf(" ");
        if (space < 0) {
            manifest.problems.push("line {i + 1}: expected '<keyword> <value>', got '{line}'");
            continue;
        }
        string keyword = line.substring(0, space);
        string value = line.substring(space + 1, line.length).trim();
        switch (keyword) {
            "stdlib" -> {
                manifest.stdlibRoot = value;
            },
            "unit" -> {
                let opened = new CheckUnit(value);
                manifest.units.push(opened);
                current = opened;
            },
            "source" -> {
                if (current == null) {
                    manifest.problems.push("line {i + 1}: 'source' before any 'unit'");
                } else {
                    current.sourceRoot = value;
                }
            },
            "entry" -> {
                if (current == null) {
                    manifest.problems.push("line {i + 1}: 'entry' before any 'unit'");
                } else {
                    current.entryFile = value;
                }
            },
            "seed" -> {
                if (current == null) {
                    manifest.problems.push("line {i + 1}: 'seed' before any 'unit'");
                } else {
                    current.seeds.push(value);
                }
            },
            default -> {
                manifest.problems.push("line {i + 1}: unknown keyword '{keyword}'");
            },
        }
    }
    if (manifest.stdlibRoot.length == 0) {
        manifest.problems.push("missing a 'stdlib' line");
    }
    if (manifest.units.length() == 0) {
        manifest.problems.push("no units listed");
    }
    for (long i = 0; i < manifest.units.length(); i++) {
        let unit = manifest.units.get(i);
        if (unit.sourceRoot.length == 0) {
            manifest.problems.push("unit {unit.label} has no 'source' line");
        }
        if (unit.seeds.length() == 0 && unit.entryFile.length == 0) {
            manifest.problems.push("unit {unit.label} has no 'seed' or 'entry' line");
        }
    }
    return manifest;
}

// Diagnostics of one unit, formatted per pipeline stage.
class StageReport {
    protected List<string> parseLines;
    protected List<string> graphLines;
    protected List<string> declareLines;
    protected List<string> linkLines;
    protected List<string> signatureLines;
    protected List<string> layoutLines;
    protected List<string> checkLines;
    protected List<string> bodyLines;
    protected List<string> exceptionLines;

    protected constructor() {
        this.parseLines = new List<string>();
        this.graphLines = new List<string>();
        this.declareLines = new List<string>();
        this.linkLines = new List<string>();
        this.signatureLines = new List<string>();
        this.layoutLines = new List<string>();
        this.checkLines = new List<string>();
        this.bodyLines = new List<string>();
        this.exceptionLines = new List<string>();
    }

    protected total() -> long {
        return this.parseLines.length() + this.graphLines.length()
            + this.declareLines.length() + this.linkLines.length()
            + this.signatureLines.length() + this.layoutLines.length()
            + this.checkLines.length() + this.bodyLines.length()
            + this.exceptionLines.length();
    }

    protected appendTo(List<string> lines) {
        appendStage(lines, "parse", this.parseLines);
        appendStage(lines, "graph", this.graphLines);
        appendStage(lines, "declare", this.declareLines);
        appendStage(lines, "link", this.linkLines);
        appendStage(lines, "signatures", this.signatureLines);
        appendStage(lines, "layout", this.layoutLines);
        appendStage(lines, "checks", this.checkLines);
        appendStage(lines, "bodies", this.bodyLines);
        appendStage(lines, "exceptions", this.exceptionLines);
    }
}

appendStage(List<string> lines, string stage, List<string> stageLines) {
    for (long i = 0; i < stageLines.length(); i++) {
        lines.push("  [{stage}] " + stageLines.get(i));
    }
}

checkUnit(SystemFileLoader loader, string stdlibRoot, CheckUnit unit) -> StageReport {
    let result = buildUnitGraph(loader, stdlibRoot, unit);
    let report = new StageReport();
    let indexes = new Map<string, LineIndex>();
    for (let loaded in result.modules()) {
        indexes.set(loaded.filePath(), new LineIndex(loaded.source()));
    }
    for (let diagnostic in result.diagnostics()) {
        report.graphLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    for (let loaded in result.modules()) {
        for (let diagnostic in loaded.parseResult().diagnostics()) {
            report.parseLines.push(formatDiagnostic(indexes, loaded.filePath(),
                diagnostic.span().start, diagnostic.message()));
        }
    }
    let analysis = pipeline.analyzeRecovered(result);
    if (analysis == null) {
        return report;
    }
    for (let diagnostic in analysis.declareDiagnostics()) {
        report.declareLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    for (let diagnostic in analysis.linkDiagnostics()) {
        report.linkLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    for (let diagnostic in analysis.signatureDiagnostics()) {
        report.signatureLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    for (let diagnostic in analysis.layoutDiagnostics()) {
        report.layoutLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    for (let diagnostic in analysis.checkDiagnostics()) {
        report.checkLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    for (let diagnostic in analysis.bodyDiagnostics()) {
        report.bodyLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    for (let diagnostic in analysis.exceptionDiagnostics()) {
        report.exceptionLines.push(formatFileDiagnostic(indexes, diagnostic));
    }
    return report;
}

buildUnitGraph(SystemFileLoader loader, string stdlibRoot, CheckUnit unit) -> GraphResult {
    string root = stdlibRoot;
    string overridden = stdlibDirective(unit);
    if (overridden.length > 0) {
        root = path.join(unit.sourceRoot, overridden);
    }
    if (unit.entryFile.length > 0) {
        return graph.buildFileProgram(loader, unit.sourceRoot, "", root, unit.entryFile);
    }
    return graph.buildGraph(loader, unit.sourceRoot, "", root, unit.seeds.toArray());
}

// The '// @stdlib <folder>' directive a unit's own files carry, relative to its source root: a
// standard library the fixture is checked against instead of the tree's. "" when none names one.
stdlibDirective(CheckUnit unit) -> string {
    for (let file in directiveFiles(unit)) {
        string text = readOrEmpty(path.join(unit.sourceRoot, file));
        string[] lines = text.lines();
        for (let line in lines) {
            string comment = commentBody(line);
            if (comment.startsWith("@stdlib ")) {
                return comment.substring("@stdlib ".length, comment.length).trim();
            }
        }
    }
    return "";
}

formatFileDiagnostic(Map<string, LineIndex> indexes, FileDiagnostic diagnostic)
        -> string {
    return formatDiagnostic(indexes, diagnostic.file(), diagnostic.span().start,
        diagnostic.message());
}

formatDiagnostic(Map<string, LineIndex> indexes, string file, long offset, string message) -> string {
    let index = indexes.get(file);
    if (index != null) {
        let position = index.positionAt(offset);
        return "{file}:{position.line}:{position.column}: {message}";
    }
    return "{file}: (offset {offset}) {message}";
}

// True when any seed or entry file carries an @expect-error directive, the same line shape the
// test runner reads: a comment line starting '// @expect-error'.
isExpectedReject(CheckUnit unit) -> bool {
    for (let file in directiveFiles(unit)) {
        string text = readOrEmpty(path.join(unit.sourceRoot, file));
        if (hasExpectErrorDirective(text)) {
            return true;
        }
    }
    return false;
}

directiveFiles(CheckUnit unit) -> string[] {
    if (unit.entryFile.length == 0) {
        return unit.seeds.toArray();
    }
    let files = new List<string>();
    files.push(unit.entryFile);
    for (long i = 0; i < unit.seeds.length(); i++) {
        files.push(unit.seeds.get(i));
    }
    return files.toArray();
}

hasExpectErrorDirective(string text) -> bool {
    string[] lines = text.lines();
    for (let line in lines) {
        string comment = commentBody(line);
        if (comment.startsWith("@expect-error")) {
            return true;
        }
    }
    return false;
}

// The phase named by an '// @expect-error-at <phase>' directive in any seed or entry file, or
// "" when the unit carries no such tag. Text after the phase name is a free-form note.
deferredPhase(CheckUnit unit) -> string {
    for (let file in directiveFiles(unit)) {
        string text = readOrEmpty(path.join(unit.sourceRoot, file));
        string[] lines = text.lines();
        for (let line in lines) {
            string comment = commentBody(line);
            if (!comment.startsWith("@expect-error-at ")) {
                continue;
            }
            string value = comment.substring("@expect-error-at ".length,
                comment.length).trimStart();
            long space = value.indexOf(" ");
            if (space < 0) {
                return value;
            }
            return value.substring(0, space);
        }
    }
    return "";
}

commentBody(string line) -> string {
    string trimmed = line.trimStart();
    if (!trimmed.startsWith("//")) {
        return "";
    }
    return trimmed.substring(2, trimmed.length).trimStart();
}

// A file's text, or empty when it could not be read. Bytes that spell no character are replaced
// rather than refused: a fixture may hold malformed bytes on purpose, and the directives this
// reads are ASCII.
readOrEmpty(string path) -> string {
    return string.fromBytesLossy(try system.readAllBytes(path));
} catch (SystemError error) {
    return "";
}

describedList(List<string> values) -> string {
    return string.joined(values.toArray(), ", ");
}
