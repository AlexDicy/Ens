// syntax.grammar - single source of truth for the self-hosted front end's tree.
//
// The syntaxgen tool reads this file and emits, as checked-in .ens sources: the SyntaxKind enum, kind predicates,
// the typed red node classes, the red factory, and the tree dump.
//
// DSL, in brief:
//   tokens { Name = 'spelling' ... }     fixed-spelling tokens and keywords
//   tokens { Name ... }                  variable-text tokens (Identifier, literals)
//   Name trivia                          trivia token: attached to real tokens, never a tree child
//   Name = 'spelling' contextual         lexed as Identifier; the parser re-tags the token only where the grammar
//                                        expects it, so the spelling stays a valid identifier everywhere else
//   Category = NodeA | NodeB | ...       a sealed abstract class; nodes extend it, so type switches are exhaustive
//   union Name = NodeA | NodeB | ...     a marker interface for ad hoc unions; a node may implement several
//   Node = slot: Type ...                a node rule with fixed slots, in order
//     'if'                               anonymous token slot (accessor name derived)
//     name: Identifier                   named token slot
//     condition: Expression              named node slot (category, union, or node)
//     x: Thing?                          optional slot (accessor returns Thing?)
//     xs: Thing* sep ','                 list slot, optionally with a separator
//     operator: ('+' | '-')              token-set slot
//
// Tree-wide rules (not expressed per node):
//   - Trivia (whitespace, comments) is attached to tokens: leading trivia plus same-line trailing trivia.
//     Tree children are only meaningful nodes and tokens.
//   - The parser never leaves a structural slot empty: an absent required token becomes a Missing token, and an
//     unparsable region becomes the Error node of the right category (ErrorExpression is an Expression, and so
//     on), so accessors are nullable only where this file says '?'.
//   - Offsets are UTF-8 byte offsets; line/column come from a LineIndex.
//   - There is no '??' token: it is two Question tokens, joined by the parser only when nothing separates them.
//     That is what lets a type stack its '?' suffixes ('string??'), the same reason '>>' is split for nested
//     generics rather than merged.

// ============================================================ tokens

tokens {
    // trivia (attached to tokens, never tree children)
    Whitespace trivia
    Newline trivia
    LineComment trivia
    BlockComment trivia

    // special
    EndOfFile
    Invalid          // tokenizer-level lex error
    Missing          // parser-inserted placeholder for an expected token

    // literals
    IntLiteral
    LongLiteral
    FloatLiteral
    DoubleLiteral
    StringLiteral
    CharLiteral
    InterpolatedStringStart    // "a{
    InterpolatedStringMiddle   // }b{
    InterpolatedStringEnd      // }c"

    Identifier

    // punctuation
    OpenParenthesis = '('      CloseParenthesis = ')'    OpenBrace = '{'      CloseBrace = '}'
    OpenBracket = '['          CloseBracket = ']'        Semicolon = ';'      Comma = ','
    Dot = '.'                  Ellipsis = '...'          Colon = ':'          Arrow = '->'
    At = '@'                   Plus = '+'                Minus = '-'          Star = '*'
    Slash = '/'                Percent = '%'             Caret = '^'          Equals = '='
    Exclamation = '!'          Tilde = '~'               Question = '?'       QuestionDot = '?.'
    EqualsEquals = '=='        NotEquals = '!='          Less = '<'           Greater = '>'
    LessEquals = '<='          GreaterEquals = '>='      AmpersandAmpersand = '&&'
    PipePipe = '||'            Ampersand = '&'           Pipe = '|'
    PlusPlus = '++'            MinusMinus = '--'
    LessLess = '<<'            GreaterGreater = '>>'     GreaterGreaterGreater = '>>>'
    PlusEquals = '+='          MinusEquals = '-='        StarEquals = '*='    SlashEquals = '/='
    PercentEquals = '%='       AmpersandEquals = '&='    PipeEquals = '|='    CaretEquals = '^='
    LessLessEquals = '<<='     GreaterGreaterEquals = '>>='                   GreaterGreaterGreaterEquals = '>>>='

    // primitive type keywords
    BoolKeyword = 'bool'       ByteKeyword = 'byte'      ShortKeyword = 'short'     UShortKeyword = 'ushort'
    IntKeyword = 'int'         UIntKeyword = 'uint'      LongKeyword = 'long'       ULongKeyword = 'ulong'
    FloatKeyword = 'float'     DoubleKeyword = 'double'  DecimalKeyword = 'decimal' CharKeyword = 'char'
    StringKeyword = 'string'   VoidKeyword = 'void'

    // reserved keywords
    AbstractKeyword = 'abstract'     AsKeyword = 'as'                 BreakKeyword = 'break'
    CatchKeyword = 'catch'           ClassKeyword = 'class'           ConstKeyword = 'const'
    ContinueKeyword = 'continue'     DefaultKeyword = 'default'       ElseKeyword = 'else'
    EnumKeyword = 'enum'             ExportKeyword = 'export'         ExtendsKeyword = 'extends'
    ExternalKeyword = 'external'     FalseKeyword = 'false'           FinalKeyword = 'final'
    ForKeyword = 'for'               IfKeyword = 'if'                 ImplementsKeyword = 'implements'
    ImportKeyword = 'import'         InterfaceKeyword = 'interface'   IsKeyword = 'is'
    LetKeyword = 'let'               NewKeyword = 'new'               NoreturnKeyword = 'noreturn'
    NullKeyword = 'null'             OverrideKeyword = 'override'     PrivateKeyword = 'private'
    ProtectedKeyword = 'protected'   PublicKeyword = 'public'         RethrowKeyword = 'rethrow'
    ReturnKeyword = 'return'         SealedKeyword = 'sealed'         StaticKeyword = 'static'
    StructKeyword = 'struct'         SuperKeyword = 'super'           SwitchKeyword = 'switch'
    ThisKeyword = 'this'             ThrowKeyword = 'throw'           ThrowsKeyword = 'throws'
    TrueKeyword = 'true'             TryKeyword = 'try'               WeakKeyword = 'weak'
    WhileKeyword = 'while'
    ConstructorKeyword = 'constructor'   DestructorKeyword = 'destructor'

    // reserved for future use
    AssertKeyword = 'assert'         CaseKeyword = 'case'             ComputedKeyword = 'computed'
    DoKeyword = 'do'                 FinallyKeyword = 'finally'       GotoKeyword = 'goto'
    PackageKeyword = 'package'

    // contextual keywords: valid identifiers everywhere except the one grammatical position that expects them
    OutKeyword = 'out' contextual
    InKeyword = 'in' contextual
    TestKeyword = 'test' contextual
    FromKeyword = 'from' contextual
    TypeKeyword = 'type' contextual

    // manifest keywords, all contextual: manifests are keyword-introduced declarations, and none
    // of these words is reserved in ordinary source
    WorkspaceKeyword = 'workspace' contextual
    OverridesKeyword = 'overrides' contextual
    VersionKeyword = 'version' contextual
    EnsKeyword = 'ens' contextual
    DependencyKeyword = 'dependency' contextual
    MemberKeyword = 'member' contextual
    NativeKeyword = 'native' contextual
    SystemKeyword = 'system' contextual
    ArtifactKeyword = 'artifact' contextual
    HashKeyword = 'hash' contextual
}

// Declaration modifiers are a token list slot, validated semantically per declaration form rather than encoded
// as per-kind slots.
tokenset Modifier = 'public' | 'private' | 'protected' | 'export' | 'abstract' | 'override' | 'final' | 'sealed' | 'weak' | 'const' | 'noreturn' | 'static'

// A constructor or destructor is introduced by its keyword instead of a name.
tokenset MemberIntroducer = 'constructor' | 'destructor'

// ============================================================ categories

Declaration = FunctionDeclaration | FieldDeclaration | StructDeclaration | ClassDeclaration | InterfaceDeclaration
            | EnumDeclaration | EnumMember | ImportDeclaration | ExternalTypeDeclaration | ExternalBlock
            | ExternalFunctionDeclaration | TestDeclaration | ErrorDeclaration

Statement = Block | VariableDeclaration | IfStatement | WhileStatement | ForStatement | ForEachStatement
          | BreakStatement | ContinueStatement | ReturnStatement | ExpressionStatement | ThrowStatement
          | RethrowStatement | SwitchStatement | ErrorStatement

Expression = LiteralExpression | IdentifierExpression | GenericNameExpression | ThisExpression
           | SuperExpression | BinaryExpression | PrefixExpression | PostfixExpression | CallExpression
           | MemberExpression | SafeMemberExpression | SubscriptExpression | SafeSubscriptExpression
           | CastExpression | CheckedCastExpression | TypeTestExpression | AssignmentExpression
           | TernaryExpression | NullCoalesceExpression | NewExpression | ParenthesizedExpression
           | ArrayLiteralExpression | StructLiteralExpression | InterpolatedStringExpression
           | TryExpression | SwitchExpression | ErrorExpression

Type = NamedType | ArrayType | OptionalType | ErrorType

SwitchArm = ValueArm | TypeArm | DefaultArm

// Manifest categories (ens.package and ens.overrides files).
ManifestDeclaration = PackageDeclaration | WorkspaceDeclaration | OverridesDeclaration | ErrorManifestDeclaration
PackageItem = VersionDeclaration | EnsDeclaration | DependencyDeclaration | NativeDeclaration | ErrorPackageItem
WorkspaceItem = MemberDeclaration | ErrorWorkspaceItem
OverridesItem = OverrideDeclaration | ErrorOverridesItem
NativeBinding = NativeLibraryBinding | NativeArtifactBinding | ErrorNativeBinding

// Ad hoc unions (marker interfaces).
union TopLevelItem = ImportDeclaration | ExternalTypeDeclaration | ExternalBlock | FunctionDeclaration
                   | StructDeclaration | ClassDeclaration | InterfaceDeclaration | EnumDeclaration
                   | TestDeclaration | ErrorDeclaration
union Member = FieldDeclaration | FunctionDeclaration | ErrorDeclaration
union ExternalItem = ExternalFunctionDeclaration | ErrorDeclaration
union Argument = Expression | OutArgument | NamedArgument
union ArmBody = Block | Expression
union ElseBody = Block | IfStatement
union ForInitializer = VariableDeclaration | ExpressionStatement

// ============================================================ top level

SourceFile = items: TopLevelItem* eof: EndOfFile

// The manifest start symbol, selected by file name (ens.package, ens.overrides). A manifest holds
// exactly one declaration; the list keeps recovery lossless when a file holds more.
ManifestFile = declarations: ManifestDeclaration* eof: EndOfFile

// ============================================================ manifests

PackageDeclaration = 'package' name: PackagePath '{' items: PackageItem* '}'
WorkspaceDeclaration = 'workspace' '{' items: WorkspaceItem* '}'
OverridesDeclaration = 'overrides' '{' items: OverridesItem* '}'

PackagePath = segments: Identifier* sep '.'

VersionDeclaration = 'version' value: StringLiteral ';'
EnsDeclaration = 'ens' value: StringLiteral ';'
DependencyDeclaration = 'dependency' name: PackagePath version: StringLiteral? source: FromClause? ';'
FromClause = 'from' url: StringLiteral
MemberDeclaration = 'member' folder: StringLiteral ';'
OverrideDeclaration = 'override' name: PackagePath folder: StringLiteral ';'

// Exactly one of bindings/';' is present: the bare form (`native zlib;`) and the system form
// (`native libc system;`) end with ';', the per-platform form carries a binding block.
NativeDeclaration = 'native' name: Identifier systemKeyword: 'system'? bindings: NativeBindingList? ';'?
NativeBindingList = '{' bindings: NativeBinding* '}'
NativeLibraryBinding = platform: Identifier names: StringLiteral* ';'
NativeArtifactBinding = platform: Identifier 'artifact' url: StringLiteral 'hash' checksum: StringLiteral ';'

// ============================================================ declarations

FunctionDeclaration =
    modifiers: Modifier*
    // A constructor/destructor carries its introducer keyword and no name; a
    // regular method carries a name and no introducer.
    introducer: MemberIntroducer?
    name: Identifier?
    typeParameters: TypeParameterList?
    parameters: ParameterList
    returnType: ReturnTypeClause?
    throwsClause: ThrowsClause?
    // Exactly one of body/';' is present: bodiless forms (abstract methods, interface method
    // signatures, and shorthand constructors like `constructor(this.shape = null);`) end with ';'.
    body: Block?
    ';'?
    catchClauses: CatchClause*

ParameterList = '(' parameters: Parameter* sep ',' ')'

// Covers `int width`, `out uint bytesRead`, and the `this.field` shorthand.
Parameter = outKeyword: 'out'? declaredType: Type? thisPrefix: ThisPrefix? name: Identifier defaultValue: Initializer?

ThisPrefix = 'this' '.'
Initializer = '=' value: Expression
ReturnTypeClause = '->' returnedType: Type
ThrowsClause = 'throws' types: NamedType* sep ','     // list may be empty
CatchClause = 'catch' '(' caughtType: NamedType name: Identifier ')' body: Block

// Structs parse the same clauses as classes so that `struct S extends T` and `struct S implements I`
// get precise semantic diagnostics ("structs cannot extend/implement") instead of parse errors.
StructDeclaration =
    modifiers: Modifier*
    'struct' name: Identifier
    typeParameters: TypeParameterList?
    extendsClause: ExtendsClause?
    implementsClause: ImplementsClause?
    body: MemberList

ClassDeclaration =
    modifiers: Modifier*
    'class' name: Identifier
    typeParameters: TypeParameterList?
    extendsClause: ExtendsClause?
    implementsClause: ImplementsClause?
    body: MemberList

InterfaceDeclaration =
    modifiers: Modifier*
    'interface' name: Identifier
    typeParameters: TypeParameterList?
    extendsClause: ExtendsClause?
    body: MemberList

ExtendsClause = 'extends' base: NamedType
ImplementsClause = 'implements' interfaces: NamedType* sep ','
MemberList = '{' members: Member* '}'

FieldDeclaration = modifiers: Modifier* declaredType: Type name: Identifier defaultValue: Initializer? ';'

EnumDeclaration = modifiers: Modifier* 'enum' name: Identifier '{' members: EnumMember* sep ',' '}'
EnumMember = name: Identifier value: Initializer?

// `import engine.renderer;` and `import Renderer from engine.renderer;`
ImportDeclaration = 'import' binding: ImportBinding? path: ImportPath ';'
ImportBinding = name: Identifier 'from'
ImportPath = at: '@'? segments: Identifier* sep '.'

ExternalTypeDeclaration = modifiers: Modifier* 'external' 'type' name: Identifier ';'
// The library identifier names a logical native library declared in the containing package's
// ens.package manifest.
ExternalBlock = 'external' 'from' library: Identifier '{' functions: ExternalItem* '}'
ExternalFunctionDeclaration = name: Identifier parameters: ParameterList returnType: ReturnTypeClause? ';'

TestDeclaration = 'test' description: (StringLiteral | InterpolatedStringExpression) body: Block

TypeParameterList = '<' parameters: TypeParameter* sep ',' '>'
TypeParameter = name: Identifier bounds: BoundsClause?
BoundsClause = ':' bounds: NamedType* sep '+'

// ============================================================ types

NamedType = qualifier: TypeQualifier?
            name: (Identifier | 'bool' | 'byte' | 'short' | 'ushort' | 'int' | 'uint' | 'long' | 'ulong'
                 | 'float' | 'double' | 'decimal' | 'char' | 'string' | 'void')
            typeArguments: TypeArgumentList?
TypeQualifier = module: Identifier '.'
ArrayType = element: Type '[' ']'
OptionalType = inner: Type '?'
TypeArgumentList = '<' arguments: Type* sep ',' '>'

// ============================================================ statements

Block = '{' statements: Statement* '}'

// Unifies `let x = e;`, `const x = e;`, `const int x = e;`, and `int x = e;`.
// At least one of modifier/declaredType is present (checked semantically).
VariableDeclaration = modifier: ('let' | 'const')? declaredType: Type? name: Identifier initializer: Initializer? ';'

IfStatement = 'if' '(' condition: Expression ')' thenBranch: Block elseClause: ElseClause?
ElseClause = 'else' body: ElseBody

WhileStatement = 'while' '(' condition: Expression ')' body: Block

// The initializer owns its own ';'; the condition's ';' is a direct token. When the initializer
// is omitted (`for (; c; u)`), its bare ';' sits in initializerSemicolon instead.
ForStatement = 'for' '(' initializer: ForInitializer? initializerSemicolon: ';'?
               condition: Expression? ';' update: Expression? ')' body: Block

ForEachStatement = 'for' '(' letKeyword: 'let'? declaredType: Type? name: Identifier 'in' iterable: Expression ')' body: Block

BreakStatement = 'break' ';'
ContinueStatement = 'continue' ';'
ReturnStatement = 'return' value: Expression? ';'
ExpressionStatement = expression: Expression ';'
ThrowStatement = 'throw' value: Expression ';'
RethrowStatement = 'rethrow' ';'

SwitchStatement = 'switch' '(' scrutinee: Expression ')' '{' arms: SwitchArm* sep ',' '}'

ValueArm = labels: Expression* sep ',' '->' body: ArmBody
TypeArm = 'is' target: NamedType binding: Identifier? '->' body: ArmBody
DefaultArm = 'default' '->' body: ArmBody

// ============================================================ expressions

LiteralExpression = value: (IntLiteral | LongLiteral | FloatLiteral | DoubleLiteral | StringLiteral | CharLiteral
                          | 'true' | 'false' | 'null')
IdentifierExpression = name: Identifier

// A type name carrying type arguments in expression position, the head of a static member access:
// 'List<int>' in 'List<int>.withCapacity(8)'. The parser commits it only when a '.' follows the
// closing '>'; anywhere else the '<' stays a comparison.
GenericNameExpression = head: Expression typeArguments: TypeArgumentList
ThisExpression = 'this'
SuperExpression = 'super'

BinaryExpression = left: Expression
                   operator: ('+' | '-' | '*' | '/' | '%' | '==' | '!=' | '<' | '>' | '<=' | '>='
                            | '&&' | '||' | '&' | '|' | '^' | '<<' | '>>' | '>>>')
                   right: Expression

PrefixExpression = operator: ('-' | '+' | '!' | '~' | '++' | '--') operand: Expression
PostfixExpression = operand: Expression operator: ('++' | '--')

CallExpression = callee: Expression typeArguments: TypeArgumentList? arguments: ArgumentList
ArgumentList = '(' arguments: Argument* sep ',' ')'
OutArgument = 'out' name: Identifier
NamedArgument = name: Identifier ':' value: Expression

MemberExpression = object: Expression '.' member: Identifier
SafeMemberExpression = object: Expression '?.' member: Identifier
SubscriptExpression = object: Expression '[' index: Expression ']'
SafeSubscriptExpression = object: Expression '?' '[' index: Expression ']'

CastExpression = value: Expression 'as' target: Type
CheckedCastExpression = value: Expression 'as' '?' target: Type
TypeTestExpression = value: Expression 'is' target: NamedType

AssignmentExpression = target: Expression
                       operator: ('=' | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^=' | '<<=' | '>>=' | '>>>=')
                       value: Expression

TernaryExpression = condition: Expression '?' thenValue: Expression ':' elseValue: Expression

// The two '?' tokens are adjacent in the source; a ternary is what a separated pair parses as.
NullCoalesceExpression = left: Expression '?' '?' right: Expression

// `new T(...)`, `new T[a][b]`, `new T[a][]`; empty dimensions have no size. The created type
// carries the element's `?` and `[]` suffixes (`new Box?[n]`, `new Box?[]?[3]`); the trailing
// sized and empty dimensions are the ArrayDimension list.
NewExpression = 'new' createdType: Type arguments: ArgumentList? dimensions: ArrayDimension*
ArrayDimension = '[' size: Expression? ']'

ParenthesizedExpression = '(' inner: Expression ')'
ArrayLiteralExpression = '[' elements: Expression* sep ',' ']'

// A context-typed aggregate literal `{field: value, field: value}`. The target struct type comes
// from the surrounding context; each field binds a declared field by name.
StructLiteralExpression = '{' fields: StructLiteralField* sep ',' '}'
StructLiteralField = name: Identifier ':' value: Expression

// An interpolated string always has at least one hole ("abc" lexes as a plain StringLiteral), and text
// segments alternate with holes by construction, so the slots read in source order.
InterpolatedStringExpression = start: InterpolatedStringStart firstHole: Expression
                               continuations: InterpolationPart* end: InterpolatedStringEnd
InterpolationPart = middle: InterpolatedStringMiddle hole: Expression

TryExpression = 'try' operand: Expression
SwitchExpression = 'switch' '(' scrutinee: Expression ')' '{' arms: SwitchArm* sep ',' '}'

// ============================================================ recovery

ErrorDeclaration = skipped: token*
ErrorStatement = skipped: token*
ErrorExpression = skipped: token*
ErrorType = skipped: token*
ErrorManifestDeclaration = skipped: token*
ErrorPackageItem = skipped: token*
ErrorWorkspaceItem = skipped: token*
ErrorOverridesItem = skipped: token*
ErrorNativeBinding = skipped: token*
