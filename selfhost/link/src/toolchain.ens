// What the machine running a link contributes to the link line. Every field is a finished value, so
// building a link line reads these and never touches the machine itself; discovery is the only part
// that looks around, and it hands back one of these.

// The C runtime pieces an ELF program starts through, each empty when the machine has none. Without
// a startup object the program links with no entry point, which is what a freestanding link wants
// and what a machine with no C compiler installed gets.
export final class ElfRuntime {
    string runtimeStartupObject;
    string runtimeInitObject;
    string runtimeFiniObject;
    string runtimeUnwinderArchive;

    public constructor(string startupObject, string initObject, string finiObject,
                       string unwinderArchive) {
        this.runtimeStartupObject = startupObject;
        this.runtimeInitObject = initObject;
        this.runtimeFiniObject = finiObject;
        this.runtimeUnwinderArchive = unwinderArchive;
    }

    // Scrt1.o, the position-independent startup object that calls main().
    export startupObject() -> string {
        return this.runtimeStartupObject;
    }

    // crti.o, which opens the .init and .fini prologues the C runtime expects.
    export initObject() -> string {
        return this.runtimeInitObject;
    }

    // crtn.o, which closes them.
    export finiObject() -> string {
        return this.runtimeFiniObject;
    }

    // The static unwinder a thrown exception walks the stack through. Empty when none was found,
    // and the link falls back to the shared libgcc_s.
    export unwinderArchive() -> string {
        return this.runtimeUnwinderArchive;
    }
}

// Where the macOS SDK is and which version it is, both empty when no SDK was found. Without a root
// the link runs without '-syslibroot' and reaches the system libraries by their absolute paths.
export final class MacosSdk {
    string sdkRootPath;
    string sdkVersionText;

    public constructor(string root, string version) {
        this.sdkRootPath = root;
        this.sdkVersionText = version;
    }

    export root() -> string {
        return this.sdkRootPath;
    }

    export version() -> string {
        return this.sdkVersionText;
    }
}

// One machine's contribution to a link line.
export final class Toolchain {
    string[] toolchainLibrarySearchPaths;
    string toolchainDynamicLinker;
    ElfRuntime toolchainElfRuntime;
    MacosSdk toolchainMacosSdk;

    public constructor(string[] librarySearchPaths, string dynamicLinker, ElfRuntime elfRuntime,
                       MacosSdk macosSdk) {
        this.toolchainLibrarySearchPaths = librarySearchPaths;
        this.toolchainDynamicLinker = dynamicLinker;
        this.toolchainElfRuntime = elfRuntime;
        this.toolchainMacosSdk = macosSdk;
    }

    // The folders LIBRARY_PATH named, each becoming both a search path and a runtime path so a
    // program that links a shared library found this way also loads it when it runs.
    export librarySearchPaths() -> string[] {
        return this.toolchainLibrarySearchPaths;
    }

    // The ELF loader the program runs through, empty when the machine has none for the target.
    export dynamicLinker() -> string {
        return this.toolchainDynamicLinker;
    }

    export elfRuntime() -> ElfRuntime {
        return this.toolchainElfRuntime;
    }

    export macosSdk() -> MacosSdk {
        return this.toolchainMacosSdk;
    }
}

// A machine that contributes nothing, which is what a COFF link uses: lld-link reads LIB itself and
// brings its own C runtime, so there is nothing left to discover.
export bareToolchain() -> Toolchain {
    return new Toolchain([], "", new ElfRuntime("", "", "", ""), new MacosSdk("", ""));
}
