// What the machine running a link contributes to the link line. Every field is a finished value, so
// building a link line reads these and never touches the machine itself; discovery is the only part
// that searches the machine, and it returns one of these.

// Where the macOS SDK is and which version it is, both empty when no SDK was found. Without a root
// the link runs without '-syslibroot' and reaches the system libraries by their absolute paths.
export final class MacosSdk {
    string sdkRootPath;
    string sdkVersionText;
    string sdkUnusableRoot;

    public constructor(string root, string version, string unusableRoot = "") {
        this.sdkRootPath = root;
        this.sdkVersionText = version;
        this.sdkUnusableRoot = unusableRoot;
    }

    export root() -> string {
        return this.sdkRootPath;
    }

    export version() -> string {
        return this.sdkVersionText;
    }

    // What SDKROOT named when it named something that is not a folder, which is then not used and
    // keeps xcrun from being asked; empty otherwise.
    export unusableRoot() -> string {
        return this.sdkUnusableRoot;
    }
}

// One machine's contribution to a link line, and the link-only system libraries ens carries for the
// target.
export final class Toolchain {
    string[] toolchainLibrarySearchPaths;
    string[] toolchainSystemFolders;
    MacosSdk toolchainMacosSdk;
    string[] toolchainSystemLibraries;

    public constructor(string[] librarySearchPaths, string[] systemFolders, MacosSdk macosSdk) {
        this.toolchainLibrarySearchPaths = librarySearchPaths;
        this.toolchainSystemFolders = systemFolders;
        this.toolchainMacosSdk = macosSdk;
        this.toolchainSystemLibraries = [];
    }

    // This toolchain linking `files` for the target's system libraries rather than the machine's
    // own, with `sdkVersion` the version of the SDK the files were read from.
    export withSystemLibraries(string[] files, string sdkVersion) -> Toolchain {
        let changed = new Toolchain(this.toolchainLibrarySearchPaths, this.toolchainSystemFolders,
            new MacosSdk(this.toolchainMacosSdk.root(), sdkVersion,
                this.toolchainMacosSdk.unusableRoot()));
        changed.toolchainSystemLibraries = files;
        return changed;
    }

    // The link-only libraries that list what the target's system libraries export, linked by path
    // so the machine's own are never read. Empty when ens carries none for the target.
    export systemLibraries() -> string[] {
        return this.toolchainSystemLibraries;
    }

    // The folders the machine names for libraries: LIB's on Windows, and LIBRARY_PATH's elsewhere,
    // where each becomes both a search path and a runtime path so a program that links a shared
    // library found this way also loads it when it runs.
    export librarySearchPaths() -> string[] {
        return this.toolchainLibrarySearchPaths;
    }

    // The folders a Linux distribution keeps its own libraries in, when the program is built for
    // the machine building it: searched for the program's own native libraries after every other
    // folder, and never recorded as a place to load them from, since the system loads from them
    // already.
    export systemFolders() -> string[] {
        return this.toolchainSystemFolders;
    }

    export macosSdk() -> MacosSdk {
        return this.toolchainMacosSdk;
    }
}

// A machine that contributes nothing: no library folder and no SDK.
export bareToolchain() -> Toolchain {
    return new Toolchain([], [], new MacosSdk("", ""));
}
