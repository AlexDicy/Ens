// The argument vector a link runs under, built from the request and what the machine contributed.
// It is a pure function of those two values, so every platform's line can be pinned by a test
// wherever the tests happen to run.
import LinkerFlavor from flavor;
import flavor;
import Toolchain from toolchain;
import LinkRequest from request;
import triple;
import List from @std.collections.list;

// The whole vector, the linker's own name first, the way lld reads argument zero.
export argumentsFor(LinkRequest request, Toolchain toolchain) -> string[] {
    let selected = flavor.flavorOf(request.target());
    let arguments = new List<string>();
    arguments.push(flavor.linkerName(selected));
    switch (selected) {
        LinkerFlavor.Coff -> {
            appendCoff(arguments, request, toolchain);
        },
        LinkerFlavor.Elf -> {
            appendElf(arguments, request, toolchain);
        },
        LinkerFlavor.MachO -> {
            appendMachO(arguments, request, toolchain);
        },
    }
    return arguments.toArray();
}

// The COFF line. '/lldignoreenv' keeps lld-link from reading the variables meant for Microsoft's
// link.exe, such as LINK and _LINK_, so the folders LIB names are passed as '/libpath:' instead.
// '/Brepro' writes a hash of the output where the time it was linked would go, so linking the same
// program twice gives the same bytes. With the import libraries ens carries, the program starts at
// ens's own startup object, which the build puts first among the objects, and links the C runtime
// Windows ships with the system, so nothing of the machine's is read. Otherwise the default
// libraries are the static C runtime, the POSIX aliases the standard library calls (rmdir), and
// kernel32 for the stack walker a trace captures through.
appendCoff(List<string> arguments, LinkRequest request, Toolchain toolchain) {
    bool carried = toolchain.systemLibraries().length > 0;
    arguments.push("/nologo");
    arguments.push("/lldignoreenv");
    arguments.push("/subsystem:console");
    arguments.push("/Brepro");
    // A library built with profile guidance carries a call graph the linker would otherwise lay
    // the code out by, under names that statics in different objects share, so the layout would
    // follow pointer order and differ between two links of the same inputs. The code stays in
    // the order of the inputs.
    arguments.push("/call-graph-profile-sort:no");
    if (carried) {
        arguments.push("/entry:mainCRTStartup");
        arguments.push("/nodefaultlib");
    }
    for (let folder in toolchain.librarySearchPaths()) {
        arguments.push("/libpath:" + folder);
    }
    appendAll(arguments, request.objects());
    appendAll(arguments, request.libraryFiles());
    arguments.push("/out:" + request.output());
    if (carried) {
        appendAll(arguments, toolchain.systemLibraries());
        return;
    }
    arguments.push("/defaultlib:libcmt");
    arguments.push("/defaultlib:oldnames");
    arguments.push("/defaultlib:kernel32");
    for (let library in request.libraries()) {
        if (library == "msvcrt" || library == "libcmt") {
            continue;
        }
        arguments.push(library + ".lib");
    }
}

// Whether every library a Windows program names is one the import libraries ens carries already
// are, which is when it links against those: the system's own kernel32 and shell32 and the C
// runtime. A program that names any other library links the way that library was built, the
// static C runtime from the folders LIB names.
export carriedOnWindows(string[] libraries) -> bool {
    for (let library in libraries) {
        bool known = false;
        for (let carried in ["kernel32", "shell32", "ucrt", "msvcrt", "libcmt"]) {
            if (library.toLowerAscii() == carried) {
                known = true;
            }
        }
        if (!known) {
            return false;
        }
    }
    return true;
}

// The ELF line. The program starts at the startup object ens writes, which the build puts first
// among the objects, and links against the link-only libraries ens carries for the target, so the
// line names nothing of the machine's but the folders for the program's own libraries. A library
// glibc folded into its C library, such as 'pthread', is already one of those, so it is never
// named, and each carried library is recorded only when the program uses it.
appendElf(List<string> arguments, LinkRequest request, Toolchain toolchain) {
    arguments.push("--eh-frame-hdr");
    arguments.push("--gc-sections");
    arguments.push("-dynamic-linker");
    arguments.push(triple.dynamicLinkerFor(request.target().architecture()));
    arguments.push("-o");
    arguments.push(request.output());
    appendSearchPaths(arguments, toolchain);
    for (let folder in toolchain.systemFolders()) {
        arguments.push("-L" + folder);
    }
    appendAll(arguments, request.objects());
    appendAll(arguments, request.libraryFiles());
    for (let library in request.libraries()) {
        if (!carriedOnLinux(library)) {
            arguments.push("-l" + library);
        }
    }
    arguments.push("--as-needed");
    appendAll(arguments, toolchain.systemLibraries());
}

// Whether a library a manifest names for Linux is one the carried libraries already are: glibc's
// own, every one of which it folded into its C library, and the unwinder.
carriedOnLinux(string library) -> bool {
    for (let carried in ["c", "m", "pthread", "dl", "rt", "util", "anl", "gcc_s"]) {
        if (library == carried) {
            return true;
        }
    }
    return false;
}

// The Mach-O line. The platform version gives the linker the system the program targets and which
// SDK it was built against; libSystem carries the whole C runtime on this platform, so it is always
// linked and never named twice. When ens carries a link-only libSystem for the target, that file is
// linked and the SDK serves only the program's own libraries, so a program that links nothing else
// is linked the same way on every machine.
appendMachO(List<string> arguments, LinkRequest request, Toolchain toolchain) {
    string deploymentTarget = request.target().macosVersion();
    let sdk = toolchain.macosSdk();
    string sdkVersion = deploymentTarget;
    if (sdk.version().length > 0) {
        sdkVersion = sdk.version();
    }
    arguments.push("-arch");
    arguments.push(triple.appleArchitectureName(request.target().architecture()));
    arguments.push("-platform_version");
    arguments.push("macos");
    arguments.push(deploymentTarget);
    arguments.push(sdkVersion);
    arguments.push("-dead_strip");
    let ownLibraries = new List<string>();
    for (let library in request.libraries()) {
        if (library != "System") {
            ownLibraries.push(library);
        }
    }
    bool carried = toolchain.systemLibraries().length > 0;
    if (sdk.root().length > 0 && (!carried || ownLibraries.length() > 0)) {
        arguments.push("-syslibroot");
        arguments.push(sdk.root());
    }
    appendAll(arguments, request.objects());
    appendAll(arguments, request.libraryFiles());
    arguments.push("-o");
    arguments.push(request.output());
    appendSearchPaths(arguments, toolchain);
    if (carried) {
        appendAll(arguments, toolchain.systemLibraries());
    } else {
        arguments.push("-lSystem");
    }
    for (let library in ownLibraries) {
        arguments.push("-l" + library);
    }
}

// Each discovered folder as both a search path and a runtime path, so a program that links a shared
// library found this way also loads it when it runs.
appendSearchPaths(List<string> arguments, Toolchain toolchain) {
    for (let folder in toolchain.librarySearchPaths()) {
        arguments.push("-L" + folder);
        arguments.push("-rpath");
        arguments.push(folder);
    }
}

appendAll(List<string> arguments, string[] values) {
    for (let value in values) {
        arguments.push(value);
    }
}
