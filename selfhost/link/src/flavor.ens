// Which of the three object formats a target is linked in, and the linker each one uses.
import TargetTriple from @ens.target.triple;
import Platform from @std.platform;

// The object format the link produces. The assigned values are the ones the linker bridge selects
// its driver with, so a flavor crosses into C as its own number.
export enum LinkerFlavor {
    Coff = 0,
    Elf = 1,
    MachO = 2,
}

// The flavor the target links in: COFF on Windows, ELF on Linux and Mach-O on macOS.
export flavorOf(TargetTriple target) -> LinkerFlavor {
    return switch (target.platform()) {
        Platform.Windows -> LinkerFlavor.Coff,
        Platform.Linux -> LinkerFlavor.Elf,
        Platform.MacOS -> LinkerFlavor.MachO,
    };
}

// The name the flavor's linker is invoked under, which every driver takes as its first argument
// and uses in the diagnostics it prints.
export linkerName(LinkerFlavor flavor) -> string {
    return switch (flavor) {
        LinkerFlavor.Coff -> "lld-link",
        LinkerFlavor.Elf -> "ld.lld",
        LinkerFlavor.MachO -> "ld64.lld",
    };
}
