// Which of the three object formats a target is linked in, and the linker each one answers to.

// The object format the link produces. The assigned values are the ones the linker bridge selects
// its driver with, so a flavor crosses into C as its own number.
export enum LinkerFlavor {
    Coff = 0,
    Elf = 1,
    MachO = 2,
}

// The flavor a target triple links in. Windows targets link COFF and Apple targets Mach-O;
// everything else links ELF, the format every other supported system uses.
export flavorOf(string triple) -> LinkerFlavor {
    if (triple.contains("windows") || triple.contains("win32") || triple.contains("msvc")) {
        return LinkerFlavor.Coff;
    }
    if (triple.contains("darwin") || triple.contains("apple")) {
        return LinkerFlavor.MachO;
    }
    return LinkerFlavor.Elf;
}

// The name the flavor's linker is invoked under, which every driver reads as its first argument
// and uses in the diagnostics it prints.
export linkerName(LinkerFlavor flavor) -> string {
    return switch (flavor) {
        LinkerFlavor.Coff -> "lld-link",
        LinkerFlavor.Elf -> "ld.lld",
        LinkerFlavor.MachO -> "ld64.lld",
    };
}
