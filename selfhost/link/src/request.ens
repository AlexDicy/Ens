// One link to run: what goes in, what comes out, and which target it is for.

export final class LinkRequest {
    string[] requestObjects;
    string[] requestLibraries;
    string[] requestLibraryFiles;
    string requestOutput;
    string requestTriple;

    export constructor(string[] objects, string[] libraries, string[] libraryFiles, string output,
                       string triple) {
        this.requestObjects = objects;
        this.requestLibraries = libraries;
        this.requestLibraryFiles = libraryFiles;
        this.requestOutput = output;
        this.requestTriple = triple;
    }

    // The object files the program was compiled into.
    export objects() -> string[] {
        return this.requestObjects;
    }

    // Logical library names, the way a manifest's native declaration names them: the link spells
    // each one the way the target platform spells a library name.
    export libraries() -> string[] {
        return this.requestLibraries;
    }

    // Library files named outright, passed to the linker as written.
    export libraryFiles() -> string[] {
        return this.requestLibraryFiles;
    }

    // The executable to write.
    export output() -> string {
        return this.requestOutput;
    }

    // The target triple the objects were compiled for, which decides the flavor of the link.
    export triple() -> string {
        return this.requestTriple;
    }
}
