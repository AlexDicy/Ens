// What one link produced.

export final class LinkResult {
    bool resultLinked;
    string resultOutput;
    string resultProblem;

    public constructor(bool linked, string output, string problem = "") {
        this.resultLinked = linked;
        this.resultOutput = output;
        this.resultProblem = problem;
    }

    export linked() -> bool {
        return this.resultLinked;
    }

    // Everything the linker printed, in the order it printed it, empty when it printed nothing. A
    // successful link reports its warnings here and a failed one its reasons, always in the
    // linker's own words.
    export output() -> string {
        return this.resultOutput;
    }

    // A failure this package found after the linker finished, as a whole message, or empty text
    // when the linker's own output is the only account.
    export problem() -> string {
        return this.resultProblem;
    }
}
