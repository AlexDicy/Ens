// Linking a program: build the flavor's argument vector from the request and a toolchain already
// discovered, and run it. Discovery is a separate step, so a caller that links many programs
// searches the machine once and threads the toolchain it found through every link.
import Path from @std.fs;
import flavor;
import Toolchain from toolchain;
import LinkRequest from request;
import LinkResult from result;
import argv;
import shim;

// Links one program with a toolchain already discovered.
export link(LinkRequest request, Toolchain toolchain) -> LinkResult {
    let selectedFlavor = flavor.flavorOf(request.target());
    let outcome = shim.runLinker(selectedFlavor, argv.argumentsFor(request, toolchain),
        request.program());
    if (!outcome.linked()) {
        return outcome;
    }
    if (!Path(request.output()).isFile()) {
        return new LinkResult(false, outcome.output(), "linking finished without an error, but "
            + "'{request.output()}' is not there. Check whether another program, such as a virus "
            + "scanner, removed it");
    }
    return outcome;
}

// Runs the work of one command, which may link any number of programs, and then 'stop', once, so
// no linker thread is left running when the process ends. Nothing links after 'stop'.
export afterLastLink(() -> int work, () -> void stop) -> int {
    int code = work();
    stop();
    return code;
}

// What a program that links calls once on its way out, after its last link.
export stopLinkerThreads() {
    shim.stopLinker();
}

