// Linking a program: look around the machine, build the flavor's argument vector, run it. Discovery
// is a separate step so a caller that links many programs looks around once and threads the
// toolchain it found through every link.
import @std.system;
import flavor;
import Toolchain from toolchain;
import LinkRequest from request;
import LinkResult from result;
import argv;
import discovery;
import shim;

// Links one program with a toolchain already discovered.
export link(LinkRequest request, Toolchain toolchain) -> LinkResult {
    let selectedFlavor = flavor.flavorOf(request.triple());
    let outcome = shim.runLinker(selectedFlavor, argv.argumentsFor(request, toolchain));
    if (!outcome.linked()) {
        return outcome;
    }
    if (!system.isFile(request.output())) {
        return new LinkResult(false,
            "the linker reported success but wrote no '{request.output()}'");
    }
    return outcome;
}

// Links one program, looking around the machine first. The probes write beside the executable, a
// folder the link already writes to under a name no other link is using.
export link(LinkRequest request) -> LinkResult {
    let discovered = discovery.discover(flavor.flavorOf(request.triple()), request.triple(),
        request.output() + ".link-probe");
    return link(request, discovered);
}
