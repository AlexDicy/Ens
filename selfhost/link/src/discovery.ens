// Searching the machine for what a link line requires from it. This is the only part of linking
// that reads the environment or runs a program, and everything it finds becomes a Toolchain value,
// so the line itself is built from values alone. The flavor determines what is worth searching for.
import Path from @std.fs;
import Environment from @std.environment;
import ProcessError from @std.process;
import @std.process;

import List from @std.collections.list;
import LinkerFlavor from flavor;
import flavor;
import Toolchain from toolchain;
import MacosSdk from toolchain;
import TargetTriple from @ens.target.triple;
import triple;

// Everything this machine contributes to a link for the given target, where `runsHere` is whether
// the program is built for this machine itself. Nothing here fails: a query the machine cannot
// satisfy leaves its part of the toolchain empty, and the link line then simply reports less.
export discover(TargetTriple target, bool runsHere) -> Toolchain {
    // The variables are read once here, at this layer's own boundary, so nothing below reads the
    // process about itself.
    let variables = Environment.current();
    return switch (flavor.flavorOf(target)) {
        LinkerFlavor.Coff -> coffToolchain(variables),
        LinkerFlavor.Elf -> elfToolchain(variables, target, runsHere),
        LinkerFlavor.MachO -> machoToolchain(variables),
    };
}

// The folders a search-path variable names, in the order it names them, with empty entries dropped.
// Unset gives none, which leaves an ordinary link untouched. LIBRARY_PATH separates them with ':',
// as the C compilers that read it do, and LIB with ';', as Microsoft's tools do.
export searchPathsFrom(string? value, string separator) -> string[] {
    let folders = new List<string>();
    if (value == null) {
        return folders.toArray();
    }
    for (let folder in value.split(separator)) {
        if (folder.length > 0) {
            folders.push(folder);
        }
    }
    return folders.toArray();
}

// The version an SDK folder's name spells out: 'MacOSX14.0.sdk' is 14.0. Empty when the name
// carries no version, and the link then reports the deployment target as the SDK version.
export sdkVersionFromRoot(string root) -> string {
    string name = Path(root).fileName();
    if (!name.startsWith("MacOSX") || !name.endsWith(".sdk")) {
        return "";
    }
    string version = name.substring(6, name.length - 4);
    bytes raw = version.toBytes();
    if (raw.length == 0) {
        return "";
    }
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] != '.' && (raw[i] < '0' || raw[i] > '9')) {
            return "";
        }
    }
    return version;
}

// lld-link brings its own C runtime and finds the Visual Studio and Windows SDK libraries itself,
// so the one thing the machine adds is the folders LIB names.
coffToolchain(Environment variables) -> Toolchain {
    return new Toolchain(searchPathsFrom(variables.get("LIB"), ";"), [], new MacosSdk("", ""));
}

// What LIBRARY_PATH names, and, for a program built for this machine, the folders its distribution
// keeps libraries in, for the program's own native libraries. The system libraries come from ens.
elfToolchain(Environment variables, TargetTriple target, bool runsHere) -> Toolchain {
    let folders = new List<string>();
    if (runsHere) {
        for (let candidate in triple.systemFolderCandidates(target.architecture())) {
            if (Path(candidate).isDirectory()) {
                folders.push(candidate);
            }
        }
    }
    return new Toolchain(searchPathsFrom(variables.get("LIBRARY_PATH"), ":"), folders.toArray(),
        new MacosSdk("", ""));
}

machoToolchain(Environment variables) -> Toolchain {
    return new Toolchain(searchPathsFrom(variables.get("LIBRARY_PATH"), ":"), [],
        macosSdk(variables));
}

// The macOS SDK to link against: the one SDKROOT names, else the one xcrun selects. Empty when
// neither is found, and the link then reaches the system libraries by their absolute paths.
macosSdk(Environment variables) -> MacosSdk {
    string root = variables.get("SDKROOT") ?? "";
    if (root.length == 0) {
        root = printedByProgram("xcrun", ["--show-sdk-path"]) ?? "";
    }
    if (root.length == 0 || !Path(root).isDirectory()) {
        return new MacosSdk("", "");
    }
    return new MacosSdk(root, sdkVersionFromRoot(root));
}

// What a program printed on its standard output, trimmed: null when it could not be run or
// reported failure, so a machine without the program is never mistaken for one that printed nothing.
printedByProgram(string program, string[] arguments) -> string? {
    let asked = try process.run(Path(program), arguments, captureOutput: true);
    if (!asked.status.succeeded()) {
        return null;
    }
    return asked.stdout.trim();
} catch (ProcessError refused) {
    return null;
}
