// Searching the machine for what a link line requires from it. This is the only part of linking
// that reads the environment or runs a program, and everything it finds becomes a Toolchain value,
// so the line itself is built from values alone. The flavor determines what is worth searching for.
import Path from @std.fs;
import Environment from @std.environment;
import ProcessError from @std.process;
import @std.process;

import List from @std.collections.list;
import LinkerFlavor from flavor;
import Toolchain from toolchain;
import ElfRuntime from toolchain;
import MacosSdk from toolchain;
import toolchain;
import triple;

// Everything this machine contributes to a link for the given target. Nothing here fails: a
// query the machine cannot satisfy leaves its part of the toolchain empty, and the link line then
// simply reports less.
export discover(LinkerFlavor selectedFlavor, string targetTriple) -> Toolchain {
    // The variables are read once here, at this layer's own boundary, so nothing below reads the
    // process about itself.
    let variables = Environment.current();
    return switch (selectedFlavor) {
        LinkerFlavor.Coff -> toolchain.bareToolchain(),
        LinkerFlavor.Elf -> elfToolchain(variables, targetTriple),
        LinkerFlavor.MachO -> machoToolchain(variables),
    };
}

// The folders a LIBRARY_PATH value names, in the order it names them, with empty entries dropped.
// Unset gives none, which leaves an ordinary link untouched. The separator is ':', the one the C
// compilers that read this variable use.
export searchPathsFrom(string? libraryPath) -> string[] {
    let folders = new List<string>();
    if (libraryPath == null) {
        return folders.toArray();
    }
    for (let folder in libraryPath.split(":")) {
        if (folder.length > 0) {
            folders.push(folder);
        }
    }
    return folders.toArray();
}

// The version an SDK folder's name spells out: 'MacOSX14.0.sdk' is 14.0. Empty when the name
// carries no version, and the link then reports the deployment target as the SDK version.
export sdkVersionFromRoot(string root) -> string {
    string name = Path(root).fileName();
    if (!name.startsWith("MacOSX") || !name.endsWith(".sdk")) {
        return "";
    }
    string version = name.substring(6, name.length - 4);
    byte[] raw = version.toBytes();
    if (raw.length == 0) {
        return "";
    }
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] != '.' && (raw[i] < '0' || raw[i] > '9')) {
            return "";
        }
    }
    return version;
}

elfToolchain(Environment variables, string targetTriple) -> Toolchain {
    return new Toolchain(searchPathsFrom(variables.get("LIBRARY_PATH")),
        firstExistingFile(triple.dynamicLinkerCandidates(targetTriple)), elfRuntime(),
        new MacosSdk("", ""));
}

machoToolchain(Environment variables) -> Toolchain {
    return new Toolchain(searchPathsFrom(variables.get("LIBRARY_PATH")), "",
        new ElfRuntime("", "", "", ""), macosSdk(variables));
}

// The C runtime pieces of the first of cc, clang and gcc this machine can run. One compiler serves
// every query, so a machine with several of them never ends up mixing two C runtimes.
elfRuntime() -> ElfRuntime {
    for (let compiler in ["cc", "clang", "gcc"]) {
        let startupObject = compilerFile(compiler, "Scrt1.o");
        if (startupObject == null) {
            continue;
        }
        return new ElfRuntime(startupObject,
            compilerFile(compiler, "crti.o") ?? "",
            compilerFile(compiler, "crtn.o") ?? "",
            unwinderArchive(compiler));
    }
    return new ElfRuntime("", "", "", "");
}

// The static unwinder to link, preferring LLVM's over GCC's. Empty when the compiler ships neither,
// and the link falls back to the shared libgcc_s.
unwinderArchive(string compiler) -> string {
    for (let archive in ["libunwind.a", "libgcc_eh.a"]) {
        string found = compilerFile(compiler, archive) ?? "";
        if (found.length > 0) {
            return found;
        }
    }
    return "";
}

// Where the C compiler keeps one of its own files, as it reports it: null when the compiler could
// not be run at all, so the next candidate gets a turn, and empty when it ran but has no such
// file, which it reports by echoing the name back unchanged.
compilerFile(string compiler, string fileName) -> string? {
    let printed = printedByProgram(compiler, ["-print-file-name=" + fileName]);
    if (printed == null) {
        return null;
    }
    if (printed == fileName || !Path(printed).isFile()) {
        return "";
    }
    return printed;
}

// The macOS SDK to link against: the one SDKROOT names, else the one xcrun selects. Empty when
// neither is found, and the link then reaches the system libraries by their absolute paths.
macosSdk(Environment variables) -> MacosSdk {
    string root = variables.get("SDKROOT") ?? "";
    if (root.length == 0) {
        root = printedByProgram("xcrun", ["--show-sdk-path"]) ?? "";
    }
    if (root.length == 0 || !Path(root).isDirectory()) {
        return new MacosSdk("", "");
    }
    return new MacosSdk(root, sdkVersionFromRoot(root));
}

// What a program printed on its standard output, trimmed: null when it could not be run or
// reported failure, so a machine without the program is never mistaken for one that printed nothing.
printedByProgram(string program, string[] arguments) -> string? {
    let asked = try process.run(Path(program), arguments, captureOutput: true);
    if (!asked.status.succeeded()) {
        return null;
    }
    return asked.stdout.trim();
} catch (ProcessError refused) {
    return null;
}

firstExistingFile(string[] candidates) -> string {
    for (let candidate in candidates) {
        if (Path(candidate).isFile()) {
            return candidate;
        }
    }
    return "";
}
