// The bridge into lld. lld has no C interface of its own, so the ens-lld library wraps its three
// drivers behind a C entry point; this module is the only place the bridge's entries are named,
// since an external declaration belongs to the file that writes it.
import LinkerFlavor from flavor;
import LinkResult from result;
import @std.ffi;
import @std.io;
import IoError from @std.io.streams;

public external type LinkerOutput;

external from lld {
    ens_lld_link_program(int selectedFlavor, byte[] argumentBlock, long argumentCount,
                         string program, out LinkerOutput? printed) -> int;
    ens_lld_free(LinkerOutput printed);
    ens_lld_shutdown();
}

// Stops the thread pool the linker runs its parallel steps on. A stopped pool is never started
// again, so nothing may link after this.
public stopLinker() {
    ens_lld_shutdown();
}

// Runs one finished argument vector through the linker and lifts everything it printed into an Ens
// string. The text the bridge allocated is released through the bridge, so it is freed by whoever
// allocated it. 'program' is the program the build reports linking, which the bridge names if the
// linker ends the process.
public runLinker(LinkerFlavor selectedFlavor, string[] arguments, string program) -> LinkResult {
    flushPrinted();
    LinkerOutput? printed = null;
    let status = ens_lld_link_program(selectedFlavor as int, argumentBlock(arguments),
        arguments.length, program, out printed);
    string reported = "";
    if (printed != null) {
        reported = ffi.fromCString(printed) ?? "";
        ens_lld_free(printed);
    }
    return new LinkResult(status == 0, reported);
}

// Hands everything this process has printed to the operating system, since the linker can end the
// process, and what is still in a buffer then is lost. A flush that fails loses nothing the link
// depends on.
flushPrinted() {
    try io.flush();
    try io.err().flush();
} catch (IoError ignored) {
}

// Every argument's bytes with a NUL after it, the block the bridge reads the vector out of. An Ens
// string array cannot cross into C as a 'char**', so the arguments are passed as one buffer and a
// count, the shape a spawned process already passes its arguments in.
argumentBlock(string[] arguments) -> byte[] {
    long total = 0;
    for (let argument in arguments) {
        total = total + argument.length + 1;
    }
    byte[] block = new byte[total];
    long at = 0;
    for (let argument in arguments) {
        byte[] raw = argument.toBytes();
        for (long i = 0; i < raw.length; i++) {
            block[at] = raw[i];
            at++;
        }
        block[at] = 0;
        at++;
    }
    return block;
}
