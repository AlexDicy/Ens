// The bridge into lld. lld has no C interface of its own, so the ens-lld library wraps its three
// drivers behind one C entry point; this module is the only place that entry point is named, since
// an external declaration belongs to the file that writes it.
import LinkerFlavor from flavor;
import LinkResult from result;
import @std.ffi;

public external type LinkerOutput;

external from lld {
    ens_lld_link(int selectedFlavor, byte[] argumentBlock, long argumentCount,
                 out LinkerOutput? printed) -> int;
    ens_lld_free(LinkerOutput printed);
}

// Runs one finished argument vector through the linker and lifts everything it printed into an Ens
// string. The text the bridge allocated is released through the bridge, so it is freed by whoever
// allocated it.
public runLinker(LinkerFlavor selectedFlavor, string[] arguments) -> LinkResult {
    LinkerOutput? printed = null;
    let status = ens_lld_link(selectedFlavor as int, argumentBlock(arguments), arguments.length,
        out printed);
    string reported = "";
    if (printed != null) {
        reported = ffi.fromCString(printed) ?? "";
        ens_lld_free(printed);
    }
    return new LinkResult(status == 0, reported);
}

// Every argument's bytes with a NUL after it, the block the bridge reads the vector out of. An Ens
// string array cannot cross into C as a 'char**', so the arguments travel as one buffer and a
// count, the shape a spawned process already passes its arguments in.
argumentBlock(string[] arguments) -> byte[] {
    long total = 0;
    for (let argument in arguments) {
        total = total + argument.length + 1;
    }
    byte[] block = new byte[total];
    long at = 0;
    for (let argument in arguments) {
        byte[] raw = argument.toBytes();
        for (long i = 0; i < raw.length; i++) {
            block[at] = raw[i];
            at++;
        }
        block[at] = 0;
        at++;
    }
    return block;
}
