// The parts of a target a link line quotes: the architecture as Apple's linker spells it, the
// dynamic linker an ELF program loads through, and where Linux keeps its own libraries.
import Architecture from @ens.target.triple;

// The architecture spelled the way Apple's linker spells it.
export appleArchitectureName(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "x86_64",
        Architecture.Arm64 -> "arm64",
    };
}

// The loader a Linux program on the architecture starts through, at the path glibc's ABI fixes for
// it, which every distribution provides.
export dynamicLinkerFor(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "/lib64/ld-linux-x86-64.so.2",
        Architecture.Arm64 -> "/lib/ld-linux-aarch64.so.1",
    };
}

// The folders Linux distributions keep their libraries in for the architecture, in the order a C
// compiler searches them: Debian's per-architecture folders, then Fedora's, then the plain ones.
export systemFolderCandidates(Architecture architecture) -> string[] {
    string multiarch = switch (architecture) {
        Architecture.X64 -> "x86_64-linux-gnu",
        Architecture.Arm64 -> "aarch64-linux-gnu",
    };
    return ["/usr/lib/" + multiarch, "/lib/" + multiarch, "/usr/lib64", "/lib64", "/usr/lib",
        "/lib"];
}
