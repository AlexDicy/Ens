// The parts of a target triple a link line quotes: the architecture, the macOS version a Mach-O
// program deploys to, and the dynamic linker an ELF program loads through.
import Architecture from @ens.target.triple;

// The architecture spelled the way Apple's linker spells it.
export appleArchitectureName(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "x86_64",
        Architecture.Arm64 -> "arm64",
    };
}

export final class Macos {
    // The oldest macOS an Ens program is built to run on when nothing names a version.
    export static const string oldestVersion = "11.0";
}

// The macOS version the triple deploys to: the version an 'x86_64-apple-macosx14.0' triple spells
// out, or the oldest supported one when the triple names the system without one, so a program built
// on a recent machine still runs on an older one.
export macosDeploymentTarget(string triple) -> string {
    long named = triple.indexOf("macosx");
    if (named < 0) {
        return Macos.oldestVersion;
    }
    string version = versionAt(triple, named + 6);
    if (version.length == 0) {
        return Macos.oldestVersion;
    }
    return version;
}

// The target to build for on the machine the given triple describes. A Mac names itself by its
// kernel's version, which code generation treats as that machine's own system, so naming the system
// and its version outright is what makes the objects and the link line deploy to the same one.
// Every other machine already names its target the way a build requires it, and a target requested by
// name is left as it was requested.
export defaultTargetFor(string hostTriple) -> string {
    long apple = hostTriple.indexOf("-apple-");
    if (apple < 0 || hostTriple.indexOf("darwin") < 0) {
        return hostTriple;
    }
    return hostTriple.substring(0, apple) + "-apple-macosx" + Macos.oldestVersion;
}

// The dynamic linkers the architecture may load programs through, most specific first. An ELF link
// names the first one the machine actually has.
export dynamicLinkerCandidates(Architecture architecture) -> string[] {
    return switch (architecture) {
        Architecture.X64 -> ["/lib64/ld-linux-x86-64.so.2", "/lib/ld-linux-x86-64.so.2"],
        Architecture.Arm64 -> ["/lib/ld-linux-aarch64.so.1"],
    };
}

// The run of digits and dots starting at the given offset, empty when nothing there is a version.
versionAt(string text, long start) -> string {
    byte[] raw = text.toBytes();
    long end = start;
    while (end < raw.length && (raw[end] == '.' || (raw[end] >= '0' && raw[end] <= '9'))) {
        end++;
    }
    return text.substring(start, end);
}
