// The parts of a target a link line quotes: the architecture as Apple's linker spells it, and the
// dynamic linker an ELF program loads through.
import Architecture from @ens.target.triple;

// The architecture spelled the way Apple's linker spells it.
export appleArchitectureName(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "x86_64",
        Architecture.Arm64 -> "arm64",
    };
}

// The dynamic linkers the architecture may load programs through, most specific first. An ELF link
// names the first one the machine actually has.
export dynamicLinkerCandidates(Architecture architecture) -> string[] {
    return switch (architecture) {
        Architecture.X64 -> ["/lib64/ld-linux-x86-64.so.2", "/lib/ld-linux-x86-64.so.2"],
        Architecture.Arm64 -> ["/lib/ld-linux-aarch64.so.1"],
    };
}
