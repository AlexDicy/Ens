// The parts of a target triple a link line quotes: the architecture, the macOS version a Mach-O
// program deploys to, and the dynamic linker an ELF program loads through.

// The architecture the triple names, spelled the way Apple's linker spells it.
export architectureOf(string triple) -> string {
    long dash = triple.indexOf("-");
    string architecture = triple;
    if (dash >= 0) {
        architecture = triple.substring(0, dash);
    }
    if (architecture == "aarch64") {
        return "arm64";
    }
    return architecture;
}

// The macOS version the triple deploys to: the version an 'x86_64-apple-macosx14.0' triple spells
// out, or 11.0 when the triple names the system without one, so a program built on a recent
// machine still runs on an older one.
export macosDeploymentTarget(string triple) -> string {
    string oldestSupported = "11.0";
    long named = triple.indexOf("macosx");
    if (named < 0) {
        return oldestSupported;
    }
    string version = versionAt(triple, named + 6);
    if (version.length == 0) {
        return oldestSupported;
    }
    return version;
}

// The dynamic linkers the architecture may load programs through, most specific first. An ELF link
// names the first one the machine actually has; an architecture with no known loader gets none, and
// the program links without a '-dynamic-linker' argument.
export dynamicLinkerCandidates(string triple) -> string[] {
    switch (architectureOf(triple)) {
        "arm64" -> {
            return ["/lib/ld-linux-aarch64.so.1"];
        },
        "x86_64" -> {
            return ["/lib64/ld-linux-x86-64.so.2", "/lib/ld-linux-x86-64.so.2"];
        },
        "i386", "i686" -> {
            return ["/lib/ld-linux.so.2"];
        },
        default -> {
            return [];
        },
    }
}

// The run of digits and dots starting at the given offset, empty when nothing there is a version.
versionAt(string text, long start) -> string {
    byte[] raw = text.toBytes();
    long end = start;
    while (end < raw.length && (raw[end] == '.' || (raw[end] >= '0' && raw[end] <= '9'))) {
        end++;
    }
    return text.substring(start, end);
}
