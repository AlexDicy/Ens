// The bridge into lld, driven on the paths that go wrong. The linker writes its reasons through an
// out-parameter, so a failing link is the case that proves the parameter is a real variable and
// not a pointer the bridge writes into nowhere.
import @std.testing;
import Path from @std.fs;
import Platform from @std.environment;
import @std.environment;
import LinkerFlavor from flavor;
import toolchain;
import LinkRequest from request;
import linker;
import shim;

test "a link that cannot read its objects fails with the linker's own words" {
    let request = new LinkRequest(["there-is-no-such-object.o"], [], [],
        "there-is-no-such-program.exe", hostTriple());
    let outcome = linker.link(request, toolchain.bareToolchain());
    try testing.assertTrue(!outcome.linked(), "the linker claimed to link a missing object");
    try testing.assertTrue(outcome.output().length > 0,
        "the linker failed without saying anything");
    try testing.assertTrue(outcome.output().contains("there-is-no-such-object.o"),
        "the report does not name the missing object: {outcome.output()}");
    try testing.assertTrue(!Path("there-is-no-such-program.exe").exists(),
        "a failed link left an executable behind");
}

// An object the linker cannot read is an input it fails on rather than declines, and failing
// has to be reported instead of ending this process. The second link proves the
// linker returned from it usable, which is what every later link in the same run depends on.
test "a link that fails is reported, and the next link still runs" {
    Path folder = try scratchFolder("abandoned-link");
    Path object = folder.join("truncated.obj");
    Path program = folder.join("program.exe");
    try object.writeBytes(unreadableObject());

    let stopped = linker.link(new LinkRequest([object.toString()], [], [],
        program.toString(), hostTriple()), toolchain.bareToolchain());
    try testing.assertTrue(!stopped.linked(), "an object the linker cannot read linked");
    try testing.assertTrue(stopped.output().contains(object.toString()),
        "the report does not name the object the linker could not read: '{stopped.output()}'");
    try testing.assertTrue(!program.exists(),
        "a link the linker gave up on left a program behind");

    let next = linker.link(new LinkRequest(["there-is-no-such-object.o"], [], [],
        program.toString(), hostTriple()), toolchain.bareToolchain());
    try testing.assertTrue(!next.linked(), "the linker claimed to link a missing object");
    try testing.assertTrue(next.output().contains("there-is-no-such-object.o"),
        "the link after the one the linker gave up on reported: '{next.output()}'");
}

test "a link with no arguments at all is refused rather than run" {
    string[] nothing = [];
    let outcome = shim.runLinker(LinkerFlavor.Coff, nothing);
    try testing.assertTrue(!outcome.linked(), "an empty argument vector reported success");
    try testing.assertEqual(outcome.output(), "no linker arguments were given");
}

// The first bytes of an x86-64 object file and nothing after them: a file the linker takes for an
// object by its magic and then cannot read at all.
unreadableObject() -> byte[] {
    return [0x64 as byte, 0x86 as byte, 0x01 as byte, 0x00 as byte, 0x00 as byte, 0x00 as byte,
        0x00 as byte, 0x00 as byte];
}

// A folder of its own for a test that writes files, under the build output so a run leaves nothing
// beside the sources.
scratchFolder(string name) -> Path throws {
    Path folder = environment.currentDirectory().join("build/ens-link-tests").join(name);
    try folder.createDirectories();
    return folder;
}

// The triple of the machine the tests run on, so the failing link goes through the flavor this
// machine actually links with.
hostTriple() -> string {
    switch (environment.platform()) {
        Platform.Windows -> {
            return "x86_64-pc-windows-msvc";
        },
        Platform.MacOS -> {
            return "arm64-apple-macosx";
        },
        default -> {
            return "x86_64-unknown-linux-gnu";
        },
    }
}
