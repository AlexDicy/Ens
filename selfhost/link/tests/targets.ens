// The targets the tests link for, read the way a build reads its own.
import TargetTriple from @ens.target.triple;

// The target `text` names, for a test that names one this toolchain builds for.
public targetOf(string text) -> TargetTriple {
    let parsed = TargetTriple.parse(text);
    if (parsed == null) {
        panic("a test names '{text}', which is not a target this toolchain builds for");
    }
    return parsed;
}
