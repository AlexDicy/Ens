// The parts of a target a link line quotes.
import @std.testing;
import expect;
import Architecture from @ens.target.triple;
import triple;

test "the architecture is spelled the way Apple's linker spells it" {
    try testing.assertEqual(triple.appleArchitectureName(Architecture.X64), "x86_64");
    try testing.assertEqual(triple.appleArchitectureName(Architecture.Arm64), "arm64");
}

test "the loader candidates follow the architecture, most specific first" {
    try expect.arguments(triple.dynamicLinkerCandidates(Architecture.X64),
        ["/lib64/ld-linux-x86-64.so.2", "/lib/ld-linux-x86-64.so.2"]);
    try expect.arguments(triple.dynamicLinkerCandidates(Architecture.Arm64),
        ["/lib/ld-linux-aarch64.so.1"]);
}
