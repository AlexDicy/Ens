// The parts of a triple a link line quotes.
import @std.testing;
import expect;
import triple;

test "the architecture is the first part, spelled the way Apple's linker spells it" {
    try testing.assertEqual(triple.architectureOf("x86_64-pc-windows-msvc"), "x86_64");
    try testing.assertEqual(triple.architectureOf("aarch64-unknown-linux-gnu"), "arm64");
    try testing.assertEqual(triple.architectureOf("arm64-apple-macosx14.0"), "arm64");
    try testing.assertEqual(triple.architectureOf("x86_64"), "x86_64");
}

test "a versioned macOS triple deploys to the version it names" {
    try testing.assertEqual(triple.macosDeploymentTarget("arm64-apple-macosx14.0"), "14.0");
    try testing.assertEqual(triple.macosDeploymentTarget("arm64-apple-macosx13"), "13");
    try testing.assertEqual(triple.macosDeploymentTarget("x86_64-apple-macosx10.15.4"), "10.15.4");
}

test "a macOS triple with no version deploys to the oldest supported system" {
    try testing.assertEqual(triple.macosDeploymentTarget("arm64-apple-macosx"), "11.0");
    try testing.assertEqual(triple.macosDeploymentTarget("x86_64-apple-darwin23.6.0"), "11.0");
    try testing.assertEqual(triple.macosDeploymentTarget("arm64-apple-darwin"), "11.0");
}

test "a machine naming itself by its kernel is built for the oldest supported system" {
    try testing.assertEqual(triple.defaultTargetFor("arm64-apple-darwin25.5.0"),
        "arm64-apple-macosx11.0");
    try testing.assertEqual(triple.defaultTargetFor("x86_64-apple-darwin23.6.0"),
        "x86_64-apple-macosx11.0");
    try testing.assertEqual(triple.defaultTargetFor("arm64-apple-darwin"),
        "arm64-apple-macosx11.0");
}

test "the target a machine already names the way a build wants it is left alone" {
    try testing.assertEqual(triple.defaultTargetFor("x86_64-pc-windows-msvc"),
        "x86_64-pc-windows-msvc");
    try testing.assertEqual(triple.defaultTargetFor("x86_64-unknown-linux-gnu"),
        "x86_64-unknown-linux-gnu");
    try testing.assertEqual(triple.defaultTargetFor("arm64-apple-macosx14.0"),
        "arm64-apple-macosx14.0");
}

test "the default target and the deployment target it implies agree" {
    string settled = triple.defaultTargetFor("arm64-apple-darwin25.5.0");
    try testing.assertEqual(triple.macosDeploymentTarget(settled), triple.oldestMacos());
}

test "the loader candidates follow the architecture, most specific first" {
    try expect.arguments(triple.dynamicLinkerCandidates("x86_64-unknown-linux-gnu"),
        ["/lib64/ld-linux-x86-64.so.2", "/lib/ld-linux-x86-64.so.2"]);
    try expect.arguments(triple.dynamicLinkerCandidates("aarch64-unknown-linux-gnu"),
        ["/lib/ld-linux-aarch64.so.1"]);
    try expect.arguments(triple.dynamicLinkerCandidates("i686-unknown-linux-gnu"),
        ["/lib/ld-linux.so.2"]);
}

test "an architecture with no known loader gets none" {
    string[] none = [];
    try expect.arguments(triple.dynamicLinkerCandidates("riscv64-unknown-linux-gnu"), none);
}
