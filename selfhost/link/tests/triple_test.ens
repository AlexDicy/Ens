// The parts of a target a link line quotes, and where Linux keeps its own libraries.
import @std.testing;
import expect;
import Architecture from @ens.target.triple;
import triple;

test "the architecture is spelled the way Apple's linker spells it" {
    try testing.assertEqual(triple.appleArchitectureName(Architecture.X64), "x86_64");
    try testing.assertEqual(triple.appleArchitectureName(Architecture.Arm64), "arm64");
}

test "the loader is the one glibc's ABI fixes for the architecture" {
    try testing.assertEqual(triple.dynamicLinkerFor(Architecture.X64),
        "/lib64/ld-linux-x86-64.so.2");
    try testing.assertEqual(triple.dynamicLinkerFor(Architecture.Arm64),
        "/lib/ld-linux-aarch64.so.1");
}

test "the distribution folders follow the architecture, Debian's first" {
    try expect.arguments(triple.systemFolderCandidates(Architecture.Arm64), [
        "/usr/lib/aarch64-linux-gnu", "/lib/aarch64-linux-gnu", "/usr/lib64", "/lib64",
        "/usr/lib", "/lib",
    ]);
}
