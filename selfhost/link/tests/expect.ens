// Comparing two argument vectors so a difference names the argument that moved rather than printing
// two link lines side by side.
import @std.testing;
import @std.text.strings;

public arguments(string[] actual, string[] expected) throws {
    long shared = actual.length;
    if (expected.length < shared) {
        shared = expected.length;
    }
    for (long i = 0; i < shared; i++) {
        if (actual[i] != expected[i]) {
            try testing.fail("argument {i} is '{actual[i]}', expected '{expected[i]}'");
        }
    }
    if (actual.length != expected.length) {
        try testing.fail("the line has {actual.length} argument(s), expected {expected.length}: "
            + strings.joined(actual, " "));
    }
}
