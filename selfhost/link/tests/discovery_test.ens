// The rules discovery applies to what the machine tells it. The parts that read a value rather than
// the machine are checked directly, so the Linux and macOS rules hold wherever these tests run.
import @std.testing;
import LinkerFlavor from flavor;
import discovery;
import expect;

test "LIBRARY_PATH becomes one folder per entry, empty entries dropped" {
    try expect.arguments(discovery.searchPathsFrom("/first/lib:/second/lib"),
        ["/first/lib", "/second/lib"]);
    try expect.arguments(discovery.searchPathsFrom("/only/lib"), ["/only/lib"]);
    try expect.arguments(discovery.searchPathsFrom("/first/lib::/second/lib:"),
        ["/first/lib", "/second/lib"]);
}

test "an unset or empty LIBRARY_PATH contributes no folder" {
    string[] none = [];
    try expect.arguments(discovery.searchPathsFrom(null), none);
    try expect.arguments(discovery.searchPathsFrom(""), none);
    try expect.arguments(discovery.searchPathsFrom(":::"), none);
}

test "an SDK folder's name spells out its version" {
    try testing.assertEqual(discovery.sdkVersionFromRoot(
        "/Library/Developer/CommandLineTools/SDKs/MacOSX14.4.sdk"), "14.4");
    try testing.assertEqual(discovery.sdkVersionFromRoot("/SDKs/MacOSX15.sdk"), "15");
}

test "an SDK folder whose name carries no macOS version reports none" {
    try testing.assertEqual(discovery.sdkVersionFromRoot("/SDKs/MacOSX.sdk"), "");
    try testing.assertEqual(discovery.sdkVersionFromRoot("/SDKs/iPhoneOS17.0.sdk"), "");
    try testing.assertEqual(discovery.sdkVersionFromRoot("/SDKs/MacOSX14.4"), "");
    try testing.assertEqual(discovery.sdkVersionFromRoot(""), "");
}

test "a COFF link asks the machine nothing, because lld-link asks for itself" {
    let machine = discovery.discover(LinkerFlavor.Coff, "x86_64-pc-windows-msvc",
        "build/coff-discovery-probe");
    string[] none = [];
    try expect.arguments(machine.librarySearchPaths(), none);
    try testing.assertEqual(machine.dynamicLinker(), "");
    try testing.assertEqual(machine.elfRuntime().startupObject(), "");
    try testing.assertEqual(machine.macosSdk().root(), "");
}
