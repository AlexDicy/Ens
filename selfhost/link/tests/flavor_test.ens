// Which linker a triple picks, over the spellings a triple reaches this code in.
import @std.testing;
import LinkerFlavor from flavor;
import flavor;

test "a Windows triple links COFF however it spells the system" {
    string[] triples = ["x86_64-pc-windows-msvc", "x86_64-pc-windows-gnu", "i686-win32",
        "aarch64-pc-windows-msvc"];
    for (let triple in triples) {
        try testing.assertTrue(flavor.flavorOf(triple) == LinkerFlavor.Coff,
            "'{triple}' picked {flavor.flavorOf(triple)}");
    }
}

test "an Apple triple links Mach-O, versioned or not" {
    string[] triples = ["arm64-apple-macosx14.0", "x86_64-apple-macosx", "x86_64-apple-darwin23.6.0",
        "arm64-apple-darwin"];
    for (let triple in triples) {
        try testing.assertTrue(flavor.flavorOf(triple) == LinkerFlavor.MachO,
            "'{triple}' picked {flavor.flavorOf(triple)}");
    }
}

test "every other triple links ELF" {
    string[] triples = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-musl",
        "riscv64-unknown-linux-gnu", "x86_64-unknown-freebsd"];
    for (let triple in triples) {
        try testing.assertTrue(flavor.flavorOf(triple) == LinkerFlavor.Elf,
            "'{triple}' picked {flavor.flavorOf(triple)}");
    }
}

test "each flavor is invoked under the name its linker answers to" {
    try testing.assertEqual(flavor.linkerName(LinkerFlavor.Coff), "lld-link");
    try testing.assertEqual(flavor.linkerName(LinkerFlavor.Elf), "ld.lld");
    try testing.assertEqual(flavor.linkerName(LinkerFlavor.MachO), "ld64.lld");
}
