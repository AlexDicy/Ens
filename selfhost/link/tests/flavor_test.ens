// Which linker a target picks, over the spellings a triple reaches this code in.
import @std.testing;
import LinkerFlavor from flavor;
import flavor;
import targets;

test "a Windows target links COFF however it spells the system" {
    for (let triple in ["x86_64-pc-windows-msvc", "x86_64-pc-win32", "aarch64-pc-windows-msvc"]) {
        try expectFlavor(triple, LinkerFlavor.Coff);
    }
}

test "a macOS target links Mach-O, versioned or not" {
    for (let triple in ["arm64-apple-macosx14.0", "x86_64-apple-macosx",
            "x86_64-apple-darwin23.6.0", "arm64-apple-darwin"]) {
        try expectFlavor(triple, LinkerFlavor.MachO);
    }
}

test "a Linux target links ELF" {
    for (let triple in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
            "arm64-unknown-linux-gnu"]) {
        try expectFlavor(triple, LinkerFlavor.Elf);
    }
}

test "each flavor is invoked under the name its linker accepts" {
    try testing.assertEqual(flavor.linkerName(LinkerFlavor.Coff), "lld-link");
    try testing.assertEqual(flavor.linkerName(LinkerFlavor.Elf), "ld.lld");
    try testing.assertEqual(flavor.linkerName(LinkerFlavor.MachO), "ld64.lld");
}

expectFlavor(string triple, LinkerFlavor expected) throws {
    let picked = flavor.flavorOf(targets.targetOf(triple));
    try testing.assertTrue(picked == expected, "'{triple}' picked {picked}");
}
