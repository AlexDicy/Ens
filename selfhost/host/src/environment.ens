// The environment a command was started with, as one value read once at the boundary and carried
// from there, so every part of a run reads the same snapshot. Which system the process runs on
// belongs to it too, because Windows matches a variable's name without regard to case.

export final class Environment {
    string[] entries;
    string systemName;

    // `entries` are the 'NAME=VALUE' entries the process inherited, and `platform` is the system it
    // is running on, named the way '@std.system.platform' names one.
    export constructor(string[] entries, string platform) {
        this.entries = entries;
        this.systemName = platform;
    }

    // What the named variable is set to, or empty text when the environment does not set it or sets
    // it to nothing. A variable set to nothing is a variable that says nothing, which is what every
    // reader of one here wants.
    export value(string name) -> string {
        for (let entry in this.entries) {
            long separator = entry.indexOf("=");
            if (separator < 0) {
                continue;
            }
            if (this.namesMatch(entry.substring(0, separator), name)) {
                return entry.substring(separator + 1, entry.length);
            }
        }
        return "";
    }

    // The system this environment was read on.
    export platform() -> string {
        return this.systemName;
    }

    namesMatch(string left, string right) -> bool {
        if (this.systemName != "windows") {
            return left == right;
        }
        if (left.length != right.length) {
            return false;
        }
        byte[] first = left.toBytes();
        byte[] second = right.toBytes();
        for (long i = 0; i < first.length; i++) {
            if (lowered(first[i]) != lowered(second[i])) {
                return false;
            }
        }
        return true;
    }
}

lowered(byte value) -> byte {
    if (value >= 'A' && value <= 'Z') {
        return (value + ('a' - 'A')) as byte;
    }
    return value;
}
