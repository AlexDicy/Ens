// A folder to work in that nothing keeps, removed again afterwards, so the tree a command was
// pointed at is left exactly as it was found. A free name is found by trying names in turn, since
// there is no clock to build one from, and claimed in one step so two runs cannot take the same.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Environment from @std.environment;
import Platform from @std.environment;
import home;

// A folder to work in, or the reason there is none.
export final class Scratch {
    Path folderPath;
    string problem;

    protected constructor(this.folderPath, this.problem);

    export folder() -> Path {
        return this.folderPath;
    }

    export failure() -> string {
        return this.problem;
    }
}

// The folder this system keeps work in progress in, or null when nothing says where that is.
// Windows names it TMP and TEMP, every other system names it TMPDIR, and all three are read
// wherever the run is so a machine set up the other way still answers.
export temporaryFolder(Environment environment) -> Path? {
    for (let name in temporaryVariables(environment.platform())) {
        string? named = environment.get(name);
        if (named != null && named.length > 0) {
            return Path.fromNative(named, environment.platform()).normalize();
        }
    }
    return conventionalFolder(environment);
}

// A folder of its own under the system's, named after what it is for.
export create(Environment environment, string prefix) -> Scratch {
    Path? root = temporaryFolder(environment);
    if (root == null) {
        return new Scratch(Path(""), "there is nowhere to build: nothing in the environment says "
            + "where this system keeps work in progress. Set " + temporaryVariable(environment)
            + " to a folder that can be written to");
    }
    return createUnder(root, prefix);
}

// A folder of its own under the given one, named after what it is for. The name is the first of
// '<prefix>-1', '<prefix>-2' and so on that is not taken, and claiming it is one step, so two runs
// at once take two folders. Which folder to work under is the caller's, because a move out of a
// folder costs what the distance to its destination costs.
export createUnder(Path root, string prefix) -> Scratch {
    for (long attempt = 1; attempt <= Attempts.limit; attempt++) {
        Path candidate = root.join("{prefix}-{attempt}");
        if (candidate.exists()) {
            continue;
        }
        bool mine = try claimed(candidate);
        if (mine) {
            return new Scratch(candidate, "");
        }
    }
    return new Scratch(Path(""), "there is no free name left under '{root}': it already holds "
        + "'{prefix}-1' through '{prefix}-{Attempts.limit}'. Remove the folders left behind by "
        + "runs that did not finish");
} catch (FileSystemError refused) {
    return new Scratch(Path(""), "'{root}' could not be worked under: {refused.message}");
}

// Removes the folder and everything under it. Answers with "" when nothing is left, or with what
// stopped it, which a caller reports without letting it decide the run's own outcome.
export discard(Path folder) -> string {
    if (folder.isEmpty() || !folder.isDirectory()) {
        return "";
    }
    try folder.removeRecursively();
    return "";
} catch (FileSystemError refused) {
    return "'{folder}' could not be removed after the run: {refused.message}";
}

// Whether this run is the one that took the folder. Asking whether a name is free and then creating it
// would be two steps, with room between them for another run to take the same name, so the folder is
// created in one step that says whether it was this run that created it: of two runs asking at the
// same instant, exactly one gets the name and the other looks for one of its own.
public claimed(Path folder) -> bool throws FileSystemError {
    return try folder.createDirectoryExclusive();
}

final class Attempts {
    // How many names are tried before a run gives up on finding a free one. Enough that a machine
    // running many builds at once never runs out, and few enough that a folder full of leftovers
    // is reported rather than scanned forever.
    protected static const long limit = 512;
}

temporaryVariables(Platform platform) -> string[] {
    if (platform == Platform.Windows) {
        return ["TMP", "TEMP", "TMPDIR"];
    }
    return ["TMPDIR", "TMP", "TEMP"];
}

// The variable a reader of this system is told to set when none of them is.
temporaryVariable(Environment environment) -> string {
    if (environment.platform() == Platform.Windows) {
        return "TMP";
    }
    return "TMPDIR";
}

// Where the system keeps work in progress when it does not say: what each one conventionally uses.
conventionalFolder(Environment environment) -> Path? {
    if (environment.platform() != Platform.Windows) {
        return Path("/tmp");
    }
    Path? user = home.userFolder(environment);
    if (user == null) {
        return null;
    }
    return user.join("AppData/Local/Temp");
}
