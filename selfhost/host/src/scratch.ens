// A folder to work in that nothing keeps. A command that builds something only in order to run it
// builds it here and removes the folder afterwards, so the tree it was pointed at is left exactly
// as it was found.
//
// Where the folder goes is what the environment says: the snapshot carried from startup names the
// folder this system keeps work in progress in. A name nothing else holds is found by trying names
// in turn, because there is no clock and no counter to build one out of, and the name is then
// claimed in one step so that two runs starting at the same instant cannot take the same one.
import @std.system;
import SystemError from @std.system;
import @std.path;
import Environment from environment;
import home;

// A folder to work in, or the reason there is none.
export final class Scratch {
    string folderPath;
    string problem;

    protected constructor(this.folderPath, this.problem);

    export folder() -> string {
        return this.folderPath;
    }

    export failure() -> string {
        return this.problem;
    }
}

// The folder this system keeps work in progress in, or empty text when nothing says where that is.
// Windows names it TMP and TEMP, every other system names it TMPDIR, and all three are read
// wherever the run is so a machine set up the other way still answers.
export temporaryFolder(Environment environment) -> string {
    for (let name in temporaryVariables(environment.platform())) {
        string named = environment.value(name);
        if (named.length > 0) {
            return path.normalize(path.fromNative(named, environment.platform()));
        }
    }
    return conventionalFolder(environment);
}

// A folder of its own under the system's, named after what it is for.
export create(Environment environment, string prefix) -> Scratch {
    string root = temporaryFolder(environment);
    if (root.length == 0) {
        return new Scratch("", "there is nowhere to build: nothing in the environment says where "
            + "this system keeps work in progress. Set " + temporaryVariable(environment)
            + " to a folder that can be written to");
    }
    return createUnder(root, prefix);
}

// A folder of its own under the given one, named after what it is for. The name is the first of
// '<prefix>-1', '<prefix>-2' and so on that is not taken, and claiming it is one step, so two runs
// at once take two folders and a folder a run left behind is stepped over rather than reused.
//
// Which folder to work under is the caller's, because where it is decides what a move out of it
// costs: work that is going to be moved into a place is assembled beside that place.
export createUnder(string root, string prefix) -> Scratch {
    for (long attempt = 1; attempt <= attemptLimit(); attempt++) {
        string candidate = path.join(root, "{prefix}-{attempt}");
        if (system.exists(candidate)) {
            continue;
        }
        bool mine = try claimed(candidate);
        if (mine) {
            return new Scratch(candidate, "");
        }
    }
    return new Scratch("", "there is no free name left under '{root}': it already holds "
        + "'{prefix}-1' through '{prefix}-{attemptLimit()}'. Remove the folders left behind by "
        + "runs that did not finish");
} catch (SystemError error) {
    return new Scratch("", "'{root}' could not be worked under: {error.message}");
}

// Removes the folder and everything under it. Answers with "" when nothing is left, or with what
// stopped it, which a caller reports without letting it decide the run's own outcome.
export discard(string folder) -> string {
    if (folder.length == 0 || !system.isDirectory(folder)) {
        return "";
    }
    for (let entry in try system.listDirectory(folder)) {
        string child = path.join(folder, entry);
        if (system.isDirectory(child)) {
            string problem = discard(child);
            if (problem.length > 0) {
                return problem;
            }
            continue;
        }
        string problem = removed(child);
        if (problem.length > 0) {
            return problem;
        }
    }
    try system.removeDirectory(folder);
    return "";
} catch (SystemError error) {
    return "'{folder}' could not be removed after the run: {error.message}";
}

// Whether this run is the one that took the folder. Asking whether a name is free and then creating it
// would be two steps, with room between them for another run to take the same name, so the folder is
// created in one step that says whether it was this run that created it: of two runs asking at the
// same instant, exactly one gets the name and the other looks for one of its own.
public claimed(string folder) -> bool throws {
    return try system.createNewDirectory(folder);
}

// How many names are tried before a run gives up on finding a free one. Enough that a machine
// running many builds at once never runs out, and few enough that a folder full of leftovers is
// reported rather than scanned forever.
attemptLimit() -> long {
    return 512;
}

removed(string file) -> string {
    try system.removeFile(file);
    return "";
} catch (SystemError error) {
    return "'{file}' could not be removed after the run: {error.message}";
}

temporaryVariables(string platform) -> string[] {
    if (platform == "windows") {
        return ["TMP", "TEMP", "TMPDIR"];
    }
    return ["TMPDIR", "TMP", "TEMP"];
}

// The variable a reader of this system is told to set when none of them is.
temporaryVariable(Environment environment) -> string {
    if (environment.platform() == "windows") {
        return "TMP";
    }
    return "TMPDIR";
}

// Where the system keeps work in progress when it does not say: what each one conventionally uses.
conventionalFolder(Environment environment) -> string {
    if (environment.platform() != "windows") {
        return "/tmp";
    }
    string user = home.userFolder(environment);
    if (user.length == 0) {
        return "";
    }
    return path.join(user, "AppData/Local/Temp");
}
