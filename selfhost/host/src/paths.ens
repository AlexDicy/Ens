// Paths as the rest of a build reads them. Text that came from a command line is written the way
// the machine running the build writes a path, and every path here reads and writes '/', so this
// is the one place a build converts between the two.
import Path from @std.fs;
import @std.environment;

// The given text as a path, with the separators this machine writes turned into '/'.
export native(string given) -> Path {
    return Path.fromNative(given, environment.platform());
}

// A path as it reads from the folder a command was run in: converted, absolute, and normalized.
export resolved(string given, Path workingFolder) -> Path {
    return native(given).absolute(workingFolder);
}
