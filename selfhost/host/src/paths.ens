// Path text as the rest of a build reads it. Text that came from a command line is written the way
// the machine running the build writes a path, and every path function reads and writes '/', so this
// is the one place a build converts between the two.
import @std.path;
import @std.system;

// The same path with the separators this machine writes turned into '/'.
export native(string given) -> string {
    return path.fromNative(given, system.platform());
}

// A path as it reads from the folder a command was run in: converted, absolute, and normalized.
export resolved(string given, string workingFolder) -> string {
    return path.absolute(native(given), workingFolder);
}
