// The exit code a command returns for a child it ran.
import ExitStatus from @std.process;

// The code for a child that has ended: its own when it exited, and 128 above the signal when one
// ended it, which is the number every shell reports for a program a signal stopped and so the
// number a caller reads as a command's exit code.
export exitCodeOf(ExitStatus status) -> int {
    if (status.signal != 0) {
        return 128 + status.signal;
    }
    return status.code;
}
