// Where Ens keeps what belongs to the user running it. The toolchains a version hop reaches for and
// the packages a build downloads sit side by side under one folder, so both are found the same way
// and neither has to know how the other is laid out.
import Path from @std.fs;
import Environment from @std.environment;
import Platform from @std.environment;

// The folder the system says belongs to the user, or null when it says nothing. Windows names it
// USERPROFILE and every other system names it HOME, so the answer follows the environment the
// snapshot was read on rather than the one this toolchain was built for.
export userFolder(Environment environment) -> Path? {
    string? named = environment.get(userFolderVariable(environment.platform()));
    if (named == null || named.length == 0) {
        return null;
    }
    return Path.fromNative(named, environment.platform()).normalize();
}

// The folder Ens keeps `name` in for this user, or null when the user's own folder is unknown.
export ensFolder(Environment environment, string name) -> Path? {
    Path? user = userFolder(environment);
    if (user == null) {
        return null;
    }
    return user.join(".ens").join(name);
}

userFolderVariable(Platform platform) -> string {
    if (platform == Platform.Windows) {
        return "USERPROFILE";
    }
    return "HOME";
}
