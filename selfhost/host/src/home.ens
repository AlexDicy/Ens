// Where Ens keeps what belongs to the user running it. The toolchains a version hop reaches for and
// the packages a build downloads are side by side under one folder, so both are found the same way
// and neither depends on how the other is laid out.
import Path from @std.fs;
import Environment from @std.environment;
import Platform from @std.platform;

// The folder the system reports as the user's, or null when it reports none. It follows the
// environment the snapshot was read on rather than the one this toolchain was built for.
export userFolder(Environment environment) -> Path? {
    return environment.homeDirectory();
}

// The folder Ens keeps `name` in for this user, or null when the user's own folder is unknown.
export ensFolder(Environment environment, string name) -> Path? {
    Path? user = userFolder(environment);
    if (user == null) {
        return null;
    }
    return user.join(".ens").join(name);
}

// The variable `platform` names the user's own folder with.
export userFolderVariable(Platform platform) -> string {
    if (platform == Platform.Windows) {
        return "USERPROFILE";
    }
    return "HOME";
}
