// Where Ens keeps a user's own folders. Which variable names the user's folder is a rule about the
// system the environment was read on, so both rules are checked on whichever system runs the tests.
import @std.testing;
import Path from @std.fs;
import Environment from @std.environment;
import Platform from @std.environment;
import home;
import support;

test "Windows names the user's folder USERPROFILE" {
    let read = windows(["USERPROFILE=C:\\Users\\Ada", "HOME=/home/ada"]);
    try testing.assertEqual(home.userFolder(read), Path("C:/Users/Ada"));
}

test "every other system names it HOME" {
    let read = linux(["USERPROFILE=C:\\Users\\Ada", "HOME=/home/ada"]);
    try testing.assertEqual(home.userFolder(read), Path("/home/ada"));
}

test "an environment that names no user folder knows of none" {
    let read = linux(["PATH=/usr/bin"]);
    try testing.assertTrue(home.userFolder(read) == null, "no variable names the user's folder");
    try testing.assertTrue(home.ensFolder(read, "toolchains") == null,
        "and nothing of Ens can be found under it");
}

test "Ens keeps its own folders under '.ens' in the user's folder" {
    let posix = linux(["HOME=/home/ada"]);
    try testing.assertEqual(home.ensFolder(posix, "toolchains"),
        Path("/home/ada/.ens/toolchains"));
    try testing.assertEqual(home.ensFolder(posix, "cache"), Path("/home/ada/.ens/cache"));
    let windowsRead = windows(["USERPROFILE=C:\\Users\\Ada"]);
    try testing.assertEqual(home.ensFolder(windowsRead, "toolchains"),
        Path("C:/Users/Ada/.ens/toolchains"));
}

windows(string[] entries) -> Environment {
    return support.given(Platform.Windows, entries);
}

linux(string[] entries) -> Environment {
    return support.given(Platform.Linux, entries);
}
