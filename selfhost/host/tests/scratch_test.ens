// The folder a run builds in and then removes: where the system keeps work in progress, the name a
// run takes there, and the removal that leaves nothing behind.
import @std.testing;
import Path from @std.fs;
import ErrorKind from @std.fs.error;
import FileSystemError from @std.fs.error;
import Environment from @std.environment;
import Platform from @std.environment;
import @std.environment;
import Retry from scratch;
import scratch;
import support;

test "the environment names the folder work in progress goes in" {
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMP=C:\\Work\\Temp"])),
        Path("C:/Work/Temp"));
    try testing.assertEqual(scratch.temporaryFolder(windows(["TEMP=C:\\Other"])),
        Path("C:/Other"));
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMPDIR=C:\\Third"])),
        Path("C:/Third"));
    try testing.assertEqual(scratch.temporaryFolder(linux(["TMPDIR=/var/tmp"])),
        Path("/var/tmp"));
    try testing.assertEqual(scratch.temporaryFolder(linux(["TMP=/scratch"])), Path("/scratch"));
}

test "TMP wins on Windows and TMPDIR everywhere else" {
    string[] all = ["TMP=/from-tmp", "TEMP=/from-temp", "TMPDIR=/from-tmpdir"];
    try testing.assertEqual(scratch.temporaryFolder(windows(all)), Path("/from-tmp"));
    try testing.assertEqual(scratch.temporaryFolder(linux(all)), Path("/from-tmpdir"));
}

test "a variable set to nothing counts as unset" {
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMP=", "TEMP=C:\\Fallback"])),
        Path("C:/Fallback"));
}

test "an environment that names no folder falls back to what the system conventionally uses" {
    try testing.assertEqual(scratch.temporaryFolder(linux(["HOME=/home/ada"])), Path("/tmp"));
    try testing.assertEqual(scratch.temporaryFolder(windows(["USERPROFILE=C:\\Users\\Ada"])),
        Path("C:/Users/Ada/AppData/Local/Temp"));
}

test "a Windows environment that names neither the temp folder nor the user has nowhere to build" {
    string[] nothing = [];
    try testing.assertTrue(scratch.temporaryFolder(windows(nothing)) == null,
        "nothing in the environment says where to build");
    let made = scratch.create(windows(nothing), "ens-run");
    try testing.assertTrue(made.folder().isEmpty(), "so no folder was made");
    try testing.assertEqual(made.failure(), "could not find a folder for temporary files: none "
        + "of 'TMP', 'TEMP' and 'TMPDIR' is set, and neither is 'USERPROFILE'. Set 'TMP' to a "
        + "folder that can be written to");
}

test "a run takes the first free name under the folder and creates it" {
    let rootFolder = try support.scratch("scratch-names");
    Path root = rootFolder.path();
    let read = here(root);

    let first = scratch.create(read, "ens-run");
    try testing.assertEqual(first.failure(), "");
    try testing.assertEqual(first.folder(), root.join("ens-run-1"));
    try testing.assertTrue(first.folder().isDirectory(), "the folder was created");

    let second = scratch.create(read, "ens-run");
    try testing.assertEqual(second.folder(), root.join("ens-run-2"));
    try testing.assertTrue(second.folder().isDirectory(), "the second folder was created");

    try testing.assertEqual(first.remove(), "");
    try testing.assertFalse(first.folder().isDirectory(), "the first folder is gone");
    let third = scratch.create(read, "ens-run");
    try testing.assertEqual(third.folder(), root.join("ens-run-1"));

    try testing.assertEqual(second.remove(), "");
    try testing.assertEqual(third.remove(), "");
}

// The marker of a run that ended part-way is a file nothing holds, which is what a run that was
// stopped leaves behind, since the system closes every file of a program that ends.
test "a folder whose run ended part-way is removed by the next run" {
    let rootFolder = try support.scratch("scratch-reclaim");
    Path root = rootFolder.path();
    Path ended = root.join("ens-run-4");
    try support.writeFile(ended, ".ens-owner", "");
    try support.writeFile(ended, "objects/staging-1/main.obj", "not really an object\n");

    let next = scratch.create(here(root), "ens-run");
    try testing.assertEqual(next.failure(), "");
    try testing.assertEqual(next.leftBehind().length, 0L);
    try testing.assertFalse(ended.exists(), "the folder of the run that ended is still there");
    try testing.assertEqual(next.remove(), "");
}

// The run holding the first folder is this one, through a marker of its own that it keeps open
// or locked. The second run reads it through a file of its own, as a run in another process does.
test "a folder whose run is still going is left alone" {
    let rootFolder = try support.scratch("scratch-held");
    Path root = rootFolder.path();
    let running = scratch.create(here(root), "ens-run");
    try support.writeFile(running.folder(), "program.exe", "not really a program\n");

    let next = scratch.create(here(root), "ens-run");
    try testing.assertEqual(next.folder(), root.join("ens-run-2"));
    try testing.assertEqual(next.leftBehind().length, 0L);
    try testing.assertTrue(running.folder().join("program.exe").exists(),
        "the folder of a run still going lost what it held");

    try testing.assertEqual(running.remove(), "");
    try testing.assertFalse(running.folder().exists(), "the run did not remove its own folder");
    try testing.assertEqual(next.remove(), "");
}

// A run that is still starting has created its folder and not marked it yet, which is what a
// folder with no marker looks like. A marker that is a folder is one that cannot be read.
test "a folder whose marker is missing or cannot be read is left alone" {
    let rootFolder = try support.scratch("scratch-unmarked");
    Path root = rootFolder.path();
    Path unmarked = root.join("ens-run-1");
    try support.writeFile(unmarked, "program.exe", "not really a program\n");
    Path unreadable = root.join("ens-run-2");
    try support.writeFile(unreadable, ".ens-owner/inside", "a folder where the marker goes\n");

    let next = scratch.create(here(root), "ens-run");
    try testing.assertEqual(next.folder(), root.join("ens-run-3"));
    try testing.assertEqual(next.leftBehind().length, 0L);
    try testing.assertTrue(unmarked.join("program.exe").exists(),
        "a folder with no marker was removed");
    try testing.assertTrue(unreadable.join(".ens-owner/inside").exists(),
        "a folder whose marker cannot be read was removed");
    try testing.assertEqual(next.remove(), "");
}

// A folder made under a given one, such as the one beside a program it is linked in, is marked and
// taken back the same way as one made under the system's.
test "a marked folder under a given one is removed by the next run once its run has ended" {
    let rootFolder = try support.scratch("scratch-reclaim-under");
    Path root = rootFolder.path();
    Path ended = root.join(".ens-link-2");
    try support.writeFile(ended, ".ens-owner", "");
    try support.writeFile(ended, "app.exe", "not really a program\n");

    let running = scratch.createMarkedUnder(root, ".ens-link");
    try testing.assertEqual(running.failure(), "");
    try testing.assertEqual(running.folder(), root.join(".ens-link-1"));
    try testing.assertEqual(running.leftBehind().length, 0L);
    try testing.assertFalse(ended.exists(), "the folder of the run that ended is still there");
    try support.writeFile(running.folder(), "app.exe", "not really a program\n");

    let next = scratch.createMarkedUnder(root, ".ens-link");
    try testing.assertEqual(next.folder(), root.join(".ens-link-2"));
    try testing.assertTrue(running.folder().join("app.exe").exists(),
        "the folder of a run still going lost what it held");

    try testing.assertEqual(next.remove(), "");
    try testing.assertEqual(running.remove(), "");
    try testing.assertFalse(running.folder().exists(), "the run did not remove its own folder");
}

test "only the folders named after the prefix and a number are taken for leftovers" {
    let rootFolder = try support.scratch("scratch-names-only");
    Path root = rootFolder.path();
    for (let name in ["ens-test-1", "ens-runner-1", "ens-run-", "ens-run-1a", "other-ens-run-1"]) {
        try support.writeFile(root.join(name), ".ens-owner", "");
    }
    let next = scratch.create(here(root), "ens-run");
    try testing.assertEqual(next.folder(), root.join("ens-run-1"));
    for (let name in ["ens-test-1", "ens-runner-1", "ens-run-", "ens-run-1a", "other-ens-run-1"]) {
        try testing.assertTrue(root.join(name).exists(), "'{name}' was taken for a leftover");
    }
    try testing.assertEqual(next.remove(), "");
}

test "a folder's name is a prefix, a dash and a number" {
    try testing.assertTrue(scratch.numbered("ens-test-1", "ens-test"), "ens-test-1");
    try testing.assertTrue(scratch.numbered("ens-test-512", "ens-test"), "ens-test-512");
    try testing.assertFalse(scratch.numbered("ens-test-", "ens-test"), "no number");
    try testing.assertFalse(scratch.numbered("ens-test-1b", "ens-test"), "a letter after it");
    try testing.assertFalse(scratch.numbered("ens-test1", "ens-test"), "no dash");
    try testing.assertFalse(scratch.numbered("ens-run-1", "ens-test"), "another prefix");
}

// Windows refuses to remove a file that is open, so a file the test keeps open inside the folder
// of an ended run is one the next run cannot remove. No other system refuses that.
test "a folder of an ended run that cannot be removed is reported with where it came from" {
    if (environment.platform() != Platform.Windows) {
        return;
    }
    let rootFolder = try support.scratch("scratch-reclaim-refused");
    Path root = rootFolder.path();
    Path ended = root.join("ens-run-1");
    try support.writeFile(ended, ".ens-owner", "");
    try support.writeFile(ended, "program.exe", "not really a program\n");
    Path program = ended.join("program.exe");
    let busy = try program.open();

    let next = scratch.create(here(root), "ens-run");
    try testing.assertEqual(next.folder(), root.join("ens-run-2"));
    string[] reported = next.leftBehind();
    try testing.assertEqual(reported.length, 1L);
    try testing.assertTrue(reported[0].startsWith("could not remove the file '{program}': "),
        "the refusal does not name the file: {reported[0]}");
    try testing.assertTrue(reported[0].endsWith(". '{ended}' was left by an earlier run that did "
        + "not finish. Remove it once nothing is using it"),
        "the refusal does not name the folder and what to do: {reported[0]}");

    try busy.close();
    try testing.assertEqual(next.remove(), "");
}

test "a folder is claimed by the first caller and by nobody after that" {
    let rootFolder = try support.scratch("scratch-claim");
    Path root = rootFolder.path();
    Path candidate = root.join("ens-run-1");
    try testing.assertTrue(try scratch.claimed(candidate), "the first claim takes the folder");
    try testing.assertFalse(try scratch.claimed(candidate),
        "a folder already claimed cannot be claimed again");
    try testing.assertTrue(candidate.isDirectory(), "the claim is the folder itself");
}

test "discarding removes everything under the folder and returns no leftover" {
    let rootFolder = try support.scratch("scratch-discard");
    Path root = rootFolder.path();
    let made = scratch.create(here(root), "ens-run");
    try support.writeFile(made.folder(), "program.exe", "not really a program\n");
    try support.writeFile(made.folder(), "objects/one.obj", "not really an object\n");
    try support.writeFile(made.folder(), "objects/deeper/two.obj", "nor this\n");

    try testing.assertEqual(made.remove(), "");
    try testing.assertFalse(made.folder().exists(), "the folder and its tree are gone");
    try testing.assertEqual(scratch.discard(made.folder()), "");
}

// The schedule is asserted by the shape it is built from rather than by the numbers it comes to.
// Changing either bound moves the assertions with it.
test "the waits start at a millisecond and double up to the longest" {
    long[] waits = Retry.schedule();
    try testing.assertTrue(waits.length > 0, "the schedule has waits in it");
    try testing.assertEqual(waits[0], 1);
    for (long i = 1; i < waits.length; i++) {
        try testing.assertTrue(waits[i] == waits[i - 1] * 2 || waits[i] == Retry.longestMillis,
            "wait {i} of {waits[i]}ms neither doubles {waits[i - 1]}ms nor holds at the longest");
    }
}

test "no single wait is longer than the longest" {
    for (let wait in Retry.schedule()) {
        try testing.assertTrue(wait <= Retry.longestMillis,
            "a wait of {wait}ms is longer than the {Retry.longestMillis}ms longest");
    }
}

// The budget is reached and then left behind, which is what makes it a budget rather than an exact
// total. The schedule stops on the first wait that carries it past. It can overshoot by one wait
// and no more.
test "the waits add up to the budget and overshoot it by less than one wait" {
    long total = 0;
    for (let wait in Retry.schedule()) {
        total = total + wait;
    }
    try testing.assertTrue(total >= Retry.budgetMillis,
        "the schedule adds up to {total}ms, short of the {Retry.budgetMillis}ms budget");
    try testing.assertTrue(total < Retry.budgetMillis + Retry.longestMillis,
        "the schedule adds up to {total}ms, more than one wait past the budget");
}

// Windows is the only system where another program's open file refuses a removal. It is the only
// one a wait is spent on.
test "only a refused permission on Windows is waited out" {
    try testing.assertTrue(scratch.waitingCanClear(ErrorKind.PermissionDenied, Platform.Windows),
        "a refused permission on Windows is what the wait is for");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.PermissionDenied, Platform.Linux),
        "Linux does not refuse a removal over an open file");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.PermissionDenied, Platform.MacOS),
        "macOS does not refuse a removal over an open file");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.NotFound, Platform.Windows),
        "a folder that is not there will not appear while a run waits");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.DirectoryNotEmpty, Platform.Windows),
        "a folder that is not empty will not empty itself while a run waits");
}

// An environment naming `root` as where this system keeps work in progress, matched by the running
// system's own rule so the folders the test makes are real ones.
here(Path root) -> Environment {
    return support.given(environment.platform(), ["TMP=" + root.toString()]);
}

windows(string[] entries) -> Environment {
    return support.given(Platform.Windows, entries);
}

linux(string[] entries) -> Environment {
    return support.given(Platform.Linux, entries);
}

// A folder that could not be removed is reported with the refusal, which names what could not be
// removed and why, and then the folder to remove, waited out or by hand.
test "a folder still there is named with the refusal that kept it" {
    let held = new FileSystemError("could not remove 'C:/Temp/ens-test-4/staging-1': another "
        + "program is using it", ErrorKind.PermissionDenied, Path("C:/Temp/ens-test-4/staging-1"), 32);
    try testing.assertEqual(scratch.refusalText(Path("C:/Temp/ens-test-4"), held, Platform.Windows),
        "could not remove 'C:/Temp/ens-test-4/staging-1': another program is using it. Remove "
        + "'C:/Temp/ens-test-4' once nothing is using it");
    let denied = new FileSystemError("could not remove '/tmp/ens-test-4/staging-1': permission "
        + "denied", ErrorKind.PermissionDenied, Path("/tmp/ens-test-4/staging-1"), 13);
    try testing.assertEqual(scratch.refusalText(Path("/tmp/ens-test-4"), denied, Platform.Linux),
        "could not remove '/tmp/ens-test-4/staging-1': permission denied. Remove '/tmp/ens-test-4' "
        + "by hand");
}

// The folder of an earlier run is one this run did not make, so the message names where it came
// from before what to do with it.
test "a folder an earlier run left is named with the refusal and where it came from" {
    let held = new FileSystemError("could not remove 'C:/Temp/ens-test-4/tests.exe': another "
        + "program is using it", ErrorKind.PermissionDenied, Path("C:/Temp/ens-test-4/tests.exe"),
        32);
    try testing.assertEqual(scratch.reclaimText(Path("C:/Temp/ens-test-4"), held,
        Platform.Windows), "could not remove 'C:/Temp/ens-test-4/tests.exe': another program is "
        + "using it. 'C:/Temp/ens-test-4' was left by an earlier run that did not finish. Remove it "
        + "once nothing is using it");
    let denied = new FileSystemError("could not remove '/tmp/ens-test-4/tests': permission denied",
        ErrorKind.PermissionDenied, Path("/tmp/ens-test-4/tests"), 13);
    try testing.assertEqual(scratch.reclaimText(Path("/tmp/ens-test-4"), denied, Platform.Linux),
        "could not remove '/tmp/ens-test-4/tests': permission denied. '/tmp/ens-test-4' was left by "
        + "an earlier run that did not finish. Remove it by hand");
}
