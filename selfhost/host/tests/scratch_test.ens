// The folder a run builds in and then removes: where the system keeps work in progress, the name a
// run takes there, and the removal that leaves nothing behind.
import @std.testing;
import Path from @std.fs;
import ErrorKind from @std.fs.error;
import Environment from @std.environment;
import Platform from @std.environment;
import @std.environment;
import Retry from scratch;
import scratch;
import support;

test "the environment names the folder work in progress goes in" {
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMP=C:\\Work\\Temp"])),
        Path("C:/Work/Temp"));
    try testing.assertEqual(scratch.temporaryFolder(windows(["TEMP=C:\\Other"])),
        Path("C:/Other"));
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMPDIR=C:\\Third"])),
        Path("C:/Third"));
    try testing.assertEqual(scratch.temporaryFolder(linux(["TMPDIR=/var/tmp"])),
        Path("/var/tmp"));
    try testing.assertEqual(scratch.temporaryFolder(linux(["TMP=/scratch"])), Path("/scratch"));
}

test "TMP wins on Windows and TMPDIR everywhere else" {
    string[] all = ["TMP=/from-tmp", "TEMP=/from-temp", "TMPDIR=/from-tmpdir"];
    try testing.assertEqual(scratch.temporaryFolder(windows(all)), Path("/from-tmp"));
    try testing.assertEqual(scratch.temporaryFolder(linux(all)), Path("/from-tmpdir"));
}

test "a variable set to nothing is no answer at all" {
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMP=", "TEMP=C:\\Fallback"])),
        Path("C:/Fallback"));
}

test "an environment that says nothing falls back to what the system conventionally uses" {
    try testing.assertEqual(scratch.temporaryFolder(linux(["HOME=/home/ada"])), Path("/tmp"));
    try testing.assertEqual(scratch.temporaryFolder(windows(["USERPROFILE=C:\\Users\\Ada"])),
        Path("C:/Users/Ada/AppData/Local/Temp"));
}

test "a Windows environment that knows neither the temp folder nor the user has nowhere to build" {
    string[] nothing = [];
    try testing.assertTrue(scratch.temporaryFolder(windows(nothing)) == null,
        "nothing in the environment says where to build");
    let made = scratch.create(windows(nothing), "ens-run");
    try testing.assertTrue(made.folder().isEmpty(), "so no folder was made");
    try assertMentions(made.failure(), "TMP");
}

test "a run takes the first free name under the folder and creates it" {
    Path root = try support.scratch("scratch-names");
    let read = here(root);

    let first = scratch.create(read, "ens-run");
    try testing.assertEqual(first.failure(), "");
    try testing.assertEqual(first.folder(), root.join("ens-run-1"));
    try testing.assertTrue(first.folder().isDirectory(), "the folder was created");

    let second = scratch.create(read, "ens-run");
    try testing.assertEqual(second.folder(), root.join("ens-run-2"));
    try testing.assertTrue(second.folder().isDirectory(), "the second folder was created");

    try testing.assertEqual(scratch.discard(first.folder()), "");
    try testing.assertFalse(first.folder().isDirectory(), "the first folder is gone");
    let third = scratch.create(read, "ens-run");
    try testing.assertEqual(third.folder(), root.join("ens-run-1"));

    try support.removeTree(root);
}

test "a folder is claimed by whoever asks first and by nobody after that" {
    Path root = try support.scratch("scratch-claim");
    Path candidate = root.join("ens-run-1");
    try testing.assertTrue(try scratch.claimed(candidate), "the first claim takes the folder");
    try testing.assertFalse(try scratch.claimed(candidate),
        "a folder already claimed cannot be claimed again");
    try testing.assertTrue(candidate.isDirectory(), "the claim is the folder itself");
    try support.removeTree(root);
}

test "discarding removes everything under the folder and answers with nothing left to say" {
    Path root = try support.scratch("scratch-discard");
    let made = scratch.create(here(root), "ens-run");
    try support.writeFile(made.folder(), "program.exe", "not really a program\n");
    try support.writeFile(made.folder(), "objects/one.obj", "not really an object\n");
    try support.writeFile(made.folder(), "objects/deeper/two.obj", "nor this\n");

    try testing.assertEqual(scratch.discard(made.folder()), "");
    try testing.assertFalse(made.folder().exists(), "the folder and its tree are gone");
    try testing.assertEqual(scratch.discard(made.folder()), "");
    try support.removeTree(root);
}

// The schedule is asserted by the shape it is built from rather than by the numbers it comes to.
// Changing either bound moves the assertions with it.
test "the waits start at a millisecond and double up to the longest" {
    long[] waits = Retry.schedule();
    try testing.assertTrue(waits.length > 0, "the schedule has waits in it");
    try testing.assertEqual(waits[0], 1);
    for (long i = 1; i < waits.length; i++) {
        try testing.assertTrue(waits[i] == waits[i - 1] * 2 || waits[i] == Retry.longestMillis,
            "wait {i} of {waits[i]}ms neither doubles {waits[i - 1]}ms nor holds at the longest");
    }
}

test "no single wait is longer than the longest" {
    for (let wait in Retry.schedule()) {
        try testing.assertTrue(wait <= Retry.longestMillis,
            "a wait of {wait}ms is longer than the {Retry.longestMillis}ms longest");
    }
}

// The budget is reached and then left behind, which is what makes it a budget rather than an exact
// total. The schedule stops on the first wait that carries it past. It can overshoot by one wait
// and no more.
test "the waits add up to the budget and overshoot it by less than one wait" {
    long total = 0;
    for (let wait in Retry.schedule()) {
        total = total + wait;
    }
    try testing.assertTrue(total >= Retry.budgetMillis,
        "the schedule adds up to {total}ms, short of the {Retry.budgetMillis}ms budget");
    try testing.assertTrue(total < Retry.budgetMillis + Retry.longestMillis,
        "the schedule adds up to {total}ms, more than one wait past the budget");
}

// Windows is the only system where another program's open file refuses a removal. It is the only
// one a wait is spent on.
test "only a refused permission on Windows is waited out" {
    try testing.assertTrue(scratch.waitingCanClear(ErrorKind.PermissionDenied, Platform.Windows),
        "a refused permission on Windows is what the wait is for");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.PermissionDenied, Platform.Linux),
        "Linux does not refuse a removal over an open file");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.PermissionDenied, Platform.MacOS),
        "macOS does not refuse a removal over an open file");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.NotFound, Platform.Windows),
        "a folder that is not there will not appear while a run waits");
    try testing.assertFalse(scratch.waitingCanClear(ErrorKind.DirectoryNotEmpty, Platform.Windows),
        "a folder that is not empty will not empty itself while a run waits");
}

// An environment naming `root` as where this system keeps work in progress, matched by the running
// system's own rule so the folders the test makes are real ones.
here(Path root) -> Environment {
    return support.given(environment.platform(), ["TMP=" + root.toString()]);
}

windows(string[] entries) -> Environment {
    return support.given(Platform.Windows, entries);
}

linux(string[] entries) -> Environment {
    return support.given(Platform.Linux, entries);
}

assertMentions(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}
