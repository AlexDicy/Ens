// A folder on disk the tests write their trees into. What a folder is, and whether a name is free,
// is what the operating system says, so the parts that ask it are tested against real folders.
import @std.system;
import @std.path;

// An empty folder of the given name, whatever was there before.
public scratch(string name) -> string throws {
    string folder = path.join(try scratchRoot(), name);
    try removeTree(folder);
    try system.createDirectory(folder);
    return folder;
}

public writeFile(string folder, string relativePath, string text) throws {
    string file = path.join(folder, relativePath);
    string parent = path.parentFolder(file);
    if (parent.length > 0 && !system.isDirectory(parent)) {
        try system.createDirectory(parent);
    }
    try system.writeAllText(file, text);
}

// Removes a folder and everything under it, doing nothing when it is not there.
public removeTree(string folder) throws {
    if (!system.isDirectory(folder)) {
        return;
    }
    for (let entry in try system.listDirectory(folder)) {
        string child = path.join(folder, entry);
        if (system.isDirectory(child)) {
            try removeTree(child);
        } else {
            try system.removeFile(child);
        }
    }
    try system.removeDirectory(folder);
}

// The scratch root sits under the build output folder, so a test run leaves nothing beside the
// sources.
scratchRoot() -> string throws {
    string root = path.join(system.currentDirectory(), "build/ens-host-tests");
    if (!system.isDirectory(root)) {
        try system.createDirectory(root);
    }
    return root;
}
