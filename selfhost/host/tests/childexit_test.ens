// The exit code a command returns for a child it ran.
import @std.testing;
import ExitStatus from @std.process;
import childexit;

test "a child that exited gives the code it chose" {
    ExitStatus succeeded = {code: 0, signal: 0};
    ExitStatus failed = {code: 2, signal: 0};
    ExitStatus aborted = {code: 134, signal: 0};
    try testing.assertEqual(childexit.exitCodeOf(succeeded), 0);
    try testing.assertEqual(childexit.exitCodeOf(failed), 2);
    try testing.assertEqual(childexit.exitCodeOf(aborted), 134);
}

// A code 128 above the signal is what a shell reports for a program a signal stopped, so a stopped
// child gives 137 and one that aborted gives 134 whichever of the two ways it is reported.
test "a child a signal ended gives 128 above the signal" {
    ExitStatus stopped = {code: 0, signal: 9};
    ExitStatus abortedBySignal = {code: 0, signal: 6};
    try testing.assertEqual(childexit.exitCodeOf(stopped), 128 + 9);
    try testing.assertEqual(childexit.exitCodeOf(abortedBySignal), 128 + 6);
    ExitStatus abortedByCode = {code: 134, signal: 0};
    try testing.assertEqual(childexit.exitCodeOf(abortedBySignal),
        childexit.exitCodeOf(abortedByCode));
}
