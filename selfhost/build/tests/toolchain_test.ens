// Which toolchain does the work. The rule is a function of what was requested, what this toolchain
// is, and what is installed, so the whole of it is checked here without a second toolchain existing:
// only the folder walk that finds them needs real files.
import Path from @std.fs;
import @std.testing;
import Platform from @std.platform;
import List from @std.collections.list;
import InstalledToolchain from toolchain;
import InstalledToolchains from toolchain;
import Declaration from toolchain;
import ToolchainDecision from toolchain;
import ToolchainRequest from toolchain;
import @ens.packages.versions;
import Version from @ens.language.version;
import toolchain;
import support;

test "a build root that declares nothing is built here when nothing newer is installed" {
    let decision = decide("", "", "", installed(["0.12.0", "0.9.0", "nightly"]));
    try assertBuildsHere(decision);
    try testing.assertEqual(decision.explanation(), "");
    string[] nothing = [];
    try assertBuildsHere(decide("", "", "", installed(nothing)));
}

test "a build root written for this or an older language version is built here" {
    let current = decide("", "", "0.13", installed(["0.13.0", "0.12.4"]));
    try assertBuildsHere(current);
    try testing.assertEqual(current.explanation(), "");
    try assertBuildsHere(decide("", "", "0.1", installed(["0.1.0", "0.12.0"])));
}

test "an installed release of this version, with or without its label, is not newer" {
    try assertBuildsHere(decide("", "", "", installed(["0.13.0"])));
    try assertBuildsHere(command("", "", installed(["0.13.0-beta", "0.13.0"])));
}

test "the newest installed toolchain runs a command whenever it is newer than this one" {
    let decision = command("", "", installed(["0.12.0", "0.14.1", "nightly", "0.14.0"]));
    try testing.assertTrue(decision.delegates(), "the work goes to 0.14.1");
    try testing.assertEqual(decision.version(), "0.14.1");
    try testing.assertEqual(decision.program(), Path("/opt/ens/0.14.1/ens.exe"));
    try testing.assertEqual(decision.failure(), "");
    try testing.assertEqual(decision.explanation(), "Ens 0.14.1 is installed at "
        + "'/opt/ens/0.14.1/ens.exe', and it is newer than this toolchain, Ens 0.13.0-beta, so it "
        + "runs the command");
}

test "a build root written for this or an older version still goes to a newer toolchain" {
    let current = decide("", "", "0.13", installed(["0.13.4", "0.14.0"]));
    try testing.assertEqual(current.version(), "0.14.0");
    try assertMentions(current.explanation(), ["is newer than this toolchain"]);
    let older = decide("", "", "0.1", installed(["0.1.0", "0.13.1"]));
    try testing.assertEqual(older.version(), "0.13.1");
    let undeclared = decide("", "", "", installed(["9.9.0"]));
    try testing.assertEqual(undeclared.version(), "9.9.0");
}

test "a build root written for a newer version goes to the newest toolchain at least that new" {
    let decision = decide("", "", "0.14",
        installed(["0.12.0", "0.14.0-beta", "0.16.1-beta", "0.14.2-beta", "nightly"]));
    try testing.assertTrue(decision.delegates(), "the work goes to 0.16.1-beta");
    try testing.assertEqual(decision.version(), "0.16.1-beta");
    try testing.assertEqual(decision.program(), Path("/opt/ens/0.16.1-beta/ens.exe"));
    try testing.assertEqual(decision.failure(), "");
    try testing.assertEqual(decision.explanation(), "'/work/app' declares 'ens \"0.14\";', so it "
        + "needs Ens 0.14 or later, and this toolchain is Ens 0.13.0-beta. Ens 0.16.1-beta at "
        + "'/opt/ens/0.16.1-beta/ens.exe' runs the command");
}

test "of the patches of a newer version, the highest does the work" {
    let decision = decide("", "", "0.14", installed(["0.14.0-beta", "0.14.2-beta", "0.14.1"]));
    try testing.assertEqual(decision.version(), "0.14.2-beta");
}

test "components compare as numbers, and a label does not change which version a release is" {
    let numeric = decide("", "", "0.20", installed(["0.9.30", "0.100.0", "0.20.0"]));
    try testing.assertEqual(numeric.version(), "0.100.0");
    let tied = decide("", "", "0.14", installed(["0.14.0", "0.14.0-beta"]));
    try testing.assertEqual(tied.version(), "0.14.0");
    let labeled = decide("", "", "0.14", installed(["0.14.0-beta"]));
    try testing.assertEqual(labeled.version(), "0.14.0-beta");
}

test "a build root written for a newer version than any installed one is not built" {
    let decision = decide("", "", "0.14", installed(["0.13.9", "0.12.0", "nightly"]));
    try testing.assertFalse(decision.delegates(), "nothing is run");
    try testing.assertEqual(decision.failure(), "'/work/app' declares 'ens \"0.14\";', so it needs "
        + "Ens 0.14 or later, and this toolchain is Ens 0.13.0-beta. No installed toolchain is "
        + "Ens 0.14 or later: '/opt/ens' contains only '0.13.9', '0.12.0' and 'nightly'. Install "
        + "Ens 0.14 or later in a folder named after its version, such as "
        + "'/opt/ens/0.14.0/ens.exe', or write '--toolchain local' to build with this toolchain "
        + "anyway");
    string[] nothing = [];
    try assertMentions(decide("", "", "0.14", installed(nothing)).failure(),
        ["'/opt/ens' contains no toolchain"]);
}

test "a newer declared version where no toolchain folder is set says where to set one" {
    InstalledToolchain[] none = [];
    let decision = decide("", "", "0.14", new InstalledToolchains(null, "ens", none));
    try testing.assertEqual(decision.failure(), "'/work/app' declares 'ens \"0.14\";', so it needs "
        + "Ens 0.14 or later, and this toolchain is Ens 0.13.0-beta. There is no toolchains folder "
        + "to look in: neither 'ENS_TOOLCHAINS' nor 'HOME' is set. Set 'ENS_TOOLCHAINS' to the "
        + "folder your toolchains are in, or write '--toolchain local' to build with this "
        + "toolchain anyway");
}

test "a declared version that is not a version leaves the work here for the build to report" {
    try assertBuildsHere(decide("", "", "0.x", installed(["0.12.0"])));
    let newer = decide("", "", "0.x", installed(["0.14.0"]));
    try testing.assertEqual(newer.version(), "0.14.0");
}

test "'--toolchain local' keeps the work here whatever the build root declares" {
    let decision = decide("local", "", "9.9", installed(["9.9.0"]));
    try assertBuildsHere(decision);
    try testing.assertEqual(decision.explanation(), "");
}

test "'--toolchain' naming the running version keeps the work here" {
    let decision = decide("0.13.0-beta", "", "9.9", installed(["9.9.0"]));
    try assertBuildsHere(decision);
    try testing.assertEqual(decision.explanation(), "");
}

test "'--toolchain' naming an installed version hands the work to it" {
    let decision = decide("9.9", "", "", installed(["9.9"]));
    try testing.assertTrue(decision.delegates(), "the work goes to 9.9");
    try testing.assertEqual(decision.program(), Path("/opt/ens/9.9/ens.exe"));
    try testing.assertEqual(decision.explanation(), "'--toolchain 9.9' names Ens 9.9, so "
        + "'/opt/ens/9.9/ens.exe' runs the command");
}

test "'--toolchain' wins over what the build root declares, older or newer" {
    let older = decide("0.12.0", "", "0.14", installed(["0.12.0", "0.14.0"]));
    try testing.assertEqual(older.version(), "0.12.0");
    let newer = decide("0.16.0", "", "0.1", installed(["0.16.0"]));
    try testing.assertEqual(newer.version(), "0.16.0");
}

test "'--toolchain' naming a version that is not installed is a usage problem" {
    let decision = decide("9.9", "", "", installed(["1.0"]));
    try testing.assertFalse(decision.delegates(), "nothing is run");
    try testing.assertEqual(decision.failure(), "'--toolchain 9.9' names Ens 9.9, which is not "
        + "installed: '/opt/ens' contains only '1.0'. Install Ens 9.9 as '/opt/ens/9.9/ens.exe', "
        + "or write '--toolchain local' to use this toolchain, Ens 0.13.0-beta");
}

test "requesting a version where no toolchain folder is set reports where to point one" {
    InstalledToolchain[] none = [];
    let decision = decide("9.9", "", "", new InstalledToolchains(null, "ens", none));
    try testing.assertEqual(decision.failure(), "'--toolchain 9.9' names Ens 9.9, and there is "
        + "no toolchains folder to look in: neither 'ENS_TOOLCHAINS' nor 'HOME' is set. Set "
        + "'ENS_TOOLCHAINS' to the folder your toolchains are in, or write '--toolchain local' to "
        + "use this toolchain, Ens 0.13.0-beta");
    let onWindows = decide("9.9", "", "", toolchain.discover(null, Platform.Windows));
    try assertMentions(onWindows.failure(), ["neither 'ENS_TOOLCHAINS' nor 'USERPROFILE' is set"]);
}

test "requesting a version where the folder holds none reports the folder is empty" {
    string[] nothing = [];
    let decision = decide("9.9", "", "", installed(nothing));
    try testing.assertEqual(decision.failure(), "'--toolchain 9.9' names Ens 9.9, which is not "
        + "installed: '/opt/ens' contains no toolchain. Install Ens 9.9 as "
        + "'/opt/ens/9.9/ens.exe', or write '--toolchain local' to use this toolchain, "
        + "Ens 0.13.0-beta");
}

test "ENS_TOOLCHAIN is the environment spelling of the option" {
    let asked = decide("", "9.9", "", installed(["9.9"]));
    try testing.assertTrue(asked.delegates(), "the work goes to 9.9");
    try assertMentions(asked.explanation(), ["ENS_TOOLCHAIN=9.9"]);

    let missing = decide("", "9.9", "", installed(["1.0"]));
    try assertMentions(missing.failure(), ["ENS_TOOLCHAIN=9.9", "not installed"]);

    let overDeclared = decide("", "0.12.0", "0.14", installed(["0.12.0", "0.14.0"]));
    try testing.assertEqual(overDeclared.version(), "0.12.0");
}

test "the option wins over the variable, whichever way they disagree" {
    let byOption = decide("9.9", "1.0", "", installed(["9.9", "1.0"]));
    try testing.assertEqual(byOption.version(), "9.9");

    let kept = decide("local", "9.9", "", installed(["9.9"]));
    try assertBuildsHere(kept);
}

test "a toolchain given the work never delegates it again" {
    let declared = decide("", "local", "9.9", installed(["9.9.0"]));
    try assertBuildsHere(declared);
    try testing.assertEqual(declared.explanation(), "");

    let asked = decide("9.9", "local", "9.9", installed(["9.9"]));
    try assertBuildsHere(asked);
    try testing.assertEqual(asked.explanation(), "Using this toolchain: 'ENS_TOOLCHAIN=local' is "
        + "set, so '--toolchain 9.9' is not used");

    try assertBuildsHere(command("", "local", installed(["9.9.0"])));
}

test "a command line that names a toolchain is not handed on unread" {
    try testing.assertTrue(toolchain.namesToolchain(["frobnicate", "--toolchain", "9.9"]),
        "'--toolchain' and its value are two words");
    try testing.assertTrue(toolchain.namesToolchain(["frobnicate", "--toolchain=9.9"]),
        "'--toolchain=9.9' is one word");
    try testing.assertFalse(toolchain.namesToolchain(["run", "--frob", "--", "--toolchain"]),
        "after '--' the words belong to the program");
    try testing.assertFalse(toolchain.namesToolchain(["build", "--toolchains", "--tool"]),
        "only the option itself counts");
}

test "the toolchain's version is a release written major.minor.patch" {
    let release = versions.release(Version.release);
    try testing.assertTrue(release != null, "'{Version.release}' is a release version");
    if (release != null) {
        try testing.assertTrue(release.components().length == 3,
            "'{Version.release}' is written major.minor.patch");
    }
}

test "ENS_TOOLCHAINS names the toolchains folder" {
    let read = support.given(Platform.Windows,
        ["ENS_TOOLCHAINS=D:\\ens\\chains\\", "USERPROFILE=C:\\Users\\Ada"]);
    try testing.assertEqual(toolchain.root(read), Path("D:/ens/chains"));
}

test "without ENS_TOOLCHAINS they are under the user's own folder" {
    let windows = support.given(Platform.Windows, ["USERPROFILE=C:\\Users\\Ada"]);
    try testing.assertEqual(toolchain.root(windows), Path("C:/Users/Ada/.ens/toolchains"));
    let posix = support.given(Platform.Linux, ["HOME=/home/ada"]);
    try testing.assertEqual(toolchain.root(posix), Path("/home/ada/.ens/toolchains"));
    let nowhere = support.given(Platform.Linux, ["PATH=/usr/bin"]);
    try testing.assertTrue(toolchain.root(nowhere) == null,
        "nothing in the environment says where toolchains live");
}

test "a version folder counts as installed once it holds the program" {
    let rootFolder = try support.scratch("toolchains");
    Path root = rootFolder.path();
    try support.writeFile(root, "9.9/ens.exe", "not really a compiler");
    try support.writeFile(root, "9.8/ens", "not really a compiler");
    try support.writeFile(root, "0.9/readme.txt", "no compiler in here");

    let onWindows = toolchain.discover(root, Platform.Windows);
    try testing.assertEqual(onWindows.programName(), "ens.exe");
    try assertVersions(onWindows, ["9.9"]);
    try testing.assertEqual(onWindows.programOf("9.9"), root.join("9.9/ens.exe"));
    try testing.assertTrue(onWindows.programOf("9.8") == null, "9.8 holds no windows program");

    let onPosix = toolchain.discover(root, Platform.Linux);
    try testing.assertEqual(onPosix.programName(), "ens");
    try assertVersions(onPosix, ["9.8"]);
}

test "a folder with no toolchains in it, and one that is not there at all, hold none" {
    let rootFolder = try support.scratch("empty-toolchains");
    Path root = rootFolder.path();
    string[] nothing = [];
    let windows = Platform.Windows;
    try assertVersions(toolchain.discover(root, windows), nothing);
    try assertVersions(toolchain.discover(root.join("missing"), windows), nothing);
    try assertVersions(toolchain.discover(null, windows), nothing);
}

// The decision of a toolchain that is Ens 0.13.0-beta, for a build root in '/work/app' declaring
// `declared`, given what '--toolchain' and ENS_TOOLCHAIN name.
decide(string option, string variable, string declared,
       InstalledToolchains found) -> ToolchainDecision {
    return toolchain.select(new ToolchainRequest(option, variable),
        new Declaration(declared, Path("/work/app")), "0.13.0-beta", found);
}

// The same decision for a command that compiles nothing, so there is no build root.
command(string option, string variable, InstalledToolchains found) -> ToolchainDecision {
    return toolchain.select(new ToolchainRequest(option, variable), null, "0.13.0-beta", found);
}

// The toolchains a decision is made against, laid out the way an installation is: one folder per
// version under the root, each holding the program that is that version.
installed(string[] versions) -> InstalledToolchains {
    let found = new List<InstalledToolchain>();
    for (let one in versions) {
        found.push(new InstalledToolchain(one, Path("/opt/ens/{one}/ens.exe")));
    }
    return new InstalledToolchains(Path("/opt/ens"), "ens.exe", found.toArray());
}

assertBuildsHere(ToolchainDecision decision) throws {
    try testing.assertFalse(decision.delegates(), "the work stays here");
    try testing.assertTrue(decision.program() == null, "and there is no program to run");
    try testing.assertEqual(decision.version(), "");
    try testing.assertEqual(decision.failure(), "");
}

assertVersions(InstalledToolchains found, string[] expected) throws {
    string[] versions = found.versions();
    try testing.assertEqual(versions.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(versions[i], expected[i]);
    }
}

assertMentions(string text, string[] expected) throws {
    for (let part in expected) {
        try testing.assertTrue(text.contains(part), "'{part}' is named in: {text}");
    }
}
