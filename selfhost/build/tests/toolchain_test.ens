// Which toolchain does the work. The rule is a function of what was requested, what this toolchain
// is, and what is installed, so the whole of it is checked here without a second toolchain existing:
// only the folder walk that finds them needs real files.
import Path from @std.fs;
import @std.testing;
import Platform from @std.environment;
import List from @std.collections.list;
import Environment from @std.environment;
import InstalledToolchain from toolchain;
import InstalledToolchains from toolchain;
import ToolchainDecision from toolchain;
import ToolchainRequest from toolchain;
import toolchain;
import support;

test "a build root that declares nothing is built here" {
    let decision = toolchain.select(new ToolchainRequest("", ""), "", "0.1", installed(["9.9"]));
    try assertBuildsHere(decision);
    try testing.assertEqual(decision.explanation(), "");
}

test "a build root written for this very version is built here" {
    let decision = toolchain.select(new ToolchainRequest("", ""), "0.1", "0.1", installed(["0.1"]));
    try assertBuildsHere(decision);
    try testing.assertEqual(decision.explanation(), "");
}

test "a build root written for another installed version is handed to it" {
    let decision = toolchain.select(new ToolchainRequest("", ""), "9.9", "0.1",
        installed(["9.9", "1.0"]));
    try testing.assertTrue(decision.delegates(), "the work goes to 9.9");
    try testing.assertEqual(decision.version(), "9.9");
    try testing.assertEqual(decision.program(), Path("/opt/ens/9.9/ens.exe"));
    try testing.assertEqual(decision.failure(), "");
    try assertMentions(decision.explanation(), ["9.9", "/opt/ens/9.9/ens.exe"]);
}

test "a build root written for a version that is not installed is built here anyway" {
    let decision = toolchain.select(new ToolchainRequest("", ""), "9.9", "0.1", installed(["1.0"]));
    try assertBuildsHere(decision);
    try assertMentions(decision.explanation(), ["9.9", "0.1", "/opt/ens", "'1.0'"]);
}

test "'--toolchain local' keeps the work here whatever the build root declares" {
    let decision = toolchain.select(new ToolchainRequest("local", ""), "9.9", "0.1",
        installed(["9.9"]));
    try assertBuildsHere(decision);
    try testing.assertEqual(decision.explanation(), "");
}

test "'--toolchain' naming the running version keeps the work here" {
    let decision = toolchain.select(new ToolchainRequest("0.1", ""), "9.9", "0.1",
        installed(["9.9"]));
    try assertBuildsHere(decision);
    try testing.assertEqual(decision.explanation(), "");
}

test "'--toolchain' naming an installed version hands the work to it" {
    let decision = toolchain.select(new ToolchainRequest("9.9", ""), "", "0.1", installed(["9.9"]));
    try testing.assertTrue(decision.delegates(), "the work goes to 9.9");
    try testing.assertEqual(decision.program(), Path("/opt/ens/9.9/ens.exe"));
    try assertMentions(decision.explanation(), ["'--toolchain 9.9'", "/opt/ens/9.9/ens.exe"]);
}

test "'--toolchain' naming a version that is not installed is a usage problem" {
    let decision = toolchain.select(new ToolchainRequest("9.9", ""), "", "0.1", installed(["1.0"]));
    try testing.assertFalse(decision.delegates(), "nothing is run");
    try assertMentions(decision.failure(), ["'--toolchain 9.9'", "not installed", "'1.0'",
        "/opt/ens/9.9/ens.exe", "'local'", "0.1"]);
}

test "requesting a version where no toolchain folder is set reports where to point one" {
    InstalledToolchain[] none = [];
    let decision = toolchain.select(new ToolchainRequest("9.9", ""), "", "0.1",
        new InstalledToolchains(null, "ens", none));
    try assertMentions(decision.failure(), ["'--toolchain 9.9'", "ENS_TOOLCHAINS", "'local'"]);
}

test "requesting a version where the folder holds none reports the folder is empty" {
    string[] nothing = [];
    let decision = toolchain.select(new ToolchainRequest("9.9", ""), "", "0.1",
        installed(nothing));
    try assertMentions(decision.failure(), ["'/opt/ens' holds no toolchain at all",
        "/opt/ens/9.9/ens.exe"]);
}

test "ENS_TOOLCHAIN is the environment spelling of the option" {
    let asked = toolchain.select(new ToolchainRequest("", "9.9"), "", "0.1", installed(["9.9"]));
    try testing.assertTrue(asked.delegates(), "the work goes to 9.9");
    try assertMentions(asked.explanation(), ["ENS_TOOLCHAIN=9.9"]);

    let missing = toolchain.select(new ToolchainRequest("", "9.9"), "", "0.1", installed(["1.0"]));
    try assertMentions(missing.failure(), ["ENS_TOOLCHAIN=9.9", "not installed"]);
}

test "the option wins over the variable, whichever way they disagree" {
    let byOption = toolchain.select(new ToolchainRequest("9.9", "1.0"), "", "0.1",
        installed(["9.9", "1.0"]));
    try testing.assertEqual(byOption.version(), "9.9");

    let kept = toolchain.select(new ToolchainRequest("local", "9.9"), "", "0.1",
        installed(["9.9"]));
    try assertBuildsHere(kept);
}

test "a toolchain given the work never delegates it again" {
    let declared = toolchain.select(new ToolchainRequest("", "local"), "9.9", "0.1",
        installed(["9.9"]));
    try assertBuildsHere(declared);
    try testing.assertEqual(declared.explanation(), "");

    let asked = toolchain.select(new ToolchainRequest("9.9", "local"), "9.9", "0.1",
        installed(["9.9"]));
    try assertBuildsHere(asked);
    try assertMentions(asked.explanation(), ["'--toolchain 9.9'", "ENS_TOOLCHAIN=local"]);
}

test "ENS_TOOLCHAINS names the toolchains folder" {
    let read = support.given(Platform.Windows,
        ["ENS_TOOLCHAINS=D:\\ens\\chains\\", "USERPROFILE=C:\\Users\\Ada"]);
    try testing.assertEqual(toolchain.root(read), Path("D:/ens/chains"));
}

test "without ENS_TOOLCHAINS they are under the user's own folder" {
    let windows = support.given(Platform.Windows, ["USERPROFILE=C:\\Users\\Ada"]);
    try testing.assertEqual(toolchain.root(windows), Path("C:/Users/Ada/.ens/toolchains"));
    let posix = support.given(Platform.Linux, ["HOME=/home/ada"]);
    try testing.assertEqual(toolchain.root(posix), Path("/home/ada/.ens/toolchains"));
    let nowhere = support.given(Platform.Linux, ["PATH=/usr/bin"]);
    try testing.assertTrue(toolchain.root(nowhere) == null,
        "nothing in the environment says where toolchains live");
}

test "a version folder counts as installed once it holds the program" {
    Path root = try support.scratch("toolchains");
    try support.writeFile(root, "9.9/ens.exe", "not really a compiler");
    try support.writeFile(root, "9.8/ens", "not really a compiler");
    try support.writeFile(root, "0.9/readme.txt", "no compiler in here");

    let onWindows = toolchain.discover(root, "x86_64-pc-windows-msvc");
    try testing.assertEqual(onWindows.programName(), "ens.exe");
    try assertVersions(onWindows, ["9.9"]);
    try testing.assertEqual(onWindows.programOf("9.9"), root.join("9.9/ens.exe"));
    try testing.assertTrue(onWindows.programOf("9.8") == null, "9.8 holds no windows program");

    let onPosix = toolchain.discover(root, "x86_64-unknown-linux-gnu");
    try testing.assertEqual(onPosix.programName(), "ens");
    try assertVersions(onPosix, ["9.8"]);
    try support.removeTree(root);
}

test "a folder with no toolchains in it, and one that is not there at all, hold none" {
    Path root = try support.scratch("empty-toolchains");
    string[] nothing = [];
    try assertVersions(toolchain.discover(root, "x86_64-pc-windows-msvc"), nothing);
    try assertVersions(toolchain.discover(root.join("missing"),
        "x86_64-pc-windows-msvc"), nothing);
    try assertVersions(toolchain.discover(null, "x86_64-pc-windows-msvc"), nothing);
    try support.removeTree(root);
}

// The toolchains a decision is made against, laid out the way an installation is: one folder per
// version under the root, each holding the program that is that version.
installed(string[] versions) -> InstalledToolchains {
    let found = new List<InstalledToolchain>();
    for (let one in versions) {
        found.push(new InstalledToolchain(one, Path("/opt/ens/{one}/ens.exe")));
    }
    return new InstalledToolchains(Path("/opt/ens"), "ens.exe", found.toArray());
}

assertBuildsHere(ToolchainDecision decision) throws {
    try testing.assertFalse(decision.delegates(), "the work stays here");
    try testing.assertTrue(decision.program() == null, "and there is no program to run");
    try testing.assertEqual(decision.version(), "");
    try testing.assertEqual(decision.failure(), "");
}

assertVersions(InstalledToolchains found, string[] expected) throws {
    string[] versions = found.versions();
    try testing.assertEqual(versions.length, expected.length);
    for (long i = 0; i < expected.length; i++) {
        try testing.assertEqual(versions[i], expected[i]);
    }
}

assertMentions(string text, string[] expected) throws {
    for (let part in expected) {
        try testing.assertTrue(text.contains(part), "'{part}' is named in: {text}");
    }
}
