// What 'ens run' says when it cannot choose the program to run. The texts are values, so each
// combination of members and folder is read here as a whole.
import @std.testing;
import run;

test "members whose syntax errors may each hide main() are named, with a folder to run" {
    try testing.assertEqual(run.uncertainProgramsMessage("/work/twounsure",
        ["twounsure.app", "twounsure.tool"], "app"),
        "the 'src/main.ens' of 'twounsure.app' and 'twounsure.tool' in the workspace at "
        + "'/work/twounsure' have syntax errors, so either may be the program to run. Name the "
        + "folder of the member to run, as in 'ens run app', and the build reports its errors");
    try testing.assertEqual(run.uncertainProgramsMessage("/work/three", ["three.a", "three.b",
        "three.c"], ""),
        "the 'src/main.ens' of 'three.a', 'three.b' and 'three.c' in the workspace at '/work/three' "
        + "have syntax errors, so any of them may be the program to run. Name the folder of the "
        + "member to run, and the build reports its errors");
}
