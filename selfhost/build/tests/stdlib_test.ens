// Standard library discovery: the environment override when it points somewhere real, else the walk
// from the source folder up to the nearest ancestor holding libs/std/ens.package.
import Path from @std.fs;
import @std.testing;
import MemoryFileLoader from support;
import support;
import SystemFileLoader from @ens.sema.support.loader;
import target;
import stdlib;

withRepo() -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/repo/libs/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    return loader;
}

test "an existing ENS_STDLIB wins over discovery" {
    let loader = withRepo();
    loader.add("/elsewhere/libs", "");
    try testing.assertEqual(stdlib.findRoot(loader, "/elsewhere/libs", Path("/repo/tools/app/src")),
        Path("/elsewhere/libs"));
}

test "a missing ENS_STDLIB falls back to the walk" {
    try testing.assertEqual(
        stdlib.findRoot(withRepo(), "/nowhere/libs", Path("/repo/tools/app/src")),
        Path("/repo/libs"));
}

test "the walk finds the nearest ancestor with libs/std" {
    try testing.assertEqual(stdlib.findRoot(withRepo(), null, Path("/repo/tools/app/src")),
        Path("/repo/libs"));
    try testing.assertEqual(stdlib.findRoot(withRepo(), null, Path("/repo")), Path("/repo/libs"));
}

test "no marked ancestor means no root, and the message says what to do" {
    try testing.assertTrue(stdlib.findRoot(withRepo(), null, Path("/other/place")) == null,
        "no ancestor holds a standard library");
    try testing.assertTrue(
        stdlib.findRoot(new MemoryFileLoader(), "", Path("C:/repo/app")) == null,
        "and an empty variable finds none either");
    try testing.assertTrue(stdlib.missingMessage().contains("--stdlib"),
        "the message names the option");
    try testing.assertTrue(stdlib.missingMessage().contains("ENS_STDLIB"),
        "the message names the variable");
}

// A target that is the package named 'std' is a standard library, so the folder holding it is the
// standard library its command uses; any other package uses the one found as before.
test "a package named 'std' with the prelude modules is the standard library its command uses" {
    Path root = try support.scratch("stdlib-target");
    try support.writeFile(root, "libs/std/ens.package", "package std \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "libs/std/src/core.ens", "export answer() -> int \{\n"
        + "    return 1;\n\}\n");
    try support.writeFile(root, "libs/std/src/io/print.ens", "export print(string message) \{ \}\n");
    try support.writeFile(root, "app/ens.package", "package demo.app \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "app/src/main.ens", "main() -> int \{\n    return 0;\n\}\n");
    try support.writeFile(root, "userstd/std/ens.package", "package std \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "userstd/std/src/tools.ens", "export answer() -> int \{\n"
        + "    return 1;\n\}\n");
    let loader = new SystemFileLoader();
    let library = target.resolve(loader, root, root.join("libs/std").toString()).target();
    let app = target.resolve(loader, root, root.join("app").toString()).target();
    let named = target.resolve(loader, root, root.join("userstd/std").toString()).target();
    if (library == null || app == null || named == null) {
        try testing.fail("every package should resolve");
    } else {
        try testing.assertTrue(stdlib.libraryRootOf(loader, library) == root.join("libs").normalize(),
            "the folder holding 'std' is the library root");
        try testing.assertTrue(stdlib.libraryRootOf(loader, app) == null,
            "another package names none");
        try testing.assertTrue(stdlib.libraryRootOf(loader, named) == null,
            "a package named 'std' without the prelude modules is an ordinary package");
    }
    try support.removeTree(root);
}

test "a '--stdlib' naming another standard library is refused with both folders" {
    try testing.assertEqual(stdlib.otherLibraryMessage(Path("/repo/libs/std"), Path("/opt/ens/libs"),
        Path("/repo/libs")),
        "'/repo/libs/std' is a standard library: a package named 'std' whose 'src' holds "
        + "'core.ens' and 'io/print.ens'. This command uses it as the standard library, but "
        + "'--stdlib' names a different folder, '/opt/ens/libs'. Remove '--stdlib', or write "
        + "'--stdlib /repo/libs'");
}
