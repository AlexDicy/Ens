// Finding the standard library: the folder the command line or the variable names, checked as one,
// and the messages for a build that has to write the library this compiler carries.
import Path from @std.fs;
import Platform from @std.platform;
import Environment from @std.environment;
import @std.testing;
import MemoryFileLoader from support;
import support;
import SystemFileLoader from @ens.sema.support.loader;
import target;
import LibraryOrigin from stdlib;
import stdlib;
import TemporaryDirectory from @std.fs.temporary;

withRepo() -> MemoryFileLoader {
    let loader = new MemoryFileLoader();
    loader.add("/repo/libs/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    return loader;
}

// The variable does what '--stdlib' does, so a folder it names that is not there is refused
// rather than passed over for the library this compiler carries.
test "an ENS_STDLIB that names nothing is used, and refused" {
    try testing.assertEqual(stdlib.variableRoot("/nowhere/libs"), Path("/nowhere/libs"));
    try testing.assertTrue(stdlib.variableRoot("") == null, "an empty variable names a folder");
    try testing.assertTrue(stdlib.variableRoot(null) == null, "an unset variable names a folder");
    try testing.assertEqual(stdlib.libraryProblem(withRepo(), Path("/nowhere/libs"),
        LibraryOrigin.Variable), "'ENS_STDLIB' names '/nowhere/libs', which is not there. "
            + "Set 'ENS_STDLIB' to the folder that contains 'std/', or unset it");
    try testing.assertEqual(stdlib.libraryProblem(withRepo(), Path("/nowhere/libs"),
        LibraryOrigin.Bundled), "");
}

test "a named file is refused as no folder" {
    let loader = withRepo();
    loader.add("/repo/notes.txt", "not a library");
    try testing.assertEqual(stdlib.libraryProblem(loader, Path("/repo/notes.txt"),
        LibraryOrigin.Option), "'--stdlib' names '/repo/notes.txt', which is a file, not a "
            + "folder. Write '--stdlib' with the folder that contains 'std/'");
    loader.addFolder("/repo/empty");
    try testing.assertEqual(stdlib.libraryProblem(loader, Path("/repo/empty"),
        LibraryOrigin.Option), "'--stdlib' names '/repo/empty', which does not contain the "
            + "standard library: there is no 'std/ens.package' in it. Write '--stdlib' with the "
            + "folder that contains 'std/'");
}

// A library is checked where the command line or the variable named it, so a folder without one
// is reported once by the command rather than as every module the build then cannot find.
test "a named folder that holds no standard library says which name it came from" {
    let scratch = try TemporaryDirectory.create("ens-build-stdlib-named");
    Path libs = scratch.path().join("libs");
    try libs.join("std").createDirectories();
    try libs.join("std/ens.package").writeText("package std \{ ens \"0.1\"; \}\n");
    Path empty = scratch.path().join("empty");
    try empty.createDirectories();
    Path nowhere = scratch.path().join("nowhere");
    let loader = new SystemFileLoader();
    try testing.assertEqual(stdlib.libraryProblem(loader, libs, LibraryOrigin.Option),
        "'--stdlib' names '{libs}', which does not contain the standard library: there is no "
            + "'std/src/core.ens' in it. Write '--stdlib' with a folder whose 'std/' holds the whole "
            + "standard library");
    try libs.join("std/src/io").createDirectories();
    try libs.join("std/src/core.ens").writeText("");
    try testing.assertEqual(stdlib.libraryProblem(loader, libs, LibraryOrigin.Variable),
        "'ENS_STDLIB' names '{libs}', which does not contain the standard library: there is no "
            + "'std/src/io/print.ens' in it. Set 'ENS_STDLIB' to a folder whose 'std/' holds the "
            + "whole standard library, or unset it");
    try libs.join("std/src/io/print.ens").writeText("");
    try testing.assertEqual(stdlib.libraryProblem(loader, libs, LibraryOrigin.Option), "");
    try testing.assertEqual(stdlib.libraryProblem(loader, nowhere, LibraryOrigin.Option),
        "'--stdlib' names '{nowhere}', which is not there. Write '--stdlib' with the folder that "
            + "contains 'std/'");
    try testing.assertEqual(stdlib.libraryProblem(loader, empty, LibraryOrigin.Option),
        "'--stdlib' names '{empty}', which does not contain the standard library: there is no "
            + "'std/ens.package' in it. Write '--stdlib' with the folder that contains 'std/'");
    try testing.assertEqual(stdlib.libraryProblem(loader, empty, LibraryOrigin.Variable),
        "'ENS_STDLIB' names '{empty}', which does not contain the standard library: there is no "
            + "'std/ens.package' in it. Set 'ENS_STDLIB' to the folder that contains 'std/', or "
            + "unset it");
}

// The 'std' folder itself is the one mistake whose fix names the exact folder to write.
test "a named file, or the 'std' folder itself, is told apart from a folder without a library" {
    let scratch = try TemporaryDirectory.create("ens-build-stdlib-itself");
    Path libs = scratch.path().join("libs");
    Path std = libs.join("std");
    try std.join("src/io").createDirectories();
    try std.join("ens.package").writeText("package std \{ ens \"0.1\"; \}\n");
    try std.join("src/core.ens").writeText("");
    try std.join("src/io/print.ens").writeText("");
    Path file = scratch.path().join("notes.txt");
    try file.writeText("not a library");
    let loader = new SystemFileLoader();
    try testing.assertEqual(stdlib.libraryProblem(loader, std, LibraryOrigin.Option),
        "'--stdlib' names '{std}', which is the 'std' folder itself. Write '--stdlib {libs}'");
    try testing.assertEqual(stdlib.libraryProblem(loader, std, LibraryOrigin.Variable),
        "'ENS_STDLIB' names '{std}', which is the 'std' folder itself. Set 'ENS_STDLIB' to "
            + "'{libs}', or unset it");
    try testing.assertEqual(stdlib.libraryProblem(loader, file, LibraryOrigin.Option),
        "'--stdlib' names '{file}', which is a file, not a folder. Write '--stdlib' with the folder "
            + "that contains 'std/'");
}

test "a library that cannot be written into the cache says where the cache would be set" {
    try testing.assertEqual(stdlib.noCacheMessage(Environment.empty(Platform.Linux)),
        "there is no cache folder to write the standard library into: neither 'ENS_CACHE' nor "
            + "'HOME' is set. Set 'ENS_CACHE' to a folder that can be written to, or pass "
            + "'--stdlib <folder>' naming the folder that contains 'std/'");
    try testing.assertEqual(stdlib.noCacheMessage(Environment.empty(Platform.Windows)),
        "there is no cache folder to write the standard library into: neither 'ENS_CACHE' nor "
            + "'USERPROFILE' is set. Set 'ENS_CACHE' to a folder that can be written to, or pass "
            + "'--stdlib <folder>' naming the folder that contains 'std/'");
    try testing.assertEqual(stdlib.notWrittenMessage("could not create the directory "
        + "'/cache/staging': something in the path is a file, not a directory"),
        "the standard library could not be put in the cache: could not create the directory "
            + "'/cache/staging': something in the path is a file, not a directory. Set "
            + "'ENS_CACHE' to a folder that can be written to, or pass '--stdlib <folder>' naming "
            + "the folder that contains 'std/'");
}

// The package named 'std' whose sources hold the prelude is the standard library, so the folder
// holding it is the standard library its command uses. A package of that name without the prelude
// is not, and the load refuses it for the name; any other package uses the one found as before.
test "the package named 'std' with the prelude is the standard library its command uses" {
    let rootFolder = try support.scratch("stdlib-target");
    Path root = rootFolder.path();
    try support.writeFile(root, "libs/std/ens.package", "package std \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "libs/std/src/core.ens", "export answer() -> int \{\n"
        + "    return 1;\n\}\n");
    try support.writeFile(root, "libs/std/src/io/print.ens", "export print(string message) \{ \}\n");
    try support.writeFile(root, "app/ens.package", "package demo.app \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "app/src/main.ens", "main() -> int \{\n    return 0;\n\}\n");
    try support.writeFile(root, "userstd/std/ens.package", "package std \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(root, "userstd/std/src/tools.ens", "export answer() -> int \{\n"
        + "    return 1;\n\}\n");
    let loader = new SystemFileLoader();
    let library = target.resolve(loader, root, root.join("libs/std").toString()).target();
    let app = target.resolve(loader, root, root.join("app").toString()).target();
    let named = target.resolve(loader, root, root.join("userstd/std").toString()).target();
    if (library == null || app == null || named == null) {
        try testing.fail("every package should resolve");
    } else {
        try testing.assertTrue(stdlib.libraryRootOf(loader, library) == root.join("libs").normalize(),
            "the folder holding 'std' is the library root");
        try testing.assertTrue(stdlib.libraryRootOf(loader, app) == null,
            "another package names none");
        try testing.assertTrue(stdlib.libraryRootOf(loader, named) == null,
            "a package named 'std' without the prelude is not the standard library");
    }
}

test "a '--stdlib' naming another standard library is refused with both folders" {
    try testing.assertEqual(stdlib.otherLibraryMessage(Path("/repo/libs/std"), Path("/opt/ens/libs"),
        Path("/repo/libs")),
        "'/repo/libs/std' is the package 'std', which is the standard library, so this command "
        + "uses it as the standard library. '--stdlib' names a different folder, '/opt/ens/libs'. "
        + "Remove '--stdlib', or write '--stdlib /repo/libs'");
}
