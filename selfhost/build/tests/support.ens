// What the build tests share: an in-memory file tree for the parts that only read text, and a
// scratch folder on disk for the parts that ask the operating system what a path is.
import @std.system;
import SystemError from @std.system;
import @std.path;
import Map from @std.collections.map;
import FileLoader from @ens.sema.support.loader;
import FileError from @ens.sema.support.loader;

// A file tree standing in for the file system. Folders a test relies on must be added as entries of
// their own, since existence is a plain key lookup here.
public class MemoryFileLoader implements FileLoader {
    Map<string, string> files;

    public constructor() {
        this.files = new Map<string, string>();
    }

    public add(string path, string text) {
        this.files.set(path, text);
    }

    override exists(string path) -> bool {
        return this.files.contains(path);
    }

    override readText(string path) -> string throws FileError {
        let text = this.files.get(path);
        if (text == null) {
            throw new FileError("Could not read '{path}'.");
        }
        return text;
    }
}

// A folder on disk, empty when the test starts with it, that the test writes its tree into. Target
// resolution and the source scan ask the operating system what a path is, so they are tested against
// real folders.
public scratch(string name) -> string throws {
    string folder = path.join(try scratchRoot(), name);
    try removeTree(folder);
    try system.createDirectory(folder);
    return folder;
}

public writeFile(string folder, string relativePath, string text) throws {
    string file = path.join(folder, relativePath);
    string parent = path.parentFolder(file);
    if (parent.length > 0 && !system.isDirectory(parent)) {
        try system.createDirectory(parent);
    }
    try system.writeAllText(file, text);
}

// Removes a folder and everything under it, doing nothing when it is not there.
public removeTree(string folder) throws {
    if (!system.isDirectory(folder)) {
        return;
    }
    for (let entry in try system.listDirectory(folder)) {
        string child = path.join(folder, entry);
        if (system.isDirectory(child)) {
            try removeTree(child);
        } else {
            try system.removeFile(child);
        }
    }
    try system.removeDirectory(folder);
}

// The scratch root is absolute, so a test can hand the same path to a resolution as both the folder
// the command ran in and the path it named without the two being joined together.
scratchRoot() -> string throws {
    string root = path.join(system.currentDirectory(), ".ens-build-tests");
    if (!system.isDirectory(root)) {
        try system.createDirectory(root);
    }
    return root;
}
