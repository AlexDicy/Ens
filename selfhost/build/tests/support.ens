// What the build tests share: an in-memory file tree for the parts that only read text, and a
// scratch folder on disk for the parts that resolve a path through the operating system.
import Path from @std.fs;
import TemporaryDirectory from @std.fs.temporary;
import Environment from @std.environment;
import Platform from @std.platform;
import List from @std.collections.list;
import Map from @std.collections.map;
import Set from @std.collections.set;
import FileLoader from @ens.sema.support.loader;
import FileError from @ens.sema.support.loader;

// A file tree standing in for the file system. Folders a test relies on must be added with
// addFolder, since existence is a plain key lookup here.
public class MemoryFileLoader implements FileLoader {
    Map<string, string> files;
    Set<string> folders;

    public constructor() {
        this.files = new Map<string, string>();
        this.folders = new Set<string>();
    }

    public add(string path, string text) {
        this.files.set(path, text);
    }

    public addFolder(string path) {
        let added = this.folders.add(path);
    }

    // The tree is keyed by the text of a path, so a path becomes text here and the calls that
    // write the tree keep taking the text a test spells out.
    public override exists(Path path) -> bool {
        return this.files.contains(path.toString()) || this.folders.contains(path.toString());
    }

    public override isFile(Path path) -> bool {
        return this.files.contains(path.toString());
    }

    public override filesUnder(Path folder) -> Path[] throws FileError {
        string inside = folder.toString() + "/";
        let found = new List<string>();
        for (let path in this.files.keys()) {
            if (path.startsWith(inside)) {
                found.push(path);
            }
        }
        found.sort();
        let paths = new List<Path>();
        for (let path in found) {
            paths.push(Path(path));
        }
        return paths.toArray();
    }

    public override folderKey(Path folder) -> string {
        return folder.normalize().toString();
    }

    public override readText(Path path) -> string throws FileError {
        let text = this.files.get(path.toString());
        if (text == null) {
            throw new FileError("Could not read '{path}'.");
        }
        return text;
    }
}

// An empty folder named `name` under the system's temporary folder, that the test writes its tree
// into and that is removed when the value goes, however the test ends. Target resolution and the
// source scan resolve paths through the operating system, so they are tested against real folders.
// The path is absolute, so a test can hand it to a resolution as both the folder the command ran in
// and the path it named without the two being joined together.
public scratch(string name) -> ScratchFolder throws {
    let holder = try TemporaryDirectory.create("ens-build-test");
    Path folder = holder.path().join(name);
    try folder.createDirectories();
    return new ScratchFolder(holder, folder);
}

// A folder named as the test asked, inside a temporary folder of its own that is removed, with
// everything in it, when the value goes.
public final class ScratchFolder {
    TemporaryDirectory holder;
    Path folder;

    protected constructor(this.holder, this.folder);

    public path() -> Path {
        return this.folder;
    }
}

public writeFile(Path folder, string relativePath, string text) throws {
    Path file = folder.join(relativePath);
    Path? parent = file.parent();
    if (parent != null) {
        try parent.createDirectories();
    }
    try file.writeText(text);
}

// Removes a folder and everything under it, doing nothing when it is not there.
public removeTree(Path folder) throws {
    if (!folder.isDirectory()) {
        return;
    }
    try folder.removeRecursively();
}

// The 'NAME=VALUE' entries as a set of variables matched by `platform`'s rule, which is how a test
// fakes one system's environment while running on another. An entry with no '=' names no variable
// and is left out.
public given(Platform platform, string[] entries) -> Environment {
    let variables = Environment.empty(platform);
    for (let entry in entries) {
        long at = entry.indexOf("=");
        if (at <= 0) {
            continue;
        }
        variables.set(entry.substring(0, at), entry.substring(at + 1));
    }
    return variables;
}
