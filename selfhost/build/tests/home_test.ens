// Where Ens keeps a user's own folders. Which variable names the user's folder is a rule about the
// system the environment was read on, so both rules are checked on whichever system runs the tests.
import @std.testing;
import Environment from environment;
import home;

test "Windows names the user's folder USERPROFILE" {
    let read = new Environment(["USERPROFILE=C:\\Users\\Ada", "HOME=/home/ada"], "windows");
    try testing.assertEqual(home.userFolder(read), "C:/Users/Ada");
}

test "every other system names it HOME" {
    let read = new Environment(["USERPROFILE=C:\\Users\\Ada", "HOME=/home/ada"], "linux");
    try testing.assertEqual(home.userFolder(read), "/home/ada");
}

test "an environment that names no user folder knows of none" {
    let read = new Environment(["PATH=/usr/bin"], "linux");
    try testing.assertEqual(home.userFolder(read), "");
    try testing.assertEqual(home.ensFolder(read, "toolchains"), "");
}

test "Ens keeps its own folders under '.ens' in the user's folder" {
    let posix = new Environment(["HOME=/home/ada"], "linux");
    try testing.assertEqual(home.ensFolder(posix, "toolchains"), "/home/ada/.ens/toolchains");
    try testing.assertEqual(home.ensFolder(posix, "cache"), "/home/ada/.ens/cache");
    let windows = new Environment(["USERPROFILE=C:\\Users\\Ada"], "windows");
    try testing.assertEqual(home.ensFolder(windows, "toolchains"), "C:/Users/Ada/.ens/toolchains");
}
