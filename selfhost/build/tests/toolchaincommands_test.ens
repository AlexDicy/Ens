// Tests for 'ens toolchain list' and 'ens toolchain remove'.
import Path from @std.fs;
import @std.testing;
import @std.environment;
import List from @std.collections.list;
import InstalledToolchain from toolchain;
import InstalledToolchains from toolchain;
import Release from releases;
import ReleaseAsset from releases;
import Reporter from report;
import Verbosity from options;
import platform;
import toolchaincommands;
import support;

test "the list shows the newest first and marks the toolchain running it" {
    string[] lines = toolchaincommands.listing(
        installed(["0.9.1", "nightly", "0.14.2", "0.10.0"]), "0.10.0", "0.10.0", null);
    try assertLines(lines, ["Installed in '/opt/ens':", "  0.14.2", "  0.10.0 (this toolchain)",
        "  0.9.1", "  nightly"]);
}

test "a running toolchain outside the toolchains folder is named after the list" {
    let lines = toolchaincommands.listing(installed(["0.14.2"]), null, "0.15.0-beta",
        Path("/usr/local/bin/ens"));
    try assertLines(lines, ["Installed in '/opt/ens':", "  0.14.2",
        "This toolchain is Ens 0.15.0-beta, at '/usr/local/bin/ens'"]);
    string[] nothing = [];
    let empty = toolchaincommands.listing(installed(nothing), null, "0.15.0-beta",
        Path("/usr/local/bin/ens"));
    try assertLines(empty, ["'/opt/ens' contains no toolchain",
        "This toolchain is Ens 0.15.0-beta, at '/usr/local/bin/ens'"]);
}

test "the available releases are listed by the folder they install in, marking the installed" {
    ReleaseAsset[] none = [];
    Release[] newest = [new Release("v0.15.0-beta", "0.15.0-beta", none),
        new Release("v0.14.2-beta", "0.14.2-beta", none)];
    try assertLines(toolchaincommands.availableListing(newest, installed(["0.14.2"]),
        "https://example.com/releases", "windows/x64"), [
        "Available from 'https://example.com/releases' for windows/x64:", "  0.15.0",
        "  0.14.2 (installed)"]);
    Release[] nothing = [];
    try assertLines(toolchaincommands.availableListing(nothing, installed(["0.14.2"]),
        "https://example.com/releases", "windows/x64"),
        ["No release at 'https://example.com/releases' has a program for windows/x64"]);
}

test "removing a version that is not installed names what is" {
    try testing.assertEqual(toolchaincommands.removalProblem(installed(["0.14.2", "0.13.1"]),
        "0.14", null), "Ens 0.14 is not installed: '/opt/ens' contains only '0.14.2' and '0.13.1'");
    try testing.assertEqual(toolchaincommands.removalProblem(installed(["0.14.2"]), "0.14.2",
        null), "");
}

test "the toolchain running the command does not remove itself" {
    try testing.assertEqual(toolchaincommands.removalProblem(installed(["0.13.1", "0.14.2"]),
        "0.14.2", "0.14.2"), "Ens 0.14.2 is the toolchain running this command, from "
        + "'/opt/ens/0.14.2/ens.exe', so it cannot remove itself. Run the 'ens' of another "
        + "version to remove it, as in '/opt/ens/0.13.1/ens.exe toolchain remove 0.14.2'");
    try testing.assertEqual(toolchaincommands.removalProblem(installed(["0.14.2"]), "0.14.2",
        "0.14.2"), "Ens 0.14.2 is the toolchain running this command, from "
        + "'/opt/ens/0.14.2/ens.exe', so it cannot remove itself. Delete the folder "
        + "'/opt/ens/0.14.2' to remove it");
    try testing.assertEqual(toolchaincommands.removalProblem(installed(["0.14.2", "0.13.1"]),
        "0.13.1", "0.14.2"), "");
}

test "a removed version is gone, and removing it again is refused" {
    let rootFolder = try support.scratch("remove-toolchain");
    Path root = rootFolder.path();
    string program = platform.executableNamed("ens", environment.platform());
    try support.writeFile(root, "9.9.1/" + program, "not really a compiler");
    try support.writeFile(root, "9.9.2/" + program, "not really a compiler");
    let variables = support.given(environment.platform(), ["ENS_TOOLCHAINS=" + root.toString()]);
    let reporter = new Reporter(Verbosity.Quiet);

    try testing.assertEqual(toolchaincommands.remove(variables, "9.9.1", reporter), 0);
    try testing.assertFalse(root.join("9.9.1").exists(), "the version's folder is gone");
    try testing.assertTrue(root.join("9.9.2").join(program).isFile(), "the other one stays");
    for (let left in try root.join(".staging").entries()) {
        try testing.fail("the removal left '{left.path}' behind");
    }

    try testing.assertEqual(toolchaincommands.remove(variables, "9.9.1", reporter), 2);
}

// One folder per version under '/opt/ens'.
installed(string[] versions) -> InstalledToolchains {
    let found = new List<InstalledToolchain>();
    for (let one in versions) {
        found.push(new InstalledToolchain(one, Path("/opt/ens/{one}/ens.exe")));
    }
    return new InstalledToolchains(Path("/opt/ens"), "ens.exe", found.toArray());
}

assertLines(string[] lines, string[] expected) throws {
    try testing.assertEqual(lines.length, expected.length);
    for (long i = 0; i < expected.length && i < lines.length; i++) {
        try testing.assertEqual(lines[i], expected[i]);
    }
}
