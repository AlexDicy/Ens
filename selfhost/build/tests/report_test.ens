// How a build words what it is doing, and the version it says it is.
import @std.testing;
import report;
import version;

test "one unit is announced by name, several by their position" {
    try testing.assertEqual(report.progress(1, 1, "hello"), "hello");
    try testing.assertEqual(report.progress(1, 3, "demo.lib"), "[1/3] demo.lib");
    try testing.assertEqual(report.progress(3, 3, "demo.app"), "[3/3] demo.app");
}

test "a count of problems reads as English" {
    try testing.assertEqual(report.problemCount(1), "1 problem");
    try testing.assertEqual(report.problemCount(0), "0 problems");
    try testing.assertEqual(report.problemCount(7), "7 problems");
}

test "a count of members reads as English" {
    try testing.assertEqual(report.memberCount(1), "1 member");
    try testing.assertEqual(report.memberCount(0), "0 members");
    try testing.assertEqual(report.memberCount(4), "4 members");
}

test "the toolchain names the language version it implements" {
    try testing.assertEqual(version.toolchainVersion(), "0.1");
}
