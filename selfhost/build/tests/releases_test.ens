import @std.testing;
import Json from @std.json;
import JsonArray from @std.json;
import JsonBool from @std.json;
import JsonNull from @std.json;
import JsonObject from @std.json;
import JsonString from @std.json;
import Release from releases;
import ReleaseAsset from releases;
import releases;

test "a page names each release with its version, assets and digests" {
    let listed = JsonArray.of([
        entry("v0.14.2-beta", false, JsonArray.of([
            asset("ens-linux-x64", "https://example.com/ens-linux-x64", "sha256:ABCDEF"),
            asset("ens-windows-x64.exe", "https://example.com/w", ""),
            asset("notes.txt", "", "")])),
        entry("v0.15.0", true, new JsonArray()),
        entry("nightly", false, new JsonArray()),
        entry("0.13.3", false, new JsonArray())]);
    let page = releases.readPage(listed.toString(), "https://example.com/releases");
    try testing.assertEqual(page.failure(), "");
    try testing.assertEqual(page.entries(), 4);
    Release[] found = page.releases();
    try testing.assertEqual(found.length, 2);
    try testing.assertEqual(found[0].tag(), "v0.14.2-beta");
    try testing.assertEqual(found[0].version(), "0.14.2-beta");
    try testing.assertEqual(found[0].folderName(), "0.14.2");
    try testing.assertEqual(found[1].version(), "0.13.3");
    try testing.assertEqual(found[1].folderName(), "0.13.3");

    ReleaseAsset? linux = found[0].asset("ens-linux-x64");
    try testing.assertTrue(linux != null, "the linux program is listed");
    if (linux != null) {
        try testing.assertEqual(linux.url(), "https://example.com/ens-linux-x64");
        try testing.assertEqual(linux.digest(), "abcdef");
    }
    ReleaseAsset? windows = found[0].asset("ens-windows-x64.exe");
    try testing.assertTrue(windows != null, "a program with no digest is still listed");
    if (windows != null) {
        try testing.assertEqual(windows.digest(), "");
    }
    try testing.assertTrue(found[0].asset("notes.txt") == null,
        "an asset with nowhere to download it from is left out");
}

test "a page that is not a list of releases is refused" {
    let notJson = releases.readPage("<html>", "https://example.com/releases");
    try testing.assertTrue(notJson.failure().startsWith(
        "the release list at 'https://example.com/releases' is not JSON: "), notJson.failure());
    let notFound = new JsonObject();
    notFound.set("message", new JsonString("Not Found"));
    let notArray = releases.readPage(notFound.toString(), "https://example.com/releases");
    try testing.assertEqual(notArray.failure(), "the release list at "
        + "'https://example.com/releases' is not a list of releases: it is JSON, but not a JSON "
        + "array");
}

test "the newest release of each language version is kept, newest first" {
    let listed = JsonArray.of([
        entry("v0.14.1-beta", false, JsonArray.of([asset("ens", "a", "")])),
        entry("v0.13.3-beta", false, JsonArray.of([asset("ens", "b", "")])),
        entry("v0.14.2-beta", false, JsonArray.of([asset("ens", "c", "")])),
        entry("v0.15.0-beta", false, JsonArray.of([asset("other", "d", "")])),
        entry("v0.9.7-beta", false, JsonArray.of([asset("ens", "e", "")]))]);
    let page = releases.readPage(listed.toString(), "https://example.com/releases");
    Release[] newest = releases.newestPerLanguage(page.releases(), "ens");
    try testing.assertEqual(newest.length, 3);
    try testing.assertEqual(newest[0].version(), "0.14.2-beta");
    try testing.assertEqual(newest[1].version(), "0.13.3-beta");
    try testing.assertEqual(newest[2].version(), "0.9.7-beta");
}

entry(string tag, bool draft, JsonArray assets) -> Json {
    let fields = new JsonObject();
    fields.set("tag_name", new JsonString(tag));
    fields.set("draft", new JsonBool(draft));
    fields.set("assets", assets);
    return fields;
}

// An empty `url` leaves the download address out, and an empty `digest` is a JSON null.
asset(string name, string url, string digest) -> Json {
    let fields = new JsonObject();
    fields.set("name", new JsonString(name));
    if (url.length > 0) {
        fields.set("browser_download_url", new JsonString(url));
    }
    if (digest.length > 0) {
        fields.set("digest", new JsonString(digest));
    } else {
        fields.set("digest", new JsonNull());
    }
    return fields;
}
