// Where a build puts the object files it emits, and what it makes of what the linker printed. Both are
// pure functions of what they are given, so every configuration - including the targets this machine
// cannot build for - is checked here rather than by watching a build write files.
import @std.testing;
import Path from @std.fs;
import ErrorKind from @std.fs.error;
import FileSystemError from @std.fs.error;
import Platform from @std.environment;
import CodegenSettings from @ens.codegen.settings;
import OptimizationLevel from @ens.codegen.settings;
import BuildOptions from options;
import Verbosity from options;
import build;

test "objects go under the build root, keyed by target and optimization level" {
    let options = at(OptimizationLevel.Default, "x86_64-pc-windows-msvc");
    try testing.assertEqual(build.objectsFolderFor(options),
        Path("/repo/app/.ens/x86_64-pc-windows-msvc/O2"));
}

test "each level and each target keeps a folder of its own" {
    string[] levels = ["0", "1", "2", "3"];
    let ordered = [OptimizationLevel.None, OptimizationLevel.Less, OptimizationLevel.Default,
        OptimizationLevel.Aggressive];
    for (long i = 0; i < ordered.length; i++) {
        try testing.assertEqual(build.objectsFolderFor(at(ordered[i], "x86_64-pc-windows-msvc")),
            Path("/repo/app/.ens/x86_64-pc-windows-msvc/O" + levels[i]));
    }
    try testing.assertEqual(
        build.objectsFolderFor(at(OptimizationLevel.Default, "arm64-apple-macosx14.0")),
        Path("/repo/app/.ens/arm64-apple-macosx14.0/O2"));
}

test "a folder named outright is where the objects go instead" {
    let named = at(OptimizationLevel.Default, "x86_64-pc-windows-msvc")
        .withObjectsFolder(Path("/elsewhere/objects"));
    try testing.assertEqual(build.objectsFolderFor(named), Path("/elsewhere/objects"));
}

test "an invocation with no build root settled yet falls back to the folder it was run in" {
    let unsettled = new BuildOptions(Path("/work"), settingsAt(OptimizationLevel.Default,
        "x86_64-pc-windows-msvc"), Path("/repo/libs"), Path(""), Path(""), false, false,
        Verbosity.Normal);
    try testing.assertEqual(build.objectsFolderFor(unsettled),
        Path("/work/.ens/x86_64-pc-windows-msvc/O2"));
}

test "the folder a build root owns is dotted, so it cannot be read as sources or as a package" {
    try testing.assertEqual(build.artifactsFolderIn(Path("/repo/app")), Path("/repo/app/.ens"));
}

test "a failed link is one problem, whatever the linker spent on saying why" {
    let lines = build.linkFailureLines(Path("/repo/app.exe"),
        "lld-link: error: could not open 'zlib.lib'\n");
    try testing.assertEqual(lines.length, 1);
    try testing.assertEqual(lines[0], "linking '/repo/app.exe' failed; the linker reported:\n"
        + "lld-link: error: could not open 'zlib.lib'");
}

test "a link that failed without a word is still reported as one" {
    let lines = build.linkFailureLines(Path("/repo/app.exe"), "\n");
    try testing.assertEqual(lines.length, 1);
    try testing.assertEqual(lines[0],
        "linking '/repo/app.exe' failed and the linker reported no reason");
}

test "what a successful link printed is passed on, and no output is nothing at all" {
    try testing.assertEqual(build.linkerNoise("ld.lld: warning: -z is deprecated\n").length, 1);
    try testing.assertEqual(build.linkerNoise("ld.lld: warning: -z is deprecated\n")[0],
        "ld.lld: warning: -z is deprecated");
    try testing.assertEqual(build.linkerNoise("").length, 0);
    try testing.assertEqual(build.linkerNoise("\n").length, 0);
}

settingsAt(OptimizationLevel level, string triple) -> CodegenSettings {
    return new CodegenSettings(level, triple);
}

at(OptimizationLevel level, string triple) -> BuildOptions {
    return new BuildOptions(Path("/work"), settingsAt(level, triple), Path("/repo/libs"),
        Path(""), Path(""), false, false,
        Verbosity.Normal, Path("/repo/app"));
}

// The program is named where the build was asked to put it, never in the folder it was linked in,
// and a refusal on Windows comes from a file that is open or read-only.
test "a program that could not be put in place is named with what to do" {
    let held = new FileSystemError("could not move 'C:/work/.ens-link-1/app.exe' to "
        + "'C:/work/app.exe': permission was refused", ErrorKind.PermissionDenied,
        Path("C:/work/.ens-link-1/app.exe"), 5, null, "permission was refused");
    try testing.assertEqual(build.replaceText(Path("C:/work/app.exe"), held, Platform.Windows),
        "could not replace 'C:/work/app.exe': another program has it open, such as a running copy "
        + "of the program, or the file is read-only. Close that program or clear the read-only "
        + "setting, and build again");
    let full = new FileSystemError("could not move '/work/.ens-link-1/app' to '/work/app': the "
        + "file system has no room left", ErrorKind.NoSpace, Path("/work/.ens-link-1/app"), 28,
        null, "the file system has no room left");
    try testing.assertEqual(build.replaceText(Path("/work/app"), full, Platform.Linux),
        "could not replace '/work/app': the file system has no room left");
}

// A staging folder an emission could not remove joins the unit's notices under the command's prefix,
// and an emission that removed its folder leaves the notices as they were.
test "a staging folder left behind joins the notices it is reported with" {
    string[] notices = ["Using the override for package 'acme.json': '/work/json'"];
    let unchanged = build.withLeftover(notices, "");
    try testing.assertEqual(unchanged.length, 1L);
    try testing.assertEqual(unchanged[0], "Using the override for package 'acme.json': '/work/json'");
    let reported = build.withLeftover(notices, "could not remove '/work/.ens/O2/staging-1': access is "
        + "denied. Remove '/work/.ens/O2/staging-1' once nothing is using it");
    try testing.assertEqual(reported.length, 2L);
    try testing.assertEqual(reported[0], "Using the override for package 'acme.json': '/work/json'");
    try testing.assertEqual(reported[1], "ens: could not remove '/work/.ens/O2/staging-1': access is "
        + "denied. Remove '/work/.ens/O2/staging-1' once nothing is using it");
}
