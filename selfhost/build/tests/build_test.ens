// Where a build puts the object files it emits. The rule is a pure function of the invocation, so
// every configuration - including the targets this machine cannot build for - is checked here rather
// than by watching a build write files.
import @std.testing;
import CodegenSettings from @ens.codegen.settings;
import OptimizationLevel from @ens.codegen.settings;
import BuildOptions from options;
import Verbosity from options;
import build;

test "objects go under the build root, keyed by target and optimization level" {
    let options = at(OptimizationLevel.Default, "x86_64-pc-windows-msvc");
    try testing.assertEqual(build.objectsFolderFor(options),
        "/repo/app/.ens/x86_64-pc-windows-msvc/O2");
}

test "each level and each target keeps a folder of its own" {
    string[] levels = ["0", "1", "2", "3"];
    let ordered = [OptimizationLevel.None, OptimizationLevel.Less, OptimizationLevel.Default,
        OptimizationLevel.Aggressive];
    for (long i = 0; i < ordered.length; i++) {
        try testing.assertEqual(build.objectsFolderFor(at(ordered[i], "x86_64-pc-windows-msvc")),
            "/repo/app/.ens/x86_64-pc-windows-msvc/O" + levels[i]);
    }
    try testing.assertEqual(
        build.objectsFolderFor(at(OptimizationLevel.Default, "arm64-apple-macosx14.0")),
        "/repo/app/.ens/arm64-apple-macosx14.0/O2");
}

test "a folder named outright is where the objects go instead" {
    let named = at(OptimizationLevel.Default, "x86_64-pc-windows-msvc")
        .withObjectsFolder("/elsewhere/objects");
    try testing.assertEqual(build.objectsFolderFor(named), "/elsewhere/objects");
}

test "an invocation with no build root settled yet falls back to the folder it was run in" {
    let unsettled = new BuildOptions("/work", settingsAt(OptimizationLevel.Default,
        "x86_64-pc-windows-msvc"), "/repo/libs", "", "", false, false, Verbosity.Normal);
    try testing.assertEqual(build.objectsFolderFor(unsettled),
        "/work/.ens/x86_64-pc-windows-msvc/O2");
}

test "the folder a build root owns is dotted, so it cannot be read as sources or as a package" {
    try testing.assertEqual(build.artifactsFolderIn("/repo/app"), "/repo/app/.ens");
}

settingsAt(OptimizationLevel level, string triple) -> CodegenSettings {
    return new CodegenSettings(level, triple);
}

at(OptimizationLevel level, string triple) -> BuildOptions {
    return new BuildOptions("/work", settingsAt(level, triple), "/repo/libs", "", "", false, false,
        Verbosity.Normal, "/repo/app");
}
