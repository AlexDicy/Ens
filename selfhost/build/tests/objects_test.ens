// The names a build keeps its objects under, the versions it clears, and keeping an object whose name
// is already taken. The names are values, and keeping one runs against a scratch folder.
import @std.testing;
import Path from @std.fs;
import objects;
import support;

test "an object is kept under its emitted name with the digest of its bytes" {
    try testing.assertEqual(objects.digestOf("abc".toBytes()), "e71fa2190541574b");
    try testing.assertEqual(objects.digestOf([]), "cbf29ce484222325");
    try testing.assertEqual(objects.contentName("app.main.obj", "abc".toBytes()),
        "app.main.e71fa2190541574b.obj");
    try testing.assertEqual(objects.contentName("app.std.collections.list.o", "abc".toBytes()),
        "app.std.collections.list.e71fa2190541574b.o");
    try testing.assertEqual(objects.contentName("app.main.obj", "abc".toBytes()),
        objects.contentName("app.main.obj", "abc".toBytes()));
    try testing.assertTrue(objects.contentName("app.main.obj", "abd".toBytes())
        != objects.contentName("app.main.obj", "abc".toBytes()), "other bytes take another name");
}

test "a kept name gives back the emitted name it came from" {
    try testing.assertEqual(objects.emittedNameOf("app.main.e71fa2190541574b.obj"), "app.main.obj");
    try testing.assertEqual(objects.emittedNameOf("app.std.io.print.0123456789abcdef.o"),
        "app.std.io.print.o");
    try testing.assertEqual(objects.emittedNameOf("app.main.obj"), "app.main.obj");
    try testing.assertEqual(objects.emittedNameOf("app.main.ABCDEF0123456789.obj"),
        "app.main.ABCDEF0123456789.obj");
}

test "a build clears every other version of the objects it kept, and nothing else" {
    string[] present = ["app.main.aaaaaaaaaaaaaaaa.obj", "app.main.bbbbbbbbbbbbbbbb.obj",
        "app.main.obj", "app.lib.cccccccccccccccc.obj", "tool.main.dddddddddddddddd.obj",
        "staging-1"];
    string[] kept = ["app.main.bbbbbbbbbbbbbbbb.obj"];
    string[] stale = objects.staleNames(present, kept);
    try testing.assertEqual(stale.length, 2L);
    try testing.assertEqual(stale[0], "app.main.aaaaaaaaaaaaaaaa.obj");
    try testing.assertEqual(stale[1], "app.main.obj");
}

test "keeping an object whose name is taken leaves the one there as it was" {
    Path root = try support.scratch("objects-keep");
    try support.writeFile(root, "staging-1/app.main.obj", "first");
    try support.writeFile(root, "staging-2/app.main.obj", "first");
    string name = objects.contentName("app.main.obj", "first".toBytes());
    Path kept = try objects.keepObject(root.join("staging-1/app.main.obj"), root, name);
    try testing.assertEqual(kept, root.join(name));
    try testing.assertFalse(root.join("staging-1/app.main.obj").exists(), "the first is moved");
    Path again = try objects.keepObject(root.join("staging-2/app.main.obj"), root, name);
    try testing.assertEqual(again, kept);
    try testing.assertEqual(try kept.readText(), "first");
    try testing.assertTrue(root.join("staging-2/app.main.obj").exists(),
        "the second copy is left to its staging folder");
    try support.removeTree(root);
}
