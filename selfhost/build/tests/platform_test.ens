// What a target's system determines about the artifacts a build writes. Every result is a pure
// function of the system, so the results for the systems this machine is not are checked on it just
// the same.
import @std.testing;
import Platform from @std.platform;
import Architecture from @ens.target.triple;
import TargetTriple from @ens.target.triple;
import platform;
import support;

test "an executable is named the target's way" {
    try testing.assertEqual(platform.executableSuffix(Platform.Windows), ".exe");
    try testing.assertEqual(platform.executableSuffix(Platform.Linux), "");
    try testing.assertEqual(platform.executableSuffix(Platform.MacOS), "");
}

test "an artifact takes its stem and the target's suffix" {
    try testing.assertEqual(platform.executableNamed("hello", Platform.Windows), "hello.exe");
    try testing.assertEqual(platform.executableNamed("hello", Platform.Linux), "hello");
    try testing.assertEqual(platform.executableNamed("hello", Platform.MacOS), "hello");
}

test "the platform name is the one a manifest's bindings use" {
    try testing.assertEqual(platform.platformName(Platform.Windows), "windows");
    try testing.assertEqual(platform.platformName(Platform.Linux), "linux");
    try testing.assertEqual(platform.platformName(Platform.MacOS), "macos");
}

// The other spelling of this machine's own processor names the same machine, so a command that
// runs what it builds runs it.
test "a command runs what it builds for this machine's processor however it is spelled" {
    let here = host();
    string respelled = otherSpelling(here.architecture())
        + here.text().substring(here.text().indexOf("-"));
    try testing.assertEqual(platform.unrunnableTriple(support.targetOf(respelled)), "");
    try testing.assertEqual(platform.unrunnableTriple(here), "");
}

test "a command refuses to build for another processor what it has to run" {
    let here = host();
    string other = "x86_64";
    if (here.architecture() == Architecture.X64) {
        other = "aarch64";
    }
    string elsewhere = other + here.text().substring(here.text().indexOf("-"));
    try testing.assertEqual(platform.unrunnableTriple(support.targetOf(elsewhere)),
        "'--target {elsewhere}' builds for another machine, and this command runs what it builds "
        + "on this one, '{here.text()}'. Remove '--target', or use 'ens build' to build for "
        + "'{elsewhere}' without running it");
}

test "this machine's target is the triple a build reads for it" {
    try testing.assertEqual(host().text(), platform.hostTriple());
}

test "a command refuses to run what it builds on a machine this toolchain cannot build for" {
    let linux = support.targetOf("x86_64-unknown-linux-gnu");
    try testing.assertEqual(platform.unrunnableOn(linux, support.targetOf("x86_64-pc-linux-gnu"),
        "x86_64-pc-linux-gnu"), "");
    try testing.assertEqual(platform.unrunnableOn(support.targetOf("x86_64-pc-windows-msvc19.40.0"),
        support.targetOf("x86_64-pc-windows-msvc"), "x86_64-pc-windows-msvc"), "");
    try testing.assertEqual(platform.unrunnableOn(linux, null, "x86_64-alpine-linux-musl"),
        "'--target x86_64-unknown-linux-gnu' builds for another machine, and this command runs "
        + "what it builds on this one, 'x86_64-alpine-linux-musl', which this toolchain cannot "
        + "build for. Use 'ens build' to build for 'x86_64-unknown-linux-gnu' without running it");
}

// The spelling of `architecture` other than the one LLVM gives this machine.
otherSpelling(Architecture architecture) -> string {
    string here = platform.hostTriple();
    return switch (architecture) {
        Architecture.X64 -> here.startsWith("x86_64") ? "amd64" : "x86_64",
        Architecture.Arm64 -> here.startsWith("aarch64") ? "arm64" : "aarch64",
    };
}

// This machine's own target, which every machine these tests run on is one this toolchain builds
// for.
host() -> TargetTriple {
    let here = platform.getHostTarget();
    if (here == null) {
        panic("these tests run on '{platform.hostTriple()}', which this toolchain cannot build for");
    }
    return here;
}
