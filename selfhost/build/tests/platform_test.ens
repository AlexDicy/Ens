// What a target triple decides about the artifacts a build writes. Every answer is a pure function
// of the triple, so the answers for the systems this machine is not are checked on it just the same.
import @std.testing;
import platform;

test "an executable is named the target's way" {
    try testing.assertEqual(platform.executableSuffix("x86_64-pc-windows-msvc"), ".exe");
    try testing.assertEqual(platform.executableSuffix("aarch64-pc-windows-msvc"), ".exe");
    try testing.assertEqual(platform.executableSuffix("x86_64-unknown-linux-gnu"), "");
    try testing.assertEqual(platform.executableSuffix("aarch64-unknown-linux-musl"), "");
    try testing.assertEqual(platform.executableSuffix("arm64-apple-macosx14.0"), "");
    try testing.assertEqual(platform.executableSuffix("x86_64-apple-darwin23"), "");
}

test "an artifact takes its stem and the target's suffix" {
    try testing.assertEqual(platform.executableNamed("hello", "x86_64-pc-windows-msvc"),
        "hello.exe");
    try testing.assertEqual(platform.executableNamed("hello", "x86_64-unknown-linux-gnu"),
        "hello");
    try testing.assertEqual(platform.executableNamed("hello", "arm64-apple-macosx14.0"), "hello");
}

test "the platform name is the one a manifest's bindings use" {
    try testing.assertEqual(platform.platformName("x86_64-pc-windows-msvc"), "windows");
    try testing.assertEqual(platform.platformName("i686-pc-windows-gnu"), "windows");
    try testing.assertEqual(platform.platformName("x86_64-unknown-linux-gnu"), "linux");
    try testing.assertEqual(platform.platformName("aarch64-unknown-freebsd"), "linux");
    try testing.assertEqual(platform.platformName("arm64-apple-macosx14.0"), "macos");
    try testing.assertEqual(platform.platformName("x86_64-apple-darwin23"), "macos");
}
