// What a load reports. A syntax error used to end the load before sema ran, so a file with one
// syntax error and six semantic ones reported a single problem and grew to seven once the syntax
// was fixed. Loading now reports both together. A check also loads the tests 'ens test' reads, so
// what it reports holds for them too.
import Path from @std.fs;
import @std.testing;
import CodegenSettings from @ens.codegen.settings;
import OptimizationLevel from @ens.codegen.settings;
import Loaded from program;
import Unit from program;
import EntryReading from program;
import program;
import BuildOptions from options;
import Verbosity from options;
import packaging;
import MemoryFileLoader from support;
import support;
import BuildTarget from target;
import WorkspaceMember from target;
import target;
import SystemFileLoader from @ens.sema.support.loader;

loadFile(string text) -> Loaded {
    let loader = new MemoryFileLoader();
    loader.add("/proj/src/main.ens", text);
    loader.add("/stdlib/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    loader.add("/stdlib/std/src/io/print.ens", "export print(string message) \{ \}\n"
        + "export eprint(string message) \{ \}\n");
    loader.add("/stdlib/std/src/core.ens", "export struct StackFrame \{\n"
        + "    export const string function;\n"
        + "    export const string file;\n"
        + "    export const int line;\n"
        + "\}\n"
        + "export class Error \{\n"
        + "    export string message;\n"
        + "    export constructor(this.message);\n"
        + "\}\n");
    let options = new BuildOptions(Path("/proj"),
        new CodegenSettings(OptimizationLevel.Default, "x86_64-pc-windows-msvc"),
        Path("/stdlib"), Path(""), Path(""),
        true, false, Verbosity.Normal);
    return program.load(loader, options, packaging.none(),
        program.fileUnit(Path("/proj/src"), "main.ens", "main"));
}

// Every case here is a diagnostic the compiler formatted, so each one names its own file and
// position and prints as it was formatted.
assertReports(Loaded loaded, string[] expected) throws {
    let problems = loaded.diagnostics();
    if (problems.length != expected.length) {
        try testing.fail("expected {expected.length} problems but found {problems.length}: "
            + joined(problems));
    }
    for (long i = 0; i < expected.length; i++) {
        try testing.assertTrue(problems[i].indexOf(expected[i]) >= 0,
            "problem {i} should mention '{expected[i]}' but is '{problems[i]}'");
    }
}

joined(string[] problems) -> string {
    string text = "";
    for (long i = 0; i < problems.length; i++) {
        text = text + "\n  " + problems[i];
    }
    return text;
}

test "a syntax error in one body does not hide the semantic errors around it" {
    let loaded = loadFile("broken() \{\n"
        + "    let value = 1 +\n"
        + "\}\n"
        + "main() \{\n"
        + "    let found = nowhere();\n"
        + "    string text = 42;\n"
        + "\}\n");
    try testing.assertTrue(!loaded.succeeded(), "the load failed");
    try assertReports(loaded, [
        "Expected a value, such as '42', a variable's name or a call like 'count()'.",
        "Expected ';' after the variable declaration",
        "Undefined function 'nowhere'",
        "Variable 'text' has type 'string', but its value has type 'int'.",
    ]);
}

test "a syntax error in what a file declares leaves the semantic errors unreported" {
    let loaded = loadFile("class Box \{\n"
        + "    long;\n"
        + "\}\n"
        + "main() \{\n"
        + "    let found = nowhere();\n"
        + "\}\n");
    try testing.assertTrue(!loaded.succeeded(), "the load failed");
    try assertReports(loaded, ["Expected the field's name"]);
}

test "a file with no syntax error reports its semantic errors as before" {
    let loaded = loadFile("main() \{\n    let found = nowhere();\n\}\n");
    try testing.assertTrue(!loaded.succeeded(), "the load failed");
    try assertReports(loaded, ["Undefined function 'nowhere'"]);
}

// A file whose syntax error may be what hides main() is not read as lacking one, so a command that
// runs it builds it and the build reports the error.
test "an entry file's syntax error leaves its main() uncertain rather than absent" {
    let loader = new MemoryFileLoader();
    loader.add("/proj/declared.ens", "main() -> int \{\n    return 0;\n\}\n");
    loader.add("/proj/absent.ens", "helper() -> int \{\n    return 0;\n\}\n");
    loader.add("/proj/hidden.ens", "attempt() \{\n    if (true) \{\n\n  main() -> int \{\n"
        + "    return 0;\n\}\n");
    loader.add("/proj/broken.ens", "attempt() \{\n    let v = (1 +;\n\}\n\nmain() -> int \{\n"
        + "    return 0;\n\}\n");
    try testing.assertTrue(program.readEntryFile(loader, Path("/proj/declared.ens"))
        == EntryReading.Declared, "a file declaring main() declares it");
    try testing.assertTrue(program.readEntryFile(loader, Path("/proj/absent.ens"))
        == EntryReading.Absent, "a sound file without main() lacks it");
    try testing.assertTrue(program.readEntryFile(loader, Path("/proj/hidden.ens"))
        == EntryReading.Uncertain, "an unclosed block may hide main()");
    try testing.assertTrue(program.readEntryFile(loader, Path("/proj/broken.ens"))
        == EntryReading.Declared, "a syntax error elsewhere leaves main() declared");
    try testing.assertTrue(program.readEntryFile(loader, Path("/proj/missing.ens"))
        == EntryReading.Absent, "a file that cannot be read declares nothing");
}

// The standard library named as the target is loaded under the paths '@std' imports reach it by,
// so each of its modules is one module and a type it declares is one type.
test "the standard library as the target is loaded once, as the library" {
    let loader = new MemoryFileLoader();
    loader.add("/stdlib/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    loader.add("/stdlib/std/src/io/print.ens", "export print(string message) \{ \}\n"
        + "export eprint(string message) \{ \}\n");
    loader.add("/stdlib/std/src/core.ens", "export struct StackFrame \{\n"
        + "    export const string function;\n"
        + "    export const string file;\n"
        + "    export const int line;\n"
        + "\}\n"
        + "export class Error \{\n"
        + "    export string message;\n"
        + "    export constructor(this.message);\n"
        + "\}\n");
    loader.add("/stdlib/std/src/fs.ens", "export final class Path \{\n    export constructor();\n\}\n\n"
        + "export read(Path path) \{ \}\n");
    loader.add("/stdlib/std/src/walk.ens", "import Path from @std.fs;\nimport @std.fs;\n\n"
        + "export walk() \{\n    fs.read(new Path());\n\}\n");
    let options = new BuildOptions(Path("/stdlib/std"),
        new CodegenSettings(OptimizationLevel.Default, "x86_64-pc-windows-msvc"),
        Path("/stdlib"), Path(""), Path(""),
        true, false, Verbosity.Normal);
    string[] seeds = ["core.ens", "fs.ens", "io/print.ens", "walk.ens"];
    let loaded = program.load(loader, options, packaging.none(),
        program.seededUnit(Path("/stdlib/std/src"), Path(""), seeds, "main", "std"));
    string[] none = [];
    try assertReports(loaded, none);
    try testing.assertEqual(loaded.moduleCount(), 4L);
}

// A package whose test file imports the class: the check reads the tests, so it leaves out the fix
// that would make the class private to its module, which a build of the sources alone offers.
test "a checked package reads its tests, so a fix it offers keeps them compiling" {
    let rootFolder = try support.scratch("check-package-tests");
    Path root = rootFolder.path();
    try writeStandardLibrary(root);
    Path packageFolder = root.join("registry");
    try writeRegistry(packageFolder);
    try support.writeFile(packageFolder, "tests/registry_test.ens", "import Registry from lib;\n\n"
        + "test \"a registry can be made\" \{\n"
        + "    let registry = new Registry();\n"
        + "    int wrong = \"text\";\n"
        + "\}\n");
    let resolved = try resolvedAt(root, packageFolder);
    let checked = program.checkedUnitOf(resolved);
    try testing.assertTrue(checked.loadsTests(), "a package's check reads its tests");
    try testing.assertEqual(checked.testFilesFolder(), resolved.testsFolder());

    let loaded = loadIn(root, checked);
    try testing.assertEqual(loaded.diagnostics().length, 2L);
    try testing.assertTrue(loaded.diagnostics()[0].endsWith(registryText(
        "Mark 'Secret' 'public'. Or mark 'Registry' 'final'.")), loaded.diagnostics()[0]);
    try testing.assertTrue(loaded.diagnostics()[1].endsWith("registry_test.ens:5:17: error: "
        + "Variable 'wrong' has type 'int', but its value has type 'string'. Declare 'wrong' as a "
        + "'string' instead."), loaded.diagnostics()[1]);

    let built = loadIn(root, program.unitOf(resolved));
    try testing.assertEqual(built.diagnostics().length, 1L);
    try testing.assertTrue(built.diagnostics()[0].endsWith(registryText("Mark 'Secret' 'public'. "
        + "Or remove 'public' from 'Registry' and its constructor. Or mark 'Registry' 'final'.")),
        built.diagnostics()[0]);
}

// With no tests folder, 'ens test' reads the test files among the sources, and so does a check.
test "a check reads the test files kept among the sources" {
    let rootFolder = try support.scratch("check-folder-tests");
    Path root = rootFolder.path();
    try writeStandardLibrary(root);
    Path folder = root.join("tool");
    try support.writeFile(folder, "main.ens", "main() \{\n\}\n");
    try support.writeFile(folder, "parts/count_test.ens", "test \"counting\" \{\n"
        + "    long total = \"none\";\n"
        + "\}\n");
    let resolved = try resolvedAt(root, folder);
    let checked = program.checkedUnitOf(resolved);
    try testing.assertTrue(checked.loadsTests(), "a folder's check reads its tests");
    try testing.assertEqual(checked.testFilesFolder(), resolved.sourceFolder());
    let loaded = loadIn(root, checked);
    try testing.assertEqual(loaded.diagnostics().length, 1L);
    try testing.assertTrue(loaded.diagnostics()[0].endsWith("count_test.ens:2:18: error: "
        + "Variable 'total' has type 'long', but its value has type 'string'. Declare 'total' as "
        + "a 'string' instead."), loaded.diagnostics()[0]);
}

// 'ens test' refuses a single file, so a check of one has no tests to read.
test "a checked single file reads no tests" {
    let rootFolder = try support.scratch("check-file-tests");
    Path root = rootFolder.path();
    try support.writeFile(root, "hello.ens", "main() \{\n\}\n");
    try support.writeFile(root, "hello_test.ens", "test \"never read\" \{\n\}\n");
    let checked = program.checkedUnitOf(try resolvedAt(root, root.join("hello.ens")));
    try testing.assertFalse(checked.loadsTests(), "a file's check reads no tests");
    try testing.assertEqual(checked.entryFile(), "hello.ens");
}

// A member is checked against the tests 'ens test' runs for it: its own tests folder, or its
// sources when it has none.
test "a checked workspace member reads its own tests" {
    let rootFolder = try support.scratch("check-member-tests");
    Path root = rootFolder.path();
    try support.writeFile(root, "app/src/main.ens", "main() \{\n\}\n");
    try support.writeFile(root, "app/tests/app_test.ens", "test \"app\" \{\n\}\n");
    try support.writeFile(root, "lib/src/lib.ens", "export one() -> int \{\n    return 1;\n\}\n");
    string[] none = [];
    let app = program.checkedMemberUnit(new WorkspaceMember("demo.app", root.join("app"), none,
        "0.1"), root);
    try testing.assertTrue(app.loadsTests(), "a member's check reads its tests");
    try testing.assertEqual(app.testFilesFolder(), root.join("app").join("tests"));
    try testing.assertEqual(app.overridesFolder() ?? Path(""), root);
    let lib = program.checkedMemberUnit(new WorkspaceMember("demo.lib", root.join("lib"), none,
        "0.1"), root);
    try testing.assertTrue(lib.testsFolder().isEmpty(), "a member with no tests folder");
    try testing.assertEqual(lib.testFilesFolder(), root.join("lib").join("src"));
}

// The standard library checked with its tests keeps its sources as the library, so each of its
// types is one type however a test reaches it.
test "the standard library checked with its tests is loaded once, as the library" {
    let rootFolder = try support.scratch("check-library-tests");
    Path root = rootFolder.path();
    try writeStandardLibrary(root);
    Path library = root.join("libs").join("std");
    try support.writeFile(library, "src/fs.ens", "export final class Path \{\n"
        + "    export constructor();\n"
        + "\}\n");
    try support.writeFile(library, "tests/fs_test.ens", "import Path from @std.fs;\n\n"
        + "test \"a path can be made\" \{\n"
        + "    Path made = new Path();\n"
        + "\}\n");
    let loaded = loadIn(root, program.checkedUnitOf(try resolvedAt(root, library)));
    string[] none = [];
    try assertReports(loaded, none);
    try testing.assertEqual(loaded.moduleCount(), 4L);
}

// The modules every program imports, in the scratch tree's own standard library.
writeStandardLibrary(Path root) throws {
    Path library = root.join("libs").join("std");
    try support.writeFile(library, "ens.package", "package std \{ ens \"0.1\"; \}\n");
    try support.writeFile(library, "src/io/print.ens", "export print(string message) \{ \}\n"
        + "export eprint(string message) \{ \}\n");
    try support.writeFile(library, "src/core.ens", "export struct StackFrame \{\n"
        + "    export const string function;\n"
        + "    export const string file;\n"
        + "    export const int line;\n"
        + "\}\n"
        + "export class Error \{\n"
        + "    export string message;\n"
        + "    export constructor(this.message);\n"
        + "\}\n");
}

// A package with a public class whose protected method takes a type private to its module.
writeRegistry(Path packageFolder) throws {
    try support.writeFile(packageFolder, "ens.package",
        "package demo.registry \{\n    ens \"0.1\";\n\}\n");
    try support.writeFile(packageFolder, "src/main.ens", "main() \{\n\}\n");
    try support.writeFile(packageFolder, "src/lib.ens", "class Secret \{\n"
        + "\}\n"
        + "\n"
        + "public class Registry \{\n"
        + "    public constructor();\n"
        + "\n"
        + "    protected keep(Secret secret) \{\n"
        + "    \}\n"
        + "\}\n");
}

registryText(string fixes) -> string {
    return "lib.ens:7:20: error: Method 'keep' of class 'Registry' is protected, and 'Registry' is "
        + "'public', so a subclass anywhere in the package can call it, but its parameter type "
        + "uses 'Secret', which is private to module 'lib'. {fixes}";
}

resolvedAt(Path root, Path named) -> BuildTarget throws {
    let resolution = target.resolve(new SystemFileLoader(), root, named.toString());
    let resolved = resolution.target();
    if (resolved == null) {
        try testing.fail("'{named}' did not resolve: {resolution.failure()}");
    }
    return resolved;
}

loadIn(Path root, Unit unit) -> Loaded {
    let options = new BuildOptions(root,
        new CodegenSettings(OptimizationLevel.Default, "x86_64-pc-windows-msvc"),
        root.join("libs"), Path(""), Path(""),
        true, false, Verbosity.Normal);
    return program.load(new SystemFileLoader(), options, packaging.none(), unit);
}
