import @std.testing;
import Platform from @std.platform;
import JsonObject from @std.json;
import JsonString from @std.json;
import releasesource;
import support;

test "the default source is GitHub, and the token goes only there" {
    let bare = releasesource.sourceFor(support.given(Platform.Linux, ["HOME=/home/ada"]));
    try testing.assertEqual(bare.url(), "https://api.github.com/repos/AlexDicy/Ens/releases");
    try testing.assertEqual(bare.token(), "");
    try testing.assertEqual(bare.failure(), "");

    let github = releasesource.sourceFor(support.given(Platform.Linux, ["GITHUB_TOKEN=secret"]));
    try testing.assertEqual(github.token(), "secret");

    let mirror = releasesource.sourceFor(support.given(Platform.Linux,
        ["GITHUB_TOKEN=secret", "ENS_RELEASES=https://mirror.example.com/releases"]));
    try testing.assertEqual(mirror.url(), "https://mirror.example.com/releases");
    try testing.assertEqual(mirror.token(), "");

    let named = releasesource.sourceFor(support.given(Platform.Linux,
        ["GITHUB_TOKEN=secret", "ENS_RELEASES=https://mirror.example.com/releases",
         "ENS_RELEASES_TOKEN=github"]));
    try testing.assertEqual(named.token(), "");
}

test "'ENS_RELEASES_TOKEN=always' sends the token to any source" {
    let always = releasesource.sourceFor(support.given(Platform.Linux,
        ["GITHUB_TOKEN=secret", "ENS_RELEASES=https://mirror.example.com/releases",
         "ENS_RELEASES_TOKEN=always"]));
    try testing.assertEqual(always.token(), "secret");
}

test "an 'ENS_RELEASES_TOKEN' that is not recognized is refused" {
    let wrong = releasesource.sourceFor(support.given(Platform.Linux, ["ENS_RELEASES_TOKEN=yes"]));
    try testing.assertEqual(wrong.failure(), "'ENS_RELEASES_TOKEN' is set to 'yes', which is not "
        + "recognized. Set it to 'always' to send 'GITHUB_TOKEN' to the release source "
        + "'ENS_RELEASES' names, or remove it to send the token only to 'https://api.github.com'");
}

test "each page is asked for by number, after any query the source already has" {
    try testing.assertEqual(releasesource.pageUrl("https://example.com/releases", 2),
        "https://example.com/releases?per_page=100&page=2");
    try testing.assertEqual(releasesource.pageUrl("https://example.com/releases?x=1", 1),
        "https://example.com/releases?x=1&per_page=100&page=1");
}

test "the token goes in a header only when it is sent" {
    try testing.assertEqual(releasesource.headerLines(""),
        "Accept: application/vnd.github+json\nX-GitHub-Api-Version: 2022-11-28\n");
    try testing.assertEqual(releasesource.headerLines("secret"),
        "Accept: application/vnd.github+json\nX-GitHub-Api-Version: 2022-11-28\n"
        + "Authorization: Bearer secret\n");
}

test "a refused request names the status and what the server said" {
    let bare = releasesource.sourceFor(support.given(Platform.Linux, ["HOME=/home/ada"]));
    try testing.assertEqual(releasesource.statusProblem(bare, "404", said("Not Found")),
        "the release list at 'https://api.github.com/repos/AlexDicy/Ens/releases' could not be "
        + "downloaded: the server answered with status 404 and the message 'Not Found'");
    try testing.assertEqual(releasesource.statusProblem(bare, "502", "<html>"),
        "the release list at 'https://api.github.com/repos/AlexDicy/Ens/releases' could not be "
        + "downloaded: the server answered with status 502");
}

test "a failed transfer quotes curl, not the status code it printed last" {
    try testing.assertEqual(releasesource.complaintOf(["curl: (37) Couldn't open file x", "000"],
        "fallback"), "curl: (37) Couldn't open file x");
    string[] nothing = [];
    try testing.assertEqual(releasesource.complaintOf(nothing, "fallback"), "fallback");
}

test "a rate limit without a token says to set one" {
    string limited = said("API rate limit exceeded for 1.2.3.4.");
    let bare = releasesource.sourceFor(support.given(Platform.Linux, ["HOME=/home/ada"]));
    try testing.assertEqual(releasesource.statusProblem(bare, "403", limited),
        "the release list at 'https://api.github.com/repos/AlexDicy/Ens/releases' could not be "
        + "downloaded: the server answered with status 403 and the message 'API rate limit "
        + "exceeded for 1.2.3.4.'. Set 'GITHUB_TOKEN' to a GitHub token to raise the limit");
    let tokened = releasesource.sourceFor(support.given(Platform.Linux, ["GITHUB_TOKEN=secret"]));
    try testing.assertFalse(releasesource.statusProblem(tokened, "403", limited).contains(
        "Set 'GITHUB_TOKEN'"), "a token that was sent is not suggested again");
}

// An error response carrying `message`, the way GitHub writes one.
said(string message) -> string {
    let fields = new JsonObject();
    fields.set("message", new JsonString(message));
    return fields.toString();
}
