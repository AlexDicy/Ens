// Diagnostic output: positions resolve through the catalog, files outside the graph are read on
// demand, and the merged list orders by (file, offset) with report order breaking ties.
import @std.testing;
import MemoryFileLoader from support;
import Source from @ens.frontend.support.source;
import @ens.frontend.support.source;
import FileDiagnostic from @ens.sema.support.diagnostics;
import RelatedLocation from @ens.sema.support.diagnostics;
import List from @std.collections.list;
import SourceCatalog from diagnostics;
import diagnostics;

test "a diagnostic formats as file, position, and message" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    catalog.add(new Source("/src/main.ens", "first\nsecond\n"));
    let diagnostic = new FileDiagnostic("/src/main.ens", "'x' is not defined.",
        source.makeSpan(8, 1));
    try testing.assertEqual(diagnostics.format(diagnostic, catalog),
        "/src/main.ens:2:3: error: 'x' is not defined.");
}

test "a file outside the graph is read through the loader" {
    let loader = new MemoryFileLoader();
    loader.add("/work/ens.package", "package broken \{\n\}\n");
    let catalog = new SourceCatalog(loader);
    let diagnostic = new FileDiagnostic("/work/ens.package", "Expected 'ens'.",
        source.makeSpan(17, 1));
    try testing.assertEqual(diagnostics.format(diagnostic, catalog),
        "/work/ens.package:2:1: error: Expected 'ens'.");
}

test "an unreadable file still reports, without a position" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    let diagnostic = new FileDiagnostic("/gone.ens", "Could not read /gone.ens.",
        source.makeSpan(0, 0));
    try testing.assertEqual(diagnostics.format(diagnostic, catalog),
        "/gone.ens: error: Could not read /gone.ens.");
}

test "diagnostics order by file then offset, stably" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    catalog.add(new Source("/a.ens", "one\ntwo\n"));
    catalog.add(new Source("/b.ens", "three\n"));
    let merged = new List<FileDiagnostic>();
    merged.push(new FileDiagnostic("/b.ens", "third", source.makeSpan(0, 1)));
    merged.push(new FileDiagnostic("/a.ens", "second", source.makeSpan(4, 1)));
    merged.push(new FileDiagnostic("/a.ens", "first", source.makeSpan(0, 1)));
    merged.push(new FileDiagnostic("/a.ens", "also first", source.makeSpan(0, 1)));
    string[] lines = diagnostics.formatAll(merged, catalog);
    try testing.assertEqual(lines.length, 4);
    try testing.assertEqual(lines[0], "/a.ens:1:1: error: first");
    try testing.assertEqual(lines[1], "/a.ens:1:1: error: also first");
    try testing.assertEqual(lines[2], "/a.ens:2:1: error: second");
    try testing.assertEqual(lines[3], "/b.ens:1:1: error: third");
}

test "a diagnostic pointing at a second place adds a note line to its own entry" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    catalog.add(new Source("/src/main.ens", "first\nsecond\n"));
    catalog.add(new Source("/lib/slots.ens", "one\ntwo\n"));
    let diagnostic = new FileDiagnostic("/src/main.ens", "'Slots<Path>' cannot be created.",
        source.makeSpan(8, 1), new RelatedLocation("/lib/slots.ens", source.makeSpan(4, 3),
            "an array of 'T' is created here"));
    try testing.assertEqual(diagnostics.format(diagnostic, catalog),
        "/src/main.ens:2:3: error: 'Slots<Path>' cannot be created.\n"
            + "/lib/slots.ens:2:1: note: an array of 'T' is created here");
}

test "a note is part of its diagnostic's entry, so it counts as no problem" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    catalog.add(new Source("/a.ens", "one\ntwo\n"));
    catalog.add(new Source("/lib.ens", "three\n"));
    let merged = new List<FileDiagnostic>();
    merged.push(new FileDiagnostic("/a.ens", "second", source.makeSpan(4, 1)));
    merged.push(new FileDiagnostic("/a.ens", "first", source.makeSpan(0, 1),
        new RelatedLocation("/lib.ens", source.makeSpan(0, 5), "written here")));
    string[] lines = diagnostics.formatAll(merged, catalog);
    try testing.assertEqual(lines.length, 2);
    try testing.assertEqual(lines[0],
        "/a.ens:1:1: error: first\n/lib.ens:1:1: note: written here");
    try testing.assertEqual(lines[1], "/a.ens:2:1: error: second");
}

test "a note whose file is unreadable still reports, without a position" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    catalog.add(new Source("/src/main.ens", "first\n"));
    let diagnostic = new FileDiagnostic("/src/main.ens", "'Slots<Path>' cannot be created.",
        source.makeSpan(0, 1), new RelatedLocation("/gone.ens", source.makeSpan(0, 0),
            "an array of 'T' is created here"));
    try testing.assertEqual(diagnostics.format(diagnostic, catalog),
        "/src/main.ens:1:1: error: 'Slots<Path>' cannot be created.\n"
            + "/gone.ens: note: an array of 'T' is created here");
}

test "an array of diagnostics formats the same way a list does" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    catalog.add(new Source("/a.ens", "one\ntwo\n"));
    FileDiagnostic[] found = [new FileDiagnostic("/a.ens", "second", source.makeSpan(4, 1)),
        new FileDiagnostic("/a.ens", "first", source.makeSpan(0, 1))];
    string[] lines = diagnostics.formatAll(found, catalog);
    try testing.assertEqual(lines.length, 2);
    try testing.assertEqual(lines[0], "/a.ens:1:1: error: first");
    try testing.assertEqual(lines[1], "/a.ens:2:1: error: second");
}

test "a diagnostic pointing at several other places adds a note line for each, in order" {
    let catalog = new SourceCatalog(new MemoryFileLoader());
    catalog.add(new Source("/c/ens.package", "native zlib;\n"));
    catalog.add(new Source("/a/ens.package", "one\nnative zlib;\n"));
    RelatedLocation[] notes = [
        new RelatedLocation("/a/ens.package", source.makeSpan(4, 12), "declared here"),
        new RelatedLocation("/b/ens.package", source.makeSpan(0, 12), "also declared here")];
    let diagnostic = new FileDiagnostic("/c/ens.package", "declared differently",
        source.makeSpan(0, 12), notes);
    try testing.assertEqual(diagnostics.format(diagnostic, catalog),
        "/c/ens.package:1:1: error: declared differently\n"
            + "/a/ens.package:2:1: note: declared here\n"
            + "/b/ens.package: note: also declared here");
}
