// Discovering the tests under a folder: which files hold them, which tests they declare, what a
// filter keeps, and every way a folder of tests cannot be run.
import @std.testing;
import @std.path;
import FileLoader from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import testing.discovery;
import support;

test "every test file under the folder is read, in path order and source order" {
    string root = try support.scratch("discovery-order");
    try support.writeFile(root, "alpha_test.ens",
        "test \"second alpha\" \{ \}\n\ntest \"first alpha\" \{ \}\n");
    try support.writeFile(root, "nested/beta_test.ens", "test \"only beta\" \{ \}\n");
    try support.writeFile(root, "nested/helper.ens", "export help() \{\}\n");

    let plan = discovery.plan(loader(), root, "");
    try testing.assertEqual(plan.usageProblem(), "");
    try testing.assertEqual(plan.nothingToRun(), "");
    try testing.assertEqual(plan.testFiles().length, 2);
    try testing.assertEqual(plan.testFiles()[0], "alpha_test.ens");
    try testing.assertEqual(plan.testFiles()[1], "nested/beta_test.ens");

    try testing.assertEqual(plan.discoveredCount(), 3);
    try testing.assertEqual(plan.tests().length, 3);
    try testing.assertEqual(plan.tests()[0].description(), "second alpha");
    try testing.assertEqual(plan.tests()[0].modulePath(), "alpha_test");
    try testing.assertEqual(plan.tests()[0].index(), 0);
    try testing.assertEqual(plan.tests()[1].description(), "first alpha");
    try testing.assertEqual(plan.tests()[1].index(), 1);
    try testing.assertEqual(plan.tests()[2].modulePath(), "nested.beta_test");
    try testing.assertEqual(plan.tests()[2].file(), "nested/beta_test.ens");
    try testing.assertEqual(plan.tests()[2].index(), 0);
    try support.removeTree(root);
}

test "a description keeps the literal it was written as, escapes and all" {
    string root = try support.scratch("discovery-literal");
    try support.writeFile(root, "quoted_test.ens", "test \"says \\\"hi\\\"\" \{ \}\n");
    let plan = discovery.plan(loader(), root, "");
    try testing.assertEqual(plan.tests().length, 1);
    try testing.assertEqual(plan.tests()[0].literal(), "\"says \\\"hi\\\"\"");
    try testing.assertEqual(plan.tests()[0].description(), "says \"hi\"");
    try support.removeTree(root);
}

test "a filter keeps the tests whose description contains it" {
    string root = try support.scratch("discovery-filter");
    try support.writeFile(root, "mixed_test.ens",
        "test \"finds the needle\" \{ \}\n\ntest \"finds the haystack\" \{ \}\n");
    let plan = discovery.plan(loader(), root, "needle");
    try testing.assertEqual(plan.nothingToRun(), "");
    try testing.assertEqual(plan.discoveredCount(), 2);
    try testing.assertEqual(plan.tests().length, 1);
    try testing.assertEqual(plan.tests()[0].description(), "finds the needle");
    try support.removeTree(root);
}

test "a filter that matches nothing is an answer, not a failure" {
    string root = try support.scratch("discovery-nomatch");
    try support.writeFile(root, "mixed_test.ens",
        "test \"finds the needle\" \{ \}\n\ntest \"finds the haystack\" \{ \}\n");
    let plan = discovery.plan(loader(), root, "unicorn");
    try testing.assertEqual(plan.usageProblem(), "");
    try testing.assertFalse(plan.runnable(), "nothing was kept");
    try testing.assertEqual(plan.discoveredCount(), 2);
    try assertMentions(plan.nothingToRun(), "unicorn");
    try assertMentions(plan.nothingToRun(), "2 tests are");
    try support.removeTree(root);
}

test "a folder with no test files says how a test file is named" {
    string root = try support.scratch("discovery-notests");
    try support.writeFile(root, "main.ens", "main() -> int \{\n    return 0;\n\}\n");
    let plan = discovery.plan(loader(), root, "");
    try testing.assertEqual(plan.usageProblem(), "");
    try assertMentions(plan.nothingToRun(), "_test.ens");
    try assertMentions(plan.nothingToRun(), root);
    try support.removeTree(root);
}

test "test files that declare no tests say how a test is written" {
    string root = try support.scratch("discovery-empty-files");
    try support.writeFile(root, "empty_test.ens", "import @std.testing;\n");
    let plan = discovery.plan(loader(), root, "");
    try testing.assertEqual(plan.usageProblem(), "");
    try assertMentions(plan.nothingToRun(), "declare no tests");
    try support.removeTree(root);
}

test "two test files with the same name are refused, naming both" {
    string root = try support.scratch("discovery-collision");
    try support.writeFile(root, "lex/scan_test.ens", "test \"one\" \{ \}\n");
    try support.writeFile(root, "parse/scan_test.ens", "test \"two\" \{ \}\n");
    let plan = discovery.plan(loader(), root, "");
    try assertMentions(plan.usageProblem(), "lex/scan_test.ens");
    try assertMentions(plan.usageProblem(), "parse/scan_test.ens");
    try assertMentions(plan.usageProblem(), "'scan_test'");
    try support.removeTree(root);
}

test "a test file that defines main() is refused, naming the file" {
    string root = try support.scratch("discovery-main");
    try support.writeFile(root, "entry_test.ens",
        "test \"one\" \{ \}\n\nmain() -> int \{\n    return 0;\n\}\n");
    let plan = discovery.plan(loader(), root, "");
    try assertMentions(plan.usageProblem(), "entry_test.ens");
    try assertMentions(plan.usageProblem(), "main()");
    try support.removeTree(root);
}

test "a folder that cannot be read is refused, naming the folder" {
    let plan = discovery.plan(loader(), "build/ens-build-tests/definitely-not-here", "");
    try assertMentions(plan.usageProblem(), "definitely-not-here");
}

test "a file path becomes the module path an import of it writes" {
    try testing.assertEqual(discovery.modulePathOf("greeting_test.ens"), "greeting_test");
    try testing.assertEqual(discovery.modulePathOf("lex/lexer_test.ens"), "lex.lexer_test");
    try testing.assertEqual(discovery.modulePathOf("a/b/c_test.ens"), "a.b.c_test");
}

loader() -> FileLoader {
    return new SystemFileLoader();
}

assertMentions(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}
