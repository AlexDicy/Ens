// The synthesized runner: the source it is, the tree it enters over, and what the code it ends
// with means.
import Path from @std.fs;
import @std.testing;
import StringBuilder from @std.text.stringbuilder;
import FileLoader from @ens.sema.support.loader;
import FileError from @ens.sema.support.loader;
import SystemFileLoader from @ens.sema.support.loader;
import DiscoveredTest from testing.discovery;
import testing.discovery;
import Runner from testing.runner;
import RunnerOverlay from testing.runner;
import RunnerOutput from testing.runner;
import testing.runner;
import support;

test "the runner imports each module once and calls every test by its place in the run" {
    let rootFolder = try support.scratch("runner-source");
    Path root = rootFolder.path();
    try support.writeFile(root, "alpha_test.ens", "test \"first\" \{ \}\n\ntest \"second\" \{ \}\n");
    try support.writeFile(root, "nested/beta_test.ens", "test \"third\" \{ \}\n");
    let plan = discovery.plan(new SystemFileLoader(), root, "");
    string source = runner.source(plan.tests());

    try assertOnce(source, "import @std.io;\n");
    try assertOnce(source, "import IoError from @std.io.streams;\n");
    try assertOnce(source, "import alpha_test;\n");
    try assertOnce(source, "import nested.beta_test;\n");
    try assertContains(source, "try alpha_test.$test0();");
    try assertContains(source, "try alpha_test.$test1();");
    try assertContains(source, "try beta_test.$test0();");
    try assertContains(source, "    $started(2);\n");
    try assertContains(source, "    $finished(2, \"PASS \" + \"third\", true);\n");
    try assertContains(source, "        2 -> $run2(),\n");
    try assertContains(source, "        for (long position = 0; position < 3; position++) \{\n");
    try testing.assertTrue(source.indexOf("tests passed") < 0,
        "the runner prints a summary of its own: {source}");
}

// Every line about a test carries the marker and the test's place, the lines of one event go out
// in one print, and each is flushed at once.
test "the runner marks and flushes every line it writes about a test" {
    let tests = try discovered("runner-flush", "test \"first\" \{ \}\n\ntest \"second\" \{ \}\n");
    string source = runner.source(tests);
    try assertOnce(source, "$flush() \{\n    try io.flush();\n\} catch (IoError ignored) \{\n\}\n");
    try assertContains(source, "    print(\"$ens_test_runner start \{position\}\");\n    $flush();\n");
    try assertContains(source,
        "        written = written + \"$ens_test_runner line \{position\} \{line\}\\n\";\n");
    try assertContains(source,
        "    print(written + \"$ens_test_runner \{verdict\} \{position\}\");\n    $flush();\n");
}

// Each dispatch function chooses between one group's tests, and the entry point's choice is of a
// group, so no switch grows with the suite.
test "the runner dispatches to a test through its group" {
    let text = new StringBuilder();
    for (long i = 0; i < 65; i++) {
        text.append("test \"case {i}\" \{ \}\n");
    }
    let tests = try discovered("runner-groups", text.toString());
    string source = runner.source(tests);
    try assertContains(source, "$group0(long position) -> bool \{\n    return switch (position) \{\n"
        + "        0 -> $run0(),\n");
    try assertContains(source, "        63 -> $run63(),\n        default -> false,\n");
    try assertContains(source, "$group1(long position) -> bool \{\n    return switch (position) \{\n"
        + "        64 -> $run64(),\n        default -> false,\n");
    try assertContains(source, "    return switch (position / 64) \{\n        0 -> $group0(position),\n"
        + "        1 -> $group1(position),\n        default -> false,\n");
}

// The program runs the places it is given one after another, each a place or a range of them,
// and every test when it is given none.
test "the runner runs the places it is given in order, and every test when given none" {
    let tests = try discovered("runner-order", "test \"first\" \{ \}\n\ntest \"second\" \{ \}\n");
    string source = runner.source(tests);
    try assertContains(source, "    if (given.length == 0) \{\n"
        + "        for (long position = 0; position < 2; position++) \{\n");
    try assertContains(source, "        long dash = range.indexOf(\"-\");\n");
    try assertContains(source, "            for (long position = first; position <= last; "
        + "position++) \{\n");
    try assertContains(source,
        "    for (let position in order) \{\n        if ($run(position)) \{\n");
    try assertContains(source, "    if (passed == order.length) \{\n        return 0;\n");
    try testing.assertTrue(source.indexOf("@std.tasks") < 0,
        "the runner starts tasks of its own: {source}");
}

test "the places to run are written as ranges where they run on" {
    try assertArguments(runner.positionArguments([0, 1, 2, 3]), ["0-3"]);
    try assertArguments(runner.positionArguments([4]), ["4"]);
    try assertArguments(runner.positionArguments([1, 2, 5, 7, 8, 9]), ["1-2", "5", "7-9"]);
    long[] none = [];
    try assertArguments(runner.positionArguments(none), []);
}

test "the runner uses nothing outside the language" {
    let rootFolder = try support.scratch("runner-clean");
    Path root = rootFolder.path();
    try support.writeFile(root, "alpha_test.ens", "test \"first\" \{ \}\n");
    let plan = discovery.plan(new SystemFileLoader(), root, "");
    string source = runner.source(plan.tests());
    try testing.assertTrue(source.indexOf("external") < 0,
        "the runner declares no external bindings: {source}");
}

test "a failure reports the message and stops the trace at the runner's own file" {
    let rootFolder = try support.scratch("runner-trace");
    Path root = rootFolder.path();
    try support.writeFile(root, "alpha_test.ens", "test \"first\" \{ \}\n");
    let plan = discovery.plan(new SystemFileLoader(), root, "");
    string source = runner.source(plan.tests());
    try assertContains(source, "catch (Error thrown) \{");
    try assertContains(source,
        "    string result = \"FAIL \" + \"first\" + \": \" + thrown.message;\n");
    try assertContains(source, "if (frame.file == \"$ens_test_runner.ens\") \{");
    try assertContains(source, "    $finished(0, result, false);\n");
}

test "the runner with no tests still compiles to a program that passes" {
    DiscoveredTest[] none = [];
    string source = runner.source(none);
    try assertContains(source, "main() -> int \{");
    try assertContains(source, "        for (long position = 0; position < 0; position++) \{\n");
}

test "the overlay covers the runner and passes everything else on" {
    FileLoader overlay = new RunnerOverlay(new StubLoader(), Path("/work/$ens_test_runner.ens"),
        "main() \{\}\n");
    try testing.assertTrue(overlay.exists(Path("/work/$ens_test_runner.ens")),
        "the runner is there");
    try testing.assertEqual(try overlay.readText(Path("/work/$ens_test_runner.ens")),
        "main() \{\}\n");
    try testing.assertTrue(overlay.exists(Path("/work/real.ens")),
        "the tree answers for its own files");
    try testing.assertEqual(try overlay.readText(Path("/work/real.ens")), "the tree's own text");
    try testing.assertFalse(overlay.exists(Path("/work/gone.ens")), "the tree has no such file");
    try testing.assertTrue(overlay.isFile(Path("/work/$ens_test_runner.ens")),
        "the runner is a file");
    try testing.assertTrue(overlay.isFile(Path("/work/real.ens")), "the tree's file is a file");
    try testing.assertFalse(overlay.isFile(Path("/work/gone.ens")), "the tree has no such file");
    Path[] under = try overlay.filesUnder(Path("/work"));
    try testing.assertEqual(under.length, 2L);
    try testing.assertEqual(under[0], Path("/work/real.ens"));
    try testing.assertEqual(under[1], Path("/work/$ens_test_runner.ens"));
    try testing.assertEqual((try overlay.filesUnder(Path("/elsewhere"))).length, 0L);
}

test "a runner ends as one that reported its results only with 0 or 1" {
    try testing.assertTrue(runner.endedWithResults(0), "every test passed");
    try testing.assertTrue(runner.endedWithResults(1), "some test failed");
    for (int code in [2, 3, 134, -1073741819]) {
        try testing.assertFalse(runner.endedWithResults(code), "code {code}");
    }
}

test "a stop after every result or between tests is reported as outside the tests" {
    let tests = try discovered("outcome-outside",
        "test \"first\" \{ \}\n\ntest \"second\" \{ \}\n");
    let done = outputOf(tests, ["start 0", "line 0 PASS first", "pass 0", "start 1",
        "line 1 PASS second", "pass 1"]);
    try testing.assertEqual(runner.stoppedOutsideTests(3, done, true), "the test program ended "
        + "with code 3 after all of its tests had reported a result, so the failure is outside "
        + "the tests");
    let between = outputOf(tests, ["start 0", "line 0 PASS first", "pass 0"]);
    try testing.assertEqual(runner.stoppedOutsideTests(1, between, false), "the test program "
        + "stopped with code 1 when no test was running, after 1 of 2 had reported a result, so "
        + "the failure is outside the tests");
}

// A test that ended its program alone fails with the last panic's message and the frames up to the
// runner's, and with the code when the program printed no panic.
test "a test that ended its program alone fails with its panic" {
    let tests = try discovered("outcome-panic", "test \"first\" \{ \}\n");
    string[] errors = ["a line of its own", "panic: boom", "  at helper (alpha_test.ens:4)",
        "  at \"first\" (alpha_test.ens:8, inlined)", "  at $run0 ($ens_test_runner.ens:48)",
        "  at lambda (tasks.ens:684)"];
    try assertArguments(runner.stoppedResult(tests[0], 134, errors), ["FAIL first: panic: boom",
        "  at helper (alpha_test.ens:4)", "  at \"first\" (alpha_test.ens:8, inlined)"]);
    try assertArguments(runner.ownErrors(errors), ["a line of its own"]);
    string[] silent = ["a line of its own"];
    try assertArguments(runner.stoppedResult(tests[0], 139, silent),
        ["FAIL first: the test ended the program with code 139"]);
    try assertArguments(runner.ownErrors(silent), ["a line of its own"]);
}

// A run that stopped knows which of its tests were running and which never started, and the one
// it stopped in takes the result it is given.
test "the output tells the tests a stop cut short from the ones it never reached" {
    let tests = try discovered("output-stop",
        "test \"first\" \{ \}\n\ntest \"second\" \{ \}\n\ntest \"third\" \{ \}\n");
    let output = outputOf(tests, ["start 1", "line 1 PASS second", "pass 1", "start 0"]);
    long[] every = [0, 1, 2];
    try assertPositions(output.unfinishedAmong(every), [0]);
    try assertPositions(output.unstartedAmong(every), [2]);
    try testing.assertFalse(output.finishedAll(every), "the first and third have no result");
    string[] shown = output.stopped(0, ["FAIL first: panic: boom", "  at \"first\" (a:1)"]);
    try assertArguments(shown, ["FAIL first: panic: boom", "  at \"first\" (a:1)", "PASS second"]);
    try testing.assertEqual(output.passed(), 1L);
    try testing.assertFalse(output.finishedAll(every), "the third has no result yet");
    try testing.assertTrue(output.finishedAll([0, 1]), "the first two have their results");
}

// Results come out in the order the tests were given, each as soon as every test before it has
// finished, while a test's own line is shown the moment it arrives.
test "the output shows results in order and a test's own lines at once" {
    let tests = try discovered("output-order",
        "test \"first\" \{ \}\n\ntest \"second\" \{ \}\n\ntest \"third\" \{ \}\n");
    let output = new RunnerOutput(tests);
    try assertShown(output, "$ens_test_runner start 0", []);
    try assertShown(output, "$ens_test_runner start 1", []);
    try assertShown(output, "$ens_test_runner line 1 FAIL second: expected '1', got '2'", []);
    try assertShown(output, "$ens_test_runner line 1   at \"second\" (alpha_test.ens:3)", []);
    try assertShown(output, "$ens_test_runner fail 1", []);
    try assertShown(output, "printed by a test", ["printed by a test"]);
    try assertShown(output, "$ens_test_runner start 2", []);
    try assertShown(output, "$ens_test_runner line 2 PASS third", []);
    try assertShown(output, "$ens_test_runner pass 2", []);
    try assertShown(output, "$ens_test_runner line 0 PASS first", []);
    try assertShown(output, "$ens_test_runner pass 0", ["PASS first",
        "FAIL second: expected '1', got '2'", "  at \"second\" (alpha_test.ens:3)", "PASS third"]);
    try testing.assertEqual(output.finished(), 3L);
    try testing.assertEqual(output.passed(), 2L);
    try testing.assertTrue(output.finishedAll([0, 1, 2]), "every test has its result");
}

// A test that finished after one before it that never did still has a result, shown once the
// runner has ended.
test "the results held behind an unfinished test are shown when the runner ends" {
    let tests = try discovered("output-held", "test \"first\" \{ \}\n\ntest \"second\" \{ \}\n");
    let output = new RunnerOutput(tests);
    try assertShown(output, "$ens_test_runner start 0", []);
    try assertShown(output, "$ens_test_runner start 1", []);
    try assertShown(output, "$ens_test_runner line 1 PASS second", []);
    try assertShown(output, "$ens_test_runner pass 1", []);
    string[] remaining = output.remaining();
    try testing.assertEqual(remaining.length, 1L);
    try testing.assertEqual(remaining[0], "PASS second");
    try assertPositions(output.unfinishedAmong([0, 1]), [0]);
}

// A line that starts like the runner's but names no test of the run is a test's own output.
test "a marked line naming no test of the run is shown as it is" {
    let tests = try discovered("output-foreign", "test \"only\" \{ \}\n");
    let output = new RunnerOutput(tests);
    try assertShown(output, "$ens_test_runner start 7", ["$ens_test_runner start 7"]);
    try assertShown(output, "$ens_test_runner start x", ["$ens_test_runner start x"]);
    try assertShown(output, "$ens_test_runner begin 0", ["$ens_test_runner begin 0"]);
    try assertShown(output, "$ens_test_runner", ["$ens_test_runner"]);
    try assertPositions(output.unfinishedAmong([0]), []);
}

test "the runner's file name is one no source file can have" {
    try testing.assertEqual(Runner.fileName, "$ens_test_runner.ens");
    try testing.assertEqual(Runner.modulePath, "$ens_test_runner");
}

// A file tree of two files, one of them missing, so the overlay's passing-on is observable.
class StubLoader implements FileLoader {
    protected constructor();

    protected override exists(Path path) -> bool {
        return path == Path("/work/real.ens");
    }

    protected override isFile(Path path) -> bool {
        return this.exists(path);
    }

    protected override filesUnder(Path folder) -> Path[] throws FileError {
        if (folder == Path("/work")) {
            return [Path("/work/real.ens")];
        }
        return [];
    }

    protected override folderKey(Path folder) -> string {
        return folder.normalize().toString();
    }

    protected override readText(Path path) -> string throws FileError {
        if (path == Path("/work/real.ens")) {
            return "the tree's own text";
        }
        throw new FileError("Could not read '{path}'.");
    }

    protected override readBytes(Path path) -> bytes throws FileError {
        return (try this.readText(path)).toBytes();
    }
}

// The tests one written file declares, discovered the way a run discovers them.
discovered(string label, string source) -> DiscoveredTest[] throws {
    let rootFolder = try support.scratch(label);
    Path root = rootFolder.path();
    try support.writeFile(root, "alpha_test.ens", source);
    let plan = discovery.plan(new SystemFileLoader(), root, "");
    return plan.tests();
}

// What a runner that wrote `events`, each after the marker, leaves the command knowing.
outputOf(DiscoveredTest[] tests, string[] events) -> RunnerOutput {
    let output = new RunnerOutput(tests);
    for (let event in events) {
        let shown = output.accept(Runner.marker + event);
    }
    return output;
}

assertShown(RunnerOutput output, string line, string[] expected) throws {
    string[] shown = output.accept(line);
    try testing.assertEqual(shown.length, expected.length);
    for (long i = 0; i < shown.length; i++) {
        try testing.assertEqual(shown[i], expected[i]);
    }
}

assertArguments(string[] actual, string[] expected) throws {
    try testing.assertEqual(actual.length, expected.length);
    for (long i = 0; i < actual.length; i++) {
        try testing.assertEqual(actual[i], expected[i]);
    }
}

assertPositions(long[] actual, long[] expected) throws {
    try testing.assertEqual(actual.length, expected.length);
    for (long i = 0; i < actual.length; i++) {
        try testing.assertEqual(actual[i], expected[i]);
    }
}

assertContains(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}

assertOnce(string text, string fragment) throws {
    try assertContains(text, fragment);
    long first = text.indexOf(fragment);
    string rest = text.substring(first + fragment.length, text.length);
    try testing.assertTrue(rest.indexOf(fragment) < 0, "'{fragment}' is written more than once");
}
