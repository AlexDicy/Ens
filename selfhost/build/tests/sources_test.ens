// The source scan: every '.ens' file under a folder, in path order, with the test files left out.
import @std.testing;
import sources;
import support;

test "the scan finds every source below the folder, in path order" {
    string root = try support.scratch("scan-tree");
    try support.writeFile(root, "main.ens", "main() \{\}\n");
    try support.writeFile(root, "alpha.ens", "export a() \{\}\n");
    try support.writeFile(root, "nested/beta.ens", "export b() \{\}\n");
    try support.writeFile(root, "nested/deeper/gamma.ens", "export g() \{\}\n");
    let found = sources.scan(root);
    try testing.assertEqual(found.failure(), "");
    string[] files = found.files();
    try testing.assertEqual(files.length, 4);
    try testing.assertEqual(files[0], "alpha.ens");
    try testing.assertEqual(files[1], "main.ens");
    try testing.assertEqual(files[2], "nested/beta.ens");
    try testing.assertEqual(files[3], "nested/deeper/gamma.ens");
    try support.removeTree(root);
}

test "test files and files that are not Ens source are left out" {
    string root = try support.scratch("scan-filtered");
    try support.writeFile(root, "main.ens", "main() \{\}\n");
    try support.writeFile(root, "main_test.ens", "test \"nothing\" \{ \}\n");
    try support.writeFile(root, "nested/deep_test.ens", "test \"nothing\" \{ \}\n");
    try support.writeFile(root, "notes.txt", "hello\n");
    let found = sources.scan(root);
    try testing.assertEqual(found.files().length, 1);
    try testing.assertEqual(found.files()[0], "main.ens");
    try support.removeTree(root);
}

test "an empty folder scans to nothing at all, which is not a failure" {
    string root = try support.scratch("scan-empty");
    let found = sources.scan(root);
    try testing.assertEqual(found.failure(), "");
    try testing.assertEqual(found.files().length, 0);
    try support.removeTree(root);
}

test "a folder that cannot be read reports the folder by name" {
    let found = sources.scan(".ens-build-tests/definitely-not-here");
    try testing.assertEqual(found.files().length, 0);
    try testing.assertTrue(found.failure().indexOf("definitely-not-here") >= 0,
        "the failure names the folder: {found.failure()}");
}

test "files already known are their own scan" {
    let found = sources.given(["hello.ens"]);
    try testing.assertEqual(found.failure(), "");
    try testing.assertEqual(found.files().length, 1);
    try testing.assertEqual(found.files()[0], "hello.ens");
}

test "the test scan finds every test file below the folder and nothing else" {
    string root = try support.scratch("scan-tests");
    try support.writeFile(root, "main.ens", "main() \{\}\n");
    try support.writeFile(root, "alpha_test.ens", "test \"a\" \{ \}\n");
    try support.writeFile(root, "nested/beta_test.ens", "test \"b\" \{ \}\n");
    try support.writeFile(root, "nested/helper.ens", "export h() \{\}\n");
    try support.writeFile(root, "notes.txt", "hello\n");
    let found = sources.scanTests(root);
    try testing.assertEqual(found.failure(), "");
    string[] files = found.files();
    try testing.assertEqual(files.length, 2);
    try testing.assertEqual(files[0], "alpha_test.ens");
    try testing.assertEqual(files[1], "nested/beta_test.ens");
    try support.removeTree(root);
}

test "a test file is recognized by its name alone" {
    try testing.assertTrue(sources.isTestFile("parse_test.ens"), "a test file");
    try testing.assertFalse(sources.isTestFile("parse.ens"), "not a test file");
    try testing.assertFalse(sources.isTestFile("test.ens"), "'test.ens' is ordinary source");
}
