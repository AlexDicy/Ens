// From manifests to link libraries: the graph's native declarations arrive deduplicated in name
// order, and the mapping picks out the bindings of the platform being built for.
import @std.testing;
import MemoryFileLoader from support;
import @ens.sema.program.graph;
import GraphResult from @ens.sema.program.graph;
import natives;

// A workspace of two members: the app depends on dep, both declare natives, and 'curl' is declared
// identically by both so it must arrive once.
loadedGraph() -> GraphResult {
    let loader = new MemoryFileLoader();
    addStandardLibrary(loader);
    loader.add("/work/ens.package", "workspace \{\n"
        + "    member \"app\";\n"
        + "    member \"dep\";\n"
        + "\}\n");
    loader.add("/work/app/ens.package", "package app \{\n"
        + "    ens \"0.1\";\n"
        + "    dependency dep;\n"
        + "    native curl;\n"
        + "\}\n");
    loader.add("/work/app/src/main.ens", "import @dep.util;\n\nmain() \{\n"
        + "    util.helper();\n\}\n");
    loader.add("/work/dep/ens.package", "package dep \{\n"
        + "    ens \"0.1\";\n"
        + "    native zlib \{\n"
        + "        windows \"zlibwin\";\n"
        + "        linux \"z\";\n"
        + "    \}\n"
        + "    native curl;\n"
        + "    native libc system;\n"
        + "\}\n");
    loader.add("/work/dep/src/util.ens", "export helper() \{\n\}\n");
    return graph.buildGraph(loader, "/work/app/src", "", "/stdlib", ["main.ens"]);
}

test "the graph collects each native once, in name order" {
    let result = loadedGraph();
    try testing.assertEqual(result.diagnostics().length, 0);
    let found = result.natives();
    try testing.assertEqual(found.length, 3);
    try testing.assertEqual(found[0].name(), "curl");
    try testing.assertEqual(found[1].name(), "libc");
    try testing.assertEqual(found[2].name(), "zlib");
}

test "each platform links the base names its own bindings give" {
    let found = loadedGraph().natives();
    let windows = natives.librariesFor(found, "windows");
    try testing.assertEqual(windows.failure(), "");
    try testing.assertEqual(windows.libraries().length, 2);
    try testing.assertEqual(windows.libraries()[0], "curl");
    try testing.assertEqual(windows.libraries()[1], "zlibwin");
    let linux = natives.librariesFor(found, "linux");
    try testing.assertEqual(linux.failure(), "");
    try testing.assertEqual(linux.libraries().length, 2);
    try testing.assertEqual(linux.libraries()[0], "curl");
    try testing.assertEqual(linux.libraries()[1], "z");
    let macos = natives.librariesFor(found, "macos");
    try testing.assertEqual(macos.failure(), "");
    try testing.assertEqual(macos.libraries().length, 1);
    try testing.assertEqual(macos.libraries()[0], "curl");
}

test "an artifact binding for the platform being built stops the mapping" {
    let loader = new MemoryFileLoader();
    addStandardLibrary(loader);
    loader.add("/work/ens.package", "package app \{\n"
        + "    ens \"0.1\";\n"
        + "    native blob \{\n"
        + "        windows artifact \"https://example.com/blob.lib\" hash \"sha256:"
        + "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\";\n"
        + "    \}\n"
        + "\}\n");
    loader.add("/work/src/main.ens", "main() \{\n\}\n");
    let result = graph.buildGraph(loader, "/work/src", "", "/stdlib", ["main.ens"]);
    try testing.assertEqual(result.diagnostics().length, 0);
    let windows = natives.librariesFor(result.natives(), "windows");
    try testing.assertTrue(windows.failure().contains("fetching artifacts is not supported yet"),
        "unexpected reason: '{windows.failure()}'");
    try testing.assertTrue(windows.failure().contains("blob"),
        "the reason names the library: '{windows.failure()}'");
    let linux = natives.librariesFor(result.natives(), "linux");
    try testing.assertEqual(linux.failure(), "");
    try testing.assertEqual(linux.libraries().length, 0);
}

addStandardLibrary(MemoryFileLoader loader) {
    loader.add("/stdlib/std/ens.package", "package std \{ ens \"0.1\"; \}\n");
    loader.add("/stdlib/std/src/core.ens", "export class Error \{\n"
        + "    export string message;\n"
        + "    export constructor(this.message);\n"
        + "\}\n");
}
