// Which targets link the system libraries ens carries, and what a link is told when they cannot be
// written.
import @std.testing;
import Path from @std.fs;
import Platform from @std.platform;
import TemporaryDirectory from @std.fs.temporary;
import ContentStore from @ens.packages.store;
import @ens.link.toolchain;
import systemlibraries;
import support;

test "an arm64 macOS link uses the libSystem ens carries, written into the cache" {
    let holder = try TemporaryDirectory.create("ens-build-system");
    let carried = systemlibraries.forTarget(toolchain.bareToolchain(),
        support.targetOf("arm64-apple-macosx11.0"), new ContentStore(holder.path()),
        Platform.MacOS);
    try testing.assertEqual(carried.failure(), "");
    let files = carried.toolchain().systemLibraries();
    try testing.assertEqual(files.length, 1L);
    try testing.assertTrue(Path(files[0]).isFile(), "'{files[0]}' was not written");
    try testing.assertTrue(files[0].endsWith("macos-arm64/libSystem.tbd"),
        "'{files[0]}' is not the link-only libSystem");
    try testing.assertTrue(carried.toolchain().macosSdk().version().length > 0,
        "the link names no SDK version");
}

test "a Linux link uses the libraries ens carries for its architecture" {
    let holder = try TemporaryDirectory.create("ens-build-system");
    let carried = systemlibraries.forTarget(toolchain.bareToolchain(),
        support.targetOf("x86_64-unknown-linux-gnu"), new ContentStore(holder.path()),
        Platform.MacOS);
    try testing.assertEqual(carried.failure(), "");
    let files = carried.toolchain().systemLibraries();
    try testing.assertEqual(files.length, 4L);
    try testing.assertTrue(files[0].endsWith("linux-x64/libc.so.6"),
        "'{files[0]}' is not the link-only C library");
    for (let file in files) {
        try testing.assertTrue(Path(file).isFile(), "'{file}' was not written");
    }
}

test "a target ens carries no system libraries for links against the machine's own" {
    for (let triple in ["x86_64-apple-macosx11.0", "x86_64-pc-windows-msvc"]) {
        let carried = systemlibraries.forTarget(toolchain.bareToolchain(),
            support.targetOf(triple), null, Platform.Linux);
        try testing.assertEqual(carried.failure(), "");
        try testing.assertEqual(carried.toolchain().systemLibraries().length, 0L);
    }
}

test "only a Linux program starts at an object of ens's, written into the link's folder" {
    let holder = try TemporaryDirectory.create("ens-build-system");
    for (let triple in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]) {
        let startup = systemlibraries.startupObjectFor(support.targetOf(triple), holder.path());
        try testing.assertEqual(startup.failure(), "");
        try testing.assertEqual(startup.path(), holder.path().join("ens.startup.o").toString());
        byte[] written = try Path(startup.path()).readBytes();
        try testing.assertEqual(try string.fromBytes(written.slice(1, 4)), "ELF");
    }
    for (let triple in ["arm64-apple-macosx11.0", "x86_64-pc-windows-msvc"]) {
        let startup = systemlibraries.startupObjectFor(support.targetOf(triple), holder.path());
        try testing.assertEqual(startup.path(), "");
    }
}

test "a link with no cache says which variables would name one" {
    let carried = systemlibraries.forTarget(toolchain.bareToolchain(),
        support.targetOf("arm64-apple-macosx11.0"), null, Platform.Windows);
    try testing.assertEqual(carried.failure(), "a macOS program is linked against lists of what "
        + "macOS's system libraries provide, which ens writes into its cache, and there is no "
        + "cache folder: neither 'ENS_CACHE' nor 'USERPROFILE' is set. Set 'ENS_CACHE' to a "
        + "folder that can be written to, or set 'USERPROFILE'");
    let linux = systemlibraries.forTarget(toolchain.bareToolchain(),
        support.targetOf("aarch64-unknown-linux-gnu"), null, Platform.Linux);
    try testing.assertEqual(linux.failure(), "a Linux program is linked against lists of what "
        + "Linux's system libraries provide, which ens writes into its cache, and there is no "
        + "cache folder: neither 'ENS_CACHE' nor 'HOME' is set. Set 'ENS_CACHE' to a folder "
        + "that can be written to, or set 'HOME'");
    try testing.assertEqual(systemlibraries.notWrittenMessage("Linux", "could not create the "
        + "directory '/cache/staging': something in the path is a file, not a directory"),
        "a Linux program is linked against lists of what Linux's system libraries provide, which "
            + "ens writes into its cache, and the lists could not be put there: could not create "
            + "the directory '/cache/staging': something in the path is a file, not a directory. "
            + "Set 'ENS_CACHE' to a folder that can be written to");
}
