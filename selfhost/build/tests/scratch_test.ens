// The folder a run builds in and then removes: where the system keeps work in progress, the name a
// run takes there, and the removal that leaves nothing behind.
import @std.testing;
import @std.system;
import @std.path;
import Environment from environment;
import scratch;
import support;

test "the environment names the folder work in progress goes in" {
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMP=C:\\Work\\Temp"])),
        "C:/Work/Temp");
    try testing.assertEqual(scratch.temporaryFolder(windows(["TEMP=C:\\Other"])), "C:/Other");
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMPDIR=C:\\Third"])), "C:/Third");
    try testing.assertEqual(scratch.temporaryFolder(linux(["TMPDIR=/var/tmp"])), "/var/tmp");
    try testing.assertEqual(scratch.temporaryFolder(linux(["TMP=/scratch"])), "/scratch");
}

test "TMP wins on Windows and TMPDIR everywhere else" {
    string[] all = ["TMP=/from-tmp", "TEMP=/from-temp", "TMPDIR=/from-tmpdir"];
    try testing.assertEqual(scratch.temporaryFolder(windows(all)), "/from-tmp");
    try testing.assertEqual(scratch.temporaryFolder(linux(all)), "/from-tmpdir");
}

test "a variable set to nothing is no answer at all" {
    try testing.assertEqual(scratch.temporaryFolder(windows(["TMP=", "TEMP=C:\\Fallback"])),
        "C:/Fallback");
}

test "an environment that says nothing falls back to what the system conventionally uses" {
    try testing.assertEqual(scratch.temporaryFolder(linux(["HOME=/home/ada"])), "/tmp");
    try testing.assertEqual(
        scratch.temporaryFolder(windows(["USERPROFILE=C:\\Users\\Ada"])),
        "C:/Users/Ada/AppData/Local/Temp");
}

test "a Windows environment that knows neither the temp folder nor the user has nowhere to build" {
    string[] nothing = [];
    try testing.assertEqual(scratch.temporaryFolder(windows(nothing)), "");
    let made = scratch.create(windows(nothing), "ens-run");
    try testing.assertEqual(made.folder(), "");
    try assertMentions(made.failure(), "TMP");
}

test "a run takes the first free name under the folder and creates it" {
    string root = try support.scratch("scratch-names");
    let environment = new Environment(["TMP=" + root], system.platform());

    let first = scratch.create(environment, "ens-run");
    try testing.assertEqual(first.failure(), "");
    try testing.assertEqual(first.folder(), path.join(root, "ens-run-1"));
    try testing.assertTrue(system.isDirectory(first.folder()), "the folder was created");

    let second = scratch.create(environment, "ens-run");
    try testing.assertEqual(second.folder(), path.join(root, "ens-run-2"));
    try testing.assertTrue(system.isDirectory(second.folder()), "the second folder was created");

    try testing.assertEqual(scratch.discard(first.folder()), "");
    try testing.assertFalse(system.isDirectory(first.folder()), "the first folder is gone");
    let third = scratch.create(environment, "ens-run");
    try testing.assertEqual(third.folder(), path.join(root, "ens-run-1"));

    try support.removeTree(root);
}

test "a folder is claimed by whoever asks first and by nobody after that" {
    string root = try support.scratch("scratch-claim");
    try testing.assertTrue(scratch.claimed(root), "the first claim takes the folder");
    try testing.assertFalse(scratch.claimed(root), "a folder already claimed cannot be claimed");
    try support.removeTree(root);
}

test "discarding removes everything under the folder and answers with nothing left to say" {
    string root = try support.scratch("scratch-discard");
    let environment = new Environment(["TMP=" + root], system.platform());
    let made = scratch.create(environment, "ens-run");
    try support.writeFile(made.folder(), "program.exe", "not really a program\n");
    try support.writeFile(made.folder(), "objects/one.obj", "not really an object\n");
    try support.writeFile(made.folder(), "objects/deeper/two.obj", "nor this\n");

    try testing.assertEqual(scratch.discard(made.folder()), "");
    try testing.assertFalse(system.exists(made.folder()), "the folder and its tree are gone");
    try testing.assertEqual(scratch.discard(made.folder()), "");
    try support.removeTree(root);
}

windows(string[] entries) -> Environment {
    return new Environment(entries, "windows");
}

linux(string[] entries) -> Environment {
    return new Environment(entries, "linux");
}

assertMentions(string text, string fragment) throws {
    try testing.assertTrue(text.indexOf(fragment) >= 0, "'{fragment}' is missing from: {text}");
}
