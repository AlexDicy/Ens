// The environment as a value: what a name is set to, and how the system it was read on decides
// whether two spellings of a name are the same variable.
import @std.testing;
import Environment from environment;

test "a variable's value is everything after the first '='" {
    let read = new Environment(["ENS_TOOLCHAIN=9.9", "PATH=/usr/bin"], "linux");
    try testing.assertEqual(read.value("ENS_TOOLCHAIN"), "9.9");
    try testing.assertEqual(read.value("PATH"), "/usr/bin");
}

test "a variable the environment does not set says nothing" {
    let read = new Environment(["HOME=/home/ada"], "linux");
    try testing.assertEqual(read.value("ENS_TOOLCHAIN"), "");
}

test "a variable set to nothing says nothing" {
    let read = new Environment(["ENS_TOOLCHAIN="], "linux");
    try testing.assertEqual(read.value("ENS_TOOLCHAIN"), "");
}

test "a value keeps every '=' of its own" {
    let read = new Environment(["ENS_FLAGS=a=1;b=2"], "linux");
    try testing.assertEqual(read.value("ENS_FLAGS"), "a=1;b=2");
}

test "an entry that sets nothing at all is passed over" {
    let read = new Environment(["broken", "HOME=/home/ada"], "linux");
    try testing.assertEqual(read.value("broken"), "");
    try testing.assertEqual(read.value("HOME"), "/home/ada");
}

test "Windows matches a name however it is spelled" {
    let read = new Environment(["ens_toolchain=9.9", "UserProfile=C:/Users/Ada"], "windows");
    try testing.assertEqual(read.value("ENS_TOOLCHAIN"), "9.9");
    try testing.assertEqual(read.value("USERPROFILE"), "C:/Users/Ada");
}

test "every other system tells two spellings apart" {
    let read = new Environment(["home=/home/ada", "HOME=/home/grace"], "linux");
    try testing.assertEqual(read.value("HOME"), "/home/grace");
    try testing.assertEqual(read.value("home"), "/home/ada");
}

test "the system the environment was read on travels with it" {
    try testing.assertEqual(new Environment(["A=1"], "macos").platform(), "macos");
}
