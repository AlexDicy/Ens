// Checking a target: everything a build does up to code generation, and nothing after it. A check
// writes nothing anywhere, so it is the fast way to ask whether a program is sound.
//
// Every member of a workspace is checked, even after one of them has problems, because a check is
// asked in order to see the problems - stopping at the first member would hide the rest.
import @std.path;
import FileLoader from @ens.sema.support.loader;
import BuildOptions from options;
import BuildTarget from target;
import TargetKind from target;
import WorkspaceMember from target;
import target;
import Reporter from report;
import report;
import Unit from program;
import program;

// Checks the target and answers with the exit code: 0 nothing to report, 1 problems were found.
export run(FileLoader loader, BuildOptions options, BuildTarget resolved,
           Reporter reporter) -> int {
    if (resolved.kind() == TargetKind.Workspace) {
        return runWorkspace(loader, options, resolved, reporter);
    }
    let unit = new Unit(resolved.sourceFolder(), resolved.entryFile(), resolved.artifactName());
    return checkUnit(loader, options, unit, reporter, 1, 1);
}

runWorkspace(FileLoader loader, BuildOptions options, BuildTarget resolved,
             Reporter reporter) -> int {
    WorkspaceMember[] members = target.memberOrder(resolved.members()).members();
    if (members.length == 0) {
        reporter.note("this workspace lists no members, so there is nothing to check");
        return 0;
    }
    int worst = 0;
    for (long i = 0; i < members.length; i++) {
        let member = members[i];
        let unit = new Unit(path.join(member.folder(), "src"), "", member.packageName());
        int code = checkUnit(loader, options, unit, reporter, i + 1, members.length);
        if (code > worst) {
            worst = code;
        }
    }
    return worst;
}

checkUnit(FileLoader loader, BuildOptions options, Unit unit, Reporter reporter, long index,
          long total) -> int {
    string label = report.progress(index, total, unit.label());
    reporter.step("{label}: reading {unit.sourceFolder()}");
    let loaded = program.load(loader, options, unit);
    if (!loaded.succeeded()) {
        reporter.problems(loaded.problems());
        reporter.problem("{label}: " + report.problemCount(loaded.problems().length));
        return 1;
    }
    reporter.note("{label}: {loaded.moduleCount()} module(s), nothing to report");
    return 0;
}
