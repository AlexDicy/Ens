// Fetching the release list from the source 'ENS_RELEASES' names, with curl.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Environment from @std.environment;
import Json from @std.json;
import JsonError from @std.json;
import List from @std.collections.list;
import Set from @std.collections.set;
import @ens.packages.tools;
import @std.text.parse;
import Progress from @ens.packages.progress;
import Release from releases;
import releases;

export final class ReleaseSource {
    string listUrl;
    string bearer;
    string problem;

    protected constructor(this.listUrl, this.bearer, this.problem);

    export url() -> string {
        return this.listUrl;
    }

    // Empty when no token is sent to this source.
    export token() -> string {
        return this.bearer;
    }

    export failure() -> string {
        return this.problem;
    }
}

export final class ReleaseList {
    Release[] found;
    string problem;

    protected constructor(this.found, this.problem);

    export releases() -> Release[] {
        return this.found;
    }

    export failure() -> string {
        return this.problem;
    }
}

final class Releases {
    protected static const string defaultList = "https://api.github.com/repos/AlexDicy/Ens/releases";
    protected static const string github = "https://api.github.com/";
    protected static const long pageSize = 100;
}

// 'GITHUB_TOKEN' is sent only to 'https://api.github.com', unless 'ENS_RELEASES_TOKEN' is 'always'.
export sourceFor(Environment environment) -> ReleaseSource {
    string url = environment.get("ENS_RELEASES") ?? "";
    if (url.length == 0) {
        url = Releases.defaultList;
    }
    string setting = environment.get("ENS_RELEASES_TOKEN") ?? "";
    if (setting.length > 0 && setting != "github" && setting != "always") {
        return new ReleaseSource(url, "", "'ENS_RELEASES_TOKEN' is set to '{setting}', which is "
            + "not recognized. Set it to 'always' to send 'GITHUB_TOKEN' to the release source "
            + "'ENS_RELEASES' names, or remove it to send the token only to "
            + "'https://api.github.com'");
    }
    string token = environment.get("GITHUB_TOKEN") ?? "";
    if (setting != "always" && !url.startsWith(Releases.github)) {
        token = "";
    }
    return new ReleaseSource(url, token, "");
}

// `staging` is a folder of this run's own. The headers go to curl through a file there, so the token
// is never on a command line. Paging stops at a short page or at a page that adds no tag, which is
// how a 'file://' source, which ignores the query, ends.
export fetch(ReleaseSource source, Path staging, Progress progress) -> ReleaseList {
    progress.step("Listing the releases at '{source.url()}'");
    Path headers = staging.join("headers");
    try headers.writeText(headerLines(source.token()));
    let found = new List<Release>();
    let seen = new Set<string>();
    long page = 1;
    while (true) {
        Path body = staging.join("page-{page}.json");
        let run = tools.read("curl", listArguments(pageUrl(source.url(), page), headers, body),
            noOverrides());
        if (!run.started()) {
            return failed("listing the releases of Ens needs 'curl', which could not be started. "
                + "Install curl and add its folder to 'PATH'");
        }
        if (!run.succeeded()) {
            return failed("the release list at '{source.url()}' could not be downloaded: "
                + complaintOf(run.lines(), run.report()));
        }
        string text = try body.readText();
        string status = run.said();
        if (status != "200" && status != "000") {
            return failed(statusProblem(source, status, text));
        }
        let read = releases.readPage(text, source.url());
        if (read.failure().length > 0) {
            return failed(read.failure());
        }
        bool added = false;
        for (let release in read.releases()) {
            if (seen.add(release.tag())) {
                found.push(release);
                added = true;
            }
        }
        if (read.entries() < Releases.pageSize || !added) {
            return new ReleaseList(found.toArray(), "");
        }
        page = page + 1;
    }
} catch (FileSystemError stopped) {
    return failed("the release list at '{source.url()}' could not be read: {stopped.message}");
}

export statusProblem(ReleaseSource source, string status, string body) -> string {
    string message = serverMessage(body);
    string said = "";
    if (message.length > 0) {
        said = " and the message '{message}'";
    }
    string problem = "the release list at '{source.url()}' could not be downloaded: the server "
        + "answered with status {status}{said}";
    if ((status == "403" || status == "429") && message.toLowerAscii().contains("rate limit")
            && source.token().length == 0) {
        return problem + ". Set 'GITHUB_TOKEN' to a GitHub token to raise the limit";
    }
    return problem;
}

export pageUrl(string url, long page) -> string {
    string joiner = "?";
    if (url.contains("?")) {
        joiner = "&";
    }
    return "{url}{joiner}per_page={Releases.pageSize}&page={page}";
}

export headerLines(string token) -> string {
    string lines = "Accept: application/vnd.github+json\nX-GitHub-Api-Version: 2022-11-28\n";
    if (token.length > 0) {
        return lines + "Authorization: Bearer {token}\n";
    }
    return lines;
}

// '%\{http_code}' is printed on a line of its own after everything else, and is '000' for a
// source that is not HTTP.
listArguments(string url, Path headers, Path body) -> string[] {
    return ["--location", "--silent", "--show-error", "--connect-timeout", "30", "--max-time",
        "120", "--header", "@{headers}", "--output", body.toString(), "--write-out",
        "\n%\{http_code}\n", "--url", url];
}

// The last line curl wrote that is not the status code it ends with, or `otherwise`.
export complaintOf(string[] lines, string otherwise) -> string {
    for (long i = lines.length - 1; i >= 0; i--) {
        string line = lines[i].trim();
        if (line.length > 0 && !isStatus(line)) {
            return line;
        }
    }
    return otherwise;
}

isStatus(string line) -> bool {
    return line.length == 3 && parse.parseInt(line) != null;
}

// The 'message' field GitHub puts in an error response, or empty.
serverMessage(string body) -> string {
    let parsed = try Json.parse(body);
    let fields = parsed.asObject();
    if (fields == null) {
        return "";
    }
    Json? message = fields.get("message");
    if (message == null) {
        return "";
    }
    return message.asString() ?? "";
} catch (JsonError unreadable) {
    return "";
}

failed(string problem) -> ReleaseList {
    Release[] none = [];
    return new ReleaseList(none, problem);
}

noOverrides() -> string[] {
    string[] none = [];
    return none;
}
