// The source files a folder holds: every '.ens' file under it, in one deterministic order, with the
// '*_test.ens' files left out because those hold test declarations and belong to a test run rather
// than to a build.
//
// A scan is a pure function of the tree it reads. It answers with the files it found or with the
// folder it could not read, so a caller never has to guess whether an empty answer means an empty
// folder or an unreadable one.
import @std.system;
import SystemError from @std.system;
import @std.path;
import @std.collections.sorting;
import List from @std.collections.list;

export final class SourceScan {
    string[] found;
    string problem;

    protected constructor(this.found, this.problem);

    // The files, relative to the scanned folder and written with forward slashes, in path order.
    export files() -> string[] {
        return this.found;
    }

    // What stopped the scan, or empty text when it read every folder it reached.
    export failure() -> string {
        return this.problem;
    }
}

// The scan of a target that names one file outright, which needs no walk at all.
export oneFile(string fileName) -> SourceScan {
    return new SourceScan([fileName], "");
}

export scan(string folder) -> SourceScan {
    let found = new List<string>();
    string problem = walk(folder, "", found);
    if (problem.length > 0) {
        string[] none = [];
        return new SourceScan(none, problem);
    }
    sorting.sort(found);
    return new SourceScan(found.toArray(), "");
}

// Whether a file holds test declarations rather than program sources.
export isTestFile(string fileName) -> bool {
    return fileName.endsWith("_test.ens");
}

walk(string folder, string prefix, List<string> found) -> string {
    for (let entry in try system.listDirectory(folder)) {
        string child = path.join(folder, entry);
        if (system.isDirectory(child)) {
            string problem = walk(child, prefix + entry + "/", found);
            if (problem.length > 0) {
                return problem;
            }
            continue;
        }
        if (entry.endsWith(".ens") && !isTestFile(entry)) {
            found.push(prefix + entry);
        }
    }
    return "";
} catch (SystemError error) {
    return "could not read the folder '{folder}': {error.message}";
}
