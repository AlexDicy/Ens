// The source files a folder holds, in one deterministic order: either every '.ens' file that is not
// a test file, or every '*_test.ens' file. The two are disjoint, so nothing is compiled by both,
// and a scan returns the files it found or the folder it could not read.
import Path from @std.fs;
import EntryKind from @std.fs.metadata;
import FileSystemError from @std.fs.error;
import List from @std.collections.list;

export final class SourceScan {
    string[] found;
    string problem;

    protected constructor(this.found, this.problem);

    // The files, relative to the scanned folder and written with forward slashes, in path order.
    export files() -> string[] {
        return this.found;
    }

    // What stopped the scan, or empty text when it read every folder it reached.
    export failure() -> string {
        return this.problem;
    }
}

// The scan of files a caller already has, which needs no walk at all.
export given(string[] files) -> SourceScan {
    return new SourceScan(files, "");
}

// Every source file a build of the folder compiles.
export scan(Path folder) -> SourceScan {
    return walked(folder, false);
}

// Every file under the folder that holds test declarations.
export scanTests(Path folder) -> SourceScan {
    return walked(folder, true);
}

// Whether a file holds test declarations rather than program sources.
export isTestFile(string fileName) -> bool {
    return fileName.endsWith("_test.ens");
}

// The walk follows symbolic links, because sources reached through one are sources of the program
// being built, and a folder reached that way would otherwise be left out of the build. The failure
// the walk raises already names the folder it could not read, so it is reported as it stands.
walked(Path folder, bool testsOnly) -> SourceScan {
    let found = new List<string>();
    for (let child in try folder.walk(followLinks: true)) {
        if (child.kind == EntryKind.Directory
                || (child.kind == EntryKind.Symlink && child.path.isDirectory())) {
            continue;
        }
        if (child.name.endsWith(".ens") && isTestFile(child.name) == testsOnly) {
            Path? relative = child.path.relativeTo(folder);
            if (relative == null) {
                panic("Internal: the walk under '{folder}' returned '{child.path}' from outside it");
            }
            found.push(relative.toString());
        }
    }
    found.sort();
    return new SourceScan(found.toArray(), "");
} catch (FileSystemError refused) {
    string[] none = [];
    return new SourceScan(none, refused.message);
}
