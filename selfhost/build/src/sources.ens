// The source files a folder holds, in one deterministic order: either every '.ens' file that is not
// a test file, or every '*_test.ens' file. The two are disjoint, so nothing is compiled by both,
// and a scan answers with the files it found or with the folder it could not read.
import @std.system;
import SystemError from @std.system;
import @std.path;
import List from @std.collections.list;

export final class SourceScan {
    string[] found;
    string problem;

    protected constructor(this.found, this.problem);

    // The files, relative to the scanned folder and written with forward slashes, in path order.
    export files() -> string[] {
        return this.found;
    }

    // What stopped the scan, or empty text when it read every folder it reached.
    export failure() -> string {
        return this.problem;
    }
}

// The scan of files a caller already knows, which needs no walk at all.
export given(string[] files) -> SourceScan {
    return new SourceScan(files, "");
}

// Every source file a build of the folder compiles.
export scan(string folder) -> SourceScan {
    return walked(folder, false);
}

// Every file under the folder that holds test declarations.
export scanTests(string folder) -> SourceScan {
    return walked(folder, true);
}

// Whether a file holds test declarations rather than program sources.
export isTestFile(string fileName) -> bool {
    return fileName.endsWith("_test.ens");
}

walked(string folder, bool wantTests) -> SourceScan {
    let found = new List<string>();
    string problem = walk(folder, "", wantTests, found);
    if (problem.length > 0) {
        string[] none = [];
        return new SourceScan(none, problem);
    }
    found.sort((a, b) -> a.compareTo(b));
    return new SourceScan(found.toArray(), "");
}

walk(string folder, string prefix, bool wantTests, List<string> found) -> string {
    for (let entry in try system.listDirectory(folder)) {
        string child = path.join(folder, entry);
        if (system.isDirectory(child)) {
            string problem = walk(child, prefix + entry + "/", wantTests, found);
            if (problem.length > 0) {
                return problem;
            }
            continue;
        }
        if (entry.endsWith(".ens") && isTestFile(entry) == wantTests) {
            found.push(prefix + entry);
        }
    }
    return "";
} catch (SystemError error) {
    return "could not read the folder '{folder}': {error.message}";
}
