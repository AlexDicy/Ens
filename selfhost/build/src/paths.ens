// Path text as the rest of a build reads it. Windows accepts either separator, so a path a user
// typed - or a script assembled - may hold backslashes; every path that enters a build comes through
// here and leaves with one convention, so nothing downstream has to ask which one it was given.
import @std.path;
import StringBuilder from @std.text.stringbuilder;

// The same path with every backslash turned forward.
export slashed(string given) -> string {
    if (given.indexOf("\\") < 0) {
        return given;
    }
    let out = new StringBuilder();
    byte[] raw = given.toBytes();
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] == '\\') {
            out.append("/");
        } else {
            out.appendByte(raw[i]);
        }
    }
    return out.toString();
}

// A path as it reads from the folder a command was run in: one separator convention, absolute, and
// normalized.
export resolved(string given, string workingFolder) -> string {
    return path.absolute(slashed(given), workingFolder);
}
