// Loading and analyzing one unit of work. A build and a check need exactly the same thing up to
// this point - the module graph, then every sema stage over it - and differ only in what they do
// afterwards, so both come through here.
//
// Loading is a function of its inputs and answers with a value: the graph, the analysis when the
// graph was sound enough to reach it, and the problems as lines already formatted for a reader.
// Nothing is written anywhere, so two units could be loaded at the same time without either seeing
// the other.
import @std.path;
import List from @std.collections.list;
import Source from @ens.frontend.support.source;
import GreenNode from @ens.frontend.syntax.green;
import @ens.frontend.parse.parser;
import @ens.frontend.syntax.generated.factory;
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FileDiagnostic from @ens.sema.support.diagnostics;
import FileError from @ens.sema.support.loader;
import FileLoader from @ens.sema.support.loader;
import GraphResult from @ens.sema.program.graph;
import NativeInfo from @ens.sema.program.workspace;
import @ens.sema.program.graph;
import ProgramAnalysis from @ens.sema.pipeline;
import @ens.sema.pipeline;
import BuildOptions from options;
import BuildTarget from target;
import WorkspaceMember from target;
import SourceCatalog from diagnostics;
import diagnostics;
import SourceScan from sources;
import sources;

// One thing to compile: where its modules are read from, which files the graph starts from, and how
// a report names it.
export final class Unit {
    string unitSource;
    string unitTests;
    string unitEntry;
    string[] unitSeeds;
    string unitEntryModule;
    string unitLabel;

    protected constructor(this.unitSource, this.unitTests, this.unitEntry, this.unitSeeds,
                this.unitEntryModule, this.unitLabel);

    export sourceFolder() -> string {
        return this.unitSource;
    }

    // The folder the seeds are named relative to when it is not the source folder, which is how a
    // test run reaches tests kept outside the sources; empty text otherwise.
    export testsFolder() -> string {
        return this.unitTests;
    }

    // The one file that is the program's main module, or empty text when the unit has no single
    // main module.
    export entryFile() -> string {
        return this.unitEntry;
    }

    // The files the graph starts from, or empty when they are whatever the source folder holds.
    export seeds() -> string[] {
        return this.unitSeeds;
    }

    // The module whose main() would be the program's entry point, which is the main module for
    // anything a build compiles and the synthesized runner for a test run.
    export entryModule() -> string {
        return this.unitEntryModule;
    }

    // How a report names this unit: a package name, or the file or folder that was named.
    export label() -> string {
        return this.unitLabel;
    }
}

// A folder of sources: every source file under it is a seed, so a module nothing imports is
// compiled too.
export folderUnit(string sourceFolder, string label) -> Unit {
    string[] scanned = [];
    return new Unit(sourceFolder, "", "", scanned, "main", label);
}

// One file, which is the program's main module whatever it is called.
export fileUnit(string sourceFolder, string entryFile, string label) -> Unit {
    string[] scanned = [];
    return new Unit(sourceFolder, "", entryFile, scanned, "main", label);
}

// A unit whose seeds are named outright, relative to `testsFolder` when it names one and to
// `sourceFolder` otherwise, and whose entry point is one of them by name.
export seededUnit(string sourceFolder, string testsFolder, string[] seeds, string entryModule,
                  string label) -> Unit {
    return new Unit(sourceFolder, testsFolder, "", seeds, entryModule, label);
}

// What compiling the resolved target compiles: the one file it named, or the folder it named.
export unitOf(BuildTarget resolved) -> Unit {
    if (resolved.entryFile().length > 0) {
        return fileUnit(resolved.sourceFolder(), resolved.entryFile(), resolved.artifactName());
    }
    return folderUnit(resolved.sourceFolder(), resolved.artifactName());
}

// What compiling one member of a workspace compiles.
export memberUnit(WorkspaceMember member) -> Unit {
    return folderUnit(path.join(member.folder(), "src"), member.packageName());
}

// One unit loaded and analyzed.
export final class Loaded {
    ProgramAnalysis? programAnalysis;
    string[] problemLines;
    long modules;
    string[] entryPoints;
    string wantedEntry;
    NativeInfo[] declaredNatives;
    SourceCatalog sources;

    protected constructor(this.programAnalysis, this.problemLines, this.modules, this.entryPoints,
                this.wantedEntry, this.declaredNatives, this.sources);

    // The analysis, or null when the program did not survive to it.
    export analysis() -> ProgramAnalysis? {
        return this.programAnalysis;
    }

    export problems() -> string[] {
        return this.problemLines;
    }

    export succeeded() -> bool {
        return this.programAnalysis != null;
    }

    export moduleCount() -> long {
        return this.modules;
    }

    // Whether the module this program's entry point would come from defines main(), which is what
    // makes it an application rather than a library.
    export definesEntry() -> bool {
        for (let modulePath in this.entryPoints) {
            if (modulePath == this.wantedEntry) {
                return true;
            }
        }
        return false;
    }

    // Every module of the program that defines main(), which a program that reaches an executable
    // has exactly one of.
    export entryModules() -> string[] {
        return this.entryPoints;
    }

    // The module this program's entry point would come from.
    export entryModule() -> string {
        return this.wantedEntry;
    }

    // The native libraries the manifests governing these modules declare.
    export natives() -> NativeInfo[] {
        return this.declaredNatives;
    }

    // The sources this load read, so a problem found after it - in code generation - is reported at
    // its own line and column too.
    export catalog() -> SourceCatalog {
        return this.sources;
    }
}

// Loads the unit's modules and runs every sema stage over them. A problem at any stage stops the
// load there, so a program that never parsed is not reported as if it failed to type-check.
export load(FileLoader loader, BuildOptions options, Unit unit) -> Loaded {
    let catalog = new SourceCatalog(loader);
    let seeds = seedsOf(unit);
    if (seeds.failure().length > 0) {
        return failed(unit, [seeds.failure()], 0, catalog);
    }
    if (seeds.files().length == 0) {
        return failed(unit, ["no Ens source files were found in '{unit.sourceFolder()}'"], 0,
            catalog);
    }

    GraphResult graphResult;
    if (unit.entryFile().length > 0) {
        graphResult = graph.buildFileProgram(loader, unit.sourceFolder(), unit.testsFolder(),
            options.stdlibRoot(), unit.entryFile());
    } else {
        graphResult = graph.buildGraph(loader, unit.sourceFolder(), unit.testsFolder(),
            options.stdlibRoot(), seeds.files());
    }
    catalog.addGraph(graphResult);
    long moduleCount = graphResult.modules().length;

    let upstream = upstreamDiagnostics(graphResult);
    if (upstream.length() > 0) {
        return failed(unit, diagnostics.formatAll(upstream, catalog), moduleCount, catalog);
    }
    let analysis = pipeline.analyzeProgram(graphResult);
    let problems = analysisDiagnostics(analysis);
    if (problems.length() > 0) {
        return failed(unit, diagnostics.formatAll(problems, catalog), moduleCount, catalog);
    }
    string[] clean = [];
    return new Loaded(analysis, clean, moduleCount, entryModules(graphResult), unit.entryModule(),
        graphResult.natives(), catalog);
}

// The files the graph starts from: the ones the unit named, the one file that is its main module, or
// every non-test source under its folder so a module nothing imports is compiled too.
seedsOf(Unit unit) -> SourceScan {
    if (unit.seeds().length > 0) {
        return sources.given(unit.seeds());
    }
    if (unit.entryFile().length > 0) {
        return sources.given([unit.entryFile()]);
    }
    return sources.scan(unit.sourceFolder());
}

failed(Unit unit, string[] problems, long moduleCount, SourceCatalog catalog) -> Loaded {
    NativeInfo[] none = [];
    string[] noEntry = [];
    return new Loaded(null, problems, moduleCount, noEntry, unit.entryModule(), none, catalog);
}

// Graph and parse diagnostics together, since both mean the program never reached analysis.
upstreamDiagnostics(GraphResult graphResult) -> List<FileDiagnostic> {
    let collected = new List<FileDiagnostic>();
    for (let diagnostic in graphResult.diagnostics()) {
        collected.push(diagnostic);
    }
    for (let loaded in graphResult.modules()) {
        for (let diagnostic in loaded.parseResult().diagnostics()) {
            collected.push(new FileDiagnostic(loaded.filePath(), diagnostic.message(),
                diagnostic.span()));
        }
    }
    return collected;
}

// Every stage's diagnostics in stage order; the formatting orders the merged list by position.
analysisDiagnostics(ProgramAnalysis analysis) -> List<FileDiagnostic> {
    let collected = new List<FileDiagnostic>();
    appendAll(collected, analysis.declareDiagnostics());
    appendAll(collected, analysis.linkDiagnostics());
    appendAll(collected, analysis.signatureDiagnostics());
    appendAll(collected, analysis.layoutDiagnostics());
    appendAll(collected, analysis.checkDiagnostics());
    appendAll(collected, analysis.bodyDiagnostics());
    appendAll(collected, analysis.exceptionDiagnostics());
    return collected;
}

appendAll(List<FileDiagnostic> sink, FileDiagnostic[] diagnostics) {
    for (let diagnostic in diagnostics) {
        sink.push(diagnostic);
    }
}

// Every module of the graph that declares a function named 'main'. Their shape is sema's business
// by the time this is asked; all that matters here is where an executable's entry point could come
// from, so a program with more than one can be told about it rather than left to the linker.
entryModules(GraphResult graphResult) -> string[] {
    let found = new List<string>();
    for (let loaded in graphResult.modules()) {
        if (declaresMain(loaded.parseResult().root())) {
            found.push(loaded.canonicalPath());
        }
    }
    return found.toArray();
}

// Whether the parsed file declares a function named 'main'.
declaresMain(GreenNode parsed) -> bool {
    let root = factory.createRoot(parsed);
    if (!(root is SourceFileNode)) {
        return false;
    }
    for (long i = 0; i < root.itemsCount(); i++) {
        let item = root.items(i);
        if (item is FunctionDeclarationNode) {
            let name = item.name();
            if (name != null && name.text() == "main") {
                return true;
            }
        }
    }
    return false;
}

// Whether the named file declares main(), which is what makes the program it is the main module of
// an application rather than a library. Asked of a file before anything is compiled, so a command
// that only runs applications can say so before it builds.
export definesEntryFile(FileLoader loader, string file) -> bool {
    return declaresMain(parser.parse(new Source(file, try loader.readText(file))).root());
} catch (FileError error) {
    return false;
}
