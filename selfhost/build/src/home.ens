// Where Ens keeps what belongs to the user running it. The toolchains a version hop reaches for and
// the packages a build downloads sit side by side under one folder, so both are found the same way
// and neither has to know how the other is laid out.
import @std.path;
import Environment from environment;

// The folder the system says belongs to the user, or empty text when it says nothing. Windows names
// it USERPROFILE and every other system names it HOME, so the answer follows the environment the
// snapshot was read on rather than the one this toolchain was built for.
export userFolder(Environment environment) -> string {
    string named = environment.value(userFolderVariable(environment.platform()));
    if (named.length == 0) {
        return "";
    }
    return path.normalize(path.fromNative(named, environment.platform()));
}

// The folder Ens keeps `name` in for this user, or empty text when the user's own folder is unknown.
export ensFolder(Environment environment, string name) -> string {
    string user = userFolder(environment);
    if (user.length == 0) {
        return "";
    }
    return path.join(path.join(user, ".ens"), name);
}

userFolderVariable(string platform) -> string {
    if (platform == "windows") {
        return "USERPROFILE";
    }
    return "HOME";
}
