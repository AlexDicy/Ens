// Building a target: one unit at a time, each loaded, analyzed, emitted into object files and
// linked. A unit whose main module defines main() produces a program, and one that does not is a
// library compiled just as thoroughly. Building a unit is a function of its inputs alone.
import @std.system;
import SystemError from @std.system;
import @std.path;
import List from @std.collections.list;
import FileDiagnostic from @ens.sema.support.diagnostics;
import FileLoader from @ens.sema.support.loader;
import ProgramAnalysis from @ens.sema.pipeline;
import @ens.host.scratch;
import @ens.codegen.driver;
import @ens.codegen.settings;
import LinkRequest from @ens.link.request;
import Toolchain from @ens.link.toolchain;
import @ens.link.toolchain;
import @ens.link.discovery;
import @ens.link.flavor;
import @ens.link.linker;
import BuildOptions from options;
import Packaging from packaging;
import BuildTarget from target;
import TargetKind from target;
import WorkspaceMember from target;
import target;
import Reporter from report;
import report;
import diagnostics;
import Loaded from program;
import Unit from program;
import program;
import natives;
import prebuilt;
import platform;

export enum BuildOutcome {
    BuiltExecutable,
    ValidatedLibrary,
    Failed,
}

// What building one unit came to.
export final class UnitReport {
    BuildOutcome result;
    string producedArtifact;
    string[] problemLines;
    long modules;
    long objects;
    string[] account;
    string[] noticeLines;

    protected constructor(this.result, this.producedArtifact, this.problemLines, this.modules,
                this.objects, this.account, this.noticeLines);

    export outcome() -> BuildOutcome {
        return this.result;
    }

    // The executable that was written, or empty text when the unit produced none.
    export artifact() -> string {
        return this.producedArtifact;
    }

    export problems() -> string[] {
        return this.problemLines;
    }

    export moduleCount() -> long {
        return this.modules;
    }

    export objectCount() -> long {
        return this.objects;
    }

    // What the optimization pipeline elided, when the build asked to be told.
    export explanation() -> string[] {
        return this.account;
    }

    // What building this unit did that whoever ran the build should know about.
    export notices() -> string[] {
        return this.noticeLines;
    }
}

// Builds the target and answers with the exit code: 0 built, 1 the work failed, 2 the command line
// asked for something it cannot have.
export run(FileLoader loader, BuildOptions options, Packaging packaging, BuildTarget resolved,
           Reporter reporter) -> int {
    if (resolved.kind() == TargetKind.Workspace) {
        return runWorkspace(loader, options, packaging, resolved, reporter);
    }
    reporter.step("building for {options.targetTriple()}");
    return runUnit(loader, options, packaging, program.unitOf(resolved), resolved.artifactName(),
        options.output(), discoverToolchain(options), reporter, 1, 1, "");
}

// Builds every member of a workspace, each one after the members it depends on.
runWorkspace(FileLoader loader, BuildOptions options, Packaging packaging, BuildTarget resolved,
             Reporter reporter) -> int {
    if (options.namesOutput()) {
        reporter.problem("'--output' names one executable, and a workspace root builds every one "
            + "of its members; name the member folder to build one, or drop '--output' and let "
            + "each member be named after its own package");
        return 2;
    }
    let order = target.memberOrder(resolved.members());
    if (order.cycle().length > 0) {
        reporter.problem("these workspace members depend on each other in a circle, so no order "
            + "builds each one after what it needs: " + report.quotedNames(order.cycle())
            + "; remove one of the dependencies");
        return 1;
    }
    WorkspaceMember[] members = order.members();
    if (members.length == 0) {
        reporter.note("this workspace lists no members, so there is nothing to build");
        return 0;
    }
    reporter.step("building {members.length} member(s) for {options.targetTriple()}");
    let toolchain = discoverToolchain(options);
    // A member's program is named after its package, and a workspace's member folder is
    // conventionally named after the program it holds, so the two names are the same one. Keeping a
    // member's artifact where its objects are is what stops a build writing an executable over the
    // folder it just read the sources from.
    string artifacts = objectsFolderFor(options);
    for (long i = 0; i < members.length; i++) {
        let member = members[i];
        int code = runUnit(loader, options, packaging,
            program.memberUnit(member, resolved.root()),
            target.artifactStem(member.packageName()), "", toolchain, reporter, i + 1,
            members.length, artifacts);
        if (code != 0) {
            return code;
        }
    }
    return 0;
}

// Builds one unit and reports it, answering with the exit code its outcome deserves.
runUnit(FileLoader loader, BuildOptions options, Packaging packaging, Unit unit,
        string artifactStem, string namedOutput, Toolchain toolchain, Reporter reporter,
        long index, long total, string artifactFolder) -> int {
    string label = report.progress(index, total, unit.label());
    reporter.step("{label}: reading {unit.sourceFolder()}");
    let built = buildUnit(loader, options, packaging, unit, artifactStem, namedOutput, toolchain,
        artifactFolder);
    reporter.notices(built.notices());
    reporter.explanation(built.explanation());
    return switch (built.outcome()) {
        BuildOutcome.Failed -> reportFailure(reporter, label, built),
        BuildOutcome.ValidatedLibrary -> reportLibrary(reporter, label, unit, namedOutput, built),
        BuildOutcome.BuiltExecutable -> reportExecutable(reporter, label, built),
    };
}

reportFailure(Reporter reporter, string label, UnitReport built) -> int {
    reporter.problems(built.problems());
    reporter.problem("{label}: build failed with "
        + report.problemCount(built.problems().length));
    return 1;
}

reportLibrary(Reporter reporter, string label, Unit unit, string namedOutput, UnitReport built) -> int {
    if (namedOutput.length > 0) {
        reporter.problem("'{unit.label()}' does not define main() in its main module, so it builds "
            + "as a library and there is no executable to write; drop '--output' to compile and "
            + "check it");
        return 2;
    }
    reporter.note("{label}: compiled {built.moduleCount()} module(s) as a library");
    return 0;
}

reportExecutable(Reporter reporter, string label, UnitReport built) -> int {
    reporter.problems(built.problems());
    reporter.step("{label}: emitted {built.objectCount()} object file(s) from "
        + "{built.moduleCount()} module(s)");
    reporter.note("{label}: built {built.artifact()}");
    return 0;
}

// Compiles one unit and links it when it is an application. Nothing here writes to a stream: the
// report carries every line the caller may want to show.
export buildUnit(FileLoader loader, BuildOptions options, Packaging packaging, Unit unit,
                 string artifactStem, string namedOutput, Toolchain toolchain,
                 string artifactFolder = "") -> UnitReport {
    return finishUnit(options, packaging, program.load(loader, options, packaging, unit),
        artifactStem, namedOutput, toolchain, artifactFolder);
}

// Everything a build does to a unit that is already loaded and analyzed. A caller with a rule of
// its own about what it loaded, as a test run has, checks that first and then comes here.
export finishUnit(BuildOptions options, Packaging packaging, Loaded loaded, string artifactStem,
                  string namedOutput, Toolchain toolchain,
                  string artifactFolder = "") -> UnitReport {
    let analysis = loaded.analysis();
    if (analysis == null) {
        return failed(loaded.problems(), loaded.moduleCount(), loaded.notices());
    }
    if (!loaded.definesEntry()) {
        return buildLibrary(options, analysis, loaded, artifactStem);
    }

    string output = namedOutput;
    if (output.length == 0) {
        string folder = artifactFolder;
        if (folder.length == 0) {
            folder = options.workingFolder();
        }
        output = path.join(folder, platform.executableNamed(artifactStem, options.targetTriple()));
    }
    // Asked to write a program over a folder, the linker stops the whole process on the spot and
    // takes its own account of why with it, so the one thing said about it has to be said here.
    if (system.isDirectory(output)) {
        return failed(["'{output}' is a folder, so the program cannot be written there; name the "
            + "program with '--output' or build from a folder that holds no '"
            + path.fileName(output) + "'"], loaded.moduleCount(), loaded.notices());
    }
    string objectsFolder = objectsFolderFor(options);
    string prepared = prepareObjectsFolder(options, objectsFolder);
    if (prepared.length > 0) {
        return failed([prepared], loaded.moduleCount(), loaded.notices());
    }

    let emitted = emitObjects(options, analysis, objectsFolder, path.stem(output) + ".");
    if (emitted.failure.length > 0) {
        return failed([emitted.failure], loaded.moduleCount(), loaded.notices());
    }
    if (emitted.diagnostics.length > 0) {
        return failed(diagnostics.formatAll(emitted.diagnostics, loaded.catalog()),
            loaded.moduleCount(), loaded.notices());
    }
    if (emitted.objects.length == 0) {
        return failed(["the program produced no object files, so there is nothing to link"],
            loaded.moduleCount(), loaded.notices());
    }

    let plan = natives.librariesFor(loaded.natives(),
        platform.platformName(options.targetTriple()));
    if (plan.failure().length > 0) {
        return failed([plan.failure()], loaded.moduleCount(), loaded.notices());
    }
    let prebuiltFiles = prebuilt.filesFor(plan, packaging);
    if (prebuiltFiles.failure().length > 0) {
        return failed([prebuiltFiles.failure()], loaded.moduleCount(), loaded.notices());
    }

    let linked = linker.link(new LinkRequest(emitted.objects, plan.libraries(),
        prebuiltFiles.files(), output, options.targetTriple()), toolchain);
    if (!linked.linked()) {
        return failed(linkFailureLines(output, linked.output()), loaded.moduleCount(),
            loaded.notices());
    }
    return new UnitReport(BuildOutcome.BuiltExecutable, output, linkerNoise(linked.output()),
        loaded.moduleCount(), emitted.objects.length, emitted.account, loaded.notices());
}

// A library is compiled the whole way, object files included, and produces no executable: the point
// of building one is to know that it compiles. Its objects are kept exactly where a program's are,
// because a library's objects are the ones most worth having again.
buildLibrary(BuildOptions options, ProgramAnalysis analysis, Loaded loaded,
             string artifactStem) -> UnitReport {
    string objectsFolder = objectsFolderFor(options);
    string prepared = prepareObjectsFolder(options, objectsFolder);
    if (prepared.length > 0) {
        return failed([prepared], loaded.moduleCount(), loaded.notices());
    }
    let emitted = emitObjects(options, analysis, objectsFolder, artifactStem + ".");
    if (emitted.failure.length > 0) {
        return failed([emitted.failure], loaded.moduleCount(), loaded.notices());
    }
    if (emitted.diagnostics.length > 0) {
        return failed(diagnostics.formatAll(emitted.diagnostics, loaded.catalog()),
            loaded.moduleCount(), loaded.notices());
    }
    string[] clean = [];
    return new UnitReport(BuildOutcome.ValidatedLibrary, "", clean, loaded.moduleCount(),
        emitted.objects.length, emitted.account, loaded.notices());
}

// Everything this machine contributes to a link for the target, looked up once for the whole
// invocation, because a target that links ELF runs the C compiler a few times. The probes write
// inside a folder claimed for this run alone, since two builds in one folder would otherwise write
// and take away the same probe file. Nowhere to claim one is a machine that answers nothing.
export discoverToolchain(BuildOptions options) -> Toolchain {
    string triple = options.targetTriple();
    let probes = scratch.createUnder(options.workingFolder(), FolderPrefixes.probe);
    if (probes.failure().length > 0) {
        return toolchain.bareToolchain();
    }
    let discovered = discovery.discover(flavor.flavorOf(triple), triple,
        path.join(probes.folder(), "probe"));
    scratch.discard(probes.folder());
    return discovered;
}

// The names the folders a run makes under a scratch root start with.
final class FolderPrefixes {
    // Dotted and tool-owned so it reads as neither a source folder nor a package of a workspace.
    protected static const string probe = ".ens-link-probe";

    // The folder one build's objects pass through on their way into place.
    protected static const string staging = "staging";
}

// What code generation left behind: the object files where they belong, whatever it diagnosed about
// the program, and the account it was asked for. A failure is the one thing here that is not the
// program's fault - a folder that could not be made, or an object that could not be put in place.
final class Emitted {
    protected string[] objects;
    protected FileDiagnostic[] diagnostics;
    protected string[] account;
    protected string failure;

    protected constructor(this.objects, this.diagnostics, this.account, this.failure);
}

// Generates the program's object files. Every one is written into a folder of this build's own and
// moved to where it belongs once it is whole, so what sits at an object's path is never a
// half-written object. The staging folder is inside the target folder, so the move is a rename
// within one volume.
emitObjects(BuildOptions options, ProgramAnalysis analysis, string objectsFolder,
            string filePrefix) -> Emitted {
    let staging = scratch.createUnder(objectsFolder, FolderPrefixes.staging);
    if (staging.failure().length > 0) {
        return failedEmission("the object files could not be assembled: " + staging.failure());
    }
    let emitted = driver.emitProgram(analysis, staging.folder(), filePrefix, options.codegen());
    string[] nothing = [];
    if (!emitted.succeeded()) {
        scratch.discard(staging.folder());
        return new Emitted(nothing, emitted.diagnostics(), emitted.arcExplanation(), "");
    }
    let placed = placeObjects(objectsFolder, emitted.objects());
    // A staging folder that could not be taken away is stepped over by the next build rather than
    // reused, and the run that finally has nowhere left to stage says so and names what to remove.
    scratch.discard(staging.folder());
    if (placed.failure.length > 0) {
        return failedEmission(placed.failure);
    }
    FileDiagnostic[] clean = [];
    return new Emitted(placed.files, clean, emitted.arcExplanation(), "");
}

// The object files of one emission, once each is where it belongs.
final class PlacedObjects {
    protected string[] files;
    protected string failure;

    protected constructor(this.files, this.failure);
}

placeObjects(string objectsFolder, List<string> staged) -> PlacedObjects {
    let placed = new List<string>();
    for (long i = 0; i < staged.length(); i++) {
        string from = staged.get(i);
        string to = path.join(objectsFolder, path.fileName(from));
        string problem = placeObject(from, to);
        if (problem.length > 0) {
            string[] nothing = [];
            return new PlacedObjects(nothing, problem);
        }
        placed.push(to);
    }
    return new PlacedObjects(placed.toArray(), "");
}

// Puts one finished object at its own path. What an earlier build left there goes first, because a
// move answers rather than replaces when a name is taken; across the two steps the path holds either
// that whole earlier object or this whole new one, and never a part of either.
placeObject(string from, string to) -> string {
    if (system.exists(to)) {
        try system.removeFile(to);
    }
    if (try system.move(from, to)) {
        return "";
    }
    return "the object file '{to}' was written by something else while this build was building it; "
        + "run one build of these sources at a time";
} catch (SystemError error) {
    return "the object file could not be put at '{to}': {error.message}";
}

failedEmission(string problem) -> Emitted {
    string[] nothing = [];
    FileDiagnostic[] clean = [];
    return new Emitted(nothing, clean, nothing, problem);
}

// The folder Ens keeps what a build root produces under. The name is dotted and tool-owned, so it
// cannot be read as a folder of sources and cannot be confused with a package of a workspace, and it
// leaves room beside the objects for whatever else a build root comes to keep.
export artifactsFolderIn(string artifactRoot) -> string {
    return path.join(artifactRoot, ".ens");
}

// Where the object files go: the folder the command line named, else a folder under the build root
// named after the target and the optimization level they were built for. Nothing built for one
// configuration ever shares a folder with another, so an object emitted for a different target or a
// different level can never be picked up by mistake.
export objectsFolderFor(BuildOptions options) -> string {
    if (options.objects().length > 0) {
        return options.objects();
    }
    string root = options.artifactRoot();
    if (root.length == 0) {
        root = options.workingFolder();
    }
    string configured = path.join(artifactsFolderIn(root), options.targetTriple());
    return path.join(configured, "O" + settings.levelText(options.codegen().optimizationLevel()));
}

// Anything the linker said on a link that still succeeded, which is worth passing on unchanged. The
// linker ends what it prints with a line break and the reporter ends every line it writes with one,
// so the linker's is dropped rather than shown as a blank line.
public linkerNoise(string reported) -> string[] {
    string said = reported.trim();
    if (said.length == 0) {
        string[] silent = [];
        return silent;
    }
    return [said];
}

// A failed link, in the linker's own words: they are the only description of what went wrong worth
// showing, and swallowing them would leave nothing to act on. It is one problem however many lines
// the linker spent on it, so it is reported as one.
public linkFailureLines(string output, string reported) -> string[] {
    string said = reported.trim();
    if (said.length == 0) {
        return ["linking '{output}' failed and the linker reported no reason"];
    }
    return ["linking '{output}' failed; the linker reported:\n{said}"];
}

// Makes the folder the objects go into, and, when that folder is one this build root owns, leaves a
// .gitignore beside it saying to ignore everything under it. What a build produces is not something
// anyone commits, and a file that says so where the files are needs nothing of whoever cloned the
// repository and nothing of anybody's memory.
prepareObjectsFolder(BuildOptions options, string objectsFolder) -> string {
    string problem = prepareFolder(objectsFolder);
    if (problem.length > 0) {
        return problem;
    }
    if (options.objects().length == 0) {
        ignoreEverythingIn(artifactsFolderIn(ownedRoot(options)));
    }
    return "";
}

ownedRoot(BuildOptions options) -> string {
    if (options.artifactRoot().length > 0) {
        return options.artifactRoot();
    }
    return options.workingFolder();
}

prepareFolder(string folder) -> string {
    if (system.isDirectory(folder)) {
        return "";
    }
    try system.createDirectory(folder);
    return "";
} catch (SystemError error) {
    return "could not create '{folder}' to hold the object files: {error.message}";
}

// A build that could not write the file goes on regardless: an ignore file is a courtesy to whoever
// reads the tree, and no build should fail over one.
ignoreEverythingIn(string folder) {
    string file = path.join(folder, ".gitignore");
    if (system.isFile(file)) {
        return;
    }
    try system.writeAllText(file, "*\n");
} catch (SystemError error) { }

// A unit that never reached an artifact, for the problems a caller found in it before a build did.
export failedUnit(string[] problems, long moduleCount, string[] notices) -> UnitReport {
    return failed(problems, moduleCount, notices);
}

failed(string[] problems, long moduleCount, string[] notices) -> UnitReport {
    string[] nothing = [];
    return new UnitReport(BuildOutcome.Failed, "", problems, moduleCount, 0, nothing, notices);
}
