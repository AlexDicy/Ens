// Building a target: one unit at a time, each loaded, analyzed, emitted into object files and
// linked. A unit whose main module defines main() produces a program, and one that does not is a
// library compiled just as thoroughly. Building a unit is a function of its inputs alone.
import Path from @std.fs;
import ErrorKind from @std.fs.error;
import FileSystemError from @std.fs.error;
import Thread from @std.thread;
import Platform from @std.environment;
import @std.environment;
import List from @std.collections.list;
import FileDiagnostic from @ens.sema.support.diagnostics;
import FileLoader from @ens.sema.support.loader;
import ProgramAnalysis from @ens.sema.pipeline;
import @ens.host.scratch;
import Retry from @ens.host.scratch;
import Scratch from @ens.host.scratch;
import @ens.codegen.driver;
import @ens.codegen.settings;
import LinkRequest from @ens.link.request;
import Toolchain from @ens.link.toolchain;
import @ens.link.discovery;
import @ens.link.flavor;
import @ens.link.linker;
import BuildOptions from options;
import Packaging from packaging;
import BuildTarget from target;
import TargetKind from target;
import WorkspaceMember from target;
import target;
import Reporter from report;
import report;
import diagnostics;
import Loaded from program;
import Unit from program;
import program;
import natives;
import objects;
import prebuilt;
import platform;

export enum BuildOutcome {
    BuiltExecutable,
    EmittedObjects,
    ValidatedLibrary,
    Failed,
}

// What building one unit came to. Its problems come in two kinds, and a unit reports one of them:
// diagnostic lines already name the file and position they are about, or what another tool wrote,
// while sentences are the build's own words and print under the 'ens: ' prefix.
export final class UnitReport {
    BuildOutcome result;
    Path producedArtifact;
    string[] diagnosticLines;
    string[] sentenceLines;
    long modules;
    long objects;
    string[] account;
    string[] noticeLines;

    protected constructor(this.result, this.producedArtifact, this.diagnosticLines,
                this.sentenceLines, this.modules, this.objects, this.account, this.noticeLines);

    export outcome() -> BuildOutcome {
        return this.result;
    }

    // The executable that was written, or empty text when the unit produced none.
    export artifact() -> Path {
        return this.producedArtifact;
    }

    export diagnostics() -> string[] {
        return this.diagnosticLines;
    }

    export sentences() -> string[] {
        return this.sentenceLines;
    }

    export problemCount() -> long {
        return this.diagnosticLines.length + this.sentenceLines.length;
    }

    export moduleCount() -> long {
        return this.modules;
    }

    export objectCount() -> long {
        return this.objects;
    }

    // What the build accounted for, when it was run with an option that asks for an account.
    export explanation() -> string[] {
        return this.account;
    }

    // What building this unit did that whoever ran the build should know about.
    export notices() -> string[] {
        return this.noticeLines;
    }
}

// Builds the target and returns the exit code: 0 built, 1 the work failed, 2 the command line
// requested something it cannot have.
export run(FileLoader loader, BuildOptions options, Packaging packaging, BuildTarget resolved,
           Reporter reporter) -> int {
    if (resolved.kind() == TargetKind.Workspace) {
        return runWorkspace(loader, options, packaging, resolved, reporter);
    }
    reporter.step("Building for '{options.targetTriple()}'");
    return runUnit(loader, options, packaging, program.unitOf(resolved), resolved.artifactName(),
        options.output(), discoverToolchain(options), reporter, 1, 1, Path(""));
}

// Builds every member of a workspace, each one after the members it depends on.
runWorkspace(FileLoader loader, BuildOptions options, Packaging packaging, BuildTarget resolved,
             Reporter reporter) -> int {
    if (options.namesOutput()) {
        reporter.problem("'--output' names one executable, but '{resolved.root()}' is a workspace "
            + "that builds one for each member. Name a member's folder to build only that "
            + "member, or remove '--output' so each member is named after its package");
        return 2;
    }
    let order = target.memberOrder(resolved.members());
    if (order.cycle().length > 0) {
        reporter.problem("these workspace members depend on each other in a circle: "
            + report.quotedNames(order.cycle()) + ". Remove one of those dependencies so the "
            + "members can be built in order");
        return 1;
    }
    WorkspaceMember[] members = order.members();
    if (members.length == 0) {
        reporter.note("This workspace has no members, so there is nothing to build. Add one to "
            + "its ens.package, as in 'member \"app\";'");
        return 0;
    }
    reporter.step("Building " + report.memberCount(members.length)
        + " for '{options.targetTriple()}'");
    let toolchain = discoverToolchain(options);
    // A member's program is named after its package, and a workspace's member folder is
    // conventionally named after the program it holds, so the two names are the same one. Keeping a
    // member's artifact where its objects are is what stops a build writing an executable over the
    // folder it just read the sources from.
    Path artifacts = objectsFolderFor(options);
    for (long i = 0; i < members.length; i++) {
        let member = members[i];
        int code = runUnit(loader, options, packaging,
            program.memberUnit(member, resolved.root()),
            target.artifactStem(member.packageName()), Path(""), toolchain, reporter, i + 1,
            members.length, artifacts);
        if (code != 0) {
            return code;
        }
    }
    return 0;
}

// Builds one unit and reports it, returning the exit code its outcome deserves.
runUnit(FileLoader loader, BuildOptions options, Packaging packaging, Unit unit,
        string artifactStem, Path namedOutput, Toolchain toolchain, Reporter reporter,
        long index, long total, Path artifactFolder) -> int {
    string label = report.progress(index, total, unit.label());
    reporter.step("{label}: Reading '{unit.sourceFolder()}'");
    let built = buildUnit(loader, options, packaging, unit, artifactStem, namedOutput, toolchain,
        artifactFolder);
    reporter.notices(built.notices());
    reporter.explanation(built.explanation());
    return switch (built.outcome()) {
        BuildOutcome.Failed -> reportFailure(reporter, label, built),
        BuildOutcome.ValidatedLibrary -> reportLibrary(reporter, label, unit, namedOutput, built),
        BuildOutcome.BuiltExecutable -> reportExecutable(reporter, label, built),
        BuildOutcome.EmittedObjects -> reportObjects(reporter, label, built),
    };
}

reportFailure(Reporter reporter, string label, UnitReport built) -> int {
    reporter.diagnostics(built.diagnostics());
    reporter.sentences(built.sentences());
    reporter.problem("{label}: build failed with "
        + report.problemCount(built.problemCount()));
    return 1;
}

reportLibrary(Reporter reporter, string label, Unit unit, Path namedOutput,
              UnitReport built) -> int {
    if (!namedOutput.isEmpty()) {
        reporter.problem("'{unit.label()}' has no main() in its main module, so it is a library "
            + "and there is no executable to write. Remove '--output' to compile it as a library");
        return 2;
    }
    reporter.note("{label}: Compiled " + report.moduleCount(built.moduleCount())
        + " as a library");
    return 0;
}

reportExecutable(Reporter reporter, string label, UnitReport built) -> int {
    reporter.diagnostics(built.diagnostics());
    reporter.sentences(built.sentences());
    reporter.step("{label}: Emitted " + report.objectCount(built.objectCount()) + " from "
        + report.moduleCount(built.moduleCount()));
    reporter.note("{label}: Built '{built.artifact()}'");
    return 0;
}

reportObjects(Reporter reporter, string label, UnitReport built) -> int {
    reporter.note("{label}: Emitted " + report.objectCount(built.objectCount()) + " from "
        + report.moduleCount(built.moduleCount()) + " into '{built.artifact()}', and linked "
        + "nothing");
    return 0;
}

// Compiles one unit and links it when it is an application. Nothing here writes to a stream: the
// report carries every line the caller may show.
export buildUnit(FileLoader loader, BuildOptions options, Packaging packaging, Unit unit,
                 string artifactStem, Path namedOutput, Toolchain toolchain,
                 Path artifactFolder = Path("")) -> UnitReport {
    return finishUnit(options, packaging, program.load(loader, options, packaging, unit),
        artifactStem, namedOutput, toolchain, artifactFolder);
}

// Everything a build does to a unit that is already loaded and analyzed. A caller with a rule of
// its own about what it loaded, as a test run has, checks that first and then comes here.
export finishUnit(BuildOptions options, Packaging packaging, Loaded loaded, string artifactStem,
                  Path namedOutput, Toolchain toolchain,
                  Path artifactFolder = Path("")) -> UnitReport {
    let analysis = loaded.analysis();
    if (analysis == null) {
        return new UnitReport(BuildOutcome.Failed, Path(""), loaded.diagnostics(),
            loaded.sentences(), loaded.moduleCount(), 0, nothing(), loaded.notices());
    }
    if (!loaded.definesEntry()) {
        return buildLibrary(options, analysis, loaded, artifactStem);
    }
    if (!options.linksProgram()) {
        return emitUnlinked(options, analysis, loaded, artifactStem);
    }

    Path output = namedOutput;
    if (output.isEmpty()) {
        Path folder = artifactFolder;
        if (folder.isEmpty()) {
            folder = options.workingFolder();
        }
        output = folder.join(platform.executableNamed(artifactStem, options.targetTriple()));
    }
    // Given a folder as the program path, the linker stops the whole process on the spot and
    // takes its own account of why with it, so the one line printed about it has to be printed here.
    if (output.isDirectory()) {
        return failed(["'{output}' is a folder, so the program cannot be written there. Name the "
            + "program with '--output', or rename the folder '" + output.fileName() + "'"],
            loaded.moduleCount(), loaded.notices());
    }
    Path objectsFolder = objectsFolderFor(options);
    string prepared = prepareObjectsFolder(options, objectsFolder);
    if (prepared.length == 0) {
        prepared = prepareOutputFolder(output);
    }
    if (prepared.length > 0) {
        return failed([prepared], loaded.moduleCount(), loaded.notices());
    }

    let emitted = emitObjects(options, analysis, objectsFolder, output.stem() + ".");
    if (emitted.failure.length > 0) {
        return failed([emitted.failure], loaded.moduleCount(),
            withLeftovers(loaded.notices(), emitted.leftBehind));
    }
    if (emitted.diagnostics.length > 0) {
        return failedWithDiagnostics(diagnostics.formatAll(emitted.diagnostics, loaded.catalog()),
            loaded.moduleCount(), withLeftovers(loaded.notices(), emitted.leftBehind));
    }
    let attempt = linkStaged(packaging, loaded, emitted, output, options, toolchain);
    string[] notices = withLeftovers(withLeftovers(withLeftovers(loaded.notices(),
        emitted.leftBehind), keepObjects(emitted, objectsFolder)), attempt.leftBehind);
    if (attempt.failure.length > 0) {
        return failed(attempt.failure, loaded.moduleCount(), notices);
    }
    return new UnitReport(BuildOutcome.BuiltExecutable, output, attempt.noise, nothing(),
        loaded.moduleCount(), emitted.objects.length, emitted.account, notices);
}

// A program built without its link: the object files go where the build keeps them, and the
// report names that folder in place of an executable.
emitUnlinked(BuildOptions options, ProgramAnalysis analysis, Loaded loaded,
             string artifactStem) -> UnitReport {
    Path objectsFolder = objectsFolderFor(options);
    string prepared = prepareObjectsFolder(options, objectsFolder);
    if (prepared.length > 0) {
        return failed([prepared], loaded.moduleCount(), loaded.notices());
    }
    let emitted = emitObjects(options, analysis, objectsFolder, artifactStem + ".");
    if (emitted.failure.length > 0) {
        return failed([emitted.failure], loaded.moduleCount(),
            withLeftovers(loaded.notices(), emitted.leftBehind));
    }
    if (emitted.diagnostics.length > 0) {
        return failedWithDiagnostics(diagnostics.formatAll(emitted.diagnostics, loaded.catalog()),
            loaded.moduleCount(), withLeftovers(loaded.notices(), emitted.leftBehind));
    }
    string[] notices = withLeftovers(withLeftovers(loaded.notices(), emitted.leftBehind),
        keepObjects(emitted, objectsFolder));
    return new UnitReport(BuildOutcome.EmittedObjects, objectsFolder, nothing(), nothing(),
        loaded.moduleCount(), emitted.objects.length, emitted.account, notices);
}

// What linking a unit's staged objects came to: why it failed, or what the linker printed on a link
// that succeeded.
final class LinkAttempt {
    protected string[] failure;
    protected string[] noise;
    // Why the folder the program was linked in is still there, and why each folder an earlier
    // build left beside the program could not be removed.
    protected string[] leftBehind;

    protected constructor(this.failure, this.noise, this.leftBehind);
}

// Links the program out of the objects in the build's own staging folder, which no other build reads
// or writes, into a folder of its own beside the program, and then moves it over the program in one
// step. Another build of the same program therefore never meets a half-written or missing one. The
// folder is marked as this build's, so a build the linker ended leaves one the next build removes.
linkStaged(Packaging packaging, Loaded loaded, Emitted emitted, Path output, BuildOptions options,
           Toolchain toolchain) -> LinkAttempt {
    string[] none = [];
    if (emitted.objects.length == 0) {
        return new LinkAttempt(["Internal: code generation wrote no object files for a program "
            + "that defines main()"], none, none);
    }
    let plan = natives.librariesFor(loaded.natives(),
        platform.platformName(options.targetTriple()));
    if (plan.failure().length > 0) {
        return new LinkAttempt([plan.failure()], none, none);
    }
    let prebuiltFiles = prebuilt.filesFor(plan, packaging);
    if (prebuiltFiles.failure().length > 0) {
        return new LinkAttempt([prebuiltFiles.failure()], none, none);
    }
    let room = scratch.createMarkedUnder(output.parent() ?? Path("."), FolderPrefixes.linking);
    if (room.failure().length > 0) {
        return new LinkAttempt([room.failure()], none, room.leftBehind());
    }
    Path linking = room.folder().join(output.fileName());
    let linked = linker.link(new LinkRequest(emitted.objects, plan.libraries(),
        prebuiltFiles.files(), linking.toString(), options.targetTriple(), output.toString()),
        toolchain);
    string[] failure = none;
    if (linked.problem().length > 0) {
        failure = [linked.problem()];
    } else if (!linked.linked()) {
        failure = linkFailureLines(output, linked.output());
    } else {
        failure = placed(linking, output);
    }
    let leftBehind = withRemoval(room.leftBehind(), room.remove());
    if (failure.length > 0) {
        return new LinkAttempt(failure, none, leftBehind);
    }
    return new LinkAttempt(none, linkerNoise(linked.output()), leftBehind);
}

// Moves the linked program over the one at 'output' in one step. Empty when that worked, or why it
// did not. Windows refuses to replace a file another program has open, so a refusal of that kind is
// waited out over the same schedule a scratch folder's removal is.
placed(Path linking, Path output) -> string[] {
    string[] none = [];
    FileSystemError? refused = moved(linking, output);
    if (refused == null) {
        return none;
    }
    FileSystemError last = refused;
    for (let wait in Retry.schedule()) {
        if (!scratch.waitingCanClear(last.kind, environment.platform())) {
            break;
        }
        Thread.sleep(wait);
        FileSystemError? again = moved(linking, output);
        if (again == null) {
            return none;
        }
        last = again;
    }
    return [replaceText(output, last, environment.platform())];
}

// The message for a program that could not be moved over the one at 'output'. On Windows a refused
// permission is a file another program has open or one marked read-only, which waiting did not
// clear.
public replaceText(Path output, FileSystemError last, Platform platform) -> string {
    if (platform == Platform.Windows && last.kind == ErrorKind.PermissionDenied) {
        return "could not replace '{output}': another program has it open, such as a running copy "
            + "of the program, or the file is read-only. Close that program or clear the read-only "
            + "setting, and build again";
    }
    return "could not replace '{output}': {last.reason}";
}

moved(Path linking, Path output) -> FileSystemError? {
    try linking.moveTo(output, true);
    return null;
} catch (FileSystemError refused) {
    return refused;
}

// A library is compiled the whole way, object files included, and produces no executable: the point
// of building one is to know that it compiles. Its objects are kept exactly where a program's are,
// because a library's objects are the ones most worth having again.
buildLibrary(BuildOptions options, ProgramAnalysis analysis, Loaded loaded,
             string artifactStem) -> UnitReport {
    Path objectsFolder = objectsFolderFor(options);
    string prepared = prepareObjectsFolder(options, objectsFolder);
    if (prepared.length > 0) {
        return failed([prepared], loaded.moduleCount(), loaded.notices());
    }
    let emitted = emitObjects(options, analysis, objectsFolder, artifactStem + ".");
    if (emitted.failure.length > 0) {
        return failed([emitted.failure], loaded.moduleCount(),
            withLeftovers(loaded.notices(), emitted.leftBehind));
    }
    if (emitted.diagnostics.length > 0) {
        return failedWithDiagnostics(diagnostics.formatAll(emitted.diagnostics, loaded.catalog()),
            loaded.moduleCount(), withLeftovers(loaded.notices(), emitted.leftBehind));
    }
    string[] notices = withLeftovers(withLeftovers(loaded.notices(), emitted.leftBehind),
        keepObjects(emitted, objectsFolder));
    return new UnitReport(BuildOutcome.ValidatedLibrary, Path(""), nothing(), nothing(),
        loaded.moduleCount(), emitted.objects.length, emitted.account, notices);
}

// Everything this machine contributes to a link for the target, looked up once for the whole
// invocation, because a target that links ELF runs the C compiler a few times.
export discoverToolchain(BuildOptions options) -> Toolchain {
    string triple = options.targetTriple();
    return discovery.discover(flavor.flavorOf(triple), triple);
}

// The name the folder one build's objects pass through on their way into place starts with.
final class FolderPrefixes {
    protected static const string staging = "staging";
    // The folder beside the program it is linked in, dotted so a listing passes over it.
    protected static const string linking = ".ens-link";
}

// What code generation left behind: the object files where they belong, whatever it diagnosed about
// the program, and the account requested. A failure is the one thing here that is not the
// program's fault - a folder that could not be made, or an object that could not be put in place.
final class Emitted {
    protected string[] objects;
    protected FileDiagnostic[] diagnostics;
    protected string[] account;
    protected string failure;
    // Why the staging folder is still there, and why each staging folder an earlier build left
    // could not be removed.
    protected string[] leftBehind;
    // The build's own folder the objects are in until they are kept, or null once it is gone.
    protected Scratch? staging;

    protected constructor(this.objects, this.diagnostics, this.account, this.failure,
                this.leftBehind, this.staging);
}

// Generates the program's object files into a folder of this build's own, each named there after its
// bytes. What is in that folder is never read or written by another build, so the link reads the
// objects there, and 'keepObjects' then puts them where the build keeps them. The folder is marked
// as this build's, so one a stopped build leaves is removed by the next build.
emitObjects(BuildOptions options, ProgramAnalysis analysis, Path objectsFolder,
            string filePrefix) -> Emitted {
    let staging = scratch.createMarkedUnder(objectsFolder, FolderPrefixes.staging);
    if (staging.failure().length > 0) {
        return failedEmission(staging.failure(), staging.leftBehind());
    }
    let emitted = driver.emitProgram(analysis, staging.folder().toString(), filePrefix,
        options.codegen());
    string[] nothing = [];
    if (!emitted.succeeded()) {
        return new Emitted(nothing, emitted.diagnostics(), emitted.explanation(), "",
            withRemoval(staging.leftBehind(), staging.remove()), null);
    }
    let named = nameObjects(emitted.objects());
    FileDiagnostic[] clean = [];
    if (named.failure.length > 0) {
        return new Emitted(nothing, clean, nothing, named.failure,
            withRemoval(staging.leftBehind(), staging.remove()), null);
    }
    return new Emitted(named.files, clean, emitted.explanation(), "", staging.leftBehind(),
        staging);
}

// The object files of one emission, each under the name its bytes give it.
final class NamedObjects {
    protected string[] files;
    protected string failure;

    protected constructor(this.files, this.failure);
}

// Renames every staged object, inside the staging folder, to the name its bytes give it.
nameObjects(List<string> staged) -> NamedObjects {
    let named = new List<string>();
    for (long i = 0; i < staged.length(); i++) {
        Path emitted = Path(staged.get(i));
        Path folder = emitted.parent() ?? Path("");
        Path renamed = folder.join(objects.contentName(emitted.fileName(), try emitted.readBytes()));
        try emitted.moveTo(renamed);
        named.push(renamed.toString());
    }
    return new NamedObjects(named.toArray(), "");
} catch (FileSystemError refused) {
    string[] nothing = [];
    return new NamedObjects(nothing, refused.message);
}

// Moves the emission's objects from its staging folder to where the build keeps them, clears the
// other versions of those objects, and removes the staging folder. Returns what could not be done,
// one line each.
keepObjects(Emitted emitted, Path objectsFolder) -> string[] {
    let kept = new List<string>();
    let problems = new List<string>();
    for (let staged in emitted.objects) {
        Path from = Path(staged);
        try objects.keepObject(from, objectsFolder, from.fileName());
        kept.push(from.fileName());
    }
    let present = new List<string>();
    for (let entry in try objectsFolder.entries()) {
        present.push(entry.name);
    }
    for (let stale in objects.staleNames(present.toArray(), kept.toArray())) {
        string refused = removedOrWhy(objectsFolder.join(stale));
        if (refused.length > 0) {
            problems.push(refused);
        }
    }
    string leftBehind = removedStaging(emitted);
    if (leftBehind.length > 0) {
        problems.push(leftBehind);
    }
    return problems.toArray();
} catch (FileSystemError refused) {
    string leftBehind = removedStaging(emitted);
    if (leftBehind.length > 0) {
        return [refused.message, leftBehind];
    }
    return [refused.message];
}

// Removes the emission's staging folder. Returns why it is still there, or "" when it is gone.
removedStaging(Emitted emitted) -> string {
    Scratch? staging = emitted.staging;
    emitted.staging = null;
    if (staging == null) {
        return "";
    }
    return staging.remove();
}

// Removes an object the build no longer keeps, or says why it is still there.
removedOrWhy(Path stale) -> string {
    try stale.removeFile();
    return "";
} catch (FileSystemError refused) {
    return refused.message;
}

failedEmission(string problem, string[] leftBehind) -> Emitted {
    string[] nothing = [];
    FileDiagnostic[] clean = [];
    return new Emitted(nothing, clean, nothing, problem, leftBehind, null);
}

// The notices of a unit, with the staging folder its emission could not remove among them, so a
// folder a build leaves behind is reported with where it is and why it is still there.
export withLeftover(string[] notices, string leftBehind) -> string[] {
    if (leftBehind.length == 0) {
        return notices;
    }
    let all = new List<string>();
    for (let notice in notices) {
        all.push(notice);
    }
    all.push("ens: " + leftBehind);
    return all.toArray();
}

// The leftovers, and after them why a folder this run made is still there when that is not empty.
withRemoval(string[] leftovers, string removal) -> string[] {
    if (removal.length == 0) {
        return leftovers;
    }
    let all = new List<string>();
    for (let leftover in leftovers) {
        all.push(leftover);
    }
    all.push(removal);
    return all.toArray();
}

// The notices with each of the leftovers among them, each one in the form 'withLeftover' gives it.
export withLeftovers(string[] notices, string[] leftovers) -> string[] {
    string[] all = notices;
    for (let leftover in leftovers) {
        all = withLeftover(all, leftover);
    }
    return all;
}

// The folder Ens keeps what a build root produces under. The name is dotted and tool-owned, so it
// is not a folder of sources and cannot be confused with a package of a workspace, and it
// leaves room beside the objects for whatever else a build root comes to keep.
export artifactsFolderIn(Path artifactRoot) -> Path {
    return artifactRoot.join(".ens");
}

// Where the object files go: the folder the command line named, else a folder under the build root
// named after the target and the optimization level they were built for. Nothing built for one
// configuration ever shares a folder with another, so an object emitted for a different target or a
// different level can never be picked up by mistake.
export objectsFolderFor(BuildOptions options) -> Path {
    if (!options.objects().isEmpty()) {
        return options.objects();
    }
    Path root = options.artifactRoot();
    if (root.isEmpty()) {
        root = options.workingFolder();
    }
    Path configured = artifactsFolderIn(root).join(options.targetTriple());
    return configured.join("O" + settings.levelText(options.codegen().optimizationLevel()));
}

// Anything the linker printed on a link that still succeeded, which is worth passing on unchanged
// and so goes in the report's diagnostic lines rather than its sentences. The linker ends what it
// prints with a line break and the reporter ends every line it writes with one, so the linker's is
// dropped rather than shown as a blank line.
public linkerNoise(string reported) -> string[] {
    string text = reported.trim();
    if (text.length == 0) {
        string[] silent = [];
        return silent;
    }
    return [text];
}

// A failed link, in the linker's own words: they are the only description of what went wrong worth
// showing, and swallowing them would leave nothing to act on. It is one problem however many lines
// the linker spent on it, so it is reported as one.
public linkFailureLines(Path output, string reported) -> string[] {
    string text = reported.trim();
    if (text.length == 0) {
        return ["linking '{output}' failed and the linker reported no reason"];
    }
    return ["linking '{output}' failed; the linker reported:\n{text}"];
}

// Makes the folder the objects go into, and, when that folder is one this build root owns, leaves a
// .gitignore beside it saying to ignore everything under it. What a build produces is not something
// anyone commits, and a file that says so where the files are needs nothing of whoever cloned the
// repository and nothing of anybody's memory.
prepareObjectsFolder(BuildOptions options, Path objectsFolder) -> string {
    string problem = prepareFolder(objectsFolder, "the object files", "--objects");
    if (problem.length > 0) {
        return problem;
    }
    if (options.objects().isEmpty()) {
        ignoreEverythingIn(artifactsFolderIn(ownedRoot(options)));
    }
    return "";
}

ownedRoot(BuildOptions options) -> Path {
    if (!options.artifactRoot().isEmpty()) {
        return options.artifactRoot();
    }
    return options.workingFolder();
}

// Makes every missing folder above the program's path. Returns "" when that worked, or why it
// did not.
public prepareOutputFolder(Path output) -> string {
    Path? folder = output.parent();
    if (folder == null || folder.isEmpty()) {
        return "";
    }
    return prepareFolder(folder, "the program", "--output");
}

// Makes `folder` and every missing folder above it. Returns "" when that worked, or why there is
// no folder for `holding`, with `option` as the way to name another one.
public prepareFolder(Path folder, string holding, string option) -> string {
    if (folder.isDirectory()) {
        return "";
    }
    try folder.createDirectories();
    return "";
} catch (FileSystemError refused) {
    string opening = "could not create the folder '{refused.path}' for {holding}";
    if (refused.kind == ErrorKind.AlreadyExists) {
        return "{opening}: a file of that name is already there. Remove the file, or name another "
            + "folder with '{option}'";
    }
    return "{opening}: {folderReason(refused)}. Name a folder that can be written to with "
        + "'{option}'";
}

// Why a folder could not be made, in the words the build's own messages use. An absence is the
// library's own reason, which names the drive, the share or what is above the folder.
folderReason(FileSystemError refused) -> string {
    return switch (refused.kind) {
        ErrorKind.NotFound -> refused.reason,
        ErrorKind.PermissionDenied -> "permission was refused",
        ErrorKind.NotADirectory -> "something in its path is a file, not a folder",
        ErrorKind.NoSpace -> "the file system has no room left",
        default -> "the system reported error {refused.nativeError}",
    };
}

// A build that could not write the file goes on regardless: an ignore file is a courtesy to whoever
// reads the tree, and no build should fail over one.
ignoreEverythingIn(Path folder) {
    Path file = folder.join(".gitignore");
    if (file.isFile()) {
        return;
    }
    try file.writeText("*\n");
} catch (FileSystemError refused) { }

// A unit that never reached an artifact, for a sentence a caller found in it before a build did.
export failedUnit(string[] sentences, long moduleCount, string[] notices) -> UnitReport {
    return failed(sentences, moduleCount, notices);
}

// A unit that failed in the build's own words.
failed(string[] sentences, long moduleCount, string[] notices) -> UnitReport {
    return new UnitReport(BuildOutcome.Failed, Path(""), nothing(), sentences, moduleCount, 0,
        nothing(), notices);
}

// A unit that failed with diagnostics the compiler formatted.
failedWithDiagnostics(string[] lines, long moduleCount, string[] notices) -> UnitReport {
    return new UnitReport(BuildOutcome.Failed, Path(""), lines, nothing(), moduleCount, 0,
        nothing(), notices);
}

nothing() -> string[] {
    string[] none = [];
    return none;
}
