// `ens override`: what the three forms of the command do. Each one finds the workspace the command
// was run in, reads the ens.overrides file beside its manifest, and either says what is in it or
// writes it back with one declaration changed.
//
// None of them builds anything, so none of them hands the work to another toolchain: an override is
// about this checkout on this machine, and which version of Ens would compile it does not come into
// it.
import SystemError from @std.system;
import FileLoader from @ens.sema.support.loader;
import OverrideEntry from @ens.sema.program.workspace;
import @ens.sema.program.workspace;
import @ens.packages.overrides;
import Reporter from report;

// Redirects the named package at the given folder, replacing an existing redirection of it.
export add(FileLoader loader, string workingFolder, string name, string given,
           Reporter reporter) -> int {
    string root = rootOrRefuse(loader, workingFolder, reporter);
    if (root.length == 0) {
        return 2;
    }
    if (!overrides.isPackageName(name)) {
        reporter.problem("ens: '{name}' is not a package name; a package name is dotted "
            + "identifiers, as in 'ens override add acme.json ../json'");
        return 2;
    }
    string stored = overrides.relativeTo(overrides.resolved(workingFolder, given), root);
    if (stored.indexOf("\"") >= 0) {
        reporter.problem("ens: the folder '{given}' cannot be written into ens.overrides because "
            + "its name holds a '\"'");
        return 2;
    }
    string wrong = overrides.targetProblem(loader, root, name, stored);
    if (wrong.length > 0) {
        reporter.problem("ens: package '{name}' cannot be taken from '{given}': {wrong}");
        return 1;
    }

    let file = try overrides.read(root);
    string unusable = file.editingProblem();
    if (unusable.length > 0) {
        reporter.problem("ens: " + unusable);
        return 1;
    }
    bool replacing = file.survey().find(name) != null;
    try overrides.write(file.path(), file.withOverride(name, stored));
    if (replacing) {
        reporter.note("Replaced the override for package '{name}': now {stored}");
        return 0;
    }
    reporter.note("Added the override for package '{name}': {stored}");
    return 0;
} catch (SystemError error) {
    reporter.problem("ens: the override could not be added: {error.message}");
    return 1;
}

// Stops redirecting the named package.
export remove(FileLoader loader, string workingFolder, string name, Reporter reporter) -> int {
    string root = rootOrRefuse(loader, workingFolder, reporter);
    if (root.length == 0) {
        return 2;
    }
    let file = try overrides.read(root);
    string unusable = file.editingProblem();
    if (unusable.length > 0) {
        reporter.problem("ens: " + unusable);
        return 1;
    }
    if (file.survey().find(name) == null) {
        reporter.problem("ens: package '{name}' is not overridden in '{file.path()}'; run 'ens "
            + "override list' to see which packages are");
        return 1;
    }
    try overrides.write(file.path(), file.withoutOverride(name));
    reporter.note("Removed the override for package '{name}'");
    return 0;
} catch (SystemError error) {
    reporter.problem("ens: the override could not be removed: {error.message}");
    return 1;
}

// Says which packages are overridden and whether each one's folder can be used.
export list(FileLoader loader, string workingFolder, Reporter reporter) -> int {
    string root = rootOrRefuse(loader, workingFolder, reporter);
    if (root.length == 0) {
        return 2;
    }
    let file = try overrides.read(root);
    string unusable = file.editingProblem();
    if (unusable.length > 0) {
        reporter.problem("ens: " + unusable);
        return 1;
    }
    OverrideEntry[] declared = file.survey().overrides();
    if (declared.length == 0) {
        reporter.note("No packages are overridden in '{file.path()}'.");
        return 0;
    }
    for (let entry in declared) {
        reporter.note(described(loader, root, entry));
    }
    return 0;
} catch (SystemError error) {
    reporter.problem("ens: the overrides could not be read: {error.message}");
    return 1;
}

// "acme.json -> ../json", with the reason after it when the folder cannot be used.
described(FileLoader loader, string root, OverrideEntry entry) -> string {
    string line = "{entry.packageName()} -> {entry.folder()}";
    string wrong = overrides.targetProblem(loader, root, entry.packageName(), entry.folder());
    if (wrong.length > 0) {
        return line + " (not usable: {wrong})";
    }
    return line;
}

// The workspace the command was run in, or empty text once the reason there is none has been said.
// Overrides belong beside a manifest, so a folder with none above it is nowhere to keep them.
rootOrRefuse(FileLoader loader, string workingFolder, Reporter reporter) -> string {
    string? discovered = workspace.discoverRoot(loader, workingFolder);
    if (discovered == null) {
        reporter.problem("ens: no ens.package manifest was found in '{workingFolder}' or in any "
            + "folder above it; an override lives beside the manifest of the workspace it applies "
            + "to");
        return "";
    }
    return discovered;
}
