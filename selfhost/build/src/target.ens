// What a path argument names: one '.ens' file, a plain folder of sources, a package, or a workspace
// of member packages, and with no path argument the nearest manifest above the current folder. A
// workspace keeps its members as the graph its manifests describe, not as a flattened list.
import Path from @std.fs;

import List from @std.collections.list;
import Set from @std.collections.set;
import FileLoader from @ens.sema.support.loader;
import ManifestSurvey from @ens.sema.program.workspace;
import @ens.sema.program.workspace;
import @ens.host.paths;
import FileDiagnostic from @ens.sema.support.diagnostics;
import SourceCatalog from diagnostics;
import diagnostics;
import report;

export enum TargetKind {
    // One '.ens' file, compiled as a program whose main module is that file.
    File,
    // A folder of sources with no manifest above them inside the folder.
    Folder,
    // A folder whose manifest declares a package.
    Package,
    // A folder whose manifest lists member packages.
    Workspace,
}

// One member of a workspace: the package it declares, its folder, the packages it
// declares a dependency on, and the Ens version it declares.
export final class WorkspaceMember {
    string memberName;
    Path memberFolder;
    string[] memberDependencies;
    string memberVersion;

    export constructor(this.memberName, this.memberFolder, this.memberDependencies, this.memberVersion);

    export packageName() -> string {
        return this.memberName;
    }

    export folder() -> Path {
        return this.memberFolder;
    }

    // The packages this member declares a dependency on, whether or not they are members too.
    export dependencies() -> string[] {
        return this.memberDependencies;
    }

    export ensVersion() -> string {
        return this.memberVersion;
    }
}

export final class BuildTarget {
    TargetKind targetKind;
    Path targetRoot;
    Path targetSource;
    Path targetTests;
    string targetEntry;
    string targetName;
    string targetPackage;
    WorkspaceMember[] targetMembers;
    string targetVersion;
    Path targetArtifacts;

    protected constructor(this.targetKind, this.targetRoot, this.targetSource, this.targetTests,
                this.targetEntry, this.targetName, this.targetPackage, this.targetMembers,
                this.targetVersion, this.targetArtifacts);

    export kind() -> TargetKind {
        return this.targetKind;
    }

    // The folder or file the command line named, or the manifest folder discovery found.
    export root() -> Path {
        return this.targetRoot;
    }

    // The folder a build of this target keeps what it produces under. It is the build root - the
    // nearest folder above the sources holding a manifest - rather than wherever an output was
    // named, because '--output' moves from one run to the next and the build root does not.
    export artifactRoot() -> Path {
        return this.targetArtifacts;
    }

    // The folder the modules are read from.
    export sourceFolder() -> Path {
        return this.targetSource;
    }

    // The folder holding the target's tests, or empty text when it has none.
    export testsFolder() -> Path {
        return this.targetTests;
    }

    // The file that is the program's main module, for a single-file target; empty otherwise.
    export entryFile() -> string {
        return this.targetEntry;
    }

    // What an artifact of this target is named after.
    export artifactName() -> string {
        return this.targetName;
    }

    // The package the target's manifest declares, or empty text when it declares none.
    export packageName() -> string {
        return this.targetPackage;
    }

    export members() -> WorkspaceMember[] {
        return this.targetMembers;
    }

    // The Ens version the build root declares it is written for: a package's own, a workspace's
    // agreed member version, or empty text for a single file or a folder with no manifest.
    export governingVersion() -> string {
        return this.targetVersion;
    }
}

// A resolved target, or the reason the path argument named none.
export final class TargetResolution {
    BuildTarget? found;
    string problem;
    string[] manifestProblems;

    protected constructor(this.found, this.problem, string[] manifestProblems = []) {
        this.manifestProblems = manifestProblems;
    }

    export target() -> BuildTarget? {
        return this.found;
    }

    export failure() -> string {
        return this.problem;
    }

    // Problems in the target's manifest that already name the file and position they are about.
    export diagnostics() -> string[] {
        return this.manifestProblems;
    }
}

// Resolves the optional path argument of a build. `given` is empty text when the command line named
// no path, and the nearest manifest above the working folder is used instead. The working folder
// is the text the invocation captured, already written with '/'; `given` is a command line
// wrote it, so it is converted here.
export resolve(FileLoader loader, Path workingFolder, string given) -> TargetResolution {
    if (given.length == 0) {
        Path? discovered = workspace.discoverRoot(loader, workingFolder);
        if (discovered == null) {
            return failed("no path was given, and no ens.package manifest was found in "
                + "'{workingFolder}' or in any folder above it. Name what to build, for example "
                + "'src/main.ens' or the package's folder");
        }
        return resolveFolder(loader, discovered);
    }
    Path named = paths.resolved(given, workingFolder);
    if (named.isFile()) {
        if (named.extension() != "ens") {
            return failed("'{given}' is not an Ens source file. Name a file whose name ends in "
                + "'.ens', a folder of sources or a package");
        }
        Path beside = named.parent() ?? Path("");
        return new TargetResolution(new BuildTarget(TargetKind.File, named, beside, Path(""),
            named.fileName(), named.stem(), "", noMembers(), "",
            buildRootAbove(loader, beside)), "");
    }
    if (!named.isDirectory()) {
        return failed("'{given}' does not exist");
    }
    return resolveFolder(loader, named);
}

// The order a workspace's members build in, derived from the graph they declare.
export final class MemberOrder {
    WorkspaceMember[] ordered;
    string[] entangled;

    protected constructor(this.ordered, this.entangled);

    // Every member, each one after the members it depends on.
    export members() -> WorkspaceMember[] {
        return this.ordered;
    }

    // The members whose dependencies form a cycle, so no order puts each of them after the ones it
    // depends on; empty when the graph is acyclic.
    export cycle() -> string[] {
        return this.entangled;
    }
}

// Orders members so each one follows every member it depends on. A dependency on a package that is
// not a member imposes no order. Members caught in a cycle are named and kept in manifest order, so
// a build can still report them all.
export memberOrder(WorkspaceMember[] members) -> MemberOrder {
    let placed = new Set<string>();
    let ordered = new List<WorkspaceMember>();
    let names = new Set<string>();
    for (long i = 0; i < members.length; i++) {
        names.add(members[i].packageName());
    }
    while (ordered.length() < members.length) {
        bool progressed = false;
        for (long i = 0; i < members.length; i++) {
            if (placed.contains(members[i].packageName())) {
                continue;
            }
            if (!dependenciesPlaced(members[i], names, placed)) {
                continue;
            }
            placed.add(members[i].packageName());
            ordered.push(members[i]);
            progressed = true;
        }
        if (!progressed) {
            let entangled = new List<string>();
            for (long i = 0; i < members.length; i++) {
                if (!placed.contains(members[i].packageName())) {
                    entangled.push(members[i].packageName());
                    ordered.push(members[i]);
                }
            }
            return new MemberOrder(ordered.toArray(), entangled.toArray());
        }
    }
    string[] acyclic = [];
    return new MemberOrder(ordered.toArray(), acyclic);
}

// Whether every member the given member depends on has already been placed.
dependenciesPlaced(WorkspaceMember member, Set<string> names, Set<string> placed) -> bool {
    for (let dependency in member.dependencies()) {
        if (names.contains(dependency) && !placed.contains(dependency)) {
            return false;
        }
    }
    return true;
}

// The Ens version a workspace's members agree on, or the disagreement to report.
export final class VersionAgreement {
    string agreed;
    string problem;

    protected constructor(this.agreed, this.problem);

    // The version every member declares, or empty text when none of them declares one.
    export version() -> string {
        return this.agreed;
    }

    export failure() -> string {
        return this.problem;
    }
}

// The version the members agree on. A workspace is built by one toolchain, so its members must
// agree on the Ens version they are written for; a member that declares none is left out of the
// comparison, because a missing declaration is already reported against that member's manifest.
export versionAgreement(WorkspaceMember[] members) -> VersionAgreement {
    string agreed = "";
    string agreedBy = "";
    for (long i = 0; i < members.length; i++) {
        string declared = members[i].ensVersion();
        if (declared.length == 0) {
            continue;
        }
        if (agreed.length == 0) {
            agreed = declared;
            agreedBy = members[i].packageName();
            continue;
        }
        if (declared != agreed) {
            return new VersionAgreement("", "the members of this workspace are written for "
                + "different versions of Ens: '{agreedBy}' declares '{agreed}' and "
                + "'{members[i].packageName()}' declares '{declared}'. One workspace is built by "
                + "one toolchain, so make every member declare the same 'ens' version");
        }
    }
    return new VersionAgreement(agreed, "");
}

resolveFolder(FileLoader loader, Path folder) -> TargetResolution {
    let survey = workspace.surveyManifest(loader, folder);
    if (survey == null) {
        return new TargetResolution(new BuildTarget(TargetKind.Folder, folder, folder, Path(""), "",
            folderStem(folder), "", noMembers(), "", buildRootAbove(loader, folder)), "");
    }
    if (survey.isWorkspace()) {
        return resolveWorkspace(loader, folder, survey);
    }
    Path source = folder;
    Path tests = Path("");
    if (folder.join("src").isDirectory()) {
        source = folder.join("src");
        if (folder.join("tests").isDirectory()) {
            tests = folder.join("tests");
        }
    }
    string declared = survey.packageName();
    string name = folderStem(folder);
    if (declared.length > 0) {
        name = artifactStem(declared);
    }
    FileDiagnostic[] problems = survey.diagnostics();
    if (problems.length > 0) {
        return failedInManifests(loader, problems,
            "{name}: {report.problemCount(problems.length)} in its ens.package");
    }
    let kind = TargetKind.Folder;
    if (survey.isPackage()) {
        kind = TargetKind.Package;
    }
    return new TargetResolution(new BuildTarget(kind, folder, source, tests, "", name, declared,
        noMembers(), survey.ensVersion(), folder), "");
}

// The build root above `folder` for sources with no manifest directly beside them: the nearest folder
// above them that holds one, which is the folder that governs them, and the folder itself when
// nothing above it does.
buildRootAbove(FileLoader loader, Path folder) -> Path {
    Path? governing = workspace.discoverRoot(loader, folder);
    if (governing == null) {
        return folder;
    }
    return governing;
}

resolveWorkspace(FileLoader loader, Path folder, ManifestSurvey survey) -> TargetResolution {
    string name = folderStem(folder);
    FileDiagnostic[] problems = survey.diagnostics();
    if (problems.length > 0) {
        return failedInManifests(loader, problems, "{name}: {report.problemCount(problems.length)} "
            + "in its ens.package, so none of its members was read");
    }
    let members = new List<WorkspaceMember>();
    let memberProblems = new List<FileDiagnostic>();
    long troubledMembers = 0;
    for (let listed in survey.members()) {
        Path memberFolder = folder.join(listed).normalize();
        let memberSurvey = workspace.surveyManifest(loader, memberFolder);
        if (memberSurvey == null) {
            return failed("the workspace at '{folder}' lists the member '{listed}', but "
                + "'{listed}' has no ens.package manifest. Add one that declares the member's "
                + "package, or remove the member from the workspace");
        }
        if (memberSurvey.diagnostics().length > 0 && !memberSurvey.declaresNothing()) {
            for (let problem in memberSurvey.diagnostics()) {
                memberProblems.push(problem);
            }
            troubledMembers++;
            continue;
        }
        if (!memberSurvey.isPackage()) {
            return failed("the workspace at '{folder}' lists the member '{listed}', but its "
                + "ens.package declares no package. Declare one there, as in "
                + "'package acme.lib \{ ... \}', or remove the member");
        }
        members.push(new WorkspaceMember(memberSurvey.packageName(), memberFolder,
            memberSurvey.dependencies(), memberSurvey.ensVersion()));
    }
    if (troubledMembers > 0) {
        string where = "a member's ens.package";
        if (troubledMembers > 1) {
            where = "{troubledMembers} members' ens.package files";
        }
        return failedInManifests(loader, memberProblems.toArray(),
            "{name}: {report.problemCount(memberProblems.length())} in {where}, so none of its "
            + "members was read");
    }
    WorkspaceMember[] listed = members.toArray();
    let agreement = versionAgreement(listed);
    if (agreement.failure().length > 0) {
        return failed(agreement.failure());
    }
    return new TargetResolution(new BuildTarget(TargetKind.Workspace, folder, folder, Path(""), "",
        name, "", listed, agreement.version(), folder), "");
}

failed(string problem) -> TargetResolution {
    return new TargetResolution(null, problem);
}

// A target whose manifests have problems, which stop the command before any source is read.
failedInManifests(FileLoader loader, FileDiagnostic[] problems, string summary) -> TargetResolution {
    return new TargetResolution(null, summary,
        diagnostics.formatAll(problems, new SourceCatalog(loader)));
}

noMembers() -> WorkspaceMember[] {
    WorkspaceMember[] none = [];
    return none;
}

// The name of the folder itself, which is what a folder with no package name is called.
folderStem(Path folder) -> string {
    string name = folder.normalize().fileName();
    if (name.length == 0 || name == "." || name == "..") {
        return "program";
    }
    return name;
}

// What an artifact of the named package is called: "acme.tools" builds "tools", the last segment
// being the part a user recognizes.
export artifactStem(string packageName) -> string {
    string[] parts = packageName.split(".");
    if (parts.length == 0) {
        return packageName;
    }
    return parts[parts.length - 1];
}
