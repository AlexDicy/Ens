// 'ens toolchain list' and 'ens toolchain remove'. A removal moves the version's folder out of the
// toolchains folder before deleting it, so one that stops part-way leaves no partial toolchain.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Environment from @std.environment;
import @std.environment;
import List from @std.collections.list;
import @ens.host.scratch;
import Version from @ens.language.version;
import InstalledToolchain from toolchain;
import InstalledToolchains from toolchain;
import toolchain;
import Reporter from report;

export list(Environment environment, Reporter reporter) -> int {
    let installed = toolchain.discover(toolchain.root(environment), environment.platform());
    if (installed.root() == null) {
        reporter.problem("there is no toolchains folder to list: "
            + toolchain.noFolderReason(installed) + ". Set 'ENS_TOOLCHAINS' to the folder your "
            + "toolchains are in");
        return 1;
    }
    Path? running = runningProgram();
    for (let line in listing(installed, runningName(installed, running), Version.release,
            running)) {
        reporter.note(line);
    }
    return 0;
}

// `runningName` is the installed toolchain running the command, or null when it runs from outside
// the toolchains folder, as the program `running`, which is Ens `runningVersion`.
export listing(InstalledToolchains installed, string? runningName, string runningVersion,
               Path? running) -> string[] {
    let lines = new List<string>();
    InstalledToolchain[] ordered = installed.byNewest();
    if (ordered.length == 0) {
        lines.push(toolchain.foundInstead(installed));
    } else {
        lines.push("Installed in '{installed.root()}':");
        for (let one in ordered) {
            if (runningName != null && one.version() == runningName) {
                lines.push("  {one.version()} (this toolchain)");
            } else {
                lines.push("  {one.version()}");
            }
        }
    }
    if (runningName == null && running != null) {
        lines.push("This toolchain is Ens {runningVersion}, at '{running}'");
    }
    return lines.toArray();
}

// Never removes the toolchain running this command.
export remove(Environment environment, string version, Reporter reporter) -> int {
    let installed = toolchain.discover(toolchain.root(environment), environment.platform());
    Path? root = installed.root();
    if (root == null) {
        reporter.problem("there is no toolchains folder to remove Ens {version} from: "
            + toolchain.noFolderReason(installed) + ". Set 'ENS_TOOLCHAINS' to the folder your "
            + "toolchains are in");
        return 1;
    }
    string refused = removalProblem(installed, version, runningName(installed, runningProgram()));
    if (refused.length > 0) {
        reporter.problem(refused);
        return 2;
    }
    Path? program = installed.programOf(version);
    Path? folder = null;
    if (program != null) {
        folder = program.parent();
    }
    if (folder == null) {
        reporter.problem("Internal: the installed toolchain '{version}' has no folder");
        return 1;
    }

    let staging = scratch.createMarkedUnder(root.join(".staging"), "remove");
    if (staging.failure().length > 0) {
        reporter.problem("Ens {version} was not removed: {staging.failure()}");
        return 1;
    }
    FileSystemError? stopped = movedAside(folder, staging.folder().join(version));
    string leftBehind = staging.remove();
    if (stopped != null) {
        reporter.problem("Ens {version} was not removed: '{folder}' could not be moved out of "
            + "'{root}': {stopped.reason}");
        return 1;
    }
    reporter.note("Removed Ens {version} from '{folder}'");
    if (leftBehind.length > 0) {
        reporter.note("Some of its files are still on disk: {leftBehind}. The next "
            + "'ens toolchain remove' deletes them");
    }
    return 0;
}

// Empty when the toolchain can be removed. `runningName` is as in 'listing'.
export removalProblem(InstalledToolchains installed, string version,
                      string? runningName) -> string {
    Path? program = installed.programOf(version);
    if (program == null) {
        return "Ens {version} is not installed: " + toolchain.foundInstead(installed);
    }
    if (runningName == null || runningName != version) {
        return "";
    }
    string cannot = "Ens {version} is the toolchain running this command, from '{program}', so "
        + "it cannot remove itself";
    for (let other in installed.byNewest()) {
        if (other.version() != version) {
            return cannot + ". Run the 'ens' of another version to remove it, as in "
                + "'{other.program()} toolchain remove {version}'";
        }
    }
    Path? folder = program.parent();
    if (folder == null) {
        return cannot;
    }
    return cannot + ". Delete the folder '{folder}' to remove it";
}

runningName(InstalledToolchains installed, Path? running) -> string? {
    if (running == null) {
        return null;
    }
    for (let one in installed.byNewest()) {
        if (samePlace(one.program(), running)) {
            return one.version();
        }
    }
    return null;
}

// With symbolic links resolved, or null when the system does not report it.
runningProgram() -> Path? {
    Path? reported = environment.executablePath();
    if (reported == null) {
        return null;
    }
    return try reported.realPath();
} catch (FileSystemError unresolved) {
    return environment.executablePath();
}

samePlace(Path program, Path running) -> bool {
    return try program.realPath() == running;
} catch (FileSystemError unresolved) {
    return false;
}

movedAside(Path folder, Path destination) -> FileSystemError? {
    let moved = try folder.moveTo(destination);
    return null;
} catch (FileSystemError refused) {
    return refused;
}
