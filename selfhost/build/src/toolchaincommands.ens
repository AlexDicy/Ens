// 'ens toolchain list' and 'ens toolchain remove'. A removal moves the version's folder out of the
// toolchains folder before deleting it, so one that stops part-way leaves no partial toolchain.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import Environment from @std.environment;
import @std.environment;
import List from @std.collections.list;
import @ens.host.scratch;
import Version from @ens.language.version;
import Release from releases;
import releases;
import releasesource;
import platform;
import InstalledToolchain from toolchain;
import InstalledToolchains from toolchain;
import toolchain;
import Reporter from report;
import RequestKind from toolchaininstall;
import toolchaininstall;
import @ens.packages.versions;

// With `available`, the releases the release source lists are printed instead.
export list(Environment environment, bool available, Reporter reporter) -> int {
    let installed = toolchain.discover(toolchain.root(environment), environment.platform());
    Path? root = installed.root();
    if (root == null) {
        reporter.problem("there is no toolchains folder to list: "
            + toolchain.noFolderReason(installed) + ". Set 'ENS_TOOLCHAINS' to the folder your "
            + "toolchains are in");
        return 1;
    }
    if (!available) {
        Path? running = runningProgram();
        for (let line in listing(installed, runningName(installed, running), Version.release,
                running)) {
            reporter.note(line);
        }
        return 0;
    }
    let source = releasesource.sourceFor(environment);
    if (source.failure().length > 0) {
        reporter.problem(source.failure());
        return 2;
    }
    let staging = scratch.createMarkedUnder(root.join(".staging"), "list");
    if (staging.failure().length > 0) {
        reporter.problem("the releases at '{source.url()}' could not be listed: "
            + staging.failure());
        return 1;
    }
    let fetched = releasesource.fetch(source, staging.folder(), reporter);
    string leftBehind = staging.remove();
    if (leftBehind.length > 0) {
        reporter.note(leftBehind);
    }
    if (fetched.failure().length > 0) {
        reporter.problem(fetched.failure());
        return 1;
    }
    for (let line in availableListing(releases.newestPerLanguage(fetched.releases(),
            platform.hostAssetName()), installed, Version.release, source.url(),
            platform.hostName())) {
        reporter.note(line);
    }
    return 0;
}

// `newest` holds one release per language version, newest first.
export availableListing(Release[] newest, InstalledToolchains installed, string runningVersion,
                        string url, string host) -> string[] {
    if (newest.length == 0) {
        string[] none = ["No release at '{url}' has a program for {host}"];
        return none;
    }
    let lines = new List<string>();
    lines.push("Available from '{url}' for {host}:");
    for (let release in newest) {
        let marks = new List<string>();
        if (installed.programOf(release.folderName()) != null) {
            marks.push("installed");
        }
        if (sameRelease(release.version(), runningVersion)) {
            marks.push("this version");
        }
        lines.push("  {release.folderName()}" + marked(marks.toArray()));
    }
    return lines.toArray();
}

// `runningName` is the installed toolchain running the command, or null when it runs from outside
// the toolchains folder, as the program `running`, which is Ens `runningVersion`. That program is
// named only when no installed toolchain is its release.
export listing(InstalledToolchains installed, string? runningName, string runningVersion,
               Path? running) -> string[] {
    let lines = new List<string>();
    InstalledToolchain[] ordered = installed.byNewest();
    if (ordered.length == 0) {
        lines.push(toolchain.foundInstead(installed));
    } else {
        lines.push("Installed in '{installed.root()}':");
        for (let one in ordered) {
            if (runningName != null && one.version() == runningName) {
                lines.push("  {one.version()} (this toolchain)");
            } else if (runningName == null && sameRelease(one.version(), runningVersion)) {
                lines.push("  {one.version()} (this version)");
            } else {
                lines.push("  {one.version()}");
            }
        }
    }
    if (runningName == null && running != null && !holdsRelease(ordered, runningVersion)) {
        lines.push("This toolchain is Ens {runningVersion}, at '{running}'");
    }
    return lines.toArray();
}

holdsRelease(InstalledToolchain[] toolchains, string version) -> bool {
    for (let one in toolchains) {
        if (sameRelease(one.version(), version)) {
            return true;
        }
    }
    return false;
}

// The label after a release's numbers, such as '-beta', does not count.
sameRelease(string left, string right) -> bool {
    let leftVersion = versions.release(left);
    let rightVersion = versions.release(right);
    return leftVersion != null && rightVersion != null
        && versions.compare(leftVersion, rightVersion) == 0;
}

// As in ' (installed, this version)', or empty when there are no marks.
marked(string[] marks) -> string {
    if (marks.length == 0) {
        return "";
    }
    string joined = marks[0];
    for (long i = 1; i < marks.length; i++) {
        joined = joined + ", " + marks[i];
    }
    return " (" + joined + ")";
}

// With `force`, an installed release is downloaded again and replaces the installed copy.
export install(Environment environment, string request, bool force, Reporter reporter) -> int {
    let kind = toolchaininstall.kindOf(request);
    if (kind == RequestKind.Unrecognized) {
        reporter.problem(toolchaininstall.unrecognized(request));
        return 2;
    }
    let installed = toolchain.discover(toolchain.root(environment), environment.platform());
    Path? root = installed.root();
    if (root == null) {
        reporter.problem("there is no toolchains folder to install Ens {request} in: "
            + toolchain.noFolderReason(installed) + ". Set 'ENS_TOOLCHAINS' to the folder your "
            + "toolchains are in");
        return 1;
    }
    if (kind == RequestKind.Release && !force) {
        string version = withoutLabel(request);
        Path? program = installed.programOf(version);
        if (program != null) {
            reporter.note("Ens {version} is already installed in '{root.join(version)}'");
            return 0;
        }
    }
    let obtained = toolchaininstall.obtain(environment, root, request, force, "", reporter);
    if (obtained.leftovers().length > 0) {
        reporter.note(obtained.leftovers());
    }
    Path? program = obtained.program();
    if (program == null) {
        reporter.problem(obtained.failure());
        return 1;
    }
    Path folder = program.parent() ?? root;
    string version = folder.fileName();
    if (!obtained.wasDownloaded()) {
        reporter.note("Ens {version} is already installed in '{folder}'");
    } else if (obtained.replaced()) {
        reporter.note("Reinstalled Ens {version} in '{folder}'");
    } else {
        reporter.note("Installed Ens {version} in '{folder}'");
    }
    return 0;
}

// '0.14.2' for '0.14.2-beta'.
withoutLabel(string release) -> string {
    long label = release.indexOf("-");
    if (label < 0) {
        return release;
    }
    return release.substring(0, label);
}

// Never removes the toolchain running this command.
export remove(Environment environment, string version, Reporter reporter) -> int {
    let installed = toolchain.discover(toolchain.root(environment), environment.platform());
    Path? root = installed.root();
    if (root == null) {
        reporter.problem("there is no toolchains folder to remove Ens {version} from: "
            + toolchain.noFolderReason(installed) + ". Set 'ENS_TOOLCHAINS' to the folder your "
            + "toolchains are in");
        return 1;
    }
    string refused = removalProblem(installed, version, runningName(installed, runningProgram()));
    if (refused.length > 0) {
        reporter.problem(refused);
        return 2;
    }
    Path? program = installed.programOf(version);
    Path? folder = null;
    if (program != null) {
        folder = program.parent();
    }
    if (folder == null) {
        reporter.problem("Internal: the installed toolchain '{version}' has no folder");
        return 1;
    }

    let staging = scratch.createMarkedUnder(root.join(".staging"), "remove");
    if (staging.failure().length > 0) {
        reporter.problem("Ens {version} was not removed: {staging.failure()}");
        return 1;
    }
    FileSystemError? stopped = movedAside(folder, staging.folder().join(version));
    string leftBehind = staging.remove();
    if (stopped != null) {
        reporter.problem("Ens {version} was not removed: '{folder}' could not be moved out of "
            + "'{root}': {stopped.reason}");
        return 1;
    }
    reporter.note("Removed Ens {version} from '{folder}'");
    if (leftBehind.length > 0) {
        reporter.note("Some of its files are still on disk: {leftBehind}. The next "
            + "'ens toolchain remove' deletes them");
    }
    return 0;
}

// Empty when the toolchain can be removed. `runningName` is as in 'listing'.
export removalProblem(InstalledToolchains installed, string version,
                      string? runningName) -> string {
    Path? program = installed.programOf(version);
    if (program == null) {
        return "Ens {version} is not installed: " + toolchain.foundInstead(installed);
    }
    if (runningName == null || runningName != version) {
        return "";
    }
    string cannot = "Ens {version} is the toolchain running this command, from '{program}', so "
        + "it cannot remove itself";
    for (let other in installed.byNewest()) {
        if (other.version() != version) {
            return cannot + ". Run the 'ens' of another version to remove it, as in "
                + "'{other.program()} toolchain remove {version}'";
        }
    }
    Path? folder = program.parent();
    if (folder == null) {
        return cannot;
    }
    return cannot + ". Delete the folder '{folder}' to remove it";
}

runningName(InstalledToolchains installed, Path? running) -> string? {
    if (running == null) {
        return null;
    }
    for (let one in installed.byNewest()) {
        if (samePlace(one.program(), running)) {
            return one.version();
        }
    }
    return null;
}

// With symbolic links resolved, or null when the system does not report it.
runningProgram() -> Path? {
    Path? reported = environment.executablePath();
    if (reported == null) {
        return null;
    }
    return try reported.realPath();
} catch (FileSystemError unresolved) {
    return environment.executablePath();
}

samePlace(Path program, Path running) -> bool {
    return try program.realPath() == running;
} catch (FileSystemError unresolved) {
    return false;
}

movedAside(Path folder, Path destination) -> FileSystemError? {
    let moved = try folder.moveTo(destination);
    return null;
} catch (FileSystemError refused) {
    return refused;
}
