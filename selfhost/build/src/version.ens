// The version of the toolchain this executable is. 'toolchain' is the language version the compiler
// in this binary implements, which is what a package's 'ens' declaration names, so a build root
// declaring the same version is one this toolchain is written for. 'release' is the published
// release this binary is, which the release workflow writes before it builds.

export final class Version {
    export static const string toolchain = "0.1";

    export static const string release = "0.9.6-beta";
}
