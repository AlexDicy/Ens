// From the module graph's native declarations to what a link step passes on, which platform's
// bindings apply being all this determines. Fetching and checking a prebuilt file happens elsewhere,
// so the mapping is a function of the manifests and the platform, answerable without a network.
import NativeInfo from @ens.sema.program.workspace;
import List from @std.collections.list;

// A prebuilt library one package binds on the platform being built for.
export final class ArtifactBinding {
    string libraryName;
    string sourceUrl;
    string declaredDigest;

    protected constructor(this.libraryName, this.sourceUrl, this.declaredDigest);

    // The native library the binding belongs to, which is what a reader of a problem recognizes.
    export library() -> string {
        return this.libraryName;
    }

    export url() -> string {
        return this.sourceUrl;
    }

    export checksum() -> string {
        return this.declaredDigest;
    }
}

// What to link, or the reason the mapping stopped.
export final class LibraryPlan {
    string[] planLibraries;
    ArtifactBinding[] planArtifacts;
    string problem;

    protected constructor(this.planLibraries, this.planArtifacts, this.problem);

    // Logical library names, the way a manifest's native declaration names them; the link spells
    // each one the way the target platform spells a library name.
    export libraries() -> string[] {
        return this.planLibraries;
    }

    // The prebuilt libraries the link needs the files of, one per binding, each listed once.
    export artifacts() -> ArtifactBinding[] {
        return this.planArtifacts;
    }

    export failure() -> string {
        return this.problem;
    }
}

export librariesFor(NativeInfo[] natives, string platform) -> LibraryPlan {
    let libraries = new List<string>();
    let artifacts = new List<ArtifactBinding>();
    for (let native in natives) {
        if (native.isSystem()) {
            continue;
        }
        if (!native.hasBindingBlock()) {
            append(libraries, native.name());
            continue;
        }
        for (let binding in native.bindings()) {
            if (binding.platform() != platform) {
                continue;
            }
            if (binding.isArtifact()) {
                appendArtifact(artifacts, new ArtifactBinding(native.name(), binding.url(),
                    binding.checksum()));
                continue;
            }
            for (let baseName in binding.baseNames()) {
                append(libraries, baseName);
            }
        }
    }
    return new LibraryPlan(libraries.toArray(), artifacts.toArray(), "");
}

// Why a macOS program cannot be linked when no macOS SDK was found and a native library names a
// framework, which only an SDK provides; empty when no library names one. `unusableRoot` is what
// SDKROOT named when that was not a folder, and `onMac` whether this machine is a Mac.
export frameworkWithoutSdk(NativeInfo[] natives, string unusableRoot, bool onMac) -> string {
    for (let native in natives) {
        if (native.isSystem() || !native.hasBindingBlock()) {
            continue;
        }
        for (let binding in native.bindings()) {
            if (binding.platform() != "macos" || binding.isArtifact()) {
                continue;
            }
            for (let baseName in binding.baseNames()) {
                if (baseName.endsWith(".framework") && baseName != ".framework") {
                    return noSdkMessage(native.name(), baseName, unusableRoot, onMac);
                }
            }
        }
    }
    return "";
}

noSdkMessage(string native, string framework, string unusableRoot, bool onMac) -> string {
    string opening = "native library '{native}' links the framework '{framework}' from the macOS "
        + "SDK, the files Xcode installs to describe what macOS provides";
    if (!onMac) {
        return "{opening}, and an SDK is installed only on a Mac. To build it here, write a "
            + "'macos artifact' line in the 'native {native}' block that names the framework's "
            + "'.tbd' file, the text file in the SDK that lists what the framework provides";
    }
    if (unusableRoot.length > 0) {
        return "{opening}, and 'SDKROOT' names '{unusableRoot}', which is not a folder. Set "
            + "'SDKROOT' to the SDK's folder, or unset it to use the SDK Xcode selects";
    }
    return "{opening}, and 'xcrun --show-sdk-path' finds none. Install one with "
        + "'xcode-select --install'";
}

append(List<string> libraries, string name) {
    for (long i = 0; i < libraries.length(); i++) {
        if (libraries.get(i) == name) {
            return;
        }
    }
    libraries.push(name);
}

appendArtifact(List<ArtifactBinding> artifacts, ArtifactBinding binding) {
    for (long i = 0; i < artifacts.length(); i++) {
        if (artifacts.get(i).library() == binding.library() && artifacts.get(i).url() == binding.url()) {
            return;
        }
    }
    artifacts.push(binding);
}
