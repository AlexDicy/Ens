// From the module graph's native declarations to the libraries a link step passes on: a library
// marked 'system' is linked by platform defaults and named nowhere, a declaration with no binding
// block links under its own name, and a binding block contributes the base names it gives the
// platform being built for.
import NativeInfo from @ens.sema.program.workspace;
import List from @std.collections.list;

// The libraries to link, or the reason the mapping stopped.
export final class LibraryPlan {
    string[] planLibraries;
    string problem;

    protected constructor(this.planLibraries, this.problem);

    // Logical library names, the way a manifest's native declaration names them; the link spells
    // each one the way the target platform spells a library name.
    export libraries() -> string[] {
        return this.planLibraries;
    }

    export failure() -> string {
        return this.problem;
    }
}

export librariesFor(NativeInfo[] natives, string platform) -> LibraryPlan {
    let libraries = new List<string>();
    for (let native in natives) {
        if (native.isSystem()) {
            continue;
        }
        if (!native.hasBindingBlock()) {
            append(libraries, native.name());
            continue;
        }
        for (let binding in native.bindings()) {
            if (binding.platform() != platform) {
                continue;
            }
            if (binding.isArtifact()) {
                string[] none = [];
                return new LibraryPlan(none, "the native library '{native.name()}' binds a "
                    + "fetched artifact on {platform}, and fetching artifacts is not supported "
                    + "yet; bind the library by name instead, so the linker finds it on the "
                    + "library path");
            }
            for (let baseName in binding.baseNames()) {
                append(libraries, baseName);
            }
        }
    }
    return new LibraryPlan(libraries.toArray(), "");
}

append(List<string> libraries, string name) {
    for (long i = 0; i < libraries.length(); i++) {
        if (libraries.get(i) == name) {
            return;
        }
    }
    libraries.push(name);
}
