// From the module graph's native declarations to what a link step passes on: a library marked
// 'system' is linked by platform defaults and named nowhere, a declaration with no binding block
// links under its own name, and a binding block contributes what it gives the platform being built
// for - either the base names the linker looks for, or a prebuilt file to link outright.
//
// Which platform's bindings apply is all this decides. A prebuilt file has to be fetched and checked
// before a link can name it, and that is somewhere else: the mapping stays a function of the
// manifests and the platform, so what a build would link is answerable without a network.
import NativeInfo from @ens.sema.program.workspace;
import List from @std.collections.list;

// A prebuilt library one package binds on the platform being built for.
export final class ArtifactBinding {
    string libraryName;
    string sourceUrl;
    string declaredDigest;

    protected constructor(this.libraryName, this.sourceUrl, this.declaredDigest);

    // The native library the binding belongs to, which is what a reader of a problem recognizes.
    export library() -> string {
        return this.libraryName;
    }

    export url() -> string {
        return this.sourceUrl;
    }

    export checksum() -> string {
        return this.declaredDigest;
    }
}

// What to link, or the reason the mapping stopped.
export final class LibraryPlan {
    string[] planLibraries;
    ArtifactBinding[] planArtifacts;
    string problem;

    protected constructor(this.planLibraries, this.planArtifacts, this.problem);

    // Logical library names, the way a manifest's native declaration names them; the link spells
    // each one the way the target platform spells a library name.
    export libraries() -> string[] {
        return this.planLibraries;
    }

    // The prebuilt libraries the link needs the files of, one per binding, each listed once.
    export artifacts() -> ArtifactBinding[] {
        return this.planArtifacts;
    }

    export failure() -> string {
        return this.problem;
    }
}

export librariesFor(NativeInfo[] natives, string platform) -> LibraryPlan {
    let libraries = new List<string>();
    let artifacts = new List<ArtifactBinding>();
    for (let native in natives) {
        if (native.isSystem()) {
            continue;
        }
        if (!native.hasBindingBlock()) {
            append(libraries, native.name());
            continue;
        }
        for (let binding in native.bindings()) {
            if (binding.platform() != platform) {
                continue;
            }
            if (binding.isArtifact()) {
                appendArtifact(artifacts, new ArtifactBinding(native.name(), binding.url(),
                    binding.checksum()));
                continue;
            }
            for (let baseName in binding.baseNames()) {
                append(libraries, baseName);
            }
        }
    }
    return new LibraryPlan(libraries.toArray(), artifacts.toArray(), "");
}

append(List<string> libraries, string name) {
    for (long i = 0; i < libraries.length(); i++) {
        if (libraries.get(i) == name) {
            return;
        }
    }
    libraries.push(name);
}

appendArtifact(List<ArtifactBinding> artifacts, ArtifactBinding binding) {
    for (long i = 0; i < artifacts.length(); i++) {
        if (artifacts.get(i).library() == binding.library()
                && artifacts.get(i).url() == binding.url()) {
            return;
        }
    }
    artifacts.push(binding);
}
