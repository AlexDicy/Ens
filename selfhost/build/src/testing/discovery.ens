// Finding the tests a run will run, and deciding whether there is a run at all. Every
// '*_test.ens' file under one folder is read, the tests each of them declares are collected in the
// order they are written, and a filter narrows them to the ones asked for.
//
// Discovery reads files and answers with a value. Nothing outside it is changed, so the same folder
// discovered twice gives the same answer and two folders could be discovered at the same time. The
// answer also carries what to say when there is nothing to run and what was written wrong when the
// command line cannot be acted on, so the caller decides only where those go.
import @std.path;
import @std.text.strings;
import List from @std.collections.list;
import Map from @std.collections.map;
import Source from @ens.frontend.support.source;
import @ens.frontend.parse.parser;
import @ens.frontend.syntax.generated.factory;
import SourceFileNode from @ens.frontend.syntax.generated.nodes;
import FunctionDeclarationNode from @ens.frontend.syntax.generated.nodes;
import TestDeclarationNode from @ens.frontend.syntax.generated.nodes;
import FileLoader from @ens.sema.support.loader;
import FileError from @ens.sema.support.loader;
import @ens.sema.model.literalvalues;
import sources;

// One test the runner will run.
export final class DiscoveredTest {
    string testModule;
    string testFile;
    long testIndex;
    string testLiteral;
    string testDescription;

    protected constructor(this.testModule, this.testFile, this.testIndex, this.testLiteral,
                this.testDescription);

    // The module the test is declared in, as an import writes it: "lex.lexer_test".
    export modulePath() -> string {
        return this.testModule;
    }

    // The file the test is written in, relative to the folder the tests were discovered under.
    export file() -> string {
        return this.testFile;
    }

    // Where the test comes among the tests its own module declares, which is what names the
    // function the compiler gave it.
    export index() -> long {
        return this.testIndex;
    }

    // The description exactly as it was written, quotes and escapes included, so splicing it into
    // generated source needs no escaping of its own.
    export literal() -> string {
        return this.testLiteral;
    }

    // The description as a reader sees it, which is what a filter matches against.
    export description() -> string {
        return this.testDescription;
    }
}

// What a test run will do, settled before anything is compiled: which files hold the tests, which
// tests were asked for, and - when there is no run - whether that is a mistake to report or simply
// nothing to do.
export final class TestPlan {
    string[] discoveredFiles;
    DiscoveredTest[] chosen;
    long discovered;
    string usage;
    string nothing;

    protected constructor(this.discoveredFiles, this.chosen, this.discovered, this.usage, this.nothing);

    // The test files, relative to the folder they were discovered under, in path order.
    export testFiles() -> string[] {
        return this.discoveredFiles;
    }

    // The tests to run, in the order they will run: by file, then as they are written.
    export tests() -> DiscoveredTest[] {
        return this.chosen;
    }

    // How many tests the files declare, whatever the filter kept.
    export discoveredCount() -> long {
        return this.discovered;
    }

    // What the command line got wrong, or empty text when it can be acted on.
    export usageProblem() -> string {
        return this.usage;
    }

    // Why there is nothing to run, or empty text when there is.
    export nothingToRun() -> string {
        return this.nothing;
    }

    export runnable() -> bool {
        return this.chosen.length > 0;
    }
}

// Discovers the tests under `discoveryRoot`, keeping the ones whose description contains `filter`.
// An empty filter keeps them all.
export plan(FileLoader loader, string discoveryRoot, string filter) -> TestPlan {
    let scanned = sources.scanTests(discoveryRoot);
    if (scanned.failure().length > 0) {
        return refused(scanned.failure());
    }
    string[] files = scanned.files();
    if (files.length == 0) {
        return idle(files, 0, "there are no tests in '{discoveryRoot}': a file holding tests is "
            + "named with a '_test.ens' ending, such as 'greeting_test.ens'");
    }
    string collision = duplicateStem(files);
    if (collision.length > 0) {
        return refused(collision);
    }

    let found = new List<DiscoveredTest>();
    for (let relativePath in files) {
        string problem = read(loader, discoveryRoot, relativePath, found);
        if (problem.length > 0) {
            return refused(problem);
        }
    }
    if (found.length() == 0) {
        return idle(files, 0, "the test files in '{discoveryRoot}' declare no tests; a test is "
            + "written as 'test \"what it checks\" \{ ... \}'");
    }
    return selected(files, found.toArray(), filter, discoveryRoot);
}

// The tests the filter keeps. A filter that matches nothing is not a failure: it is an answer, and
// the run says so rather than passing an empty suite off as a success.
selected(string[] files, DiscoveredTest[] found, string filter, string discoveryRoot) -> TestPlan {
    if (filter.length == 0) {
        return new TestPlan(files, found, found.length, "", "");
    }
    let kept = new List<DiscoveredTest>();
    for (let one in found) {
        if (one.description().indexOf(filter) >= 0) {
            kept.push(one);
        }
    }
    if (kept.length() == 0) {
        return idle(files, found.length, "no test under '{discoveryRoot}' has '{filter}' in its "
            + "description, so there is nothing to run; " + counted(found.length)
            + " there in all");
    }
    return new TestPlan(files, kept.toArray(), found.length, "", "");
}

// Reads one test file and appends the tests it declares in the order they are written.
read(FileLoader loader, string discoveryRoot, string relativePath, List<DiscoveredTest> found) -> string {
    string file = path.join(discoveryRoot, relativePath);
    let parsed = parser.parse(new Source(file, try loader.readText(file)));
    let root = factory.createRoot(parsed.root());
    if (!(root is SourceFileNode)) {
        return "";
    }
    string modulePath = modulePathOf(relativePath);
    long index = 0;
    for (long i = 0; i < root.itemsCount(); i++) {
        switch (root.items(i)) {
            is FunctionDeclarationNode declaration -> {
                let name = declaration.name();
                if (name != null && name.text() == "main") {
                    return "'{relativePath}' defines main(), and a test run builds its own entry "
                        + "point around the tests, so there would be two; move main() into a file "
                        + "that is not a test file";
                }
            },
            is TestDeclarationNode declaration -> {
                string literal = "\"\"";
                let token = declaration.descriptionToken();
                if (token != null) {
                    literal = token.text();
                }
                found.push(new DiscoveredTest(modulePath, relativePath, index, literal,
                    literalvalues.decodeString(literal)));
                index++;
            },
            default -> { },
        }
    }
    return "";
} catch (FileError error) {
    return "'{relativePath}' could not be read: {error.message}";
}

// Two test files with the same name would be imported under the same module path, so the runner
// could reach only one of them.
duplicateStem(string[] files) -> string {
    let seen = new Map<string, string>();
    for (let relativePath in files) {
        string stem = stemOf(relativePath);
        let existing = seen.get(stem);
        if (existing != null) {
            return "'{existing}' and '{relativePath}' are both named '{stem}', and a test run "
                + "imports every test file by its name, so it could reach only one of them; give "
                + "one of the two a name of its own";
        }
        seen.set(stem, relativePath);
    }
    return "";
}

stemOf(string relativePath) -> string {
    string name = path.fileName(relativePath);
    if (name.endsWith(".ens")) {
        return name.substring(0, name.length - 4);
    }
    return name;
}

// "lex/lexer_test.ens" -> "lex.lexer_test", the module path an import of that file writes.
export modulePathOf(string relativePath) -> string {
    string bare = relativePath;
    if (bare.endsWith(".ens")) {
        bare = bare.substring(0, bare.length - 4);
    }
    return strings.joined(strings.split(bare, "/"), ".");
}

// "7 tests are" or "1 test is", so a count reads as English inside a sentence.
counted(long count) -> string {
    if (count == 1) {
        return "1 test is";
    }
    return "{count} tests are";
}

refused(string problem) -> TestPlan {
    string[] noFiles = [];
    return new TestPlan(noFiles, noTests(), 0, problem, "");
}

idle(string[] files, long discovered, string reason) -> TestPlan {
    return new TestPlan(files, noTests(), discovered, "", reason);
}

noTests() -> DiscoveredTest[] {
    DiscoveredTest[] none = [];
    return none;
}
