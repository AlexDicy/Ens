// The program a test run actually runs. It is ordinary Ens, written out of what discovery found:
// one import per test module, one function per test that says what happened and answers whether it
// passed, and a main() that runs them in order and counts what came back.
//
// A description is spliced in as the literal it was written as, so nothing needs escaping again. A
// failure prints the frames of the throw behind it and stops at the runner's own file, whose frames
// say nothing about the test. Each result is printed and handed over the moment the test producing it
// finishes, so whoever is reading this program's output sees it while the suite is still going and a
// run that stops partway has already given up everything it said.
import StringBuilder from @std.text.stringbuilder;
import FileLoader from @ens.sema.support.loader;
import FileError from @ens.sema.support.loader;
import DiscoveredTest from testing.discovery;

// The file the runner is compiled as. It is not a file on disk: it enters the module graph over the
// tree the tests were read from, which is why its name is one no source file can have.
export fileName() -> string {
    return "$ens_test_runner.ens";
}

export modulePath() -> string {
    return "$ens_test_runner";
}

// The runner for these tests, in the order they are given.
export source(DiscoveredTest[] tests) -> string {
    let out = new StringBuilder();
    appendImports(out, tests);
    for (long i = 0; i < tests.length; i++) {
        appendTest(out, tests[i], i);
    }
    appendEntry(out, tests.length);
    return out.toString();
}

// One import per module, written once however many of its tests are running, over the one import the
// runner itself needs: a result is handed over as it happens rather than when a buffer fills.
appendImports(StringBuilder out, DiscoveredTest[] tests) {
    out.append("import @std.system;\n");
    string last = "";
    for (let one in tests) {
        if (one.modulePath() == last) {
            continue;
        }
        last = one.modulePath();
        out.append("import {last};\n");
    }
    out.append("\n");
}

// One test: run it, say it passed, and answer true; or catch what it threw, say it failed with the
// message and the frames that led there, and answer false.
appendTest(StringBuilder out, DiscoveredTest test, long position) {
    out.append("$run{position}() -> bool \{\n");
    out.append("    try {aliasOf(test.modulePath())}.$test{test.index()}();\n");
    out.append("    print(\"PASS \" + {test.literal()});\n");
    out.append("    return true;\n");
    out.append("\} catch (Error thrown) \{\n");
    out.append("    print(\"FAIL \" + {test.literal()} + \": \" + thrown.message);\n");
    out.append("    for (let frame in thrown.stackFrames()) \{\n");
    out.append("        if (frame.file == \"{fileName()}\") \{\n");
    out.append("            break;\n");
    out.append("        \}\n");
    out.append("        print(\"  at \" + frame.function + \" (\" + frame.file + \":\" "
        + "+ frame.line + \")\");\n");
    out.append("    \}\n");
    out.append("    return false;\n");
    out.append("\}\n\n");
}

// The entry point: every test in turn, then how many of them passed. All passing is a run that
// worked; anything less is a run that failed. Each result is handed over before the next test starts,
// because a result still sitting in a buffer is not a result anyone can see.
appendEntry(StringBuilder out, long total) {
    out.append("main() -> int \{\n");
    out.append("    int passed = 0;\n");
    for (long i = 0; i < total; i++) {
        out.append("    if ($run{i}()) \{\n        passed = passed + 1;\n    \}\n");
        out.append("    system.flush();\n");
    }
    out.append("    print(\"\{passed\}/{total} tests passed\");\n");
    out.append("    if (passed == {total}) \{\n        return 0;\n    \}\n");
    out.append("    return 1;\n");
    out.append("\}\n");
}

// The name an imported module's own members are reached through, which is its last segment.
aliasOf(string modulePath) -> string {
    long start = 0;
    byte[] raw = modulePath.toBytes();
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] == '.') {
            start = i + 1;
        }
    }
    return modulePath.substring(start, modulePath.length);
}

// The runner over the tree the tests were read from, so it is compiled as if it were a file beside
// them without ever being written to one.
export class RunnerOverlay implements FileLoader {
    FileLoader tree;
    string runnerFile;
    string runnerSource;

    export constructor(FileLoader tree, string runnerFile, string runnerSource) {
        this.tree = tree;
        this.runnerFile = runnerFile;
        this.runnerSource = runnerSource;
    }

    override exists(string path) -> bool {
        if (path == this.runnerFile) {
            return true;
        }
        return this.tree.exists(path);
    }

    override readText(string path) -> string throws FileError {
        if (path == this.runnerFile) {
            return this.runnerSource;
        }
        return try this.tree.readText(path);
    }
}

// What a run came to, read from the code the runner ended with.
export final class RunnerOutcome {
    int code;
    string problem;

    protected constructor(this.code, this.problem);

    // 0 every test passed, 1 some of them failed, 2 the run did not finish.
    export exitCode() -> int {
        return this.code;
    }

    // What to report about a run that did not finish, or empty text when it finished.
    export failure() -> string {
        return this.problem;
    }
}

// Whether the line is the result `test` prints, which is how a reader of the output knows that test
// has finished. The text is exactly what appendTest writes, and a line is only ever offered against
// the one test whose turn it is, so a test printing something of its own is not mistaken for a result.
export reportsResult(string line, DiscoveredTest test) -> bool {
    return line == "PASS " + test.description()
        || line.startsWith("FAIL " + test.description() + ": ");
}

// What the code the runner ended with means, given how many of `tests` reported a result before it
// ended. It ends with 0 when every test passed and 1 when some failed, having said which; anything
// else means it stopped partway - a panic, an exception nothing caught, or a crash - and the test it
// stopped in is the one after the last result that arrived.
export outcomeOf(int runnerExit, DiscoveredTest[] tests, long finished) -> RunnerOutcome {
    if (runnerExit == 0) {
        return new RunnerOutcome(0, "");
    }
    if (runnerExit == 1) {
        return new RunnerOutcome(1, "");
    }
    if (finished < 0 || finished >= tests.length) {
        return new RunnerOutcome(2, "the test program stopped before it had run every test, ending "
            + "with code {runnerExit}; every test that reported a result had already finished");
    }
    string stopped = tests[finished].description();
    return new RunnerOutcome(2, "the test program stopped while running '{stopped}', ending with "
        + "code {runnerExit}; run that test on its own with --filter '{stopped}' to see it");
}
