// The program a test run actually runs, ordinary Ens written out of what discovery found. A
// description is spliced in as the literal it was written as, so nothing needs escaping again.
// Several tests run at the same time, on as many tasks as the run was given jobs, each taking the
// next test nobody has started, and every line the runner writes about a test is marked with the
// test's place in the run, so the command reading it can put the results back in order whatever
// order they finished in. A run that stopped partway is started again over the tests it did not
// finish, so the program is told which of them to run.
import StringBuilder from @std.text.stringbuilder;
import List from @std.collections.list;
import Map from @std.collections.map;
import FileLoader from @ens.sema.support.loader;
import Path from @std.fs;
import FileError from @ens.sema.support.loader;
import @std.text.parse;
import DiscoveredTest from testing.discovery;
import report;

export final class Runner {
    // Not a file on disk. It enters the module graph over the tree the tests were read from, which
    // is why its name is one no source file can have.
    export static const string fileName = "$ens_test_runner.ens";

    export static const string modulePath = "$ens_test_runner";

    // What starts every line the runner writes about a test. A test's own output does not start
    // with it, so the two are told apart line by line.
    export static const string marker = "$ens_test_runner ";

    // How many tests one dispatch function chooses between, so no function's switch grows with
    // the suite.
    export static const long groupSize = 64;

    // What starts the report a panic writes to the error stream.
    export static const string panicPrefix = "panic: ";
}

// The runner for these tests, in the order they are given.
export source(DiscoveredTest[] tests) -> string {
    let out = new StringBuilder();
    appendImports(out, tests);
    appendReporting(out);
    for (long i = 0; i < tests.length; i++) {
        appendTest(out, tests[i], i);
    }
    appendDispatch(out, tests.length);
    appendEntry(out, tests.length);
    return out.toString();
}

// One import per module, written once however many of its tests are running, over the ones the
// runner itself uses.
appendImports(StringBuilder out, DiscoveredTest[] tests) {
    out.append("import @std.io;\n");
    out.append("import IoError from @std.io.streams;\n");
    out.append("import @std.environment;\n");
    out.append("import @std.tasks;\n");
    out.append("import Atomic from @std.tasks;\n");
    out.append("import @std.text.parse;\n");
    out.append("import List from @std.collections.list;\n");
    out.append("import FrozenList from @std.collections.frozen;\n");
    string last = "";
    for (let one in tests) {
        if (one.modulePath() == last) {
            continue;
        }
        last = one.modulePath();
        out.append("import {last};\n");
    }
    out.append("\n");
}

// The runner's own reporting, named as the synthesized declarations are so no test module can
// collide with it. Each event is one print, so its lines reach the output together, and is flushed
// at once, because a result still held in a buffer is not one anyone can read. A standard output
// that will not take them is dropped, because a run reports through its exit code and the lines it
// managed to write.
appendReporting(StringBuilder out) {
    out.append("$flush() \{\n");
    out.append("    try io.flush();\n");
    out.append("\} catch (IoError ignored) \{\n");
    out.append("\}\n\n");
    out.append("$started(long position) \{\n");
    out.append("    print(\"{Runner.marker}start \{position\}\");\n");
    out.append("    $flush();\n");
    out.append("\}\n\n");
    out.append("$finished(long position, string result, bool passed) \{\n");
    out.append("    string written = \"\";\n");
    out.append("    for (let line in result.lines()) \{\n");
    out.append("        written = written + \"{Runner.marker}line \{position\} \{line\}\\n\";\n");
    out.append("    \}\n");
    out.append("    string verdict = passed ? \"pass\" : \"fail\";\n");
    out.append("    print(written + \"{Runner.marker}\{verdict\} \{position\}\");\n");
    out.append("    $flush();\n");
    out.append("\}\n\n");
}

// One test: run it and report that it passed, or catch what it threw and report that it failed,
// with the message and the frames that led there. Returns whether it passed.
appendTest(StringBuilder out, DiscoveredTest test, long position) {
    out.append("$run{position}() -> bool \{\n");
    out.append("    $started({position});\n");
    out.append("    try {aliasOf(test.modulePath())}.$test{test.index()}();\n");
    out.append("    $finished({position}, \"PASS \" + {test.literal()}, true);\n");
    out.append("    return true;\n");
    out.append("\} catch (Error thrown) \{\n");
    out.append("    string result = \"FAIL \" + {test.literal()} + \": \" + thrown.message;\n");
    out.append("    for (let frame in thrown.stackFrames()) \{\n");
    out.append("        if (frame.file == \"{Runner.fileName}\") \{\n");
    out.append("            break;\n");
    out.append("        \}\n");
    out.append("        result = result + \"\\n  at \" + frame.function + \" (\" + frame.file + "
        + "\":\" + frame.line + \")\";\n");
    out.append("    \}\n");
    out.append("    $finished({position}, result, false);\n");
    out.append("    return false;\n");
    out.append("\}\n\n");
}

// The test at a place in the run, chosen in two steps, its group and then the test, so no switch
// has more arms than a group has tests.
appendDispatch(StringBuilder out, long total) {
    long groups = (total + Runner.groupSize - 1) / Runner.groupSize;
    for (long group = 0; group < groups; group++) {
        out.append("$group{group}(long position) -> bool \{\n");
        out.append("    return switch (position) \{\n");
        long end = (group + 1) * Runner.groupSize;
        if (end > total) {
            end = total;
        }
        for (long i = group * Runner.groupSize; i < end; i++) {
            out.append("        {i} -> $run{i}(),\n");
        }
        out.append("        default -> false,\n");
        out.append("    \};\n");
        out.append("\}\n\n");
    }
    out.append("$run(long position) -> bool \{\n");
    out.append("    return switch (position / {Runner.groupSize}) \{\n");
    for (long group = 0; group < groups; group++) {
        out.append("        {group} -> $group{group}(position),\n");
    }
    out.append("        default -> false,\n");
    out.append("    \};\n");
    out.append("\}\n\n");
}

// The entry point: as many workers as the run has jobs, each running the next test of the order
// nobody has started until none are left. All passing is a run that worked; anything less is a run
// that failed. The number of jobs is the program's first argument, and the tests to run follow it
// as places in the run, each one alone or a range such as '3-10', all of them when none follow.
appendEntry(StringBuilder out, long total) {
    out.append("$work(FrozenList<long> order, Atomic<long> next, Atomic<long> passed) \{\n");
    out.append("    long taken = next.increment() - 1;\n");
    out.append("    while (taken < order.length()) \{\n");
    out.append("        if ($run(order.get(taken))) \{\n");
    out.append("            passed.increment();\n");
    out.append("        \}\n");
    out.append("        taken = next.increment() - 1;\n");
    out.append("    \}\n");
    out.append("\}\n\n");
    out.append("$jobs() -> long \{\n");
    out.append("    string[] given = environment.arguments();\n");
    out.append("    long? jobs = given.length > 0 ? parse.parseLong(given[0]) : null;\n");
    out.append("    if (jobs == null || jobs < 1) \{\n");
    out.append("        return 1;\n");
    out.append("    \}\n");
    out.append("    return jobs;\n");
    out.append("\}\n\n");
    out.append("$order() -> FrozenList<long> \{\n");
    out.append("    string[] given = environment.arguments();\n");
    out.append("    let order = new List<long>();\n");
    out.append("    if (given.length < 2) \{\n");
    out.append("        for (long position = 0; position < {total}; position++) \{\n");
    out.append("            order.push(position);\n");
    out.append("        \}\n");
    out.append("        return order.frozen();\n");
    out.append("    \}\n");
    out.append("    for (long i = 1; i < given.length; i++) \{\n");
    out.append("        long dash = given[i].indexOf(\"-\");\n");
    out.append("        long? first = parse.parseLong(dash < 0 ? given[i] "
        + ": given[i].substring(0, dash));\n");
    out.append("        long? last = parse.parseLong(dash < 0 ? given[i] "
        + ": given[i].substring(dash + 1, given[i].length));\n");
    out.append("        if (first != null && last != null) \{\n");
    out.append("            for (long position = first; position <= last; position++) \{\n");
    out.append("                order.push(position);\n");
    out.append("            \}\n");
    out.append("        \}\n");
    out.append("    \}\n");
    out.append("    return order.frozen();\n");
    out.append("\}\n\n");
    out.append("main() -> int \{\n");
    out.append("    long jobs = $jobs();\n");
    out.append("    let order = $order();\n");
    out.append("    let next = new Atomic<long>(0);\n");
    out.append("    let passed = new Atomic<long>(0);\n");
    out.append("    tasks.scope((scope) -> \{\n");
    out.append("        for (long worker = 0; worker < jobs && worker < order.length(); "
        + "worker++) \{\n");
    out.append("            scope.launch(() -> $work(order, next, passed));\n");
    out.append("        \}\n");
    out.append("    \});\n");
    out.append("    if (passed.read() == order.length()) \{\n        return 0;\n    \}\n");
    out.append("    return 1;\n");
    out.append("\}\n");
}

// The arguments that tell the runner to run `positions` in that order, a run of consecutive
// places written as one range.
export positionArguments(long[] positions) -> string[] {
    let written = new List<string>();
    long i = 0;
    while (i < positions.length) {
        long end = i;
        while (end + 1 < positions.length && positions[end + 1] == positions[end] + 1) {
            end++;
        }
        written.push(end == i ? "{positions[i]}" : "{positions[i]}-{positions[end]}");
        i = end + 1;
    }
    return written.toArray();
}

// The name an imported module's own members are reached through, which is its last segment.
aliasOf(string modulePath) -> string {
    long start = 0;
    bytes raw = modulePath.toBytes();
    for (long i = 0; i < raw.length; i++) {
        if (raw[i] == '.') {
            start = i + 1;
        }
    }
    return modulePath.substring(start, modulePath.length);
}

// The runner over the tree the tests were read from, so it is compiled as if it were a file beside
// them without ever being written to one.
export class RunnerOverlay implements FileLoader {
    FileLoader tree;
    Path runnerFile;
    string runnerSource;

    export constructor(FileLoader tree, Path runnerFile, string runnerSource) {
        this.tree = tree;
        this.runnerFile = runnerFile;
        this.runnerSource = runnerSource;
    }

    export override exists(Path path) -> bool {
        if (path == this.runnerFile) {
            return true;
        }
        return this.tree.exists(path);
    }

    export override isFile(Path path) -> bool {
        return path == this.runnerFile || this.tree.isFile(path);
    }

    export override filesUnder(Path folder) -> Path[] throws FileError {
        Path[] under = try this.tree.filesUnder(folder);
        if (this.runnerFile.relativeTo(folder) == null) {
            return under;
        }
        let found = new List<Path>();
        for (let path in under) {
            found.push(path);
        }
        found.push(this.runnerFile);
        return found.toArray();
    }

    export override folderKey(Path folder) -> string {
        return this.tree.folderKey(folder);
    }

    export override readText(Path path) -> string throws FileError {
        if (path == this.runnerFile) {
            return this.runnerSource;
        }
        return try this.tree.readText(path);
    }

    export override readBytes(Path path) -> bytes throws FileError {
        if (path == this.runnerFile) {
            return this.runnerSource.toBytes();
        }
        return try this.tree.readBytes(path);
    }
}

// The runner's output read line by line: what to show for each line, in the order it is to be
// shown, and which tests have started and finished. A test's results are held until every test
// before it has finished, so they come out in the order the tests were given whatever order they
// finished in, while a line a test printed of its own is shown as it arrives.
export final class RunnerOutput {
    DiscoveredTest[] tests;
    bool[] begun;
    bool[] ended;
    bool[] succeeded;
    Map<long, List<string>> held;
    long shownThrough;

    export constructor(DiscoveredTest[] tests) {
        this.tests = tests;
        this.begun = new bool[tests.length];
        this.ended = new bool[tests.length];
        this.succeeded = new bool[tests.length];
        this.held = new Map<long, List<string>>();
        this.shownThrough = 0;
    }

    // The lines to show now that `line` arrived.
    export accept(string line) -> string[] {
        if (!line.startsWith(Runner.marker)) {
            return [line];
        }
        string event = line.substring(Runner.marker.length, line.length);
        long space = event.indexOf(" ");
        if (space < 0) {
            return [line];
        }
        string kind = event.substring(0, space);
        string rest = event.substring(space + 1, event.length);
        long numberEnd = rest.indexOf(" ");
        string number = numberEnd < 0 ? rest : rest.substring(0, numberEnd);
        long? parsed = parse.parseLong(number);
        if (parsed == null || parsed < 0 || parsed >= this.tests.length) {
            return [line];
        }
        long position = parsed;
        switch (kind) {
            "start" -> {
                this.begun[position] = true;
            }
            "line" -> {
                this.heldFor(position).push(numberEnd < 0 ? ""
                    : rest.substring(numberEnd + 1, rest.length));
            }
            "pass", "fail" -> {
                this.ended[position] = true;
                this.succeeded[position] = kind == "pass";
                return this.inOrder();
            }
            default -> {
                return [line];
            }
        }
        return [];
    }

    // The results still held once the runner has ended: those of the tests that finished after a
    // test before them that never did, in the order the tests were given.
    export remaining() -> string[] {
        let shown = new List<string>();
        for (long i = this.shownThrough; i < this.tests.length; i++) {
            if (this.ended[i]) {
                this.show(i, shown);
            }
        }
        this.shownThrough = this.tests.length;
        return shown.toArray();
    }

    // How many tests the run has.
    export total() -> long {
        return this.tests.length;
    }

    // How many tests have reported a result.
    export finished() -> long {
        long count = 0;
        for (let one in this.ended) {
            if (one) {
                count++;
            }
        }
        return count;
    }

    // How many of them passed.
    export passed() -> long {
        long count = 0;
        for (long i = 0; i < this.tests.length; i++) {
            if (this.ended[i] && this.succeeded[i]) {
                count++;
            }
        }
        return count;
    }

    // The places among `positions` whose tests started and have not reported a result.
    export unfinishedAmong(long[] positions) -> long[] {
        let found = new List<long>();
        for (let position in positions) {
            if (this.begun[position] && !this.ended[position]) {
                found.push(position);
            }
        }
        return found.toArray();
    }

    // The places among `positions` whose tests never started.
    export unstartedAmong(long[] positions) -> long[] {
        let found = new List<long>();
        for (let position in positions) {
            if (!this.begun[position] && !this.ended[position]) {
                found.push(position);
            }
        }
        return found.toArray();
    }

    // Whether every test among `positions` has reported a result.
    export finishedAll(long[] positions) -> bool {
        for (let position in positions) {
            if (!this.ended[position]) {
                return false;
            }
        }
        return true;
    }

    export hasStarted(long position) -> bool {
        return this.begun[position];
    }

    export hasFinished(long position) -> bool {
        return this.ended[position];
    }

    // Forgets that the test at `position` started, before it runs again on its own.
    export rerun(long position) {
        this.begun[position] = false;
    }

    // Records the failure of a test that ended the program, as the lines of its result, and
    // returns the lines to show now.
    export stopped(long position, string[] result) -> string[] {
        let lines = this.heldFor(position);
        for (let line in result) {
            lines.push(line);
        }
        this.ended[position] = true;
        this.succeeded[position] = false;
        return this.inOrder();
    }

    // The results of every finished test no unfinished test comes before, which have not been
    // shown yet.
    inOrder() -> string[] {
        let shown = new List<string>();
        while (this.shownThrough < this.tests.length && this.ended[this.shownThrough]) {
            this.show(this.shownThrough, shown);
            this.shownThrough++;
        }
        return shown.toArray();
    }

    show(long position, List<string> shown) {
        let lines = this.held.get(position);
        if (lines == null) {
            return;
        }
        for (let line in lines) {
            shown.push(line);
        }
        this.held.remove(position);
    }

    heldFor(long position) -> List<string> {
        let lines = this.held.get(position);
        if (lines != null) {
            return lines;
        }
        let created = new List<string>();
        this.held.set(position, created);
        return created;
    }
}

// Whether a runner that reported a result for every test it was given ended as one that did:
// with 0 when all of them passed and 1 when some failed.
export endedWithResults(int runnerExit) -> bool {
    return runnerExit == 0 || runnerExit == 1;
}

// What to report about a runner that stopped where no test explains it: after every test it was
// given had reported a result, or while none of them was running.
export stoppedOutsideTests(int runnerExit, RunnerOutput output, bool everyResultIn) -> string {
    if (everyResultIn) {
        return "the test program ended with code {runnerExit} after all of its tests had reported "
            + "a result, so the failure is outside the tests";
    }
    return "the test program stopped with code {runnerExit} when no test was running, after "
        + "{output.finished()} of {output.total()} had reported a result, so the failure is outside the "
        + "tests";
}

// What to report when the tests that were running as the program stopped each finished when run
// again on their own, so none of them stops it alone.
export stoppedOnlyTogether(int runnerExit, DiscoveredTest[] running) -> string {
    if (running.length == 1) {
        return "the test program stopped with code {runnerExit} while running "
            + "'{running[0].description()}', and that test finished when run alone, so the stop "
            + "happens only when it runs beside other tests";
    }
    let names = new List<string>();
    for (let one in running) {
        names.push(one.description());
    }
    return "the test program stopped with code {runnerExit} while "
        + report.quotedNames(names.toArray()) + " were running at the same time, and each of them "
        + "finished when run alone, so the stop happens only when they run together";
}

// Where the report of the last panic on a runner's error stream starts, or -1 when it has none.
export panicStart(string[] errors) -> long {
    for (long i = errors.length - 1; i >= 0; i--) {
        if (errors[i].startsWith(Runner.panicPrefix)) {
            return i;
        }
    }
    return -1;
}

// The result of a test that ended the program it ran in alone: its panic's message and the frames
// up to the runner's own, or the code the program ended with when it printed no panic.
export stoppedResult(DiscoveredTest test, int runnerExit, string[] errors) -> string[] {
    long start = panicStart(errors);
    if (start < 0) {
        return ["FAIL {test.description()}: the test ended the program with code {runnerExit}"];
    }
    let result = new List<string>();
    result.push("FAIL {test.description()}: " + errors[start]);
    for (long i = start + 1; i < errors.length; i++) {
        if (errors[i].indexOf("({Runner.fileName}:") >= 0) {
            break;
        }
        result.push(errors[i]);
    }
    return result.toArray();
}

// The lines of a runner's error stream before its last panic, which a test wrote of its own.
export ownErrors(string[] errors) -> string[] {
    long start = panicStart(errors);
    if (start < 0) {
        return errors;
    }
    let own = new List<string>();
    for (long i = 0; i < start; i++) {
        own.push(errors[i]);
    }
    return own.toArray();
}

// The lines of a runner's error stream from its last panic on.
export panicLines(string[] errors) -> string[] {
    let lines = new List<string>();
    long start = panicStart(errors);
    if (start < 0) {
        return lines.toArray();
    }
    for (long i = start; i < errors.length; i++) {
        lines.push(errors[i]);
    }
    return lines.toArray();
}
