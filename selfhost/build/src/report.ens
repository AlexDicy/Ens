// What a build prints. One reporter belongs to one invocation and is the only thing in this
// package that writes to a stream, so everything else returns its findings as values and the
// order they appear in is fixed in one place.
import @std.io;
import IoError from @std.io.streams;
import Set from @std.collections.set;
import Progress from @ens.packages.progress;
import Verbosity from options;

export final class Reporter implements Progress {
    Verbosity level;
    Set<string> printed;

    export constructor(Verbosity level) {
        this.level = level;
        this.printed = new Set<string>();
    }

    // What the run produced. A quiet run keeps this to itself; every other run shows it.
    export note(string line) {
        if (this.level != Verbosity.Quiet) {
            print(line);
        }
    }

    // A step the run took, which only a verbose run prints.
    export override step(string line) {
        if (this.level == Verbosity.Verbose) {
            print(line);
        }
    }

    // A line another program wrote, passed on as it arrives. It is shown whatever verbosity the run
    // requested, because the output of the program a command was given to run is not the command's
    // own account of itself, and written out rather than buffered: a line waiting for a buffer to fill
    // is not live.
    export override relayed(string line) {
        print(line);
        try io.flush();
    } catch (IoError ignored) {
        // A standard output that will not take the line is dropped, since relaying one program's
        // account of itself is not something this reporter controls.
    }

    // Where the build compiled something other than what the manifests declare. Always shown,
    // whatever verbosity the run requested, and on the error stream beside the problems, because an override
    // changes which sources a build reads and hiding that is how somebody ships from the wrong
    // checkout. Each one is printed once however many of the build's units report it.
    export notices(string[] lines) {
        for (let line in lines) {
            if (this.printed.add(line)) {
                eprint(line);
            }
        }
    }

    // A problem in the command's own words. Always shown, whatever verbosity the run requested,
    // on the error stream, under the prefix every problem an 'ens' command reports carries.
    export problem(string line) {
        eprint("ens: " + line);
    }

    // Problems in the command's own words, each one under that same prefix.
    export sentences(string[] lines) {
        for (let line in lines) {
            this.problem(line);
        }
    }

    // Lines that already name where they come from, a formatted compiler diagnostic or what
    // another tool wrote, printed as they arrived.
    export diagnostics(string[] lines) {
        for (let line in lines) {
            eprint(line);
        }
    }

    // Lines a run requested explanations for, shown as they were gathered.
    export explanation(string[] lines) {
        for (let line in lines) {
            print(line);
        }
    }
}

// "[2/5] demo.app", how one of several units is announced.
export progress(long index, long total, string label) -> string {
    if (total <= 1) {
        return label;
    }
    return "[{index}/{total}] {label}";
}

// "'one', 'two' and 'three'", so a list of names is grammatical English inside a sentence.
export quotedNames(string[] names) -> string {
    string listed = "";
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            if (i == names.length - 1) {
                listed = listed + " and ";
            } else {
                listed = listed + ", ";
            }
        }
        listed = listed + "'" + names[i] + "'";
    }
    return listed;
}

// "3 problems" or "1 problem", so a count is always grammatical English.
export problemCount(long count) -> string {
    if (count == 1) {
        return "1 problem";
    }
    return "{count} problems";
}

// "3 members" or "1 member", for the same reason.
export memberCount(long count) -> string {
    if (count == 1) {
        return "1 member";
    }
    return "{count} members";
}

// "3 modules" or "1 module", for the same reason.
export moduleCount(long count) -> string {
    if (count == 1) {
        return "1 module";
    }
    return "{count} modules";
}

// "3 object files" or "1 object file", for the same reason.
export objectCount(long count) -> string {
    if (count == 1) {
        return "1 object file";
    }
    return "{count} object files";
}

// "3 tests" or "1 test", for the same reason.
export testCount(long count) -> string {
    if (count == 1) {
        return "1 test";
    }
    return "{count} tests";
}
