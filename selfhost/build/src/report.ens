// What a build says out loud. One reporter belongs to one invocation and is the only thing in this
// package that writes to a stream, so everything else hands its findings back as values and the
// order they appear in is decided in one place.
import @std.system;
import Set from @std.collections.set;
import Progress from @ens.packages.progress;
import Verbosity from options;

export final class Reporter implements Progress {
    Verbosity level;
    Set<string> alreadySaid;

    export constructor(Verbosity level) {
        this.level = level;
        this.alreadySaid = new Set<string>();
    }

    // What the run produced. A quiet run keeps this to itself; every other run shows it.
    export note(string line) {
        if (this.level != Verbosity.Quiet) {
            print(line);
        }
    }

    // A step the run took, which only a verbose run asks for.
    export override step(string line) {
        if (this.level == Verbosity.Verbose) {
            print(line);
        }
    }

    // A line another program wrote, passed on as it arrives. It is shown whatever the run asked
    // for, because the output of the program a command was told to run is not the command's own
    // account of itself, and handed over rather than buffered: a line waiting for a buffer to fill
    // is not live.
    export override relayed(string line) {
        print(line);
        system.flush();
    }

    // Where the build compiled something other than what the manifests declare. Always shown,
    // whatever the run asked for, and on the error stream beside the problems: an override changes
    // which sources a build reads, and a run that hid that would be how somebody ships from the
    // wrong checkout without ever seeing it. Quiet hides an account of the work, not a departure
    // from what was asked for.
    //
    // Each one is said once however many of the build's units report it, because a workspace's
    // members all resolve through the same overrides and the build is what is using them.
    export notices(string[] lines) {
        for (let line in lines) {
            if (this.alreadySaid.add(line)) {
                // What has already been printed goes out first, so a notice lands where it belongs
                // in the account rather than wherever the two streams happen to meet.
                system.flush();
                system.writeError(line);
            }
        }
    }

    // A problem. Always shown, whatever the run asked for, on the error stream.
    export problem(string line) {
        system.writeError(line);
    }

    export problems(string[] lines) {
        for (let line in lines) {
            system.writeError(line);
        }
    }

    // Lines a run asked to be explained, shown as they were gathered.
    export explanation(string[] lines) {
        for (let line in lines) {
            print(line);
        }
    }
}

// "[2/5] demo.app", how one of several units is announced.
export progress(long index, long total, string label) -> string {
    if (total <= 1) {
        return label;
    }
    return "[{index}/{total}] {label}";
}

// "'one', 'two' and 'three'", so a list of names reads as English inside a sentence.
export quotedNames(string[] names) -> string {
    string listed = "";
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            if (i == names.length - 1) {
                listed = listed + " and ";
            } else {
                listed = listed + ", ";
            }
        }
        listed = listed + "'" + names[i] + "'";
    }
    return listed;
}

// "3 problems" or "1 problem", so a count always reads as English.
export problemCount(long count) -> string {
    if (count == 1) {
        return "1 problem";
    }
    return "{count} problems";
}
