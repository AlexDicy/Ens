// What a build says out loud. One reporter belongs to one invocation and is the only thing in this
// package that writes to a stream, so everything else hands its findings back as values and the
// order they appear in is decided in one place.
import @std.system;
import BuildOptions from options;
import Verbosity from options;

export final class Reporter {
    Verbosity level;

    export constructor(BuildOptions options) {
        this.level = options.verbosity();
    }

    // What the run produced. A quiet run keeps this to itself; every other run shows it.
    export note(string line) {
        if (this.level != Verbosity.Quiet) {
            print(line);
        }
    }

    // A step the run took, which only a verbose run asks for.
    export step(string line) {
        if (this.level == Verbosity.Verbose) {
            print(line);
        }
    }

    // A problem. Always shown, whatever the run asked for, on the error stream.
    export problem(string line) {
        system.writeError(line);
    }

    export problems(string[] lines) {
        for (let line in lines) {
            system.writeError(line);
        }
    }

    // Lines a run asked to be explained, shown as they were gathered.
    export explanation(string[] lines) {
        for (let line in lines) {
            print(line);
        }
    }
}

// "[2/5] demo.app", how one of several units is announced.
export progress(long index, long total, string label) -> string {
    if (total <= 1) {
        return label;
    }
    return "[{index}/{total}] {label}";
}

// "'one', 'two' and 'three'", so a list of names reads as English inside a sentence.
export quotedNames(string[] names) -> string {
    string listed = "";
    for (long i = 0; i < names.length; i++) {
        if (i > 0) {
            if (i == names.length - 1) {
                listed = listed + " and ";
            } else {
                listed = listed + ", ";
            }
        }
        listed = listed + "'" + names[i] + "'";
    }
    return listed;
}

// "3 problems" or "1 problem", so a count always reads as English.
export problemCount(long count) -> string {
    if (count == 1) {
        return "1 problem";
    }
    return "{count} problems";
}
