// What a target's system determines beyond code generation: what an executable for it is called,
// and which platform name a manifest's native bindings use for it. Every result is a pure function
// of the system, so a cross build names its artifacts the target's way, not the build machine's.
import @ens.llvm.target;
import Architecture from @ens.target.triple;
import TargetTriple from @ens.target.triple;
import @ens.target.triple;
import Platform from @std.platform;

// The target a build is for when the command line does not name one: what this machine runs, spelled
// in the form a build reads, and null when this toolchain cannot build for this machine. Every query
// about this machine goes through here, so the default target and the target a command compares
// against to know whether it can run what it built are the same value.
export getHostTarget() -> TargetTriple? {
    return TargetTriple.parse(hostTriple());
}

// What this machine runs, spelled in the form a build reads, whether or not this toolchain can build
// for it.
export hostTriple() -> string {
    return triple.defaultTargetFor(target.hostTargetTriple());
}

// The suffix an executable carries on the system: Windows names its programs '.exe', and Linux and
// macOS name them with no suffix at all.
export executableSuffix(Platform platform) -> string {
    return switch (platform) {
        Platform.Windows -> ".exe",
        Platform.Linux -> "",
        Platform.MacOS -> "",
    };
}

export platformName(Platform platform) -> string {
    return switch (platform) {
        Platform.Windows -> "windows",
        Platform.Linux -> "linux",
        Platform.MacOS -> "macos",
    };
}

export architectureName(Architecture architecture) -> string {
    return switch (architecture) {
        Architecture.X64 -> "x64",
        Architecture.Arm64 -> "arm64",
    };
}

// The system and processor this toolchain runs on, as in 'windows/x64', or the triple LLVM names
// for this machine when this toolchain cannot build for it.
export hostName() -> string {
    let here = getHostTarget();
    if (here == null) {
        return hostTriple();
    }
    return platformName(here.platform()) + "/" + architectureName(here.architecture());
}

// The file an artifact of the given stem is written to on the system.
export executableNamed(string stem, Platform platform) -> string {
    return stem + executableSuffix(platform);
}

// Whether a program built for `target` runs on this machine.
export runsHere(TargetTriple target) -> bool {
    let here = getHostTarget();
    return here != null && target.runsOn(here);
}

// Why a command that has to run what it builds cannot build for this target, or empty text when it
// can. A program built for another machine cannot be started on this one, so a command that builds
// only in order to run reports it before it builds rather than after.
export unrunnableTriple(TargetTriple target) -> string {
    return unrunnableOn(target, getHostTarget(), hostTriple());
}

// Why a command cannot run what it builds for `target` on a machine whose own target is `here`,
// written `hereText`, where `here` is null when this toolchain cannot build for that machine.
public unrunnableOn(TargetTriple target, TargetTriple? here, string hereText) -> string {
    if (here != null && target.runsOn(here)) {
        return "";
    }
    string elsewhere = "'--target {target.text()}' builds for another machine, and this command runs "
        + "what it builds on this one, '{hereText}'";
    string build = "'ens build' to build for '{target.text()}' without running it";
    if (here == null) {
        return "{elsewhere}, which this toolchain cannot build for. Use {build}";
    }
    return "{elsewhere}. Remove '--target', or use {build}";
}
