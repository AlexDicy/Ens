// What a target triple decides beyond code generation: what an executable for it is called, and
// which platform name a manifest's native bindings use for it. Both follow from the object format
// the target links in, which is the one question a triple is asked here.
//
// Every answer is a pure function of the triple, so a cross build names its artifacts and picks
// its libraries the target's way rather than the way the machine running the build would.
import LinkerFlavor from @ens.link.flavor;
import @ens.link.flavor;
import @ens.llvm.target;

// The suffix an executable carries on the target: Windows names its programs '.exe', and the
// systems that link ELF and Mach-O name them with no suffix at all.
export executableSuffix(string triple) -> string {
    return switch (flavor.flavorOf(triple)) {
        LinkerFlavor.Coff -> ".exe",
        LinkerFlavor.Elf -> "",
        LinkerFlavor.MachO -> "",
    };
}

// The name a manifest's native bindings give this platform.
export platformName(string triple) -> string {
    return switch (flavor.flavorOf(triple)) {
        LinkerFlavor.Coff -> "windows",
        LinkerFlavor.Elf -> "linux",
        LinkerFlavor.MachO -> "macos",
    };
}

// The file an artifact of the given stem is written to.
export executableNamed(string stem, string triple) -> string {
    return stem + executableSuffix(triple);
}

// Why a command that has to run what it builds cannot build for this triple, or empty text when it
// can. A program built for another machine cannot be started on this one, so a command that builds
// only in order to run says so before it builds rather than after.
export unrunnableTriple(string triple) -> string {
    string here = target.hostTargetTriple();
    if (triple == here) {
        return "";
    }
    return "'--target {triple}' builds for another machine, and this command runs what it builds; "
        + "drop '--target' to build for this machine, which is '{here}', or use 'ens build' to "
        + "build for '{triple}' without running it";
}
