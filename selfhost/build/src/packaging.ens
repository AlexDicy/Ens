// How a build reaches what it depends on, as one value settled before any of the work starts. It is
// threaded rather than looked up, so nothing in a build reaches the cache or the network itself,
// and a build given none of it simply has nothing to fetch.
import PackageSources from @ens.sema.program.workspace;
import @ens.sema.program.workspace;
import ContentStore from @ens.packages.store;
import Progress from @ens.packages.progress;

export final class Packaging {
    PackageSources resolvedSources;
    ContentStore? cache;
    bool noNetwork;
    Progress account;

    export constructor(this.resolvedSources, this.cache, this.noNetwork, this.account);

    // The folder each package the build resolved from outside its own workspace sits in.
    export sources() -> PackageSources {
        return this.resolvedSources;
    }

    // The cache this machine shares between builds, or null when nothing says where it would be.
    export store() -> ContentStore? {
        return this.cache;
    }

    export offline() -> bool {
        return this.noNetwork;
    }

    export progress() -> Progress {
        return this.account;
    }
}

// A build with nothing to fetch and nowhere to say so, which is what compiling sources that depend on
// nothing outside the checkout amounts to.
export none() -> Packaging {
    return new Packaging(workspace.noPackageSources(), null, true, new Silence());
}

// Somewhere for the lines a build with no reporter would have shown to go.
final class Silence implements Progress {
    protected constructor() { }

    protected override step(string line) { }

    protected override relayed(string line) { }
}
