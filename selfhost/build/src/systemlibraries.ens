// The link-only system libraries ens carries for a target, written into the cache for a link to
// read, so the program links against the same files whichever machine builds it. A target ens
// carries none for links against what the machine has.
import Path from @std.fs;
import Platform from @std.platform;
import ContentStore from @ens.packages.store;
import Toolchain from @ens.link.toolchain;
import Architecture from @ens.target.triple;
import TargetTriple from @ens.target.triple;
import @ens.host.home;
import @ens.bundled.macos;

// The toolchain a link for `target` runs with, or why it cannot run, and what writing the files
// left in the cache that nothing removed.
export final class CarriedLibraries {
    Toolchain linkWith;
    string problem;
    string leftover;

    protected constructor(this.linkWith, this.problem, this.leftover);

    export toolchain() -> Toolchain {
        return this.linkWith;
    }

    export failure() -> string {
        return this.problem;
    }

    export leftBehind() -> string {
        return this.leftover;
    }
}

// `toolchain` linking the system libraries ens carries for `target`, written into `store` first
// when no earlier run has written them. `platform` is the system this build runs on, which names
// the variable for the user's own folder.
export forTarget(Toolchain toolchain, TargetTriple target, ContentStore? store,
                 Platform platform) -> CarriedLibraries {
    if (target.platform() != Platform.MacOS || target.architecture() != Architecture.Arm64) {
        return new CarriedLibraries(toolchain, "", "");
    }
    if (store == null) {
        return new CarriedLibraries(toolchain, noCacheMessage(platform), "");
    }
    let written = macos.systemLibrary(store);
    if (written.failure().length > 0) {
        return new CarriedLibraries(toolchain, notWrittenMessage(written.failure()),
            written.leftBehind());
    }
    Path libSystem = written.path().join(macos.libSystemFile());
    return new CarriedLibraries(toolchain.withSystemLibraries([libSystem.toString()],
        macos.arm64List().sdkVersion()), "", written.leftBehind());
}

// The message for a macOS link with no cache to write libSystem's list into.
export noCacheMessage(Platform platform) -> string {
    string variable = home.userFolderVariable(platform);
    return "a macOS program is linked against a list of what macOS's system library provides, "
        + "which ens writes into its cache, and there is no cache folder: neither 'ENS_CACHE' nor "
        + "'{variable}' is set. Set 'ENS_CACHE' to a folder that can be written to, or set "
        + "'{variable}'";
}

// The message for a macOS link whose list of libSystem's symbols could not be written, given why.
export notWrittenMessage(string failure) -> string {
    return "a macOS program is linked against a list of what macOS's system library provides, "
        + "which ens writes into its cache, and the list could not be put there: {failure}. Set "
        + "'ENS_CACHE' to a folder that can be written to";
}
