// The files behind the prebuilt native libraries a build links, each downloaded once into the cache
// and checked against the digest its manifest declared. Every binding is settled on its own, and
// the order they end up on the link line is the order the manifests named them in.
import List from @std.collections.list;
import ArtifactBinding from natives;
import LibraryPlan from natives;
import Packaging from packaging;
import @ens.packages.artifacts;

// The files a link needs, or the reason one of them is not there.
export final class PrebuiltFiles {
    string[] resolvedFiles;
    string problem;

    protected constructor(this.resolvedFiles, this.problem);

    export files() -> string[] {
        return this.resolvedFiles;
    }

    export failure() -> string {
        return this.problem;
    }
}

// The file of every prebuilt library the plan asks for. The first binding that cannot be settled
// stops it: a program linked against some of the libraries it binds is not the program.
export filesFor(LibraryPlan plan, Packaging packaging) -> PrebuiltFiles {
    ArtifactBinding[] wanted = plan.artifacts();
    if (wanted.length == 0) {
        string[] none = [];
        return new PrebuiltFiles(none, "");
    }
    let cache = packaging.store();
    if (cache == null) {
        return refused("the prebuilt library for native '{wanted[0].library()}' cannot be kept: "
            + "nothing in the environment says where this machine caches what a build fetches");
    }
    let files = new List<string>();
    for (let binding in wanted) {
        let fetched = artifacts.fetch(cache, binding.library(), binding.url(), binding.checksum(),
            packaging.offline(), packaging.progress());
        if (!fetched.succeeded()) {
            return refused(fetched.failure());
        }
        files.push(fetched.file());
    }
    return new PrebuiltFiles(files.toArray(), "");
}

refused(string problem) -> PrebuiltFiles {
    string[] none = [];
    return new PrebuiltFiles(none, problem);
}
