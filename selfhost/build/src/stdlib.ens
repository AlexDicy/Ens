// Finding the standard library: the folder holding 'std/'. A build reads the folder the environment
// names, then walks up from the sources it was given to compile until it finds a 'libs/std' beside
// them, which is what makes a build inside a checkout of the language work with no configuration.
import FileLoader from @ens.sema.support.loader;
import Path from @std.fs;

// The folder containing 'std/', or null when neither the environment nor the walk found one.
export findRoot(FileLoader loader, string? environment, Path startFolder) -> Path? {
    if (environment != null && environment.length > 0) {
        Path named = Path(environment);
        if (loader.exists(named)) {
            return named;
        }
    }
    Path? folder = startFolder.normalize();
    while (folder != null) {
        Path libs = folder.join("libs");
        if (loader.exists(libs.join("std/ens.package"))) {
            return libs;
        }
        Path? above = folder.parent();
        if (above == null || above == folder) {
            return null;
        }
        folder = above;
    }
    return null;
}

// The message for a user whose build found no standard library.
export missingMessage() -> string {
    return "the standard library could not be found; pass '--stdlib <folder>' naming the folder "
        + "that holds 'std/', or set ENS_STDLIB to it";
}
