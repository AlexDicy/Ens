// Finding the standard library: the folder holding 'std/'. A build reads the folder the command
// line or the environment names, and otherwise the library this compiler carries, which is written
// into the cache the first time a build needs it.
import FileLoader from @ens.sema.support.loader;
import @ens.sema.program.workspace;
import @ens.host.paths;
import @ens.host.home;
import Path from @std.fs;
import Environment from @std.environment;
import BuildTarget from target;
import TargetKind from target;

// The folder the 'ENS_STDLIB' variable names, or null when it names none. A folder the variable
// names is the one used, as '--stdlib' is, whatever is there.
export variableRoot(string? named) -> Path? {
    if (named == null || named.length == 0) {
        return null;
    }
    return paths.native(named);
}

// The folder containing the target when the target is the standard library, so a command over it
// uses it as the library rather than loading a second one: the package named 'std' whose sources
// hold the modules every program reads without an import. Null for any other target, including a
// package named 'std' without them, which the load then refuses for taking the reserved name.
export libraryRootOf(FileLoader loader, BuildTarget resolved) -> Path? {
    if (resolved.kind() != TargetKind.Package || resolved.packageName() != "std") {
        return null;
    }
    if (missingPrelude(loader, resolved.sourceFolder()).length > 0) {
        return null;
    }
    return resolved.root().normalize().parent();
}

// The first module every program reads without an import that `sources` lacks, as a path under
// it, or empty text when it holds them all.
missingPrelude(FileLoader loader, Path sources) -> string {
    for (let module in ["core.ens", "io/print.ens"]) {
        if (!loader.exists(sources.join(module))) {
            return module;
        }
    }
    return "";
}

// The message for a command over a standard library whose '--stdlib' names a different folder.
export otherLibraryMessage(Path target, Path given, Path library) -> string {
    return "'{target}' is the package 'std', which is the standard library, so this command uses "
        + "it as the standard library. '--stdlib' names a different folder, '{given}'. Remove "
        + "'--stdlib', or write '--stdlib {library}'";
}

// Where the folder holding the standard library a build uses came from: '--stdlib', the
// 'ENS_STDLIB' variable, the library this compiler carries, or the target, when it is the library.
export enum LibraryOrigin {
    Option,
    Variable,
    Bundled,
    Target,
}

// What keeps `root` from being the folder that holds the standard library, or empty text when it
// holds one. The library this compiler carries holds one and a target is checked as the library
// itself, so only a folder the command line or the variable named can be anything else.
export libraryProblem(FileLoader loader, Path root, LibraryOrigin origin) -> string {
    if (origin == LibraryOrigin.Bundled || origin == LibraryOrigin.Target) {
        return "";
    }
    let wording = new LibraryWording(origin);
    string named = "{wording.name} names '{root}'";
    if (!loader.exists(root)) {
        return "{named}, which is not there. " + wording.fix("the folder that contains 'std/'");
    }
    if (loader.isFile(root)) {
        return "{named}, which is a file, not a folder. "
            + wording.fix("the folder that contains 'std/'");
    }
    if (!loader.exists(root.join("std/ens.package"))) {
        if (isLibraryFolder(loader, root)) {
            Path above = root.parent() ?? root;
            return "{named}, which is the 'std' folder itself. {wording.exact(above)}";
        }
        return "{named}, which does not contain the standard library: there is no "
            + "'std/ens.package' in it. " + wording.fix("the folder that contains 'std/'");
    }
    string missing = missingPrelude(loader, root.join("std/src"));
    if (missing.length > 0) {
        return "{named}, which does not contain the standard library: there is no "
            + "'std/src/{missing}' in it. "
            + wording.fix("a folder whose 'std/' holds the whole standard library");
    }
    return "";
}

// Whether `folder` is itself the package folder of the standard library: its manifest declares
// the package 'std' and its sources hold the modules every program reads without an import.
isLibraryFolder(FileLoader loader, Path folder) -> bool {
    if (!loader.exists(folder.join("ens.package"))) {
        return false;
    }
    let survey = workspace.surveyManifest(loader, folder);
    return survey != null && survey.isPackage() && survey.packageName() == "std"
        && missingPrelude(loader, folder.join("src")).length == 0;
}

// How a library problem names where the folder came from and what to write instead.
final class LibraryWording {
    protected string name;
    LibraryOrigin origin;

    protected constructor(LibraryOrigin origin) {
        this.origin = origin;
        this.name = "'--stdlib'";
        if (origin == LibraryOrigin.Variable) {
            this.name = "'ENS_STDLIB'";
        }
    }

    // The fix that names `wanted`, the kind of folder to name instead.
    protected fix(string wanted) -> string {
        if (this.origin == LibraryOrigin.Option) {
            return "Write '--stdlib' with {wanted}";
        }
        return "Set 'ENS_STDLIB' to {wanted}, or unset it";
    }

    // The fix that names the folder to write.
    protected exact(Path folder) -> string {
        if (this.origin == LibraryOrigin.Option) {
            return "Write '--stdlib {folder}'";
        }
        return "Set 'ENS_STDLIB' to '{folder}', or unset it";
    }
}

// The message for a build that names no standard library when there is no cache to write the one
// this compiler carries into.
export noCacheMessage(Environment environment) -> string {
    string variable = home.userFolderVariable(environment.platform());
    return "there is no cache folder to write the standard library into: neither 'ENS_CACHE' nor "
        + "'{variable}' is set. Set 'ENS_CACHE' to a folder that can be written to, or pass "
        + "'--stdlib <folder>' naming the folder that contains 'std/'";
}

// The message for a build whose standard library could not be written into the cache, given why.
export notWrittenMessage(string failure) -> string {
    return "the standard library could not be put in the cache: {failure}. Set 'ENS_CACHE' to a "
        + "folder that can be written to, or pass '--stdlib <folder>' naming the folder that "
        + "contains 'std/'";
}
