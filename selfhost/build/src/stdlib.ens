// Finding the standard library: the folder holding 'std/'. A build reads the folder the environment
// names, then walks up from the sources it was given to compile until it finds a 'libs/std' beside
// them, which is what makes a build inside a checkout of the language work with no configuration.
import FileLoader from @ens.sema.support.loader;
import Path from @std.fs;
import BuildTarget from target;
import TargetKind from target;

// The folder containing 'std/', or null when neither the environment nor the walk found one.
export findRoot(FileLoader loader, string? environment, Path startFolder) -> Path? {
    if (environment != null && environment.length > 0) {
        Path named = Path(environment);
        if (loader.exists(named)) {
            return named;
        }
    }
    Path? folder = startFolder.normalize();
    while (folder != null) {
        Path libs = folder.join("libs");
        if (loader.exists(libs.join("std/ens.package"))) {
            return libs;
        }
        Path? above = folder.parent();
        if (above == null || above == folder) {
            return null;
        }
        folder = above;
    }
    return null;
}

// The folder containing the target when the target is the standard library, so a command over it
// uses it as the library rather than loading a second one: the package named 'std' whose sources
// hold the modules every program reads without an import. Null for any other target, including a
// package named 'std' without them, which the load then refuses for taking the reserved name.
export libraryRootOf(FileLoader loader, BuildTarget resolved) -> Path? {
    if (resolved.kind() != TargetKind.Package || resolved.packageName() != "std") {
        return null;
    }
    Path sources = resolved.sourceFolder();
    if (!loader.exists(sources.join("core.ens")) || !loader.exists(sources.join("io/print.ens"))) {
        return null;
    }
    return resolved.root().normalize().parent();
}

// The message for a command over a standard library whose '--stdlib' names a different folder.
export otherLibraryMessage(Path target, Path given, Path library) -> string {
    return "'{target}' is the package 'std', which is the standard library, so this command uses "
        + "it as the standard library. '--stdlib' names a different folder, '{given}'. Remove "
        + "'--stdlib', or write '--stdlib {library}'";
}

// The message for a user whose build found no standard library.
export missingMessage() -> string {
    return "could not find the standard library. Pass '--stdlib <folder>' naming the folder that "
        + "contains 'std/', or set 'ENS_STDLIB' to that folder";
}
