// Finding the standard library: the folder holding 'std/'. A build looks where the environment
// says, then walks up from the sources it was asked to compile until it finds a 'libs/std' beside
// them, which is what makes a build inside a checkout of the language work with no configuration.
import FileLoader from @ens.sema.support.loader;
import @std.path;

// The folder containing 'std/', or empty text when neither the environment nor the walk found one.
export findRoot(FileLoader loader, string? environment, string startFolder) -> string {
    if (environment != null && environment.length > 0 && loader.exists(environment)) {
        return environment;
    }
    string folder = path.normalize(startFolder);
    while (folder.length > 0) {
        string libs = path.join(folder, "libs");
        if (loader.exists(path.join(libs, "std/ens.package"))) {
            return libs;
        }
        string parent = path.parentFolder(folder);
        if (parent.length == 0 || parent == folder) {
            return "";
        }
        folder = parent;
    }
    return "";
}

// What to tell a user whose build found no standard library.
export missingMessage() -> string {
    return "the standard library could not be found; pass '--stdlib <folder>' naming the folder "
        + "that holds 'std/', or set ENS_STDLIB to it";
}
