// The names a build keeps its object files under. An object is named after the emitted name, which is
// its stem and its module, and the digest of its bytes, so a name only ever holds one content: two
// builds of the same sources keep the same names, and keeping an object never replaces another one.
import Path from @std.fs;
import FileSystemError from @std.fs.error;
import List from @std.collections.list;
import Set from @std.collections.set;

final class ObjectNames {
    // How many hex digits of an object's digest its name carries, the 64 bits of FNV-1a.
    protected static const long digestDigits = 16;
}

// The name an object emitted as 'emitted', such as 'app.main.obj', is kept under once its bytes are
// known: 'app.main.<digest>.obj'.
export contentName(string emitted, byte[] bytes) -> string {
    string digest = digestOf(bytes);
    long dot = emitted.lastIndexOf(".");
    if (dot < 0) {
        return emitted + "." + digest;
    }
    return emitted.substring(0, dot) + "." + digest + emitted.substring(dot);
}

// The emitted name a kept name came from, its digest taken out, which every version of one object
// shares. A name that carries no digest, as an earlier build wrote them, is its own emitted name.
export emittedNameOf(string kept) -> string {
    long extension = kept.lastIndexOf(".");
    if (extension < 0) {
        return kept;
    }
    long digest = kept.substring(0, extension).lastIndexOf(".");
    if (digest < 0 || !isDigest(kept.substring(digest + 1, extension))) {
        return kept;
    }
    return kept.substring(0, digest) + kept.substring(extension);
}

// The names among 'present', a folder's files, that a build which kept 'kept' clears: every other
// version of an object it kept. An object of a module it did not emit is left alone.
export staleNames(string[] present, string[] kept) -> string[] {
    let keptNames = new Set<string>();
    let emitted = new Set<string>();
    for (let name in kept) {
        keptNames.add(name);
        emitted.add(emittedNameOf(name));
    }
    let stale = new List<string>();
    for (let name in present) {
        if (!keptNames.contains(name) && emitted.contains(emittedNameOf(name))) {
            stale.push(name);
        }
    }
    return stale.toArray();
}

// Puts the object at 'staged' in 'folder' under 'name'. A name already there holds the same bytes,
// since the name is their digest, so it is kept as it is and the staged copy is left to be discarded
// with its folder.
export keepObject(Path staged, Path folder, string name) -> Path throws FileSystemError {
    Path destination = folder.join(name);
    if (!destination.exists()) {
        try staged.moveTo(destination);
    }
    return destination;
}

// The 64-bit FNV-1a digest of the bytes as 16 lowercase hex digits. It tells apart the versions of
// one object a folder holds, which no one chooses to make collide, and it is quick over the
// megabytes a large program's objects come to.
export digestOf(byte[] bytes) -> string {
    ulong hash = 14695981039346656037 as ulong;
    for (let value in bytes) {
        hash = hash ^ (value as ulong);
        hash = hash * (1099511628211 as ulong);
    }
    string digits = "0123456789abcdef";
    string written = "";
    for (long shift = 60; shift >= 0; shift = shift - 4) {
        long nibble = ((hash >> (shift as ulong)) & (15 as ulong)) as long;
        written = written + digits.substring(nibble, nibble + 1);
    }
    return written;
}

isDigest(string text) -> bool {
    if (text.length != ObjectNames.digestDigits) {
        return false;
    }
    for (let value in text.bytes()) {
        bool digit = value >= '0' && value <= '9';
        bool letter = value >= 'a' && value <= 'f';
        if (!digit && !letter) {
            return false;
        }
    }
    return true;
}
