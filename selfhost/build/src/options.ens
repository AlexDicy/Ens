// One invocation, as a value. Everything a build reads about how it was asked to run is in here,
// settled before any work starts and never changed afterwards: the folder the command was run
// from, the code-generation settings, where the standard library lives, where the artifacts go,
// and how much the run says out loud.
//
// The working folder is read once, at startup, and carried here. Nothing changes the process's own
// working folder, so two builds in one process would never be able to interfere - which is why
// every relative path a build resolves is resolved against this value.
import CodegenSettings from @ens.codegen.settings;

// How much a run says out loud: a quiet run reports only problems, a verbose run reports each step
// it takes, and an ordinary run reports what it produced.
export enum Verbosity {
    Quiet,
    Normal,
    Verbose,
}

export final class BuildOptions {
    string invocationFolder;
    CodegenSettings settings;

    string stdlibFolder;
    string outputFile;
    string objectsFolder;
    string artifactsRoot;

    bool noNetwork;
    bool lockFixed;

    Verbosity level;

    export constructor(string workingFolder, CodegenSettings settings, string stdlibRoot,
                       string output, string objectsFolder, bool offline, bool locked,
                       Verbosity verbosity, string artifactRoot = "") {
        this.invocationFolder = workingFolder;
        this.settings = settings;
        this.stdlibFolder = stdlibRoot;
        this.outputFile = output;
        this.objectsFolder = objectsFolder;
        this.artifactsRoot = artifactRoot;
        this.noNetwork = offline;
        this.lockFixed = locked;
        this.level = verbosity;
    }

    // The folder the command was run from, every relative path resolving against it.
    export workingFolder() -> string {
        return this.invocationFolder;
    }

    export codegen() -> CodegenSettings {
        return this.settings;
    }

    export targetTriple() -> string {
        return this.settings.targetTriple();
    }

    // The folder holding 'std/', or empty text when nothing has said where it is yet.
    export stdlibRoot() -> string {
        return this.stdlibFolder;
    }

    // The same invocation with the standard library settled. Where it is depends on what was being
    // built, which is known only once the target has been resolved, so it arrives after the rest.
    export withStdlibRoot(string root) -> BuildOptions {
        return new BuildOptions(this.invocationFolder, this.settings, root, this.outputFile,
            this.objectsFolder, this.noNetwork, this.lockFixed, this.level, this.artifactsRoot);
    }

    // The folder a build keeps what it produces under, which is the build root of whatever was
    // being built and so arrives once the target has been resolved.
    export artifactRoot() -> string {
        return this.artifactsRoot;
    }

    export withArtifactRoot(string root) -> BuildOptions {
        return new BuildOptions(this.invocationFolder, this.settings, this.stdlibFolder,
            this.outputFile, this.objectsFolder, this.noNetwork, this.lockFixed, this.level, root);
    }

    // The same invocation building its object files somewhere named outright. A command that builds
    // a program only in order to run it says where that way: it builds in a folder of its own that
    // it removes afterwards, so its objects belong there rather than under a build root.
    export withObjectsFolder(string folder) -> BuildOptions {
        return new BuildOptions(this.invocationFolder, this.settings, this.stdlibFolder,
            this.outputFile, folder, this.noNetwork, this.lockFixed, this.level,
            this.artifactsRoot);
    }

    // Whether the run may reach the network at all. Everything it needs has to be in the cache
    // already, and anything that is not fails the build by name.
    export offline() -> bool {
        return this.noNetwork;
    }

    // Whether ens.lock may change. A run that may not change it stops instead, saying what it would
    // have had to change, which is what a build that has to be reproducible wants.
    export locked() -> bool {
        return this.lockFixed;
    }

    // Where the executable goes, or empty text when the build names it after what it built.
    export output() -> string {
        return this.outputFile;
    }

    export namesOutput() -> bool {
        return this.outputFile.length > 0;
    }

    // Where the object files go, or empty text when they go under the build root.
    export objects() -> string {
        return this.objectsFolder;
    }

    export verbosity() -> Verbosity {
        return this.level;
    }
}
