// `ens` is also a version multiplexer: a build root written for a newer version of Ens than this one
// delegates the whole command to the newest installed toolchain that is at least that version, and a
// command line can name the toolchain outright.
import Path from @std.fs;
import EntryKind from @std.fs.metadata;
import FileSystemError from @std.fs.error;
import ProcessError from @std.process;
import @std.process;
import List from @std.collections.list;
import Environment from @std.environment;
import Platform from @std.platform;
import @ens.host.home;
import @ens.host.childexit;
import platform;
import Reporter from report;
import report;
import Version from @ens.language.version;
import Version as VersionNumber from @ens.packages.versions;
import @ens.packages.versions;

// What the command line and the environment named as the toolchain that does the work.
export final class ToolchainRequest {
    string optionText;
    string environmentText;

    export constructor(this.optionText, this.environmentText);

    // The version '--toolchain' named, or empty text when the command line named none.
    export option() -> string {
        return this.optionText;
    }

    // The version ENS_TOOLCHAIN named, or empty text when the environment named none.
    export environmentValue() -> string {
        return this.environmentText;
    }
}

// One installed toolchain: the version it is, and the program that is it.
export final class InstalledToolchain {
    string toolchainVersion;
    Path programFile;

    export constructor(this.toolchainVersion, this.programFile);

    export version() -> string {
        return this.toolchainVersion;
    }

    export program() -> Path {
        return this.programFile;
    }
}

// Every toolchain installed in the toolchains folder, with the folder they were looked for in and the
// name one of their programs carries, so a run that requested a missing one can report where it searched and
// what it would have taken to be there.
export final class InstalledToolchains {
    Path? rootFolder;
    string programFileName;
    InstalledToolchain[] found;
    string userFolderVariable;

    export constructor(this.rootFolder, this.programFileName, this.found,
                       this.userFolderVariable = "HOME");

    // The variable that names the user's own folder, which the toolchains folder is under when
    // 'ENS_TOOLCHAINS' is not set.
    export userVariable() -> string {
        return this.userFolderVariable;
    }

    // The toolchains folder, or empty text when no setting names where that is.
    export root() -> Path? {
        return this.rootFolder;
    }

    // What the program of an installed toolchain is called on this machine.
    export programName() -> string {
        return this.programFileName;
    }

    export versions() -> string[] {
        let named = new List<string>();
        for (let one in this.found) {
            named.push(one.version());
        }
        return named.toArray();
    }

    // The newest installed toolchain whose version is at least `lowest`, or null when none is. A
    // folder whose name is not a release version is never chosen this way, and of two folders
    // naming the same version the first in the order they were found is kept.
    export newestAtLeast(VersionNumber lowest) -> InstalledToolchain? {
        InstalledToolchain? newest = null;
        VersionNumber? newestVersion = null;
        for (let one in this.found) {
            let candidate = versions.release(one.version());
            if (candidate != null && versions.compare(candidate, lowest) >= 0
                    && (newestVersion == null || versions.compare(candidate, newestVersion) > 0)) {
                newest = one;
                newestVersion = candidate;
            }
        }
        return newest;
    }

    // The program that is the named version, or empty text when that version is not installed.
    export programOf(string version) -> Path? {
        for (let one in this.found) {
            if (one.version() == version) {
                return one.program();
            }
        }
        return null;
    }
}

// Which toolchain does the work, why, and what a command line that cannot be acted on got wrong.
export final class ToolchainDecision {
    string chosenVersion;
    Path? chosenProgram;
    string problem;
    string reason;

    protected constructor(this.chosenVersion, this.chosenProgram, this.problem, this.reason);

    // Whether another toolchain does the work, which is exactly when there is a program to run.
    export delegates() -> bool {
        return this.chosenProgram != null;
    }

    // The version doing the work when it is not this one, and empty text when this one is.
    export version() -> string {
        return this.chosenVersion;
    }

    // The program to run, when the work is delegated to another toolchain.
    export program() -> Path? {
        return this.chosenProgram;
    }

    // Why the command line cannot be acted on, or empty text when it can.
    export failure() -> string {
        return this.problem;
    }

    // What a verbose run prints about this choice, or empty text when the
    // choice is the obvious one and there is nothing worth printing.
    export explanation() -> string {
        return this.reason;
    }
}

// Whether another toolchain ran the command, and with what.
export final class Handoff {
    bool completed;
    int code;

    protected constructor(this.completed, this.code);

    // Whether the command is complete: another toolchain ran it, or it requested one that is not
    // there. Either way there is nothing left for this toolchain to do.
    export finished() -> bool {
        return this.completed;
    }

    // The exit code the command ended with, which means something only once it is finished.
    export exitCode() -> int {
        return this.code;
    }
}

// Selects the toolchain that does the work and, when it is another one, runs it and returns its
// exit code. `argv` is what this process was given after its own name, forwarded exactly as it
// was given so the other toolchain reads the command line this one was given.
export hand(Environment environment, ToolchainRequest request, string governingVersion,
            Path buildRoot, string[] argv, Reporter reporter) -> Handoff {
    let installed = discover(root(environment), environment.platform());
    let decision = select(request, governingVersion, buildRoot, Version.release, installed);
    if (decision.failure().length > 0) {
        reporter.problem(decision.failure());
        return new Handoff(true, 2);
    }
    if (decision.explanation().length > 0) {
        reporter.step(decision.explanation());
    }
    if (!decision.delegates()) {
        return new Handoff(false, 0);
    }
    Path? chosen = decision.program();
    if (chosen == null) {
        return new Handoff(false, 0);
    }
    return new Handoff(true, runToolchain(chosen, decision.version(), argv, reporter));
}

// Which toolchain does the work. `governing` is the version the build root in `buildRoot` is written
// for, `running` is the release this toolchain is, and `installed` is what was found in the
// toolchains folder. A declared version is the oldest one the build root can be built with, so the
// work leaves this toolchain only when this toolchain is older than the declared version.
export select(ToolchainRequest request, string governing, Path buildRoot, string running,
              InstalledToolchains installed) -> ToolchainDecision {
    string requested = request.option();
    if (requested.length == 0) {
        requested = request.environmentValue();
    }
    if (requested == ToolchainVersions.local || requested == running) {
        return buildHere("");
    }
    if (request.environmentValue() == ToolchainVersions.local) {
        string named = requestWording(request, requested);
        return buildHere("Building with this toolchain: 'ENS_TOOLCHAIN=local' is set, so {named} "
            + "is not used");
    }
    if (requested.length > 0) {
        return honorRequest(request, requested, running, installed);
    }
    let declared = versions.parsed(governing);
    let current = versions.release(running);
    if (declared == null || current == null || versions.compare(declared, current) <= 0) {
        return buildHere("");
    }
    string needs = "'{buildRoot}' declares 'ens \"{governing}\";', so it needs Ens {governing} or "
        + "later, and this toolchain is Ens {running}";
    let newest = installed.newestAtLeast(declared);
    if (newest == null) {
        return new ToolchainDecision("", null, needs + ". " + noneNewEnough(installed, governing),
            "");
    }
    Path program = newest.program();
    return new ToolchainDecision(newest.version(), program, "",
        "{needs}. Ens {newest.version()} at '{program}' is building it");
}

// Why no installed toolchain can build a build root written for `governing`, and what to do.
noneNewEnough(InstalledToolchains installed, string governing) -> string {
    string local = "write '--toolchain local' to build with this toolchain anyway";
    if (installed.root() == null) {
        return "There is no toolchains folder to look in: " + noFolderReason(installed) + ". Set "
            + "'ENS_TOOLCHAINS' to the folder your toolchains are in, or {local}";
    }
    return "No installed toolchain is Ens {governing} or later: " + foundInstead(installed)
        + ". Install Ens {governing} or later in a folder named after its version, such as '"
        + installedAt(installed, "{governing}.0") + "', or {local}";
}

// A version the command line or the environment requested by name. Requesting one that is not here
// is a usage problem: it names a toolchain, and there is no toolchain to name.
honorRequest(ToolchainRequest request, string requested, string running,
             InstalledToolchains installed) -> ToolchainDecision {
    string named = requestWording(request, requested);
    Path? program = installed.programOf(requested);
    if (program != null) {
        return new ToolchainDecision(requested, program, "",
            "{named} names Ens {requested}, so '{program}' is building it");
    }
    string local = "write '--toolchain local' to build with this toolchain, Ens {running}";
    if (installed.root() == null) {
        return new ToolchainDecision("", null, "{named} names Ens {requested}, and there is no "
            + "toolchains folder to look in: " + noFolderReason(installed) + ". Set "
            + "'ENS_TOOLCHAINS' to the folder your toolchains are in, or {local}", "");
    }
    return new ToolchainDecision("", null, "{named} names Ens {requested}, which is not "
        + "installed: " + foundInstead(installed) + ". Install Ens {requested} as '"
        + installedAt(installed, requested) + "', or {local}", "");
}

// The toolchains folder: the folder ENS_TOOLCHAINS names, else '.ens/toolchains' under this user's
// own folder, or empty text when neither names where.
export root(Environment environment) -> Path? {
    string? named = environment.get("ENS_TOOLCHAINS");
    if (named != null && named.length > 0) {
        return Path.fromNative(named, environment.platform()).normalize();
    }
    return home.ensFolder(environment, "toolchains");
}

// The toolchains installed under `root`: one folder per version, each holding the program that is
// that version. A folder without that program is not a toolchain, so something else left in there
// cannot make a version look installed. What the program is called follows `host`, because the
// toolchain that runs has to run on this machine whatever the build is targeting.
export discover(Path? root, Platform host) -> InstalledToolchains {
    string program = platform.executableNamed("ens", host);
    let found = new List<InstalledToolchain>();
    if (root != null && root.isDirectory()) {
        for (let child in try root.entries()) {
            Path candidate = child.path.join(program);
            if (child.kind == EntryKind.Directory && candidate.isFile()) {
                found.push(new InstalledToolchain(child.name, candidate));
            }
        }
    }
    return new InstalledToolchains(root, program, found.toArray(), userVariableFor(host));
} catch (FileSystemError refused) {
    InstalledToolchain[] none = [];
    return new InstalledToolchains(root, platform.executableNamed("ens", host), none,
        userVariableFor(host));
}

// The variable that names the user's own folder on a machine of the `host` system.
userVariableFor(Platform host) -> string {
    if (host == Platform.Windows) {
        return "USERPROFILE";
    }
    return "HOME";
}

// Delegates the whole command to another toolchain: the arguments exactly as they were given, its streams
// left with this process so its output appears as it is written, and ENS_TOOLCHAIN=local in its
// environment, which is what stops it delegating the work again. One hop is all there ever is.
runToolchain(Path program, string version, string[] argv, Reporter reporter) -> int {
    let pinned = Environment.current();
    pinned.set("ENS_TOOLCHAIN", ToolchainVersions.local);
    let ran = try process.run(program, argv, environment: pinned);
    return childexit.exitCodeOf(ran.status);
} catch (ProcessError refused) {
    reporter.problem("the Ens {version} toolchain is installed, but {refused.message}");
    return 1;
}

final class ToolchainVersions {
    // The version that means "this one", whatever this one is.
    protected static const string local = "local";
}

buildHere(string reason) -> ToolchainDecision {
    return new ToolchainDecision("", null, "", reason);
}

// How the version was requested, so a message names what the reader wrote.
requestWording(ToolchainRequest request, string requested) -> string {
    if (request.option().length > 0) {
        return "'--toolchain {requested}'";
    }
    return "'ENS_TOOLCHAIN={requested}'";
}

// What the toolchains folder contains, once there is one.
foundInstead(InstalledToolchains installed) -> string {
    string[] versions = installed.versions();
    if (versions.length == 0) {
        return "'{installed.root()}' contains no toolchain";
    }
    return "'{installed.root()}' contains only " + report.quotedNames(versions);
}

noFolderReason(InstalledToolchains installed) -> string {
    return "neither 'ENS_TOOLCHAINS' nor '{installed.userVariable()}' is set";
}

// Where a requested version's program would be under the toolchains folder. Only a message
// calls this, and only after the folder is resolved, so a caller that has none never reaches here.
installedAt(InstalledToolchains installed, string requested) -> string {
    Path? root = installed.root();
    if (root == null) {
        return installed.programName();
    }
    return root.join(requested).join(installed.programName()).toString();
}
