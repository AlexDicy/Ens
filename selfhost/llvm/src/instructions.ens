// The builder instruction surface, less the memory and atomic operations. Each one is a free
// function taking the builder, because an Ens class cannot span files and a single Builder wrapper
// could not hold this and the memory surface separately.

import Builder from core;
import LLVMBuilderRef from core;
import Value from values;
import LLVMValueRef from values;
import TypeRef from types;
import LLVMTypeRef from types;
import BasicBlock from blocks;
import LLVMBasicBlockRef from blocks;

external from llvm {
    LLVMBuildRet(LLVMBuilderRef builder, LLVMValueRef value) -> LLVMValueRef;
    LLVMBuildRetVoid(LLVMBuilderRef builder) -> LLVMValueRef;
    LLVMBuildBr(LLVMBuilderRef builder, LLVMBasicBlockRef destination) -> LLVMValueRef;
    LLVMBuildCondBr(LLVMBuilderRef builder, LLVMValueRef condition, LLVMBasicBlockRef thenBlock,
        LLVMBasicBlockRef elseBlock) -> LLVMValueRef;
    LLVMBuildSwitch(LLVMBuilderRef builder, LLVMValueRef value, LLVMBasicBlockRef elseBlock,
        uint caseCount) -> LLVMValueRef;
    LLVMAddCase(LLVMValueRef switchInstruction, LLVMValueRef onValue, LLVMBasicBlockRef destination);
    LLVMBuildUnreachable(LLVMBuilderRef builder) -> LLVMValueRef;

    LLVMBuildCall2(LLVMBuilderRef builder, LLVMTypeRef functionType, LLVMValueRef function,
        LLVMValueRef[] arguments, uint argumentCount, string name) -> LLVMValueRef;

    LLVMBuildAdd(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildSub(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildMul(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildSDiv(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildUDiv(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildSRem(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildURem(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildFAdd(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildFSub(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildFMul(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildFDiv(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildFRem(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildAnd(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildOr(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildXor(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildShl(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildAShr(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildLShr(LLVMBuilderRef builder, LLVMValueRef lhs, LLVMValueRef rhs, string name)
        -> LLVMValueRef;
    LLVMBuildNeg(LLVMBuilderRef builder, LLVMValueRef value, string name) -> LLVMValueRef;
    LLVMBuildFNeg(LLVMBuilderRef builder, LLVMValueRef value, string name) -> LLVMValueRef;
    LLVMBuildNot(LLVMBuilderRef builder, LLVMValueRef value, string name) -> LLVMValueRef;

    LLVMBuildICmp(LLVMBuilderRef builder, int predicate, LLVMValueRef lhs, LLVMValueRef rhs,
        string name) -> LLVMValueRef;
    LLVMBuildFCmp(LLVMBuilderRef builder, int predicate, LLVMValueRef lhs, LLVMValueRef rhs,
        string name) -> LLVMValueRef;

    LLVMBuildTrunc(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildZExt(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildSExt(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildFPTrunc(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildFPExt(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildSIToFP(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildUIToFP(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildFPToSI(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildFPToUI(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildBitCast(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildPtrToInt(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        string name) -> LLVMValueRef;
    LLVMBuildIntCast2(LLVMBuilderRef builder, LLVMValueRef value, LLVMTypeRef destinationType,
        int isSigned, string name) -> LLVMValueRef;

    LLVMBuildSelect(LLVMBuilderRef builder, LLVMValueRef condition, LLVMValueRef thenValue,
        LLVMValueRef elseValue, string name) -> LLVMValueRef;
    LLVMBuildInsertValue(LLVMBuilderRef builder, LLVMValueRef aggregate, LLVMValueRef element,
        uint index, string name) -> LLVMValueRef;
    LLVMBuildExtractValue(LLVMBuilderRef builder, LLVMValueRef aggregate, uint index, string name)
        -> LLVMValueRef;
}

// ---- Terminators ----

export buildRet(Builder builder, Value value) -> Value {
    return new Value(LLVMBuildRet(builder.builderHandle, value.valueHandle));
}

export buildRetVoid(Builder builder) -> Value {
    return new Value(LLVMBuildRetVoid(builder.builderHandle));
}

export buildBr(Builder builder, BasicBlock destination) -> Value {
    return new Value(LLVMBuildBr(builder.builderHandle, destination.blockHandle));
}

export buildCondBr(Builder builder, Value condition, BasicBlock thenBlock, BasicBlock elseBlock)
        -> Value {
    return new Value(LLVMBuildCondBr(builder.builderHandle, condition.valueHandle,
        thenBlock.blockHandle, elseBlock.blockHandle));
}

// A switch over an integer value with the given default block, sized for caseCount cases; add
// each case with addCase.
export buildSwitch(Builder builder, Value value, BasicBlock elseBlock, uint caseCount) -> Value {
    return new Value(LLVMBuildSwitch(builder.builderHandle, value.valueHandle,
        elseBlock.blockHandle, caseCount));
}

export addCase(Value switchInstruction, Value onValue, BasicBlock destination) {
    LLVMAddCase(switchInstruction.valueHandle, onValue.valueHandle, destination.blockHandle);
}

export buildUnreachable(Builder builder) -> Value {
    return new Value(LLVMBuildUnreachable(builder.builderHandle));
}

// ---- Calls ----

// A call through the given function type to the callee (a function or a loaded function pointer).
export buildCall(Builder builder, TypeRef functionType, Value function, Value[] arguments,
        string name) -> Value {
    LLVMValueRef[] handles = new LLVMValueRef[arguments.length];
    for (long i = 0; i < handles.length; i++) {
        handles[i] = arguments[i].valueHandle;
    }
    return new Value(LLVMBuildCall2(builder.builderHandle, functionType.typeHandle,
        function.valueHandle, handles, handles.length as uint, name));
}

// ---- Integer and floating-point arithmetic ----

export buildAdd(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildAdd(builder.builderHandle, lhs.valueHandle, rhs.valueHandle, name));
}

export buildSub(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildSub(builder.builderHandle, lhs.valueHandle, rhs.valueHandle, name));
}

