// ---- Integer comparisons (LLVMIntPredicate constants) ----

export buildICmpEQ(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 32, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpNE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 33, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpUGT(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 34, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpUGE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 35, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpULT(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 36, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpULE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 37, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpSGT(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 38, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpSGE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 39, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpSLT(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 40, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildICmpSLE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildICmp(builder.builderHandle, 41, lhs.valueHandle, rhs.valueHandle,
        name));
}

// ---- Ordered floating-point comparisons (LLVMRealPredicate constants) ----

export buildFCmpOEQ(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildFCmp(builder.builderHandle, 1, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildFCmpOGT(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildFCmp(builder.builderHandle, 2, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildFCmpOGE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildFCmp(builder.builderHandle, 3, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildFCmpOLT(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildFCmp(builder.builderHandle, 4, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildFCmpOLE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildFCmp(builder.builderHandle, 5, lhs.valueHandle, rhs.valueHandle,
        name));
}

export buildFCmpONE(Builder builder, Value lhs, Value rhs, string name) -> Value {
    return new Value(LLVMBuildFCmp(builder.builderHandle, 6, lhs.valueHandle, rhs.valueHandle,
        name));
}

// ---- Casts ----

export buildTrunc(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildTrunc(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildZExt(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildZExt(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildSExt(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildSExt(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildFPTrunc(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildFPTrunc(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildFPExt(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildFPExt(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildSIToFP(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildSIToFP(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildUIToFP(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildUIToFP(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildFPToSI(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildFPToSI(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildFPToUI(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildFPToUI(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildBitCast(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildBitCast(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

export buildPtrToInt(Builder builder, Value value, TypeRef destinationType, string name) -> Value {
    return new Value(LLVMBuildPtrToInt(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, name));
}

// An integer width change to destinationType, sign- or zero-extending per signed.
export buildIntCast(Builder builder, Value value, TypeRef destinationType, bool signed,
        string name) -> Value {
    return new Value(LLVMBuildIntCast2(builder.builderHandle, value.valueHandle,
        destinationType.typeHandle, signed ? 1 : 0, name));
}

// ---- Selection and aggregates ----

export buildSelect(Builder builder, Value condition, Value thenValue, Value elseValue, string name)
        -> Value {
    return new Value(LLVMBuildSelect(builder.builderHandle, condition.valueHandle,
        thenValue.valueHandle, elseValue.valueHandle, name));
}

export buildInsertValue(Builder builder, Value aggregate, Value element, uint index, string name)
        -> Value {
    return new Value(LLVMBuildInsertValue(builder.builderHandle, aggregate.valueHandle,
        element.valueHandle, index, name));
}

export buildExtractValue(Builder builder, Value aggregate, uint index, string name) -> Value {
    return new Value(LLVMBuildExtractValue(builder.builderHandle, aggregate.valueHandle, index,
        name));
}
