// The memory and atomic builder surface: stack slots, loads, stores, address computation, the bulk
// memory intrinsics, and the atomic operations the reference counter and weak side table need.
// Monotonic, Acquire, Release and AcquireRelease are all reachable through the ordering helpers.

import Builder from core;
import LLVMBuilderRef from core;
import Value from values;
import LLVMValueRef from values;
import TypeRef from types;
import LLVMTypeRef from types;

external from llvm {
    LLVMBuildAlloca(LLVMBuilderRef builder, LLVMTypeRef type, string name) -> LLVMValueRef;
    LLVMBuildArrayAlloca(LLVMBuilderRef builder, LLVMTypeRef type, LLVMValueRef count,
        string name) -> LLVMValueRef;
    LLVMBuildLoad2(LLVMBuilderRef builder, LLVMTypeRef type, LLVMValueRef pointer, string name)
        -> LLVMValueRef;
    LLVMBuildStore(LLVMBuilderRef builder, LLVMValueRef value, LLVMValueRef pointer)
        -> LLVMValueRef;
    LLVMBuildGEP2(LLVMBuilderRef builder, LLVMTypeRef type, LLVMValueRef pointer,
        LLVMValueRef[] indices, uint indexCount, string name) -> LLVMValueRef;
    LLVMBuildInBoundsGEP2(LLVMBuilderRef builder, LLVMTypeRef type, LLVMValueRef pointer,
        LLVMValueRef[] indices, uint indexCount, string name) -> LLVMValueRef;
    LLVMBuildStructGEP2(LLVMBuilderRef builder, LLVMTypeRef structType, LLVMValueRef pointer,
        uint index, string name) -> LLVMValueRef;
    LLVMBuildMemCpy(LLVMBuilderRef builder, LLVMValueRef destination, uint destinationAlignment,
        LLVMValueRef source, uint sourceAlignment, LLVMValueRef size) -> LLVMValueRef;
    LLVMBuildMemSet(LLVMBuilderRef builder, LLVMValueRef pointer, LLVMValueRef value,
        LLVMValueRef length, uint alignment) -> LLVMValueRef;

    LLVMBuildAtomicRMW(LLVMBuilderRef builder, int operation, LLVMValueRef pointer,
        LLVMValueRef value, int ordering, int singleThread) -> LLVMValueRef;
    LLVMBuildAtomicCmpXchg(LLVMBuilderRef builder, LLVMValueRef pointer, LLVMValueRef comparand,
        LLVMValueRef replacement, int successOrdering, int failureOrdering, int singleThread)
        -> LLVMValueRef;
    LLVMSetOrdering(LLVMValueRef memoryAccess, int ordering);
    LLVMSetAlignment(LLVMValueRef memoryAccess, uint bytes);
}

// ---- LLVMAtomicOrdering values ----

export final class AtomicOrdering {
    export static const int monotonic = 2;
    export static const int acquire = 4;
    export static const int release = 5;
    export static const int acquireRelease = 6;
    export static const int sequentiallyConsistent = 7;
}

// ---- Memory ----

export buildAlloca(Builder builder, TypeRef type, string name) -> Value {
    return new Value(LLVMBuildAlloca(builder.builderHandle, type.typeHandle, name));
}

// A stack slot holding `count` values of the type, where the count is computed at run time.
export buildArrayAlloca(Builder builder, TypeRef type, Value count, string name) -> Value {
    return new Value(LLVMBuildArrayAlloca(builder.builderHandle, type.typeHandle,
        count.valueHandle, name));
}

export buildLoad(Builder builder, TypeRef type, Value pointer, string name) -> Value {
    return new Value(LLVMBuildLoad2(builder.builderHandle, type.typeHandle, pointer.valueHandle,
        name));
}

export buildStore(Builder builder, Value value, Value pointer) -> Value {
    return new Value(LLVMBuildStore(builder.builderHandle, value.valueHandle, pointer.valueHandle));
}

// A getelementptr from the base pointer through the given index values.
export buildGEP(Builder builder, TypeRef type, Value pointer, Value[] indices, string name)
        -> Value {
    return new Value(LLVMBuildGEP2(builder.builderHandle, type.typeHandle, pointer.valueHandle,
        indexHandlesOf(indices), indices.length as uint, name));
}

export buildInBoundsGEP(Builder builder, TypeRef type, Value pointer, Value[] indices, string name)
        -> Value {
    return new Value(LLVMBuildInBoundsGEP2(builder.builderHandle, type.typeHandle,
        pointer.valueHandle, indexHandlesOf(indices), indices.length as uint, name));
}

// A getelementptr to field index of the given struct type.
export buildStructGEP(Builder builder, TypeRef structType, Value pointer, uint index, string name)
        -> Value {
    return new Value(LLVMBuildStructGEP2(builder.builderHandle, structType.typeHandle,
        pointer.valueHandle, index, name));
}

export buildMemCpy(Builder builder, Value destination, uint destinationAlignment, Value source,
        uint sourceAlignment, Value size) -> Value {
    return new Value(LLVMBuildMemCpy(builder.builderHandle, destination.valueHandle,
        destinationAlignment, source.valueHandle, sourceAlignment, size.valueHandle));
}

export buildMemSet(Builder builder, Value pointer, Value value, Value length, uint alignment)
        -> Value {
    return new Value(LLVMBuildMemSet(builder.builderHandle, pointer.valueHandle, value.valueHandle,
        length.valueHandle, alignment));
}

// ---- Atomics (LLVMAtomicRMWBinOp: Xchg 0, Add 1, Sub 2) ----

export buildAtomicAdd(Builder builder, Value pointer, Value value, int ordering) -> Value {
    return new Value(LLVMBuildAtomicRMW(builder.builderHandle, 1, pointer.valueHandle,
        value.valueHandle, ordering, 0));
}

export buildAtomicSub(Builder builder, Value pointer, Value value, int ordering) -> Value {
    return new Value(LLVMBuildAtomicRMW(builder.builderHandle, 2, pointer.valueHandle,
        value.valueHandle, ordering, 0));
}

export buildAtomicExchange(Builder builder, Value pointer, Value value, int ordering) -> Value {
    return new Value(LLVMBuildAtomicRMW(builder.builderHandle, 0, pointer.valueHandle,
        value.valueHandle, ordering, 0));
}

// A compare-and-exchange yielding a { value, i1 } aggregate; unpack it with extractValue.
export buildAtomicCompareExchange(Builder builder, Value pointer, Value comparand,
        Value replacement, int successOrdering, int failureOrdering) -> Value {
    return new Value(LLVMBuildAtomicCmpXchg(builder.builderHandle, pointer.valueHandle,
        comparand.valueHandle, replacement.valueHandle, successOrdering, failureOrdering, 0));
}

// Marks a load or store atomic with the given ordering.
export setOrdering(Value memoryAccess, int ordering) {
    LLVMSetOrdering(memoryAccess.valueHandle, ordering);
}

// Sets the alignment, in bytes, of an alloca, load, or store.
export setAlignment(Value memoryAccess, uint bytes) {
    LLVMSetAlignment(memoryAccess.valueHandle, bytes);
}

// The raw handles behind an array of value wrappers, for a foreign call taking LLVMValueRef[].
indexHandlesOf(Value[] indices) -> LLVMValueRef[] {
    LLVMValueRef[] handles = new LLVMValueRef[indices.length];
    for (long i = 0; i < handles.length; i++) {
        handles[i] = indices[i].valueHandle;
    }
    return handles;
}
