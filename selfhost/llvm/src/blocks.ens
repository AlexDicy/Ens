// LLVM basic blocks: the leaves of a function's control-flow graph. The handle is package-wide
// so the builder and core modules can position at and branch to a block.

import Value from values;
import LLVMValueRef from values;

public external type LLVMBasicBlockRef;

external from llvm {
    LLVMBlockAddress(LLVMValueRef function, LLVMBasicBlockRef block) -> LLVMValueRef;
}

// A basic block within a function.
export final class BasicBlock {
    public LLVMBasicBlockRef blockHandle;

    public constructor(this.blockHandle);
}

// The constant address of a block within its function, usable as a global initializer. The block
// may not be the function's entry block.
export blockAddress(Value function, BasicBlock block) -> Value {
    return new Value(LLVMBlockAddress(function.valueHandle, block.blockHandle));
}
