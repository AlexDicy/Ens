// Global variables, symbol linkage, and function and parameter attributes. Globals hold the
// private constant string data and the read-only tables the code generator emits; linkage marks a
// symbol external, internal, or private; the attribute helpers set the function attributes the
// generator relies on (NoUnwind, AlwaysInline, NoReturn) by name.

import Module from core;
import LLVMModuleRef from core;
import Context from core;
import LLVMContextRef from core;
import Builder from core;
import LLVMBuilderRef from core;
import Value from values;
import LLVMValueRef from values;
import TypeRef from types;
import LLVMTypeRef from types;

public external type LLVMAttributeRef;

external from llvm {
    LLVMAddGlobal(LLVMModuleRef module, LLVMTypeRef type, string name) -> LLVMValueRef;
    LLVMGetNamedGlobal(LLVMModuleRef module, string name) -> LLVMValueRef?;
    LLVMGetNamedFunction(LLVMModuleRef module, string name) -> LLVMValueRef?;
    LLVMSetInitializer(LLVMValueRef global, LLVMValueRef constant);
    LLVMSetGlobalConstant(LLVMValueRef global, int isConstant);
    LLVMSetLinkage(LLVMValueRef global, int linkage);
    LLVMSetUnnamedAddress(LLVMValueRef global, int unnamedAddress);
    LLVMSetAlignment(LLVMValueRef global, uint bytes);
    LLVMGetParam(LLVMValueRef function, uint index) -> LLVMValueRef;
    LLVMBuildGlobalStringPtr(LLVMBuilderRef builder, string text, string name) -> LLVMValueRef;

    LLVMGetEnumAttributeKindForName(string name, ulong nameLength) -> uint;
    LLVMCreateEnumAttribute(LLVMContextRef context, uint kindId, ulong value) -> LLVMAttributeRef;
    LLVMAddAttributeAtIndex(LLVMValueRef function, uint index, LLVMAttributeRef attribute);

    LLVMGetFirstFunction(LLVMModuleRef module) -> LLVMValueRef?;
    LLVMGetNextFunction(LLVMValueRef function) -> LLVMValueRef?;
    LLVMIsDeclaration(LLVMValueRef global) -> int;
}

// ---- LLVMLinkage values ----

export linkageExternal() -> int {
    return 0;
}

export linkageAppending() -> int {
    return 7;
}

export linkageInternal() -> int {
    return 8;
}

export linkagePrivate() -> int {
    return 9;
}

// ---- LLVMUnnamedAddr values ----

export unnamedAddressNone() -> int {
    return 0;
}

export unnamedAddressGlobal() -> int {
    return 2;
}

// ---- Globals ----

export addGlobal(Module module, TypeRef type, string name) -> Value {
    return new Value(LLVMAddGlobal(module.moduleHandle, type.typeHandle, name));
}

// The global with this name, or null when the module declares none.
export getNamedGlobal(Module module, string name) -> Value? {
    let found = LLVMGetNamedGlobal(module.moduleHandle, name);
    if (found == null) {
        return null;
    }
    return new Value(found);
}

// The function with this name, or null when the module declares none.
export getNamedFunction(Module module, string name) -> Value? {
    let found = LLVMGetNamedFunction(module.moduleHandle, name);
    if (found == null) {
        return null;
    }
    return new Value(found);
}

export setInitializer(Value global, Value constant) {
    LLVMSetInitializer(global.valueHandle, constant.valueHandle);
}

export setGlobalConstant(Value global, bool isConstant) {
    LLVMSetGlobalConstant(global.valueHandle, isConstant ? 1 : 0);
}

export setLinkage(Value global, int linkage) {
    LLVMSetLinkage(global.valueHandle, linkage);
}

export setUnnamedAddress(Value global, int unnamedAddress) {
    LLVMSetUnnamedAddress(global.valueHandle, unnamedAddress);
}

export setAlignment(Value global, uint bytes) {
    LLVMSetAlignment(global.valueHandle, bytes);
}

// The index-th parameter of a function value.
export getParam(Value function, uint index) -> Value {
    return new Value(LLVMGetParam(function.valueHandle, index));
}

// A private, NUL-terminated global string, returning a pointer to its bytes.
export buildGlobalString(Builder builder, string text, string name) -> Value {
    return new Value(LLVMBuildGlobalStringPtr(builder.builderHandle, text, name));
}

// Adds a named function attribute (for example "nounwind", "alwaysinline", or "noreturn") to the
// function itself. 4294967295 is LLVMAttributeFunctionIndex, the attribute index of the function.
export addFunctionAttribute(Context context, Value function, string name) {
    addFunctionAttributeValued(context, function, name, 0);
}

// The same for an attribute that carries an integer value, such as "uwtable" whose value 2 asks
// for asynchronous unwind tables.
export addFunctionAttributeValued(Context context, Value function, string name, ulong value) {
    let kind = LLVMGetEnumAttributeKindForName(name, name.length as ulong);
    let attribute = LLVMCreateEnumAttribute(context.contextHandle, kind, value);
    LLVMAddAttributeAtIndex(function.valueHandle, 4294967295 as uint, attribute);
}

// The module's first function, or null when it declares none; step with nextFunction.
export firstFunction(Module module) -> Value? {
    let found = LLVMGetFirstFunction(module.moduleHandle);
    if (found == null) {
        return null;
    }
    return new Value(found);
}

// The function after this one in its module, or null past the last.
export nextFunction(Value function) -> Value? {
    let found = LLVMGetNextFunction(function.valueHandle);
    if (found == null) {
        return null;
    }
    return new Value(found);
}

// True when the global is only declared here, with its definition in another module.
export isDeclaration(Value global) -> bool {
    return LLVMIsDeclaration(global.valueHandle) != 0;
}
