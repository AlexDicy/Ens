// The LLVM-C binding. Every opaque handle and foreign function is private to this file, because
// Ens external declarations carry no visibility and cannot be shared across modules; the public
// surface is the wrapper classes below, each holding one handle and exposing it only through
// their own methods. The foreign declarations are grouped by LLVM-C header area.

// llvm-c/Types.h and Target headers: the opaque reference types.
external type LLVMContextRef;
external type LLVMModuleRef;
external type LLVMBuilderRef;
external type LLVMTypeRef;
external type LLVMValueRef;
external type LLVMBasicBlockRef;
external type LLVMTargetRef;
external type LLVMTargetMachineRef;

// A char* the library owns; the caller passes null to decline the diagnostic message. Ens has no
// char** to string marshalling, so the text is never read back.
external type LLVMMessage;

external from llvm {
    // Core: context, module, and builder lifecycle.
    LLVMContextCreate() -> LLVMContextRef;
    LLVMContextDispose(LLVMContextRef context);
    LLVMModuleCreateWithNameInContext(string name, LLVMContextRef context) -> LLVMModuleRef;
    LLVMDisposeModule(LLVMModuleRef module);
    LLVMCreateBuilderInContext(LLVMContextRef context) -> LLVMBuilderRef;
    LLVMDisposeBuilder(LLVMBuilderRef builder);
    LLVMPositionBuilderAtEnd(LLVMBuilderRef builder, LLVMBasicBlockRef block);

    // Types.
    LLVMInt32TypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMFunctionType(LLVMTypeRef returnType, LLVMTypeRef[] parameterTypes, uint parameterCount,
        int isVarArg) -> LLVMTypeRef;

    // Constants.
    LLVMConstInt(LLVMTypeRef integerType, ulong value, int signExtend) -> LLVMValueRef;

    // Functions and basic blocks.
    LLVMAddFunction(LLVMModuleRef module, string name, LLVMTypeRef functionType) -> LLVMValueRef;
    LLVMAppendBasicBlockInContext(LLVMContextRef context, LLVMValueRef function, string name)
        -> LLVMBasicBlockRef;
    LLVMBuildRet(LLVMBuilderRef builder, LLVMValueRef value) -> LLVMValueRef;

    // Verification.
    LLVMVerifyModule(LLVMModuleRef module, int failureAction, LLVMMessage? outMessage) -> int;

    // Target, target machine, and object emission. The per-target initializers are the
    // linkable entry points (the LLVMInitializeAll* helpers are header-only), so the host
    // families are bound individually and one is chosen at run time.
    LLVMInitializeX86TargetInfo();
    LLVMInitializeX86Target();
    LLVMInitializeX86TargetMC();
    LLVMInitializeX86AsmPrinter();
    LLVMInitializeAArch64TargetInfo();
    LLVMInitializeAArch64Target();
    LLVMInitializeAArch64TargetMC();
    LLVMInitializeAArch64AsmPrinter();
    LLVMGetDefaultTargetTriple() -> string;
    LLVMGetTargetFromTriple(string triple, out LLVMTargetRef? target, LLVMMessage? outError)
        -> int;
    LLVMCreateTargetMachine(LLVMTargetRef target, string triple, string cpu, string features,
        int optimizationLevel, int relocationMode, int codeModel) -> LLVMTargetMachineRef;
    LLVMTargetMachineEmitToFile(LLVMTargetMachineRef machine, LLVMModuleRef module,
        string filename, int fileType, LLVMMessage? outError) -> int;
    LLVMDisposeTargetMachine(LLVMTargetMachineRef machine);
}

// A parsed LLVM type. Its handle is shared only inside this file.
export final class TypeRef {
    protected LLVMTypeRef typeHandle;

    protected constructor(this.typeHandle);

    // The function type returning this type over the given parameter types.
    export functionType(TypeRef[] parameterTypes) -> TypeRef {
        LLVMTypeRef[] handles = new LLVMTypeRef[parameterTypes.length];
        for (long i = 0; i < handles.length; i++) {
            handles[i] = parameterTypes[i].typeHandle;
        }
        return new TypeRef(LLVMFunctionType(this.typeHandle, handles,
            handles.length as uint, 0));
    }

    // The integer constant of this type with the given value.
    export constInt(ulong value) -> Value {
        return new Value(LLVMConstInt(this.typeHandle, value, 0));
    }
}

// An LLVM value: a constant, a function, or an instruction result.
export final class Value {
    protected LLVMValueRef valueHandle;

    protected constructor(this.valueHandle);
}

// A basic block within a function.
export final class BasicBlock {
    protected LLVMBasicBlockRef blockHandle;

    protected constructor(this.blockHandle);
}

// An IR builder positioned at an insertion point.
export final class Builder {
    protected LLVMBuilderRef builderHandle;

    protected constructor(this.builderHandle);

    export positionAtEnd(BasicBlock block) {
        LLVMPositionBuilderAtEnd(this.builderHandle, block.blockHandle);
    }

    export buildReturn(Value value) -> Value {
        return new Value(LLVMBuildRet(this.builderHandle, value.valueHandle));
    }

    export dispose() {
        LLVMDisposeBuilder(this.builderHandle);
    }
}

// An LLVM module: a container of functions and globals.
export final class Module {
    protected LLVMModuleRef moduleHandle;

    protected constructor(this.moduleHandle);

    export addFunction(string name, TypeRef functionType) -> Value {
        return new Value(LLVMAddFunction(this.moduleHandle, name, functionType.typeHandle));
    }

    // True when the module is well formed. Never aborts the process; a broken module returns
    // false with the diagnostic declined.
    export verify() -> bool {
        return LLVMVerifyModule(this.moduleHandle, 2, null) == 0;
    }

    export dispose() {
        LLVMDisposeModule(this.moduleHandle);
    }
}

// An LLVM context owning the types, values, and modules created through it.
export final class Context {
    protected LLVMContextRef contextHandle;

    protected constructor(this.contextHandle);

    export createModule(string name) -> Module {
        return new Module(LLVMModuleCreateWithNameInContext(name, this.contextHandle));
    }

    export int32Type() -> TypeRef {
        return new TypeRef(LLVMInt32TypeInContext(this.contextHandle));
    }

    export createBuilder() -> Builder {
        return new Builder(LLVMCreateBuilderInContext(this.contextHandle));
    }

    export appendBasicBlock(Value function, string name) -> BasicBlock {
        return new BasicBlock(LLVMAppendBasicBlockInContext(this.contextHandle,
            function.valueHandle, name));
    }

    export dispose() {
        LLVMContextDispose(this.contextHandle);
    }
}

// A resolved compilation target for a triple.
export final class Target {
    protected LLVMTargetRef targetHandle;

    protected constructor(this.targetHandle);

    // The target machine for this target with default CPU, features, and code-generation
    // settings.
    export createTargetMachine(string triple) -> TargetMachine {
        return new TargetMachine(LLVMCreateTargetMachine(this.targetHandle, triple, "", "",
            0, 0, 0));
    }
}

// A configured target machine that emits code for one target.
export final class TargetMachine {
    protected LLVMTargetMachineRef machineHandle;

    protected constructor(this.machineHandle);

    // Emits the module as a native object file. Returns true on success.
    export emitObjectFile(Module module, string filename) -> bool {
        return LLVMTargetMachineEmitToFile(this.machineHandle, module.moduleHandle, filename,
            1, null) == 0;
    }

    export dispose() {
        LLVMDisposeTargetMachine(this.machineHandle);
    }
}

// Creates a fresh LLVM context.
export createContext() -> Context {
    return new Context(LLVMContextCreate());
}

// Registers the target family of the host so a target machine can be created for it, chosen from
// the default triple: AArch64 for arm64 hosts, x86 otherwise.
export initializeHostTarget() {
    string triple = LLVMGetDefaultTargetTriple();
    if (triple.contains("aarch64") || triple.contains("arm64")) {
        LLVMInitializeAArch64TargetInfo();
        LLVMInitializeAArch64Target();
        LLVMInitializeAArch64TargetMC();
        LLVMInitializeAArch64AsmPrinter();
    } else {
        LLVMInitializeX86TargetInfo();
        LLVMInitializeX86Target();
        LLVMInitializeX86TargetMC();
        LLVMInitializeX86AsmPrinter();
    }
}

// The host's default target triple.
export hostTargetTriple() -> string {
    return LLVMGetDefaultTargetTriple();
}

// The target for the given triple, or null when it cannot be resolved. Call initializeHostTarget
// first so the host target is registered.
export targetFromTriple(string triple) -> Target? {
    LLVMTargetRef? target = null;
    let found = LLVMGetTargetFromTriple(triple, out target, null);
    if (found != 0 || target == null) {
        return null;
    }
    return new Target(target);
}
