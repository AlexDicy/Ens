// LLVM types and the constants derived directly from a type. The type handle is package-wide so
// every module that builds instructions or globals can name it. Type creation that needs a
// context (the integer, float, pointer, struct, and void types) lives on the Context in the core
// module; the operations here derive a new type or a constant from types the caller already has.

import Value from values;
import LLVMValueRef from values;

public external type LLVMTypeRef;

external from llvm {
    LLVMFunctionType(LLVMTypeRef returnType, LLVMTypeRef[] parameterTypes, uint parameterCount,
        int isVarArg) -> LLVMTypeRef;
    LLVMArrayType2(LLVMTypeRef elementType, ulong elementCount) -> LLVMTypeRef;
    LLVMStructSetBody(LLVMTypeRef structType, LLVMTypeRef[] elementTypes, uint elementCount,
        int packed);

    LLVMConstInt(LLVMTypeRef integerType, ulong value, int signExtend) -> LLVMValueRef;
    LLVMConstReal(LLVMTypeRef floatType, double value) -> LLVMValueRef;
    LLVMConstNull(LLVMTypeRef type) -> LLVMValueRef;
    LLVMGetUndef(LLVMTypeRef type) -> LLVMValueRef;
    LLVMConstArray2(LLVMTypeRef elementType, LLVMValueRef[] values, ulong count) -> LLVMValueRef;
    LLVMConstNamedStruct(LLVMTypeRef structType, LLVMValueRef[] values, uint count)
        -> LLVMValueRef;
    LLVMConstInBoundsGEP2(LLVMTypeRef type, LLVMValueRef pointer, LLVMValueRef[] indices,
        uint indexCount) -> LLVMValueRef;
}

// An LLVM type.
export final class TypeRef {
    public LLVMTypeRef typeHandle;

    public constructor(this.typeHandle);

    // The function type returning this type over the given parameter types.
    export functionType(TypeRef[] parameterTypes) -> TypeRef {
        return new TypeRef(LLVMFunctionType(this.typeHandle, handlesOf(parameterTypes),
            parameterTypes.length as uint, 0));
    }

    // The variadic function type returning this type over the given fixed parameter types.
    export variadicFunctionType(TypeRef[] parameterTypes) -> TypeRef {
        return new TypeRef(LLVMFunctionType(this.typeHandle, handlesOf(parameterTypes),
            parameterTypes.length as uint, 1));
    }

    // The array type of this element type with the given length.
    export arrayType(ulong length) -> TypeRef {
        return new TypeRef(LLVMArrayType2(this.typeHandle, length));
    }

    // Fills in this named struct type's fields.
    export setBody(TypeRef[] elementTypes, bool packed) {
        LLVMStructSetBody(this.typeHandle, handlesOf(elementTypes),
            elementTypes.length as uint, packed ? 1 : 0);
    }

    // The integer constant of this type with the given value, sign-extended when signed is true.
    export constInt(ulong value, bool signed) -> Value {
        return new Value(LLVMConstInt(this.typeHandle, value, signed ? 1 : 0));
    }

    // The floating-point constant of this type with the given value.
    export constReal(double value) -> Value {
        return new Value(LLVMConstReal(this.typeHandle, value));
    }

    // The zero value of this type (a null pointer, zero integer, or zero aggregate).
    export constNull() -> Value {
        return new Value(LLVMConstNull(this.typeHandle));
    }

    // An undefined value of this type, the base for building an aggregate with insertValue.
    export undef() -> Value {
        return new Value(LLVMGetUndef(this.typeHandle));
    }

    // A constant array of this element type over the given element values.
    export constArray(Value[] values) -> Value {
        return new Value(LLVMConstArray2(this.typeHandle, valueHandlesOf(values),
            values.length as ulong));
    }

    // A constant instance of this named struct type over the given field values.
    export constNamedStruct(Value[] values) -> Value {
        return new Value(LLVMConstNamedStruct(this.typeHandle, valueHandlesOf(values),
            values.length as uint));
    }

    // The constant address of a field or element reached from a constant pointer, reading it as
    // this type. The first index steps whole objects, as in a runtime getelementptr.
    export constInBoundsGEP(Value pointer, Value[] indices) -> Value {
        return new Value(LLVMConstInBoundsGEP2(this.typeHandle, pointer.valueHandle,
            valueHandlesOf(indices), indices.length as uint));
    }
}

// The raw handles behind an array of type wrappers, for a foreign call taking LLVMTypeRef[].
handlesOf(TypeRef[] types) -> LLVMTypeRef[] {
    LLVMTypeRef[] handles = new LLVMTypeRef[types.length];
    for (long i = 0; i < handles.length; i++) {
        handles[i] = types[i].typeHandle;
    }
    return handles;
}

// The raw handles behind an array of value wrappers, for a foreign call taking LLVMValueRef[].
valueHandlesOf(Value[] values) -> LLVMValueRef[] {
    LLVMValueRef[] handles = new LLVMValueRef[values.length];
    for (long i = 0; i < handles.length; i++) {
        handles[i] = values[i].valueHandle;
    }
    return handles;
}
