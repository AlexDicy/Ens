// Targets, target machines, data layout, and native object emission. The per-target initializers
// are the linkable entry points (the LLVMInitializeAll* helpers are header-only), so every family
// is bound individually and all of them are registered together.

import Module from core;
import LLVMModuleRef from core;
import TypeRef from types;
import LLVMTypeRef from types;
import LLVMMessage from analysis;
import @std.ffi;

public external type LLVMTargetRef;
public external type LLVMTargetMachineRef;
public external type LLVMTargetDataRef;

external from llvm {
    LLVMInitializeX86TargetInfo();
    LLVMInitializeX86Target();
    LLVMInitializeX86TargetMC();
    LLVMInitializeX86AsmPrinter();
    LLVMInitializeAArch64TargetInfo();
    LLVMInitializeAArch64Target();
    LLVMInitializeAArch64TargetMC();
    LLVMInitializeAArch64AsmPrinter();
    LLVMGetDefaultTargetTriple() -> string;
    LLVMGetTargetFromTriple(string triple, out LLVMTargetRef? target,
        out LLVMMessage? outError) -> int;
    LLVMCreateTargetMachine(LLVMTargetRef target, string triple, string cpu, string features,
        int optimizationLevel, int relocationMode, int codeModel) -> LLVMTargetMachineRef;
    LLVMDisposeTargetMachine(LLVMTargetMachineRef machine);
    LLVMTargetMachineEmitToFile(LLVMTargetMachineRef machine, LLVMModuleRef module,
        string filename, int fileType, out LLVMMessage? outError) -> int;
    LLVMDisposeMessage(LLVMMessage message);
    LLVMCreateTargetDataLayout(LLVMTargetMachineRef machine) -> LLVMTargetDataRef;
    LLVMSetModuleDataLayout(LLVMModuleRef module, LLVMTargetDataRef dataLayout);
    LLVMABISizeOfType(LLVMTargetDataRef dataLayout, LLVMTypeRef type) -> ulong;
    LLVMABIAlignmentOfType(LLVMTargetDataRef dataLayout, LLVMTypeRef type) -> uint;
    LLVMSizeOfTypeInBits(LLVMTargetDataRef dataLayout, LLVMTypeRef type) -> ulong;
    LLVMOffsetOfElement(LLVMTargetDataRef dataLayout, LLVMTypeRef structType, uint element)
        -> ulong;
    LLVMPointerSize(LLVMTargetDataRef dataLayout) -> uint;
}

// The data layout of a target machine, used to query type sizes, alignments, and field offsets.
export final class TargetData {
    public LLVMTargetDataRef dataHandle;

    public constructor(this.dataHandle);

    export abiSizeOfType(TypeRef type) -> ulong {
        return LLVMABISizeOfType(this.dataHandle, type.typeHandle);
    }

    export abiAlignmentOfType(TypeRef type) -> uint {
        return LLVMABIAlignmentOfType(this.dataHandle, type.typeHandle);
    }

    export sizeOfTypeInBits(TypeRef type) -> ulong {
        return LLVMSizeOfTypeInBits(this.dataHandle, type.typeHandle);
    }

    export offsetOfElement(TypeRef structType, uint element) -> ulong {
        return LLVMOffsetOfElement(this.dataHandle, structType.typeHandle, element);
    }

    export pointerSize() -> uint {
        return LLVMPointerSize(this.dataHandle);
    }
}

// A configured target machine that emits code for one target.
export final class TargetMachine {
    public LLVMTargetMachineRef machineHandle;

    public constructor(this.machineHandle);

    // The data layout this machine assigns to a module.
    export createDataLayout() -> TargetData {
        return new TargetData(LLVMCreateTargetDataLayout(this.machineHandle));
    }

    // Emits the module as a native object file. Returns "" on success, or the reason it failed.
    // File type 1 is LLVMObjectFile.
    export emitObjectFile(Module module, string filename) -> string {
        LLVMMessage? message = null;
        let failed = LLVMTargetMachineEmitToFile(this.machineHandle, module.moduleHandle,
            filename, 1, out message);
        if (failed == 0) {
            if (message != null) {
                LLVMDisposeMessage(message);
            }
            return "";
        }
        if (message == null) {
            return "the target machine could not write '{filename}'";
        }
        let reason = ffi.fromCString(message) ?? "";
        LLVMDisposeMessage(message);
        if (reason.length == 0) {
            return "the target machine could not write '{filename}'";
        }
        return reason;
    }

    export dispose() {
        LLVMDisposeTargetMachine(this.machineHandle);
    }
}

// A resolved compilation target for a triple.
export final class Target {
    public LLVMTargetRef targetHandle;

    public constructor(this.targetHandle);

    // The target machine for this target with default CPU, features, relocation, and code model,
    // generating code at the given optimization level: 0 none, which keeps every value in stack
    // memory, 1 less, 2 default, 3 aggressive.
    export createTargetMachine(string triple, int optimizationLevel) -> TargetMachine {
        return new TargetMachine(LLVMCreateTargetMachine(this.targetHandle, triple, "", "",
            optimizationLevel, 0, 0));
    }
}

// Sets the module's data layout, so type queries and emission agree on target layout.
export setModuleDataLayout(Module module, TargetData dataLayout) {
    LLVMSetModuleDataLayout(module.moduleHandle, dataLayout.dataHandle);
}

// Registers every target family this binding is linked against, so a target machine can be
// created for any of them and a build for a triple this machine does not run still resolves.
export initializeTargets() {
    LLVMInitializeX86TargetInfo();
    LLVMInitializeX86Target();
    LLVMInitializeX86TargetMC();
    LLVMInitializeX86AsmPrinter();
    LLVMInitializeAArch64TargetInfo();
    LLVMInitializeAArch64Target();
    LLVMInitializeAArch64TargetMC();
    LLVMInitializeAArch64AsmPrinter();
}

// The host's default target triple.
export hostTargetTriple() -> string {
    return LLVMGetDefaultTargetTriple();
}

// The target for the given triple, or null when it cannot be resolved. Call initializeTargets
// first so the target families are registered.
export targetFromTriple(string triple) -> Target? {
    LLVMTargetRef? target = null;
    LLVMMessage? message = null;
    let found = LLVMGetTargetFromTriple(triple, out target, out message);
    if (message != null) {
        LLVMDisposeMessage(message);
    }
    if (found != 0 || target == null) {
        return null;
    }
    return new Target(target);
}
