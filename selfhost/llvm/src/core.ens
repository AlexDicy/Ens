// The core LLVM objects: a context and the modules and builders it owns, plus the type and
// function creation that needs a context. The context, module, and builder handles are owned
// here; the other modules import them to reach across the binding.

import TypeRef from types;
import LLVMTypeRef from types;
import Value from values;
import LLVMValueRef from values;
import BasicBlock from blocks;
import LLVMBasicBlockRef from blocks;

public external type LLVMContextRef;
public external type LLVMModuleRef;
public external type LLVMBuilderRef;

external from llvm {
    LLVMContextCreate() -> LLVMContextRef;
    LLVMContextDispose(LLVMContextRef context);
    LLVMModuleCreateWithNameInContext(string name, LLVMContextRef context) -> LLVMModuleRef;
    LLVMDisposeModule(LLVMModuleRef module);
    LLVMCreateBuilderInContext(LLVMContextRef context) -> LLVMBuilderRef;
    LLVMDisposeBuilder(LLVMBuilderRef builder);
    LLVMPositionBuilderAtEnd(LLVMBuilderRef builder, LLVMBasicBlockRef block);
    LLVMGetInsertBlock(LLVMBuilderRef builder) -> LLVMBasicBlockRef?;

    LLVMInt1TypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMInt8TypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMInt16TypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMInt32TypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMInt64TypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMFloatTypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMDoubleTypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMVoidTypeInContext(LLVMContextRef context) -> LLVMTypeRef;
    LLVMPointerTypeInContext(LLVMContextRef context, uint addressSpace) -> LLVMTypeRef;
    LLVMStructCreateNamed(LLVMContextRef context, string name) -> LLVMTypeRef;
    LLVMStructTypeInContext(LLVMContextRef context, LLVMTypeRef[] elementTypes,
        uint elementCount, int packed) -> LLVMTypeRef;

    LLVMAddFunction(LLVMModuleRef module, string name, LLVMTypeRef functionType) -> LLVMValueRef;
    LLVMAppendBasicBlockInContext(LLVMContextRef context, LLVMValueRef function, string name)
        -> LLVMBasicBlockRef;
    LLVMConstStringInContext2(LLVMContextRef context, string text, ulong length,
        int dontNullTerminate) -> LLVMValueRef;
    LLVMConstStructInContext(LLVMContextRef context, LLVMValueRef[] values, uint count,
        int packed) -> LLVMValueRef;
}

// An LLVM module: a container of functions and globals.
export final class Module {
    public LLVMModuleRef moduleHandle;

    public constructor(this.moduleHandle);

    export addFunction(string name, TypeRef functionType) -> Value {
        return new Value(LLVMAddFunction(this.moduleHandle, name, functionType.typeHandle));
    }

    export dispose() {
        LLVMDisposeModule(this.moduleHandle);
    }
}

// An IR builder positioned at an insertion point.
export final class Builder {
    public LLVMBuilderRef builderHandle;

    public constructor(this.builderHandle);

    export positionAtEnd(BasicBlock block) {
        LLVMPositionBuilderAtEnd(this.builderHandle, block.blockHandle);
    }

    // The block being inserted into, or null when the builder has no insertion point yet. Save it
    // before emitting elsewhere and position back at it to resume.
    export insertBlock() -> BasicBlock? {
        let block = LLVMGetInsertBlock(this.builderHandle);
        if (block == null) {
            return null;
        }
        return new BasicBlock(block);
    }

    export dispose() {
        LLVMDisposeBuilder(this.builderHandle);
    }
}

// An LLVM context owning the types, values, and modules created through it.
export final class Context {
    public LLVMContextRef contextHandle;

    public constructor(this.contextHandle);

    export createModule(string name) -> Module {
        return new Module(LLVMModuleCreateWithNameInContext(name, this.contextHandle));
    }

    export createBuilder() -> Builder {
        return new Builder(LLVMCreateBuilderInContext(this.contextHandle));
    }

    export appendBasicBlock(Value function, string name) -> BasicBlock {
        return new BasicBlock(LLVMAppendBasicBlockInContext(this.contextHandle,
            function.valueHandle, name));
    }

    export int1Type() -> TypeRef {
        return new TypeRef(LLVMInt1TypeInContext(this.contextHandle));
    }

    export int8Type() -> TypeRef {
        return new TypeRef(LLVMInt8TypeInContext(this.contextHandle));
    }

    export int16Type() -> TypeRef {
        return new TypeRef(LLVMInt16TypeInContext(this.contextHandle));
    }

    export int32Type() -> TypeRef {
        return new TypeRef(LLVMInt32TypeInContext(this.contextHandle));
    }

    export int64Type() -> TypeRef {
        return new TypeRef(LLVMInt64TypeInContext(this.contextHandle));
    }

    export floatType() -> TypeRef {
        return new TypeRef(LLVMFloatTypeInContext(this.contextHandle));
    }

    export doubleType() -> TypeRef {
        return new TypeRef(LLVMDoubleTypeInContext(this.contextHandle));
    }

    export voidType() -> TypeRef {
        return new TypeRef(LLVMVoidTypeInContext(this.contextHandle));
    }

    // The opaque pointer type in the default address space.
    export pointerType() -> TypeRef {
        return new TypeRef(LLVMPointerTypeInContext(this.contextHandle, 0));
    }

    // A fresh named (opaque) struct type; fill it in later with TypeRef.setBody.
    export namedStructType(string name) -> TypeRef {
        return new TypeRef(LLVMStructCreateNamed(this.contextHandle, name));
    }

    // A constant byte array holding the string's bytes, the raw data for a private string global.
    // When nullTerminated is true a trailing NUL is appended, matching C string data.
    export constString(string text, bool nullTerminated) -> Value {
        return new Value(LLVMConstStringInContext2(this.contextHandle, text, text.length as ulong,
            nullTerminated ? 0 : 1));
    }

    // A constant of a literal (anonymous) struct type, its type inferred from the field values.
    export constStruct(Value[] values, bool packed) -> Value {
        LLVMValueRef[] handles = new LLVMValueRef[values.length];
        for (long i = 0; i < handles.length; i++) {
            handles[i] = values[i].valueHandle;
        }
        return new Value(LLVMConstStructInContext(this.contextHandle, handles,
            handles.length as uint, packed ? 1 : 0));
    }

    // A literal (anonymous) struct type over the given field types.
    export structType(TypeRef[] elementTypes, bool packed) -> TypeRef {
        LLVMTypeRef[] handles = new LLVMTypeRef[elementTypes.length];
        for (long i = 0; i < handles.length; i++) {
            handles[i] = elementTypes[i].typeHandle;
        }
        return new TypeRef(LLVMStructTypeInContext(this.contextHandle, handles,
            handles.length as uint, packed ? 1 : 0));
    }

    export dispose() {
        LLVMContextDispose(this.contextHandle);
    }
}

// Creates a fresh LLVM context.
export createContext() -> Context {
    return new Context(LLVMContextCreate());
}
