// LLVM values: constants, functions, globals, and instruction results. The opaque handle is a
// package-wide external type so the other binding modules can name it; the wrapper hands it to
// them through a public field, and consumers of ens.llvm reach values only through the wrappers.

public external type LLVMValueRef;

// An LLVM value. The handle is public within the package so a sibling binding module can read it
// and wrap a result, but it is never exported, so consumers cannot forge one.
export final class Value {
    public LLVMValueRef valueHandle;

    public constructor(this.valueHandle);
}
