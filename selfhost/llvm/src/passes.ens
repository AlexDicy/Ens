// LLVM's own IR optimization passes, run over a whole module through the new pass manager. A
// pipeline is written the way opt's '-passes' option takes it, such as 'default<O2>'.

import Module from core;
import LLVMModuleRef from core;
import TargetMachine from target;
import LLVMTargetMachineRef from target;
import @std.ffi;

public external type LLVMPassBuilderOptionsRef;
public external type LLVMErrorRef;
public external type LLVMErrorMessage;

external from llvm {
    LLVMCreatePassBuilderOptions() -> LLVMPassBuilderOptionsRef;
    LLVMDisposePassBuilderOptions(LLVMPassBuilderOptionsRef options);
    LLVMRunPasses(LLVMModuleRef module, string passes, LLVMTargetMachineRef machine,
        LLVMPassBuilderOptionsRef options) -> LLVMErrorRef?;
    LLVMGetErrorMessage(LLVMErrorRef error) -> LLVMErrorMessage;
    LLVMDisposeErrorMessage(LLVMErrorMessage message);
}

// Runs the pipeline over the module, tuned for the machine's target. Returns "" on success, or
// LLVM's reason the pipeline did not run, such as a pass name it does not know.
export runPasses(Module module, string pipeline, TargetMachine machine) -> string {
    let options = LLVMCreatePassBuilderOptions();
    let failure = LLVMRunPasses(module.moduleHandle, pipeline, machine.machineHandle, options);
    LLVMDisposePassBuilderOptions(options);
    if (failure == null) {
        return "";
    }
    let message = LLVMGetErrorMessage(failure);
    let reason = ffi.fromCString(message) ?? "";
    LLVMDisposeErrorMessage(message);
    if (reason.length == 0) {
        return "the pipeline '{pipeline}' did not run";
    }
    return reason;
}
