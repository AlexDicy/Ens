// Module verification. LLVMVerifyModule writes its diagnostic into a library-owned C string; the
// message handle is an external type, read into an Ens string through @std.ffi.fromCString and
// then freed with LLVMDisposeMessage.

import Module from core;
import LLVMModuleRef from core;
import @std.ffi;

public external type LLVMMessage;

external from llvm {
    LLVMVerifyModule(LLVMModuleRef module, int action, out LLVMMessage? outMessage) -> int;
    LLVMDisposeMessage(LLVMMessage message);
}

// Verifies the module. Returns "" when it is well formed, or the verifier's message otherwise.
// Action 2 is LLVMReturnStatusAction: capture the message rather than printing it or aborting.
export verify(Module module) -> string {
    LLVMMessage? message = null;
    let broken = LLVMVerifyModule(module.moduleHandle, 2, out message);
    if (broken == 0) {
        if (message != null) {
            LLVMDisposeMessage(message);
        }
        return "";
    }
    if (message == null) {
        return "the module failed verification";
    }
    let text = ffi.fromCString(message) ?? "";
    LLVMDisposeMessage(message);
    return text;
}
