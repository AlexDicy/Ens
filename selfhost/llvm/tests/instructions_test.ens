// The builder instruction surface: arithmetic, bitwise, comparisons, casts, selection,
// aggregates, control flow, and calls. Each test builds a well-formed function and asserts the
// LLVM verifier accepts the module.
import core;
import instructions;
import globals;
import support;

test "arithmetic, bitwise, comparison, and selection verify" {
    let context = core.createContext();
    let module = context.createModule("inst_arith");
    let i32 = context.int32Type();
    let function = module.addFunction("mix", i32.functionType([i32, i32]));
    let a = globals.getParam(function, 0);
    let b = globals.getParam(function, 1);
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let sum = instructions.buildAdd(builder, a, b, "sum");
    let diff = instructions.buildSub(builder, sum, b, "diff");
    let prod = instructions.buildMul(builder, diff, b, "prod");
    let quot = instructions.buildSDiv(builder, prod, b, "quot");
    let rem = instructions.buildSRem(builder, quot, b, "rem");
    let masked = instructions.buildAnd(builder, rem, a, "masked");
    let ored = instructions.buildOr(builder, masked, b, "ored");
    let xored = instructions.buildXor(builder, ored, a, "xored");
    let shifted = instructions.buildShl(builder, xored, b, "shifted");
    let arithShifted = instructions.buildAShr(builder, shifted, b, "arithShifted");
    let negated = instructions.buildNeg(builder, arithShifted, "neg");
    let condition = instructions.buildICmpSLT(builder, negated, a, "lt");
    let widened = instructions.buildZExt(builder, condition, i32, "wide");
    let chosen = instructions.buildSelect(builder, condition, widened, a, "sel");
    let terminator = instructions.buildRet(builder, chosen);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "the integer and float casts verify" {
    let context = core.createContext();
    let module = context.createModule("inst_casts");
    let i8 = context.int8Type();
    let i32 = context.int32Type();
    let i64 = context.int64Type();
    let floatType = context.floatType();
    let doubleType = context.doubleType();
    let function = module.addFunction("casts", i32.functionType([i32]));
    let a = globals.getParam(function, 0);
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let narrow = instructions.buildTrunc(builder, a, i8, "narrow");
    let signWide = instructions.buildSExt(builder, narrow, i64, "signWide");
    let zeroWide = instructions.buildZExt(builder, narrow, i64, "zeroWide");
    let backToInt = instructions.buildIntCast(builder, signWide, i32, true, "back");
    let asDouble = instructions.buildSIToFP(builder, backToInt, doubleType, "asDouble");
    let asFloat = instructions.buildFPTrunc(builder, asDouble, floatType, "asFloat");
    let widerAgain = instructions.buildFPExt(builder, asFloat, doubleType, "widerAgain");
    let asUnsigned = instructions.buildUIToFP(builder, backToInt, doubleType, "asUnsigned");
    let fromDouble = instructions.buildFPToSI(builder, widerAgain, i32, "fromDouble");
    let fromUnsigned = instructions.buildFPToUI(builder, asUnsigned, i32, "fromUnsigned");
    let bits = instructions.buildBitCast(builder, asFloat, i32, "bits");
    let combined = instructions.buildAdd(builder, fromDouble, bits, "combined");
    let terminator = instructions.buildRet(builder, combined);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "branches, a switch, and unreachable verify" {
    let context = core.createContext();
    let module = context.createModule("inst_control");
    let i32 = context.int32Type();
    let function = module.addFunction("classify", i32.functionType([i32]));
    let x = globals.getParam(function, 0);
    let builder = context.createBuilder();
    let entry = context.appendBasicBlock(function, "entry");
    let positive = context.appendBasicBlock(function, "positive");
    let other = context.appendBasicBlock(function, "other");
    let zeroCase = context.appendBasicBlock(function, "zeroCase");
    let oneCase = context.appendBasicBlock(function, "oneCase");
    let fallback = context.appendBasicBlock(function, "fallback");
    builder.positionAtEnd(entry);
    let condition = instructions.buildICmpSGT(builder, x, i32.constInt(0, false), "pos");
    let branch = instructions.buildCondBr(builder, condition, positive, other);
    builder.positionAtEnd(positive);
    let r1 = instructions.buildRet(builder, i32.constInt(1, false));
    builder.positionAtEnd(other);
    let switchInstruction = instructions.buildSwitch(builder, x, fallback, 2);
    instructions.addCase(switchInstruction, i32.constInt(0, false), zeroCase);
    instructions.addCase(switchInstruction, i32.constInt(1, false), oneCase);
    builder.positionAtEnd(zeroCase);
    let r2 = instructions.buildRet(builder, i32.constInt(10, false));
    builder.positionAtEnd(oneCase);
    let r3 = instructions.buildRet(builder, i32.constInt(20, false));
    builder.positionAtEnd(fallback);
    let unreachable = instructions.buildUnreachable(builder);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "a direct call verifies" {
    let context = core.createContext();
    let module = context.createModule("inst_call");
    let i32 = context.int32Type();
    let calleeType = i32.functionType([i32]);
    let callee = module.addFunction("callee", calleeType);
    let calleeBuilder = context.createBuilder();
    calleeBuilder.positionAtEnd(context.appendBasicBlock(callee, "entry"));
    let calleeReturn = instructions.buildRet(calleeBuilder, globals.getParam(callee, 0));
    let caller = module.addFunction("caller", i32.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(caller, "entry"));
    let result = instructions.buildCall(builder, calleeType, callee,
        [i32.constInt(5, false)], "result");
    let terminator = instructions.buildRet(builder, result);
    try support.assertVerifies(module);
    calleeBuilder.dispose();
    builder.dispose();
    context.dispose();
}

test "insert and extract on an aggregate verify" {
    let context = core.createContext();
    let module = context.createModule("inst_aggregate");
    let i32 = context.int32Type();
    let pair = context.structType([i32, i32], false);
    let function = module.addFunction("firstOf", i32.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let empty = pair.undef();
    let withFirst = instructions.buildInsertValue(builder, empty, i32.constInt(1, false), 0,
        "withFirst");
    let withSecond = instructions.buildInsertValue(builder, withFirst, i32.constInt(2, false), 1,
        "withSecond");
    let first = instructions.buildExtractValue(builder, withSecond, 0, "first");
    let terminator = instructions.buildRet(builder, first);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}
