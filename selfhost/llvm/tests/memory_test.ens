// The memory and atomic surface: stack slots, loads and stores, address computation, the bulk
// memory intrinsics, and the atomic operations the reference counter needs. Each test builds a
// well-formed function and asserts the LLVM verifier accepts the module.
import core;
import instructions;
import memory;
import globals;
import support;

test "stack slots, loads, stores, and address computation verify" {
    let context = core.createContext();
    let module = context.createModule("mem_basic");
    let i32 = context.int32Type();
    let pair = context.structType([i32, i32], false);
    let function = module.addFunction("roundTrip", i32.functionType([i32]));
    let a = globals.getParam(function, 0);
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let slot = memory.buildAlloca(builder, i32, "slot");
    let stored = memory.buildStore(builder, a, slot);
    let loaded = memory.buildLoad(builder, i32, slot, "loaded");
    let record = memory.buildAlloca(builder, pair, "record");
    let field = memory.buildStructGEP(builder, pair, record, 1, "field");
    let fieldStore = memory.buildStore(builder, loaded, field);
    let fieldLoad = memory.buildLoad(builder, i32, field, "fieldLoad");
    let address = instructions.buildPtrToInt(builder, slot, i32, "address");
    let sum = instructions.buildAdd(builder, fieldLoad, address, "sum");
    let terminator = instructions.buildRet(builder, sum);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "array indexing and the bulk memory intrinsics verify" {
    let context = core.createContext();
    let module = context.createModule("mem_bulk");
    let i8 = context.int8Type();
    let i32 = context.int32Type();
    let i64 = context.int64Type();
    let bytes = i8.arrayType(8);
    let function = module.addFunction("copyBytes", context.voidType().functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let source = memory.buildAlloca(builder, bytes, "source");
    let destination = memory.buildAlloca(builder, bytes, "destination");
    let filled = memory.buildMemSet(builder, source, i8.constInt(7, false),
        i64.constInt(8, false), 1);
    let copied = memory.buildMemCpy(builder, destination, 1, source, 1, i64.constInt(8, false));
    let element = memory.buildGEP(builder, bytes, destination,
        [i32.constInt(0, false), i32.constInt(3, false)], "element");
    let terminator = instructions.buildRetVoid(builder);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "atomic read-modify-write, compare-exchange, and ordered loads verify" {
    let context = core.createContext();
    let module = context.createModule("mem_atomic");
    let i32 = context.int32Type();
    let function = module.addFunction("refcount", i32.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let slot = memory.buildAlloca(builder, i32, "slot");
    let initialize = memory.buildStore(builder, i32.constInt(1, false), slot);
    let retained = memory.buildAtomicAdd(builder, slot, i32.constInt(1, false),
        memory.orderingMonotonic());
    let released = memory.buildAtomicSub(builder, slot, i32.constInt(1, false),
        memory.orderingAcquireRelease());
    let swapped = memory.buildAtomicExchange(builder, slot, i32.constInt(0, false),
        memory.orderingRelease());
    let exchanged = memory.buildAtomicCompareExchange(builder, slot, i32.constInt(0, false),
        i32.constInt(1, false), memory.orderingAcquireRelease(), memory.orderingAcquire());
    let previous = instructions.buildExtractValue(builder, exchanged, 0, "previous");
    let observed = memory.buildLoad(builder, i32, slot, "observed");
    memory.setOrdering(observed, memory.orderingAcquire());
    memory.setAlignment(observed, 4);
    let terminator = instructions.buildRet(builder, previous);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}
