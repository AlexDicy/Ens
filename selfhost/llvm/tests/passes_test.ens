// Running LLVM's own pass pipeline over a module, and the reason reported for a pipeline text
// LLVM refuses.
import @std.testing;
import analysis;
import core;
import instructions;
import memory;
import passes;
import target;
import TargetMachine from target;
import support;

hostMachine() -> TargetMachine? {
    target.initializeTargets();
    string triple = target.hostTargetTriple();
    let resolved = target.targetFromTriple(triple);
    if (resolved == null) {
        return null;
    }
    return resolved.createTargetMachine(triple, 2);
}

test "the default pipeline turns a stack slot into a value" {
    let machine = hostMachine();
    try testing.assertTrue(machine != null, "the host target did not resolve");
    if (machine == null) {
        return;
    }
    let context = core.createContext();
    let module = context.createModule("passes_promote");
    let i32 = context.int32Type();
    let function = module.addFunction("seven", i32.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let slot = memory.buildAlloca(builder, i32, "slot");
    let stored = memory.buildStore(builder, i32.constInt(7, false), slot);
    let loaded = memory.buildLoad(builder, i32, slot, "loaded");
    let returned = instructions.buildRet(builder, loaded);
    try support.assertVerifies(module);

    string failure = passes.runPasses(module, "default<O2>", machine);
    try testing.assertEqual(failure, "");
    string text = analysis.moduleText(module);
    try testing.assertTrue(text.indexOf("alloca") < 0, "the stack slot survived: {text}");
    try testing.assertTrue(text.indexOf("ret i32 7") >= 0, "the value was not folded: {text}");
    builder.dispose();
    context.dispose();
    machine.dispose();
}

test "a pipeline naming a pass LLVM does not have is refused with the name" {
    let machine = hostMachine();
    try testing.assertTrue(machine != null, "the host target did not resolve");
    if (machine == null) {
        return;
    }
    let context = core.createContext();
    let module = context.createModule("passes_unknown");
    string failure = passes.runPasses(module, "no-such-pass", machine);
    try testing.assertEqual(failure, "unknown pass name 'no-such-pass'");
    context.dispose();
    machine.dispose();
}
