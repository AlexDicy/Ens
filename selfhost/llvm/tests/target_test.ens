// The target surface: host target resolution, target machines, and object emission. Emission
// failures must come back as a message, because LLVM writes the reason through the error
// out-parameter whenever it cannot open the output file.
import @std.testing;
import core;
import instructions;
import target;
import support;

test "the host target resolves into a target machine with a data layout" {
    target.initializeHostTarget();
    string triple = target.hostTargetTriple();
    try testing.assertTrue(triple.length > 0, "the host triple was empty");
    let resolved = target.targetFromTriple(triple);
    try testing.assertTrue(resolved != null, "the host target '{triple}' did not resolve");
    if (resolved == null) {
        return;
    }
    let machine = resolved.createTargetMachine(triple);
    let layout = machine.createDataLayout();
    try testing.assertTrue(layout.pointerSize() > 0, "the data layout reported no pointer size");
    machine.dispose();
}

test "emitting into a folder that does not exist reports the reason" {
    target.initializeHostTarget();
    string triple = target.hostTargetTriple();
    let resolved = target.targetFromTriple(triple);
    try testing.assertTrue(resolved != null, "the host target '{triple}' did not resolve");
    if (resolved == null) {
        return;
    }
    let machine = resolved.createTargetMachine(triple);

    let context = core.createContext();
    let module = context.createModule("target_emit");
    let i32 = context.int32Type();
    let function = module.addFunction("seven", i32.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let terminator = instructions.buildRet(builder, i32.constInt(7, false));
    try support.assertVerifies(module);

    string failure = machine.emitObjectFile(module, "no-such-folder-for-tests/module.obj");
    try testing.assertTrue(failure.length > 0,
        "emitting into a missing folder reported success");

    builder.dispose();
    context.dispose();
    machine.dispose();
}
