// Core, type, constant, and global surface: build small modules and assert the LLVM verifier
// accepts them. A failure prints the verifier's own message so the break is legible.
import @std.testing;
import analysis;
import core;
import instructions;
import memory;
import Linkage from globals;
import UnnamedAddress from globals;
import globals;
import support;

test "a function returning an integer constant verifies" {
    let context = core.createContext();
    let module = context.createModule("core_constants");
    let i32 = context.int32Type();
    let function = module.addFunction("seven", i32.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let terminator = instructions.buildRet(builder, i32.constInt(7, false));
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "the primitive and derived types build a well-formed function" {
    let context = core.createContext();
    let module = context.createModule("core_types");
    let doubleType = context.doubleType();
    let function = module.addFunction("pi", doubleType.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let terminator = instructions.buildRet(builder, doubleType.constReal(3.14));
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "a named struct type and an aggregate constant verify" {
    let context = core.createContext();
    let module = context.createModule("core_struct");
    let i32 = context.int32Type();
    let i8 = context.int8Type();
    let point = context.namedStructType("Point");
    point.setBody([i32, i8], false);
    let function = module.addFunction("makePoint", point.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let value = point.constNamedStruct([i32.constInt(1, false), i8.constInt(2, false)]);
    let terminator = instructions.buildRet(builder, value);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "a private constant string global verifies" {
    let context = core.createContext();
    let module = context.createModule("core_string");
    let data = context.constString("hello", true);
    let bytes = context.int8Type().arrayType(6);
    let greeting = globals.addGlobal(module, bytes, "greeting");
    globals.setInitializer(greeting, data);
    globals.setGlobalConstant(greeting, true);
    globals.setLinkage(greeting, Linkage.privateSymbol);
    globals.setUnnamedAddress(greeting, UnnamedAddress.global);
    try support.assertVerifies(module);
    context.dispose();
}

test "a global constant with internal linkage and a function attribute verify" {
    let context = core.createContext();
    let module = context.createModule("core_globals");
    let i32 = context.int32Type();
    let counter = globals.addGlobal(module, i32, "counter");
    globals.setInitializer(counter, i32.constInt(0, false));
    globals.setGlobalConstant(counter, true);
    globals.setLinkage(counter, Linkage.internalSymbol);
    let function = module.addFunction("readCounter", i32.functionType([]));
    globals.addFunctionAttribute(context, function, "nounwind");
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let loaded = memory.buildLoad(builder, i32, counter, "value");
    let terminator = instructions.buildRet(builder, loaded);
    try support.assertVerifies(module);
    builder.dispose();
    context.dispose();
}

test "the printed IR names the module's globals and functions" {
    let context = core.createContext();
    let module = context.createModule("core_text");
    let i32 = context.int32Type();
    let function = module.addFunction("answer", i32.functionType([]));
    let builder = context.createBuilder();
    builder.positionAtEnd(context.appendBasicBlock(function, "entry"));
    let terminator = instructions.buildRet(builder, i32.constInt(42, false));
    string text = analysis.moduleText(module);
    try testing.assertTrue(text.indexOf("define i32 @answer()") >= 0,
        "the printed IR did not define the function: {text}");
    try testing.assertTrue(text.indexOf("ret i32 42") >= 0,
        "the printed IR did not carry the body: {text}");
    builder.dispose();
    context.dispose();
}
