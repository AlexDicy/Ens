// Shared assertion for the binding tests: build a module, then check the real LLVM verifier
// accepts it, surfacing the verifier's own message when it does not.
import @std.testing;
import Module from core;
import analysis;

export assertVerifies(Module module) throws {
    let error = analysis.verify(module);
    try testing.assertTrue(error.length == 0, "verification failed: {error}");
}
